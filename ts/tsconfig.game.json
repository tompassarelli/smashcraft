{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "build/typecheck-game",
    "tsBuildInfoFile": "build/typecheck-game.tsbuildinfo",
    "skipLibCheck": true,
    "types": [
      "lua-types/5.3"
    ]
  },
  "include": [
    "node_modules/wisp/src/natives/warcraft.d.ts",
    "src/runtime/*.ts",
    "src/sim/*.ts",
    "src/game/**/*.ts",
    "src/platform/**/*.ts",
    "scripts/wisp/perfLua.ts",
    "scripts/wisp/memoryLua.ts",
    "scripts/wisp/handleBaselineLua.ts",
    "scripts/wisp/handleBaseline.ts",
    "scripts/wisp/handleCensus.ts",
    "scripts/wisp/memoryCensus.ts",
    "scripts/wisp/botMatch.ts"
  ],
  "exclude": [
    "src/sim/*.test.ts"
  ]
}
