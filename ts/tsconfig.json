{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noEmitOnError": true,
    "incremental": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": "build/typecheck-host",
    "tsBuildInfoFile": "build/typecheck-host.tsbuildinfo",
    "skipLibCheck": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectSuggestionsInTscExitCode": false,
        "ignoreEffectWarningsInTscExitCode": false,
        "allowedUnstableApis": ["effect/process", "@effect/platform-bun/BunRuntime", "@effect/platform-bun/BunServices"]
      },
      {
        "name": "wisp/plugins/number-rules-service.cjs",
        "project": "./tsconfig.game.json"
      }
    ],
    "types": [
      "bun"
    ]
  },
  "include": [
    "src/**/*.ts",
    "scripts/**/*.ts",
    "plugins/**/*.ts"
  ],
  "exclude": [
    "src/platform/**",
    "src/game/ui/**",
    "src/game/render/**",
    "src/parity/lua-entry.ts",
    "scripts/wisp/perfLua.ts",
    "scripts/wisp/memoryLua.ts",
    "scripts/wisp/memoryCensus.ts",
    "scripts/wisp/botMatch.ts",
    "scripts/wisp/censusProfile.ts"
  ]
}
