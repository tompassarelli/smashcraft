{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [
      "lua-types/5.3"
    ],
    "rootDir": "src",
    "outDir": "build",
    "sourceMap": true
  },
  "include": [
    "src/sim/**/*.ts",
    "src/runtime/*.ts",
    "node_modules/wisp/src/natives/warcraft.d.ts",
    "src/platform/*.ts"
  ],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.tests.ts",
    "src/platform/airCutoffProbe.ts",
    "src/platform/physicsProbeMain.ts",
    "src/platform/frameCostMain.ts",
    "src/platform/integrityMain.ts",
    "src/platform/playableMain.ts",
    "src/platform/stackDemo.ts",
    "src/platform/stackTraceMain.ts"
  ],
  "tstl": {
    "luaTarget": "5.3",
    "luaBundle": "map.lua",
    "luaBundleEntry": "src/platform/devMain.ts",
    "noImplicitSelf": true,
    "noHeader": true,
    "luaPlugins": [
      {
        "name": "./node_modules/wisp/plugins/warcraft-numbers.ts"
      }
    ]
  }
}
