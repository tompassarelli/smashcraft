{
  "compilerOptions": {
    "target": "ESNext",
    "lib": [
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noEmitOnError": true,
    "skipLibCheck": true,
    "types": [
      "lua-types/5.3"
    ],
    "rootDir": ".",
    "outDir": "build/lua-tests"
  },
  "include": [
    "src/runtime/*.ts",
    "src/sim/*.ts",
    "src/game/**/*.ts",
    "src/natives/*.d.ts",
    "test/lua/*.ts"
  ],
  "tstl": {
    "luaTarget": "5.3",
    "luaBundle": "tests.lua",
    "luaBundleEntry": "test/lua/entry.ts",
    "noImplicitSelf": true,
    "noHeader": true,
    "luaPlugins": [
      {
        "name": "./plugins/warcraft-numbers.ts"
      }
    ]
  },
  "exclude": [
    "src/**/*.test.ts"
  ]
}
