{
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./ts/node_modules/typescript-native/bin",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "js/ts.tsdk.additionalLocations": [
    "./ts/node_modules/typescript-native/bin"
