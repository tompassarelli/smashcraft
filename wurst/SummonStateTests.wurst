package SummonStateTests
import Wurst
import Simulation
import SummonPose
import SummonState
import SummonOriginalClipInfo
import MatchRules
import MatchStep
import ReplayState
import ReplayHistory
import ParticipantInputs

class SummonTestWorld
    FighterRoster world
    MatchState game = new MatchState()
    FrameInputs inputs = new FrameInputs()
    ReplayRuntimeState runtime = new ReplayRuntimeState()
    MatchFrameInput row = new MatchFrameInput()

    construct(int mask)
        world = new FighterRoster(mask)
        game.setHumanMask(mask)
        game.phase = MATCH
        game.timeLimitMinutes = 0
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                world.fighters[slot] = new FighterState(1, -240. + slot * 150., 1)

    function executeNext()
        row.capture(runtime.simulationFrame + 1, world.mask, inputs, runtime).assertTrue()
        row.execute(game, world, inputs, runtime, runtime.simulationFrame + 1).assertTrue()

@Test function summonSpawnSwipeQueueAndOriginalTiming()
    let state = new SummonState()
    let fighter = new FighterState(1, 0, 1)
    fighter.bearLife = 500
    fighter.bearX = 123
    fighter.bearZ = 42
    fighter.bearVelocityX = -14
    state.advance(fighter, 3)
    let spawn = state.projectBear(fighter, 3)
    spawn.visible.assertTrue()
    spawn.clipIndex.assertEquals(SUMMON_BEAR_WALK)
    spawn.seconds.assertEquals(0.)
    spawn.x.assertEquals(123.)
    spawn.z.assertEquals(42.)
    spawn.yaw.assertEquals(3.141592654)
    spawn.scale.assertEquals(0.8)
    state.advance(fighter, 3)
    state.bears[3].clipTime.assertEquals(1. / 60.)
    fighter.bearHitSerial++
    state.advance(fighter, 3)
    state.bears[3].clipIndex.assertEquals(SUMMON_BEAR_ATTACK)
    state.bears[3].queuedClip.assertEquals(SUMMON_BEAR_WALK)
    state.bears[3].clipTime.assertEquals(0.)
    let attack = summonClip(SUMMON_BEAR, SUMMON_BEAR_ATTACK)
    let attackDuration = attack.endSeconds - attack.startSeconds
    var elapsed = 0.
    while elapsed + 1. / 60. < attackDuration
        state.advance(fighter, 3)
        elapsed += 1. / 60.
        state.bears[3].clipIndex.assertEquals(SUMMON_BEAR_ATTACK)
    state.advance(fighter, 3)
    elapsed += 1. / 60.
    state.bears[3].clipIndex.assertEquals(SUMMON_BEAR_WALK)
    state.bears[3].queuedClip.assertEquals(-1)
    state.bears[3].clipTime.assertEquals(elapsed - attackDuration)
    let walk = summonClip(SUMMON_BEAR, SUMMON_BEAR_WALK)
    let walkDuration = walk.endSeconds - walk.startSeconds
    state.bears[3].advance(SUMMON_BEAR, walkDuration * 3.)
    (state.bears[3].clipTime - (elapsed - attackDuration)).abs().assertLessThan(0.00001)
    fighter.bearHitSerial++
    state.advance(fighter, 3)
    state.advance(fighter, 3)
    fighter.bearHitSerial++
    state.advance(fighter, 3)
    state.bears[3].clipIndex.assertEquals(SUMMON_BEAR_ATTACK)
    state.bears[3].clipTime.assertEquals(0.)
    fighter.bearLife = 0
    state.advance(fighter, 3)
    state.projectBear(fighter, 3).visible.assertFalse()
    fighter.bearLife = 500
    state.advance(fighter, 3)
    state.bears[3].clipIndex.assertEquals(SUMMON_BEAR_WALK)
    state.bears[3].clipTime.assertEquals(0.)

@Test function summonSnapshotBackwardRestoreAndRepeatedProjection()
    let fixture = new SummonTestWorld(9)
    let fighter = fixture.world.fighters[3]
    fighter.bearLife = 500
    fighter.bearX = fighter.x
    fighter.bearVelocityX = 0
    fixture.executeNext()
    fighter.bearHitSerial++
    fixture.executeNext()
    for frame = 1 to 4
        fixture.executeNext()
    let early = new ReplaySnapshot()
    early.capture(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    let earlyTime = fixture.runtime.summons.bears[3].clipTime
    let later = new ReplaySnapshot()
    for frame = 1 to 6
        fixture.executeNext()
    later.capture(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    early.restore(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    fixture.runtime.summons.bears[3].clipTime.assertEquals(earlyTime)
    fixture.runtime.summons.bears[3].queuedClip.assertEquals(SUMMON_BEAR_WALK)
    let rendered = new ReplaySnapshot()
    // Paused callbacks perform projection without executing a match frame.
    for callback = 1 to 20
        fixture.runtime.summons.projectBear(fixture.world.fighters[3], 3).seconds.assertEquals(earlyTime)
        fixture.runtime.summons.projectBear(null, 1).visible.assertFalse()
    rendered.capture(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    early.firstDifference(rendered).assertEquals("")
    early.firstPoseDifference(rendered).assertEquals("")
    fixture.runtime.summons.bears[3].clipTime += 1. / 60.
    rendered.capture(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    early.checksum().assertEquals(rendered.checksum())
    early.firstPoseDifference(rendered).assertEquals("summons.slot[3].clipTime")
    later.restore(fixture.world, fixture.game, fixture.inputs, fixture.runtime)
    (fixture.runtime.summons.bears[3].clipTime > earlyTime).assertTrue()
    fixture.runtime.resetPoses()
    fixture.runtime.summons.projectBear(fixture.world.fighters[3], 3).visible.assertFalse()

@Test function summonLateCorrectionRemovesAndRestoresSpawnAndSwipe()
    for initiallySummons = 0 to 1
        let fixture = new SummonTestWorld(9)
        fixture.world.fighters[3].x = -150
        let history = new ReplayHistory()
        history.beginEpochWithCorrections(92, 1, 12).assertTrue()
        for frame = 1 to 8
            fixture.inputs.inputs[0].specialPressed = frame == 1 and initiallySummons == 1
            fixture.inputs.inputs[0].specialX = frame == 1 ? initiallySummons : 0
            fixture.row.capture(frame, 9, fixture.inputs, fixture.runtime).assertTrue()
            history.saveSpeculative(92, fixture.row, fixture.world, fixture.game, fixture.inputs, fixture.runtime).assertTrue()
            fixture.row.execute(fixture.game, fixture.world, fixture.inputs, fixture.runtime, frame).assertTrue()
        fixture.runtime.summons.projectBear(fixture.world.fighters[0], 0).visible.assertEquals(initiallySummons == 1)
        if initiallySummons == 1
            fixture.runtime.summons.bears[0].clipIndex.assertEquals(SUMMON_BEAR_ATTACK)
            fixture.runtime.summons.bearHitSerial[0].assertEquals(1)
        let replacement = new FrameInputs()
        replacement.inputs[0].specialPressed = initiallySummons == 0
        replacement.inputs[0].specialX = 1 - initiallySummons
        let row = new MatchFrameInput()
        row.capture(1, 9, replacement, fixture.runtime).assertTrue()
        let corrections = new ReplayCorrections()
        corrections.beginEpoch(92).assertTrue()
        corrections.add(row).assertTrue()
        history.correct(92, corrections, fixture.world, fixture.game, fixture.inputs, fixture.runtime).assertEquals(1)
        let expected = new SummonTestWorld(9)
        expected.world.fighters[3].x = -150
        for frame = 1 to 8
            expected.inputs.inputs[0].specialPressed = frame == 1 and initiallySummons == 0
            expected.inputs.inputs[0].specialX = frame == 1 ? 1 - initiallySummons : 0
            expected.executeNext()
        fixture.runtime.summons.firstDifference(expected.runtime.summons).assertEquals("")
        fixture.runtime.summons.projectBear(fixture.world.fighters[0], 0).visible.assertEquals(initiallySummons == 0)
        fixture.runtime.summons.bearHitSerial[0].assertEquals(1 - initiallySummons)
        if initiallySummons == 0
            fixture.runtime.summons.bears[0].clipIndex.assertEquals(SUMMON_BEAR_ATTACK)
            (fixture.runtime.summons.bears[0].clipTime > 0.).assertTrue()

@Test function summonSparseFourSlotCatchupAndLifecycle()
    for maskIndex = 0 to 1
        let mask = maskIndex == 0 ? 9 : 15
        let sequential = new SummonTestWorld(mask)
        let catchup = new SummonTestWorld(mask)
        for frame = 1 to 8
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if sequential.world.active(slot) and frame == slot + 1
                    let a = sequential.world.fighters[slot]
                    let b = catchup.world.fighters[slot]
                    a.bearLife = 500
                    b.bearLife = 500
                    a.bearX = a.x
                    b.bearX = b.x
                    a.bearVelocityX = 0
                    b.bearVelocityX = 0
            sequential.executeNext()
            catchup.executeNext()
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if sequential.world.active(slot)
                    sequential.runtime.summons.projectBear(sequential.world.fighters[slot], slot)
                    sequential.runtime.summons.projectBear(sequential.world.fighters[slot], slot)
        sequential.runtime.summons.firstDifference(catchup.runtime.summons).assertEquals("")
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            sequential.runtime.summons.bears[slot].active.assertEquals(sequential.world.active(slot))
            if sequential.world.active(slot)
                (sequential.runtime.summons.bears[slot].clipTime - (7 - slot) / 60.).abs().assertLessThan(0.00001)
                sequential.runtime.summons.projectBear(sequential.world.fighters[slot], slot).x.assertEquals(-240. + slot * 150.)
        sequential.world.fighters[3].out = true
        sequential.world.fighters[3].respawn = 60
        sequential.executeNext()
        sequential.runtime.summons.bears[3].active.assertFalse()
        sequential.runtime.summons.projectBear(sequential.world.fighters[3], 3).visible.assertFalse()
        let empty = new SummonState()
        catchup.game.timeLimitMinutes = 1
        catchup.game.remainingFrames = 1
        catchup.executeNext()
        catchup.game.phase.assertEquals(RESULT)
        catchup.runtime.summons.firstDifference(empty).assertEquals("")
        sequential.game.phase = CHARACTER_MENU
        sequential.executeNext()
        sequential.runtime.summons.firstDifference(empty).assertEquals("")
