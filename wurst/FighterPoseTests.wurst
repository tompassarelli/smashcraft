package FighterPoseTests
import WorldTestSupport
import FighterPose
import DemonHunterAssetInfo
import Simulation
import MatchRules
import MatchStep
import ReplayState
import ReplayHistory
import CommandBuffer

@Test function poseHistoryRestoresFrameOwnedSelectionAndPhase()
    for character = 0 to 2
        let first = new FighterState(character, -200, 1)
        let second = new FighterState(1, 200, -1)
        let game = new MatchState()
        game.phase = MATCH
        game.timeLimitMinutes = 0
        let commands = new AttackBuffer(0)
        let secondCommands = new AttackBuffer(0)
        let requests = new AttackBuffer(0)
        let input = new InputSnapshot()
        let neutral = new InputSnapshot()
        let runtime = new ReplayRuntimeState()
        let row = new MatchFrameInput()
        let history = new ReplayHistory()
        let expected = new ReplaySnapshot()
        let actual = new ReplaySnapshot()
        history.beginEpoch(1, 1).assertTrue()
        for frame = 1 to 24
            input.direction = frame < 12 ? 1 : -1
            input.jumpPressed = frame == 4 or frame == 15
            input.jumpHeld = frame < 10
            row.capture(frame, 3, testControls(input, neutral, requests, requests), runtime).assertTrue()
            history.save(1, row, testWorld(first, second), game, testCommands(commands, secondCommands), runtime).assertTrue()
            row.execute(game, testWorld(first, second), testCommands(commands, secondCommands), runtime, frame).assertTrue()
        expected.capture(testWorld(first, second), game, testCommands(commands, secondCommands), runtime)
        history.replay(1, 8, 24, testWorld(first, second), game, testCommands(commands, secondCommands), runtime).assertTrue()
        actual.capture(testWorld(first, second), game, testCommands(commands, secondCommands), runtime)
        expected.firstDifference(actual).assertEquals("")
        expected.firstPoseDifference(actual).assertEquals("")
        let gameplayChecksum = actual.checksum()
        actual.runtime.poses[0].clipTime += 1.
        expected.firstPoseDifference(actual).assertEquals("pose[0].clipTime")
        actual.checksum().assertEquals(gameplayChecksum)

@Test function poseHitlagFreezesAndRepeatedHitRestarts()
    for character = 0 to 2
        let f = new FighterState(character, 0, 1)
        let input = new InputSnapshot()
        let pose = new FighterPose()
        f.hitstun = 20
        f.hitlag = 5
        pose.advance(f, input, false, false, false, true)
        let selected = pose.selectionSerial
        pose.clipTime.assertEquals(0.)
        pose.rate.assertEquals(0.)
        for frame = 1 to 4
            pose.advance(f, input, false, false, false, false)
            pose.selectionSerial.assertEquals(selected)
            pose.clipTime.assertEquals(0.)
        f.hitlag = 0
        pose.advance(f, input, false, false, false, false)
        pose.selectionSerial.assertEquals(selected)
        pose.advance(f, input, false, false, false, false)
        (pose.clipTime > 0.).assertTrue()
        f.hitlag = 3
        pose.advance(f, input, false, false, false, true)
        pose.selectionSerial.assertEquals(selected + 1)
        pose.clipTime.assertEquals(0.)
        f.frozenFrames = 10
        pose.advance(f, input, false, false, false, false)
        pose.clipTime.assertEquals(0.)
        pose.rate.assertEquals(0.)

@Test function poseDoubleJumpRestartsAndLandingKeepsEntryRate()
    let f = new FighterState(2, 0, 1)
    let input = new InputSnapshot()
    let pose = new FighterPose()
    f.grounded = false
    f.vz = 5
    pose.advance(f, input, false, true, false, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_JUMP_INDEX)
    pose.advance(f, input, false, false, false, false)
    (pose.clipTime > 0.).assertTrue()
    let selected = pose.selectionSerial
    f.jumpIsDouble = true
    pose.advance(f, input, false, true, false, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_DOUBLE_JUMP_INDEX)
    pose.selectionSerial.assertEquals(selected + 1)
    pose.clipTime.assertEquals(0.)
    f.specialFall = true
    pose.advance(f, input, false, false, false, false)
    f.specialFall = false
    f.grounded = true
    f.landingLag = 12
    pose.advance(f, input, false, false, false, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_LAND_SPECIAL_INDEX)
    let rate = pose.rate
    let landing = pose.selectionSerial
    f.landingLag = 11
    pose.advance(f, input, false, false, false, false)
    pose.rate.assertEquals(rate)
    pose.selectionSerial.assertEquals(landing)

@Test function poseSnapshotRemapsPriorGrabOwnerForEscape()
    let first = new FighterState(2, 0, 1)
    let second = new FighterState(1, 50, -1)
    let game = new MatchState()
    let runtime = new ReplayRuntimeState()
    let input = new InputSnapshot()
    let commands = new AttackBuffer(0)
    let snapshot = new ReplaySnapshot()
    first.grabOwner = second
    runtime.poses[0].advance(first, input, false, false, false, false)
    snapshot.capture(testWorld(first, second), game, testCommands(commands, commands), runtime)
    // Mutating the original holder must not mutate detached presentation history.
    second.grabAction = THROW_FORWARD
    snapshot.world.fighters[0].grabOwner = null
    snapshot.world.fighters[0].hitstun = 10
    snapshot.world.fighters[1].grabAction = GRAB_ESCAPE
    snapshot.runtime.poses[0].advance(snapshot.world.fighters[0], input, false, false, false, false)
    snapshot.runtime.poses[0].clipIndex.assertEquals(DEMON_HUNTER_GRAB_ESCAPE_INDEX)
    snapshot.runtime.poses[0].motion.escapeRemaining.assertEquals(10)

@Test function poseAttackRestartAndSmashReleaseKeepAuthoredSelection()
    let f = new FighterState(2, 0, 1)
    let input = new InputSnapshot()
    let pose = new FighterPose()
    f.attackStyle = 2
    f.attackFrame = 1
    f.attackDuration = attackDurationFramesForGrounding(2, true)
    pose.advance(f, input, false, false, true, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_UP_SMASH_INDEX)
    f.smashCharging = true
    pose.advance(f, input, false, false, false, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_UP_SMASH_CHARGE_INDEX)
    pose.rate.assertEquals(0.)
    f.smashCharging = false
    pose.advance(f, input, false, false, false, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_UP_SMASH_RELEASE_INDEX)
    pose.clipTime.assertEquals(0.)
    (pose.rate > 0.).assertTrue()
    pose.advance(f, input, false, false, false, false)
    (pose.clipTime > 0.).assertTrue()
    pose.advance(f, input, false, false, true, false)
    pose.clipIndex.assertEquals(DEMON_HUNTER_UP_SMASH_INDEX)
    pose.clipTime.assertEquals(0.)
