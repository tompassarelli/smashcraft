package ReplayHistoryTests
import ReplayHistory
import ReplayState
import MatchStep
import Simulation
import MatchRules
import CommandBuffer

class TapeWorld
    FighterState first = new FighterState(0, 0, 1)
    FighterState second = new FighterState(1, 100, -1)
    MatchState game = new MatchState()
    AttackBuffer firstCommands = new AttackBuffer(4)
    AttackBuffer secondCommands = new AttackBuffer(4)
    ReplayRuntimeState runtime = new ReplayRuntimeState()
    ReplaySnapshot snapshot = new ReplaySnapshot()

    construct(int startingStocks)
        game.phase = MATCH
        game.timeLimitMinutes = 0
        game.stockCount = startingStocks
        first.stocks = startingStocks
        second.stocks = startingStocks

    function capture()
        snapshot.capture(first, second, game, firstCommands, secondCommands, runtime)

    function execute(MatchFrameInput row)
        row.execute(game, first, second, firstCommands, secondCommands, runtime, row.frameNumber()).assertTrue()

    function save(ReplayHistory history, int epoch, MatchFrameInput row) returns boolean
        return history.save(epoch, row, first, second, game, firstCommands, secondCommands, runtime)

    function replay(ReplayHistory history, int epoch, int fromFrame, int throughFrame) returns boolean
        return history.replay(epoch, fromFrame, throughFrame, first, second, game, firstCommands, secondCommands, runtime)

    function saveSpeculative(ReplayHistory history, int epoch, MatchFrameInput row) returns boolean
        return history.saveSpeculative(epoch, row, first, second, game, firstCommands, secondCommands, runtime)

    function correct(ReplayHistory history, int epoch, ReplayCorrections corrections) returns int
        return history.correct(epoch, corrections, first, second, game, firstCommands, secondCommands, runtime)

    function restore(ReplayHistory history, int epoch, int frame) returns boolean
        return history.restore(epoch, frame, first, second, game, firstCommands, secondCommands, runtime)

@Test function historyWrapEpochAndInvalidRangesAreNonDestructive()
    let world = new TapeWorld(99)
    let history = new ReplayHistory()
    let row = new MatchFrameInput()
    let input = new InputSnapshot()
    let requests = new AttackBuffer(0)
    let before = new ReplaySnapshot()
    history.beginEpoch(7, 1).assertTrue()
    for frame = 1 to 65
        row.capture(frame, input, input, requests, requests, world.runtime).assertTrue()
        world.save(history, 7, row).assertTrue()
        world.save(history, 7, row).assertFalse()
        world.execute(row)
    history.contains(7, 1).assertFalse()
    history.contains(7, 2).assertTrue()
    history.contains(7, 65).assertTrue()
    history.contains(7, 66).assertFalse()
    before.capture(world.first, world.second, world.game, world.firstCommands, world.secondCommands, world.runtime)
    world.restore(history, 7, 1).assertFalse()
    world.restore(history, 6, 2).assertFalse()
    world.restore(history, 7, 66).assertFalse()
    world.replay(history, 7, 2, 66).assertFalse()
    world.replay(history, 7, 1, 65).assertFalse()
    world.replay(history, 7, 65, 64).assertFalse()
    world.capture()
    before.firstDifference(world.snapshot).assertEquals("")
    history.beginEpoch(7, 1).assertFalse()
    history.beginEpoch(6, 1).assertFalse()
    history.contains(7, 2).assertTrue()
    world.restore(history, 7, 2).assertTrue()
    world.runtime.simulationFrame.assertEquals(1)
    world.replay(history, 7, 2, 65).assertTrue()
    world.capture()
    before.firstDifference(world.snapshot).assertEquals("")
    history.beginEpoch(8, 1).assertTrue()
    history.contains(7, 65).assertFalse()
    history.contains(8, 65).assertFalse()
    world.restore(history, 8, 2).assertFalse()
    world.runtime.simulationFrame = 0
    row.reset()
    row.capture(1, input, input, requests, requests, world.runtime).assertTrue()
    world.save(history, 7, row).assertFalse()
    world.save(history, 8, row).assertTrue()
    history.contains(8, 1).assertTrue()

@Test function historyRejectsSkippedFramesAndSignedCounterOverflow()
    let world = new TapeWorld(99)
    let history = new ReplayHistory()
    let row = new MatchFrameInput()
    let input = new InputSnapshot()
    let requests = new AttackBuffer(0)
    history.beginEpoch(-1, 1).assertFalse()
    history.beginEpoch(0, 0).assertFalse()
    history.beginEpoch(0, 1).assertTrue()
    row.capture(2, input, input, requests, requests, world.runtime).assertTrue()
    world.save(history, 0, row).assertFalse()
    row.capture(1, input, input, requests, requests, world.runtime).assertTrue()
    world.runtime.simulationFrame = 1
    world.save(history, 0, row).assertFalse()
    world.runtime.simulationFrame = 0
    world.save(history, 0, row).assertTrue()
    history.beginEpoch(1, 2147483646).assertTrue()
    world.runtime.simulationFrame = 2147483645
    row.capture(2147483646, input, input, requests, requests, world.runtime).assertTrue()
    world.save(history, 1, row).assertTrue()
    world.execute(row)
    row.capture(2147483647, input, input, requests, requests, world.runtime).assertTrue()
    world.save(history, 1, row).assertFalse()
    history.contains(1, 2147483646).assertTrue()
    world.restore(history, 1, 2147483646).assertTrue()
    world.runtime.simulationFrame.assertEquals(2147483645)

public function runRecordedTape(int frames, int rollbackStride, int startingStocks)
    let canonical = new TapeWorld(startingStocks)
    let replayed = new TapeWorld(startingStocks)
    let history = new ReplayHistory()
    let row = new MatchFrameInput()
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstRequests = new AttackBuffer(0)
    let secondRequests = new AttackBuffer(0)
    history.beginEpoch(1, 1).assertTrue()
    var sawShieldStun = false
    var sawHitRegistry = false
    var sawProjectile = false
    var sawHitlag = false
    var sawDamage = false
    var sawRespawn = false
    for frame = 1 to frames
        // A deterministic input tape, independent of either world's evolving state.
        let phase = frame mod 192
        firstInput.direction = phase >= 96 and phase < 120 ? -1 : (phase >= 144 and phase < 168 ? 1 : 0)
        secondInput.direction = -firstInput.direction
        firstInput.jumpPressed = phase == 128
        firstInput.jumpHeld = phase >= 128 and phase < 142
        secondInput.shield = frame <= 16
        secondInput.techPressed = phase == 60
        secondInput.sdiPulse = phase mod 3 == 0
        secondInput.sdiX = phase mod 2 == 0 ? 1 : -1
        firstRequests.clear()
        secondRequests.clear()
        if frame == 1 or frame == 40
            firstRequests.enqueue(0, 1, frame, false)
        if phase >= 80 and phase mod 32 == 16
            firstRequests.enqueue(1, 1, frame, false)
        if phase == 160
            secondRequests.enqueue(6, -1, frame, false)
        // Exercise stock loss and respawn through recorded input, independently
        // of whether the preceding combat sequence happens to produce a KO.
        if frame >= 3000 and frame < 3300
            secondInput.direction = 1
            secondRequests.clear()
        row.capture(frame, firstInput, secondInput, firstRequests, secondRequests, canonical.runtime).assertTrue()
        replayed.save(history, 1, row).assertTrue()
        canonical.execute(row)
        replayed.execute(row)
        // Reuse producer storage before rollback; history must retain its own row.
        row.reset()
        firstInput.direction = 1
        firstInput.shield = true
        row.capture(frame, firstInput, firstInput, secondRequests, firstRequests, canonical.runtime).assertTrue()
        firstInput.shield = false
        if frame mod rollbackStride == 0
            replayed.replay(history, 1, max(1, frame - 5), frame).assertTrue()
        if frame mod 64 == 0
            replayed.replay(history, 1, frame - 63, frame).assertTrue()
        canonical.capture()
        replayed.capture()
        let difference = canonical.snapshot.firstDifference(replayed.snapshot)
        if difference != ""
            testFail("frame " + I2S(frame) + ": " + difference)
        sawDamage = sawDamage or canonical.second.damage > 0
        sawRespawn = sawRespawn or (canonical.second.stocks < startingStocks and not canonical.second.out and canonical.second.invincible > 0)
        sawShieldStun = sawShieldStun or canonical.second.shieldStun > 0
        sawHitRegistry = sawHitRegistry or canonical.second.lastHitAttacker == canonical.first
        sawProjectile = sawProjectile or projectileCount(canonical.first) > 0
        sawHitlag = sawHitlag or canonical.first.hitlag > 0 or canonical.second.hitlag > 0
    sawShieldStun.assertTrue()
    sawHitRegistry.assertTrue()
    sawProjectile.assertTrue()
    sawHitlag.assertTrue()
    canonical.first.attackSerial.assertGreaterThan(1)
    sawDamage.assertTrue()
    if frames >= 4096
        canonical.second.stocks.assertLessThan(startingStocks)
        sawRespawn.assertTrue()
    canonical.game.phase.assertEquals(MATCH)

@Test function recordedTapeMatchesIndependentRunAndRepeatedRollback()
    // One complete input cycle crosses the history ring and checks every recorded
    // combat event above; longer repetitions remain in ReplaySoak.
    runRecordedTape(192, 1, 99)

@Test function correctedPredictionsRefreshSnapshotsAcrossRingWrapAndSecondRollback()
    let canonical = new TapeWorld(99)
    let partiallyCorrected = new TapeWorld(99)
    let predicted = new TapeWorld(99)
    let canonicalHistory = new ReplayHistory()
    let history = new ReplayHistory()
    let corrections = new ReplayCorrections()
    corrections.beginEpoch(9).assertTrue()
    let row = new MatchFrameInput()
    let wrongRow = new MatchFrameInput()
    let retainedWitness = new MatchFrameInput()
    MatchFrameInput array[6] actual
    for i = 0 to 5
        actual[i] = new MatchFrameInput()
    let input = new InputSnapshot()
    let neutral = new InputSnapshot()
    let response = new InputSnapshot()
    let requests = new AttackBuffer(0)
    let noRequests = new AttackBuffer(0)
    history.beginEpochWithCorrections(9, 1, 6).assertTrue()
    canonicalHistory.beginEpoch(9, 1).assertTrue()
    for frame = 1 to 68
        response.direction = frame >= 65 ? 1 : 0
        input.direction = frame == 65 ? -1 : 0
        requests.clear()
        if frame == 63
            requests.enqueue(1, 1, frame, false)
        row.capture(frame, input, response, requests, noRequests, canonical.runtime).assertTrue()
        canonical.save(canonicalHistory, 9, row).assertTrue()
        canonical.execute(row)
        wrongRow.capture(frame, neutral, neutral, noRequests, noRequests, predicted.runtime).assertTrue()
        partiallyCorrected.execute(frame == 65 ? wrongRow : row)
        if frame >= 63
            row.copyTo(actual[frame - 63])
            if frame == 66 or frame == 68
                predicted.save(history, 9, row).assertTrue()
            else
                predicted.saveSpeculative(history, 9, frame == 63 or frame == 65 ? wrongRow : row).assertTrue()
        else
            predicted.save(history, 9, row).assertTrue()
        predicted.execute(frame == 63 or frame == 65 ? wrongRow : row)
    canonical.capture()
    predicted.capture()
    (canonical.snapshot.firstDifference(predicted.snapshot) != "").assertTrue()
    history.contains(9, 4).assertFalse()
    history.contains(9, 5).assertTrue()
    actual[0].copyTo(retainedWitness)
    // Arrival order differs from frame order. An identical row does not move
    // the rollback start; the earliest changed row does.
    corrections.add(actual[1]).assertTrue()
    corrections.add(actual[0]).assertTrue()
    predicted.correct(history, 9, corrections).assertEquals(63)
    actual[0].sameAs(retainedWitness).assertTrue()
    partiallyCorrected.capture()
    predicted.capture()
    partiallyCorrected.snapshot.firstDifference(predicted.snapshot).assertEquals("")
    corrections.clear()
    for i = 5 downto 2
        corrections.add(actual[i]).assertTrue()
    predicted.correct(history, 9, corrections).assertEquals(65)
    predicted.capture()
    canonical.snapshot.firstDifference(predicted.snapshot).assertEquals("")
    canonical.first.attackSerial.assertEquals(1)
    canonical.second.damage.assertGreaterThan(0.)
    (canonical.snapshot.firstDifference(partiallyCorrected.snapshot) != "").assertTrue()
    // Every snapshot after the first mismatch must now restore corrected state,
    // including frames overwritten during the second correction.
    for frame = 64 to 68
        predicted.restore(history, 9, frame).assertTrue()
        canonical.restore(canonicalHistory, 9, frame).assertTrue()
        predicted.capture()
        canonical.capture()
        canonical.snapshot.firstDifference(predicted.snapshot).assertEquals("")
    predicted.replay(history, 9, 64, 68).assertTrue()
    canonical.replay(canonicalHistory, 9, 64, 68).assertTrue()
    predicted.capture()
    canonical.capture()
    canonical.snapshot.firstDifference(predicted.snapshot).assertEquals("")
    predicted.correct(history, 9, corrections).assertEquals(REPLAY_CORRECTION_UNCHANGED)
    predicted.capture()
    canonical.snapshot.firstDifference(predicted.snapshot).assertEquals("")
    row.capture(69, neutral, neutral, noRequests, noRequests, predicted.runtime).assertTrue()
    predicted.saveSpeculative(history, 9, row).assertTrue()

@Test function correctionWindowAndIdenticalConfirmationControlSpeculation()
    let world = new TapeWorld(99)
    let history = new ReplayHistory()
    let corrections = new ReplayCorrections()
    corrections.beginEpoch(2).assertTrue()
    let first = new MatchFrameInput()
    let second = new MatchFrameInput()
    let third = new MatchFrameInput()
    let input = new InputSnapshot()
    let requests = new AttackBuffer(0)
    first.capture(1, input, input, requests, requests, world.runtime).assertTrue()
    history.beginEpoch(1, 1).assertTrue()
    world.saveSpeculative(history, 1, first).assertFalse()
    history.beginEpochWithCorrections(2, 1, 7).assertFalse()
    history.beginEpochWithCorrections(2, 1, -1).assertFalse()
    history.beginEpochWithCorrections(2, 1, 2).assertTrue()
    world.saveSpeculative(history, 2, first).assertTrue()
    world.execute(first)
    second.capture(2, input, input, requests, requests, world.runtime).assertTrue()
    world.saveSpeculative(history, 2, second).assertTrue()
    world.execute(second)
    third.capture(3, input, input, requests, requests, world.runtime).assertTrue()
    world.saveSpeculative(history, 2, third).assertFalse()
    world.save(history, 2, third).assertFalse()
    corrections.add(second).assertTrue()
    // A noncanonical live marker proves equal input causes no restore or step.
    world.first.damage = 12.5
    world.correct(history, 2, corrections).assertEquals(REPLAY_CORRECTION_UNCHANGED)
    world.first.damage.assertEquals(12.5)
    world.runtime.simulationFrame.assertEquals(2)
    world.saveSpeculative(history, 2, third).assertFalse()
    corrections.clear()
    corrections.add(first).assertTrue()
    world.correct(history, 2, corrections).assertEquals(REPLAY_CORRECTION_UNCHANGED)
    world.first.damage.assertEquals(12.5)
    world.saveSpeculative(history, 2, third).assertTrue()
    world.execute(third)
    history.beginEpochWithCorrections(3, 1, 1).assertTrue()
    world.correct(history, 2, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
    world.runtime.simulationFrame = 0
    world.correct(history, 3, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
    world.saveSpeculative(history, 3, first).assertTrue()
    world.execute(first)
    world.correct(history, 3, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
    world.saveSpeculative(history, 3, second).assertFalse()
    corrections.beginEpoch(3).assertTrue()
    corrections.add(first).assertTrue()
    world.correct(history, 3, corrections).assertEquals(REPLAY_CORRECTION_UNCHANGED)
    world.saveSpeculative(history, 3, second).assertTrue()

@Test function correctionPreflightRejectsWholeBatchWithoutChangingHistoryOrLiveState()
    let world = new TapeWorld(99)
    let history = new ReplayHistory()
    let corrections = new ReplayCorrections()
    corrections.beginEpoch(5).assertTrue()
    let row = new MatchFrameInput()
    let changed = new MatchFrameInput()
    let input = new InputSnapshot()
    let requests = new AttackBuffer(0)
    let before = new ReplaySnapshot()
    history.beginEpochWithCorrections(5, 1, 6).assertTrue()
    for frame = 1 to 66
        row.capture(frame, input, input, requests, requests, world.runtime).assertTrue()
        if frame >= 64
            world.saveSpeculative(history, 5, row).assertTrue()
        else
            world.save(history, 5, row).assertTrue()
        world.execute(row)
    before.capture(world.first, world.second, world.game, world.firstCommands, world.secondCommands, world.runtime)
    input.jumpPressed = true
    changed.capture(64, input, input, requests, requests, world.runtime).assertTrue()
    corrections.add(changed).assertTrue()
    world.correct(history, 4, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
    // Invalid future, overwritten and authoritative-conflict rows each reject
    // the preceding valid correction as part of the same atomic batch.
    for caseIndex = 0 to 2
        let badFrame = caseIndex == 0 ? 67 : (caseIndex == 1 ? 1 : 63)
        row.capture(badFrame, input, input, requests, requests, world.runtime).assertTrue()
        corrections.add(row).assertTrue()
        world.correct(history, 5, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
        world.capture()
        before.firstDifference(world.snapshot).assertEquals("")
        world.replay(history, 5, 64, 66).assertTrue()
        world.capture()
        before.firstDifference(world.snapshot).assertEquals("")
        corrections.clear()
        corrections.add(changed).assertTrue()
    world.restore(history, 5, 66).assertTrue()
    world.correct(history, 5, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)
    world.runtime.simulationFrame.assertEquals(65)
    world.replay(history, 5, 66, 66).assertTrue()
    world.correct(history, 5, corrections).assertEquals(64)
    world.capture()
    (before.firstDifference(world.snapshot) != "").assertTrue()
    // A corrected row is authoritative now; a conflicting second value fails.
    input.jumpPressed = false
    row.capture(64, input, input, requests, requests, world.runtime).assertTrue()
    corrections.clear()
    corrections.add(row).assertTrue()
    world.correct(history, 5, corrections).assertEquals(REPLAY_CORRECTION_REJECTED)

@Test function correctionBatchCopiesRowsBoundsStorageAndRejectsConflicts()
    let corrections = new ReplayCorrections()
    corrections.beginEpoch(1).assertTrue()
    let row = new MatchFrameInput()
    let copy = new MatchFrameInput()
    let input = new InputSnapshot()
    let requests = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    corrections.add(row).assertFalse()
    for frame = 1 to 6
        row.capture(frame, input, input, requests, requests, runtime).assertTrue()
        corrections.add(row).assertTrue()
    corrections.size().assertEquals(6)
    corrections.add(row).assertTrue()
    row.capture(7, input, input, requests, requests, runtime).assertTrue()
    corrections.add(row).assertFalse()
    input.specialPressed = true
    row.capture(6, input, input, requests, requests, runtime).assertTrue()
    corrections.add(row).assertFalse()
    corrections.copyRow(5, copy).assertTrue()
    copy.sameAs(row).assertFalse()
    input.specialPressed = false
    row.reset()
    row.capture(6, input, input, requests, requests, runtime).assertTrue()
    copy.sameAs(row).assertTrue()
    corrections.copyRow(-1, copy).assertFalse()
    corrections.copyRow(6, copy).assertFalse()
    copy.sameAs(row).assertTrue()
    corrections.clear()
    corrections.add(row).assertTrue()
    corrections.size().assertEquals(1)

@Test function replayFramePreservesDirectionalInfluenceMagnitudeAndDistinguishesCorrections()
    let world = new TapeWorld(3)
    let original = new MatchFrameInput()
    let copied = new MatchFrameInput()
    let changed = new MatchFrameInput()
    let input = new InputSnapshot()
    let neutral = new InputSnapshot()
    let requests = new AttackBuffer(0)
    input.diStickValid = true
    input.diStickX = 0.25
    input.diStickZ = 0.5
    original.capture(1, input, neutral, requests, requests, world.runtime).assertTrue()
    original.copyTo(copied)
    input.diStickZ = 1
    changed.capture(1, input, neutral, requests, requests, world.runtime).assertTrue()
    original.sameAs(changed).assertFalse()
    original.sameAs(copied).assertTrue()
    world.first.grounded = false
    world.first.z = 300
    world.first.knockbackX = 6
    world.first.hitlag = 1
    world.first.diPending = true
    world.execute(copied)
    world.first.diAngleDegrees.assertEquals(4.5, 0.00001)
    world.first.diSerial.assertEquals(1)
    input.diStickZ = 0.5
    input.diStickValid = false
    changed.reset()
    changed.capture(1, input, neutral, requests, requests, world.runtime).assertTrue()
    original.sameAs(changed).assertFalse()
