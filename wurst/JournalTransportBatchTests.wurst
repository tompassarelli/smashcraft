package JournalTransportBatchTests
import JournalTransportBatch
import JournalInputSource
import InputProtocol
import NetworkInput
import KeyBindings

@Test function transportBatchRetainsEveryOriginalEdgeAndFrame()
    let source = new JournalInputSource()
    let batch = new JournalTransportBatch()
    let received = new JournalTransportBatch()
    let packet = new InputPacket()
    let down = new NetworkInput()
    let up = new NetworkInput()
    let copied = new NetworkInput()
    down.assign(inputActionBit(ATTACK), inputActionBit(ATTACK), 0, 0, 0, 0, 0).assertTrue()
    up.assign(0, 0, inputActionBit(ATTACK), 0, 0, 0, 0).assertTrue()
    source.beginEpoch("batch", 7, 0, 0).assertTrue()
    packet.assign(7, 1, 2, down, up).assertTrue()
    let first = packet.encode()
    source.decode(first, 64).assertEquals(JOURNAL_READY)
    source.copyRow(0, copied).assertTrue()
    copied.sameAs(down).assertTrue()
    batch.append(first).assertTrue()
    source.sent().assertTrue()
    source.expectedFrame().assertEquals(3)
    batch.ready(false).assertFalse()
    batch.nextCallback()
    batch.ready(false).assertFalse()
    packet.assign(7, 3, 2, down, up).assertTrue()
    let second = packet.encode()
    source.decode(second, 64).assertEquals(JOURNAL_READY)
    batch.append(second).assertTrue()
    source.sent().assertTrue()
    batch.ready(false).assertTrue()
    batch.recordCount().assertEquals(4)
    received.decode(batch.encode()).assertTrue()
    received.packetWire(0).assertEquals(first)
    received.packetWire(1).assertEquals(second)
    received.firstFrameNumber().assertEquals(1)
    received.epochNumber().assertEquals(7)
    for index = 0 to 1
        packet.decode(received.packetWire(index)).assertTrue()
        packet.firstFrameNumber().assertEquals(1 + 2 * index)
        packet.copyRecord(0, copied).assertTrue()
        copied.sameAs(down).assertTrue()
        packet.copyRecord(1, copied).assertTrue()
        copied.sameAs(up).assertTrue()

@Test function lonePacketFlushesAfterTwoCallbacksOrAtPauseAndEnd()
    let batch = new JournalTransportBatch()
    let packet = new InputPacket()
    let row = new NetworkInput()
    packet.assign(8, 40, 1, row, row).assertTrue()
    batch.append(packet.encode()).assertTrue()
    batch.ready(false).assertFalse()
    batch.ready(true).assertTrue()
    batch.nextCallback()
    batch.ready(false).assertFalse()
    batch.nextCallback()
    batch.ready(false).assertTrue()
    batch.encode().assertEquals(packet.encode())
    batch.clear()
    batch.ready(true).assertFalse()
    batch.packetCount().assertEquals(0)

@Test function batchRejectsDiscontinuousOrPartialSecondPacketBeforeDelivery()
    let batch = new JournalTransportBatch()
    let packet = new InputPacket()
    let row = new NetworkInput()
    packet.assign(9, 1, 2, row, row).assertTrue()
    let first = packet.encode()
    packet.assign(9, 4, 2, row, row).assertTrue()
    batch.decode("B4" + first + "|" + packet.encode()).assertFalse()
    batch.packetCount().assertEquals(0)
    batch.decode("B4" + first + "|").assertFalse()
    batch.packetCount().assertEquals(0)
    packet.assign(10, 3, 2, row, row).assertTrue()
    batch.decode("B4" + first + "|" + packet.encode()).assertFalse()
    batch.packetCount().assertEquals(0)
