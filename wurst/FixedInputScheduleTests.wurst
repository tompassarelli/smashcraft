package FixedInputScheduleTests
import NetworkInput
import ParticipantInputs
import InputProtocol
import InputLedger
import FixedInputSchedule

function sampleAt(int captureFrame, int sender, NetworkInput row)
    row.assign((captureFrame * 7 + sender) mod 32768, (captureFrame * 13 + sender) mod 32768,
        (captureFrame * 3 + sender) mod 32768, captureFrame mod 255 - 127,
        (captureFrame + sender) mod 255 - 127, captureFrame mod 256, (captureFrame + sender) mod 256).assertTrue()

function rowAt(int frame, int delay, int sender, NetworkInput row)
    if frame <= delay
        row.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    else
        sampleAt(frame - delay, sender, row)

@Test function fixedScheduleSeedsEverySupportedDelayAndRequiresExplicitCompletion()
    let schedule = new FixedInputSchedule()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    let neutral = new NetworkInput()
    schedule.mayAdvance().assertFalse()
    schedule.captureTarget().assertEquals(0)
    schedule.captureLocal(0, first).assertEquals(FIXED_WRONG_EPOCH)
    for delay = 0 to 5
        if delay != 4
            schedule.beginEpoch(delay, delay, 3).assertTrue()
            schedule.nextFrameNumber().assertEquals(1)
            schedule.delayFrames().assertEquals(delay)
            schedule.knownThrough().assertEquals(delay)
            schedule.confirmedThrough().assertEquals(0)
            for frame = 1 to delay
                schedule.captureTarget().assertEquals(frame + delay)
                schedule.complete(delay, frame).assertFalse()
                schedule.readNext(delay, inputs).assertTrue()
                first.sameAs(neutral).assertTrue()
                second.sameAs(neutral).assertTrue()
                schedule.nextFrameNumber().assertEquals(frame)
                schedule.confirmedThrough().assertEquals(frame - 1)
                schedule.complete(delay, frame + 1).assertFalse()
                schedule.complete(delay, frame).assertTrue()
                schedule.complete(delay, frame).assertFalse()
            schedule.mayAdvance().assertFalse()
            schedule.readNext(delay, inputs).assertFalse()
            schedule.nextFrameNumber().assertEquals(delay + 1)

@Test function fixedScheduleCapturesOncePerOpportunityWithoutOpeningCommonGate()
    let schedule = new FixedInputSchedule()
    let sample = new NetworkInput()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    let original = new NetworkInput()
    let packet = new InputPacket()
    schedule.beginEpoch(1, 3, 3).assertTrue()
    sampleAt(1, 0, sample)
    sample.copyTo(original)
    schedule.captureLocal(1, sample).assertEquals(FIXED_CAPTURED)
    sampleAt(99, 0, sample)
    schedule.captureLocal(1, sample).assertEquals(FIXED_ALREADY_CAPTURED)
    schedule.copyPending(1, 4, first).assertTrue()
    first.sameAs(original).assertTrue()
    schedule.copyAccepted(1, 0, 4, second).assertFalse()
    schedule.knownThrough().assertEquals(3)
    for frame = 1 to 3
        schedule.readNext(1, inputs).assertTrue()
        schedule.complete(1, frame).assertTrue()
        schedule.captureLocal(1, sample).assertEquals(FIXED_CAPTURED)
    for service = 1 to 20
        sampleAt(service, 0, sample)
        schedule.captureLocal(1, sample).assertEquals(FIXED_ALREADY_CAPTURED)
        schedule.readNext(1, inputs).assertFalse()
        schedule.nextFrameNumber().assertEquals(4)
        schedule.captureTarget().assertEquals(7)
        schedule.knownThrough().assertEquals(3)
        schedule.confirmedThrough().assertEquals(3)
    // A successful local packet construction still is not common receipt.
    schedule.copyPending(1, 4, first).assertTrue()
    packet.assign(1, 4, 1, first, first).assertTrue()
    schedule.mayAdvance().assertFalse()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_ACCEPTED)
    schedule.mayAdvance().assertFalse()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_ACCEPTED)
    schedule.knownThrough().assertEquals(3)
    schedule.acceptSynchronized(1, packet).assertEquals(INPUT_ACCEPTED)
    schedule.knownThrough().assertEquals(4)
    schedule.confirmedThrough().assertEquals(3)
    schedule.nextFrameNumber().assertEquals(4)
    schedule.complete(1, 4).assertFalse()
    schedule.readNext(1, inputs).assertTrue()
    first.sameAs(original).assertTrue()
    second.sameAs(original).assertTrue()
    schedule.complete(1, 4).assertTrue()

@Test function fixedScheduleReadSetIsAtomicDetachedAndEpochChecked()
    let schedule = new FixedInputSchedule()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    let packet = new InputPacket()
    let row = new NetworkInput()
    schedule.beginEpoch(2, 2, 3).assertTrue()
    for frame = 1 to 2
        schedule.readNext(2, inputs).assertTrue()
        schedule.complete(2, frame).assertTrue()
    sampleAt(7, 0, first)
    sampleAt(8, 1, second)
    sampleAt(1, 0, row)
    packet.assign(2, 3, 1, row, row).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_ACCEPTED)
    schedule.readNext(2, inputs).assertFalse()
    first.heldMask().assertEquals(49)
    second.heldMask().assertEquals(57)
    sampleAt(1, 1, row)
    packet.assign(2, 3, 1, row, row).assertTrue()
    schedule.acceptSynchronized(1, packet).assertEquals(INPUT_ACCEPTED)
    schedule.readNext(1, inputs).assertFalse()
    schedule.readNext(2, null).assertFalse()
    first.heldMask().assertEquals(49)
    schedule.complete(2, 3).assertFalse()
    schedule.readNext(2, inputs).assertTrue()
    first.heldMask().assertEquals(7)
    second.heldMask().assertEquals(8)
    sampleAt(90, 0, first)
    schedule.readNext(2, inputs).assertTrue()
    first.heldMask().assertEquals(7)
    schedule.complete(1, 3).assertFalse()
    schedule.complete(2, 3).assertTrue()

@Test function fixedScheduleReturnsPacketErrorsAndRejectsWholeConflictingBatch()
    let schedule = new FixedInputSchedule()
    let packet = new InputPacket()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    let output = new NetworkInput()
    schedule.beginEpoch(1, 2, 3).assertTrue()
    sampleAt(4, 0, first)
    sampleAt(5, 0, second)
    packet.assign(1, 4, 1, second, second).assertTrue()
    schedule.receiveSynchronized(0, packet.encode()).assertEquals(INPUT_ACCEPTED)
    schedule.receiveSynchronized(0, packet.encode()).assertEquals(INPUT_ACCEPTED)
    packet.assign(1, 3, 2, first, first).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_CONFLICT)
    schedule.copyAccepted(1, 0, 3, output).assertFalse()
    schedule.copyAccepted(1, 0, 4, output).assertTrue()
    output.sameAs(second).assertTrue()
    schedule.receiveSynchronized(0, "I1").assertEquals(INPUT_MALFORMED)
    schedule.receiveSynchronized(2, packet.encode()).assertEquals(INPUT_WRONG_SENDER)
    packet.assign(0, 3, 1, first, first).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_WRONG_EPOCH)
    schedule.knownThrough().assertEquals(2)
    schedule.nextFrameNumber().assertEquals(1)

@Test function fixedScheduleBoundsFutureByCompletionRatherThanReceipt()
    let schedule = new FixedInputSchedule()
    let packet = new InputPacket()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    schedule.beginEpoch(1, 2, 3).assertTrue()
    for frame = 3 to 64
        packet.assign(1, frame, 1, first, first).assertTrue()
        schedule.acceptSynchronized(0, packet).assertEquals(INPUT_ACCEPTED)
        schedule.acceptSynchronized(1, packet).assertEquals(INPUT_ACCEPTED)
    schedule.knownThrough().assertEquals(64)
    schedule.confirmedThrough().assertEquals(0)
    schedule.nextFrameNumber().assertEquals(1)
    packet.assign(1, 64, 2, first, first).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_TOO_FAR_AHEAD)
    schedule.copyAccepted(1, 0, 65, second).assertFalse()
    schedule.readNext(1, inputs).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_TOO_FAR_AHEAD)
    schedule.complete(1, 1).assertTrue()
    schedule.acceptSynchronized(0, packet).assertEquals(INPUT_ACCEPTED)
    schedule.acceptSynchronized(1, packet).assertEquals(INPUT_ACCEPTED)
    schedule.knownThrough().assertEquals(65)
    schedule.confirmedThrough().assertEquals(1)

@Test function fixedScheduleEpochResetClearsPendingAndPreparedRows()
    let schedule = new FixedInputSchedule()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    schedule.beginEpoch(-1, 3, 3).assertFalse()
    schedule.beginEpoch(0, -1, 3).assertFalse()
    schedule.beginEpoch(0, 4, 3).assertFalse()
    schedule.beginEpoch(0, 3, 3).assertTrue()
    schedule.captureLocal(0, first).assertEquals(FIXED_CAPTURED)
    schedule.readNext(0, inputs).assertTrue()
    schedule.beginEpoch(0, 5, 3).assertFalse()
    schedule.beginEpoch(1, 4, 3).assertFalse()
    schedule.delayFrames().assertEquals(3)
    schedule.copyPending(0, 4, first).assertTrue()
    schedule.beginEpoch(1, 5, 3).assertTrue()
    schedule.epochNumber().assertEquals(1)
    schedule.nextFrameNumber().assertEquals(1)
    schedule.knownThrough().assertEquals(5)
    schedule.confirmedThrough().assertEquals(0)
    schedule.copyPending(1, 4, first).assertFalse()
    schedule.copyPending(0, 4, first).assertFalse()
    schedule.complete(0, 1).assertFalse()
    schedule.complete(1, 1).assertFalse()
    schedule.captureLocal(0, first).assertEquals(FIXED_WRONG_EPOCH)
    schedule.captureLocal(1, first).assertEquals(FIXED_CAPTURED)
    schedule.copyPending(1, 6, first).assertTrue()
    schedule.copyPending(1, -1, first).assertFalse()
    schedule.copyPending(1, 2147483647, first).assertFalse()
    schedule.beginEpoch(2147483647, 2, 3).assertTrue()
    schedule.beginEpoch(-2147483647, 3, 3).assertFalse()
    schedule.beginEpoch(2147483647, 3, 3).assertFalse()

@Test function fixedScheduleCaptureTargetsRejectSignedExhaustion()
    for delay = 2 to 5
        if delay != 4
            fixedCaptureTarget(1, delay).assertEquals(1 + delay)
            fixedCaptureTarget(INPUT_LAST_FRAME - delay, delay).assertEquals(INPUT_LAST_FRAME)
            fixedCaptureTarget(INPUT_LAST_FRAME - delay + 1, delay).assertEquals(0)
            fixedCaptureTarget(INPUT_LAST_FRAME, delay).assertEquals(0)
            fixedCaptureTarget(2147483647, delay).assertEquals(0)
            fixedCaptureTarget(-2147483647, delay).assertEquals(0)
            fixedCaptureTarget(0, delay).assertEquals(0)
    fixedCaptureTarget(1, -2147483647).assertEquals(0)
    fixedCaptureTarget(1, 2147483647).assertEquals(0)
    for delay = 0 to 1
        fixedCaptureTarget(1, delay).assertEquals(1 + delay)
        fixedCaptureTarget(INPUT_LAST_FRAME - delay, delay).assertEquals(INPUT_LAST_FRAME)
        fixedCaptureTarget(2147483647, delay).assertEquals(0)
        fixedCaptureTarget(0, delay).assertEquals(0)

// Compare every complete normalized row against its canonical capture tape,
// with receiver order, duplicate bursts, batch shape and wait counts differing.
@Test function fixedScheduleDeliveryOracleMatchesAcrossWaitsBatchesAndRingWrap()
    let ordered = new FixedInputSchedule()
    let reordered = new FixedInputSchedule()
    let packet = new InputPacket()
    let a = new NetworkInput()
    let b = new NetworkInput()
    let inputs = new ParticipantInputs()
    let first = inputs.row(0)
    let second = inputs.row(1)
    let otherInputs = new ParticipantInputs()
    let otherFirst = otherInputs.row(0)
    let otherSecond = otherInputs.row(1)
    ordered.beginEpoch(7, 3, 3).assertTrue()
    reordered.beginEpoch(7, 3, 3).assertTrue()
    for block = 0 to 49
        let start = block * 12 + 1
        for frame = start to start + 11
            for sender = 0 to 1
                rowAt(frame, 3, sender, a)
                packet.assign(7, frame, 1, a, a).assertTrue()
                ordered.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)
        // New service opportunities while stalled cannot edit assigned input.
        sampleAt(start, 0, a)
        reordered.captureLocal(7, a).assertEquals(FIXED_CAPTURED)
        for service = 1 to 4
            sampleAt(start + service, 0, a)
            reordered.captureLocal(7, a).assertEquals(FIXED_ALREADY_CAPTURED)
            reordered.nextFrameNumber().assertEquals(start)
        // All player 1 batches arrive before player 0; each player's batches
        // arrive newest first, so the oldest missing pair closes the final gap.
        for delivery = 0 to 11
            let sender = delivery < 6 ? 1 : 0
            let frame = start + (5 - delivery mod 6) * 2
            rowAt(frame, 3, sender, a)
            rowAt(frame + 1, 3, sender, b)
            packet.assign(7, frame, 2, a, b).assertTrue()
            reordered.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)
            reordered.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)
            reordered.confirmedThrough().assertEquals(start - 1)
            reordered.nextFrameNumber().assertEquals(start)
            if block > 0 and delivery < 11
                reordered.mayAdvance().assertFalse()
                reordered.readNext(7, inputs).assertFalse()
        reordered.knownThrough().assertEquals(start + 11)
        for frame = start to start + 11
            sampleAt(frame, 0, a)
            ordered.captureLocal(7, a).assertEquals(FIXED_CAPTURED)
            reordered.captureLocal(7, a).assertEquals(frame == start ? FIXED_ALREADY_CAPTURED : FIXED_CAPTURED)
            ordered.captureTarget().assertEquals(frame + 3)
            reordered.copyPending(7, frame + 3, b).assertTrue()
            b.sameAs(a).assertTrue()
            ordered.readNext(7, inputs).assertTrue()
            reordered.readNext(7, otherInputs).assertTrue()
            first.sameAs(otherFirst).assertTrue()
            second.sameAs(otherSecond).assertTrue()
            rowAt(frame, 3, 0, a)
            rowAt(frame, 3, 1, b)
            first.sameAs(a).assertTrue()
            second.sameAs(b).assertTrue()
            ordered.complete(7, frame).assertTrue()
            reordered.complete(7, frame).assertTrue()
            reordered.confirmedThrough().assertEquals(frame)
            reordered.nextFrameNumber().assertEquals(frame + 1)
    reordered.firstRetained().assertEquals(537)
    reordered.copyAccepted(7, 0, 536, a).assertFalse()
    reordered.copyAccepted(7, 0, 537, a).assertTrue()
    reordered.copyAccepted(7, 1, 600, a).assertTrue()
    reordered.copyPending(7, 536, a).assertFalse()
    reordered.copyPending(7, 537, a).assertTrue()
    reordered.copyPending(7, 603, a).assertTrue()
    packet.assign(7, 536, 1, a, a).assertTrue()
    reordered.acceptSynchronized(0, packet).assertEquals(INPUT_OUT_OF_HISTORY)
    reordered.beginEpoch(8, 2, 3).assertTrue()
    reordered.copyPending(8, 603, a).assertFalse()
    reordered.copyAccepted(8, 0, 537, a).assertFalse()

@Test function fourParticipantScheduleKeepsEveryRowAcrossRingReuse()
    let schedule = new FixedInputSchedule()
    let inputs = new ParticipantInputs()
    let sample = new NetworkInput()
    let expected = new NetworkInput()
    let packet = new InputPacket()
    schedule.beginEpoch(30, 0, 15).assertTrue()
    for frame = 1 to 300
        sampleAt(frame, 3, sample)
        schedule.captureLocal(30, sample).assertEquals(FIXED_CAPTURED)
        sample.assignThrowContributions(12, -9).assertTrue()
        schedule.captureLocal(30, sample).assertEquals(FIXED_ALREADY_CAPTURED)
        schedule.copyPending(30, frame, expected).assertTrue()
        sampleAt(frame, 3, sample)
        expected.sameAs(sample).assertTrue()
        for sender = 0 to 2
            sampleAt(frame, sender, sample)
            packet.assign(30, frame, 1, sample, sample).assertTrue()
            schedule.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)
        schedule.knownThrough().assertEquals(frame - 1)
        inputs.row(3).assign(27, 0, 0, 0, 0, 0, 0).assertTrue()
        schedule.readNext(30, inputs).assertFalse()
        inputs.row(3).heldMask().assertEquals(27)
        sampleAt(frame, 3, sample)
        packet.assign(30, frame, 1, sample, sample).assertTrue()
        schedule.acceptSynchronized(3, packet).assertEquals(INPUT_ACCEPTED)
        schedule.readNext(30, inputs).assertTrue()
        for sender = 0 to 3
            sampleAt(frame, sender, expected)
            inputs.row(sender).sameAs(expected).assertTrue()
        schedule.complete(30, frame).assertTrue()
    schedule.firstRetained().assertEquals(237)
    schedule.copyAccepted(30, 3, 236, sample).assertFalse()
    schedule.copyAccepted(30, 3, 237, sample).assertTrue()
    schedule.copyPending(30, 236, sample).assertFalse()
    schedule.copyPending(30, 237, sample).assertTrue()

@Test function sparseScheduleReadsOnlyActiveSlotsAndInvalidMembershipPreservesEpoch()
    let schedule = new FixedInputSchedule()
    let inputs = new ParticipantInputs()
    schedule.beginEpoch(1, 2, 13).assertTrue()
    inputs.row(1).assign(27, 9, 4, 1, -1, 3, 7).assertTrue()
    schedule.beginEpoch(2, 2, 0).assertFalse()
    schedule.participantMask().assertEquals(13)
    schedule.readNext(1, inputs).assertTrue()
    inputs.row(1).heldMask().assertEquals(27)
    for slot = 0 to 3
        if slot != 1
            inputs.row(slot).heldMask().assertEquals(0)
    schedule.complete(1, 1).assertTrue()
