package SelectionDragTests
import SelectionDrag

@Test function hoveringShowsHeldChipButDoesNotPlaceIt()
    let drag = new SelectionDrag()
    drag.update(true, false, 0.300, 0.370, 0, 0, false, 1, false, false)
    drag.hoverTile.assertEquals(0)
    drag.placeHovered().assertEquals(-1)
    drag.selectHeldChip(0, true)
    drag.update(true, false, 0.300, 0.370, 0, 0, false, 1, false, false)
    drag.placeHovered().assertEquals(0)
    drag.releasedSlot.assertEquals(0)
    destroy drag

@Test function clickPlacesAndRecallTargetsTheHeldChip()
    let drag = new SelectionDrag()
    drag.selectHeldChip(0, true)
    drag.update(true, true, 0.300, 0.370, 0, 0, false, 1, false, false)
    drag.update(true, false, 0.300, 0.370, 0, 0, false, 1, false, false).assertEquals(0)
    drag.releasedSlot.assertEquals(0)
    drag.recallHeld().assertEquals(0)
    drag.releasedSlot.assertEquals(0)
    destroy drag

@Test function selectedChipCanBeDraggedToAnotherPortrait()
    let drag = new SelectionDrag()
    drag.selectHeldChip(0, true)
    drag.update(true, true, 0.300, 0.370, 0, 0, true, 1, false, false)
    drag.update(true, true, 0.480, 0.370, 0, 0, true, 1, false, false).assertEquals(-1)
    drag.update(true, false, 0.480, 0.370, 0, 0, true, 1, false, false).assertEquals(1)
    drag.releasedSlot.assertEquals(0)
    destroy drag

@Test function cpuCanChooseSamePortraitAsHuman()
    let drag = new SelectionDrag()
    drag.selectHeldChip(1, true)
    drag.update(true, true, 0.300, 0.370, 0, 0, false, 1, false, true)
    drag.update(true, false, 0.300, 0.370, 0, 0, false, 1, false, true).assertEquals(0)
    drag.releasedSlot.assertEquals(1)
    destroy drag

@Test function onlyAnPlacedOpponentChipCanBeDragged()
    let drag = new SelectionDrag()
    drag.update(true, true, 0.523, 0.346, 0, 0, false, 1, false, true)
    drag.active.assertFalse()
    drag.update(true, false, 0.490, 0.370, 0, 0, false, 1, false, true).assertEquals(-1)
    destroy drag

@Test function disabledPanelClearsHoverAndHeldChip()
    let drag = new SelectionDrag()
    drag.selectHeldChip(0, true)
    drag.update(false, false, 0.300, 0.370, 0, 0, false, 1, false, false)
    drag.hoverTile.assertEquals(-1)
    drag.placeHovered().assertEquals(-1)
    destroy drag

@Test function selectingCpuCardChangesWhichChipAppearsOnHover()
    selectionCardSlot(0.300, 0.160, 0, true).assertEquals(1)
    selectionCardSlot(0.300, 0.160, 0, false).assertEquals(-1)
    selectionCardSlot(0.120, 0.160, 0, false).assertEquals(0)
    selectionCardSlot(0.120, 0.160, 1, true).assertEquals(-1)
    selectionCardSlot(0.300, 0.160, 1, true).assertEquals(1)
    selectionCardSlot(0.300, 0.310, 0, true).assertEquals(-1)

@Test function screenPixelsMapToCenteredFourByThreeFrames()
    selectionPointerX(960, 1920, 1080).assertEquals(0.4, 0.000001)
    selectionPointerY(540, 1080).assertEquals(0.3, 0.000001)
    selectionPointerX(240, 1920, 1080).assertEquals(0., 0.000001)
    selectionPointerX(0, 1440, 1080).assertEquals(0., 0.000001)

@Test function unplacedHumanAndCpuChipsDragFromTheirCardsOntoRoster()
    for slot = 0 to 1
        let drag = new SelectionDrag()
        drag.selectHeldChip(0, true)
        drag.update(true, true, 0.135 + slot * 0.175, 0.180, 0, 0, false, 1, false, true).assertEquals(-1)
        drag.active.assertTrue()
        drag.activeSlot.assertEquals(slot)
        drag.update(true, false, 0.480, 0.370, 0, 0, false, 1, false, true).assertEquals(1)
        drag.releasedSlot.assertEquals(slot)
        destroy drag

@Test function bothChipsCanSelectAndLeaveIllidanTile()
    selectionTile(0.660, 0.370).assertEquals(2)
    selectionTile(0.740, 0.370).assertEquals(-1)
    selectionTile(0.660, 0.280).assertEquals(-1)
    for slot = 0 to 1
        let drag = new SelectionDrag()
        drag.selectHeldChip(slot, true)
        drag.update(true, true, 0.660, 0.370, 0, 0, false, 1, false, true)
        drag.update(true, false, 0.660, 0.370, 0, 0, false, 1, false, true).assertEquals(2)
        drag.releasedSlot.assertEquals(slot)
        drag.update(true, true, selectionChipX(slot, 2) + 0.020, 0.346, 0, 2, true, 2, true, true)
        drag.activeSlot.assertEquals(slot)
        drag.update(true, false, 0.300, 0.370, 0, 2, true, 2, true, true).assertEquals(0)
        drag.releasedSlot.assertEquals(slot)
        destroy drag
