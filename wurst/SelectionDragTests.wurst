package SelectionDragTests
import SelectionDrag

@Test function holdMovesWithoutSelectingAndReleaseCommits()
    let drag = new SelectionDrag()
    drag.update(true, true, 0.292, 0.346, 0, 0).assertEquals(-1)
    drag.active.assertTrue()
    drag.update(true, true, 0.490, 0.370, 0, 0).assertEquals(-1)
    drag.update(true, false, 0.490, 0.370, 0, 0).assertEquals(1)
    drag.active.assertFalse()
    drag.update(true, false, 0.490, 0.370, 0, 0).assertEquals(-1)
    destroy drag

@Test function outsideDropAndOtherPlayersChipDoNotSelect()
    let drag = new SelectionDrag()
    drag.update(true, true, 0.292, 0.346, 0, 0)
    drag.update(true, false, 0.400, 0.370, 0, 0).assertEquals(-1)
    drag.update(true, true, 0.523, 0.346, 0, 0)
    drag.active.assertFalse()
    drag.update(true, false, 0.490, 0.370, 0, 0).assertEquals(-1)
    destroy drag

@Test function secondPlayersOwnChipAndOverlayCancellation()
    let drag = new SelectionDrag()
    drag.update(true, true, 0.523, 0.346, 1, 1)
    drag.active.assertTrue()
    drag.update(false, true, 0.292, 0.346, 1, 1)
    drag.active.assertFalse()
    drag.update(true, false, 0.292, 0.346, 1, 1).assertEquals(-1)
    destroy drag

@Test function screenPixelsMapToCenteredFourByThreeFrames()
    selectionPointerX(960, 1920, 1080).assertEquals(0.4, 0.000001)
    selectionPointerY(540, 1080).assertEquals(0.3, 0.000001)
    selectionPointerX(240, 1920, 1080).assertEquals(0., 0.000001)
    selectionPointerX(0, 1440, 1080).assertEquals(0., 0.000001)
