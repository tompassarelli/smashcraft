package KeyboardInputCapture
import KeyBindings
import NetworkInput
import FixedInputSchedule
import DirectionalInput

// Construct in common initialization. Sampling and capture mutate only this
// client's preallocated numerical input storage.
public class KeyboardInputCapture
    private int held = 0
    private int pressed = 0
    private int released = 0
    private int specialX = 0
    private int specialZ = 0
    private int dodgeX = 0
    private int dodgeZ = 0
    private int ledgeVertical = 0
    private int throwX = 0
    private int throwZ = 0
    private DirectionalInput directions = new DirectionalInput()
    private NetworkInput scratch = new NetworkInput()

    private function heldValueIn(int heldActions, int action) returns int
        return (heldActions div inputActionBit(action)) mod 2

    private function horizontalIn(int heldActions) returns int
        return heldValueIn(heldActions, MOVE_RIGHT) - heldValueIn(heldActions, MOVE_LEFT)

    private function verticalIn(int heldActions) returns int
        return heldValueIn(heldActions, MOVE_UP) - heldValueIn(heldActions, MOVE_DOWN)

    private function boundedThrowCount(int count) returns int
        return count < -INPUT_THROW_CONTRIBUTION_LIMIT ? -INPUT_THROW_CONTRIBUTION_LIMIT :
            (count > INPUT_THROW_CONTRIBUTION_LIMIT ? INPUT_THROW_CONTRIBUTION_LIMIT : count)

    function sample(int heldActions) returns boolean
        if heldActions < 0 or heldActions > INPUT_ACTION_MASK
            return false
        let previous = held
        let specialBit = inputActionBit(SPECIAL)
        let specialWasPending = (pressed div specialBit) mod 2 == 1
        let specialRose = heldValueIn(previous, SPECIAL) == 0 and heldValueIn(heldActions, SPECIAL) == 1
        let leftTriggerRose = heldValueIn(previous, LEFT_TRIGGER) == 0 and heldValueIn(heldActions, LEFT_TRIGGER) == 1
        let rightTriggerRose = heldValueIn(previous, RIGHT_TRIGGER) == 0 and heldValueIn(heldActions, RIGHT_TRIGGER) == 1
        let upRose = heldValueIn(previous, MOVE_UP) == 0 and heldValueIn(heldActions, MOVE_UP) == 1
        let downRose = heldValueIn(previous, MOVE_DOWN) == 0 and heldValueIn(heldActions, MOVE_DOWN) == 1
        var throwXDelta = 0
        var throwZDelta = 0
        for action = 0 to ACTION_COUNT - 1
            let bit = inputActionBit(action)
            let before = (held div bit) mod 2 == 1
            let after = (heldActions div bit) mod 2 == 1
            if after and not before and (pressed div bit) mod 2 == 0
                pressed += bit
            if before and not after and (released div bit) mod 2 == 0
                released += bit
            if after and not before
                if action == MOVE_LEFT or action == SMASH_LEFT
                    throwXDelta--
                else if action == MOVE_RIGHT or action == SMASH_RIGHT
                    throwXDelta++
                else if action == MOVE_DOWN or action == SMASH_DOWN
                    throwZDelta--
                else if action == MOVE_UP or action == SMASH_UP
                    throwZDelta++
        throwX = boundedThrowCount(throwX + throwXDelta)
        throwZ = boundedThrowCount(throwZ + throwZDelta)
        // Keep the first uncommitted Special direction. Polling identifies the
        // sampled held directions, but cannot recover ordering between keys
        // that change between two calls to sample().
        if specialRose and not specialWasPending
            specialX = horizontalIn(heldActions)
            specialZ = verticalIn(heldActions)
        // The native callback overwrites dodge intent for each fresh shield
        // trigger, so retain the latest observed trigger-press sample.
        if leftTriggerRose or rightTriggerRose
            dodgeX = horizontalIn(heldActions)
            dodgeZ = verticalIn(heldActions)
        // Intra-row up/down order is unavailable; opposing edges cancel.
        if upRose or downRose
            ledgeVertical = upRose == downRose ? 0 : (upRose ? 1 : -1)
        directions.update(horizontalIn(heldActions), verticalIn(heldActions))
        held = heldActions
        return true

    private function heldValue(int action) returns int
        return (held div inputActionBit(action)) mod 2

    // Opposite keyboard directions cancel; C-stick actions never set movement
    // axes. Multiple physical transitions coalesce to one edge of each kind.
    function read(NetworkInput destination)
        destination.assign(held, pressed, released,
            127 * (heldValue(MOVE_RIGHT) - heldValue(MOVE_LEFT)),
            127 * (heldValue(MOVE_UP) - heldValue(MOVE_DOWN)),
            255 * heldValue(LEFT_TRIGGER), 255 * heldValue(RIGHT_TRIGGER))
        destination.assignPressData(specialX, specialZ, dodgeX, dodgeZ,
            directions.pulsePending, directions.pulseX, directions.pulseZ, ledgeVertical)
        destination.assignThrowContributions(throwX, throwZ)

    function capture(FixedInputSchedule schedule, int epoch) returns int
        read(scratch)
        let result = schedule.captureLocal(epoch, scratch)
        if result == FIXED_CAPTURED
            pressed = 0
            released = 0
            specialX = 0
            specialZ = 0
            dodgeX = 0
            dodgeZ = 0
            ledgeVertical = 0
            throwX = 0
            throwZ = 0
            directions.clearPulse()
        return result

    // Resume from current hardware holds without inventing new press edges.
    // A new epoch may start from neutral. Focus loss during play uses sample(0)
    // instead so its release edges reach the next committed row.
    function reset(int heldActions) returns boolean
        if heldActions < 0 or heldActions > INPUT_ACTION_MASK
            return false
        held = heldActions
        pressed = 0
        released = 0
        specialX = 0
        specialZ = 0
        dodgeX = 0
        dodgeZ = 0
        ledgeVertical = 0
        throwX = 0
        throwZ = 0
        directions.clear()
        directions.update(horizontalIn(heldActions), verticalIn(heldActions))
        directions.clearPulse()
        return true
