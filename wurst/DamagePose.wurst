package DamagePose
import Simulation

public constant int DAMAGE_POSE_NONE = 0
public constant int DAMAGE_POSE_GROUND = 1
public constant int DAMAGE_POSE_AIR = 2
public constant int DAMAGE_POSE_TUMBLE = 3
public constant int DAMAGE_POSE_SHIELD = 4

// Numerical presentation selection only; native poses never feed combat.
public function damagePose(FighterState f) returns int
    if f.out or f.frozenFrames > 0 or f.shieldBreakState != SHIELD_BREAK_NONE or f.ledgeState != LEDGE_NONE
        return DAMAGE_POSE_NONE
    if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE
        return DAMAGE_POSE_NONE
    if f.hitstun > 0 and (f.grounded or (f.hitlag > 0 and f.sdiWasGrounded))
        return DAMAGE_POSE_GROUND
    if isTumbling(f)
        return DAMAGE_POSE_TUMBLE
    if f.hitstun > 0
        return DAMAGE_POSE_AIR
    if f.shield and f.shieldStun > 0
        return DAMAGE_POSE_SHIELD
    return DAMAGE_POSE_NONE
