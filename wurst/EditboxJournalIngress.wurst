package EditboxJournalIngress
import Wurst
import JournalTextStream
import VocabularyIngress

public constant int EDITBOX_JOURNAL_CAPACITY = 4096

// getText/setText run consecutively on the engine thread. Remove only the
// admitted prefix; retain an incomplete suffix and later appended packets.
public class EditboxJournalIngress
    private framehandle inputBox
    private framehandle nativeChat
    private int chatSerial = 0
    private int chatState = 0
    private framehandle pauseLabel
    private JournalTextStream stream = new JournalTextStream()
    private string failure = ""
    private boolean active = false
    private string build = ""
    private int epoch = 0
    private int slot = 0
    private int ackTicks = 0
    private boolean ackDirty = false
    private int ackRevision = 0

    construct()
        nativeChat = BlzGetFrameByName("ChatEditBar", 0)
        inputBox = createFrame("EDITBOX", "JournalControllerInput", GAME_UI, "EscMenuEditBoxTemplate", 969)
        inputBox.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.04, 0.55)
        inputBox.setSize(0.72, 0.035)
        inputBox.setTextSizeLimit(EDITBOX_JOURNAL_CAPACITY)
        inputBox.setVisible(false)
        pauseLabel = createTextFrame("JournalPauseHelp", GAME_UI, 970)
        pauseLabel.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.61, 0.49)
        pauseLabel.setSize(0.15, 0.025)
        pauseLabel.setVisible(false)

    function onEnter(code callback)
        let entered = CreateTrigger()
        BlzTriggerRegisterFrameEvent(entered, inputBox, FRAMEEVENT_EDITBOX_ENTER)
        TriggerAddAction(entered, callback)

    function requestChat(int serial)
        if not active or chatState != 0
            return
        chatSerial = serial
        chatState = 1
        inputBox.setFocus(GetLocalPlayer(), true)
        writeAck()

    // Q means the helper has consumed its last receipt and stopped all output.
    // Keep receiver focus until then, including during pause acknowledgment.
    function serviceChat(boolean paused) returns boolean
        if not active or chatState == 0
            return false
        if chatState == 1 and paused
            let path = "smashcraft-journal-chat-" + build + "-e" + I2S(epoch) + "-s" + I2S(slot) + "-n" + I2S(chatSerial) + ".pld"
            if vocabularyReadTooltip(path) == "Q"
                inputBox.setFocus(GetLocalPlayer(), false)
                inputBox.setVisible(false)
                chatState = 2
                writeAck()
        else if chatState == 2 and nativeChat != null and nativeChat.isVisible()
            chatState = 3
            writeAck()
        else if chatState == 3 and not nativeChat.isVisible()
            inputBox.setText(GetLocalPlayer(), "")
            inputBox.setVisible(true)
            inputBox.setFocus(GetLocalPlayer(), true)
            chatState = 0
            writeAck()
            return true
        return false

    function chatSequence() returns int
        return chatSerial

    function beginEpoch(string buildId, int newEpoch, int localSlot)
        build = buildId
        epoch = newEpoch
        slot = localSlot
        ackRevision = 0
        chatSerial = 0
        chatState = 0
        stream.reset(epoch)
        failure = ""
        if inputBox.getTextSizeLimit() < EDITBOX_JOURNAL_CAPACITY
            failure = "controller text capacity was not accepted"
        active = true
        inputBox.setText(GetLocalPlayer(), "")
        inputBox.setVisible(true)
        inputBox.setFocus(GetLocalPlayer(), true)
        pauseLabel.setVisible(true)
        writeAck()

    private function writeAck()
        ackRevision++
        PreloadGenClear()
        PreloadGenStart()
        Preload("SMASHCRAFT TEXT ACK v=1 build=" + build + " epoch=" + I2S(epoch) + " slot=" + I2S(slot) + " received=" + I2S(stream.received()) + " consumed=" + I2S(stream.acknowledged()) + " revision=" + I2S(ackRevision) + " chat=" + I2S(chatSerial) + " chatState=" + I2S(chatState) + " chatFrame=" + (nativeChat != null ? "1" : "0"))
        PreloadGenEnd("smashcraft-journal-text-ack-" + build + "-e" + I2S(epoch) + "-p" + I2S(slot) + ".txt")
        ackTicks = 0
        ackDirty = false

    function tick()
        if not active
            return
        ackTicks++
        if ackDirty and ackTicks >= 6
            writeAck()

    function flushReceipt()
        if active
            writeAck()

    function endEpoch()
        if not active
            return
        writeAck()
        active = false
        inputBox.setFocus(GetLocalPlayer(), false)
        inputBox.setVisible(false)
        pauseLabel.setVisible(false)
        inputBox.setText(GetLocalPlayer(), "")

    function updatePauseLabel(boolean paused, boolean pending, boolean targetPaused)
        if active
            pauseLabel.setText(chatState == 1 ? "Opening chat…" : (chatState > 1 ? "Chat — match paused" : (pending ? (targetPaused ? "Pausing…" : "Resuming…") : (paused ? "Resume: Start" : "Pause: Start"))))

    function failed() returns string
        return failure

    function peek() returns string
        if not active or chatState >= 2 or failure != "" or not BlzIsLocalClientActive()
            return ""
        for attempt = 1 to JOURNAL_TEXT_WINDOW
            let text = inputBox.getText()
            let state = stream.inspect(text)
            if state == JOURNAL_TEXT_READY
                inputBox.setText(GetLocalPlayer(), text.substring(stream.discardWidth()))
                ackDirty = true
            else if state == JOURNAL_TEXT_SKIP
                inputBox.setText(GetLocalPlayer(), text.substring(stream.discardWidth()))
                ackDirty = true
            if state == JOURNAL_TEXT_INVALID
                failure = "controller record changed or exceeded the bounded receive window"
                return ""
            if state == JOURNAL_TEXT_WAIT
                if text.length() >= EDITBOX_JOURNAL_CAPACITY
                    failure = "controller text capacity reached"
                    return ""
                ackDirty = true
                break
        return stream.wire()

    function consumed() returns boolean
        if not stream.consumed()
            failure = "controller text changed during admission"
            return false
        ackDirty = true
        return true
