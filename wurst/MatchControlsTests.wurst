package MatchControlsTests
import MatchControls
import MatchRules

@Test function yConfirmsSelectionStageAndRematch()
	let controls = new MatchControls()
	controls.keyDown(0, CHARACTER_MENU, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyUp(0)
	controls.keyDown(1, STAGE_MENU, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyUp(1)
	controls.keyDown(0, RESULT, false).assertEquals(START_PAUSE_CONFIRM)
	controls.isPaused().assertFalse()
	destroy controls

@Test function yPausesAndResumesOnlyOnFreshPress()
	let controls = new MatchControls()
	controls.keyDown(0, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertTrue()
	controls.keyDown(0, MATCH, false).assertEquals(START_PAUSE_NONE)
	controls.isPaused().assertTrue()
	controls.keyUp(0)
	controls.keyDown(0, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertFalse()
	destroy controls

@Test function deferredJournalPauseChangesOnlyWhenTheAcknowledgmentCommits()
	let controls = new MatchControls()
	controls.keyDownDeferred(0, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertFalse()
	controls.setPaused(true)
	controls.isPaused().assertTrue()
	controls.keyUp(0)
	controls.keyDownDeferred(0, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertTrue()
	controls.setPaused(false)
	controls.isPaused().assertFalse()
	destroy controls

@Test function pauseIsSharedAndSimultaneousPlayerPressDoesNotUndoIt()
	let controls = new MatchControls()
	controls.keyDown(0, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.keyDown(1, MATCH, false).assertEquals(START_PAUSE_NONE)
	controls.isPaused().assertTrue()
	controls.keyUp(0)
	controls.keyUp(1)
	controls.keyDown(1, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertFalse()
	destroy controls

@Test function yInSettingsDoesNotConfirmOrPause()
	let controls = new MatchControls()
	controls.keyDown(0, CHARACTER_MENU, true).assertEquals(START_PAUSE_NONE)
	controls.keyUp(0)
	controls.keyDown(0, MATCH, true).assertEquals(START_PAUSE_NONE)
	controls.isPaused().assertFalse()
	destroy controls

@Test function overlappingMenuPressesCannotConfirmTwoPhasesAtOnce()
	let controls = new MatchControls()
	controls.keyDown(0, CHARACTER_MENU, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyDown(1, STAGE_MENU, false).assertEquals(START_PAUSE_NONE)
	controls.keyUp(0)
	controls.keyUp(1)
	controls.keyDown(1, STAGE_MENU, false).assertEquals(START_PAUSE_CONFIRM)
	destroy controls

@Test function allFourSlotsShareOnePauseLatch()
	let controls = new MatchControls()
	controls.keyDown(3, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertTrue()
	controls.keyDown(2, MATCH, false).assertEquals(START_PAUSE_NONE)
	controls.keyUp(3)
	controls.keyUp(2)
	controls.keyDown(2, MATCH, false).assertEquals(START_PAUSE_TOGGLED)
	controls.isPaused().assertFalse()
	controls.keyUp(2)
	controls.keyDown(3, RESULT, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyDown(4, MATCH, false).assertEquals(START_PAUSE_NONE)
	destroy controls

@Test function overlappingResultPressesConfirmEachPlayersRematch()
	let controls = new MatchControls()
	controls.keyDown(0, RESULT, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyDown(1, RESULT, false).assertEquals(START_PAUSE_CONFIRM)
	controls.keyDown(1, RESULT, false).assertEquals(START_PAUSE_NONE)
	controls.keyDown(2, CHARACTER_MENU, false).assertEquals(START_PAUSE_NONE)
	controls.isPaused().assertFalse()
	destroy controls
