package InputLedger
import NetworkInput
import ParticipantInputs
import InputProtocol

public constant int INPUT_LEDGER_CAPACITY = 256
public constant int INPUT_FUTURE_LIMIT = 64
public constant int INPUT_ACCEPTED = 0
public constant int INPUT_MALFORMED = 1
public constant int INPUT_WRONG_EPOCH = 2
public constant int INPUT_WRONG_SENDER = 3
public constant int INPUT_OUT_OF_HISTORY = 4
public constant int INPUT_TOO_FAR_AHEAD = 5
public constant int INPUT_CONFLICT = 6
public constant int INPUT_STORAGE_FULL = 7

// Common construction preallocates every row and receive scratch object. No
// accept/read/predict/reset operation allocates or destroys Wurst objects.
public class InputLedger
    private NetworkInput array[INPUT_LEDGER_CAPACITY * INPUT_PARTICIPANT_CAPACITY] rows
    private int array[INPUT_LEDGER_CAPACITY * INPUT_PARTICIPANT_CAPACITY] frames
    private InputPacket packet = new InputPacket()
    private NetworkInput firstScratch = new NetworkInput()
    private NetworkInput secondScratch = new NetworkInput()
    private NetworkInput neutral = new NetworkInput()
    private int activeMask = 0
    private int epoch = -1
    private int retainedFrom = 1
    private int consumed = 0
    private int known = 0

    construct()
        for i = 0 to INPUT_LEDGER_CAPACITY * INPUT_PARTICIPANT_CAPACITY - 1
            rows[i] = new NetworkInput()
            frames[i] = -1

    // Normal matches start at 1: seed 1..D, corresponding to proposal 0..D-1.
    // Explicit firstFrame also supports bounded imported/resumed frame ranges.
    function beginEpoch(int newEpoch, int firstFrame, int delay, int participants) returns boolean
        if not validParticipantMask(participants) or newEpoch <= epoch or firstFrame < 1 or firstFrame > INPUT_LAST_FRAME or delay < 0 or delay > INPUT_FUTURE_LIMIT
            return false
        if delay > 0 and firstFrame > INPUT_LAST_FRAME - (delay - 1)
            return false
        activeMask = participants
        epoch = newEpoch
        retainedFrom = firstFrame
        consumed = firstFrame - 1
        known = firstFrame - 1
        for i = 0 to INPUT_LEDGER_CAPACITY * INPUT_PARTICIPANT_CAPACITY - 1
            frames[i] = -1
        for i = 0 to delay - 1
            let frame = firstFrame + i
            let index = (frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY
            for sender = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if isActive(sender)
                    neutral.copyTo(rows[index + sender])
                    frames[index + sender] = frame
            known = frame
        return true

    function participantMask() returns int
        return activeMask

    function isActive(int sender) returns boolean
        return participantIsActive(activeMask, sender)

    private function allPresent(int frame) returns boolean
        for sender = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if isActive(sender) and not contains(epoch, sender, frame)
                return false
        return true

    function epochNumber() returns int
        return epoch

    function knownThrough() returns int
        return known

    function consumedThrough() returns int
        return consumed

    function firstRetained() returns int
        return retainedFrom

    function contains(int requestedEpoch, int sender, int frame) returns boolean
        if epoch < 0 or requestedEpoch != epoch or not isActive(sender) or frame < retainedFrom or frame > INPUT_LAST_FRAME
            return false
        if frame - retainedFrom >= INPUT_LEDGER_CAPACITY
            return false
        return frames[(frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY + sender] == frame

    function copyAccepted(int requestedEpoch, int sender, int frame, NetworkInput destination) returns boolean
        if not contains(requestedEpoch, sender, frame)
            return false
        rows[(frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY + sender].copyTo(destination)
        return true

    function predictFrom(int requestedEpoch, int sender, int frame, NetworkInput destination) returns boolean
        if not contains(requestedEpoch, sender, frame)
            return false
        rows[(frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY + sender].predictTo(destination)
        return true

    // The caller acknowledges actual common consumption in order. Future bounds
    // move only here, never merely because remote rows advanced K.
    function markConsumed(int requestedEpoch, int frame) returns boolean
        if epoch < 0 or requestedEpoch != epoch or frame > known or frame != consumed + 1
            return false
        consumed = frame
        return true

    // Caller releases replay consumers first. Consumption permits discard, but
    // does not itself discard history. Retained or unconsumed rows never overwrite.
    function discardThrough(int requestedEpoch, int frame) returns boolean
        if epoch < 0 or requestedEpoch != epoch or frame < retainedFrom - 1 or frame > consumed
            return false
        for oldFrame = retainedFrom to frame
            let index = (oldFrame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY
            for sender = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                frames[index + sender] = -1
        retainedFrom = frame + 1
        return true

    private function validateRow(int sender, int frame, NetworkInput row) returns int
        if frame < retainedFrom
            return INPUT_OUT_OF_HISTORY
        if frame > consumed and frame - consumed > INPUT_FUTURE_LIMIT
            return INPUT_TOO_FAR_AHEAD
        if frame - retainedFrom >= INPUT_LEDGER_CAPACITY
            return INPUT_STORAGE_FULL
        let index = (frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY + sender
        if frames[index] == frame
            return rows[index].sameAs(row) ? INPUT_ACCEPTED : INPUT_CONFLICT
        if frames[index] != -1
            return INPUT_STORAGE_FULL
        return INPUT_ACCEPTED

    private function commitRow(int sender, int frame, NetworkInput row)
        let index = (frame mod INPUT_LEDGER_CAPACITY) * INPUT_PARTICIPANT_CAPACITY + sender
        if frames[index] != frame
            row.copyTo(rows[index])
            frames[index] = frame

    // Only the receiver's event-derived slot is authoritative. Do not call from
    // local sampling or pending-input storage: those are separate scheduler data.
    function acceptPacket(int sender, InputPacket incoming) returns int
        if sender < 0 or sender >= INPUT_PARTICIPANT_CAPACITY or (epoch >= 0 and not isActive(sender))
            return INPUT_WRONG_SENDER
        let count = incoming.recordCount()
        if count < 1 or count > 2
            return INPUT_MALFORMED
        if epoch < 0 or incoming.epochNumber() != epoch
            return INPUT_WRONG_EPOCH
        let frame = incoming.firstFrameNumber()
        incoming.copyRecord(0, firstScratch)
        let firstStatus = validateRow(sender, frame, firstScratch)
        if firstStatus != INPUT_ACCEPTED
            return firstStatus
        if count == 2
            incoming.copyRecord(1, secondScratch)
            let secondStatus = validateRow(sender, frame + 1, secondScratch)
            if secondStatus != INPUT_ACCEPTED
                return secondStatus
        commitRow(sender, frame, firstScratch)
        if count == 2
            commitRow(sender, frame + 1, secondScratch)
        while known < INPUT_LAST_FRAME and allPresent(known + 1)
            known++
        return INPUT_ACCEPTED

    function receive(int sender, string wire) returns int
        if sender < 0 or sender >= INPUT_PARTICIPANT_CAPACITY or (epoch >= 0 and not isActive(sender))
            return INPUT_WRONG_SENDER
        if not packet.decode(wire)
            return INPUT_MALFORMED
        return acceptPacket(sender, packet)
