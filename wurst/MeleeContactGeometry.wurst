package MeleeContactGeometry

public constant real SMASHCRAFT_ATTACK_CAPSULE_RADIUS = 10.

// Geometry used by Smashcraft's authored fighter-contact approximation.
// Coordinates are local simulation units; callers mirror X by facing.
public tuple meleeCapsule(real x1, real z1, real x2, real z2, real radius)

function pointSegmentDistanceSquared(real px, real pz, meleeCapsule segment) returns real
	let dx = segment.x2 - segment.x1
	let dz = segment.z2 - segment.z1
	let lengthSquared = dx * dx + dz * dz
	if lengthSquared <= 0.0000001
		let pointOffsetX = px - segment.x1
		let pointOffsetZ = pz - segment.z1
		return pointOffsetX * pointOffsetX + pointOffsetZ * pointOffsetZ
	let projection = max(0., min(1., ((px - segment.x1) * dx + (pz - segment.z1) * dz) / lengthSquared))
	let closestOffsetX = px - (segment.x1 + projection * dx)
	let closestOffsetZ = pz - (segment.z1 + projection * dz)
	return closestOffsetX * closestOffsetX + closestOffsetZ * closestOffsetZ

function orientation(real ax, real az, real bx, real bz, real cx, real cz) returns real
	return (bx - ax) * (cz - az) - (bz - az) * (cx - ax)

function between(real a, real b, real value) returns boolean
	return value >= min(a, b) and value <= max(a, b)

function segmentsIntersect(meleeCapsule a, meleeCapsule b) returns boolean
	let abC = orientation(a.x1, a.z1, a.x2, a.z2, b.x1, b.z1)
	let abD = orientation(a.x1, a.z1, a.x2, a.z2, b.x2, b.z2)
	let cdA = orientation(b.x1, b.z1, b.x2, b.z2, a.x1, a.z1)
	let cdB = orientation(b.x1, b.z1, b.x2, b.z2, a.x2, a.z2)
	if ((abC < 0 and abD > 0) or (abC > 0 and abD < 0)) and
		((cdA < 0 and cdB > 0) or (cdA > 0 and cdB < 0))
		return true
	if abC == 0 and between(a.x1, a.x2, b.x1) and between(a.z1, a.z2, b.z1)
		return true
	if abD == 0 and between(a.x1, a.x2, b.x2) and between(a.z1, a.z2, b.z2)
		return true
	if cdA == 0 and between(b.x1, b.x2, a.x1) and between(b.z1, b.z2, a.z1)
		return true
	return cdB == 0 and between(b.x1, b.x2, a.x2) and between(b.z1, b.z2, a.z2)

// For two non-intersecting segments the minimum distance is attained by an
// endpoint projected onto the other segment. Radii expand the centerlines.
public function meleeCapsulesIntersect(meleeCapsule a, meleeCapsule b) returns boolean
	let radius = a.radius + b.radius
	if segmentsIntersect(a, b)
		return true
	let distanceSquared = min(
		min(pointSegmentDistanceSquared(a.x1, a.z1, b), pointSegmentDistanceSquared(a.x2, a.z2, b)),
		min(pointSegmentDistanceSquared(b.x1, b.z1, a), pointSegmentDistanceSquared(b.x2, b.z2, a)))
	return distanceSquared <= radius * radius

public function mirrorMeleeCapsule(meleeCapsule capsule, real originX, real originZ,
		int facing) returns meleeCapsule
	let direction = facing < 0 ? -1. : 1.
	return meleeCapsule(originX + direction * capsule.x1, originZ + capsule.z1,
		originX + direction * capsule.x2, originZ + capsule.z2, capsule.radius)

// Provisional Smashcraft strike paths. Move identity determines the strike
// direction; a tall eligibility envelope does not make a jab a vertical strike.
// Numeric style IDs are the shared Simulation action IDs.
public function authoredAttackCapsule(int style, real minX, real maxX, real minZ, real maxZ) returns meleeCapsule
	if style == 0
		return meleeCapsule(0, 45, 70, 45, 10)
	if style == 15
		return meleeCapsule(0, 70, 0, maxZ - 30, 40)
	if style == 16
		return meleeCapsule(0, minZ, 0, -75, 40)
	if style == 2 or style == 7
		return meleeCapsule(0, 20, maxX - 30, maxZ - 30, 30)
	if style == 9
		return meleeCapsule(minX, 45, maxX - 34, 175, 10)
	if style == 10
		return meleeCapsule(minX, 45, maxX - 34, -85, 10)
	if style == 3 or style == 8
		return meleeCapsule(minX < 0 ? minX + 25 : minX, 0, maxX - 25, 0, 25)
	let left = minX < 0 ? minX + 34 : minX
	let right = maxX > 0 ? max(minX, maxX - 34) : maxX
	return meleeCapsule(left, 45, right, 45, SMASHCRAFT_ATTACK_CAPSULE_RADIUS)

// Coarse, pose-independent hurt capsules tuned for Smashcraft's current actor
// presentation scale. These do not claim Melee hurtbox or animation parity.
public function authoredFighterHurtCapsule(int character) returns meleeCapsule
	if character == 0
		return meleeCapsule(0, 4, 0, 88, 24)
	if character == 1
		return meleeCapsule(0, 4, 0, 96, 26)
	return meleeCapsule(0, 4, 0, 102, 25)
