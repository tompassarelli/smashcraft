// Actor-owned tuning, in world units per simulation frame. Character identity
// selects moves and presentation; these values are copied by value in replays.
public tuple fighterPhysics(real weight, real gravity, real terminalSpeed, real fastFallSpeed,
		real airAcceleration, real airSpeed, real airFriction, real airCap,
		real traction, real dashSpeed, real runSpeed, real walkSpeed,
		int jumpSquatFrames, real fullJumpSpeed, real shortJumpSpeed, real aerialJumpSpeed,
		real jumpMomentum, real jumpHorizontalSpeed, real jumpHorizontalCap,
		real aerialJumpHorizontalSpeed, real shieldBreakSpeed,
		real groundAccelerationMultiplier, real groundAccelerationBase, real groundSpeedCap)

public function archerPhysics() returns fighterPhysics
	return fighterPhysics(75, 0.23000000417232513 * WORLD_UNITS_PER_MELEE_UNIT,
		2.799999952316284 * WORLD_UNITS_PER_MELEE_UNIT, 3.4000000953674316 * WORLD_UNITS_PER_MELEE_UNIT,
		(0.019999999552965164 + 0.05999999865889549) * WORLD_UNITS_PER_MELEE_UNIT,
		0.8299999833106995 * WORLD_UNITS_PER_MELEE_UNIT, 0.019999999552965164 * WORLD_UNITS_PER_MELEE_UNIT, 3. * WORLD_UNITS_PER_MELEE_UNIT,
		GROUND_TRACTION, INITIAL_DASH_SPEED, 2.2 * WORLD_UNITS_PER_MELEE_UNIT, 1.6 * WORLD_UNITS_PER_MELEE_UNIT,
		3, 3.680000066757202 * WORLD_UNITS_PER_MELEE_UNIT, 2.0999999046325684 * WORLD_UNITS_PER_MELEE_UNIT,
		3.680000066757202 * WORLD_UNITS_PER_MELEE_UNIT * 1.2000000476837158,
		0.8299999833106995, 0.72 * WORLD_UNITS_PER_MELEE_UNIT, 1.7 * WORLD_UNITS_PER_MELEE_UNIT,
		0.8999999761581421 * WORLD_UNITS_PER_MELEE_UNIT, 3.299999952316284 * WORLD_UNITS_PER_MELEE_UNIT,
		GROUND_ACCELERATION_MULTIPLIER, GROUND_ACCELERATION_BASE, GROUND_SPEED_CAP)

