public function grabHoldFrames(real damage) returns int
	return (GRAB_HOLD_FRAMES + 1.6 * max(0., damage)).toInt()

// Original character tuning: action frames are one-based, including entry.
public function grabContactFrame(int action) returns int
	if action == GRAB_PUMMEL
		return 5
	if action == THROW_FORWARD
		return 12
	if action == THROW_UP
		return 14
	return 16

public function grabActionDuration(int action) returns int
	if action == GRAB_PUMMEL
		return 24
	if action == THROW_FORWARD
		return 30
	if action == THROW_BACK
		return 34
	if action == THROW_UP
		return 32
	if action == THROW_DOWN
		return 36
	return 10
