public class InputSnapshot
	int direction = 0
	int verticalDirection = 0
	boolean sdiPulse = false
	int sdiX = 0
	int sdiZ = 0
	int cStickX = 0
	int cStickZ = 0
	boolean attackRequested = false
	boolean specialPressed = false
	boolean down = false
	boolean shield = false
	boolean jumpPressed = false
	boolean airDodgePressed = false
	boolean techPressed = false
	boolean mashPressed = false
	boolean attackPressed = false
	boolean grabMashPressed = false
	int grabThrowX = 0
	int grabThrowZ = 0
	boolean lCancelPressed = false
	boolean groundDodgePressed = false
	int groundDodgeDirection = 0
	boolean getupAttackPressed = false
	int ledgeVerticalPressed = 0
	boolean getupStandPressed = false
	boolean getupDirectionPressed = false
	int getupDirection = 0
	int dodgeX = 0
	int dodgeZ = 0
	boolean jumpHeld = false
	boolean walking = false
	boolean attackHeld = false

	function copyTo(InputSnapshot destination)
		destination.direction = direction
		destination.verticalDirection = verticalDirection
		destination.sdiPulse = sdiPulse
		destination.sdiX = sdiX
		destination.sdiZ = sdiZ
		destination.cStickX = cStickX
		destination.cStickZ = cStickZ
		destination.attackRequested = attackRequested
		destination.specialPressed = specialPressed
		destination.down = down
		destination.shield = shield
		destination.jumpPressed = jumpPressed
		destination.airDodgePressed = airDodgePressed
		destination.techPressed = techPressed
		destination.mashPressed = mashPressed
		destination.attackPressed = attackPressed
		destination.grabMashPressed = grabMashPressed
		destination.grabThrowX = grabThrowX
		destination.grabThrowZ = grabThrowZ
		destination.lCancelPressed = lCancelPressed
		destination.groundDodgePressed = groundDodgePressed
		destination.groundDodgeDirection = groundDodgeDirection
		destination.getupAttackPressed = getupAttackPressed
		destination.ledgeVerticalPressed = ledgeVerticalPressed
		destination.getupStandPressed = getupStandPressed
		destination.getupDirectionPressed = getupDirectionPressed
		destination.getupDirection = getupDirection
		destination.dodgeX = dodgeX
		destination.dodgeZ = dodgeZ
		destination.jumpHeld = jumpHeld
		destination.walking = walking
		destination.attackHeld = attackHeld

function applyDirectionalInfluence(FighterState target, InputSnapshot input)
	if not target.diPending
		return
	target.diPending = false
	if input.direction == 0 and input.verticalDirection == 0 or target.diLaunchSpeed <= 0
		target.diLaunchSpeed = 0
		return
	let dx = input.direction == 0 ? 0 : (input.direction > 0 ? 1 : -1)
	let dz = input.verticalDirection == 0 ? 0 : (input.verticalDirection > 0 ? 1 : -1)
	let inputScale = dx != 0 and dz != 0 ? DIAGONAL_UNIT : 1
	let inputX = dx * inputScale
	let inputZ = dz * inputScale
	let cross = (target.knockbackX * inputZ - target.knockbackZ * inputX) / target.diLaunchSpeed
	if cross == 0
		target.diLaunchSpeed = 0
		return
	let angle = cross * cross.abs() * DI_MAX_ANGLE_RADIANS
	let cosine = Cos(angle)
	let sine = Sin(angle)
	let oldVx = target.knockbackX
	let oldVz = target.knockbackZ
	target.knockbackX = oldVx * cosine - oldVz * sine
	target.knockbackZ = oldVz * cosine + oldVx * sine
	target.diAngleDegrees = angle * RADIANS_TO_DEGREES
	target.diSerial++
	target.diLaunchSpeed = 0

public function totalVelocityX(FighterState f) returns real
	return f.vx + f.knockbackX

public function totalVelocityZ(FighterState f) returns real
	return f.vz + f.knockbackZ

function decayKnockback(FighterState f)
	let speed = SquareRoot(f.knockbackX * f.knockbackX + f.knockbackZ * f.knockbackZ)
	let decay = KNOCKBACK_DECAY_PER_FRAME * WORLD_UNITS_PER_MELEE_UNIT
	if speed <= decay
		f.knockbackX = 0
		f.knockbackZ = 0
	else if speed > 0
		let scale = (speed - decay) / speed
		f.knockbackX *= scale
		f.knockbackZ *= scale

public function surfaceCount(int stage) returns int
	return stage == 0 ? 1 : 3

public function surfaceLeft(int stage, int index) returns real
	if index == 0
		return -600
	if stage == 1 and index == 1
		return -420
	if stage == 1 and index == 2
		return 110
	return 0

public function surfaceRight(int stage, int index) returns real
	if index == 0
		return 600
	if stage == 1 and index == 1
		return -110
	if stage == 1 and index == 2
		return 420
	return 0

public function surfaceZ(int stage, int index) returns real
	return stage == 1 and index > 0 ? 170 : 0

public function surfacePass(int stage, int index) returns boolean
	return stage == 1 and index > 0

public function characterSpeed(int character) returns real
	return character == 0 ? 2.2 * WORLD_UNITS_PER_MELEE_UNIT : (character == 1 ? 1.5 : 1.85) * WORLD_UNITS_PER_MELEE_UNIT

public function characterWalkSpeed(int character) returns real
	return (character == 0 ? 1.6 : (character == 1 ? 1.4 : 1.55)) * WORLD_UNITS_PER_MELEE_UNIT

function clearDash(FighterState f)
	f.dashFrame = 0
	f.dashDirection = 0

function advanceGroundMovement(FighterState f, int direction, boolean walking)
	if walking
		clearDash(f)
		if direction != 0
			f.facing = direction
			f.vx = characterWalkSpeed(f.character) * direction
		return
	if direction == 0
		if f.vx.abs() <= GROUND_TRACTION
			clearDash(f)
		else if f.dashFrame > 0
			f.dashFrame = min(INITIAL_DASH_FRAMES + 1, f.dashFrame + 1)
		return
	if f.dashFrame >= INITIAL_DASH_FRAMES and direction != f.dashDirection and f.vx * f.dashDirection > 0
		f.dashFrame = INITIAL_DASH_FRAMES + 1
		f.vx = f.dashDirection * max(0, f.vx * f.dashDirection - RUN_TURN_BRAKING)
		return
	if f.dashFrame == 0 or direction != f.dashDirection
		f.dashFrame = 1
		f.dashDirection = direction
	else
		f.dashFrame = min(INITIAL_DASH_FRAMES + 1, f.dashFrame + 1)
	f.facing = direction
	f.vx = direction * (f.dashFrame <= INITIAL_DASH_FRAMES ? INITIAL_DASH_SPEED : characterSpeed(f.character))

public function characterGravity(int character) returns real
	return character == 0 ? FOX_GRAVITY : (character == 1 ? FALCO_GRAVITY : 0.19 * WORLD_UNITS_PER_MELEE_UNIT)

public function characterTerminalSpeed(int character) returns real
	return character == 0 ? FOX_TERMINAL_SPEED : (character == 1 ? FALCO_TERMINAL_SPEED : 3.0 * WORLD_UNITS_PER_MELEE_UNIT)

public function characterAirSpeed(int character) returns real
	return character == 0 ? FOX_AIR_SPEED : (character == 1 ? FALCO_AIR_SPEED : 0.88 * WORLD_UNITS_PER_MELEE_UNIT)

public function characterAirAcceleration(int character) returns real
	return character == 0 ? FOX_AIR_ACCELERATION : (character == 1 ? FALCO_AIR_ACCELERATION : 0.075 * WORLD_UNITS_PER_MELEE_UNIT)

public function characterFastFallSpeed(int character) returns real
	return character == 0 ? FOX_FAST_FALL_SPEED : (character == 1 ? FALCO_FAST_FALL_SPEED : 3.45 * WORLD_UNITS_PER_MELEE_UNIT)

public function fullJumpSpeed(int character) returns real
	return character == 0 ? FOX_FULL_JUMP_SPEED : (character == 1 ? FALCO_FULL_JUMP_SPEED : 24.2)

public function shortJumpSpeed(int character) returns real
	return character == 0 ? FOX_SHORT_JUMP_SPEED : (character == 1 ? FALCO_SHORT_JUMP_SPEED : 13.2)

public function doubleJumpSpeed(int character) returns real
	return character == 0 ? FOX_DOUBLE_JUMP_SPEED : (character == 1 ? FALCO_DOUBLE_JUMP_SPEED : 25.5)

public function jumpSquatFrames(int character) returns int
	return character == 0 ? FOX_JUMP_SQUAT_FRAMES : (character == 1 ? FALCO_JUMP_SQUAT_FRAMES : 4)

function canStartAttack(FighterState attacker) returns boolean
	if attacker.grabTarget != null or attacker.grabAction != GRAB_NONE
		return false
	if attacker.frozenFrames > 0
		return false
	if attacker.ledgeState != LEDGE_NONE
		return false
	return not attacker.out and not attacker.specialFall and attacker.specialLockFrames <= 0 and attacker.shieldBreakState == SHIELD_BREAK_NONE and (attacker.downState == DOWN_NONE or isTumbling(attacker)) and attacker.grabbedFrames <= 0 and attacker.hitlag <= 0 and attacker.hitstun <= 0 and attacker.shieldStun <= 0 and attacker.shieldReleaseLag <= 0 and attacker.landingLag <= 0 and not attacker.airDodging and not isGroundDodging(attacker) and attacker.jumpSquat <= 0 and attacker.cooldown <= 0

public function canAttack(FighterState attacker) returns boolean
	return canStartAttack(attacker) and not attacker.shield and attacker.frozenFrames <= 0

public function canShieldGrab(FighterState attacker) returns boolean
	return canStartAttack(attacker) and attacker.shield and attacker.grounded and attacker.shieldEnergy > 0

public function canStartAttackStyle(FighterState attacker, int style) returns boolean
	return canAttack(attacker) or (style == 5 and canShieldGrab(attacker))

public function isAerialAttack(int style) returns boolean
	return style >= AERIAL_NEUTRAL_STYLE and style <= AERIAL_DOWN_STYLE

public function attackLandingLag(int style) returns int
	if style == AERIAL_NEUTRAL_STYLE
		return AERIAL_NEUTRAL_LANDING_LAG
	if style == AERIAL_FORWARD_STYLE
		return AERIAL_FORWARD_LANDING_LAG
	if style == AERIAL_BACK_STYLE
		return AERIAL_BACK_LANDING_LAG
	if style == AERIAL_UP_STYLE
		return AERIAL_UP_LANDING_LAG
	return style == AERIAL_DOWN_STYLE ? AERIAL_DOWN_LANDING_LAG : 0

function attackDamage(int style) returns real
	if style == DEMONHUNTER_DASH_ATTACK_STYLE
		return 9
	if style == LEDGE_ATTACK_STYLE
		return 7
	if style == DOWN_ATTACK_STYLE
		return DOWN_ATTACK_DAMAGE
	if style == AERIAL_NEUTRAL_STYLE
		return 7
	if style == AERIAL_FORWARD_STYLE or style == AERIAL_BACK_STYLE or style == AERIAL_UP_STYLE
		return 8
	if style == AERIAL_DOWN_STYLE
		return 9
	if style == 1
		return 3
	if style == 2 or style == 3
		return 16
	if style == 4
		return 18
	if style == 5
		return 0
	if style == 6 or style == 9 or style == 10
		return 10
	if style == 7 or style == 8
		return 8
	return 12

function isSmashAttack(int style) returns boolean
	return style >= 2 and style <= 4

public function smashDamageMultiplier(int chargeFrames) returns real
	return 1 + (SMASH_MAX_DAMAGE_MULTIPLIER - 1) * max(0, min(SMASH_MAX_CHARGE_FRAMES, chargeFrames)) / SMASH_MAX_CHARGE_FRAMES

// Pure ordinary-hit math. Parameters come from the selected hit region.
// Electric, crouching, fixed-knockback, and capped branches are separate.
public function ordinaryHitKnockback(real preHitPercent, real hitDamage, real victimWeight,
		real growthPercent, real baseKnockback, real contextScale) returns real
	let postHitPercent = R2I(max(0, preHitPercent)) + hitDamage
	let percentGrowth = (postHitPercent / 10. + postHitPercent * hitDamage / 20.) * 200 / (victimWeight + 100) * 1.4 + 18
	return (percentGrowth * growthPercent / 100. + baseKnockback) * contextScale

public function ordinaryHitlagFrames(real hitDamage) returns int
	return hitDamage <= 0 ? 0 : min(20, R2I(hitDamage / 3. + 3))

public function digitalShieldstunFrames(real hitDamage) returns int
	return R2I((hitDamage * 0.45 + 2) * 200 / 201)

public function ordinaryHitstunFrames(real knockback) returns int
	return R2I(knockback * HITSTUN_FRAMES_PER_KNOCKBACK)

function attackReach(int style) returns real
	if style == DEMONHUNTER_DASH_ATTACK_STYLE
		return 155
	return style == 1 ? 600 : (style == 2 or style == 3 ? 125 : (style == 5 ? 100 : 145))

public function attackStartupFrames(int style) returns int
	if style == LEDGE_ATTACK_STYLE
		return 16
	if style == DEMONHUNTER_DASH_ATTACK_STYLE
		return 4
	// attackFrame zero is the start tick (reference frame one).
	if style == AERIAL_NEUTRAL_STYLE or style == AERIAL_BACK_STYLE
		return 3
	if style == AERIAL_FORWARD_STYLE
		return 5
	if style == AERIAL_UP_STYLE
		return 5
	if style == AERIAL_DOWN_STYLE
		return 7
	return style == DOWN_ATTACK_STYLE ? DOWN_ATTACK_STARTUP_FRAMES : (style == 1 ? 2 : (style == 2 or style == 3 ? 8 : (style == 4 ? 6 : (style == 5 ? 5 : (style == 6 or style == 8 or style == 9 or style == 10 ? 5 : (style == 7 ? 6 : 4))))))

public function attackActiveFrames(int style) returns int
	if style == LEDGE_ATTACK_STYLE
		return 3
	if style == DEMONHUNTER_DASH_ATTACK_STYLE
		return 2
	if style == AERIAL_NEUTRAL_STYLE
		return 28
	if style == AERIAL_BACK_STYLE
		return 16
	if style == AERIAL_FORWARD_STYLE
		return 2
	if style == AERIAL_UP_STYLE or style == AERIAL_DOWN_STYLE
		return 3
	return style == DOWN_ATTACK_STYLE ? DOWN_ATTACK_ACTIVE_FRAMES : (style == 1 ? 1 : (style == 2 or style == 3 or style == 4 ? 3 : 2))

public function characterAttackActiveFrames(int character, int style) returns int
	return character == 0 and style == AERIAL_DOWN_STYLE ? ARCHER_DOWN_ACTIVE_FRAMES : attackActiveFrames(style)

public function attackDurationFrames(int style) returns int
	return attackDurationFramesForGrounding(style, true)

public function attackDurationFramesForGrounding(int style, boolean grounded) returns int
	if style == LEDGE_ATTACK_STYLE
		return LEDGE_ATTACK_FRAMES
	if style == DEMONHUNTER_DASH_ATTACK_STYLE
		return 32
	if style == AERIAL_NEUTRAL_STYLE
		return 41
	if style == AERIAL_FORWARD_STYLE
		return 31
	if style == AERIAL_BACK_STYLE
		return 37
	if style == AERIAL_UP_STYLE
		return 34
	if style == AERIAL_DOWN_STYLE
		return 38
	return style == DOWN_ATTACK_STYLE ? DOWN_ATTACK_FRAMES : (style == 1 ? (grounded ? 24 : 15) : (style == 2 or style == 3 ? 42 : (style == 6 or style == 8 or style == 9 or style == 10 ? 28 : (style == 7 ? 29 : 36))))

public function attackRecoveryFrames(int style, boolean grounded) returns int
	return attackDurationFramesForGrounding(style, grounded) - attackStartupFrames(style) - attackActiveFrames(style)

public function attackPhase(FighterState f) returns int
	if f.attackStyle < 0
		return ATTACK_NONE
	if f.attackFrame < attackStartupFrames(f.attackStyle)
		return ATTACK_STARTUP
	if f.attackFrame < attackStartupFrames(f.attackStyle) + characterAttackActiveFrames(f.character, f.attackStyle)
		return ATTACK_ACTIVE
	return ATTACK_RECOVERY

public function projectileCount(FighterState f) returns int
	var count = 0
	for index = 0 to PROJECTILE_CAPACITY - 1
		if f.projectileLife[index] > 0
			count++
	return count

public function projectileActive(FighterState f, int index) returns boolean
	return index >= 0 and index < PROJECTILE_CAPACITY and f.projectileLife[index] > 0

public function projectileXAt(FighterState f, int index) returns real
	return f.projectileX[index]

public function projectileZAt(FighterState f, int index) returns real
	return f.projectileZ[index]

public function projectileDirectionAt(FighterState f, int index) returns int
	return f.projectileDirection[index]

public function projectileVelocityXAt(FighterState f, int index) returns real
	return f.projectileVelocityX[index]

public function projectileVelocityZAt(FighterState f, int index) returns real
	return f.projectileVelocityZ[index]

public function projectileKindAt(FighterState f, int index) returns int
	return f.projectileKind[index]

tuple hitEffect(real damage, real growth, real base, real launchX, real launchZ)
tuple hitRegion(real minX, real maxX, real minZ, real maxZ, hitEffect hitData, int window)

function noHitRegion() returns hitRegion
	return hitRegion(0, 0, 0, 0, hitEffect(0, 0, 0, 0, 0), 0)

// Coordinates are facing-relative offsets of the victim's simulation origin.
// Lower region indices win overlaps. Window zero means no authored contact;
// increasing positive windows explicitly permit a later hit of the same target.
function authoredHitRegion(int character, int style, int frame, int chargeFrames, int index) returns hitRegion
	if style < 0 or style == 1 or frame < attackStartupFrames(style) or frame >= attackStartupFrames(style) + characterAttackActiveFrames(character, style)
		return noHitRegion()
	// Character 2 has an explicit authored region for each shared ground/aerial
	// action ID. Numeric windows are single-contact and provisional; animation
	// assets must bind their matching action IDs before roster exposure.
	// Grab and recovery attacks use the shared contact rules below.
	if character == 2 and style != 5 and style != DOWN_ATTACK_STYLE and style != LEDGE_ATTACK_STYLE
		let charge = isSmashAttack(style) ? smashDamageMultiplier(chargeFrames) : 1
		let ground = style <= 10 or style == DEMONHUNTER_DASH_ATTACK_STYLE
		let demonDamage = (style == 0 ? 5. : (style == 2 or style == 3 or style == 4 ? 15. : (style == 12 ? 8. : (style == 16 ? 10. : 7.)))) * charge
		let data = hitEffect(demonDamage, 100, style == 2 or style == 3 or style == 4 ? 28 : 18, DIAGONAL_UNIT, DIAGONAL_UNIT)
		if ground
			if style == 0
				return hitRegion(0, 92, -55, 105, data, 1)
			if style == 2
				return hitRegion(-105, 105, -30, 195, data, 1)
			if style == 3
				return hitRegion(-105, 105, -195, 45, data, 1)
			if style == 4
				return hitRegion(25, 195, -75, 105, data, 1)
			if style == DEMONHUNTER_DASH_ATTACK_STYLE
				return hitRegion(0, 150, -70, 115, hitEffect(9, 95, 20, 0.92, 0.39), 1)
			if style == 6
				return hitRegion(0, 135, -80, 95, hitEffect(8, 95, 18, 0.94, 0.34), 1)
			if style == 7
				return hitRegion(0, 125, -30, 185, hitEffect(8, 105, 18, 0.25, 0.9682458), 1)
			if style == 8
				return hitRegion(-115, 115, -145, 40, hitEffect(7, 90, 16, DIAGONAL_UNIT, 0.3), 1)
			if style == 9
				return hitRegion(0, 135, -30, 145, hitEffect(8, 100, 18, 0.88, 0.48), 1)
			if style == 10
				return hitRegion(0, 135, -145, 5, hitEffect(8, 100, 18, 0.88, -0.48), 1)
			return noHitRegion()
		if style == AERIAL_NEUTRAL_STYLE
			return hitRegion(-115, 115, -45, 100, hitEffect(7, 95, 16, DIAGONAL_UNIT, DIAGONAL_UNIT), 1)
		if style == AERIAL_FORWARD_STYLE
			return hitRegion(0, 175, -55, 115, hitEffect(8, 100, 18, 0.94, 0.34), 1)
		if style == AERIAL_BACK_STYLE
			return hitRegion(-175, 0, -55, 115, hitEffect(8, 100, 18, -0.94, 0.34), 1)
		if style == AERIAL_UP_STYLE
			return hitRegion(-115, 115, 10, 205, hitEffect(8, 105, 19, 0.22, 0.975), 1)
		if style == AERIAL_DOWN_STYLE
			return hitRegion(-105, 105, -190, -10, hitEffect(9, 100, 20, 0.16, -0.987), 1)
		return noHitRegion()
	let lingering = (style == AERIAL_NEUTRAL_STYLE or style == AERIAL_BACK_STYLE) and frame >= 7
	let damage = (lingering ? 5. : attackDamage(style)) * (isSmashAttack(style) ? smashDamageMultiplier(chargeFrames) : 1)
	var hitData = hitEffect(damage, ORDINARY_HIT_GROWTH_PERCENT, ORDINARY_HIT_BASE_KNOCKBACK, DIAGONAL_UNIT, DIAGONAL_UNIT)
	if style == 6
		let early = frame == attackStartupFrames(style)
		if index == 0
			hitData = hitEffect(early ? 10 : 8, early ? 110 : 90, early ? 24 : 18, 0.8, 0.6)
			return hitRegion(90, 145, -130, 130, hitData, 1)
		hitData = hitEffect(early ? 7 : 5, early ? 80 : 70, early ? 16 : 12, DIAGONAL_UNIT, DIAGONAL_UNIT)
		return hitRegion(0, 110, -130, 130, hitData, 1)
	if style == LEDGE_ATTACK_STYLE
		return hitRegion(0, 140, -90, 90, hitData, 1)
	if style == DOWN_ATTACK_STYLE
		hitData = hitEffect(DOWN_ATTACK_DAMAGE, ORDINARY_HIT_GROWTH_PERCENT,
			DOWN_ATTACK_BASE_KNOCKBACK, DIAGONAL_UNIT, DIAGONAL_UNIT)
		return hitRegion(-attackReach(style), attackReach(style), -130, 130, hitData, 1)
	if style == AERIAL_NEUTRAL_STYLE
		return hitRegion(-90, 90, -65, 90, hitData, 1)
	if style == AERIAL_FORWARD_STYLE
		return hitRegion(0, 165, -65, 100, hitData, 1)
	if style == AERIAL_BACK_STYLE
		hitData = hitEffect(damage, hitData.growth, hitData.base, -DIAGONAL_UNIT, DIAGONAL_UNIT)
		return hitRegion(-155, 0, -65, 100, hitData, 1)
	if style == AERIAL_UP_STYLE
		let finisher = frame == attackStartupFrames(style) + 2
		hitData = hitEffect(finisher ? 8 : 4, finisher ? 110 : 60, finisher ? 24 : 14, 0.25, 0.9682458)
		return hitRegion(-105, 105, 20, 190, hitData, finisher ? 2 : 1)
	if style == AERIAL_DOWN_STYLE
		if character == 0
			let diveDamage = frame < attackStartupFrames(style) + 3 ? damage : 6.
			hitData = hitEffect(diveDamage, hitData.growth, hitData.base, 0.25, -0.9682458)
			return hitRegion(-55, 55, -180, -10, hitData, 1)
		hitData = hitEffect(damage, hitData.growth, hitData.base, 0.25, -0.9682458)
		return hitRegion(-95, 95, -180, -10, hitData, 1)
	let verticalOffset = style == 9 ? 65. : (style == 10 ? -65. : 0.)
	return hitRegion(style == DOWN_ATTACK_STYLE ? -attackReach(style) : 0, attackReach(style), verticalOffset - 130, verticalOffset + 130, hitData, 1)

function selectHitRegion(FighterState attacker, FighterState target) returns hitRegion
	if attacker.out or attacker.hitlag > 0 or target.out or isIntangible(target)
		return noHitRegion()
	let localX = (target.x - attacker.x) * attacker.facing
	let localZ = target.z - attacker.z
	for index = 0 to (attacker.attackStyle == 6 ? 1 : 0)
		let hitBox = authoredHitRegion(attacker.character, attacker.attackStyle, attacker.attackFrame, attacker.smashChargeFrames, index)
		let alreadyHit = target.lastHitAttacker == attacker and target.lastHitAttackSerial == attacker.attackSerial and target.lastHitWindow >= hitBox.window
		if hitBox.window > 0 and not alreadyHit and localX >= hitBox.minX and localX <= hitBox.maxX and localZ >= hitBox.minZ and localZ <= hitBox.maxZ
			return hitBox
	return noHitRegion()

function recordHitRegion(FighterState attacker, FighterState target, hitRegion hitBox)
	attacker.attackHit = true
	target.lastHitAttacker = attacker
	target.lastHitAttackSerial = attacker.attackSerial
	target.lastHitWindow = hitBox.window

public function isIntangible(FighterState f) returns boolean
	if f.ledgeState != LEDGE_NONE and f.ledgeIntangible > 0
		return true
	let groundDodgeIntangible = f.groundDodgeFrame > 0 and (
		(f.groundDodgeDirection == 0 and f.groundDodgeFrame >= SPOT_DODGE_INTANGIBLE_START and f.groundDodgeFrame <= SPOT_DODGE_INTANGIBLE_END)
		or (f.groundDodgeDirection != 0 and f.groundDodgeFrame >= GROUND_ROLL_INTANGIBLE_START and f.groundDodgeFrame <= GROUND_ROLL_INTANGIBLE_END))
	let downRollIntangibleFrames = f.downDirection != 0 and f.downDirection != f.facing
		? (f.downFaceUp ? DOWN_ROLL_INTANGIBLE_FRAMES_BACK_UP : DOWN_ROLL_INTANGIBLE_FRAMES_BACK_DOWN)
		: DOWN_RECOVERY_INTANGIBLE_FRAMES
	let downRecoveryIntangible = f.downState == DOWN_STAND and f.downFrame > 0 and f.downFrame <= DOWN_RECOVERY_INTANGIBLE_FRAMES
		or (f.downState == DOWN_ROLL and f.downFrame > 0 and f.downFrame <= downRollIntangibleFrames)
		or (f.downState == DOWN_ATTACK and f.downFrame > 0 and f.downFrame <= (f.downFaceUp ? DOWN_ATTACK_INTANGIBLE_FRAMES_UP : DOWN_ATTACK_INTANGIBLE_FRAMES_DOWN))
	let techIntangible = isFloorTeching(f) and f.downFrame >= 1 and f.downFrame <= (f.downState == DOWN_TECH ? TECH_INTANGIBLE_FRAMES : TECH_ROLL_INTANGIBLE_FRAMES)
	return f.invincible > 0 or groundDodgeIntangible or downRecoveryIntangible or techIntangible or (f.airDodging and f.airDodgeFrame >= AIR_DODGE_INTANGIBLE_START and f.airDodgeFrame <= AIR_DODGE_INTANGIBLE_END)

public function isGroundDodging(FighterState f) returns boolean
	return f.groundDodgeFrame > 0

public function isTumbling(FighterState f) returns boolean
	return f.downState == DOWN_TUMBLE

function isDownDamageState(FighterState f) returns boolean
	return f.grounded and (f.downState == DOWN_BOUND or f.downState == DOWN_WAIT or f.downState == DOWN_DAMAGE)

function beginDownDamage(FighterState f, int hitstunFrames)
	f.downState = DOWN_DAMAGE
	f.downFrame = 1
	f.downWaitRemaining = max(0, hitstunFrames)
	f.hitstun = max(0, hitstunFrames)
	f.diPending = false
	f.diLaunchSpeed = 0
	f.vx = 0
	f.vz = 0
	f.knockbackX = 0
	f.knockbackZ = 0
	f.grounded = true
	f.shield = false
	f.shieldHeldFrames = 0

public function isFloorTeching(FighterState f) returns boolean
	return f.downState == DOWN_TECH or f.downState == DOWN_TECH_ROLL

function clearLedge(FighterState f)
	f.ledgeState = LEDGE_NONE
	f.ledgeSide = 0
	f.ledgeFrame = 0
	f.ledgeIntangible = 0

function leaveLedge(FighterState f)
	clearLedge(f)
	f.ledgeRegrab = LEDGE_REGRAB_FRAMES

function ledgeX(int stage, int side) returns real
	return side < 0 ? surfaceLeft(stage, 0) : surfaceRight(stage, 0)

function ledgeCandidate(FighterState f, int stage, InputSnapshot input) returns int
	let canCatchDuringSpecialFall = f.specialFall and not f.out and f.specialLockFrames <= 0 and f.hitlag <= 0 and f.hitstun <= 0 and f.shieldStun <= 0 and (f.downState == DOWN_NONE or isTumbling(f))
	if (not canAttack(f) and not canCatchDuringSpecialFall) or f.grounded or f.ledgeRegrab > 0 or f.attackStyle >= 0 or input.down or input.verticalDirection < 0 or totalVelocityZ(f) >= 0
		return 0
	let height = f.z - surfaceZ(stage, 0)
	if height < -LEDGE_GRAB_BELOW or height > LEDGE_GRAB_ABOVE
		return 0
	let side = f.x < 0 ? -1 : 1
	let outside = (f.x - ledgeX(stage, side)) * side
	if outside < 0 or outside > LEDGE_GRAB_WIDTH or f.facing != -side
		return 0
	return side

function ledgeDistance(FighterState f, int stage, int side) returns real
	let dx = f.x - ledgeX(stage, side)
	let dz = f.z - surfaceZ(stage, 0)
	return dx * dx + dz * dz

function catchLedge(FighterState f, int stage, int side)
	clearDash(f)
	clearDownState(f)
	f.ledgeState = LEDGE_HANG
	f.ledgeSide = side
	f.ledgeFrame = 0
	f.ledgeSerial++
	f.ledgeIntangible = LEDGE_INTANGIBLE_FRAMES
	f.x = ledgeX(stage, side) + side * LEDGE_HANG_OUTSET
	f.z = surfaceZ(stage, 0) - LEDGE_HANG_DEPTH
	f.facing = -side
	f.grounded = false
	f.surface = -1
	f.vx = 0
	f.vz = 0
	f.knockbackX = 0
	f.knockbackZ = 0
	f.specialFall = false
	f.jumps = 1
	f.dropTime = 0
	f.lCancelWindow = 0
	f.techWindow = 0
	f.techHitlagLatched = false

public function resolveLedgePair(FighterState first, FighterState second, int stage, InputSnapshot firstInput, InputSnapshot secondInput)
	var firstSide = ledgeCandidate(first, stage, firstInput)
	var secondSide = ledgeCandidate(second, stage, secondInput)
	if second.ledgeState != LEDGE_NONE and second.ledgeSide == firstSide
		firstSide = 0
	if first.ledgeState != LEDGE_NONE and first.ledgeSide == secondSide
		secondSide = 0
	if firstSide != 0 and firstSide == secondSide
		let firstDistance = ledgeDistance(first, stage, firstSide)
		let secondDistance = ledgeDistance(second, stage, secondSide)
		if firstDistance >= secondDistance
			firstSide = 0
		if secondDistance >= firstDistance
			secondSide = 0
	if firstSide != 0
		catchLedge(first, stage, firstSide)
	if secondSide != 0
		catchLedge(second, stage, secondSide)

function startLedgeOption(FighterState f, int state)
	f.ledgeState = state
	f.ledgeFrame = 0
	if state == LEDGE_ATTACK
		beginAttack(f, LEDGE_ATTACK_STYLE, false)

function advanceLedge(FighterState f, int stage, InputSnapshot input)
	checkBlastZone(f)
	if f.out
		return
	if f.hitlag > 0
		f.hitlag--
		return
	f.invincible = max(0, f.invincible - 1)
	f.ledgeIntangible = max(0, f.ledgeIntangible - 1)
	if f.ledgeState == LEDGE_HANG
		// The catch tick anchors before new options can begin.
		if f.ledgeFrame > 0
			let intoStage = input.getupDirectionPressed and input.getupDirection == -f.ledgeSide
			let away = input.getupDirectionPressed and input.getupDirection == f.ledgeSide
			if input.jumpPressed
				f.vx = -f.ledgeSide * characterAirSpeed(f.character)
				f.vz = fullJumpSpeed(f.character)
				f.jumpSerial++
				f.jumpIsDouble = false
				leaveLedge(f)
				return
			else if intoStage or input.ledgeVerticalPressed > 0
				startLedgeOption(f, LEDGE_CLIMB)
				return
			else if away or input.ledgeVerticalPressed < 0
				f.vx = f.ledgeSide * 2.
				f.vz = -2
				leaveLedge(f)
				return
			else if input.airDodgePressed
				startLedgeOption(f, LEDGE_ROLL)
				return
			else if input.getupAttackPressed
				startLedgeOption(f, LEDGE_ATTACK)
				return
		f.ledgeFrame++
		return
	f.ledgeFrame++
	let progress = min(LEDGE_MOUNT_FRAMES, f.ledgeFrame) * 1. / LEDGE_MOUNT_FRAMES
	let inset = f.ledgeState == LEDGE_ROLL ? 140. : (f.ledgeState == LEDGE_ATTACK ? 64. : LEDGE_CLIMB_INSET)
	f.x = ledgeX(stage, f.ledgeSide) + f.ledgeSide * (LEDGE_HANG_OUTSET * (1 - progress) - inset * progress)
	f.z = surfaceZ(stage, 0) - LEDGE_HANG_DEPTH * (1 - progress)
	f.grounded = f.ledgeFrame >= LEDGE_MOUNT_FRAMES
	f.surface = f.grounded ? 0 : -1
	if f.ledgeState == LEDGE_ATTACK
		f.attackFrame = f.ledgeFrame
		f.cooldown = max(0, LEDGE_ATTACK_FRAMES - f.ledgeFrame)
	let duration = f.ledgeState == LEDGE_CLIMB ? LEDGE_CLIMB_FRAMES : (f.ledgeState == LEDGE_ROLL ? LEDGE_ROLL_FRAMES : LEDGE_ATTACK_FRAMES)
	if f.ledgeFrame >= duration
		if f.ledgeState == LEDGE_ATTACK
			cancelAttack(f)
		f.jumps = 2
		leaveLedge(f)

function clearShieldBreak(FighterState f)
	f.shieldBreakState = SHIELD_BREAK_NONE
	f.shieldBreakFrame = 0
	f.shieldBreakRemaining = 0

function clearOwnedFreezeTrap(FighterState f)
	f.freezeTrapLife = 0
	f.freezeTrapArming = 0
	f.freezeTrapX = 0
	f.freezeTrapZ = 0
	f.freezeTrapSurface = -1

public function cancelSpecialState(FighterState f)
	f.specialFall = false
	f.specialAction = SPECIAL_NONE
	f.specialFrame = 0
	f.specialDuration = 0
	f.specialLockFrames = 0
	// Spawned cover and bears outlive the owner's action; a mount does not.
	if f.hippogryphKind == 2
		f.hippogryphLife = 0
		f.hippogryphKind = 0

function clearSpecialOnStock(FighterState f)
	cancelSpecialState(f)
	f.specialFall = false
	f.specialHit = false
	f.bearLife = 0
	f.bearSwipeCooldown = 0
	f.hippogryphLife = 0
	f.hippogryphKind = 0
	for i = 0 to SPECIAL_ACTION_CAPACITY - 1
		f.specialCooldowns[i] = 0
	f.specialDirection = 0
	f.bearX = 0
	f.bearZ = 0
	f.bearVelocityX = 0
	f.bearVelocityZ = 0
	f.bearHitSerial = 0
	f.bearSurface = -1
	f.hippogryphX = 0
	f.hippogryphZ = 0
	f.hippogryphVelocityX = 0
	f.hippogryphVelocityZ = 0
	for i = 0 to PROJECTILE_CAPACITY - 1
		f.projectileLife[i] = 0
		f.projectileX[i] = 0
		f.projectileZ[i] = 0
		f.projectileDirection[i] = 0
		f.projectileKind[i] = PROJECTILE_BLASTER
		f.projectileVelocityX[i] = 0
		f.projectileVelocityZ[i] = 0
		f.projectileSerial[i] = 0

public function startFreezeTrap(FighterState owner, int stage) returns boolean
	if owner.character != 1 or not owner.grounded or owner.surface < 0 or owner.freezeTrapLife > 0 or owner.freezeTrapCooldown > 0 or not canAttack(owner)
		return false
	owner.freezeTrapX = owner.x
	owner.freezeTrapSurface = owner.surface
	owner.freezeTrapZ = surfaceZ(stage, owner.surface)
	owner.freezeTrapLife = FREEZE_TRAP_LIFETIME_FRAMES
	owner.freezeTrapArming = FREEZE_TRAP_ARMING_FRAMES
	owner.freezeTrapSerial++
	owner.freezeTrapCooldown = FREEZE_TRAP_COOLDOWN_FRAMES
	owner.cooldown = max(owner.cooldown, FREEZE_TRAP_COOLDOWN_FRAMES)
	return true

function trapCanContact(FighterState owner, FighterState target) returns boolean
	return owner.freezeTrapLife > 0 and owner.freezeTrapArming == 0 and not owner.out and not target.out and target.frozenFrames == 0 and target.grounded and target.surface == owner.freezeTrapSurface and not isIntangible(target) and (target.x - owner.freezeTrapX).abs() <= FREEZE_TRAP_TRIGGER_RADIUS

function freezeFromTrap(FighterState target)
	clearGrabLinks(target)
	clearDownState(target)
	cancelAttack(target)
	clearLedge(target)
	target.ledgeRegrab = 0
	target.shield = false
	target.shieldStun = 0
	target.shieldReleaseLag = 0
	target.hitstun = 0
	target.hitlag = 0
	target.grabbedFrames = 0
	target.vx = 0
	target.vz = 0
	target.knockbackX = 0
	target.knockbackZ = 0
	target.frozenFrames = FREEZE_TRAP_FREEZE_FRAMES
	cancelSpecialState(target)

// Determine both contacts against the same pre-mutation frame, then consume
// traps and freeze targets. Simultaneous traps therefore do not depend on P1 order.
public function advanceFreezeTrapPair(FighterState first, FighterState second)
	let firstTriggers = trapCanContact(first, second)
	let secondTriggers = trapCanContact(second, first)
	let freezeSecond = firstTriggers and not (second.shield and second.shieldEnergy > 0)
	let freezeFirst = secondTriggers and not (first.shield and first.shieldEnergy > 0)
	if firstTriggers
		clearOwnedFreezeTrap(first)
	if secondTriggers
		clearOwnedFreezeTrap(second)
	if freezeFirst
		freezeFromTrap(first)
	if freezeSecond
		freezeFromTrap(second)

public function shieldBreakDizzyFrames(real percent) returns int
	// Prototype timing; only the inverse percent relationship is reference-backed.
	return max(60, 240 - R2I(max(0, percent)))

function beginShieldBreak(FighterState f)
	clearGrabLinks(f)
	interruptJumpOrDodge(f)
	clearDownState(f)
	cancelAttack(f)
	f.shieldBreakState = SHIELD_BREAK_AIR
	f.shieldBreakSerial++
	f.shield = false
	f.shieldEnergy = 0
	f.shieldStun = 0
	f.shieldHeldFrames = 0
	f.shieldReleaseLag = 0
	f.hitstun = 0
	f.grabbedFrames = 0
	f.landingLag = 0
	f.lCancelWindow = 0
	f.techWindow = 0
	f.techLockout = 0
	f.techHitlagLatched = false
	f.dropTime = 0
	f.diPending = false
	f.diLaunchSpeed = 0
	f.vx = 0
	f.vz = SHIELD_BREAK_LAUNCH_SPEED
	f.knockbackX = 0
	f.knockbackZ = 0
	f.grounded = false
	f.surface = -1

function advanceShieldBreak(FighterState f, int stage, InputSnapshot input)
	if f.hitlag > 0
		f.hitlag--
		return
	checkBlastZone(f)
	if f.out
		return
	f.invincible = max(0, f.invincible - 1)
	f.shieldBreakFrame++
	if f.shieldBreakState == SHIELD_BREAK_AIR
		let oldZ = f.z
		f.vz = max(-characterTerminalSpeed(f.character), f.vz - characterGravity(f.character))
		f.z += f.vz
		let landing = landingAlongShift(f, stage, f.x, oldZ, f.x, f.z)
		if landing >= 0
			f.z = surfaceZ(stage, landing)
			f.surface = landing
			f.grounded = true
			f.vz = 0
			f.jumps = 2
			f.shieldBreakState = SHIELD_BREAK_LAND
			f.shieldBreakFrame = 0
	else if f.shieldBreakState == SHIELD_BREAK_LAND and f.shieldBreakFrame >= SHIELD_BREAK_LAND_FRAMES
		f.shieldBreakState = SHIELD_BREAK_STAND
		f.shieldBreakFrame = 0
	else if f.shieldBreakState == SHIELD_BREAK_STAND and f.shieldBreakFrame >= SHIELD_BREAK_STAND_FRAMES
		f.shieldBreakState = SHIELD_BREAK_DIZZY
		f.shieldBreakFrame = 0
		f.shieldBreakRemaining = shieldBreakDizzyFrames(f.damage)
		f.shieldEnergy = SHIELD_BREAK_RESTORED_ENERGY
	else if f.shieldBreakState == SHIELD_BREAK_DIZZY
		f.shieldBreakRemaining = max(0, f.shieldBreakRemaining - 1 - (input.mashPressed ? SHIELD_BREAK_MASH_REDUCTION : 0))
		if f.shieldBreakRemaining == 0
			clearShieldBreak(f)
	checkBlastZone(f)

function clearDownState(FighterState f)
	f.downState = DOWN_NONE
	f.downFrame = 0
	f.downDirection = 0
	f.downWaitRemaining = 0
	f.downFaceUp = true

function beginDownState(FighterState f, int state, int direction)
	f.downState = state
	f.downFrame = 1
	f.downDirection = direction
	if state != DOWN_DAMAGE
		f.downWaitRemaining = 0
	f.vx = 0
	f.vz = 0
	f.knockbackX = 0
	f.knockbackZ = 0
	f.shield = false
	f.shieldHeldFrames = 0
	f.grounded = true
	if state == DOWN_ATTACK
		f.attackStyle = DOWN_ATTACK_STYLE
		f.attackFrame = 0
		f.attackDuration = DOWN_ATTACK_FRAMES
		f.attackSerial++
		f.attackHit = false
		f.smashCharging = false
		f.smashChargeFrames = 0
		f.smashChargeAllowed = false
		f.cooldown = DOWN_ATTACK_FRAMES

function finishLanding(FighterState f, int stage, InputSnapshot input, int landing, boolean fromAsdi)
	if not f.grounded
		clearDash(f)
	if not f.grounded and not f.airDodging and not isAerialAttack(f.attackStyle) and f.downState == DOWN_NONE and f.hitstun <= 0 and not fromAsdi
		f.landingLag = max(f.landingLag, EMPTY_LANDING_LAG)
	if f.airDodging
		f.landingLag = AIR_DODGE_LANDING_LAG
		f.airDodging = false
		f.airDodgeFrame = 0
	if isAerialAttack(f.attackStyle)
		var recovery = attackLandingLag(f.attackStyle)
		if f.lCancelWindow > 0
			recovery = recovery div 2
			f.lCancelSerial++
		f.landingLag = max(f.landingLag, recovery)
		cancelAttack(f)
	f.lCancelWindow = 0
	f.grounded = true
	f.surface = landing
	f.z = surfaceZ(stage, landing)
	f.vz = 0
	f.knockbackZ = 0
	f.specialFall = false
	f.lastAerialTapDirection = 0
	if f.jumpSquat <= 0
		f.jumps = 2
	if isTumbling(f)
		let launchDirection = totalVelocityX(f) < 0 ? -1 : 1
		f.hitstun = 0
		if f.techWindow > 0
			let techDirection = input.direction == 0 ? 0 : (input.direction < 0 ? -1 : 1)
			f.techWindow = 0
			beginDownState(f, techDirection == 0 ? DOWN_TECH : DOWN_TECH_ROLL, techDirection)
		else
			beginDownState(f, DOWN_BOUND, launchDirection)
	else if fromAsdi
		f.hitstun = 0

function landingAlongShift(FighterState f, int stage, real oldX, real oldZ, real newX, real newZ) returns int
	if newZ >= oldZ
		return -1
	var landing = -1
	for i = 0 to surfaceCount(stage) - 1
		let platformZ = surfaceZ(stage, i)
		if oldZ >= platformZ and newZ <= platformZ and not (surfacePass(stage, i) and f.dropTime > 0)
			let fraction = (oldZ - platformZ) / (oldZ - newZ)
			let crossingX = oldX + (newX - oldX) * fraction
			if crossingX >= surfaceLeft(stage, i) and crossingX <= surfaceRight(stage, i) and newX >= surfaceLeft(stage, i) and newX <= surfaceRight(stage, i)
				if landing < 0 or platformZ > surfaceZ(stage, landing)
					landing = i
	return landing

function applyHitlagShift(FighterState f, int stage, InputSnapshot input, int directionX, int directionZ, real distance, boolean fromAsdi)
	if directionX == 0 and directionZ == 0
		return
	let diagonalScale = directionX != 0 and directionZ != 0 ? DIAGONAL_UNIT : 1
	let shiftX = directionX * diagonalScale * distance
	var shiftZ = directionZ * diagonalScale * distance
	if f.sdiWasGrounded and not f.sdiLaunchesUpward
		shiftZ = 0
	if shiftX == 0 and shiftZ == 0
		return
	let oldX = f.x
	let oldZ = f.z
	let newX = oldX + shiftX
	var newZ = oldZ + shiftZ
	var landing = landingAlongShift(f, stage, oldX, oldZ, newX, newZ)
	if not fromAsdi and landing >= 0 and shiftZ < 0
		newZ = oldZ
		landing = -1
	f.x = newX
	if landing >= 0
		finishLanding(f, stage, input, landing, fromAsdi)
	else
		f.z = newZ
	if f.x != oldX or f.z != oldZ
		if fromAsdi
			f.asdiSerial++
		else
			f.sdiSerial++
	checkBlastZone(f)

function applySmashDirectionalInfluence(FighterState f, int stage, InputSnapshot input)
	if input.sdiPulse
		applyHitlagShift(f, stage, input, input.sdiX, input.sdiZ, SDI_DISTANCE, false)

function applyAutomaticSmashDirectionalInfluence(FighterState f, int stage, InputSnapshot input)
	var directionX = input.direction
	var directionZ = input.verticalDirection
	if input.cStickX != 0 or input.cStickZ != 0
		directionX = input.cStickX
		directionZ = input.cStickZ
	applyHitlagShift(f, stage, input, directionX, directionZ, ASDI_DISTANCE, true)

function startDownWait(FighterState f, int remainingFrames)
	f.downState = DOWN_WAIT
	f.downFrame = 0
	f.downDirection = 0
	f.downWaitRemaining = max(0, remainingFrames)

function startDownStand(FighterState f)
	beginDownState(f, DOWN_STAND, 0)

function advanceDownState(FighterState f, int stage, InputSnapshot input) returns boolean
	let leavingBound = f.downState == DOWN_BOUND and f.downFrame >= DOWN_BOUND_FRAMES
	if f.downState == DOWN_NONE
		return false
	if f.downState == DOWN_TUMBLE
		f.downFrame++
		return false
	if isFloorTeching(f)
		f.downFrame++
		if f.downState == DOWN_TECH_ROLL and f.downFrame >= TECH_ROLL_MOVE_START and f.downFrame <= TECH_ROLL_MOVE_END
			f.x += f.downDirection * (TECH_ROLL_DISTANCE / (TECH_ROLL_MOVE_END - TECH_ROLL_MOVE_START + 1))
			f.x = max(surfaceLeft(stage, f.surface), min(surfaceRight(stage, f.surface), f.x))
		return true
	if f.downState == DOWN_BOUND
		if f.downFrame >= DOWN_BOUND_FRAMES
			startDownWait(f, DOWN_WAIT_FRAMES)
		else
			f.downFrame++
			f.grounded = true
			f.z = surfaceZ(stage, max(0, f.surface))
			return true
	if f.downState == DOWN_DAMAGE
		f.grounded = true
		f.z = surfaceZ(stage, max(0, f.surface))
		f.vz = 0
		f.knockbackZ = 0
		if f.downFrame >= DOWN_DAMAGE_FRAMES
			if f.hitstun <= 0
				startDownStand(f)
			else
				startDownWait(f, f.hitstun)
		else
			f.downFrame++
		return true
	if f.downState == DOWN_WAIT
		f.grounded = true
		f.z = surfaceZ(stage, max(0, f.surface))
		if input.getupAttackPressed
			beginDownState(f, DOWN_ATTACK, 0)
		else if input.getupDirectionPressed and input.getupDirection != 0
			beginDownState(f, DOWN_ROLL, input.getupDirection)
		else if input.direction != 0
			beginDownState(f, DOWN_ROLL, input.direction < 0 ? -1 : 1)
		else if input.getupStandPressed or input.verticalDirection > 0
			startDownStand(f)
		else if not leavingBound
			f.downWaitRemaining = max(0, f.downWaitRemaining - 1)
			f.downFrame++
			if f.downWaitRemaining == 0
				startDownStand(f)
		return true
	if f.downState == DOWN_STAND
		f.grounded = true
		f.z = surfaceZ(stage, max(0, f.surface))
		if f.downFrame >= DOWN_STAND_FRAMES
			clearDownState(f)
		else
			f.downFrame++
		return true
	if f.downState == DOWN_ROLL
		f.grounded = true
		f.z = surfaceZ(stage, max(0, f.surface))
		if f.downFrame >= DOWN_ROLL_FRAMES
			clearDownState(f)
		else
			f.downFrame++
			if f.downFrame >= GROUND_ROLL_MOVE_START and f.downFrame <= GROUND_ROLL_MOVE_END
				f.x += f.downDirection * (DOWN_ROLL_DISTANCE / (GROUND_ROLL_MOVE_END - GROUND_ROLL_MOVE_START + 1))
				f.x = max(surfaceLeft(stage, max(0, f.surface)), min(surfaceRight(stage, max(0, f.surface)), f.x))
			f.z = surfaceZ(stage, max(0, f.surface))
			f.grounded = true
		return true
	if f.downState == DOWN_ATTACK
		f.grounded = true
		f.z = surfaceZ(stage, max(0, f.surface))
		if f.downFrame >= DOWN_ATTACK_FRAMES
			clearDownState(f)
		else
			f.downFrame++
		return true
	return false

function beginGroundDodge(FighterState f, int direction)
	clearDash(f)
	if direction < 0
		f.groundDodgeDirection = -1
		f.vx = 0
	else if direction > 0
		f.groundDodgeDirection = 1
		f.vx = 0
	else
		f.groundDodgeDirection = 0
		f.vx = 0
	f.groundDodgeFrame = 1
	f.shield = false
	f.shieldHeldFrames = 0

function interruptJumpOrDodge(FighterState f)
	clearDash(f)
	if f.ledgeState != LEDGE_NONE
		leaveLedge(f)
	clearShieldBreak(f)
	f.jumpSquat = 0
	f.jumpDodgeQueued = false
	f.jumpDodgeX = 0
	f.jumpDodgeZ = 0
	f.jumpHeld = false
	f.airDodging = false
	f.airDodgeTime = 0
	f.airDodgeFrame = 0
	f.groundDodgeFrame = 0
	f.groundDodgeDirection = 0

function beginAttack(FighterState attacker, int style, boolean mayCharge)
	clearDash(attacker)
	if isTumbling(attacker)
		clearDownState(attacker)
	if style == 5 and attacker.shield
		attacker.shield = false
		attacker.shieldHeldFrames = 0
	attacker.attackStyle = style
	attacker.attackFrame = 0
	attacker.attackDuration = attackDurationFramesForGrounding(style, attacker.grounded)
	attacker.attackSerial++
	attacker.attackHit = false
	attacker.smashCharging = false
	attacker.smashChargeFrames = 0
	attacker.smashChargeAllowed = isSmashAttack(style) and mayCharge
	attacker.cooldown = attacker.attackDuration

function spawnProjectileMotion(FighterState owner, int kind, real velocityX, real velocityZ,
		int lifetime, int serial)
	for index = 0 to PROJECTILE_CAPACITY - 1
		if owner.projectileLife[index] <= 0
			owner.projectileDirection[index] = velocityX < 0 ? -1 : 1
			owner.projectileKind[index] = kind
			owner.projectileVelocityX[index] = velocityX
			owner.projectileVelocityZ[index] = velocityZ
			owner.projectileSerial[index] = serial
			owner.projectileX[index] = owner.x + (velocityX < 0 ? -1 : 1) * BLASTER_PROJECTILE_SPAWN_OFFSET
			owner.projectileZ[index] = owner.z + BLASTER_PROJECTILE_HEIGHT
			owner.projectileLife[index] = lifetime
			return

function spawnProjectile(FighterState owner)
	spawnProjectileMotion(owner, PROJECTILE_BLASTER, owner.facing * BLASTER_PROJECTILE_SPEED, 0,
		BLASTER_PROJECTILE_LIFETIME, owner.attackSerial)

function spawnArcherArrow(FighterState owner, int direction, real verticalSpeed, int kind, int serial)
	let facing = direction == 0 ? owner.facing : (direction > 0 ? 1 : -1)
	spawnProjectileMotion(owner, kind, facing * BLASTER_PROJECTILE_SPEED, verticalSpeed,
		kind == PROJECTILE_ARROW ? 75 : 65, serial)

function applySpecialProjectileHit(FighterState target, int kind, int direction)
	let damage = kind == PROJECTILE_FAN_ARROW ? 4. : (kind == PROJECTILE_RECOIL or kind == PROJECTILE_MANA_BURN ? 5. : 7.)
	let damageOnly = kind == PROJECTILE_ARROW or kind == PROJECTILE_FAN_ARROW
	if target.shield and target.shieldEnergy > 0
		target.shieldEnergy = max(0, target.shieldEnergy - damage * 0.7)
		if not damageOnly
			target.shieldStun = digitalShieldstunFrames(damage)
			target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))
		if target.shieldEnergy == 0
			beginShieldBreak(target)
		return
	if damageOnly
		target.damage += damage
		target.frozenFrames = 0
		return
	let jabReset = isDownDamageState(target) and damage < DOWN_DAMAGE_MAX_HIT_DAMAGE
	let groundedBeforeHit = target.grounded
	clearGrabLinks(target)
	target.frozenFrames = 0
	target.diPending = false
	target.diLaunchSpeed = 0
	interruptJumpOrDodge(target)
	if not jabReset
		clearDownState(target)
	cancelAttack(target)
	cancelSpecialState(target)
	target.damage += damage
	let knockback = ordinaryHitKnockback(target.damage - damage, damage,
		target.character == 0 ? 75. : 80., 85, 16, 1)
	target.hitstun = ordinaryHitstunFrames(knockback)
	if jabReset
		beginDownDamage(target, target.hitstun)
	else
		target.vx = 0
		target.vz = 0
		target.grounded = false
		let launch = knockback * KNOCKBACK_LAUNCH_SCALE
		target.knockbackX = direction * launch * 0.8
		target.knockbackZ = launch * (kind == PROJECTILE_RECOIL ? -0.6 : 0.6)
		target.sdiWasGrounded = groundedBeforeHit
		target.sdiLaunchesUpward = target.knockbackZ > 0
		target.diPending = true
		target.diLaunchSpeed = launch
		if knockback >= DOWN_KNOCKBACK_THRESHOLD
			target.downState = DOWN_TUMBLE
			target.downFrame = 0
			target.downDirection = 0
			target.downFaceUp = target.knockbackZ >= 0
	target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))

function demonHunterParryIsActive(FighterState fighter) returns boolean
	return fighter.character == 2 and fighter.specialAction == SPECIAL_DEMONHUNTER_PARRY_STEP
		and fighter.specialFrame >= DEMONHUNTER_PARRY_START
		and fighter.specialFrame <= DEMONHUNTER_PARRY_END

function resolveDemonHunterParry(FighterState defender, FighterState attacker, int awayDirection)
	if not demonHunterParryIsActive(defender)
		return
	// Original parry choice: a close-range strike during frames 4-9 cancels
	// the attacker and gives 10 hitstun / 4 hitlag. No projectile reflection.
	cancelAttack(attacker)
	cancelSpecialState(attacker)
	attacker.hitstun = max(attacker.hitstun, 10)
	attacker.hitlag = max(attacker.hitlag, 4)
	attacker.grounded = false
	attacker.vx = 0
	attacker.vz = 0
	attacker.knockbackX = awayDirection * 9.
	attacker.knockbackZ = 4.
	defender.specialAction = SPECIAL_NONE
	defender.specialFrame = 0
	defender.specialLockFrames = 0

function applyProjectileHit(FighterState owner, FighterState target, int index)
	if demonHunterParryIsActive(target)
		resolveDemonHunterParry(target, owner, -owner.projectileDirection[index])
		return
	if owner.projectileKind[index] != PROJECTILE_BLASTER
		applySpecialProjectileHit(target, owner.projectileKind[index], owner.projectileDirection[index])
		return
	let damage = attackDamage(1)
	if target.shield and target.shieldEnergy > 0
		target.shieldEnergy = max(0, target.shieldEnergy - damage * 0.7)
		target.shieldStun = digitalShieldstunFrames(damage)
		target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))
		if target.shieldEnergy == 0
			beginShieldBreak(target)
		return
	let jabReset = isDownDamageState(target) and damage < DOWN_DAMAGE_MAX_HIT_DAMAGE
	target.frozenFrames = 0
	clearGrabLinks(target)
	target.damage += damage
	target.diPending = false
	target.diLaunchSpeed = 0
	interruptJumpOrDodge(target)
	if not jabReset
		clearDownState(target)
	cancelAttack(target)
	target.hitstun = max(target.hitstun, 11)
	target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))
	cancelSpecialState(target)
	if jabReset
		beginDownDamage(target, target.hitstun)

function updateProjectiles(FighterState owner, FighterState target, real targetX, real targetZ, boolean targetWasOut, boolean targetWasIntangible)
	for index = 0 to PROJECTILE_CAPACITY - 1
		if owner.projectileLife[index] > 0
			let oldX = owner.projectileX[index]
			let oldZ = owner.projectileZ[index]
			var velocityX = owner.projectileVelocityX[index]
			let velocityZ = owner.projectileVelocityZ[index]
			if owner.projectileKind[index] == PROJECTILE_BLASTER and velocityX == 0
				velocityX = owner.projectileDirection[index] * BLASTER_PROJECTILE_SPEED
				owner.projectileVelocityX[index] = velocityX
			owner.projectileX[index] = oldX + velocityX
			owner.projectileZ[index] = oldZ + velocityZ
			owner.projectileLife[index]--
			let direction = velocityX < 0 ? -1 : 1
			let crossedTarget = (targetX - oldX) * direction >= 0 and (targetX - owner.projectileX[index]) * direction <= 0
			let nearTarget = (targetX - owner.projectileX[index]).abs() <= BLASTER_PROJECTILE_RADIUS
			let crossedHeight = targetZ + 45 >= min(oldZ, owner.projectileZ[index]) - BLASTER_PROJECTILE_HALF_HEIGHT and targetZ + 45 <= max(oldZ, owner.projectileZ[index]) + BLASTER_PROJECTILE_HALF_HEIGHT
			if (crossedTarget or nearTarget) and crossedHeight and not targetWasOut and not targetWasIntangible
				applyProjectileHit(owner, target, index)
				owner.projectileLife[index] = 0
			else if owner.projectileLife[index] <= 0
				owner.projectileLife[index] = 0

public function updateProjectilePair(FighterState first, FighterState second)
	let firstWasOut = first.out
	let secondWasOut = second.out
	let firstWasIntangible = isIntangible(first)
	let secondWasIntangible = isIntangible(second)
	let firstX = first.x
	let firstZ = first.z
	let secondX = second.x
	let secondZ = second.z
	updateProjectiles(first, second, secondX, secondZ, secondWasOut, secondWasIntangible)
	updateProjectiles(second, first, firstX, firstZ, firstWasOut, firstWasIntangible)

function clearGrabLinks(FighterState f)
	let owner = f.grabOwner
	let target = f.grabTarget
	f.grabOwner = null
	f.grabTarget = null
	f.grabbedFrames = 0
	f.grabAction = GRAB_NONE
	f.grabFrame = 0
	f.grabMashX = 0
	f.grabMashZ = 0
	if owner != null and owner.grabTarget == f
		owner.grabTarget = null
		owner.grabAction = GRAB_NONE
		owner.grabFrame = 0
	if target != null and target.grabOwner == f
		target.grabOwner = null
		target.grabbedFrames = 0
		target.grabMashX = 0
		target.grabMashZ = 0

public function inGrabContext(FighterState f) returns boolean
	return f.grabOwner != null or f.grabTarget != null or f.grabAction != GRAB_NONE or f.grabbedFrames > 0

function beginGrabAction(FighterState owner, int action)
	owner.grabAction = action
	owner.grabFrame = 1
	owner.grabSerial++

function escapeGrab(FighterState owner, FighterState target)
	clearGrabLinks(owner)
	beginGrabAction(owner, GRAB_ESCAPE)
	target.hitstun = 10

function releaseThrow(FighterState owner, FighterState target, InputSnapshot targetInput)
	let action = owner.grabAction
	let damage = action == THROW_UP ? 6. : (action == THROW_DOWN ? 5. : 7.)
	let knockback = ordinaryHitKnockback(target.damage, damage,
		target.character == 0 ? 75. : 80., 70, action == THROW_DOWN ? 55. : 45., 1)
	owner.grabTarget = null
	target.grabOwner = null
	target.grabbedFrames = 0
	target.grabMashX = 0
	target.grabMashZ = 0
	target.damage += damage
	target.vx = 0
	target.vz = 0
	target.grounded = false
	target.surface = -1
	let launch = knockback * KNOCKBACK_LAUNCH_SCALE
	let direction = action == THROW_BACK ? -owner.facing : owner.facing
	target.knockbackX = direction * launch * (action == THROW_UP ? 0.173648 : (action == THROW_DOWN ? 0.342020 : 0.866025))
	target.knockbackZ = launch * (action == THROW_UP ? 0.984808 : (action == THROW_DOWN ? 0.939693 : 0.5))
	target.diPending = true
	target.diLaunchSpeed = launch
	applyDirectionalInfluence(target, targetInput)
	target.hitstun = ordinaryHitstunFrames(knockback)
	if knockback >= DOWN_KNOCKBACK_THRESHOLD
		target.downState = DOWN_TUMBLE
		target.downFrame = 0
		target.downDirection = 0
		target.downFaceUp = target.knockbackZ >= 0

function advanceGrab(FighterState owner, InputSnapshot ownerInput, InputSnapshot targetInput, boolean paused)
	if owner.grabAction == GRAB_NONE or paused
		return
	let target = owner.grabTarget
	if target != null and (owner.grabAction == GRAB_HOLD or owner.grabAction == GRAB_PUMMEL)
		var contributions = targetInput.grabMashPressed ? 1 : 0
		let x = targetInput.direction == 0 ? target.grabMashX : targetInput.direction
		let z = targetInput.verticalDirection == 0 ? target.grabMashZ : targetInput.verticalDirection
		if x != target.grabMashX or z != target.grabMashZ
			contributions++
		target.grabMashX = x
		target.grabMashZ = z
		target.grabbedFrames = max(0, target.grabbedFrames - 1 - 6 * contributions)
		if target.grabbedFrames == 0
			escapeGrab(owner, target)
			return
	if owner.grabAction == GRAB_HOLD
		if ownerInput.attackPressed
			beginGrabAction(owner, GRAB_PUMMEL)
		else if ownerInput.grabThrowZ != 0
			beginGrabAction(owner, ownerInput.grabThrowZ > 0 ? THROW_UP : THROW_DOWN)
		else if ownerInput.grabThrowX != 0
			beginGrabAction(owner, ownerInput.grabThrowX == owner.facing ? THROW_FORWARD : THROW_BACK)
	else if owner.grabFrame >= grabActionDuration(owner.grabAction)
		owner.grabAction = target == null ? GRAB_NONE : GRAB_HOLD
		owner.grabFrame = 0
	else
		owner.grabFrame++
	if target != null and owner.grabAction >= GRAB_PUMMEL and owner.grabAction <= THROW_DOWN and owner.grabFrame == grabContactFrame(owner.grabAction)
		resolveHeldTarget(owner)
		if owner.grabAction == GRAB_PUMMEL
			target.damage += 3
			owner.hitlag = ordinaryHitlagFrames(3)
			target.hitlag = owner.hitlag
		else
			releaseThrow(owner, target, targetInput)

public function advanceGrabPair(FighterState first, FighterState second, InputSnapshot firstInput, InputSnapshot secondInput, boolean paused)
	advanceGrab(first, firstInput, secondInput, paused)
	advanceGrab(second, secondInput, firstInput, paused)

function resolveHeldTarget(FighterState owner)
	let target = owner.grabTarget
	if target == null
		return
	if owner.out or target.out or owner.frozenFrames > 0 or target.frozenFrames > 0 or owner.hitstun > 0 or target.grabbedFrames <= 0 or target.grabOwner != owner
		clearGrabLinks(owner)
		return
	owner.vx = 0
	owner.vz = 0
	owner.knockbackX = 0
	owner.knockbackZ = 0
	target.x = owner.x + owner.facing * GRAB_HOLD_DISTANCE
	target.z = owner.z
	if owner.grabAction >= THROW_FORWARD and owner.grabAction <= THROW_DOWN
		let progress = min(1., owner.grabFrame * 1. / grabContactFrame(owner.grabAction))
		if owner.grabAction == THROW_BACK
			target.x = owner.x + owner.facing * GRAB_HOLD_DISTANCE * (1 - 2 * progress)
			target.z += 75 * (1 - (2 * progress - 1) * (2 * progress - 1))
		else if owner.grabAction == THROW_UP
			target.z += 65 * progress
		else if owner.grabAction == THROW_DOWN
			target.z += 25 * (1 - (2 * progress - 1) * (2 * progress - 1))
	target.surface = owner.surface
	target.grounded = owner.grounded
	target.facing = -owner.facing
	target.vx = 0
	target.vz = 0
	target.knockbackX = 0
	target.knockbackZ = 0

// Resolve after both fighters advance, so expiry never gives the second slot
// an extra movement tick. Run again after contacts to anchor a newly caught pair.
public function resolveGrabPair(FighterState first, FighterState second)
	resolveHeldTarget(first)
	resolveHeldTarget(second)

function cancelAttack(FighterState fighter)
	fighter.attackStyle = -1
	fighter.attackFrame = 0
	fighter.attackDuration = 0
	fighter.attackHit = false
	fighter.cooldown = 0
	fighter.smashCharging = false
	fighter.smashChargeFrames = 0
	fighter.smashChargeAllowed = false

function applyAttackHit(FighterState attacker, FighterState target, int style, int facing, hitEffect hitData, boolean directContact)
	let damage = hitData.damage
	if demonHunterParryIsActive(target)
		resolveDemonHunterParry(target, attacker, -facing)
		return
	if style == 5
		if target.frozenFrames > 0
			return
		clearGrabLinks(attacker)
		clearGrabLinks(target)
		attacker.grabTarget = target
		target.grabOwner = attacker
		cancelAttack(attacker)
		beginGrabAction(attacker, GRAB_HOLD)
		clearDash(attacker)
		attacker.vx = 0
		attacker.vz = 0
		attacker.knockbackX = 0
		attacker.knockbackZ = 0
		target.diPending = false
		target.diLaunchSpeed = 0
		interruptJumpOrDodge(target)
		clearDownState(target)
		cancelAttack(target)
		target.grabbedFrames = grabHoldFrames(target.damage)
		target.hitstun = 0
		target.hitlag = 0
		cancelSpecialState(target)
		target.shield = false
		target.shieldStun = 0
		target.vx = 0
		target.vz = 0
		target.knockbackX = 0
		target.knockbackZ = 0
		return
	if target.shield and target.shieldEnergy > 0
		target.shieldEnergy = max(0, target.shieldEnergy - damage * 0.7)
		target.shieldStun = digitalShieldstunFrames(damage)
		target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))
		if directContact
			attacker.hitlag = max(attacker.hitlag, ordinaryHitlagFrames(damage))
		if target.shieldEnergy == 0
			beginShieldBreak(target)
		return
	let groundedBeforeHit = target.grounded
	let jabReset = isDownDamageState(target) and damage < DOWN_DAMAGE_MAX_HIT_DAMAGE
	if damage > 0
		target.frozenFrames = 0
	clearGrabLinks(target)
	target.diPending = false
	target.diLaunchSpeed = 0
	interruptJumpOrDodge(target)
	if not jabReset
		clearDownState(target)
	cancelAttack(target)
	cancelSpecialState(target)
	let weight = target.character == 0 ? 75. : 80.
	let knockback = ordinaryHitKnockback(target.damage, damage, weight,
		hitData.growth, hitData.base, ORDINARY_HIT_CONTEXT_SCALE)
	target.damage += damage
	target.hitstun = ordinaryHitstunFrames(knockback)
	if jabReset
		beginDownDamage(target, target.hitstun)
	else
		target.vx = 0
		target.vz = 0
		target.grounded = false
		let launch = knockback * KNOCKBACK_LAUNCH_SCALE
		target.knockbackX = facing * launch * hitData.launchX
		target.knockbackZ = launch * hitData.launchZ
		target.sdiWasGrounded = groundedBeforeHit
		target.sdiLaunchesUpward = target.knockbackZ > 0
		target.diPending = true
		target.diLaunchSpeed = launch
		if knockback >= DOWN_KNOCKBACK_THRESHOLD
			target.downState = DOWN_TUMBLE
			target.downFrame = 0
			target.downDirection = 0
			target.downFaceUp = target.knockbackZ >= 0
	target.hitlag = max(target.hitlag, ordinaryHitlagFrames(damage))
	if directContact
		attacker.hitlag = max(attacker.hitlag, ordinaryHitlagFrames(damage))

function startSpecialAction(FighterState owner, int action, int duration, int direction)
	owner.specialAction = action
	owner.specialFrame = 0
	owner.specialDuration = duration
	owner.specialLockFrames = duration
	owner.specialDirection = direction < 0 ? -1 : (direction > 0 ? 1 : 0)
	owner.attackStyle = -1
	owner.attackFrame = 0
	owner.attackDuration = 0
	owner.attackHit = false
	owner.smashCharging = false
	owner.smashChargeFrames = 0
	owner.smashChargeAllowed = false
	owner.shield = false
	owner.shieldHeldFrames = 0
	owner.cooldown = max(owner.cooldown, duration)

function specialDirection(InputSnapshot input, int facing) returns int
	if input.direction != 0
		return input.direction
	return input.verticalDirection == 0 ? facing : 0

function requestedSpecial(FighterState owner, InputSnapshot input) returns int
	if owner.character == 0
		if input.verticalDirection > 0
			return SPECIAL_ARCHER_RECOVERY
		if input.verticalDirection < 0 or input.down
			return SPECIAL_ARCHER_DISENGAGE
		if input.direction != 0
			return SPECIAL_ARCHER_MULTISHOT
		return SPECIAL_ARCHER_ARROW
	if owner.character == 1
		if input.verticalDirection < 0 or input.down
			return SPECIAL_RIFLEMAN_TRAP
		if input.verticalDirection > 0
			return SPECIAL_RIFLEMAN_RECOVERY
		if input.direction != 0
			return SPECIAL_RIFLEMAN_BEAR
		return SPECIAL_RIFLEMAN_BLASTER
	if owner.character == 2
		if input.verticalDirection > 0
			return SPECIAL_DEMONHUNTER_WING_ASCENT
		if input.verticalDirection < 0 or input.down
			return SPECIAL_DEMONHUNTER_IMMOLATE
		if input.direction != 0
			return SPECIAL_DEMONHUNTER_PARRY_STEP
		return SPECIAL_DEMONHUNTER_MANA_BURN
	return SPECIAL_NONE

function specialCanStart(FighterState owner, int action) returns boolean
	return action > SPECIAL_NONE and action < SPECIAL_ACTION_CAPACITY
		and owner.specialCooldowns[action] <= 0 and owner.specialLockFrames <= 0
		and owner.specialAction == SPECIAL_NONE and canAttack(owner)

public function startFighterSpecial(FighterState owner, int stage, InputSnapshot input) returns boolean
	if not input.specialPressed
		return false
	let requested = requestedSpecial(owner, input)
	if not specialCanStart(owner, requested)
		return false
	if not owner.grounded and input.direction == 0 and input.verticalDirection == 0 and not input.down and owner.lastAerialTapDirection != 0
		owner.facing = owner.lastAerialTapDirection
	let moveX = specialDirection(input, owner.facing)
	if owner.character == 0
		if input.verticalDirection > 0
			startSpecialAction(owner, SPECIAL_ARCHER_RECOVERY, ARCHER_RECOVERY_FRAMES, moveX)
			owner.hippogryphKind = 2
			owner.hippogryphLife = ARCHER_RECOVERY_FRAMES
			owner.hippogryphX = owner.x
			owner.hippogryphZ = owner.z
			owner.hippogryphVelocityX = moveX * 2.
			owner.hippogryphVelocityZ = 32
			owner.vx = moveX * 3.
			owner.vz = 32
			owner.grounded = false
			owner.surface = -1
			owner.jumps = 0
			owner.specialCooldowns[SPECIAL_ARCHER_RECOVERY] = 90
			return true
		if input.verticalDirection < 0 or input.down
			startSpecialAction(owner, SPECIAL_ARCHER_DISENGAGE, ARCHER_DISENGAGE_FRAMES, moveX)
			owner.hippogryphKind = 1
			owner.specialHit = false
			owner.hippogryphLife = 18
			owner.hippogryphX = owner.x - owner.facing * 150
			owner.hippogryphZ = owner.z + 40
			owner.hippogryphVelocityX = owner.facing * 32.
			owner.hippogryphVelocityZ = 0
			owner.vx = -owner.facing * 18.
			owner.vz = 16
			owner.grounded = false
			owner.surface = -1
			owner.specialCooldowns[SPECIAL_ARCHER_DISENGAGE] = 75
			return true
		if input.direction != 0
			startSpecialAction(owner, SPECIAL_ARCHER_MULTISHOT, 34, moveX)
			owner.specialCooldowns[SPECIAL_ARCHER_MULTISHOT] = 40
			return true
		startSpecialAction(owner, SPECIAL_ARCHER_ARROW, 3, moveX)
		owner.cooldown = 0
		owner.specialCooldowns[SPECIAL_ARCHER_ARROW] = 8
		return true
	if owner.character == 1
		if input.verticalDirection < 0 or input.down
			if startFreezeTrap(owner, stage)
				startSpecialAction(owner, SPECIAL_RIFLEMAN_TRAP, 20, moveX)
				owner.specialCooldowns[SPECIAL_RIFLEMAN_TRAP] = 90
				return true
			return false
		if input.verticalDirection > 0
			if not owner.grounded
				owner.jumps = 0
			startSpecialAction(owner, SPECIAL_RIFLEMAN_RECOVERY, 34, moveX)
			owner.specialCooldowns[SPECIAL_RIFLEMAN_RECOVERY] = 90
			return true
		if input.direction != 0
			if owner.bearLife > 0
				return false
			startSpecialAction(owner, SPECIAL_RIFLEMAN_BEAR, 18, moveX)
			owner.bearLife = RIFLEMAN_BEAR_LIFETIME
			owner.bearX = owner.x + moveX * 45
			owner.bearZ = owner.grounded and owner.surface >= 0 ? surfaceZ(stage, owner.surface) : owner.z
			owner.bearVelocityX = moveX * 14.
			owner.facing = moveX
			owner.bearVelocityZ = owner.grounded ? 0 : owner.vz
			owner.bearSurface = owner.grounded ? owner.surface : -1
			owner.bearSwipeCooldown = 5
			owner.specialCooldowns[SPECIAL_RIFLEMAN_BEAR] = 90
			return true
		let duration = owner.grounded ? attackDurationFramesForGrounding(1, true) : attackDurationFramesForGrounding(1, false)
		startSpecialAction(owner, SPECIAL_RIFLEMAN_BLASTER, duration, moveX)
		owner.specialCooldowns[SPECIAL_RIFLEMAN_BLASTER] = 8
		return true
	if owner.character == 2
		if requested == SPECIAL_DEMONHUNTER_WING_ASCENT
			startSpecialAction(owner, requested, DEMONHUNTER_WING_DURATION, moveX)
			owner.specialCooldowns[requested] = 90
			owner.vx = moveX * 5.
			owner.vz = 30.
			owner.grounded = false
			owner.surface = -1
			owner.jumps = 0
			owner.jumpSquat = 0
			return true
		if requested == SPECIAL_DEMONHUNTER_IMMOLATE
			startSpecialAction(owner, requested, DEMONHUNTER_IMMOLATE_DURATION, moveX)
			owner.specialCooldowns[requested] = 24
			owner.specialHit = false
			return true
		if requested == SPECIAL_DEMONHUNTER_PARRY_STEP
			startSpecialAction(owner, requested, DEMONHUNTER_PARRY_DURATION, moveX)
			owner.specialCooldowns[requested] = 45
			owner.vx = moveX * 9.
			return true
		startSpecialAction(owner, requested, DEMONHUNTER_MANA_BURN_STARTUP + DEMONHUNTER_MANA_BURN_RECOVERY, moveX)
		owner.specialCooldowns[requested] = 24
		return true
	return false

function advanceSpecialAction(FighterState owner)
	if owner.specialAction == SPECIAL_NONE or owner.hitlag > 0
		return
	owner.specialFrame++
	if owner.specialAction == SPECIAL_ARCHER_ARROW and owner.specialFrame == 2
		spawnArcherArrow(owner, owner.facing, 0, PROJECTILE_ARROW, owner.attackSerial + 1)
	if owner.specialAction == SPECIAL_RIFLEMAN_BLASTER and owner.specialFrame == 2
		spawnProjectileMotion(owner, PROJECTILE_BLASTER, owner.facing * BLASTER_PROJECTILE_SPEED, 0,
			BLASTER_PROJECTILE_LIFETIME, owner.attackSerial + 1)
	if owner.specialAction == SPECIAL_DEMONHUNTER_MANA_BURN and owner.specialFrame == DEMONHUNTER_MANA_BURN_STARTUP
		spawnProjectileMotion(owner, PROJECTILE_MANA_BURN, owner.facing * 30., 0., 48, owner.attackSerial + 1)
	if owner.specialAction == SPECIAL_ARCHER_MULTISHOT and owner.specialFrame == ARCHER_MULTISHOT_WINDUP_FRAMES
		let direction = owner.specialDirection
		spawnArcherArrow(owner, direction, 10, PROJECTILE_FAN_ARROW, owner.attackSerial + 1)
		spawnArcherArrow(owner, direction, 0, PROJECTILE_FAN_ARROW, owner.attackSerial + 1)
		spawnArcherArrow(owner, direction, -10, PROJECTILE_FAN_ARROW, owner.attackSerial + 1)
	if owner.specialAction == SPECIAL_RIFLEMAN_RECOVERY
		if owner.specialFrame == RIFLEMAN_RECOVERY_STARTUP_FRAMES
			spawnProjectileMotion(owner, PROJECTILE_RECOIL, owner.facing * 2., -28., 8, owner.attackSerial + 1)
			owner.vx = owner.specialDirection * 8.
			owner.vz = 30
			owner.grounded = false
			owner.surface = -1
			owner.jumps = 0
		if owner.specialFrame >= RIFLEMAN_RECOVERY_STARTUP_FRAMES and owner.specialFrame <= RIFLEMAN_RECOVERY_PROTECTION_END
			owner.invincible = max(owner.invincible, 2)
	if owner.specialAction == SPECIAL_DEMONHUNTER_WING_ASCENT and owner.specialFrame == DEMONHUNTER_WING_STARTUP
		owner.vz = 30.
		owner.vx = owner.specialDirection * 5.
		owner.grounded = false
		owner.surface = -1
		owner.jumps = 0
		owner.invincible = max(owner.invincible, 4)
	if owner.specialAction == SPECIAL_ARCHER_DISENGAGE and owner.specialFrame >= ARCHER_DISENGAGE_FRAMES
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
		owner.specialHit = false
	if owner.specialAction == SPECIAL_ARCHER_RECOVERY and owner.specialFrame >= ARCHER_RECOVERY_FRAMES
		if not owner.grounded
			owner.specialFall = true
			owner.jumps = 0
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_ARCHER_MULTISHOT and owner.specialFrame >= 34
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_RIFLEMAN_BEAR and owner.specialFrame >= 18
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_RIFLEMAN_RECOVERY and owner.specialFrame >= 34
		if not owner.grounded
			owner.specialFall = true
			owner.jumps = 0
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_RIFLEMAN_TRAP and owner.specialFrame >= 20
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_RIFLEMAN_BLASTER and owner.specialFrame >= owner.specialDuration
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_DEMONHUNTER_MANA_BURN and owner.specialFrame >= owner.specialDuration
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_DEMONHUNTER_PARRY_STEP and owner.specialFrame >= owner.specialDuration
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_DEMONHUNTER_WING_ASCENT and owner.specialFrame >= owner.specialDuration
		if not owner.grounded
			owner.specialFall = true
			owner.jumps = 0
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_DEMONHUNTER_IMMOLATE and owner.specialFrame >= owner.specialDuration
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0
	if owner.specialAction == SPECIAL_ARCHER_ARROW and owner.specialFrame >= 3
		owner.specialAction = SPECIAL_NONE
		owner.specialFrame = 0

function advanceBear(FighterState owner, FighterState target, int stage)
	if owner.bearLife <= 0
		return
	owner.bearLife--
	owner.bearX += owner.bearVelocityX
	if owner.bearSwipeCooldown > 0
		owner.bearSwipeCooldown--
	if owner.bearSurface >= 0
		owner.bearZ = surfaceZ(stage, owner.bearSurface)
	else
		owner.bearVelocityZ = max(-characterTerminalSpeed(owner.character), owner.bearVelocityZ - characterGravity(owner.character))
		owner.bearZ += owner.bearVelocityZ
		if owner.bearZ <= surfaceZ(stage, 0)
			owner.bearZ = surfaceZ(stage, 0)
			owner.bearVelocityZ = 0
			owner.bearSurface = 0
	if owner.bearSwipeCooldown <= 0 and not target.out and not isIntangible(target) and (target.x - owner.bearX).abs() <= 70 and (target.z - owner.bearZ).abs() <= 100
		owner.bearSwipeCooldown = RIFLEMAN_BEAR_SWIPE_INTERVAL
		owner.bearHitSerial++
		applyAttackHit(owner, target, 0, owner.bearVelocityX < 0 ? -1 : 1,
			hitEffect(6, 90, 18, DIAGONAL_UNIT, 0.35), false)
	if owner.bearLife <= 0 or owner.bearX < surfaceLeft(stage, 0) - 100 or owner.bearX > surfaceRight(stage, 0) + 100
		owner.bearLife = 0

function advanceHippogryph(FighterState owner, FighterState target)
	if owner.hippogryphLife <= 0
		return
	owner.hippogryphLife--
	if owner.hippogryphKind == 2
		owner.hippogryphX = owner.x
		owner.hippogryphZ = owner.z + 30
	else
		let oldX = owner.hippogryphX
		owner.hippogryphX += owner.hippogryphVelocityX
		owner.hippogryphZ += owner.hippogryphVelocityZ
		if owner.hippogryphKind == 1 and not owner.specialHit and not target.out and not isIntangible(target)
			let crossedTarget = (target.x - oldX) * owner.facing >= 0 and (target.x - owner.hippogryphX) * owner.facing <= 0
			if (crossedTarget or (target.x - owner.hippogryphX).abs() <= 60) and (target.z - owner.hippogryphZ).abs() <= 100
				owner.specialHit = true
				applyAttackHit(owner, target, 0, owner.facing,
					hitEffect(8, 100, 22, DIAGONAL_UNIT, DIAGONAL_UNIT), false)
	if owner.hippogryphLife <= 0
		owner.hippogryphKind = 0
		if owner.specialAction == SPECIAL_ARCHER_DISENGAGE
			owner.specialHit = false

public function advanceSpecialPair(FighterState first, FighterState second, int stage)
	advanceSpecialAction(first)
	advanceSpecialAction(second)
	resolveDemonHunterSpecialContact(first, second)
	resolveDemonHunterSpecialContact(second, first)
	advanceBear(first, second, stage)
	advanceBear(second, first, stage)
	advanceHippogryph(first, second)
	advanceHippogryph(second, first)

function resolveDemonHunterSpecialContact(FighterState owner, FighterState target)
	if owner.character != 2 or owner.specialAction != SPECIAL_DEMONHUNTER_IMMOLATE
		return
	if owner.specialHit or owner.specialFrame < DEMONHUNTER_IMMOLATE_STARTUP
		return
	if owner.specialFrame >= DEMONHUNTER_IMMOLATE_STARTUP + DEMONHUNTER_IMMOLATE_ACTIVE or target.out or isIntangible(target)
		return
	let localX = (target.x - owner.x) * owner.facing
	let localZ = target.z - owner.z
	let groundedShine = owner.grounded
	let overlaps = groundedShine
		? localX >= 0 and localX <= 140 and localZ >= -80 and localZ <= 100
		: localX >= -70 and localX <= 70 and localZ >= -170 and localZ <= 30
	if not overlaps
		return
	owner.specialHit = true
	if groundedShine
		applyAttackHit(owner, target, 0, owner.facing, hitEffect(7, 105, 21, 1, 0), true)
	else
		applyAttackHit(owner, target, 0, owner.facing, hitEffect(9, 110, 26, 0.12, -0.993), true)

public function simulationJump(FighterState f)
	if inGrabContext(f)
		return
	if f.ledgeState != LEDGE_NONE
		return
	if f.out or f.specialFall or f.shieldBreakState != SHIELD_BREAK_NONE or (f.downState != DOWN_NONE and not isTumbling(f)) or f.hitlag > 0 or f.hitstun > 0 or f.shieldStun > 0 or (f.shieldReleaseLag > 0 and not f.grounded) or f.landingLag > 0 or f.airDodging or isGroundDodging(f) or f.cooldown > 0 or f.jumpSquat > 0 or f.jumps <= 0
		return
	if f.grounded
		clearDash(f)
		f.shield = false
		f.shieldHeldFrames = 0
		f.shieldReleaseLag = 0
		f.jumpSquat = jumpSquatFrames(f.character)
		f.jumpHeld = true
	else
		f.vz = doubleJumpSpeed(f.character)
		f.jumpSerial++
		f.jumpIsDouble = true
		clearDownState(f)
	f.jumps--

public function simulationAirDodge(FighterState f, int horizontal, int vertical)
	if inGrabContext(f)
		return
	if f.ledgeState != LEDGE_NONE
		return
	if f.out or f.specialFall or f.shieldBreakState != SHIELD_BREAK_NONE or (f.downState != DOWN_NONE and not isTumbling(f)) or f.grounded or f.hitlag > 0 or f.hitstun > 0 or f.shieldStun > 0 or f.landingLag > 0 or f.cooldown > 0 or f.airDodging or f.airDodgeTime > 0
		return
	let dx = horizontal == 0 ? 0 : (horizontal > 0 ? 1 : -1)
	let dz = vertical == 0 ? 0 : (vertical > 0 ? 1 : -1)
	let scale = dx != 0 and dz != 0 ? DIAGONAL_UNIT : 1
	f.vx = dx * AIR_DODGE_SPEED * scale
	f.vz = dz * AIR_DODGE_SPEED * scale
	if dx != 0 and dz == 0
		// Horizontal digital dodges angle down; explicit vertical input stays directional.
		f.vx = dx * AIR_DODGE_SPEED * Cos(18 * bj_DEGTORAD)
		f.vz = -AIR_DODGE_SPEED * Sin(18 * bj_DEGTORAD)
	f.knockbackX = 0
	f.knockbackZ = 0
	f.airDodgeTime = AIR_DODGE_FRAMES
	f.airDodging = true
	f.airDodgeFrame = 0
	f.grounded = false
	f.jumps = max(0, f.jumps - 1)
	clearDownState(f)

function canBeginGroundDodge(FighterState f) returns boolean
	if inGrabContext(f)
		return false
	return not f.out and f.downState == DOWN_NONE and f.grounded and f.hitlag <= 0 and f.hitstun <= 0 and f.shieldStun <= 0 and f.shieldReleaseLag <= 0 and f.landingLag <= 0 and f.cooldown <= 0 and f.jumpSquat <= 0 and f.grabbedFrames <= 0 and not f.airDodging and not isGroundDodging(f) and f.shieldEnergy > 0

public function beginAttackPair(FighterState first, FighterState second, int firstStyle, int secondStyle, boolean firstMayCharge, boolean secondMayCharge)
	let firstAction = first.character == 2 and firstStyle == 0 and first.grounded and first.dashFrame > 0 ? DEMONHUNTER_DASH_ATTACK_STYLE : firstStyle
	let secondAction = second.character == 2 and secondStyle == 0 and second.grounded and second.dashFrame > 0 ? DEMONHUNTER_DASH_ATTACK_STYLE : secondStyle
	let firstGroundAttack = firstAction >= 0 and firstAction <= 10 and firstAction != 1 or firstAction == DEMONHUNTER_DASH_ATTACK_STYLE
	let secondGroundAttack = secondAction >= 0 and secondAction <= 10 and secondAction != 1 or secondAction == DEMONHUNTER_DASH_ATTACK_STYLE
	let firstAerial = isAerialAttack(firstAction)
	let secondAerial = isAerialAttack(secondAction)
	let firstEligible = (firstGroundAttack and first.grounded or firstAction == 1 or firstAerial and not first.grounded) and canStartAttackStyle(first, firstAction) and not second.out
	let secondEligible = (secondGroundAttack and second.grounded or secondAction == 1 or secondAerial and not second.grounded) and canStartAttackStyle(second, secondAction) and not first.out
	if firstEligible
		beginAttack(first, firstAction, firstMayCharge)
	if secondEligible
		beginAttack(second, secondAction, secondMayCharge)

public function resolveAttackPair(FighterState first, FighterState second)
	let firstStyle = first.attackStyle
	let secondStyle = second.attackStyle
	let firstRegion = selectHitRegion(first, second)
	let secondRegion = selectHitRegion(second, first)
	let firstShot = firstStyle == 1 and attackPhase(first) == ATTACK_ACTIVE and not first.attackHit
	let secondShot = secondStyle == 1 and attackPhase(second) == ATTACK_ACTIVE and not second.attackHit
	let firstHits = firstShot or firstRegion.window > 0
	let secondHits = secondShot or secondRegion.window > 0
	let firstFacing = first.facing
	let secondFacing = second.facing
	let firstGrabPriority = firstHits and firstStyle == 5 and secondStyle != 5
	let secondGrabPriority = secondHits and secondStyle == 5 and firstStyle != 5
	if firstHits and secondHits and firstStyle == 5 and secondStyle == 5
		recordHitRegion(first, second, firstRegion)
		recordHitRegion(second, first, secondRegion)
		return
	if firstShot
		first.attackHit = true
	if secondShot
		second.attackHit = true
	if firstRegion.window > 0 and not secondGrabPriority
		recordHitRegion(first, second, firstRegion)
	if secondRegion.window > 0 and not firstGrabPriority
		recordHitRegion(second, first, secondRegion)
	if firstHits and not secondGrabPriority
		if firstStyle == 1
			spawnProjectile(first)
		else
			applyAttackHit(first, second, firstStyle, firstFacing, firstRegion.hitData, true)
	if secondHits and not firstGrabPriority
		if secondStyle == 1
			spawnProjectile(second)
		else
			applyAttackHit(second, first, secondStyle, secondFacing, secondRegion.hitData, true)

public function reset(FighterState f, real startX)
	f.jumpDodgeQueued = false
	f.jumpDodgeX = 0
	f.jumpDodgeZ = 0
	clearGrabLinks(f)
	clearSpecialOnStock(f)
	f.lastAerialTapDirection = 0
	f.lastHitAttacker = null
	f.lastHitAttackSerial = -1
	f.lastHitWindow = 0
	clearDash(f)
	clearLedge(f)
	f.ledgeSerial = 0
	f.ledgeRegrab = 0
	clearShieldBreak(f)
	f.shieldBreakSerial = 0
	clearOwnedFreezeTrap(f)
	f.freezeTrapSerial = 0
	f.frozenFrames = 0
	f.freezeTrapCooldown = 0
	clearDownState(f)
	f.lCancelWindow = 0
	f.lCancelSerial = 0
	f.techWindow = 0
	f.techLockout = 0
	f.techHitlagLatched = false
	f.jumpSerial = 0
	f.jumpIsDouble = false
	f.x = startX
	f.z = 280
	f.vx = 0
	f.vz = 0
	f.knockbackX = 0
	f.knockbackZ = 0
	f.damage = 0
	f.hitstun = 0
	f.hitlag = 0
	f.diPending = false
	f.diLaunchSpeed = 0
	f.diSerial = 0
	f.diAngleDegrees = 0
	f.sdiWasGrounded = false
	f.sdiLaunchesUpward = false
	f.sdiSerial = 0
	f.asdiSerial = 0
	f.shieldStun = 0
	f.attackStyle = -1
	f.attackFrame = 0
	f.attackDuration = 0
	f.attackHit = false
	f.smashCharging = false
	f.smashChargeFrames = 0
	f.smashChargeAllowed = false
	f.cooldown = 0
	f.specialDirection = 0
	f.shield = false
	f.shieldEnergy = SHIELD_MAX
	f.jumpSquat = 0
	f.jumpHeld = false
	f.out = false
	f.grounded = false
	f.jumps = 2
	f.dropTime = 0
	f.airDodgeTime = 0
	f.landingLag = 0
	f.airDodging = false
	f.airDodgeFrame = 0
	f.groundDodgeFrame = 0
	f.groundDodgeDirection = 0
	f.grabbedFrames = 0
	f.shieldHeldFrames = 0
	f.grabSerial = 0
	f.shieldReleaseLag = 0
	f.shieldStun = 0
	f.invincible = 90

public function advance(FighterState f, int stage, InputSnapshot input, real respawnX)
	if f.out
		if f.stocks <= 0
			return
		f.respawn--
		if f.respawn <= 0
			reset(f, respawnX)
		return
	let wasFrozen = f.frozenFrames > 0
	if f.frozenFrames > 0
		f.frozenFrames--
	if f.freezeTrapCooldown > 0
		f.freezeTrapCooldown--
	if f.freezeTrapLife > 0
		f.freezeTrapLife--
		if f.freezeTrapArming > 0
			f.freezeTrapArming--
		if f.freezeTrapLife == 0
			clearOwnedFreezeTrap(f)
	if wasFrozen
		checkBlastZone(f)
		return
	if f.hitlag <= 0
		f.ledgeRegrab = max(0, f.ledgeRegrab - 1)
	if f.ledgeState != LEDGE_NONE
		advanceLedge(f, stage, input)
		return
	if f.shieldBreakState != SHIELD_BREAK_NONE
		advanceShieldBreak(f, stage, input)
		return
	// Counts include the current contact tick. A hitlag edge starts counting after the freeze.
	if f.hitlag <= 0
		f.lCancelWindow = max(0, f.lCancelWindow - 1)
	if input.lCancelPressed
		f.lCancelWindow = L_CANCEL_WINDOW_FRAMES
	if f.hitlag <= 0
		if not f.techHitlagLatched
			f.techWindow = max(0, f.techWindow - 1)
			f.techLockout = max(0, f.techLockout - 1)
		f.techHitlagLatched = false
		if isFloorTeching(f) and f.downFrame >= (f.downState == DOWN_TECH ? TECH_IN_PLACE_FRAMES : TECH_ROLL_FRAMES)
			clearDownState(f)
	if input.techPressed
		f.techWindow = f.techLockout == 0 ? (f.hitlag > 1 ? 1 : TECH_WINDOW_FRAMES) : 0
		f.techLockout = TECH_LOCKOUT_FRAMES
		if f.hitlag > 0
			f.techHitlagLatched = true
	if inGrabContext(f)
		if f.hitlag <= 0
			f.invincible = max(0, f.invincible - 1)
		f.hitlag = max(0, f.hitlag - 1)
		checkBlastZone(f)
		return
	var groundDodgeStarted = false
	var smashChargePaused = false
	if f.hitlag <= 0
		f.landingLag = max(0, f.landingLag - 1)
		if f.smashCharging
			if f.grounded and input.attackHeld and f.smashChargeFrames < SMASH_MAX_CHARGE_FRAMES
				f.smashChargeFrames++
				smashChargePaused = true
			else
				f.smashCharging = false
				f.smashChargeAllowed = false
		else if f.grounded and f.attackStyle >= 0 and f.smashChargeAllowed and isSmashAttack(f.attackStyle) and input.attackHeld and f.attackFrame >= attackStartupFrames(f.attackStyle) - 1
			f.smashCharging = true
			f.smashChargeFrames = 1
			smashChargePaused = true
		if not smashChargePaused
			f.cooldown = max(0, f.cooldown - 1)
			if f.specialLockFrames > 0
				f.specialLockFrames--
			for i = 1 to SPECIAL_ACTION_CAPACITY - 1
				f.specialCooldowns[i] = max(0, f.specialCooldowns[i] - 1)
			if f.attackStyle >= 0
				f.attackFrame++
				if f.attackFrame >= f.attackDuration
					f.attackStyle = -1
					f.attackFrame = 0
					f.attackHit = false
					f.smashCharging = false
					f.smashChargeFrames = 0
					f.smashChargeAllowed = false
	if f.grabTarget != null
		checkBlastZone(f)
		return
	if f.hitlag <= 0
		f.hitstun = max(0, f.hitstun - 1)
	if input.jumpPressed
		simulationJump(f)
	if f.jumpSquat > 0
		f.jumpHeld = f.jumpHeld and input.jumpHeld
	if input.airDodgePressed
		if f.grounded and f.jumpSquat > 0
			f.jumpDodgeQueued = true
			f.jumpDodgeX = input.dodgeX
			f.jumpDodgeZ = input.dodgeZ
		else
			simulationAirDodge(f, input.dodgeX, input.dodgeZ)
	if f.jumpDodgeQueued and (input.direction != 0 or input.verticalDirection != 0)
		f.jumpDodgeX = input.direction
		f.jumpDodgeZ = input.verticalDirection
	if input.groundDodgePressed and input.shield and not input.jumpPressed and canBeginGroundDodge(f)
		beginGroundDodge(f, input.groundDodgeDirection)
		groundDodgeStarted = true
	if f.jumpSquat > 0 and f.hitlag == 0
		f.jumpSquat--
		if f.jumpSquat == 0
			f.grounded = false
			f.vz = f.jumpHeld ? fullJumpSpeed(f.character) : shortJumpSpeed(f.character)
			f.jumpSerial++
			f.jumpIsDouble = false
			if f.jumpDodgeQueued
				f.jumpDodgeQueued = false
				simulationAirDodge(f, f.jumpDodgeX, f.jumpDodgeZ)
				f.jumpDodgeX = 0
				f.jumpDodgeZ = 0
	if f.hitlag > 0
		if f.hitlag > 1 and f.diPending
			applySmashDirectionalInfluence(f, stage, input)
		if f.hitlag == 1 and f.diPending and not f.out
			applyDirectionalInfluence(f, input)
			applyAutomaticSmashDirectionalInfluence(f, stage, input)
		f.hitlag--
		return
	if f.groundDodgeFrame > 0 and not groundDodgeStarted
		f.groundDodgeFrame++
		let dodgeFrames = f.groundDodgeDirection == 0 ? SPOT_DODGE_FRAMES : GROUND_ROLL_FRAMES
		if f.groundDodgeFrame > dodgeFrames
			if f.groundDodgeDirection == f.facing
				f.facing = -f.facing
			f.groundDodgeFrame = 0
			f.groundDodgeDirection = 0
			f.vx = 0
	checkBlastZone(f)
	if f.out
		return
	if advanceDownState(f, stage, input)
		return
	let forcedShield = f.shield and f.shieldStun > 0
	f.shieldStun = max(0, f.shieldStun - 1)
	f.invincible = max(0, f.invincible - 1)
	if f.airDodging
		f.airDodgeFrame = min(AIR_DODGE_ANIMATION_FRAMES, f.airDodgeFrame + 1)
	f.dropTime = max(0, f.dropTime - 1)
	let dodgeActive = f.airDodgeTime > 0
	f.airDodgeTime = max(0, f.airDodgeTime - 1)
	f.shieldReleaseLag = max(0, f.shieldReleaseLag - 1)
	let shieldCanStart = input.shield and f.shieldEnergy > 0 and f.downState == DOWN_NONE and f.hitstun <= 0 and f.grounded and not isGroundDodging(f)
		and f.shieldStun <= 0 and f.landingLag <= 0 and f.shieldReleaseLag <= 0 and f.cooldown <= 0 and f.jumpSquat <= 0
	var wantsShield = forcedShield
	if not forcedShield
		if f.shield and not input.shield and f.shieldEnergy > 0 and f.shieldHeldFrames < SHIELD_MIN_HOLD_FRAMES
			wantsShield = true
			f.shieldHeldFrames++
		else
			wantsShield = shieldCanStart
			if wantsShield
				f.shieldHeldFrames++
			else if f.shield and not input.shield and f.shieldEnergy > 0
				f.shieldReleaseLag = SHIELD_RELEASE_LAG_FRAMES
				f.shieldHeldFrames = 0
	f.shield = wantsShield
	if wantsShield
		if not forcedShield
			f.shieldEnergy = max(0, f.shieldEnergy - SHIELD_DRAIN_PER_FRAME)
	else
		f.shieldEnergy = min(SHIELD_MAX, f.shieldEnergy + SHIELD_REGEN_PER_FRAME)
	if wantsShield and f.shieldEnergy == 0
		beginShieldBreak(f)
		return
	var direction = input.direction
	let canSteer = f.downState == DOWN_NONE and f.hitstun <= 0 and not f.airDodging and not isGroundDodging(f) and f.shieldReleaseLag <= 0 and f.landingLag <= 0 and f.shieldStun <= 0 and f.jumpSquat <= 0 and not smashChargePaused and (not f.grounded or f.cooldown <= 0)
	if canSteer and not f.grounded and direction != 0
		f.lastAerialTapDirection = direction
	if not canSteer or wantsShield or not f.grounded
		clearDash(f)
	if canSteer
		if wantsShield
			direction = 0
		if f.grounded
			advanceGroundMovement(f, direction, input.walking)
		else if direction != 0
			f.vx = f.vx + direction * characterAirAcceleration(f.character)
			f.vx = max(-characterAirSpeed(f.character), min(characterAirSpeed(f.character), f.vx))
			// Air steering changes velocity, not facing; back aerials rely on a stable orientation.
	if isGroundDodging(f) and f.groundDodgeDirection != 0 and f.groundDodgeFrame >= GROUND_ROLL_MOVE_START and f.groundDodgeFrame <= GROUND_ROLL_MOVE_END
		f.vx = GROUND_ROLL_SPEED * f.groundDodgeDirection
	else if isGroundDodging(f)
		f.vx = 0
	else if (not canSteer or direction == 0) and f.hitstun <= 0 and (not dodgeActive or f.grounded)
		let drag = f.grounded ? GROUND_TRACTION : AIR_FRICTION
		f.vx = f.vx > 0 ? max(0, f.vx - drag) : min(0, f.vx + drag)
	if input.down and not input.attackRequested and f.downState == DOWN_NONE and f.grounded and f.surface >= 0 and surfacePass(stage, f.surface) and canAttack(f)
		f.dropTime = 12
		f.jumps = min(f.jumps, 1)
		f.grounded = false
		f.vz = -2
	let oldX = f.x
	let oldZ = f.z
	if dodgeActive and not f.grounded
		f.vx = f.vx * 0.9
		f.vz = f.vz * 0.9
	if isGroundDodging(f) and f.groundDodgeDirection != 0
		let proposedX = f.x + totalVelocityX(f)
		f.x = max(surfaceLeft(stage, max(0, f.surface)), min(surfaceRight(stage, max(0, f.surface)), proposedX))
		if (f.groundDodgeDirection < 0 and f.x == surfaceLeft(stage, max(0, f.surface))) or (f.groundDodgeDirection > 0 and f.x == surfaceRight(stage, max(0, f.surface)))
			f.vx = 0
			f.knockbackX = 0
	else
		f.x += totalVelocityX(f)
	if isGroundDodging(f)
		f.vz = 0
		f.z = surfaceZ(stage, max(0, f.surface))
	else if f.grounded and f.jumpSquat > 0
		f.vz = 0
		f.z = surfaceZ(stage, max(0, f.surface))
	else if not dodgeActive or f.grounded
		let gravity = characterGravity(f.character)
		f.vz = max(-characterTerminalSpeed(f.character), f.vz - gravity)
		if input.down and input.direction == 0 and f.downState == DOWN_NONE and f.hitstun <= 0 and totalVelocityZ(f) < 0
			f.vz = -characterFastFallSpeed(f.character)
	f.z += totalVelocityZ(f)
	var landing = -1
	if totalVelocityZ(f) <= 0
		for i = 0 to surfaceCount(stage) - 1
			let platformZ = surfaceZ(stage, i)
			if oldZ >= platformZ and f.z <= platformZ and not (surfacePass(stage, i) and f.dropTime > 0)
				let fraction = oldZ == f.z ? 1 : (oldZ - platformZ) / (oldZ - f.z)
				let crossingX = oldX + (f.x - oldX) * fraction
				if crossingX >= surfaceLeft(stage, i) and crossingX <= surfaceRight(stage, i) and f.x >= surfaceLeft(stage, i) and f.x <= surfaceRight(stage, i)
					if landing < 0 or platformZ > surfaceZ(stage, landing)
						landing = i
	if landing >= 0
		finishLanding(f, stage, input, landing, false)
	else
		if f.grounded
			f.jumps = min(f.jumps, 1)
		f.grounded = false
		f.surface = -1
		clearDash(f)
	decayKnockback(f)
	checkBlastZone(f)

function checkBlastZone(FighterState f)
	if f.x <= -920 or f.x >= 920 or f.z <= -420 or f.z >= 760
		clearGrabLinks(f)
		clearDash(f)
		f.out = true
		clearLedge(f)
		f.ledgeRegrab = 0
		clearShieldBreak(f)
		clearSpecialOnStock(f)
		clearOwnedFreezeTrap(f)
		f.frozenFrames = 0
		f.diPending = false
		f.diLaunchSpeed = 0
		f.vx = 0
		f.vz = 0
		f.knockbackX = 0
		f.knockbackZ = 0
		f.lCancelWindow = 0
		f.techWindow = 0
		f.techLockout = 0
		f.techHitlagLatched = false
		f.stocks = max(0, f.stocks - 1)
		f.respawn = f.stocks > 0 ? 60 : 0
		f.attackStyle = -1
		f.attackFrame = 0
		f.attackHit = false
		f.smashCharging = false
		f.smashChargeFrames = 0
		f.smashChargeAllowed = false
		f.cooldown = 0
		f.groundDodgeFrame = 0
		f.groundDodgeDirection = 0
		clearDownState(f)
		return
