package NetworkInputTests
import NetworkInput
import KeyBindings

@Test function normalizedInputUsesExistingActionIdsAndRetainsTapEdges()
    let row = new NetworkInput()
    inputActionBit(MOVE_LEFT).assertEquals(1)
    inputActionBit(ATTACK).assertEquals(32)
    inputActionBit(WALK_MODIFIER).assertEquals(16384)
    inputActionBit(-1).assertEquals(0)
    inputActionBit(ACTION_COUNT).assertEquals(0)
    row.assign(inputActionBit(MOVE_LEFT) + inputActionBit(WALK_MODIFIER), inputActionBit(ATTACK), inputActionBit(ATTACK), -127, 127, 0, 255).assertTrue()
    row.actionHeld(MOVE_LEFT).assertTrue()
    row.actionHeld(MOVE_RIGHT).assertFalse()
    row.actionHeld(WALK_MODIFIER).assertTrue()
    row.actionHeld(ATTACK).assertFalse()
    row.actionPressed(ATTACK).assertTrue()
    row.actionReleased(ATTACK).assertTrue()
    row.actionHeld(-1).assertFalse()
    row.actionPressed(ACTION_COUNT).assertFalse()
    row.actionReleased(2147483647).assertFalse()

@Test function normalizedInputRejectsInvalidValuesWithoutMutation()
    let row = new NetworkInput()
    let before = new NetworkInput()
    row.assign(32767, 32767, 32767, -127, 127, 255, 255).assertTrue()
    row.copyTo(before)
    row.assign(32768, 0, 0, 0, 0, 0, 0).assertFalse()
    row.assign(0, -1, 0, 0, 0, 0, 0).assertFalse()
    row.assign(0, 0, 32768, 0, 0, 0, 0).assertFalse()
    row.assign(0, 0, 0, -128, 0, 0, 0).assertFalse()
    row.assign(0, 0, 0, 0, 128, 0, 0).assertFalse()
    row.assign(0, 0, 0, 0, 0, -1, 0).assertFalse()
    row.assign(0, 0, 0, 0, 0, 0, 256).assertFalse()
    row.sameAs(before).assertTrue()

@Test function conservativePredictionCopiesHoldsAndAxesWithoutRepeatingEdges()
    let source = new NetworkInput()
    let predicted = new NetworkInput()
    source.assign(32, 32, 16, 93, -71, 124, 255).assertTrue()
    source.predictTo(predicted)
    predicted.heldMask().assertEquals(32)
    predicted.axisX().assertEquals(93)
    predicted.axisZ().assertEquals(-71)
    predicted.triggerLeft().assertEquals(124)
    predicted.triggerRight().assertEquals(255)
    predicted.pressedMask().assertEquals(0)
    predicted.releasedMask().assertEquals(0)
    source.pressedMask().assertEquals(32)
    source.releasedMask().assertEquals(16)
    predicted.predictTo(predicted)
    predicted.pressedMask().assertEquals(0)
    predicted.releasedMask().assertEquals(0)
    source.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    predicted.heldMask().assertEquals(32)
