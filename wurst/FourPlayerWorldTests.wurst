package FourPlayerWorldTests
import Simulation
import MatchStep
import MatchRules
import ReplayState
import ReplayHistory
import ShadowInputSchedule
import ShadowInputPlayback
import ParticipantInputs
import NetworkInput
import InputProtocol
import InputLedger
import KeyBindings

function fourWorld(int mask) returns FighterRoster
    let world = new FighterRoster(mask)
    for slot = 0 to 3
        world.fighters[slot] = new FighterState(0, -300. + slot * 200, slot mod 2 == 0 ? 1 : -1)
        world.fighters[slot].surface = 0
    return world

@Test function sparseWorldAdvancesEachActiveFighterAndClockOnce()
    let world = fourWorld(13)
    let controls = new FrameInputs()
    let game = new MatchState()
    game.phase = MATCH
    for slot = 0 to 3
        world.fighters[slot].hitlag = 3
    let clock = game.remainingFrames
    stepMatch(game, world, controls, 1)
    world.fighters[0].hitlag.assertEquals(2)
    world.fighters[1].hitlag.assertEquals(3)
    world.fighters[2].hitlag.assertEquals(2)
    world.fighters[3].hitlag.assertEquals(2)
    game.remainingFrames.assertEquals(clock - 1)
    world.fighters[2].stocks = 0
    world.fighters[2].out = true
    game.resolveStocks(world)
    game.phase.assertEquals(MATCH)
    world.fighters[0].stocks = 0
    world.fighters[0].out = true
    game.resolveStocks(world)
    game.winner.assertEquals(3)
    game.phase.assertEquals(RESULT)

@Test function multipleAttackersKeepIndependentVictimHitWindows()
    let world = fourWorld(13)
    world.fighters[0].x = 0
    world.fighters[2].x = 0
    world.fighters[3].x = 100
    for slot = 0 to 2
        if world.active(slot)
            beginFighterAttack(world, slot, 0, false)
            world.fighters[slot].attackFrame = attackStartupFrames(0)
    resolveAttacks(world)
    world.fighters[3].damage.assertEquals(24.)
    world.fighters[0].hitlag = 0
    world.fighters[2].hitlag = 0
    resolveAttacks(world)
    world.fighters[3].damage.assertEquals(24.)

@Test function oneMeleeSwingCanContactAllThreeOpponents()
    let world = fourWorld(15)
    world.fighters[0].x = 0
    for slot = 1 to 3
        world.fighters[slot].x = 80. + slot * 5
    beginFighterAttack(world, 0, 0, false)
    world.fighters[0].attackFrame = attackStartupFrames(0)
    resolveAttacks(world)
    for slot = 1 to 3
        world.fighters[slot].damage.assertEquals(12.)

@Test function projectileMovesOnceAndHitsNearestOpponent()
    let world = fourWorld(15)
    let owner = world.fighters[0]
    owner.projectileLife[0] = 10
    owner.projectileX[0] = 0
    owner.projectileZ[0] = 45
    owner.projectileVelocityX[0] = 100
    owner.projectileDirection[0] = 1
    world.fighters[1].x = 70
    world.fighters[2].x = 25
    world.fighters[3].x = 90
    updateProjectiles(world)
    owner.projectileX[0].assertEquals(100.)
    owner.projectileLife[0].assertEquals(0)
    world.fighters[1].damage.assertEquals(0.)
    world.fighters[2].damage.assertEquals(3.)
    world.fighters[3].damage.assertEquals(0.)
    owner.projectileLife[1] = 10
    owner.projectileX[1] = -400
    owner.projectileZ[1] = 45
    owner.projectileVelocityX[1] = 10
    updateProjectiles(world)
    owner.projectileLife[1].assertEquals(9)
    owner.projectileX[1].assertEquals(-390.)

@Test function summonAndSpecialClocksAdvanceOnceWithFourOpponents()
    let world = fourWorld(15)
    let owner = world.fighters[3]
    owner.character = 1
    owner.bearLife = 30
    owner.bearX = 0
    owner.bearVelocityX = 14
    owner.bearSurface = 0
    owner.bearSwipeCooldown = 10
    owner.hippogryphLife = 20
    owner.hippogryphKind = 2
    owner.specialAction = SPECIAL_RIFLEMAN_BEAR
    owner.specialDuration = 18
    advanceSpecials(world, 0)
    owner.bearLife.assertEquals(29)
    owner.bearX.assertEquals(14.)
    owner.bearSwipeCooldown.assertEquals(9)
    owner.hippogryphLife.assertEquals(19)
    owner.specialFrame.assertEquals(1)

@Test function grabHitlagPausesOnlyItsLinkedFighters()
    let world = fourWorld(15)
    let controls = new FrameInputs()
    let game = new MatchState()
    game.phase = MATCH
    for ownerSlot = 0 to 1
        let owner = world.fighters[ownerSlot]
        let target = world.fighters[ownerSlot + 2]
        owner.grabTarget = target
        owner.grabAction = GRAB_HOLD
        target.grabOwner = owner
        target.grabbedFrames = 60
    world.fighters[2].hitlag = 2
    stepMatch(game, world, controls, 1)
    world.fighters[2].grabbedFrames.assertEquals(60)
    world.fighters[3].grabbedFrames.assertEquals(59)
    world.fighters[2].hitlag.assertEquals(1)
    stepMatch(game, world, controls, 2)
    world.fighters[2].grabbedFrames.assertEquals(59)
    world.fighters[3].grabbedFrames.assertEquals(58)
    world.fighters[2].hitlag.assertEquals(0)

@Test function competingGrabsChooseOneVictimAndThirdPartyHitBreaksLinks()
    let world = fourWorld(15)
    world.fighters[0].x = 0
    world.fighters[1].x = 25
    world.fighters[2].x = 35
    world.fighters[3].x = -400
    beginFighterAttack(world, 0, 5, false)
    world.fighters[0].attackFrame = attackStartupFrames(5)
    resolveAttacks(world)
    (world.fighters[0].grabTarget == world.fighters[1]).assertTrue()
    (world.fighters[1].grabOwner == world.fighters[0]).assertTrue()
    (world.fighters[2].grabOwner == null).assertTrue()
    world.fighters[3].x = -100
    world.fighters[3].facing = 1
    beginFighterAttack(world, 3, 0, false)
    world.fighters[3].attackFrame = attackStartupFrames(0)
    resolveAttacks(world)
    (world.fighters[0].grabTarget == null).assertTrue()
    (world.fighters[1].grabOwner == null).assertTrue()

@Test function fourSlotSnapshotRemapsEveryCrossFighterReference()
    let original = fourWorld(15)
    let restored = fourWorld(15)
    let controls = new FrameInputs()
    let restoredControls = new FrameInputs()
    let game = new MatchState()
    let runtime = new ReplayRuntimeState()
    let restoredRuntime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()
    let witness = new ReplaySnapshot()
    for slot = 0 to 3
        let fighter = original.fighters[slot]
        fighter.grabOwner = original.fighters[(slot + 1) mod 4]
        fighter.grabTarget = original.fighters[(slot + 3) mod 4]
        fighter.lastHitAttacker = original.fighters[(slot + 2) mod 4]
        fighter.damage = slot * 17.5
        for other = 0 to 3
            fighter.hitAttackers[other] = original.fighters[other]
            fighter.hitSerials[other] = 10 + other
            fighter.hitWindows[other] = other + 1
            fighter.specialHitTargets[other] = original.fighters[other]
        controls.commands[slot].enqueue(0, 1, 3, false)
        runtime.poses[slot].advance(fighter, controls.inputs[slot], false, false, false, false)
    snapshot.capture(original, game, controls, runtime)
    snapshot.restore(restored, game, restoredControls, restoredRuntime)
    for slot = 0 to 3
        let fighter = restored.fighters[slot]
        (fighter.grabOwner == restored.fighters[(slot + 1) mod 4]).assertTrue()
        (fighter.grabTarget == restored.fighters[(slot + 3) mod 4]).assertTrue()
        (fighter.lastHitAttacker == restored.fighters[(slot + 2) mod 4]).assertTrue()
        for other = 0 to 3
            (fighter.hitAttackers[other] == restored.fighters[other]).assertTrue()
            (fighter.specialHitTargets[other] == restored.fighters[other]).assertTrue()
    witness.capture(restored, game, restoredControls, restoredRuntime)
    snapshot.firstDifference(witness).assertEquals("")
    snapshot.firstPoseDifference(witness).assertEquals("")
    snapshot.checksum().assertEquals(witness.checksum())
    original.fighters[3].damage = 999
    snapshot.restore(restored, game, restoredControls, restoredRuntime)
    restored.fighters[3].damage.assertEquals(52.5)

@Test function timeoutRanksEveryActiveSlotAndKeepsTiedWinnerUnresolved()
    let world = fourWorld(13)
    let game = new MatchState()
    game.phase = MATCH
    game.remainingFrames = 1
    world.fighters[0].stocks = 2
    world.fighters[2].stocks = 3
    world.fighters[3].stocks = 3
    world.fighters[2].damage = 80
    world.fighters[3].damage = 20
    game.advanceClock(world)
    game.winner.assertEquals(3)
    game.phase = MATCH
    game.remainingFrames = 1
    world.fighters[2].damage = 20
    game.advanceClock(world)
    game.winner.assertEquals(-1)

function fourRow(int slot, int frame, NetworkInput row)
    var held = 0
    var pressed = 0
    var released = 0
    if slot == 0 and frame == 1
        pressed = inputActionBit(ATTACK)
    if slot == 1
        if frame <= 3
            held = inputActionBit(LEFT_TRIGGER)
        if frame == 1
            pressed = inputActionBit(LEFT_TRIGGER)
        if frame == 4
            released = inputActionBit(LEFT_TRIGGER)
    if slot == 2 and frame == 2
        pressed = inputActionBit(SPECIAL)
    if slot == 3
        held = inputActionBit(MOVE_LEFT)
    row.assign(held, pressed, released, slot == 3 ? -127 : 0, 0, 0, 0).assertTrue()
    row.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
    row.assignThrowContributions(0, 0).assertTrue()

@Test function delayedIndependentRemotesConvergeForFullAndSparseRosters()
    for sparse = 0 to 1
        let mask = sparse == 0 ? 15 : 13
        let epoch = 300 + sparse
        let schedule = new ShadowInputSchedule()
        let playback = new ShadowInputPlayback()
        let predicted = fourWorld(mask)
        let confirmed = fourWorld(mask)
        predicted.fighters[0].x = 0
        predicted.fighters[1].x = 100
        confirmed.fighters[0].x = 0
        confirmed.fighters[1].x = 100
        let game = new MatchState()
        let confirmedGame = new MatchState()
        game.setHumanMask(mask)
        confirmedGame.setHumanMask(mask)
        game.phase = MATCH
        confirmedGame.phase = MATCH
        let controls = new FrameInputs()
        let confirmedControls = new FrameInputs()
        let runtime = new ReplayRuntimeState()
        let confirmedRuntime = new ReplayRuntimeState()
        let history = new ReplayHistory()
        let confirmedHistory = new ReplayHistory()
        let sample = new NetworkInput()
        let packet = new InputPacket()
        schedule.beginEpoch(epoch, 0, 8, mask).assertTrue()
        playback.beginEpoch(epoch).assertTrue()
        history.beginEpochWithCorrections(epoch, 1, 8).assertTrue()
        confirmedHistory.beginEpoch(epoch, 1).assertTrue()
        for frame = 1 to 6
            fourRow(3, frame, sample)
            schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
            playback.advanceSpeculative(schedule, epoch, 3, game, predicted, controls, runtime, history).assertTrue()
        // Each remote arrives independently; one sender cannot confirm another.
        for slot = 0 to 3
            if predicted.active(slot)
                for frame = 1 to 6
                    fourRow(slot, frame, sample)
                    packet.assign(epoch, frame, 1, sample, sample).assertTrue()
                    schedule.acceptSynchronized(slot, packet).assertEquals(INPUT_ACCEPTED)
                (playback.reconcile(schedule, epoch, 3, predicted, game, controls, runtime, history) >= 0).assertTrue()
                if slot < 3
                    history.isSpeculative(epoch, 1).assertTrue()
        for frame = 1 to 6
            playback.advanceConfirmed(schedule, epoch, confirmedGame, confirmed, confirmedControls, confirmedRuntime, confirmedHistory).assertTrue()
        let expected = new ReplaySnapshot()
        let actual = new ReplaySnapshot()
        expected.capture(confirmed, confirmedGame, confirmedControls, confirmedRuntime)
        actual.capture(predicted, game, controls, runtime)
        expected.firstDifference(actual).assertEquals("")
        expected.firstPoseDifference(actual).assertEquals("")
        history.isSpeculative(epoch, 6).assertFalse()
        expected.checksum().assertEquals(actual.checksum())

@Test function fourFightersArbitrateBothLedgesByDistance()
    let world = fourWorld(15)
    let controls = new FrameInputs()
    for slot = 0 to 3
        let fighter = world.fighters[slot]
        let side = slot < 2 ? -1 : 1
        fighter.x = side * (slot mod 2 == 0 ? 630. : 620.)
        fighter.z = -30
        fighter.vz = -2
        fighter.grounded = false
        fighter.facing = -side
    resolveLedges(world, 0, controls)
    world.fighters[0].ledgeState.assertEquals(LEDGE_NONE)
    world.fighters[1].ledgeState.assertEquals(LEDGE_HANG)
    world.fighters[2].ledgeState.assertEquals(LEDGE_NONE)
    world.fighters[3].ledgeState.assertEquals(LEDGE_HANG)

@Test function freezeTrapChoosesNearestEligibleFighterOnce()
    let world = fourWorld(15)
    let owner = world.fighters[3]
    owner.character = 1
    owner.x = 0
    startFreezeTrap(owner, 0).assertTrue()
    owner.freezeTrapArming = 0
    world.fighters[0].x = 30
    world.fighters[1].x = 10
    world.fighters[2].x = -20
    advanceFreezeTraps(world)
    owner.freezeTrapLife.assertEquals(0)
    world.fighters[0].frozenFrames.assertEquals(0)
    world.fighters[1].frozenFrames.assertEquals(FREEZE_TRAP_FREEZE_FRAMES)
    world.fighters[2].frozenFrames.assertEquals(0)

@Test function immolateContactsEachOpponentOnlyOnce()
    let world = fourWorld(15)
    let owner = world.fighters[0]
    owner.character = 2
    owner.x = 0
    owner.specialAction = SPECIAL_DEMONHUNTER_IMMOLATE
    owner.specialFrame = DEMONHUNTER_IMMOLATE_STARTUP - 1
    owner.specialDuration = DEMONHUNTER_IMMOLATE_DURATION
    for slot = 1 to 3
        world.fighters[slot].x = 50. + slot * 10
    advanceSpecials(world, 0)
    for slot = 1 to 3
        world.fighters[slot].damage.assertEquals(7.)
    owner.hitlag = 0
    advanceSpecials(world, 0)
    for slot = 1 to 3
        world.fighters[slot].damage.assertEquals(7.)

@Test function summonHitMemorySurvivesStartingAnUnrelatedSpecial()
    let world = fourWorld(15)
    let owner = world.fighters[0]
    owner.x = 0
    owner.hippogryphKind = 1
    owner.hippogryphLife = 18
    owner.hippogryphX = 0
    owner.hippogryphVelocityX = 0
    world.fighters[3].x = 30
    advanceSpecials(world, 0)
    world.fighters[3].damage.assertEquals(8.)
    let input = new InputSnapshot()
    input.specialPressed = true
    startFighterSpecial(owner, 0, input).assertTrue()
    advanceSpecials(world, 0)
    world.fighters[3].damage.assertEquals(8.)
