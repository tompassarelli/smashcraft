package MeleeContactTests
import Simulation

function prepareJab(FighterState attacker, FighterState target, int facing)
	attacker.facing = facing
	beginAttackPair(attacker, target, 0, -1, false, false)
	attacker.attackFrame = attackStartupFrames(0)

@Test function meleeCapsuleBlocksAndDamagesShieldOnlyWhenItsCircleIsReached()
	let attacker = new FighterState(0, 0, 1)
	let shielded = new FighterState(1, 70, -1)
	shielded.shield = true
	prepareJab(attacker, shielded, 1)
	resolveAttackPair(attacker, shielded)
	shielded.damage.assertEquals(0.)
	(shielded.shieldEnergy < SHIELD_MAX).assertTrue()
	shielded.shieldStun.assertGreaterThan(0)
	destroy attacker
	destroy shielded

@Test function drainedShieldLeavesARealMeleePokeAtTheExposedBodyEdge()
	let attacker = new FighterState(0, 0, 1)
	let defender = new FighterState(1, 100, -1)
	defender.shield = true
	defender.shieldEnergy = 0
	prepareJab(attacker, defender, 1)
	resolveAttackPair(attacker, defender)
	defender.damage.assertGreaterThan(0.)
	defender.shieldStun.assertEquals(0)
	defender.hitstun.assertGreaterThan(0)
	destroy attacker
	destroy defender

@Test function meleeCanReachShieldBeforeTheBodyAndFacingMirrorsItsVolume()
	for direction = -1 to 1
		if direction != 0
			let attacker = new FighterState(0, 0, direction)
			let defender = new FighterState(1, direction * 110., -direction)
			defender.shield = true
			prepareJab(attacker, defender, direction)
			resolveAttackPair(attacker, defender)
			defender.damage.assertEquals(0.)
			(defender.shieldEnergy < SHIELD_MAX).assertTrue()
			destroy attacker
			destroy defender

@Test function meleeCapsuleTradesQueueBothContactsBeforeEitherHitResolves()
	let first = new FighterState(0, -35, 1)
	let second = new FighterState(1, 35, -1)
	beginAttackPair(first, second, 0, 0, false, false)
	first.attackFrame = attackStartupFrames(0)
	second.attackFrame = attackStartupFrames(0)
	resolveAttackPair(first, second)
	first.damage.assertGreaterThan(0.)
	second.damage.assertGreaterThan(0.)
	first.hitstun.assertGreaterThan(0)
	second.hitstun.assertGreaterThan(0)
	destroy first
	destroy second
