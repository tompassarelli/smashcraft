package JournalMatchLifecycleTests
import JournalMatchLifecycle

@Test function matchLifecycleRequiresEveryHumanAndResetsForRematch()
    let lifecycle = new JournalMatchLifecycle()
    lifecycle.beginEpoch(1, 5)
    lifecycle.ready(1, 0)
    lifecycle.ready(1, 0)
    lifecycle.ready(1, 1)
    lifecycle.started().assertFalse()
    lifecycle.ready(1, 2)
    lifecycle.started().assertTrue()
    lifecycle.stopped(1, 0)
    lifecycle.quiescent().assertFalse()
    lifecycle.stopped(1, 2)
    lifecycle.quiescent().assertTrue()
    lifecycle.beginEpoch(2, 5)
    lifecycle.started().assertFalse()
    lifecycle.quiescent().assertFalse()
    lifecycle.ready(1, 0)
    lifecycle.ready(1, 2)
    lifecycle.stopped(1, 0)
    lifecycle.stopped(1, 2)
    lifecycle.started().assertFalse()
    lifecycle.quiescent().assertFalse()
    lifecycle.ready(2, 0)
    lifecycle.ready(2, 2)
    lifecycle.started().assertTrue()
    destroy lifecycle
