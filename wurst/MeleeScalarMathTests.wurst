package MeleeScalarMathTests
import MeleeScalarMath

@Test function recordedScalar0()
    (meleeAtan2(0., 1.) == 0.).assertTrue()
    (meleeCos(meleeAtan2(0., 1.)) == 1.).assertTrue()
    (meleeSin(meleeAtan2(0., 1.)) == 0.).assertTrue()

@Test function recordedScalar1()
    (meleeAtan2(1., 0.) == 1.5707963705062866).assertTrue()
    (meleeCos(meleeAtan2(1., 0.)) == -0.000000055655068109672357).assertTrue()
    (meleeSin(meleeAtan2(1., 0.)) == 1.).assertTrue()

@Test function recordedScalar2()
    (meleeAtan2(0., -1.) == 3.1415927410125732).assertTrue()
    (meleeCos(meleeAtan2(0., -1.)) == -1.).assertTrue()
    (meleeSin(meleeAtan2(0., -1.)) == -0.00000008742277657347586).assertTrue()

@Test function recordedScalar3()
    (meleeAtan2(-1., 0.) == -1.5707963705062866).assertTrue()
    (meleeCos(meleeAtan2(-1., 0.)) == -0.000000055655068109672357).assertTrue()
    (meleeSin(meleeAtan2(-1., 0.)) == -1.).assertTrue()

@Test function recordedScalar4()
    (meleeAtan2(3., 4.) == 0.6435011625289917).assertTrue()
    (meleeCos(meleeAtan2(3., 4.)) == 0.7999999523162842).assertTrue()
    (meleeSin(meleeAtan2(3., 4.)) == 0.6000000834465027).assertTrue()

@Test function recordedScalar5()
    (meleeAtan2(4., 3.) == 0.9272952079772949).assertTrue()
    (meleeCos(meleeAtan2(4., 3.)) == 0.6000000238418579).assertTrue()
    (meleeSin(meleeAtan2(4., 3.)) == 0.800000011920929).assertTrue()

@Test function recordedScalar6()
    (meleeAtan2(1., 1.) == 0.7853981852531433).assertTrue()
    (meleeCos(meleeAtan2(1., 1.)) == 0.7071068286895752).assertTrue()
    (meleeSin(meleeAtan2(1., 1.)) == 0.7071068286895752).assertTrue()

@Test function recordedScalar7()
    (meleeAtan2(-1., 1.) == -0.7853981852531433).assertTrue()
    (meleeCos(meleeAtan2(-1., 1.)) == 0.7071068286895752).assertTrue()
    (meleeSin(meleeAtan2(-1., 1.)) == -0.7071068286895752).assertTrue()

@Test function recordedScalar8()
    (meleeAtan2(1., -1.) == 2.356194496154785).assertTrue()
    (meleeCos(meleeAtan2(1., -1.)) == -0.7071068286895752).assertTrue()
    (meleeSin(meleeAtan2(1., -1.)) == 0.7071067690849304).assertTrue()

@Test function recordedScalar9()
    (meleeAtan2(-1., -1.) == -2.356194496154785).assertTrue()
    (meleeCos(meleeAtan2(-1., -1.)) == -0.7071068286895752).assertTrue()
    (meleeSin(meleeAtan2(-1., -1.)) == -0.7071067690849304).assertTrue()

@Test function recordedScalar10()
    (meleeAtan2(0.05000000074505806, 1.) == 0.04995839670300484).assertTrue()
    (meleeCos(meleeAtan2(0.05000000074505806, 1.)) == 0.9987523555755615).assertTrue()
    (meleeSin(meleeAtan2(0.05000000074505806, 1.)) == 0.049937617033720016).assertTrue()

@Test function recordedScalar11()
    (meleeCos(0.) == 1.).assertTrue()
    (meleeSin(0.) == 0.).assertTrue()

@Test function recordedScalar12()
    (meleeCos(1.5707963705062866) == -0.000000055655068109672357).assertTrue()
    (meleeSin(1.5707963705062866) == 1.).assertTrue()

@Test function recordedScalar13()
    (meleeCos(-1.5707963705062866) == -0.000000055655068109672357).assertTrue()
    (meleeSin(-1.5707963705062866) == -1.).assertTrue()

@Test function recordedScalar14()
    (meleeCos(3.1415927410125732) == -1.).assertTrue()
    (meleeSin(3.1415927410125732) == -0.00000008742277657347586).assertTrue()

@Test function recordedScalar15()
    (meleeCos(-3.1415927410125732) == -1.).assertTrue()
    (meleeSin(-3.1415927410125732) == 0.00000008742277657347586).assertTrue()


@Test function scalarTrigCoversDiAnglesCrossingThePiBoundary()
    meleeCos(3.455751895904541015625000000000).assertEquals(-0.951056540012359619140625000000)
    meleeSin(3.455751895904541015625000000000).assertEquals(-0.309017002582550048828125000000)
    meleeCos(-3.455751895904541015625000000000).assertEquals(-0.951056540012359619140625000000)
    meleeSin(-3.455751895904541015625000000000).assertEquals(0.309017002582550048828125000000)
    meleeCos(3.341592550277709960937500000000).assertEquals(-0.980066597461700439453125000000)
    meleeSin(3.341592550277709960937500000000).assertEquals(-0.198669224977493286132812500000)
    meleeCos(-3.341592550277709960937500000000).assertEquals(-0.980066597461700439453125000000)
    meleeSin(-3.341592550277709960937500000000).assertEquals(0.198669224977493286132812500000)
    meleeCos(1.884955644607543945312500000000).assertEquals(-0.309017032384872436523437500000)
    meleeSin(1.884955644607543945312500000000).assertEquals(0.951056480407714843750000000000)
    meleeCos(-1.884955644607543945312500000000).assertEquals(-0.309017032384872436523437500000)
    meleeSin(-1.884955644607543945312500000000).assertEquals(-0.951056480407714843750000000000)
    meleeCos(0.314159274101257324218750000000).assertEquals(0.951056540012359619140625000000)
    meleeSin(0.314159274101257324218750000000).assertEquals(0.309017032384872436523437500000)
    meleeCos(-0.314159274101257324218750000000).assertEquals(0.951056540012359619140625000000)
    meleeSin(-0.314159274101257324218750000000).assertEquals(-0.309017032384872436523437500000)
