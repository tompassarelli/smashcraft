package InputProtocol
import NetworkInput

// Leave one signed counter value for the next-frame cursor.
public constant int INPUT_LAST_FRAME = 2147483646
public constant int INPUT_HEADER_MIN_BYTES = 5
public constant int INPUT_HEADER_MAX_BYTES = 17
public constant int INPUT_MIN_RECORD_BYTES = 1
public constant int INPUT_MAX_RECORD_BYTES = 21
constant string INPUT_ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_"

function compact(int value, int width) returns string
    var result = ""
    var remaining = value
    for i = 1 to width
        result = INPUT_ALPHABET.charAt(remaining mod 64) + result
        remaining = remaining div 64
    return result

function parseCompact(string wire, int offset, int width) returns int
    if offset < 0 or offset + width > wire.length()
        return -1
    var value = 0
    for i = offset to offset + width - 1
        let digit = INPUT_ALPHABET.indexOf(wire.charAt(i))
        if digit < 0 or value > 33554431
            return -1
        value = value * 64 + digit
    return value

function compactVarint(int value) returns string
    if value < 0
        return ""
    var remaining = value
    var result = ""
    var more = true
    while more
        let payload = remaining mod 32
        remaining = remaining div 32
        more = remaining > 0
        result += INPUT_ALPHABET.charAt(payload + (more ? 32 : 0))
    return result

function compactVarintWidth(string wire, int offset) returns int
    if offset < 0 or offset >= wire.length()
        return -1
    for width = 1 to 7
        if offset + width > wire.length()
            return -1
        let digit = INPUT_ALPHABET.indexOf(wire.charAt(offset + width - 1))
        if digit < 0
            return -1
        if digit < 32
            return width
    return -1

function parseCompactVarint(string wire, int offset, int width, int maximum) returns int
    if width < 1 or width > 7 or offset < 0 or offset + width > wire.length()
        return -1
    var value = 0
    var multiplier = 1
    for i = 0 to width - 1
        let digit = INPUT_ALPHABET.indexOf(wire.charAt(offset + i))
        if digit < 0 or (i < width - 1 and digit < 32) or (i == width - 1 and digit >= 32)
            return -1
        let payload = digit mod 32
        if (i == width - 1 and width > 1 and payload == 0) or (i == 6 and payload > 1)
            return -1
        if payload > (maximum - value) div multiplier
            return -1
        value += payload * multiplier
        if i < width - 1
            multiplier *= 32
    return value

// Zero maps to zero, negatives to odd digits, positives to even digits.
function signedDigit(int value) returns int
    return value < 0 ? -2 * value - 1 : 2 * value

function signedValue(int digit) returns int
    return digit mod 2 == 1 ? -(digit + 1) div 2 : digit div 2

function encodeRecord(NetworkInput row) returns string
    var flags = 0
    var body = ""
    if row.heldMask() != 0
        flags += 1
        body += compact(row.heldMask(), 3)
    if row.pressedMask() != 0 or row.releasedMask() != 0
        flags += 2
        body += compact(row.pressedMask(), 3) + compact(row.releasedMask(), 3)
    let axes = signedDigit(row.axisX()) * 255 + signedDigit(row.axisZ())
    if axes != 0
        flags += 4
        body += compact(axes, 3)
    let triggers = row.triggerLeft() * 256 + row.triggerRight()
    if triggers != 0
        flags += 8
        body += compact(triggers, 3)
    // NetworkInput permits SDI iff its vector is nonzero, so the vector also
    // carries the pulse flag without losing any valid NetworkInput state.
    let metadata = signedDigit(row.specialX()) + 3 * signedDigit(row.specialZ())
        + 9 * signedDigit(row.dodgeX()) + 27 * signedDigit(row.dodgeZ())
        + 81 * signedDigit(row.sdiX()) + 243 * signedDigit(row.sdiZ())
        + 729 * signedDigit(row.ledgeVerticalPressed())
    if metadata != 0
        flags += 16
        body += compact(metadata, 2)
    let throws = signedDigit(row.throwX()) * 255 + signedDigit(row.throwZ())
    if throws != 0
        flags += 32
        body += compact(throws, 3)
    return compact(flags, 1) + body

// Return the next record offset, or -1. No absent group inherits prior state.
function decodeRecord(string wire, int offset, NetworkInput destination) returns int
    let flags = parseCompact(wire, offset, 1)
    if flags < 0
        return -1
    var cursor = offset + 1
    var held = 0
    var pressed = 0
    var released = 0
    var axes = 0
    var triggers = 0
    var metadata = 0
    var throws = 0
    if flags mod 2 == 1
        held = parseCompact(wire, cursor, 3)
        cursor += 3
        if held <= 0 or held > INPUT_ACTION_MASK
            return -1
    if (flags div 2) mod 2 == 1
        pressed = parseCompact(wire, cursor, 3)
        released = parseCompact(wire, cursor + 3, 3)
        cursor += 6
        if pressed < 0 or pressed > INPUT_ACTION_MASK or released < 0 or released > INPUT_ACTION_MASK or (pressed == 0 and released == 0)
            return -1
    if (flags div 4) mod 2 == 1
        axes = parseCompact(wire, cursor, 3)
        cursor += 3
        if axes <= 0 or axes > 65024
            return -1
    if (flags div 8) mod 2 == 1
        triggers = parseCompact(wire, cursor, 3)
        cursor += 3
        if triggers <= 0 or triggers > 65535
            return -1
    if (flags div 16) mod 2 == 1
        metadata = parseCompact(wire, cursor, 2)
        cursor += 2
        if metadata <= 0 or metadata > 2186
            return -1
    if (flags div 32) mod 2 == 1
        throws = parseCompact(wire, cursor, 3)
        cursor += 3
        if throws <= 0 or throws > 65024
            return -1
    if not destination.assign(held, pressed, released, signedValue(axes div 255), signedValue(axes mod 255), triggers div 256, triggers mod 256)
        return -1
    let sdiX = signedValue((metadata div 81) mod 3)
    let sdiZ = signedValue((metadata div 243) mod 3)
    if not destination.assignPressData(signedValue(metadata mod 3), signedValue((metadata div 3) mod 3),
            signedValue((metadata div 9) mod 3), signedValue((metadata div 27) mod 3),
            sdiX != 0 or sdiZ != 0, sdiX, sdiZ, signedValue(metadata div 729))
        return -1
    // assign derives throw contributions from pressed bits; the wire owns the
    // accumulated values, including explicitly zero contributions.
    if not destination.assignThrowContributions(signedValue(throws div 255), signedValue(throws mod 255))
        return -1
    return cursor

public function inputPacketSizeInRange(int bytes, int records) returns boolean
    return records >= 1 and records <= 2 and bytes >= INPUT_HEADER_MIN_BYTES + INPUT_MIN_RECORD_BYTES * records and bytes <= INPUT_HEADER_MAX_BYTES + INPUT_MAX_RECORD_BYTES * records

// I4 | count (1/2) | epoch varint | first-frame varint. Each unsigned
// varint uses 5 payload bits per safe base64 character; bit 5 marks continuation.
// Each absolute row starts with six presence bits: held, edges, axes, triggers,
// press metadata, throw totals. Present groups must be nonzero. No packet or
// row depends on a predecessor. Sender identity comes from the receive event.
public class InputPacket
    private int epoch = -1
    private int firstFrame = 0
    private int count = 0
    private NetworkInput first = new NetworkInput()
    private NetworkInput second = new NetworkInput()

    function assign(int assignedEpoch, int assignedFirst, int recordCount, NetworkInput firstInput, NetworkInput secondInput) returns boolean
        count = 0
        if assignedEpoch < 0 or assignedFirst < 1 or assignedFirst > INPUT_LAST_FRAME or recordCount < 1 or recordCount > 2
            return false
        if assignedFirst > INPUT_LAST_FRAME - (recordCount - 1)
            return false
        firstInput.copyTo(first)
        if recordCount == 2
            secondInput.copyTo(second)
        epoch = assignedEpoch
        firstFrame = assignedFirst
        count = recordCount
        return true

    function decode(string wire) returns boolean
        count = 0
        if wire.length() < INPUT_HEADER_MIN_BYTES + INPUT_MIN_RECORD_BYTES or wire.length() > INPUT_HEADER_MAX_BYTES + 2 * INPUT_MAX_RECORD_BYTES
            return false
        if wire.substring(0, 2) != "I4"
            return false
        let records = parseCompact(wire, 2, 1)
        if not inputPacketSizeInRange(wire.length(), records)
            return false
        let epochWidth = compactVarintWidth(wire, 3)
        let decodedEpoch = parseCompactVarint(wire, 3, epochWidth, 2147483647)
        if decodedEpoch < 0
            return false
        let frameOffset = 3 + epochWidth
        let frameWidth = compactVarintWidth(wire, frameOffset)
        let decodedFirst = parseCompactVarint(wire, frameOffset, frameWidth, INPUT_LAST_FRAME)
        if decodedEpoch < 0 or decodedFirst < 1 or decodedFirst > INPUT_LAST_FRAME - (records - 1)
            return false
        var cursor = decodeRecord(wire, frameOffset + frameWidth, first)
        if cursor < 0
            return false
        if records == 2
            cursor = decodeRecord(wire, cursor, second)
        if cursor != wire.length()
            return false
        epoch = decodedEpoch
        firstFrame = decodedFirst
        count = records
        return true

    function encode() returns string
        if count == 0
            return ""
        let header = "I4" + compact(count, 1) + compactVarint(epoch) + compactVarint(firstFrame)
        return header + encodeRecord(first) + (count == 2 ? encodeRecord(second) : "")

    function epochNumber() returns int
        return epoch

    function firstFrameNumber() returns int
        return firstFrame

    function recordCount() returns int
        return count

    function copyRecord(int record, NetworkInput destination) returns boolean
        if record < 0 or record >= count
            return false
        if record == 0
            first.copyTo(destination)
        else
            second.copyTo(destination)
        return true
