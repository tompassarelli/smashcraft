package FrameIntegrityExperiment
import WorldTestSupport
import ShadowInputSchedule
import ShadowInputPlayback
import ReplayHistory
import ReplayState
import MatchRules
import Simulation
import CommandBuffer
import NetworkInput
import InputProtocol
import InputLedger
import KeyBindings
import MatchStep
import ParticipantInputs
import KeyboardInputCapture

class IntegrityWorld
	FighterState first = new FighterState(0, -55, 1)
	FighterState second = new FighterState(1, 55, -1)
	MatchState game = new MatchState()
	AttackBuffer firstCommands = new AttackBuffer(4)
	AttackBuffer secondCommands = new AttackBuffer(4)
	ReplayRuntimeState runtime = new ReplayRuntimeState()
	ReplaySnapshot snapshot = new ReplaySnapshot()

	construct()
		game.setHumanCount(2)
		game.phase = MATCH
		game.timeLimitMinutes = 0
		game.stockCount = 99
		first.stocks = 99
		second.stocks = 99

	function capture()
		snapshot.capture(testWorld(first, second), game, testCommands(firstCommands, secondCommands), runtime)

class ContactIntegrityWorld
	FighterState first = new FighterState(0, 0, 1)
	FighterState second = new FighterState(1, 100, -1)
	MatchState game = new MatchState()
	AttackBuffer firstCommands = new AttackBuffer(4)
	AttackBuffer secondCommands = new AttackBuffer(4)
	ReplayRuntimeState runtime = new ReplayRuntimeState()
	ReplaySnapshot snapshot = new ReplaySnapshot()

	construct()
		game.setHumanCount(2)
		game.phase = MATCH
		game.timeLimitMinutes = 0
		game.stockCount = 99
		first.stocks = 99
		second.stocks = 99

	function capture()
		snapshot.capture(testWorld(first, second), game, testCommands(firstCommands, secondCommands), runtime)

function integrityNeutral(NetworkInput row)
	row.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
	row.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
	row.assignThrowContributions(0, 0).assertTrue()

// Independently authored oracle: frame numbers are fixed before either schedule runs.
// Slot 0 attacks while moving in; slot 1 shields on frame 4 and holds through 6.
function integrityCorpusRow(int frame, int slot, NetworkInput row)
	var held = 0
	var pressed = 0
	var released = 0
	var x = 0
	var triggers = 0
	if slot == 0 and frame >= 1 and frame <= 4
		held += inputActionBit(MOVE_RIGHT)
		x = 127
	if slot == 0 and frame == 1
		pressed += inputActionBit(ATTACK)
	if slot == 1 and frame >= 4 and frame <= 6
		held += inputActionBit(LEFT_TRIGGER)
		triggers = 255
	if slot == 1 and frame == 4
		pressed += inputActionBit(LEFT_TRIGGER)
	if slot == 1 and frame == 7
		released += inputActionBit(LEFT_TRIGGER)
	row.assign(held, pressed, released, x, 0, triggers, 0).assertTrue()
	row.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
	row.assignThrowContributions(0, 0).assertTrue()

function integrityDeliver(ShadowInputSchedule schedule, int sender, int epoch, int frame,
		NetworkInput input, InputPacket packet)
	packet.assign(epoch, frame, 1, input, input).assertTrue()
	schedule.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)

function integrityBuildRows(int frame, NetworkInput first, NetworkInput second)
	integrityCorpusRow(frame, 0, first)
	integrityCorpusRow(frame, 1, second)

// Contact corpus uses exact assigned frames: a jab press at F1 and a shield
// press held for two rows beginning at the independently selected shield frame.
function contactCorpusRow(int frame, int slot, int shieldFrame, NetworkInput row)
	var held = 0
	var pressed = 0
	var released = 0
	var triggerAmount = 0
	if slot == 0 and frame == 1
		pressed = inputActionBit(ATTACK)
	if slot == 1 and frame >= shieldFrame and frame <= shieldFrame + 1
		held = inputActionBit(LEFT_TRIGGER)
		triggerAmount = 255
		if frame == shieldFrame
			pressed = inputActionBit(LEFT_TRIGGER)
	if slot == 1 and frame == shieldFrame + 2
		released = inputActionBit(LEFT_TRIGGER)
	row.assign(held, pressed, released, 0, 0, triggerAmount, 0).assertTrue()
	row.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
	row.assignThrowContributions(0, 0).assertTrue()

function runContactFrame(ContactIntegrityWorld fight, int frame, int shieldFrame,
		NetworkInput first, NetworkInput second, ParticipantInputs rows, MatchFrameInput recorded)
	contactCorpusRow(frame, 0, shieldFrame, first)
	contactCorpusRow(frame, 1, shieldFrame, second)
	first.copyTo(rows.row(0))
	second.copyTo(rows.row(1))
	recorded.captureNetworkInputs(frame, rows, testWorld(fight.first, fight.second), 3).assertTrue()
	recorded.execute(fight.game, testWorld(fight.first, fight.second),
		testCommands(fight.firstCommands, fight.secondCommands), fight.runtime, frame).assertTrue()

function runOneSpeculativeFrame(ShadowInputSchedule schedule, ShadowInputPlayback playback,
		ReplayHistory history, ContactIntegrityWorld fight, int epoch, int localPlayer,
		int frame, int shieldFrame, NetworkInput sample)
	contactCorpusRow(frame, localPlayer, shieldFrame, sample)
	schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
	playback.advanceSpeculative(schedule, epoch, localPlayer, fight.game,
		testWorld(fight.first, fight.second), testCommands(fight.firstCommands, fight.secondCommands),
		fight.runtime, history).assertTrue()

function runIntegrityScenario(int localPlayer)
	let epoch = 1100 + localPlayer
	let remotePlayer = 1 - localPlayer
	let canonical = new IntegrityWorld()
	let speculative = new IntegrityWorld()
	let confirmed = new IntegrityWorld()
	let schedule = new ShadowInputSchedule()
	let playback = new ShadowInputPlayback()
	let history = new ReplayHistory()
	let confirmedHistory = new ReplayHistory()
	let sample = new NetworkInput()
	let first = new NetworkInput()
	let second = new NetworkInput()
	let copied = new NetworkInput()
	let pending = new NetworkInput()
	let packet = new InputPacket()
	let packetRow = new NetworkInput()
	let rows = new ParticipantInputs()
	let canonicalRow = new MatchFrameInput()
	let recorded = new MatchFrameInput()
	schedule.beginEpoch(epoch, 0, 24, 3).assertTrue()
	playback.beginEpoch(epoch).assertTrue()
	history.beginEpochWithCorrections(epoch, 1, 24).assertTrue()
	confirmedHistory.beginEpoch(epoch, 1).assertTrue()
	for frame = 1 to 4
		integrityBuildRows(frame, first, second)
		first.copyTo(rows.row(0))
		second.copyTo(rows.row(1))
		canonicalRow.captureNetworkInputs(frame, rows, testWorld(canonical.first, canonical.second), 3).assertTrue()
		canonicalRow.execute(canonical.game, testWorld(canonical.first, canonical.second), testCommands(canonical.firstCommands, canonical.secondCommands), canonical.runtime, frame).assertTrue()
		integrityCorpusRow(frame, localPlayer, sample)
		schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
		playback.advanceSpeculative(schedule, epoch, localPlayer, speculative.game,
			testWorld(speculative.first, speculative.second), testCommands(speculative.firstCommands, speculative.secondCommands),
			speculative.runtime, history).assertTrue()
	if remotePlayer == 0
		canonical.first.attackSerial.assertGreaterThan(0)
		speculative.first.attackSerial.assertEquals(0)
	// At the frame-5 sampling boundary, frame-1 has spent four logical ticks
	// in flight. Send the remote rows out of order; absolute frame tags remain 1-4.
	integrityCorpusRow(5, localPlayer, sample)
	schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
	for index = 0 to 3
		let frame = 4 - index
		integrityCorpusRow(frame, remotePlayer, packetRow)
		integrityDeliver(schedule, remotePlayer, epoch, frame, packetRow, packet)
	for frame = 1 to 4
		schedule.copyPending(epoch, frame, pending).assertTrue()
		integrityDeliver(schedule, localPlayer, epoch, frame, pending, packet)
	schedule.knownThrough().assertEquals(4)
	playback.reconcile(schedule, epoch, localPlayer, testWorld(speculative.first, speculative.second),
		speculative.game, testCommands(speculative.firstCommands, speculative.secondCommands), speculative.runtime, history).assertEquals(remotePlayer == 0 ? 1 : 4)
	if remotePlayer == 0
		speculative.first.attackSerial.assertGreaterThan(0)
	for frame = 5 to 8
		integrityBuildRows(frame, first, second)
		first.copyTo(rows.row(0))
		second.copyTo(rows.row(1))
		canonicalRow.captureNetworkInputs(frame, rows, testWorld(canonical.first, canonical.second), 3).assertTrue()
		canonicalRow.execute(canonical.game, testWorld(canonical.first, canonical.second), testCommands(canonical.firstCommands, canonical.secondCommands), canonical.runtime, frame).assertTrue()
		if frame > 5
			integrityCorpusRow(frame, localPlayer, sample)
			schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
		playback.advanceSpeculative(schedule, epoch, localPlayer, speculative.game,
			testWorld(speculative.first, speculative.second), testCommands(speculative.firstCommands, speculative.secondCommands),
			speculative.runtime, history).assertTrue()
	for frame = 5 to 8
		for slot = 0 to 1
			if slot == localPlayer
				schedule.copyPending(epoch, frame, pending).assertTrue()
				integrityDeliver(schedule, slot, epoch, frame, pending, packet)
			else
				integrityCorpusRow(frame, slot, packetRow)
				integrityDeliver(schedule, slot, epoch, frame, packetRow, packet)
	schedule.knownThrough().assertEquals(8)
	playback.reconcile(schedule, epoch, localPlayer, testWorld(speculative.first, speculative.second),
		speculative.game, testCommands(speculative.firstCommands, speculative.secondCommands), speculative.runtime, history).assertEquals(remotePlayer == 0 ? 5 : 7)
	while schedule.mayAdvanceConfirmed()
		playback.advanceConfirmed(schedule, epoch, confirmed.game, testWorld(confirmed.first, confirmed.second),
			testCommands(confirmed.firstCommands, confirmed.secondCommands), confirmed.runtime, confirmedHistory).assertTrue()
	canonical.capture()
	speculative.capture()
	confirmed.capture()
	speculative.snapshot.firstDifference(canonical.snapshot).assertEquals("")
	speculative.snapshot.firstDifference(confirmed.snapshot).assertEquals("")
	history.copyInputRow(epoch, 1, recorded).assertTrue()
	recorded.copyNetworkRow(remotePlayer, copied).assertTrue()
	integrityCorpusRow(1, remotePlayer, sample)
	copied.sameAs(sample).assertTrue()
	assertTrue(speculative.first.attackSerial > 0, "Canonical corpus must exercise an attack")
	assertTrue(speculative.second.shield or speculative.second.shieldReleaseLag > 0, "Corpus must exercise shield defense")

@Test function fourFrameLateReorderedCombatRowsReplayToCanonicalForBothRoles()
	runIntegrityScenario(0)
	runIntegrityScenario(1)

@Test function keyboardSamplerCannotObserveACompleteTapBetweenPolls()
	let sampler = new KeyboardInputCapture()
	let row = new NetworkInput()
	// A device press and release entirely between polls leaves zero at both
	// observable sample boundaries, so no edge can enter the input row.
	// The transient state is absent from the observations; only neutral is polled.
	sampler.sample(0).assertTrue()
	sampler.sample(0).assertTrue()
	sampler.read(row)
	row.pressedMask().assertEquals(0)
	row.releasedMask().assertEquals(0)
	row.heldMask().assertEquals(0)

@Test function captureRowCoalescesRepeatedSameActionPressAndReleaseBits()
	let sampler = new KeyboardInputCapture()
	let row = new NetworkInput()
	let attack = inputActionBit(ATTACK)
	sampler.sample(attack).assertTrue()
	sampler.sample(0).assertTrue()
	sampler.sample(attack).assertTrue()
	sampler.sample(0).assertTrue()
	sampler.read(row)
	row.actionPressed(ATTACK).assertTrue()
	row.actionReleased(ATTACK).assertTrue()
	// Two cycles are represented by one bit in each edge mask; count and order
	// are not part of NetworkInput's row format.
	row.pressedMask().assertEquals(attack)
	row.releasedMask().assertEquals(attack)

@Test function progressCursorDoesNotCatchUpToIndependentContinuousFrameClock()
	let schedule = new ShadowInputSchedule()
	let row = new NetworkInput()
	let inputs = new ParticipantInputs()
	schedule.beginEpoch(1200, 0, 24, 1).assertTrue()
	integrityNeutral(row)
	schedule.captureLocal(1200, row).assertEquals(SHADOW_CAPTURED)
	schedule.resolveSpeculative(1200, 0, inputs).assertTrue()
	schedule.completeSpeculative(1200, 1).assertTrue()
	// Assume four further nominal 60 Hz ticks elapsed while this service made
	// no progress. The independently defined continuous contract expects F=6;
	// the scheduler has no wall clock and still offers its next relative F=2.
	let externalContinuousExpectedFrame = 6
	externalContinuousExpectedFrame.assertEquals(6)
	schedule.captureTarget().assertEquals(2)

@Test function fourFrameShieldShiftChangesRealJabContactAndDamage()
	let timely = new ContactIntegrityWorld()
	let shifted = new ContactIntegrityWorld()
	let first = new NetworkInput()
	let second = new NetworkInput()
	let timelyRows = new ParticipantInputs()
	let shiftedRows = new ParticipantInputs()
	let timelyRecord = new MatchFrameInput()
	let shiftedRecord = new MatchFrameInput()
	for frame = 1 to 12
		runContactFrame(timely, frame, 5, first, second, timelyRows, timelyRecord)
		runContactFrame(shifted, frame, 9, first, second, shiftedRows, shiftedRecord)
	timely.second.damage.assertEquals(0.)
	timely.second.shieldStun.assertGreaterThan(0)
	shifted.second.damage.assertGreaterThan(0.)
	shifted.first.attackHit.assertTrue()
	timely.capture()
	shifted.capture()
	assertTrue(timely.snapshot.firstDifference(shifted.snapshot) != "", "A four-frame shield shift must change final combat state")

@Test function fourFrameLateShieldContactCorrectionMatchesDirectCanonicalOutcome()
	let epoch = 1250
	let localPlayer = 0
	let remotePlayer = 1
	let canonical = new ContactIntegrityWorld()
	let speculative = new ContactIntegrityWorld()
	let confirmed = new ContactIntegrityWorld()
	let schedule = new ShadowInputSchedule()
	let playback = new ShadowInputPlayback()
	let history = new ReplayHistory()
	let confirmedHistory = new ReplayHistory()
	let sample = new NetworkInput()
	let remoteRow = new NetworkInput()
	let pending = new NetworkInput()
	let packet = new InputPacket()
	let rows = new ParticipantInputs()
	let canonicalRecord = new MatchFrameInput()
	let confirmedRecord = new MatchFrameInput()
	schedule.beginEpoch(epoch, 0, 24, 3).assertTrue()
	playback.beginEpoch(epoch).assertTrue()
	history.beginEpochWithCorrections(epoch, 1, 24).assertTrue()
	confirmedHistory.beginEpoch(epoch, 1).assertTrue()
	for frame = 1 to 8
		runContactFrame(canonical, frame, 5, remoteRow, pending, rows, canonicalRecord)
		runOneSpeculativeFrame(schedule, playback, history, speculative,
			epoch, localPlayer, frame, 5, sample)
	// Canonical input F5 shielded the jab; with that sender withheld, the
	// speculative execution takes the contact and displays damage.
	canonical.second.damage.assertEquals(0.)
	speculative.second.damage.assertGreaterThan(0.)
	for index = 0 to 7
		let frame = 8 - index
		contactCorpusRow(frame, remotePlayer, 5, remoteRow)
		integrityDeliver(schedule, remotePlayer, epoch, frame, remoteRow, packet)
	for frame = 1 to 8
		schedule.copyPending(epoch, frame, pending).assertTrue()
		integrityDeliver(schedule, localPlayer, epoch, frame, pending, packet)
	schedule.knownThrough().assertEquals(8)
	playback.reconcile(schedule, epoch, localPlayer, testWorld(speculative.first, speculative.second),
		speculative.game, testCommands(speculative.firstCommands, speculative.secondCommands),
		speculative.runtime, history).assertEquals(5)
	speculative.second.damage.assertEquals(0.)
	speculative.second.shieldStun.assertGreaterThan(0)
	while schedule.mayAdvanceConfirmed()
		playback.advanceConfirmed(schedule, epoch, confirmed.game, testWorld(confirmed.first, confirmed.second),
			testCommands(confirmed.firstCommands, confirmed.secondCommands), confirmed.runtime, confirmedHistory).assertTrue()
	canonical.capture()
	speculative.capture()
	confirmed.capture()
	speculative.snapshot.firstDifference(canonical.snapshot).assertEquals("")
	speculative.snapshot.firstDifference(confirmed.snapshot).assertEquals("")
	history.copyInputRow(epoch, 5, canonicalRecord).assertTrue()
	canonicalRecord.copyNetworkRow(remotePlayer, remoteRow).assertTrue()
	contactCorpusRow(5, remotePlayer, 5, pending)
	remoteRow.sameAs(pending).assertTrue()

@Test function sameWallOpportunityGetsDifferentTagsAfterOneScheduleFallsFourAdvancesBehind()
	let advanced = new ShadowInputSchedule()
	let stalled = new ShadowInputSchedule()
	let row = new NetworkInput()
	let inputs = new ParticipantInputs()
	advanced.beginEpoch(1300, 0, 24, 1).assertTrue()
	stalled.beginEpoch(1300, 0, 24, 1).assertTrue()
	integrityNeutral(row)
	for frame = 1 to 4
		advanced.captureLocal(1300, row).assertEquals(SHADOW_CAPTURED)
		advanced.resolveSpeculative(1300, 0, inputs).assertTrue()
		advanced.completeSpeculative(1300, frame).assertTrue()
	advanced.captureTarget().assertEquals(5)
	stalled.captureTarget().assertEquals(1)
	let sameExternalAction = new NetworkInput()
	sameExternalAction.assign(inputActionBit(ATTACK), inputActionBit(ATTACK), 0, 0, 0, 0, 0).assertTrue()
	advanced.captureLocal(1300, sameExternalAction).assertEquals(SHADOW_CAPTURED)
	stalled.captureLocal(1300, sameExternalAction).assertEquals(SHADOW_CAPTURED)
	let advancedRow = new NetworkInput()
	let stalledRow = new NetworkInput()
	advanced.copyPending(1300, 5, advancedRow).assertTrue()
	stalled.copyPending(1300, 1, stalledRow).assertTrue()
	advancedRow.sameAs(stalledRow).assertTrue()
	// Under a continuous 60 Hz frame contract this common external action has
	// expected F5 on both; progress-relative assignment makes the stalled cursor F1.
	advancedRow.actionPressed(ATTACK).assertTrue()
	stalledRow.actionPressed(ATTACK).assertTrue()
