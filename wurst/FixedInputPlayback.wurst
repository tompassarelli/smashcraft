package FixedInputPlayback
import ParticipantInputs
import FixedInputSchedule
import MatchStep
import Simulation
import MatchRules

public class FixedInputPlayback
	private ParticipantInputs acceptedInputs = new ParticipantInputs()
	private MatchFrameInput recorded = new MatchFrameInput()

	function advanceNext(FixedInputSchedule schedule, int epoch, MatchState game,
			FighterRoster world, FrameInputs controls, ReplayRuntimeState runtime) returns boolean
		let frame = schedule.nextFrameNumber()
		if schedule.participantMask() != world.mask or runtime.simulationFrame + 1 != frame or not schedule.readNext(epoch, acceptedInputs)
			return false
		if not recorded.captureNetworkInputs(frame, acceptedInputs, world, schedule.participantMask())
			return false
		if not recorded.execute(game, world, controls, runtime, frame)
			return false
		return schedule.complete(epoch, frame)

	function lastRecordedFrame() returns int
		return recorded.frameNumber()
