        stageHeading = createTextFrame("MeleeStageHeading" + suffix, GAME_UI, 435 + frameOffset)
        stageHeading.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.066, 0.410)
        stageHeading.setSize(0.142, 0.018)
        stageHeading.setText("STAGE  ·  P1 CHOOSES")
        BlzFrameSetFont(stageHeading, "Fonts\\FRIZQT__.TTF", 0.008, 0)
        skyStage = createFrame("ScriptDialogButton", GAME_UI, 0, 436 + frameOffset)
        skyStage.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.066, 0.385)
