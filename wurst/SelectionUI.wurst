package SelectionUI
import Wurst
import ClosureFrames

public abstract class SelectionActions
    abstract function selectChoice(int participantId, int choice)
    abstract function confirmSelection(int participantId)
    abstract function backSelection(int participantId)
    abstract function openSettings(int participantId)

function characterName(int choice) returns string
    return choice == 0 ? "Archer" : "Rifleman"

// Native buttons sit over custom, transparent artwork. Each participant gets
// a complete frame tree on every client; update() reveals only its local tree.
public class SelectionPanel
    framehandle backdrop
    framehandle heading
    framehandle subheading
    framehandle firstTileArt
    framehandle secondTileArt
    framehandle firstChoice
    framehandle secondChoice
    framehandle firstChoicePortrait
    framehandle secondChoicePortrait
    framehandle firstChoiceName
    framehandle secondChoiceName
    framehandle playerOneCard
    framehandle playerTwoCard
    framehandle selectedPortrait
    framehandle selectedName
    framehandle selectedStatus
    framehandle opponentPortrait
    framehandle opponentName
    framehandle opponentStatus
    framehandle playerOneTag
    framehandle playerTwoTag
    framehandle confirmArt
    framehandle backArt
    framehandle settingsArt
    framehandle confirmLabel
    framehandle backLabel
    framehandle settingsLabel
    framehandle confirmButton
    framehandle backButton
    framehandle settingsButton
    int lastState = -1
    int lastChoice = -1
    int lastOwnCharacter = -1
    int lastOpponentChoice = -1
    int participantId
    boolean lastEnabled = false
    boolean lastReady = false
    boolean lastOpponentReady = false
    boolean lastOpponentHuman = false
    boolean settingsOpen = false

    construct(SelectionActions actions, int participantId)
        this.participantId = participantId
        let suffix = I2S(participantId)
        let frameOffset = participantId * 100

        backdrop = createBackdrop("MeleeSelectBackdrop" + suffix, CONSOLE_UI, 400 + frameOffset)
        backdrop.setTexture("war3mapImported\\SelectionBackdrop.tga", 0, false)
        backdrop.setFullscreenReference()

        heading = createTextFrame("MeleeSelectHeading" + suffix, GAME_UI, 401 + frameOffset)
        heading.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.045, 0.467)
        heading.setSize(0.55, 0.024)
        BlzFrameSetFont(heading, "Fonts\\FRIZQT__.TTF", 0.017, 0)
        BlzFrameSetTextAlignment(heading, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)

        subheading = createTextFrame("MeleeSelectSubheading" + suffix, GAME_UI, 402 + frameOffset)
        subheading.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.047, 0.442)
        subheading.setSize(0.62, 0.017)
        BlzFrameSetFont(subheading, "Fonts\\FRIZQT__.TTF", 0.010, 0)
        BlzFrameSetTextAlignment(subheading, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_LEFT)

        firstTileArt = createBackdrop("MeleeArcherTileArt" + suffix, GAME_UI, 419 + frameOffset)
        firstTileArt.setTexture("war3mapImported\\SelectionTileFrame.tga", 0, true)
        firstTileArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.260, 0.424)
        firstTileArt.setSize(0.112, 0.132)
        secondTileArt = createBackdrop("MeleeRiflemanTileArt" + suffix, GAME_UI, 420 + frameOffset)
        secondTileArt.setTexture("war3mapImported\\SelectionTileFrame.tga", 0, true)
        secondTileArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.440, 0.424)
        secondTileArt.setSize(0.112, 0.132)

        firstChoice = createFrame("ScriptDialogButton", GAME_UI, 0, 407 + frameOffset)
        firstChoice.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.260, 0.424)
        firstChoice.setSize(0.112, 0.132)
        firstChoice.setAlpha(0)
        firstChoice.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.selectChoice(participantId, 0)
        end)
        firstChoice.onClickReleaseFocus()

        secondChoice = createFrame("ScriptDialogButton", GAME_UI, 0, 408 + frameOffset)
        secondChoice.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.440, 0.424)
        secondChoice.setSize(0.112, 0.132)
        secondChoice.setAlpha(0)
        secondChoice.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.selectChoice(participantId, 1)
        end)
        secondChoice.onClickReleaseFocus()

        firstChoicePortrait = createBackdrop("MeleeArcherChoicePortrait" + suffix, GAME_UI, 421 + frameOffset)
        firstChoicePortrait.setTexture("war3mapImported\\ArcherTile.tga", 0, true)
        firstChoicePortrait.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.283, 0.411)
        firstChoicePortrait.setSize(0.066, 0.087)
        firstChoicePortrait.setEnabled(false)
        secondChoicePortrait = createBackdrop("MeleeRiflemanChoicePortrait" + suffix, GAME_UI, 422 + frameOffset)
        secondChoicePortrait.setTexture("war3mapImported\\RiflemanTile.tga", 0, true)
        secondChoicePortrait.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.463, 0.411)
        secondChoicePortrait.setSize(0.066, 0.087)
        secondChoicePortrait.setEnabled(false)
        firstChoiceName = createTextFrame("MeleeArcherChoiceName" + suffix, GAME_UI, 423 + frameOffset)
        firstChoiceName.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.264, 0.313)
        firstChoiceName.setSize(0.103, 0.024)
        BlzFrameSetFont(firstChoiceName, "Fonts\\FRIZQT__.TTF", 0.0095, 0)
        BlzFrameSetTextAlignment(firstChoiceName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        firstChoiceName.setEnabled(false)
        secondChoiceName = createTextFrame("MeleeRiflemanChoiceName" + suffix, GAME_UI, 424 + frameOffset)
        secondChoiceName.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.444, 0.313)
        secondChoiceName.setSize(0.103, 0.024)
        BlzFrameSetFont(secondChoiceName, "Fonts\\FRIZQT__.TTF", 0.0095, 0)
        BlzFrameSetTextAlignment(secondChoiceName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        secondChoiceName.setEnabled(false)

        playerOneCard = createBackdrop("MeleeSelectP1Card" + suffix, GAME_UI, 403 + frameOffset)
        playerOneCard.setTexture("war3mapImported\\SelectionCardRed.tga", 0, true)
        playerOneCard.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.241, 0.274)
        playerOneCard.setSize(0.150, 0.230)
        playerTwoCard = createBackdrop("MeleeSelectP2Card" + suffix, GAME_UI, 404 + frameOffset)
        playerTwoCard.setTexture("war3mapImported\\SelectionCardBlue.tga", 0, true)
        playerTwoCard.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.421, 0.274)
        playerTwoCard.setSize(0.150, 0.230)

        playerOneTag = createTextFrame("MeleeSelectP1Tag" + suffix, GAME_UI, 428 + frameOffset)
        playerOneTag.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.271, 0.266)
        playerOneTag.setSize(0.090, 0.012)
        BlzFrameSetFont(playerOneTag, "Fonts\\FRIZQT__.TTF", 0.008, 0)
        BlzFrameSetTextAlignment(playerOneTag, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        playerTwoTag = createTextFrame("MeleeSelectP2Tag" + suffix, GAME_UI, 429 + frameOffset)
        playerTwoTag.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.451, 0.266)
        playerTwoTag.setSize(0.090, 0.012)
        BlzFrameSetFont(playerTwoTag, "Fonts\\FRIZQT__.TTF", 0.008, 0)
        BlzFrameSetTextAlignment(playerTwoTag, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

        selectedPortrait = createBackdrop("MeleeSelectedPortrait" + suffix, GAME_UI, 409 + frameOffset)
        selectedPortrait.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.255 : 0.435, 0.266)
        selectedPortrait.setSize(0.122, 0.163)
        selectedName = createTextFrame("MeleeSelectedName" + suffix, GAME_UI, 410 + frameOffset)
        selectedName.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.247 : 0.427, 0.095)
        selectedName.setSize(0.138, 0.019)
        BlzFrameSetFont(selectedName, "Fonts\\FRIZQT__.TTF", 0.010, 0)
        BlzFrameSetTextAlignment(selectedName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        selectedStatus = createTextFrame("MeleeSelectedStatus" + suffix, GAME_UI, 411 + frameOffset)
        selectedStatus.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.247 : 0.427, 0.110)
        selectedStatus.setSize(0.138, 0.012)
        BlzFrameSetFont(selectedStatus, "Fonts\\FRIZQT__.TTF", 0.0075, 0)
        BlzFrameSetTextAlignment(selectedStatus, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

        opponentPortrait = createBackdrop("MeleeOpponentPortrait" + suffix, GAME_UI, 412 + frameOffset)
        opponentPortrait.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.435 : 0.255, 0.266)
        opponentPortrait.setSize(0.122, 0.163)
        opponentName = createTextFrame("MeleeOpponentName" + suffix, GAME_UI, 413 + frameOffset)
        opponentName.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.427 : 0.247, 0.095)
        opponentName.setSize(0.138, 0.019)
        BlzFrameSetFont(opponentName, "Fonts\\FRIZQT__.TTF", 0.010, 0)
        BlzFrameSetTextAlignment(opponentName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        opponentStatus = createTextFrame("MeleeOpponentStatus" + suffix, GAME_UI, 414 + frameOffset)
        opponentStatus.setAbsPoint(FRAMEPOINT_TOPLEFT, participantId == 0 ? 0.427 : 0.247, 0.110)
        opponentStatus.setSize(0.138, 0.012)
        BlzFrameSetFont(opponentStatus, "Fonts\\FRIZQT__.TTF", 0.0075, 0)
        BlzFrameSetTextAlignment(opponentStatus, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

        confirmArt = createBackdrop("MeleeConfirmArt" + suffix, GAME_UI, 425 + frameOffset)
        confirmArt.setTexture("war3mapImported\\SelectionAction.tga", 0, true)
        confirmArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.071, 0.043)
        confirmArt.setSize(0.235, 0.037)
        backArt = createBackdrop("MeleeBackArt" + suffix, GAME_UI, 426 + frameOffset)
        backArt.setTexture("war3mapImported\\SelectionAction.tga", 0, true)
        backArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.316, 0.043)
        backArt.setSize(0.130, 0.037)
        settingsArt = createBackdrop("MeleeSettingsArt" + suffix, GAME_UI, 427 + frameOffset)
        settingsArt.setTexture("war3mapImported\\SelectionAction.tga", 0, true)
        settingsArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.500, 0.043)
        settingsArt.setSize(0.222, 0.037)

        confirmLabel = createTextFrame("MeleeConfirmLabel" + suffix, GAME_UI, 430 + frameOffset)
        confirmLabel.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.079, 0.039)
        confirmLabel.setSize(0.219, 0.028)
        BlzFrameSetFont(confirmLabel, "Fonts\\FRIZQT__.TTF", 0.011, 0)
        BlzFrameSetTextAlignment(confirmLabel, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        backLabel = createTextFrame("MeleeBackLabel" + suffix, GAME_UI, 431 + frameOffset)
        backLabel.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.320, 0.039)
        backLabel.setSize(0.122, 0.028)
        BlzFrameSetFont(backLabel, "Fonts\\FRIZQT__.TTF", 0.009, 0)
        BlzFrameSetTextAlignment(backLabel, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        settingsLabel = createTextFrame("MeleeSettingsLabel" + suffix, GAME_UI, 432 + frameOffset)
        settingsLabel.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.506, 0.039)
        settingsLabel.setSize(0.209, 0.028)
        BlzFrameSetFont(settingsLabel, "Fonts\\FRIZQT__.TTF", 0.009, 0)
        BlzFrameSetTextAlignment(settingsLabel, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

        confirmButton = createFrame("ScriptDialogButton", GAME_UI, 0, 415 + frameOffset)
        confirmButton.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.071, 0.043)
        confirmButton.setSize(0.235, 0.037)
        confirmButton.setAlpha(0)
        confirmButton.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.confirmSelection(participantId)
        end)
        confirmButton.onClickReleaseFocus()

        backButton = createFrame("ScriptDialogButton", GAME_UI, 0, 416 + frameOffset)
        backButton.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.316, 0.043)
        backButton.setSize(0.130, 0.037)
        backButton.setAlpha(0)
        backButton.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.backSelection(participantId)
        end)
        backButton.onClickReleaseFocus()

        settingsButton = createFrame("ScriptDialogButton", GAME_UI, 0, 417 + frameOffset)
        settingsButton.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.500, 0.043)
        settingsButton.setSize(0.222, 0.037)
        settingsButton.setAlpha(0)
        settingsButton.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.openSettings(participantId)
        end)
        settingsButton.onClickReleaseFocus()

        backdrop.setVisible(false)
        heading.setVisible(false)
        subheading.setVisible(false)
        firstTileArt.setVisible(false)
        secondTileArt.setVisible(false)
        firstChoice.setVisible(false)
        secondChoice.setVisible(false)
        firstChoicePortrait.setVisible(false)
        secondChoicePortrait.setVisible(false)
        firstChoiceName.setVisible(false)
        secondChoiceName.setVisible(false)
        playerOneCard.setVisible(false)
        playerTwoCard.setVisible(false)
        playerOneTag.setVisible(false)
        playerTwoTag.setVisible(false)
        selectedPortrait.setVisible(false)
        selectedName.setVisible(false)
        selectedStatus.setVisible(false)
        opponentPortrait.setVisible(false)
        opponentName.setVisible(false)
        opponentStatus.setVisible(false)
        confirmArt.setVisible(false)
        backArt.setVisible(false)
        settingsArt.setVisible(false)
        confirmLabel.setVisible(false)
        backLabel.setVisible(false)
        settingsLabel.setVisible(false)
        confirmButton.setVisible(false)
        backButton.setVisible(false)
        settingsButton.setVisible(false)

    function update(int menuState, int choice, boolean overlayOpen, boolean enabled, boolean ready,
        int ownCharacter, int opponentChoice, boolean opponentHuman, boolean opponentReady)
        if menuState == lastState and choice == lastChoice and overlayOpen == settingsOpen and enabled == lastEnabled and ready == lastReady and ownCharacter == lastOwnCharacter and opponentChoice == lastOpponentChoice and opponentHuman == lastOpponentHuman and opponentReady == lastOpponentReady
            return
        lastState = menuState
        lastChoice = choice
        settingsOpen = overlayOpen
        lastEnabled = enabled
        lastReady = ready
        lastOwnCharacter = ownCharacter
        lastOpponentChoice = opponentChoice
        lastOpponentHuman = opponentHuman
        lastOpponentReady = opponentReady
        if GetLocalPlayer() != Player(participantId)
            return

        let selecting = (menuState == 0 or menuState == 1) and enabled
        let visible = selecting and not settingsOpen
        backdrop.setVisible(visible)
        heading.setVisible(visible)
        subheading.setVisible(visible)
        firstTileArt.setVisible(visible)
        secondTileArt.setVisible(visible)
        firstChoice.setVisible((menuState == 0 or participantId == 0) and visible)
        secondChoice.setVisible((menuState == 0 or participantId == 0) and visible)
        firstChoicePortrait.setVisible(visible)
        secondChoicePortrait.setVisible(visible)
        firstChoiceName.setVisible(visible)
        secondChoiceName.setVisible(visible)
        playerOneCard.setVisible(visible)
        playerTwoCard.setVisible(visible)
        playerOneTag.setVisible(visible)
        playerTwoTag.setVisible(visible)
        selectedPortrait.setVisible(visible)
        selectedName.setVisible(visible)
        selectedStatus.setVisible(visible)
        opponentPortrait.setVisible(visible)
        opponentName.setVisible(visible)
        opponentStatus.setVisible(visible)
        confirmArt.setVisible(visible)
        backArt.setVisible(menuState == 1 and visible)
        settingsArt.setVisible(visible)
        confirmLabel.setVisible(visible and (menuState == 0 or participantId == 0))
        backLabel.setVisible(menuState == 1 and visible)
        settingsLabel.setVisible(visible)
        confirmButton.setVisible(visible and (menuState == 0 or participantId == 0))
        backButton.setVisible(menuState == 1 and visible)
        settingsButton.setVisible(visible)
        if not visible
            return

        if menuState == 0
            firstChoicePortrait.setTexture("war3mapImported\\ArcherTile.tga", 0, true)
            secondChoicePortrait.setTexture("war3mapImported\\RiflemanTile.tga", 0, true)
            heading.setText("CHOOSE YOUR FIGHTER")
            subheading.setText("Select a fighter, then confirm. Player 1 chooses the stage.")
            firstChoiceName.setText((choice == 0 ? "|cffffd64a>  |r" : "") + "ARCHER")
            secondChoiceName.setText((choice == 1 ? "|cffffd64a>  |r" : "") + "RIFLEMAN")
            confirmButton.setText("")
            confirmLabel.setText(ready ? "READY  ✓" : "CONFIRM FIGHTER")
            backLabel.setText("BACK")
            settingsLabel.setText("CONTROLS  [F1]")
            playerOneTag.setText("|cffffefcfP1  HUMAN|r")
            playerTwoTag.setText(opponentHuman ? "|cffd9e8ffP2  HUMAN|r" : "|cffd9e8ffCPU|r")
            selectedName.setText((participantId == 0 ? "|cffff5555P1  |r" : "|cff6699ffP2  |r") + characterName(choice))
            selectedStatus.setText(ready ? "|cff8dff9aREADY|r" : "|cffc6cbd4Choose your fighter|r")
            if opponentHuman
                opponentName.setText((participantId == 0 ? "|cff6699ffP2  |r" : "|cffff5555P1  |r") + characterName(opponentChoice))
                opponentStatus.setText(opponentReady ? "|cff8dff9aREADY|r" : "|cffc6cbd4Choosing|r")
            else
                opponentName.setText("|cffc6cbd4BOT  |r" + characterName(opponentChoice))
                opponentStatus.setText("Computer opponent")
            if opponentChoice == 0
                opponentPortrait.setTexture("war3mapImported\\ArcherPortrait.tga", 0, true)
            else
                opponentPortrait.setTexture("war3mapImported\\RiflemanPortrait.tga", 0, true)
            if choice == 0
                selectedPortrait.setTexture("war3mapImported\\ArcherPortrait.tga", 0, true)
            else
                selectedPortrait.setTexture("war3mapImported\\RiflemanPortrait.tga", 0, true)
        else
            heading.setText("CHOOSE A STAGE")
            subheading.setText("Mouse-select a stage, then start the match.")
            firstChoiceName.setText((choice == 0 ? "|cffffd64a>  |r" : "") + "SKY DECK")
            secondChoiceName.setText((choice == 1 ? "|cffffd64a>  |r" : "") + "THREE BRIDGES")
            firstChoicePortrait.setTexture("war3mapImported\\SelectionSkyDeck.tga", 0, true)
            secondChoicePortrait.setTexture("war3mapImported\\SelectionThreeBridges.tga", 0, true)
            selectedName.setText((participantId == 0 ? "|cffff5555P1  |r" : "|cff6699ffP2  |r") + characterName(ownCharacter))
            selectedStatus.setText(choice == 0 ? "One wide platform" : "Three floating platforms")
            opponentName.setText(opponentHuman ? (participantId == 0 ? "|cff6699ffP2  |r" : "|cffff5555P1  |r") + characterName(opponentChoice) : "|cffc6cbd4BOT  |r" + characterName(opponentChoice))
            opponentStatus.setText((participantId == 0 ? characterName(ownCharacter) : characterName(opponentChoice)) + "  vs  " + (participantId == 0 ? characterName(opponentChoice) : characterName(ownCharacter)))
            if ownCharacter == 0
                selectedPortrait.setTexture("war3mapImported\\ArcherPortrait.tga", 0, true)
            else
                selectedPortrait.setTexture("war3mapImported\\RiflemanPortrait.tga", 0, true)
            if opponentChoice == 0
                opponentPortrait.setTexture("war3mapImported\\ArcherPortrait.tga", 0, true)
            else
                opponentPortrait.setTexture("war3mapImported\\RiflemanPortrait.tga", 0, true)
            confirmButton.setText("")
            confirmLabel.setText("START MATCH")
            backLabel.setText("BACK")
            settingsLabel.setText("CONTROLS  [F1]")
            playerOneTag.setText("|cffffefcfP1  HUMAN|r")
            playerTwoTag.setText(opponentHuman ? "|cffd9e8ffP2  HUMAN|r" : "|cffd9e8ffCPU|r")

        BlzFrameSetTextAlignment(firstChoiceName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        BlzFrameSetTextAlignment(secondChoiceName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        BlzFrameSetTextAlignment(selectedName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        BlzFrameSetTextAlignment(opponentName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        BlzFrameSetTextAlignment(selectedStatus, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        BlzFrameSetTextAlignment(opponentStatus, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
