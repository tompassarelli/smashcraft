package SelectionUI
import Wurst
import ClosureFrames
import SelectionDrag

public abstract class SelectionActions
    abstract function selectChoice(int participantId, int choice)
    abstract function selectCpuChoice(int participantId, int choice)
    abstract function openSettings(int participantId)
    abstract function start(int participantId)

SelectionPanel array participantPanels

function onSelectionDrop()
    let slot = GetPlayerId(GetTriggerPlayer())
    if slot >= 0 and slot <= 1
        participantPanels[slot].acceptDrop(BlzGetTriggerSyncData())

function onCpuSelectionDrop()
    if GetTriggerPlayer() == Player(0)
        participantPanels[0].acceptCpuDrop(BlzGetTriggerSyncData())

function characterNameTexture(int choice) returns string
    return choice == 0 ? "war3mapImported\\ArcherName.tga" : "war3mapImported\\RiflemanName.tga"

// Native buttons sit over custom, transparent artwork. Each participant gets
// a complete frame tree on every client; update() reveals only its local tree.
public class SelectionPanel
    framehandle backdrop
    framehandle heading
    framehandle subheading
    framehandle firstTileArt
    framehandle secondTileArt
    framehandle firstChoice
    framehandle secondChoice
    framehandle firstChoicePortrait
    framehandle secondChoicePortrait
    framehandle playerOneChip
    framehandle playerTwoChip
    framehandle firstChoiceName
    framehandle secondChoiceName
    framehandle playerOneCard
    framehandle playerTwoCard
    framehandle playerThreeCard
    framehandle playerFourCard
    framehandle playerThreeTag
    framehandle playerFourTag
    framehandle playerThreeFooter
    framehandle playerFourFooter
    framehandle selectedPortrait
    framehandle selectedName
    framehandle selectedStatus
    framehandle opponentPortrait
    framehandle opponentName
    framehandle opponentStatus
    framehandle playerOneTag
    framehandle playerTwoTag
    framehandle confirmArt
    framehandle settingsArt
    framehandle confirmLabel
    framehandle startButton
    framehandle settingsLabel
    framehandle settingsButton
    SelectionActions actions
    SelectionDrag drag = new SelectionDrag()
    int lastState = -1
    int lastChoice = -1
    int lastOpponentChoice = -1
    int participantId
    boolean lastEnabled = false
    boolean lastReady = false
    boolean lastOpponentReady = false
    boolean lastOpponentHuman = false
    boolean settingsOpen = false

    construct(SelectionActions actions, int participantId)
        this.participantId = participantId
        this.actions = actions
        participantPanels[participantId] = this
        let suffix = I2S(participantId)
        let frameOffset = participantId * 100

