        skyStageArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.068, 0.383)
        skyStageArt.setSize(0.138, 0.079)
        skyStageArt.setEnabled(false)
        bridgesStageArt = createBackdrop("MeleeBridgesStageArt" + suffix, GAME_UI, 439 + frameOffset)
        bridgesStageArt.setTexture("war3mapImported\\SelectionThreeBridges.tga", 0, true)
        bridgesStageArt.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.068, 0.253)
        bridgesStageArt.setSize(0.138, 0.079)
        bridgesStageArt.setEnabled(false)
        skyStageName = createTextFrame("MeleeSkyStageName" + suffix, GAME_UI, 440 + frameOffset)
        skyStageName.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.066, 0.302)
        skyStageName.setSize(0.142, 0.018)
        skyStageName.setEnabled(false)
        BlzFrameSetFont(skyStageName, "Fonts\\FRIZQT__.TTF", 0.009, 0)
        BlzFrameSetTextAlignment(skyStageName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
        bridgesStageName = createTextFrame("MeleeBridgesStageName" + suffix, GAME_UI, 441 + frameOffset)
        bridgesStageName.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.066, 0.172)
        bridgesStageName.setSize(0.142, 0.018)
        bridgesStageName.setEnabled(false)
        BlzFrameSetFont(bridgesStageName, "Fonts\\FRIZQT__.TTF", 0.009, 0)
        BlzFrameSetTextAlignment(bridgesStageName, TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)

        let dropTrigger = CreateTrigger()
        BlzTriggerRegisterPlayerSyncEvent(dropTrigger, Player(participantId), "fighter-drop", false)
        TriggerAddAction(dropTrigger, function onSelectionDrop)

        backdrop.setVisible(false)
        heading.setVisible(false)
        subheading.setVisible(false)
        firstTileArt.setVisible(false)
        secondTileArt.setVisible(false)
        firstChoice.setVisible(false)
        secondChoice.setVisible(false)
        firstChoicePortrait.setVisible(false)
        secondChoicePortrait.setVisible(false)
        playerOneChip.setVisible(false)
        playerTwoChip.setVisible(false)
        firstChoiceName.setVisible(false)
        secondChoiceName.setVisible(false)
        playerOneCard.setVisible(false)
        playerTwoCard.setVisible(false)
        playerOneTag.setVisible(false)
        playerTwoTag.setVisible(false)
        selectedPortrait.setVisible(false)
        selectedName.setVisible(false)
        selectedStatus.setVisible(false)
        opponentPortrait.setVisible(false)
        opponentName.setVisible(false)
        opponentStatus.setVisible(false)
        confirmArt.setVisible(false)
        settingsArt.setVisible(false)
        confirmLabel.setVisible(false)
        settingsLabel.setVisible(false)
        settingsButton.setVisible(false)
        stageHeading.setVisible(false)
        skyStage.setVisible(false)
        bridgesStage.setVisible(false)
        skyStageArt.setVisible(false)
        bridgesStageArt.setVisible(false)
        skyStageName.setVisible(false)
        bridgesStageName.setVisible(false)

    function acceptDrop(string data)
        if lastState == 0 and not settingsOpen and lastEnabled and (data == "0" or data == "1")
            actions.selectChoice(participantId, S2I(data))

    function update(int menuState, int choice, boolean overlayOpen, boolean enabled, boolean ready,
        int opponentChoice, boolean opponentHuman, boolean opponentReady, int stageChoice)
        if GetLocalPlayer() == Player(participantId)
            let width = I2R(BlzGetLocalClientWidth())
            let height = I2R(BlzGetLocalClientHeight())
            if height > 0 and width > 0
                let pointer = getMouseScreenPosition()
                let x = selectionPointerX(pointer.x, width, height)
                let y = selectionPointerY(pointer.y, height)
                let dropped = drag.update(menuState == 0 and enabled and not overlayOpen,
                    MOUSE_BUTTON_TYPE_LEFT.isPressed(), x, y, participantId, choice)
                if dropped >= 0
                    BlzSendSyncData("fighter-drop", I2S(dropped))
                let ownChip = participantId == 0 ? playerOneChip : playerTwoChip
                ownChip.setAbsPoint(FRAMEPOINT_TOPLEFT, drag.active ? x - 0.020 : selectionChipX(participantId, choice), drag.active ? y + 0.020 : 0.366)

        if menuState == lastState and choice == lastChoice and overlayOpen == settingsOpen and enabled == lastEnabled and ready == lastReady and opponentChoice == lastOpponentChoice and opponentHuman == lastOpponentHuman and opponentReady == lastOpponentReady and stageChoice == lastStage
            return
        lastState = menuState
        lastChoice = choice
        settingsOpen = overlayOpen
        lastEnabled = enabled
        lastReady = ready
        lastOpponentChoice = opponentChoice
        lastOpponentHuman = opponentHuman
        lastOpponentReady = opponentReady
        lastStage = stageChoice
        if GetLocalPlayer() != Player(participantId)
            return

        let visible = menuState == 0 and enabled and not settingsOpen
        backdrop.setVisible(visible)
        heading.setVisible(visible)
        subheading.setVisible(visible)
        firstTileArt.setVisible(visible)
        secondTileArt.setVisible(visible)
        firstChoice.setVisible(visible)
        secondChoice.setVisible(visible)
        firstChoicePortrait.setVisible(visible)
        secondChoicePortrait.setVisible(visible)
        playerOneChip.setVisible(visible)
        playerTwoChip.setVisible(visible)
        firstChoiceName.setVisible(visible)
        secondChoiceName.setVisible(visible)
        playerOneCard.setVisible(visible)
        playerTwoCard.setVisible(visible)
        playerOneTag.setVisible(visible)
        playerTwoTag.setVisible(visible)
        selectedPortrait.setVisible(visible)
        selectedName.setVisible(visible)
        selectedStatus.setVisible(visible)
        opponentPortrait.setVisible(visible)
        opponentName.setVisible(visible)
        opponentStatus.setVisible(visible)
        confirmArt.setVisible(visible)
        settingsArt.setVisible(visible)
        confirmLabel.setVisible(visible)
        settingsLabel.setVisible(visible)
        settingsButton.setVisible(visible)
        stageHeading.setVisible(visible)
        skyStageArt.setVisible(visible)
        bridgesStageArt.setVisible(visible)
        skyStageName.setVisible(visible)
        bridgesStageName.setVisible(visible)
        skyStage.setVisible(visible and participantId == 0)
        bridgesStage.setVisible(visible and participantId == 0)
        if not visible
            return

        let opponentChip = participantId == 0 ? playerTwoChip : playerOneChip
        opponentChip.setAbsPoint(FRAMEPOINT_TOPLEFT, selectionChipX(1 - participantId, opponentChoice), 0.366)
        playerTwoChip.setTexture(opponentHuman ? "war3mapImported\\SelectionChipP2.tga" : "war3mapImported\\SelectionChipCPU.tga", 0, true)
        firstChoiceName.setText("ARCHER")
        secondChoiceName.setText("RIFLEMAN")
        heading.setText("CHOOSE YOUR FIGHTER")
        subheading.setText("Drag your chip onto a fighter, or click their portrait. Enter starts when everyone has chosen.")
        let allReady = ready and (not opponentHuman or opponentReady)
        confirmLabel.setText(allReady ? "Start" : "PLACE YOUR CHIP")
        settingsLabel.setText("CONTROLS  [F1]")
        playerOneTag.setText("|cffffefcfP1  HUMAN|r")
        playerTwoTag.setText(opponentHuman ? "|cffd9e8ffP2  HUMAN|r" : "|cffc6cbd4P2  COMPUTER|r")
        selectedName.setText(characterName(choice))
        selectedStatus.setText(ready ? "|cff8dff9aREADY|r" : "|cffc6cbd4Choose your fighter|r")
        opponentName.setText(characterName(opponentChoice))
        opponentStatus.setText(opponentHuman ? (opponentReady ? "|cff8dff9aREADY|r" : "|cffc6cbd4Choosing|r") : "Computer opponent")
        selectedPortrait.setTexture(choice == 0 ? "war3mapImported\\ArcherPortrait.tga" : "war3mapImported\\RiflemanPortrait.tga", 0, true)
        opponentPortrait.setTexture(opponentChoice == 0 ? "war3mapImported\\ArcherPortrait.tga" : "war3mapImported\\RiflemanPortrait.tga", 0, true)
        skyStageName.setText(stageChoice == 0 ? "|cffffd64aSKY DECK|r" : "SKY DECK")
        bridgesStageName.setText(stageChoice == 1 ? "|cffffd64aTHREE BRIDGES|r" : "THREE BRIDGES")
