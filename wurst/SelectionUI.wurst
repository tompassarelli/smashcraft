        bridgesStage = createFrame("ScriptDialogButton", GAME_UI, 0, 437 + frameOffset)
        bridgesStage.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.066, 0.255)
        bridgesStage.setSize(0.142, 0.107)
        bridgesStage.setAlpha(0)
        bridgesStage.onClick(() -> begin
