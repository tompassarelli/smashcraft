package SelectionUI
import Wurst
import ClosureFrames
import SelectionDrag
import MatchRules
import ParticipantInputs

public abstract class SelectionActions
    abstract function selectChoice(int participantId, int choice)
    abstract function selectCpuChoice(int participantId, int cpu, int choice)
    abstract function cycleMode(int actorId, int fighterSlot)
    abstract function recallChoice(int actorId, int chipSlot)
    abstract function openSettings(int participantId)
    abstract function start(int participantId)

SelectionPanel array participantPanels

function onSelectionDrop()
    let slot = GetPlayerId(GetTriggerPlayer())
    if slot >= 0 and slot < INPUT_PARTICIPANT_CAPACITY
        participantPanels[slot].acceptDrop(BlzGetTriggerSyncData(), false)

function onCpuSelectionDrop()
    let slot = GetPlayerId(GetTriggerPlayer())
    if slot >= 0 and slot < INPUT_PARTICIPANT_CAPACITY
        participantPanels[slot].acceptDrop(BlzGetTriggerSyncData(), true)

function onSelectionRecall()
    let slot = GetPlayerId(GetTriggerPlayer())
    if slot >= 0 and slot < INPUT_PARTICIPANT_CAPACITY
        participantPanels[slot].acceptRecall(BlzGetTriggerSyncData())

function characterNameTexture(int choice) returns string
    return choice == 2 ? "war3mapImported\\DemonHunterName.tga" : (choice == 0 ? "war3mapImported\\ArcherName.tga" : "war3mapImported\\RiflemanName.tga")

function characterPortrait(int choice, boolean tile) returns string
    let name = choice == 2 ? "DemonHunter" : (choice == 0 ? "Archer" : "Rifleman")
    return "war3mapImported\\" + name + (tile ? "Tile.tga" : "Portrait.tga")

function selectionArt(framehandle parent, string name, string texture, real x, real y, real width, real height) returns framehandle
    let art = createBackdrop(name, parent, 0)
    art.setTexture(texture, 0, true)
    art.setAbsPoint(FRAMEPOINT_TOPLEFT, x, y)
    art.setSize(width, height)
    art.setEnabled(false)
    return art

function selectionText(framehandle parent, string name, real x, real y, real width, real height, real size) returns framehandle
    let label = createTextFrame(name, parent, 0)
    label.setAbsPoint(FRAMEPOINT_TOPLEFT, x, y)
    label.setSize(width, height)
    label.setFont("Fonts\\FRIZQT__.TTF", size, 0)
    label.setTextAlignment(TEXT_JUSTIFY_MIDDLE, TEXT_JUSTIFY_CENTER)
    label.setEnabled(false)
    return label

// Each client allocates the same frame trees. Only visibility and cursor art
// vary locally; completed choices are checked again by the synchronized owner.
public class SelectionPanel
    framehandle root
    framehandle backdrop
    framehandle confirmLabel
    framehandle array[INPUT_PARTICIPANT_CAPACITY] cards
    framehandle array[INPUT_PARTICIPANT_CAPACITY] portraits
    framehandle array[INPUT_PARTICIPANT_CAPACITY] names
    framehandle array[INPUT_PARTICIPANT_CAPACITY] modeButtons
    framehandle array[INPUT_PARTICIPANT_CAPACITY] tags
    framehandle array[INPUT_PARTICIPANT_CAPACITY] statuses
    framehandle array[INPUT_PARTICIPANT_CAPACITY] chips
    SelectionActions actions
    SelectionDrag drag = new SelectionDrag()
    MatchState game = null
    int participantId
    boolean settingsOpen = false

    construct(SelectionActions actions, int participantId)
        this.participantId = participantId
        this.actions = actions
        participantPanels[participantId] = this
        let suffix = I2S(participantId)
        root = createFrame("FRAME", "MeleeSelectRoot" + suffix, GAME_UI, "", 0)
        backdrop = createBackdrop("MeleeSelectBackdrop" + suffix, CONSOLE_UI, 400 + participantId)
        backdrop.setTexture("war3mapImported\\SelectionBackdrop.tga", 0, false)
        backdrop.setFullscreenReference()
        for choice = 0 to 2
            let x = 0.260 + choice * 0.180
            let name = suffix + "_" + I2S(choice)
            selectionArt(root, "MeleeTile" + name, "war3mapImported\\SelectionTileFrame.tga", x, 0.424, 0.112, 0.132)
            selectionArt(root, "MeleeTilePortrait" + name, characterPortrait(choice, true), x + 0.0125, 0.411, 0.087, 0.087)
            selectionArt(root, "MeleeTileName" + name, characterNameTexture(choice), x + 0.004, 0.316, 0.103, 0.018)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            let x = selectionCardX(slot)
            let name = suffix + "_" + I2S(slot)
            cards[slot] = selectionArt(root, "MeleeCard" + name, "war3mapImported\\SelectionCardGray.tga", x, 0.275, 0.160, 0.200)
            tags[slot] = selectionText(root, "MeleeTag" + name, x + 0.014, 0.267, 0.132, 0.019, 0.010)
            let fighterSlot = slot
            let mode = createFrame("ScriptDialogButton", root, 0, 0)
            mode.setAbsPoint(FRAMEPOINT_TOPLEFT, x + 0.014, 0.270)
            mode.setSize(0.132, 0.027)
            mode.setAlpha(0)
            mode.setLevel(1)
            tags[slot].setLevel(2)
            mode.onClick(() -> begin
                if GetTriggerPlayer() == Player(participantId)
                    actions.cycleMode(participantId, fighterSlot)
            end)
            mode.onClickReleaseFocus()
            modeButtons[slot] = mode
            portraits[slot] = selectionArt(root, "MeleePortrait" + name, characterPortrait(0, false), x + 0.019, 0.245, 0.122, 0.122)
            names[slot] = selectionArt(root, "MeleeName" + name, characterNameTexture(0), x + 0.008, 0.116, 0.144, 0.020)
            statuses[slot] = selectionText(root, "MeleeStatus" + name, x + 0.014, 0.093, 0.132, 0.014, 0.011)
            chips[slot] = selectionArt(root, "MeleeChip" + name, "war3mapImported\\SelectionChipP" + I2S(slot + 1) + ".tga", x + 0.060, 0.200, 0.040, 0.040)
            chips[slot].setLevel(10)
        selectionArt(root, "MeleeConfirmArt" + suffix, "war3mapImported\\SelectionAction.tga", 0.071, 0.043, 0.235, 0.037)
        confirmLabel = selectionText(root, "MeleeConfirmLabel" + suffix, 0.079, 0.039, 0.219, 0.028, 0.011)
        let start = createFrame("ScriptDialogButton", root, 0, 0)
        start.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.071, 0.043)
        start.setSize(0.235, 0.037)
        start.setAlpha(0)
        start.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.start(participantId)
        end)
        start.onClickReleaseFocus()
        selectionArt(root, "MeleeSettingsArt" + suffix, "war3mapImported\\SelectionAction.tga", 0.510, 0.043, 0.235, 0.037)
        let settingsLabel = selectionText(root, "MeleeSettingsLabel" + suffix, 0.518, 0.039, 0.219, 0.028, 0.011)
        settingsLabel.setText("CONTROLS  [F1]")
        let settings = createFrame("ScriptDialogButton", root, 0, 0)
        settings.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.510, 0.043)
        settings.setSize(0.235, 0.037)
        settings.setAlpha(0)
        settings.onClick(() -> begin
            if GetTriggerPlayer() == Player(participantId)
                actions.openSettings(participantId)
        end)
        settings.onClickReleaseFocus()
        let drop = CreateTrigger()
        BlzTriggerRegisterPlayerSyncEvent(drop, Player(participantId), "fighter-drop", false)
        TriggerAddAction(drop, function onSelectionDrop)
        let cpuDrop = CreateTrigger()
        BlzTriggerRegisterPlayerSyncEvent(cpuDrop, Player(participantId), "cpu-fighter-drop", false)
        TriggerAddAction(cpuDrop, function onCpuSelectionDrop)
        let recall = CreateTrigger()
        BlzTriggerRegisterPlayerSyncEvent(recall, Player(participantId), "fighter-recall", false)
        TriggerAddAction(recall, function onSelectionRecall)
        root.setVisible(false)
        backdrop.setVisible(false)

    function acceptDrop(string data, boolean cpu)
        if game == null or game.phase != CHARACTER_MENU or settingsOpen or not game.humanActive(participantId)
            return
        if cpu
            if StringLength(data) == 2
                let cpuSlot = S2I(SubString(data, 0, 1))
                let choice = S2I(SubString(data, 1, 2))
                if data == I2S(cpuSlot) + I2S(choice) and game.canChooseComputer(participantId, cpuSlot) and choice >= 0 and choice <= 2
                    actions.selectCpuChoice(participantId, cpuSlot, choice)
        else if data == "0" or data == "1" or data == "2"
            actions.selectChoice(participantId, S2I(data))

    function acceptRecall(string data)
        if game == null or game.phase != CHARACTER_MENU or settingsOpen or not game.humanActive(participantId)
            return
        if data == "0" or data == "1" or data == "2" or data == "3"
            actions.recallChoice(participantId, S2I(data))

    function placeHovered()
        if GetLocalPlayer() != Player(participantId) or game == null or game.phase != CHARACTER_MENU or settingsOpen or not game.humanActive(participantId)
            return
        let tile = drag.placeHovered()
        if tile >= 0
            sendDrop(tile)

    private function sendDrop(int choice)
        if drag.releasedSlot == participantId and game.humanFighterActive(participantId)
            BlzSendSyncData("fighter-drop", I2S(choice))
        else if game.canChooseComputer(participantId, drag.releasedSlot)
            BlzSendSyncData("cpu-fighter-drop", I2S(drag.releasedSlot) + I2S(choice))

    function recallHeld()
        if GetLocalPlayer() != Player(participantId) or game == null or game.phase != CHARACTER_MENU or settingsOpen or not game.humanActive(participantId)
            return
        let chip = drag.recallHeld()
        if chip >= 0
            BlzSendSyncData("fighter-recall", I2S(chip))

    function update(MatchState state, boolean overlayOpen)
        game = state
        settingsOpen = overlayOpen
        if GetLocalPlayer() != Player(participantId)
            return
        let visible = game.phase == CHARACTER_MENU and game.humanActive(participantId) and not settingsOpen
        root.setVisible(visible)
        backdrop.setVisible(visible)
        if not visible
            drag.update(false, false, 0, 0, participantId)
            return
        if drag.heldSlot < 0
            drag.selectHeldChip(participantId, game.humanFighterActive(participantId))
        var x = 0.
        var y = 0.
        let width = I2R(BlzGetLocalClientWidth())
        let height = I2R(BlzGetLocalClientHeight())
        if width > 0 and height > 0
            let pointer = getMouseScreenPosition()
            x = selectionPointerX(pointer.x, width, height)
            y = selectionPointerY(pointer.y, height)
            drag.selectableMask = 0
            var bit = 1
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                drag.choices[slot] = game.characterFor(slot)
                drag.ready[slot] = game.characterReady(slot)
                if (slot == participantId and game.humanFighterActive(slot)) or game.canChooseComputer(participantId, slot)
                    drag.selectableMask += bit
                bit *= 2
            if not participantIsActive(drag.selectableMask, drag.heldSlot)
                drag.heldSlot = -1
            if not participantIsActive(drag.selectableMask, drag.activeSlot)
                drag.active = false
                drag.activeSlot = -1
            let dropped = drag.update(true, MOUSE_BUTTON_TYPE_LEFT.isPressed(), x, y, participantId)
            if dropped >= 0
                sendDrop(dropped)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            let active = game.fighterActive(slot)
            let ready = game.characterReady(slot)
            let color = slot == 0 ? "Red" : (slot == 1 ? "Blue" : (slot == 2 ? "Yellow" : "Green"))
            cards[slot].setTexture("war3mapImported\\SelectionCard" + (active ? color : "Gray") + ".tga", 0, true)
            tags[slot].setText(active ? (game.humanFighterActive(slot) ? "HMN" : "CPU") : "EMPTY")
            modeButtons[slot].setEnabled(game.canCycleSlotMode(participantId, slot))
            portraits[slot].setVisible(active and ready)
            names[slot].setVisible(active and ready)
            statuses[slot].setText(game.humanFighterActive(slot) and not game.humanPresent(slot) ? "No player" : (active and not ready ? "Choose fighter" : "P" + I2S(slot + 1)))
            if ready
                portraits[slot].setTexture(characterPortrait(game.characterFor(slot), false), 0, true)
                names[slot].setTexture(characterNameTexture(game.characterFor(slot)), 0, true)
            chips[slot].setVisible(active)
            chips[slot].setTexture("war3mapImported\\SelectionChip" + (game.humanFighterActive(slot) ? "P" + I2S(slot + 1) : "CPU") + ".tga", 0, true)
            let held = (drag.active and drag.activeSlot == slot) or (not ready and drag.heldSlot == slot and drag.hoverTile >= 0)
            chips[slot].setAbsPoint(FRAMEPOINT_TOPLEFT, held ? x - 0.020 : (ready ? selectionChipX(slot, game.characterFor(slot)) : selectionCardX(slot) + 0.060), held ? y + 0.020 : (ready ? selectionChipY(slot) : 0.200))
        confirmLabel.setText(game.hasUnassignedHuman() ? "Choose CPU or EMPTY" : (game.allCharactersReady() ? "Start [Y]" : (game.fighterMask() == 0 ? "Add a fighter" : "Place your chip")))
