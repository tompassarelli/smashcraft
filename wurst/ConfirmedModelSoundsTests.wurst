package ConfirmedModelSoundsTests
import Wurst
import ConfirmedModelSounds
import FighterOriginalClipInfo
import FighterPose
import Simulation
import MatchRules
import MatchStep
import ReplayHistory
import ParticipantInputs

class SoundRecording extends ModelSoundSink
    int count = 0
    int array[INPUT_PARTICIPANT_CAPACITY] perSlot
    string events = ""
    modelSoundEvent last

    override function emit(modelSoundEvent occurrence, real x, real z)
        count++
        perSlot[occurrence.slot]++
        last = occurrence
        events += I2S(occurrence.epoch) + ":" + I2S(occurrence.frame) + ":" + I2S(occurrence.slot) + ":" + I2S(occurrence.selectionSerial) + ":" + I2S(occurrence.ordinal) + ":" + I2S(occurrence.loopIndex) + ";"

@Test function soundCrossingsKeepStartEndAndLoopBoundary()
    modelSoundCrossed(-1., 0., 0., 1., false, 0).assertTrue()
    modelSoundCrossed(0., 0., 0., 1., false, 0).assertFalse()
    modelSoundCrossed(0.9, 1., 1., 1., false, 0).assertTrue()
    modelSoundCrossed(1., 2., 1., 1., false, 0).assertFalse()
    modelSoundCrossed(0.9, 1., 1., 1., true, 0).assertTrue()
    modelSoundCrossed(0.9, 1., 0., 1., true, 1).assertTrue()
    modelSoundCrossed(1., 1.1, 0., 1., true, 1).assertFalse()
    modelSoundCrossed(0., 10., 0.2, 1., false, 1).assertFalse()

@Test function soundOriginalLoopCrossingsHaveNoDroppingCap()
    let record = new SoundRecording()
    let clip = originalClip(2, 108)
    clip.looping.assertTrue()
    let duration = clip.endSeconds - clip.startSeconds
    emitModelSoundInterval(record, 4, 8, 3, 2, 7, 108, -1., duration * 300., 0., 0.)
    record.count.assertEquals(600)
    record.last.loopIndex.assertEquals(299)
    record.last.ordinal.assertEquals(9)
    record.last.slot.assertEquals(3)
    record.last.selectionSerial.assertEquals(7)
    record.last.epoch.assertEquals(4)
    record.last.frame.assertEquals(8)

@Test function soundConfirmedSelectionStartAndIntentionalRepeat()
    let sounds = new ConfirmedModelSounds()
    let record = new SoundRecording()
    let fighter = new FighterState(2, 0, 1)
    let pose = new FighterPose()
    pose.selectIndex(6)
    sounds.beginEpoch(2).assertTrue()
    sounds.confirm(2, 0, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
    sounds.confirm(2, 0, 3, fighter, pose, record).assertFalse()
    record.count.assertEquals(1)
    pose.selectIndex(6)
    sounds.confirm(2, 1, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(2)
    record.last.selectionSerial.assertEquals(2)
    sounds.confirm(2, 3, 3, fighter, pose, record).assertFalse()
    sounds.confirm(2, 2, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(2)
    sounds.beginEpoch(2).assertFalse()
    sounds.beginEpoch(3).assertTrue()
    sounds.confirm(2, 3, 3, fighter, pose, record).assertFalse()
    sounds.confirm(3, 0, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(3)
    record.last.epoch.assertEquals(3)

@Test function soundInterruptedPreviousIntervalAndFrozenRate()
    let sounds = new ConfirmedModelSounds()
    let record = new SoundRecording()
    let fighter = new FighterState(1, 0, 1)
    let pose = new FighterPose()
    pose.selectIndex(5)
    pose.clipTime = 0.16
    pose.rate = 1.
    sounds.beginEpoch(6).assertTrue()
    sounds.confirm(6, 0, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(0)
    pose.selectName("stand")
    pose.rate = 0.
    sounds.confirm(6, 1, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
    record.last.selectionSerial.assertEquals(1)
    record.last.ordinal.assertEquals(0)
    pose.selectIndex(5)
    pose.clipTime = 0.16
    sounds.confirm(6, 2, 0, fighter, pose, record).assertTrue()
    sounds.confirm(6, 3, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
    pose.selectName("stand")
    sounds.confirm(6, 4, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)

@Test function soundSparseFourSlotsAndCatchupMatchSequential()
    for maskIndex = 0 to 1
        let mask = maskIndex == 0 ? 9 : 15
        let world = new FighterRoster(mask)
        let runtime = new ReplayRuntimeState()
        let sequential = new ConfirmedModelSounds()
        let catchup = new ConfirmedModelSounds()
        let a = new SoundRecording()
        let b = new SoundRecording()
        sequential.beginEpoch(7).assertTrue()
        catchup.beginEpoch(7).assertTrue()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                world.fighters[slot] = new FighterState(2, slot * 100., 1)
                runtime.poses[slot].selectName("walk alternate")
                sequential.confirm(7, 0, slot, world.fighters[slot], runtime.poses[slot], a).assertTrue()
                catchup.confirm(7, 0, slot, world.fighters[slot], runtime.poses[slot], b).assertTrue()
        // Six confirmed rows serviced by one callback must all reach the cursor.
        for frame = 1 to 6
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if world.active(slot)
                    let pose = runtime.poses[slot]
                    pose.clipTime = frame * 0.2
                    sequential.confirm(7, frame, slot, world.fighters[slot], pose, a).assertTrue()
        for frame = 1 to 6
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if world.active(slot)
                    let pose = runtime.poses[slot]
                    pose.clipTime = frame * 0.2
                    catchup.confirm(7, frame, slot, world.fighters[slot], pose, b).assertTrue()
                    catchup.confirm(7, frame, slot, world.fighters[slot], pose, b).assertFalse()
        a.events.assertEquals(b.events)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            a.perSlot[slot].assertEquals(world.active(slot) ? 3 : 0)

@Test function soundOutSelectionPlaysOnceAndHiddenLoopDoesNotContinue()
    let sounds = new ConfirmedModelSounds()
    let record = new SoundRecording()
    let fighter = new FighterState(2, 0, 1)
    let pose = new FighterPose()
    pose.selectIndex(108)
    sounds.beginEpoch(9).assertTrue()
    sounds.confirm(9, 0, 0, fighter, pose, record).assertTrue()
    fighter.out = true
    pose.selectIndex(18)
    sounds.confirm(9, 1, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
    pose.clipTime = 3.
    sounds.confirm(9, 2, 0, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)

@Test function soundActualNumericalRollbackNeverDispatches()
    let world = new FighterRoster(9)
    let game = new MatchState()
    game.setHumanMask(9)
    game.phase = MATCH
    game.timeLimitMinutes = 0
    let inputs = new FrameInputs()
    let runtime = new ReplayRuntimeState()
    let history = new ReplayHistory()
    let row = new MatchFrameInput()
    let sounds = new ConfirmedModelSounds()
    let record = new SoundRecording()
    sounds.beginEpoch(11).assertTrue()
    history.beginEpochWithCorrections(11, 1, 12).assertTrue()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot)
            world.fighters[slot] = new FighterState(1, -200. + slot * 150., 1)
            // Freeze gameplay while retaining an authored clip clock about to
            // cross a real rifle cue on the first completed frame.
            world.fighters[slot].frozenFrames = 60
            runtime.poses[slot].selectIndex(5)
            runtime.poses[slot].clipTime = 0.16
            sounds.confirm(11, 0, slot, world.fighters[slot], runtime.poses[slot], record).assertTrue()
    for frame = 1 to 4
        row.capture(frame, 9, inputs, runtime).assertTrue()
        history.saveSpeculative(11, row, world, game, inputs, runtime).assertTrue()
        row.execute(game, world, inputs, runtime, frame).assertTrue()
    record.count.assertEquals(0)
    let replacement = new FrameInputs()
    replacement.inputs[3].direction = -1
    row.capture(1, 9, replacement, runtime).assertTrue()
    let corrections = new ReplayCorrections()
    corrections.beginEpoch(11).assertTrue()
    corrections.add(row).assertTrue()
    history.correct(11, corrections, world, game, inputs, runtime).assertEquals(1)
    record.count.assertEquals(0)
    history.replay(11, 1, 4, world, game, inputs, runtime).assertTrue()
    record.count.assertEquals(0)
    // The confirmed copy consumes each saved completed frame once.
    for frame = 1 to 4
        history.replay(11, frame, frame, world, game, inputs, runtime).assertTrue()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                sounds.confirm(11, frame, slot, world.fighters[slot], runtime.poses[slot], record).assertTrue()
                sounds.confirm(11, frame, slot, world.fighters[slot], runtime.poses[slot], record).assertFalse()
    record.count.assertEquals(2)
    history.replay(11, 1, 4, world, game, inputs, runtime).assertTrue()
    record.count.assertEquals(2)

@Test function soundHiddenUnchangedSelectionStopsButNewOutClipKeepsDelayedCues()
    let sounds = new ConfirmedModelSounds()
    let record = new SoundRecording()
    let fighter = new FighterState(2, 0, 1)
    let pose = new FighterPose()
    pose.selectIndex(108)
    sounds.beginEpoch(12).assertTrue()
    sounds.confirm(12, 0, 3, fighter, pose, record).assertTrue()
    fighter.out = true
    pose.clipTime = 0.05
    sounds.confirm(12, 1, 3, fighter, pose, record).assertTrue()
    pose.clipTime = 2.
    sounds.confirm(12, 2, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(0)
    // Use a real delayed source cue to prove that the rule is about a new
    // selection while hidden, not a special case for death-at-zero metadata.
    fighter.character = 1
    pose.selectIndex(5)
    sounds.confirm(12, 3, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(0)
    pose.clipTime = 0.2
    sounds.confirm(12, 4, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
    pose.clipTime = 2.
    sounds.confirm(12, 5, 3, fighter, pose, record).assertTrue()
    record.count.assertEquals(1)
