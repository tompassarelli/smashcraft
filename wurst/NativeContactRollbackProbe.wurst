package NativeContactRollbackProbe
import Wurst
import ClosureFrames
import FrameTaggedRecord
import WorldTestSupport
import ShadowInputSchedule
import ShadowInputPlayback
import ReplayHistory
import ReplayState
import MatchRules
import Simulation
import CommandBuffer
import NetworkInput
import KeyBindings
import InputProtocol
import MatchStep
import ParticipantInputs

constant int EPOCH = 9910
constant int REMOTE_SLOT = 1
constant int LOCAL_SLOT = 0
constant int CONTACT_FRAME = 5
constant string SYNC_PREFIX = "CR10"
constant int ROW_COUNT = 8

class ContactProbeWorld
	FighterState first = new FighterState(0, 0, 1)
	FighterState second = new FighterState(1, 100, -1)
	MatchState game = new MatchState()
	AttackBuffer firstCommands = new AttackBuffer(4)
	AttackBuffer secondCommands = new AttackBuffer(4)
	ReplayRuntimeState runtime = new ReplayRuntimeState()
	ReplaySnapshot snapshot = new ReplaySnapshot()

	construct()
		game.setHumanCount(2)
		game.phase = MATCH
		game.timeLimitMinutes = 0
		game.stockCount = 99
		first.stocks = 99
		second.stocks = 99

	function capture()
		snapshot.capture(testWorld(first, second), game,
			testCommands(firstCommands, secondCommands), runtime)

framehandle inputBox
framehandle statusLine
timer nativeClock
timer pollTimer
boolean recording = false
boolean started = false
boolean finished = false
string previousText = ""
string array[8] receivedWire
int array[9] actionByFrame
string array[9] wireByFrame
string array[9] receiptGameMsByFrame
int receivedCount = 0
int sendCount = 0
int invalidCount = 0
int localPollCount = 0
int scanOffset = 0
TaggedEvent candidate
EventLedger receivedLedger
ContactProbeWorld canonical
ContactProbeWorld speculative
ContactProbeWorld confirmed
ContactProbeWorld shifted
ShadowInputSchedule schedule
ShadowInputPlayback playback
ReplayHistory correctionHistory
ReplayHistory confirmedHistory
ParticipantInputs networkRows
MatchFrameInput stepRow
InputPacket packet
NetworkInput row
NetworkInput pending
int reconciliationFrame = -1
real transientDamage = 0.
string transientChecksum = ""
string correctedVsCanonicalAtF8 = ""
string correctedVsConfirmedAtF8 = ""
string canonicalFullAtF8 = ""
string correctedFullAtF8 = ""
string confirmedFullAtF8 = ""
string canonicalChecksumAtF8 = ""
string correctedChecksumAtF8 = ""
string confirmedChecksumAtF8 = ""

function gameMs() returns string
	return R2S(TimerGetElapsed(nativeClock) * 1000.)

function contactRow(int frame, int slot, boolean held, boolean wasHeld, NetworkInput destination)
	var heldMask = 0
	var pressedMask = 0
	var releasedMask = 0
	var triggerAmount = 0
	if slot == LOCAL_SLOT and frame == 1
		pressedMask = inputActionBit(ATTACK)
	if slot == REMOTE_SLOT
		if held
			heldMask = inputActionBit(LEFT_TRIGGER)
			triggerAmount = 255
			if not wasHeld
				pressedMask = inputActionBit(LEFT_TRIGGER)
		else if wasHeld
			releasedMask = inputActionBit(LEFT_TRIGGER)
	destination.assign(heldMask, pressedMask, releasedMask, 0, 0, triggerAmount, 0)
	destination.assignPressData(0, 0, 0, 0, false, 0, 0, 0)
	destination.assignThrowContributions(0, 0)

function advanceDirect(ContactProbeWorld fight, int frame, boolean remoteHeld,
		boolean remoteWasHeld, ParticipantInputs rows)
	let first = rows.row(LOCAL_SLOT)
	let second = rows.row(REMOTE_SLOT)
	contactRow(frame, LOCAL_SLOT, false, false, first)
	contactRow(frame, REMOTE_SLOT, remoteHeld, remoteWasHeld, second)
	first.copyTo(rows.row(LOCAL_SLOT))
	second.copyTo(rows.row(REMOTE_SLOT))
	stepRow.captureNetworkInputs(frame, rows, testWorld(fight.first, fight.second), 3)
	stepRow.execute(fight.game, testWorld(fight.first, fight.second),
		testCommands(fight.firstCommands, fight.secondCommands), fight.runtime, frame)
	stepRow.reset()

function beginSpeculative()
	canonical = new ContactProbeWorld()
	speculative = new ContactProbeWorld()
	confirmed = new ContactProbeWorld()
	shifted = new ContactProbeWorld()
	schedule = new ShadowInputSchedule()
	playback = new ShadowInputPlayback()
	correctionHistory = new ReplayHistory()
	confirmedHistory = new ReplayHistory()
	networkRows = new ParticipantInputs()
	stepRow = new MatchFrameInput()
	packet = new InputPacket()
	row = new NetworkInput()
	pending = new NetworkInput()
	schedule.beginEpoch(EPOCH, 0, 24, 3)
	playback.beginEpoch(EPOCH)
	correctionHistory.beginEpochWithCorrections(EPOCH, 1, 24)
	confirmedHistory.beginEpoch(EPOCH, 1)
	for frame = 1 to 8
		contactRow(frame, LOCAL_SLOT, false, false, row)
		schedule.captureLocal(EPOCH, row)
		playback.advanceSpeculative(schedule, EPOCH, LOCAL_SLOT, speculative.game,
			testWorld(speculative.first, speculative.second),
			testCommands(speculative.firstCommands, speculative.secondCommands),
			speculative.runtime, correctionHistory)
	transientDamage = speculative.second.damage
	speculative.capture()
	transientChecksum = speculative.snapshot.checksum()
	started = true
	statusLine.setText("F1-F8 speculative combat complete. On Player 2 enter the eight tagged rows. F5 shield will reconcile at F9.")

function writeResult()
	finished = true
	PreloadGenClear()
	PreloadGenStart()
	Preload("NATIVE_CONTACT_ROLLBACK v=1 candidate=0.0.10 epoch=" + I2S(EPOCH) + " local_slot=" + I2S(GetPlayerId(GetLocalPlayer())))
	Preload("scope=scripted production-simulation; no physical input or visible fighter-response acceptance")
	Preload("application=after speculative F8; delivery phase F9; network receive times are observer-local Warcraft timer ms")
	Preload("counts rows=" + I2S(receivedCount) + " invalid=" + I2S(invalidCount) + " native_poll_reads=" + I2S(localPollCount) + " native_sends=" + I2S(sendCount))
	Preload("transient_after_F8 damage=" + R2S(transientDamage) + " checksum=" + transientChecksum)
	Preload("correction earliest_frame=" + I2S(reconciliationFrame) + " known_through=" + I2S(schedule.knownThrough()) + " corrected_damage=" + R2S(speculative.second.damage) + " shield_stun=" + I2S(speculative.second.shieldStun) + " checksum_F8=" + correctedChecksumAtF8)
	Preload("canonical damage_F8=" + R2S(canonical.second.damage) + " checksum_F8=" + canonicalChecksumAtF8)
	Preload("confirmed damage_F8=" + R2S(confirmed.second.damage) + " checksum_F8=" + confirmedChecksumAtF8)
	Preload("corrected_vs_canonical_at_F8=" + correctedVsCanonicalAtF8)
	Preload("corrected_vs_confirmed_at_F8=" + correctedVsConfirmedAtF8)
	Preload("canonical_full_F8=" + canonicalFullAtF8)
	Preload("corrected_full_F8=" + correctedFullAtF8)
	Preload("confirmed_full_F8=" + confirmedFullAtF8)
	Preload("F9_original_remote_row_matches=" + (row.sameAs(pending) ? "1" : "0"))
	Preload("shifted_F9 shield_damage=" + R2S(shifted.second.damage) + " checksum=" + shifted.snapshot.checksum())
	Preload("shifted_vs_F5_canonical=" + canonical.snapshot.firstDifference(shifted.snapshot))
	Preload("FRAME_TAGS id elapsed_us intended_frame shield_held receipt_game_ms accepted_frame")
	for frame = 1 to 8
		Preload("REMOTE " + wireByFrame[frame] + " receive_game_ms=" + receiptGameMsByFrame[frame] + " accepted_frame=" + I2S(frame))
	PreloadGenEnd("smashcraft-contact-rollback-20261004-p" + I2S(GetPlayerId(GetLocalPlayer())) + ".txt")
	statusLine.setText("CONTACT ROLLBACK COMPLETE. Exported this observer's native receipt.")

function finishDelivery()
	if finished or not started or receivedCount != ROW_COUNT
		return
	// All original frame identities and held states are now present. Derive edges
	// from adjacent original rows before inserting any row, independent of the
	// network callback order.
	for offset = 0 to 7
		let frame = 8 - offset
		let held = actionByFrame[frame] == 1
		let wasHeld = frame > 1 and actionByFrame[frame - 1] == 1
		contactRow(frame, REMOTE_SLOT, held, wasHeld, row)
		packet.assign(EPOCH, frame, 1, row, row)
		schedule.acceptSynchronized(REMOTE_SLOT, packet)
	for frame = 1 to 8
		contactRow(frame, LOCAL_SLOT, false, false, pending)
		packet.assign(EPOCH, frame, 1, pending, pending)
		schedule.acceptSynchronized(LOCAL_SLOT, packet)
	let earliest = playback.reconcile(schedule, EPOCH, LOCAL_SLOT,
		testWorld(speculative.first, speculative.second), speculative.game,
		testCommands(speculative.firstCommands, speculative.secondCommands),
		speculative.runtime, correctionHistory)
	reconciliationFrame = earliest
	for frame = 1 to 8
		let held = actionByFrame[frame] == 1
		let wasHeld = frame > 1 and actionByFrame[frame - 1] == 1
		advanceDirect(canonical, frame, held, wasHeld, networkRows)
		let shiftedHeld = frame >= 9 and frame <= 10
		let shiftedWasHeld = frame == 10
		advanceDirect(shifted, frame, shiftedHeld, shiftedWasHeld, networkRows)
	while schedule.mayAdvanceConfirmed()
		playback.advanceConfirmed(schedule, EPOCH, confirmed.game,
			testWorld(confirmed.first, confirmed.second),
			testCommands(confirmed.firstCommands, confirmed.secondCommands),
			confirmed.runtime, confirmedHistory)
	canonical.capture()
	speculative.capture()
	confirmed.capture()
	correctedVsCanonicalAtF8 = speculative.snapshot.firstDifference(canonical.snapshot)
	correctedVsConfirmedAtF8 = speculative.snapshot.firstDifference(confirmed.snapshot)
	canonicalFullAtF8 = canonical.snapshot.canonicalState()
	correctedFullAtF8 = speculative.snapshot.canonicalState()
	confirmedFullAtF8 = confirmed.snapshot.canonicalState()
	canonicalChecksumAtF8 = canonical.snapshot.checksum()
	correctedChecksumAtF8 = speculative.snapshot.checksum()
	confirmedChecksumAtF8 = confirmed.snapshot.checksum()
	row = new NetworkInput()
	contactRow(CONTACT_FRAME, REMOTE_SLOT, actionByFrame[CONTACT_FRAME] == 1, false, row)
	correctionHistory.copyInputRow(EPOCH, CONTACT_FRAME, stepRow)
	stepRow.copyNetworkRow(REMOTE_SLOT, pending)
	for frame = 9 to 12
		advanceDirect(canonical, frame, false, false, networkRows)
		let held = frame >= 9 and frame <= 10
		let wasHeld = frame == 10 or frame == 11
		advanceDirect(shifted, frame, held, wasHeld, networkRows)
	canonical.capture()
	shifted.capture()
	writeResult()

function receiveContactRow()
	if finished or not started or GetPlayerId(GetTriggerPlayer()) != REMOTE_SLOT
		return
	let wire = BlzGetTriggerSyncData()
	if candidate == null or not candidate.decode(wire)
		invalidCount++
		return
	if candidate.frame() < 1 or candidate.frame() > ROW_COUNT or receivedCount >= ROW_COUNT
		invalidCount++
		return
	if receivedLedger.observe(wire) != RECORD_ADDED
		invalidCount++
		return
	let frame = candidate.frame()
	if wireByFrame[frame] != ""
		invalidCount++
		return
	wireByFrame[frame] = wire
	receiptGameMsByFrame[frame] = gameMs()
	actionByFrame[frame] = candidate.state()
	receivedWire[receivedCount] = wire + " receive_game_ms=" + gameMs()
	receivedCount++
	if receivedCount == ROW_COUNT
		finishDelivery()

function pollExternalRows()
	if not recording or GetLocalPlayer() != Player(REMOTE_SLOT)
		return
	localPollCount++
	let text = inputBox.getText()
	if text.length() < previousText.length() or (previousText.length() > 0 and text.substring(0, previousText.length()) != previousText)
		recording = false
		invalidCount++
		statusLine.setText("Input must stay append-only. Restart the map for another trial.")
		return
	previousText = text
	while true
		let delimiterPos = text.indexOf(";", scanOffset)
		if delimiterPos < 0
			return
		let wire = text.substring(scanOffset, delimiterPos + 1)
		scanOffset = delimiterPos + 1
		if not candidate.decode(wire) or candidate.frame() < 1 or candidate.frame() > ROW_COUNT
			invalidCount++
			return
		if GetLocalPlayer().sendSyncData(SYNC_PREFIX, wire)
			sendCount++
		else
			invalidCount++
		statusLine.setText("Player 2 rows synchronized: " + I2S(sendCount) + "/8")

function startOnHost()
	if GetTriggerPlayer() == Player(LOCAL_SLOT)
		if started
			return
		beginSpeculative()

function setup()
	DestroyTimer(GetExpiredTimer())
	candidate = new TaggedEvent()
	receivedLedger = new EventLedger()
	nativeClock = CreateTimer()
	TimerStart(nativeClock, 3600., false, null)
	inputBox = createFrame("EDITBOX", "NativeContactCorpus", GAME_UI, "EscMenuEditBoxTemplate", 909)
	inputBox.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.04, 0.55)
	inputBox.setSize(0.82, 0.06)
	inputBox.setTextSizeLimit(230)
	let info = createTextFrame("NativeContactInfo", GAME_UI, 910)
	info.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.04, 0.64)
	info.setSize(0.92, 0.14)
	info.setText("NATIVE CONTACT ROLLBACK PROBE 0.0.10 | HOST: -start, then PLAYER 2 enters eight V1 tagged rows below after F8. Each row: id, elapsed_us, intended F, shield held. No wall-clock alignment is claimed.")
	statusLine = createTextFrame("NativeContactStatus", GAME_UI, 911)
	statusLine.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.04, 0.49)
	statusLine.setSize(0.92, 0.05)
	statusLine.setText("Ready. Wait for both clients to load, then host sends -start.")
	inputBox.setFocus(GetLocalPlayer(), GetLocalPlayer() == Player(REMOTE_SLOT))
	let sync = CreateTrigger()
	BlzTriggerRegisterPlayerSyncEvent(sync, Player(REMOTE_SLOT), SYNC_PREFIX, false)
	TriggerAddAction(sync, function receiveContactRow)
	let chat = CreateTrigger()
	TriggerRegisterPlayerChatEvent(chat, Player(LOCAL_SLOT), "-start", false)
	TriggerAddAction(chat, function startOnHost)
	pollTimer = CreateTimer()
	recording = true
	TimerStart(pollTimer, 1. / 60., true, function pollExternalRows)
	PreloadGenClear()
	PreloadGenStart()
	Preload("NATIVE_CONTACT_READY v=1 candidate=0.0.10 slot=" + I2S(GetPlayerId(GetLocalPlayer())))
	Preload("start=-start; speculative F1-F8; P2 then append eight exact V1 rows in editbox; remote tags accepted; replay from original F5")
	Preload("INPUT_PATH=editbox timer poll then BlzSendSyncData CR10; complete input occurs after F8; no native input-to-frame derivation")
	PreloadGenEnd("smashcraft-contact-rollback-20261004-p" + I2S(GetPlayerId(GetLocalPlayer())) + "-ready.txt")

init
	TimerStart(CreateTimer(), 0., false, function setup)
