	advance(fighter, 0, input, -240)
	fighter.hitstun.assertEquals(0)
	SquareRoot(fighter.knockbackX * fighter.knockbackX + fighter.knockbackZ * fighter.knockbackZ).assertEquals(99.694, 0.001)
	(fighter.knockbackX / fighter.knockbackZ).assertEquals(0.75, 0.001)
	let xAtStunEnd = fighter.x
	advance(fighter, 0, input, -240)
	(fighter.x > xAtStunEnd).assertTrue()
