	blasterCommands.enqueue(1, 0, 1)
	opponentCommands.enqueue(1, 0, 1)
	for frame = 1 to attackStartupFrames(1) + 1
		stepMatch(game, blaster, opponent, blasterInput, opponentInput, blasterCommands, opponentCommands, frame)
	blaster.damage.assertEquals(3.)
