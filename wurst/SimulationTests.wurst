@Test function spotDodgeStartsAtFrameOneStaysInPlaceAndUsesProvisionalIntangibility()
	let fighter = new FighterState(0, 0, 1)
	fighter.surface = 0
	let input = new InputSnapshot()
	input.shield = true
	input.groundDodgePressed = true
	input.groundDodgeDirection = 0
	advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(1)
	isGroundDodging(fighter).assertTrue()
	isIntangible(fighter).assertFalse()
	fighter.x.assertEquals(0.)
	input.groundDodgePressed = false
	for frame = 2 to SPOT_DODGE_INTANGIBLE_START
		advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(SPOT_DODGE_INTANGIBLE_START)
	isIntangible(fighter).assertTrue()
	for frame = SPOT_DODGE_INTANGIBLE_START + 1 to SPOT_DODGE_INTANGIBLE_END
		advance(fighter, 0, input, -240)
	isIntangible(fighter).assertTrue()
	advance(fighter, 0, input, -240)
	isIntangible(fighter).assertFalse()
	for frame = SPOT_DODGE_INTANGIBLE_END + 2 to SPOT_DODGE_FRAMES
		advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(SPOT_DODGE_FRAMES)
	fighter.x.assertEquals(0.)
	canAttack(fighter).assertFalse()
	input.jumpPressed = true
	let jumpsBefore = fighter.jumps
	advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(0)
	fighter.jumps.assertEquals(jumpsBefore)

@Test function rollHasBoundedLockedMotionAndForwardRollTurnsAtRecoveryEnd()
	let fighter = new FighterState(0, 0, 1)
	fighter.surface = 0
	let input = new InputSnapshot()
	input.shield = true
	input.groundDodgePressed = true
	input.groundDodgeDirection = 1
	input.direction = -1
	advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(1)
	fighter.facing.assertEquals(1)
	input.groundDodgePressed = false
	advance(fighter, 0, input, -240)
	advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(GROUND_ROLL_INTANGIBLE_START - 1)
	isIntangible(fighter).assertFalse()
	advance(fighter, 0, input, -240)
	isIntangible(fighter).assertTrue()
	for frame = GROUND_ROLL_INTANGIBLE_START + 1 to GROUND_ROLL_FRAMES
		advance(fighter, 0, input, -240)
	fighter.x.assertEquals(128.)
	fighter.facing.assertEquals(1)
	fighter.grounded.assertTrue()
	fighter.groundDodgeFrame.assertEquals(GROUND_ROLL_FRAMES)
	canAttack(fighter).assertFalse()
	input.jumpPressed = true
	let jumpsBefore = fighter.jumps
	advance(fighter, 0, input, -240)
	fighter.groundDodgeFrame.assertEquals(0)
	fighter.facing.assertEquals(-1)
	fighter.jumps.assertEquals(jumpsBefore)

