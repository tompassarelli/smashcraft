	let targetCommands = new AttackBuffer(0)
	attackerCommands.enqueue(0, 0, 1, false)
	stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, 1)
	target.damage.assertEquals(0.)
	attacker.attackSerial.assertEquals(1)
	(attackPhase(attacker) == ATTACK_STARTUP).assertTrue()
	for tick = 2 to attackStartupFrames(0) + 1
		stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, tick)
	target.damage.assertEquals(12.)
	target.vx.assertEquals(0.)
	target.vz.assertEquals(0.)
	target.knockbackX.assertEquals(6.5085, 0.01)
	target.knockbackZ.assertEquals(6.5085, 0.01)
	totalVelocityX(target).assertEquals(target.knockbackX)
	totalVelocityZ(target).assertEquals(target.knockbackZ)
	target.hitstun.assertEquals(20)
	target.hitlag.assertEquals(7)
	target.diPending.assertTrue()
	target.diLaunchSpeed.assertGreaterThan(0.)
	attacker.hitlag.assertEquals(7)
	var frame = attackStartupFrames(0) + 2
	while attacker.hitlag > 0
		stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, frame)
		frame++
	target.x = 100
	target.z = 0
	target.vx = 0
	target.vz = 0
	target.knockbackX = 0
	target.knockbackZ = 0
	target.hitstun = 0
	let damageAfterContact = target.damage
	stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, frame)
	target.damage.assertEquals(damageAfterContact)

@Test function shieldConsumesEnergyInsteadOfGivingHitDamage()
