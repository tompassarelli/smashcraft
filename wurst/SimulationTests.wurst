@Test function simultaneousEligibleAttacksTradeInEitherOrder()
	let gameA = testMatch()
	let leftA = new FighterState(0, 0, 1)
	let rightA = new FighterState(1, 100, -1)
	let leftInputA = new InputSnapshot()
	let rightInputA = new InputSnapshot()
	let leftCommandsA = new AttackBuffer(0)
	let rightCommandsA = new AttackBuffer(0)
	leftCommandsA.enqueue(1, 0, 1, false)
	rightCommandsA.enqueue(1, 0, 1, false)
	for frame = 1 to attackStartupFrames(1) + 1
		stepMatch(gameA, leftA, rightA, leftInputA, rightInputA, leftCommandsA, rightCommandsA, frame)
	leftA.cooldown.assertEquals(22)
	rightA.cooldown.assertEquals(22)
	for frame = attackStartupFrames(1) + 2 to 40
		stepMatch(gameA, leftA, rightA, leftInputA, rightInputA, leftCommandsA, rightCommandsA, frame)
	leftA.damage.assertEquals(3.)
	rightA.damage.assertEquals(3.)
	let gameB = testMatch()
	let leftB = new FighterState(0, 0, 1)
	let rightB = new FighterState(1, 100, -1)
	let leftInputB = new InputSnapshot()
	let rightInputB = new InputSnapshot()
	let leftCommandsB = new AttackBuffer(0)
	let rightCommandsB = new AttackBuffer(0)
	leftCommandsB.enqueue(1, 0, 1, false)
	rightCommandsB.enqueue(1, 0, 1, false)
	for frame = 1 to attackStartupFrames(1) + 1
		stepMatch(gameB, rightB, leftB, rightInputB, leftInputB, rightCommandsB, leftCommandsB, frame)
	for frame = attackStartupFrames(1) + 2 to 40
		stepMatch(gameB, rightB, leftB, rightInputB, leftInputB, rightCommandsB, leftCommandsB, frame)
	leftA.damage.assertEquals(3.)
	rightA.damage.assertEquals(3.)
	leftA.damage.assertEquals(rightA.damage)
	leftA.damage.assertEquals(leftB.damage)
	leftA.damage.assertEquals(rightB.damage)
	leftA.hitstun.assertEquals(leftB.hitstun)
	rightA.hitstun.assertEquals(rightB.hitstun)
	leftA.cooldown.assertEquals(leftB.cooldown)
	rightA.cooldown.assertEquals(rightB.cooldown)

