	falling.knockbackZ = -20
	let input = new InputSnapshot()
	input.down = true
	advance(falling, 0, input, -240)
	totalVelocityZ(falling).assertLessThan(-characterTerminalSpeed(falling.character))
	falling.vz.assertEquals(-characterGravity(falling.character), 0.001)
	let rising = new FighterState(0, 0, 1)
	rising.grounded = false
	rising.z = 500
	rising.knockbackZ = 10
	rising.hitstun = 10
	advance(rising, 0, input, -240)
	rising.vz.assertEquals(-characterGravity(rising.character), 0.001)
	totalVelocityZ(rising).assertGreaterThan(0.)
	rising.hitstun = 0
	advance(rising, 0, input, -240)
	rising.vz.assertEquals(-characterGravity(rising.character) * 2, 0.001)
	totalVelocityZ(rising).assertGreaterThan(0.)
	destroy input
	destroy rising
	destroy falling

