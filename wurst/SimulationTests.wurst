@Test function airDodgeChangesVelocityAndLandingRestoresJumps()
	let fighter = new FighterState(0, 0, 1)
	fighter.grounded = false
	fighter.z = 20
	let input = new InputSnapshot()
	input.airDodgePressed = true
	input.dodgeX = 1
	input.dodgeZ = -1
	advance(fighter, 0, input, -240)
	(fighter.vx > 0).assertTrue()
	(fighter.vz < 0).assertTrue()
	fighter.vx.assertEquals(11.4551, 0.01)
	var ticks = 0
	while not fighter.grounded and ticks < 100
		input.airDodgePressed = false
		input.dodgeX = 0
		input.dodgeZ = 0
		advance(fighter, 0, input, -240)
		ticks++
	ticks.assertLessThan(100)
	fighter.z.assertEquals(0.)
	fighter.grounded.assertTrue()
	fighter.jumps.assertEquals(2)
	fighter.landingLag.assertEquals(10)
	input.direction = 1
	advance(fighter, 0, input, -240)
	fighter.landingLag.assertEquals(9)

@Test function airDodgeReplacesPriorMovementAndLaunchMomentum()
	for direction = 0 to 1
		let fighter = new FighterState(0, 0, 1)
		fighter.grounded = false
		fighter.z = 300
		fighter.vx = -30
		fighter.vz = 20
		fighter.knockbackX = 40
		fighter.knockbackZ = -50
		let input = new InputSnapshot()
		input.airDodgePressed = true
		input.dodgeX = direction
		advance(fighter, 0, input, 0)
		fighter.knockbackX.assertEquals(0.)
		fighter.knockbackZ.assertEquals(0.)
		fighter.x.assertEquals(direction * 15.40711556, 0.001)
		fighter.vx.assertEquals(direction * 15.40711556, 0.001)
		fighter.z.assertEquals(300. - direction * 5.00607531, 0.001)
		fighter.vz.assertEquals(-direction * 5.00607531, 0.001)
		input.airDodgePressed = false
		advance(fighter, 0, input, 0)
		fighter.x.assertEquals(direction * 29.27351957, 0.001)
		fighter.z.assertEquals(300. - direction * 9.51154309, 0.001)
		destroy input
		destroy fighter

@Test function horizontalAirDodgeDefaultsToShallowWavedashOnBothSides()
	for character = 0 to 1
		for direction = -1 to 1
			if direction != 0
				let fighter = new FighterState(character, 0, -direction)
				fighter.grounded = false
				fighter.z = 1
				simulationAirDodge(fighter, direction, 0)
				fighter.vx.assertEquals(direction * 17.1190173, 0.0001)
				fighter.vz.assertEquals(-5.5623059, 0.0001)
				(fighter.vx * fighter.vx + fighter.vz * fighter.vz).assertEquals(324., 0.001)
				let input = new InputSnapshot()
				advance(fighter, 0, input, 0)
				fighter.grounded.assertTrue()
				fighter.landingLag.assertEquals(AIR_DODGE_LANDING_LAG)
				(fighter.vx * direction).assertGreaterThan(11.4552)
				let landedX = fighter.x
				advance(fighter, 0, input, 0)
				((fighter.x - landedX) * direction).assertGreaterThan(0.)
				destroy input
				destroy fighter

@Test function diagonalDownDoesNotTriggerFastfallButStraightDownDoes()
	for character = 0 to 1
		for direction = -1 to 1
			let fighter = new FighterState(character, 0, 1)
			fighter.grounded = false
			fighter.z = 300
			fighter.vz = -1
			let input = new InputSnapshot()
			input.down = true
			input.verticalDirection = -1
			input.direction = direction
			advance(fighter, 0, input, 0)
			if direction == 0
				fighter.vz.assertEquals(-characterFastFallSpeed(character), 0.001)
			else
				fighter.vz.assertEquals(-1 - characterGravity(character), 0.001)
				(fighter.vx * direction).assertGreaterThan(0.)
			destroy input
			destroy fighter

@Test function diagonalAirDodgeDisplacesBothAxesWithTheSameDecayedVector()
	for direction = -1 to 1
		if direction != 0
			let fighter = new FighterState(0, 0, 1)
			fighter.grounded = false
			fighter.z = 300
			simulationAirDodge(fighter, 1, direction)
			let input = new InputSnapshot()
			var displacement = 11.4551299
			var distance = 0.
			for frame = 1 to 26
				advance(fighter, 0, input, 0)
				distance += displacement
				fighter.x.assertEquals(distance, 0.001)
				fighter.z.assertEquals(300 + direction * distance, 0.001)
				fighter.vx.assertEquals(displacement, 0.001)
				fighter.vz.assertEquals(direction * displacement, 0.001)
				displacement *= 0.9
			destroy input
			destroy fighter

@Test function fastAirDodgeUsesTheSweptPlatformCrossing()
	for entersTooLate = 0 to 1
		let fighter = new FighterState(0, entersTooLate == 0 ? -350 : -440, 1)
		fighter.grounded = false
		fighter.z = 200
		simulationAirDodge(fighter, 1, -1)
		// Stress the collision sweep independently of provisional dodge speed.
		fighter.vx = 100
		fighter.vz = -300
		let input = new InputSnapshot()
		advance(fighter, 1, input, 0)
		fighter.grounded.assertTrue()
		fighter.surface.assertEquals(entersTooLate == 0 ? 1 : 0)
		fighter.z.assertEquals(entersTooLate == 0 ? 170. : 0.)
		fighter.vx.assertEquals(90., 0.001)
		fighter.landingLag.assertEquals(10)
		destroy input
		destroy fighter

@Test function airDodgeLandingSlidesAndRestoresActionsAfterTenTicks()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		fighter.grounded = false
		fighter.z = 1
		simulationAirDodge(fighter, 1, -1)
		let input = new InputSnapshot()
		advance(fighter, 0, input, 0)
		fighter.grounded.assertTrue()
		fighter.landingLag.assertEquals(10)
		canAttack(fighter).assertFalse()
		let landingSpeed = fighter.vx
		input.direction = -1
		for tick = 1 to 9
			let previousX = fighter.x
			advance(fighter, 0, input, 0)
			fighter.x.assertGreaterThan(previousX)
			fighter.vx.assertEquals(landingSpeed - tick * GROUND_TRACTION, 0.001)
			fighter.landingLag.assertEquals(10 - tick)
			canAttack(fighter).assertFalse()
		advance(fighter, 0, input, 0)
		fighter.landingLag.assertEquals(0)
		canAttack(fighter).assertTrue()
		fighter.vx.assertEquals(-11.4, 0.001)
		fighter.dashFrame.assertEquals(1)
		destroy input
		destroy fighter

@Test function delayedJumpAirDodgeLandsDuringMotionAndSlides()
	for character = 0 to 1
		for fullJump = 0 to 1
			for direction = -1 to 1
				if direction != 0
					let fighter = new FighterState(character, 0, direction)
					let input = new InputSnapshot()
					input.jumpPressed = true
					input.jumpHeld = true
					for tick = 1 to 6
						advance(fighter, 0, input, 0)
						input.jumpPressed = false
						input.jumpHeld = fullJump == 1
					fighter.grounded.assertFalse()
					input.airDodgePressed = true
					input.dodgeX = direction
					input.dodgeZ = -1
					advance(fighter, 0, input, 0)
					input.airDodgePressed = false
					while not fighter.grounded and fighter.airDodgeTime > 0
						advance(fighter, 0, input, 0)
					fighter.grounded.assertTrue()
					fighter.airDodgeTime.assertGreaterThan(0)
					fighter.landingLag.assertEquals(10)
					(fighter.vx * direction).assertGreaterThan(GROUND_TRACTION)
					let landingX = fighter.x
					let landingSpeed = fighter.vx
					advance(fighter, 0, input, 0)
					((fighter.x - landingX) * direction).assertGreaterThan(0.)
					fighter.vx.assertEquals(landingSpeed - direction * GROUND_TRACTION, 0.001)
					fighter.landingLag.assertEquals(9)
					canAttack(fighter).assertFalse()
					destroy input
					destroy fighter

