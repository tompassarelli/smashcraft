@Test function downWaitAutostandsAndGetupAttackHasItsOwnHitbox()
	let fighter = new FighterState(0, 0, 1)
	let opponent = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	fighter.downState = DOWN_WAIT
	fighter.downFrame = DOWN_WAIT_FRAMES - 1
	advance(fighter, 0, input, 0)
	fighter.downState.assertEquals(DOWN_STAND)
	fighter.downState = DOWN_WAIT
	fighter.downFrame = 0
	input.getupAttackPressed = true
	advance(fighter, 0, input, 0)
	fighter.downState.assertEquals(DOWN_ATTACK)
	(attackPhase(fighter) == ATTACK_STARTUP).assertTrue()
	for frame = 1 to DOWN_ATTACK_STARTUP_FRAMES
		advance(fighter, 0, input, 0)
	(attackPhase(fighter) == ATTACK_ACTIVE).assertTrue()
	for frame = 1 to DOWN_ATTACK_ACTIVE_FRAMES
		resolveAttackPair(fighter, opponent)
		advance(fighter, 0, input, 0)
	opponent.damage.assertEquals(DOWN_ATTACK_DAMAGE)
	destroy input
	destroy opponent
	destroy fighter

function runGetupAttackToContact(FighterState attacker, FighterState target, int direction, real distance)
	attacker.facing = direction
	attacker.grounded = true
	attacker.surface = 0
	attacker.downState = DOWN_WAIT
	attacker.downFrame = 0
	target.facing = -direction
	target.x = attacker.x + direction * distance
	target.z = 0
	target.grounded = true
	target.surface = 0
	let input = new InputSnapshot()
	input.shield = target.shield
	input.getupAttackPressed = true
	advance(attacker, 0, input, 0)
	input.getupAttackPressed = false
	for tick = 1 to DOWN_ATTACK_STARTUP_FRAMES
		advance(attacker, 0, input, 0)
		advance(target, 0, input, 0)
		resolveAttackPair(attacker, target)
	destroy input

@Test function getupAttackCleanLowPercentHitGivesAttackerTimeBeforeWakeupAttackBothCharactersAndSides()
	for character = 0 to 1
		for side = 0 to 1
			let direction = side == 0 ? -1 : 1
			let attacker = new FighterState(character, 0, direction)
			let target = new FighterState(1 - character, 0, -direction)
			runGetupAttackToContact(attacker, target, direction, 100)
			target.damage.assertEquals(DOWN_ATTACK_DAMAGE)
			target.downState.assertEquals(DOWN_TUMBLE)
			let hitstunAtContact = target.hitstun
			hitstunAtContact.assertEquals(ordinaryHitstunFrames(
				ordinaryHitKnockback(0, DOWN_ATTACK_DAMAGE, character == 0 ? 80 : 75,
					ORDINARY_HIT_GROWTH_PERCENT, DOWN_ATTACK_BASE_KNOCKBACK, ORDINARY_HIT_CONTEXT_SCALE)))
			let attackerRecoveryAtContact = DOWN_ATTACK_FRAMES - attacker.downFrame
			hitstunAtContact.assertGreaterThan(attackerRecoveryAtContact)
			var attackerReadyFrame = -1
			var attackerActiveFrame = -1
			var victimWakeupActiveFrame = -1
			let neutral = new InputSnapshot()
			let victimInput = new InputSnapshot()
			for frame = 1 to 90
				advance(attacker, 0, neutral, 0)
				victimInput.getupAttackPressed = target.downState == DOWN_WAIT
				advance(target, 0, victimInput, 0)
				if victimWakeupActiveFrame < 0 and attackPhase(target) == ATTACK_ACTIVE and not isIntangible(target)
					victimWakeupActiveFrame = frame
				if attackerReadyFrame < 0 and canAttack(attacker)
					attackerReadyFrame = frame
					beginAttackPair(attacker, target, 0, -1, false, false)
				if attackerActiveFrame < 0 and attacker.attackStyle == 0 and attackPhase(attacker) == ATTACK_ACTIVE
					attackerActiveFrame = frame
			attackerReadyFrame.assertGreaterThan(0)
			attackerActiveFrame.assertGreaterThan(attackerReadyFrame)
			victimWakeupActiveFrame.assertGreaterThan(attackerActiveFrame)
			attackerReadyFrame.assertEquals(34)
			attackerActiveFrame.assertEquals(38)
			victimWakeupActiveFrame.assertEquals(character == 0 ? 54 : 50)
			destroy neutral
			destroy victimInput
			destroy target
			destroy attacker

@Test function getupAttackCleanHitRecoversBeforeSuccessfulTechBothCharactersAndSides()
	for character = 0 to 1
		for side = 0 to 1
			let direction = side == 0 ? -1 : 1
			let attacker = new FighterState(character, 0, direction)
			let target = new FighterState(1 - character, 0, -direction)
			runGetupAttackToContact(attacker, target, direction, 100)
			let neutral = new InputSnapshot()
			let defender = new InputSnapshot()
			var pressedTech = false
			var landedTech = false
			var attackerReady = -1
			var defenderReady = -1
			for frame = 1 to 100
				defender.techPressed = not pressedTech and target.hitlag == 0 and isTumbling(target) and totalVelocityZ(target) < 0 and target.z < 50
				pressedTech = pressedTech or defender.techPressed
				advance(attacker, 0, neutral, 0)
				advance(target, 0, defender, 0)
				landedTech = landedTech or target.downState == DOWN_TECH
				if attackerReady < 0 and canAttack(attacker)
					attackerReady = frame
				if defenderReady < 0 and canAttack(target)
					defenderReady = frame
			landedTech.assertTrue()
			attackerReady.assertEquals(34)
			defenderReady.assertGreaterThan(attackerReady)
			destroy defender
			destroy neutral
			destroy target
			destroy attacker

@Test function getupAttackShieldHitDoesNotGrantCleanHitFrameAdvantage()
