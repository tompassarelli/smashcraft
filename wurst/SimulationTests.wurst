@Test function knockbackDecaysByVectorMagnitudeAndContinuesAfterHitstun()
	let fighter = new FighterState(0, 100, 1)
	fighter.grounded = false
	fighter.z = 300
	fighter.hitstun = 1
	fighter.knockbackX = 60
	fighter.knockbackZ = 80
	let input = new InputSnapshot()
	advance(fighter, 0, input, -240)
	fighter.hitstun.assertEquals(0)
	SquareRoot(fighter.knockbackX * fighter.knockbackX + fighter.knockbackZ * fighter.knockbackZ).assertEquals(99.694, 0.001)
	(fighter.knockbackX / fighter.knockbackZ).assertEquals(0.75, 0.001)
	let xAtStunEnd = fighter.x
	advance(fighter, 0, input, -240)
	(fighter.x > xAtStunEnd).assertTrue()
	SquareRoot(fighter.knockbackX * fighter.knockbackX + fighter.knockbackZ * fighter.knockbackZ).assertEquals(99.388, 0.001)
	destroy input
	destroy fighter

@Test function downwardLaunchExceedsTerminalFallCapAndFastfallUsesNetActionableDescent()
	let falling = new FighterState(0, 0, 1)
	falling.grounded = false
	falling.z = 500
	falling.hitstun = 10
	falling.knockbackZ = -20
	let input = new InputSnapshot()
	input.down = true
	advance(falling, 0, input, -240)
	totalVelocityZ(falling).assertLessThan(-characterTerminalSpeed(falling.character))
	falling.vz.assertEquals(-characterGravity(falling.character), 0.001)
	let rising = new FighterState(0, 0, 1)
	rising.grounded = false
	rising.z = 500
	rising.knockbackZ = 10
	rising.hitstun = 10
	advance(rising, 0, input, -240)
	rising.vz.assertEquals(-characterGravity(rising.character), 0.001)
	totalVelocityZ(rising).assertGreaterThan(0.)
	rising.hitstun = 0
	advance(rising, 0, input, -240)
	rising.vz.assertEquals(-characterGravity(rising.character) * 2, 0.001)
	totalVelocityZ(rising).assertGreaterThan(0.)
	destroy input
	destroy rising
	destroy falling

