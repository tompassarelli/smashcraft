	blaster.hitlag.assertEquals(0)
	opponent.hitlag.assertEquals(0)
	blaster.cooldown.assertEquals(0)
	opponent.cooldown.assertEquals(attackDurationFrames(1) - attackStartupFrames(1))

@Test function successfulGrabHasPriorityOverSimultaneousStrikeInEitherOrder()
	let gameA = testMatch()
	let grabberA = new FighterState(0, 0, 1)
	let strikerA = new FighterState(1, 90, -1)
	let grabberInputA = new InputSnapshot()
	let strikerInputA = new InputSnapshot()
	let grabberCommandsA = new AttackBuffer(0)
	let strikerCommandsA = new AttackBuffer(0)
	grabberCommandsA.enqueue(5, 0, 1)
	for frame = 1 to 3
		stepMatch(gameA, grabberA, strikerA, grabberInputA, strikerInputA, grabberCommandsA, strikerCommandsA, frame)
	strikerCommandsA.enqueue(1, 0, 4)
	for frame = 4 to 6
		stepMatch(gameA, grabberA, strikerA, grabberInputA, strikerInputA, grabberCommandsA, strikerCommandsA, frame)
	let gameB = testMatch()
	let grabberB = new FighterState(0, 0, 1)
	let strikerB = new FighterState(1, 90, -1)
	let grabberInputB = new InputSnapshot()
	let strikerInputB = new InputSnapshot()
	let grabberCommandsB = new AttackBuffer(0)
	let strikerCommandsB = new AttackBuffer(0)
	grabberCommandsB.enqueue(5, 0, 1)
	for frame = 1 to 3
		stepMatch(gameB, grabberB, strikerB, grabberInputB, strikerInputB, grabberCommandsB, strikerCommandsB, frame)
	strikerCommandsB.enqueue(1, 0, 4)
	for frame = 4 to 6
		stepMatch(gameB, strikerB, grabberB, strikerInputB, grabberInputB, strikerCommandsB, grabberCommandsB, frame)
	grabberA.damage.assertEquals(0.)
	strikerA.damage.assertEquals(0.)
	grabberB.damage.assertEquals(grabberA.damage)
	strikerB.damage.assertEquals(strikerA.damage)
	strikerA.grabbedFrames.assertEquals(20)
	strikerB.grabbedFrames.assertEquals(strikerA.grabbedFrames)
	grabberA.cooldown.assertEquals(attackDurationFrames(5) - 5)
	strikerA.cooldown.assertEquals(0)
	grabberB.cooldown.assertEquals(grabberA.cooldown)
	strikerB.cooldown.assertEquals(strikerA.cooldown)

@Test function grabBreaksShieldButHasShortReachAndTimedRelease()
	let game = testMatch()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 90, -1)
	let attackerInput = new InputSnapshot()
	let targetInput = new InputSnapshot()
	targetInput.shield = true
	let attackerCommands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	runToAttackActive(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, 5, 1)
	target.grabbedFrames.assertEquals(20)
	target.shield.assertFalse()
	for frame = attackStartupFrames(5) + 2 to attackStartupFrames(5) + 21
		stepMatch(game, target, attacker, targetInput, attackerInput, targetCommands, attackerCommands, frame)
	target.grabbedFrames.assertEquals(0)
	target.hitstun.assertEquals(10)
	target.jumpSquat.assertEquals(0)
	let farTarget = new FighterState(1, 150, -1)
	let farAttacker = new FighterState(0, 0, 1)
	let farGame = testMatch()
	let farCommands = new AttackBuffer(0)
	let farTargetCommands = new AttackBuffer(0)
	runToAttackActive(farGame, farAttacker, farTarget, attackerInput, targetInput, farCommands, farTargetCommands, 5, 1)
	farTarget.grabbedFrames.assertEquals(0)
	let invincibleTarget = new FighterState(1, 50, -1)
	invincibleTarget.invincible = 100
	let invincibleAttacker = new FighterState(0, 0, 1)
	let invincibleGame = testMatch()
	let invincibleCommands = new AttackBuffer(0)
	let invincibleTargetCommands = new AttackBuffer(0)
	runToAttackActive(invincibleGame, invincibleAttacker, invincibleTarget, attackerInput, targetInput, invincibleCommands, invincibleTargetCommands, 5, 1)
	invincibleTarget.grabbedFrames.assertEquals(0)
	let outTarget = new FighterState(1, 50, -1)
	outTarget.out = true
	let outAttacker = new FighterState(0, 0, 1)
	let outGame = testMatch()
	let outCommands = new AttackBuffer(0)
	let outTargetCommands = new AttackBuffer(0)
	runToAttackActive(outGame, outAttacker, outTarget, attackerInput, targetInput, outCommands, outTargetCommands, 5, 1)
	outTarget.grabbedFrames.assertEquals(0)

@Test function airDodgeProtectsOnlyFramesFourThroughTwentyNine()
	for character = 0 to 1
		for frame = 1 to 30
			let fighter = new FighterState(character, 100, -1)
			fighter.z = 300
			fighter.grounded = false
			simulationAirDodge(fighter, 0, 0)
			let input = new InputSnapshot()
			for tick = 1 to frame
				advance(fighter, 0, input, -240)
			let attacker = new FighterState(0, 0, 1)
			attacker.z = fighter.z
			attacker.attackStyle = 0
			attacker.attackFrame = attackStartupFrames(0)
			resolveAttackPair(attacker, fighter)
			fighter.damage.assertEquals(frame >= 4 and frame <= 29 ? 0. : 12.)
			destroy attacker
			destroy input
			destroy fighter

@Test function aHitDuringDodgeStartupInterruptsDodgeMovement()
	let fighter = new FighterState(0, 100, -1)
	fighter.z = 300
	fighter.grounded = false
	simulationAirDodge(fighter, 1, 0)
	let attacker = new FighterState(1, 0, 1)
	attacker.z = 300
	attacker.attackStyle = 0
	attacker.attackFrame = attackStartupFrames(0)
	resolveAttackPair(attacker, fighter)
	fighter.damage.assertEquals(12.)
	fighter.airDodging.assertFalse()
	fighter.airDodgeTime.assertEquals(0)
	fighter.hitstun.assertGreaterThan(0)

@Test function landingEndsDodgeProtectionWithoutRemovingRespawnProtection()
	let fighter = new FighterState(0, 100, -1)
	fighter.z = 30
	fighter.grounded = false
	simulationAirDodge(fighter, 0, 0)
	let input = new InputSnapshot()
	for frame = 1 to 4
		advance(fighter, 0, input, -240)
	fighter.z = 1
	fighter.vz = -5
	advance(fighter, 0, input, -240)
	fighter.grounded.assertTrue()
	let attacker = new FighterState(1, 0, 1)
	attacker.z = fighter.z
	attacker.attackStyle = 0
	attacker.attackFrame = attackStartupFrames(0)
	resolveAttackPair(attacker, fighter)
	fighter.damage.assertEquals(12.)
	let respawned = new FighterState(0, 100, -1)
	respawned.invincible = 20
	let otherAttacker = new FighterState(1, 0, 1)
	otherAttacker.attackStyle = 0
	otherAttacker.attackFrame = attackStartupFrames(0)
	resolveAttackPair(otherAttacker, respawned)
	respawned.damage.assertEquals(0.)

function groundJumpApex(int character, boolean holdJump) returns real
	let fighter = new FighterState(character, 0, 1)
	let input = new InputSnapshot()
	input.jumpPressed = true
	input.jumpHeld = holdJump
	var apex = 0.
	for frame = 1 to 120
		advance(fighter, 0, input, -240)
		input.jumpPressed = false
		apex = max(apex, fighter.z)
	fighter.grounded.assertTrue()
	fighter.jumps.assertEquals(2)
	destroy input
	destroy fighter
	return apex

function airJumpApex(int character) returns real
	let fighter = new FighterState(character, 0, 1)
	fighter.grounded = false
	fighter.z = 100
	fighter.vz = -5
	fighter.jumps = 1
	let input = new InputSnapshot()
	input.jumpPressed = true
	input.jumpHeld = true
	var apex = fighter.z
	for frame = 1 to 120
		advance(fighter, 0, input, -240)
		input.jumpPressed = false
		apex = max(apex, fighter.z)
	fighter.grounded.assertTrue()
	destroy input
	destroy fighter
	return apex - 100

@Test function completeJumpTrajectoriesMatchReferenceHeights()
	groundJumpApex(0, true).assertEquals(31.28 * 6, 0.02)
	groundJumpApex(0, false).assertEquals(10.65 * 6, 0.02)
	airJumpApex(0).assertEquals(40.204 * 6, 0.02)
	groundJumpApex(1, true).assertEquals(51.5 * 6, 0.02)
	groundJumpApex(1, false).assertEquals(11.58 * 6, 0.02)
	airJumpApex(1).assertEquals(41.778 * 6, 0.02)

@Test function anotherPressDuringJumpSquatDoesNotRestartOrSpendAirJump()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		let input = new InputSnapshot()
		input.jumpPressed = true
		input.jumpHeld = true
		advance(fighter, 0, input, -240)
		advance(fighter, 0, input, -240)
		fighter.jumpSquat.assertEquals(jumpSquatFrames(character) - 2)
		fighter.jumps.assertEquals(1)
		destroy input
		destroy fighter

@Test function releasingThenRepressingDuringSquatKeepsShortHop()
	let fighter = new FighterState(1, 0, 1)
	let input = new InputSnapshot()
	input.jumpPressed = true
	input.jumpHeld = true
	advance(fighter, 0, input, -240)
	input.jumpPressed = false
	input.jumpHeld = false
	advance(fighter, 0, input, -240)
	input.jumpHeld = true
	for frame = 3 to 5
		advance(fighter, 0, input, -240)
	fighter.vz.assertEquals(shortJumpSpeed(1) - characterGravity(1), 0.01)
	fighter.jumps.assertEquals(1)

@Test function attackRecoveryBlocksJumpThroughAdvance()
	let fighter = new FighterState(0, 0, 1)
	setRecovery(fighter, 3)
	let input = new InputSnapshot()
	input.jumpPressed = true
	input.jumpHeld = true
	advance(fighter, 0, input, -240)
	fighter.jumps.assertEquals(2)
	fighter.jumpSquat.assertEquals(0)
	fighter.grounded.assertTrue()

@Test function attackRecoveryBlocksAirDodgeThroughAdvance()
	let fighter = new FighterState(0, 0, 1)
	fighter.grounded = false
	fighter.z = 120
	setRecovery(fighter, 3)
	let input = new InputSnapshot()
	input.airDodgePressed = true
	input.dodgeX = 1
	advance(fighter, 0, input, -240)
	fighter.airDodging.assertFalse()
	fighter.airDodgeTime.assertEquals(0)
	fighter.jumps.assertEquals(2)

@Test function attackRecoveryBlocksShieldThroughAdvance()
	let fighter = new FighterState(0, 0, 1)
	setRecovery(fighter, 3)
	let input = new InputSnapshot()
	input.shield = true
	advance(fighter, 0, input, -240)
	fighter.shield.assertFalse()

@Test function attackCommitmentBlocksGroundSteeringButKeepsAirDrift()
	let grounded = new FighterState(0, 0, 1)
	setRecovery(grounded, 10)
	let groundInput = new InputSnapshot()
	groundInput.direction = -1
	advance(grounded, 0, groundInput, -240)
	grounded.facing.assertEquals(1)
	grounded.vx.assertEquals(0.)
	let airborne = new FighterState(0, 0, 1)
	airborne.grounded = false
	airborne.z = 120
	setRecovery(airborne, 10)
	let airInput = new InputSnapshot()
	airInput.direction = -1
	advance(airborne, 0, airInput, -240)
	airborne.facing.assertEquals(1)
	airborne.vx.assertLessThan(0.)

@Test function finalRecoveryFrameAllowsActionsOnTheSameSimulationTick()
	let jumper = new FighterState(0, 0, 1)
	setRecovery(jumper, 1)
	jumper.attackFrame = attackDurationFrames(0) - 1
	let jumpInput = new InputSnapshot()
	jumpInput.jumpPressed = true
	jumpInput.jumpHeld = true
	advance(jumper, 0, jumpInput, -240)
	jumper.cooldown.assertEquals(0)
	jumper.jumpSquat.assertEquals(jumpSquatFrames(0) - 1)

	let dodger = new FighterState(0, 0, 1)
	dodger.grounded = false
	dodger.z = 120
	setRecovery(dodger, 1)
	dodger.attackFrame = attackDurationFrames(0) - 1
	let dodgeInput = new InputSnapshot()
	dodgeInput.airDodgePressed = true
	dodgeInput.dodgeX = 1
	advance(dodger, 0, dodgeInput, -240)
	dodger.airDodging.assertTrue()
	dodger.cooldown.assertEquals(0)

	let shielder = new FighterState(0, 0, 1)
	setRecovery(shielder, 1)
	shielder.attackFrame = attackDurationFrames(0) - 1
	let shieldInput = new InputSnapshot()
	shieldInput.shield = true
	advance(shielder, 0, shieldInput, -240)
	shielder.shield.assertTrue()
	shielder.cooldown.assertEquals(0)

@Test function jumpOutOfShieldClearsShieldThroughoutSquat()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		fighter.shield = true
		fighter.shieldHeldFrames = 1
		let input = new InputSnapshot()
		input.shield = true
		input.jumpPressed = true
		input.jumpHeld = true
		for frame = 1 to jumpSquatFrames(character)
			advance(fighter, 0, input, -240)
			input.jumpPressed = false
			fighter.shield.assertFalse()
			fighter.shieldReleaseLag.assertEquals(0)
			fighter.jumpSquat.assertEquals(jumpSquatFrames(character) - frame)
		fighter.grounded.assertFalse()
		fighter.jumps.assertEquals(1)
		destroy input
		destroy fighter

@Test function shieldJumpIntoDirectionalDodgeLandsWithSlidingRecovery()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		fighter.shield = true
		let input = new InputSnapshot()
		input.shield = true
		input.jumpPressed = true
		input.jumpHeld = true
		for frame = 1 to jumpSquatFrames(character)
			advance(fighter, 0, input, -240)
			input.jumpPressed = false
		input.airDodgePressed = true
		input.dodgeX = 1
		input.dodgeZ = -1
		advance(fighter, 0, input, -240)
		input.airDodgePressed = false
		fighter.airDodging.assertTrue()
		var frames = 0
		while not fighter.grounded and frames < 20
			advance(fighter, 0, input, -240)
			frames++
		fighter.grounded.assertTrue()
		fighter.airDodging.assertFalse()
		fighter.landingLag.assertEquals(AIR_DODGE_LANDING_LAG)
		fighter.vx.assertGreaterThan(0.)
		fighter.jumps.assertEquals(2)
		let landingX = fighter.x
		advance(fighter, 0, input, -240)
		fighter.x.assertGreaterThan(landingX)
		fighter.shield.assertFalse()
		fighter.landingLag.assertEquals(AIR_DODGE_LANDING_LAG - 1)
		destroy input
		destroy fighter
