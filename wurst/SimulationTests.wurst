@Test function attacksCommitRecoveryOnWhiffAndBlockDuringLandingLag()
	let game = testMatch()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 400, -1)
	let attackerInput = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let attackerCommands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	runToAttackActive(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, 0, 1)
	attacker.cooldown.assertEquals(32)
	(attackPhase(attacker) == ATTACK_ACTIVE).assertTrue()
	target.x = 100
	stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, attackStartupFrames(0) + 2)
	target.damage.assertEquals(12.)
	attacker.attackHit.assertTrue()
	let damageAfterContact = target.damage
	for frame = attackStartupFrames(0) + 3 to attackStartupFrames(0) + attackActiveFrames(0) + 1
		stepMatch(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, frame)
	target.damage.assertEquals(damageAfterContact)

@Test function simultaneousEligibleAttacksTradeInEitherOrder()
