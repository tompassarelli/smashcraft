@Test function blastZoneRemovesExactlyOneStock()
	let fighter = new FighterState(0, 918, 1)
	fighter.vx = 100
	let input = new InputSnapshot()
	input.direction = 1
	advance(fighter, 0, input, -240)
	fighter.out.assertTrue()
	fighter.stocks.assertEquals(2)
	var ticks = 0
	while ticks < 130
		advance(fighter, 0, input, -240)
		ticks++
	fighter.stocks.assertEquals(2)
	fighter.out.assertEquals(false)
	fighter.out.assertEquals(false)
	fighter.x = 920
	advance(fighter, 0, input, -240)
	fighter.stocks.assertEquals(1)
	while fighter.respawn > 0
		advance(fighter, 0, input, -240)
	fighter.x = 920
	advance(fighter, 0, input, -240)
	fighter.stocks.assertEquals(0)
	fighter.out.assertEquals(true)
	let finalX = fighter.x
	advance(fighter, 0, input, -240)
	fighter.x.assertEquals(finalX)

@Test function releasingShieldWaitsForMinimumHoldThenAppliesReleaseLag()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	input.shield = true
	advance(fighter, 0, input, -240)
	input.shield = false
	for i = 0 to SHIELD_MIN_HOLD_FRAMES - 2
		advance(fighter, 0, input, -240)
		fighter.shield.assertTrue()
	advance(fighter, 0, input, -240)
	fighter.shield.assertFalse()
	fighter.shieldReleaseLag.assertEquals(SHIELD_RELEASE_LAG_FRAMES)
	let energyAtRelease = fighter.shieldEnergy
	advance(fighter, 0, input, -240)
	fighter.shieldEnergy.assertGreaterThan(energyAtRelease)
	fighter.shieldReleaseLag.assertEquals(SHIELD_RELEASE_LAG_FRAMES - 1)

