		destroy target
		destroy fighter

@Test function cStickDownAirPreservesNormalAerialMomentumForBothFighters()
	for character = 0 to 1
		for verticalSign = -1 to 1
			if verticalSign != 0
				let fighter = new FighterState(character, 0, 1)
				let falling = new FighterState(character, 0, 1)
				let other = new FighterState(1 - character, 500, -1)
				let input = new InputSnapshot()
				let neutralInput = new InputSnapshot()
				fighter.grounded = false
				falling.grounded = false
				fighter.z = 500
				falling.z = 500
				fighter.vz = verticalSign * 8.
				falling.vz = fighter.vz
				fighter.knockbackZ = 2
				falling.knockbackZ = 2
				input.cStickZ = -1
				beginAttackPair(fighter, other, AERIAL_DOWN_STYLE, -1, false, false)
				fighter.vz.assertEquals(falling.vz)
				fighter.knockbackZ.assertEquals(falling.knockbackZ)
				for frame = 1 to 26
					advance(fighter, 0, input, 0)
					advance(falling, 0, neutralInput, 0)
					fighter.vz.assertEquals(falling.vz, 0.0001)
					fighter.z.assertEquals(falling.z, 0.0001)
				destroy neutralInput
				destroy input
				destroy other
				destroy falling
				destroy fighter

@Test function archerDownAirHasOneStrongToWeakWindowAndRiflemanIsUnchanged()
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 0, -1)
	fighter.grounded = false
	fighter.z = 300
	target.z = 240
	beginAttackPair(fighter, target, AERIAL_DOWN_STYLE, -1, false, false)
	fighter.attackFrame = 7
	resolveAttackPair(fighter, target)
	target.damage.assertEquals(9.)
	fighter.hitlag = 0
	fighter.attackFrame = 26
	resolveAttackPair(fighter, target)
	target.damage.assertEquals(9.)
	let lateTarget = new FighterState(1, 0, -1)
	lateTarget.z = 240
	resolveAttackPair(fighter, lateTarget)
	lateTarget.damage.assertEquals(6.)
	fighter.hitlag = 0
	fighter.attackFrame = 27
	attackPhase(fighter).assertEquals(ATTACK_RECOVERY)
	let rifleman = new FighterState(1, 0, 1)
	rifleman.grounded = false
	rifleman.z = 300
	rifleman.vz = 10
	beginAttackPair(rifleman, target, AERIAL_DOWN_STYLE, -1, false, false)
	rifleman.vz.assertEquals(10.)
	rifleman.attackFrame = 9
	attackPhase(rifleman).assertEquals(ATTACK_ACTIVE)
	rifleman.attackFrame = 10
	attackPhase(rifleman).assertEquals(ATTACK_RECOVERY)
	destroy rifleman
	destroy lateTarget
	destroy target
	destroy fighter

@Test function commonGroundDodgeFrameDataAppliesToBothCharacters()
	for character = 0 to 1
		for direction = -1 to 1
			let fighter = new FighterState(character, 0, 1)
			let input = new InputSnapshot()
			input.shield = true
			input.groundDodgePressed = true
			input.groundDodgeDirection = direction
			let duration = direction == 0 ? 22 : 31
			for frame = 1 to duration
				advance(fighter, 0, input, 0)
				input.groundDodgePressed = false
				fighter.groundDodgeFrame.assertEquals(frame)
				let expectedIntangible = direction == 0 ? frame >= 2 and frame <= 15 : frame >= 4 and frame <= 19
				(isIntangible(fighter) == expectedIntangible).assertTrue()
				canAttack(fighter).assertFalse()
			advance(fighter, 0, input, 0)
			fighter.groundDodgeFrame.assertEquals(0)
			destroy input
			destroy fighter

