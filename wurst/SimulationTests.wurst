@Test function directionalInfluenceOpportunityClearsOnResetStockLossAndNonKnockbackHits()
	let fighter = new FighterState(0, 0, 1)
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let game = testMatch()
	let attackerInput = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let attackerCommands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	targetInput.shield = true
	fighter.diPending = true
	fighter.diLaunchSpeed = 10
	fighter.diSerial = 2
	fighter.diAngleDegrees = 9
	reset(fighter, 0)
	fighter.diPending.assertFalse()
	fighter.diLaunchSpeed.assertEquals(0.)
	fighter.diSerial.assertEquals(0)
	fighter.diAngleDegrees.assertEquals(0.)
	fighter.diPending = true
	fighter.x = 920
	advance(fighter, 0, targetInput, 0)
	fighter.diPending.assertFalse()
	fighter.diLaunchSpeed.assertEquals(0.)
	target.diPending = true
	target.diLaunchSpeed = 10
	target.hitlag = 20
	target.shield = true
	runToAttackActive(game, attacker, target, attackerInput, targetInput, attackerCommands, targetCommands, 0, 1)
	target.diPending.assertTrue()
	target.diLaunchSpeed.assertEquals(10.)
	target.vx.assertEquals(0.)
	target.vz.assertEquals(0.)
	let grabber = new FighterState(0, 0, 1)
	let grabbed = new FighterState(1, 100, -1)
	grabbed.diPending = true
	grabbed.diLaunchSpeed = 10
	beginAttackPair(grabber, grabbed, 5, -1, false, false)
	grabber.attackFrame = attackStartupFrames(5)
	resolveAttackPair(grabber, grabbed)
	grabbed.grabbedFrames.assertEquals(20)
	grabbed.diPending.assertFalse()
	let shooter = new FighterState(0, 0, 1)
	let shotTarget = new FighterState(0, 30, -1)
	shotTarget.diPending = true
	shotTarget.diLaunchSpeed = 10
	shotTarget.knockbackX = 10
	shotTarget.hitlag = 1
	let shotInput = new InputSnapshot()
	shotInput.verticalDirection = 1
	shooter.projectileLife[0] = 1
	shooter.projectileDirection[0] = 1
	shooter.projectileX[0] = 0
	shooter.projectileZ[0] = 45
	updateProjectilePair(shooter, shotTarget)
	shotTarget.damage.assertEquals(3.)
	shotTarget.diPending.assertTrue()
	shotTarget.diSerial.assertEquals(0)
	advance(shotTarget, 0, shotInput, -240)
	shotTarget.diPending.assertFalse()
	shotTarget.diSerial.assertEquals(1)
	shotTarget.diAngleDegrees.assertEquals(18, 0.001)
	let blockedTarget = new FighterState(1, 30, -1)
	blockedTarget.shield = true
	blockedTarget.diPending = true
	blockedTarget.diLaunchSpeed = 10
	shooter.projectileLife[0] = 1
	shooter.projectileX[0] = 0
	shooter.projectileZ[0] = 45
	updateProjectilePair(shooter, blockedTarget)
	blockedTarget.diPending.assertTrue()
	blockedTarget.diLaunchSpeed.assertEquals(10.)
	destroy targetCommands
	destroy attackerCommands
	destroy targetInput
	destroy attackerInput
	destroy game
	destroy attacker
	destroy target
	destroy shooter
	destroy shotTarget
	destroy shotInput
	destroy blockedTarget
	destroy grabber
	destroy grabbed
	destroy fighter

