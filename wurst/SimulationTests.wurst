	for frame = 1 to 60
		advance(attacker, 0, neutral, 0)
		advance(target, 0, neutral, 0)
		if attackerReady < 0 and canAttack(attacker)
			attackerReady = frame
		if defenderReady < 0 and canAttack(target)
			defenderReady = frame
	defenderReady.assertGreaterThan(0)
