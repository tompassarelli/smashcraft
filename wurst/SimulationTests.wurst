	rightCommandsB.enqueue(1, 0, 1, false)
	for frame = 1 to attackStartupFrames(1) + 1
		stepMatch(gameB, rightB, leftB, rightInputB, leftInputB, rightCommandsB, leftCommandsB, frame)
	for frame = attackStartupFrames(1) + 2 to 40
		stepMatch(gameB, rightB, leftB, rightInputB, leftInputB, rightCommandsB, leftCommandsB, frame)
	leftA.damage.assertEquals(3.)
	rightA.damage.assertEquals(3.)
	leftA.damage.assertEquals(rightA.damage)
	leftA.damage.assertEquals(leftB.damage)
	leftA.damage.assertEquals(rightB.damage)
	leftA.hitstun.assertEquals(leftB.hitstun)
	rightA.hitstun.assertEquals(rightB.hitstun)
	leftA.cooldown.assertEquals(leftB.cooldown)
	rightA.cooldown.assertEquals(rightB.cooldown)

