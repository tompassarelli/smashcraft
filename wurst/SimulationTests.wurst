@Test function walkingModifierUsesCharacterWalkSpeedAndReleasesToDash()
	for character = 0 to 1
		for direction = -1 to 1
			if direction != 0
				let fighter = new FighterState(character, 0, direction)
				let input = new InputSnapshot()
				input.direction = direction
				input.walking = true
				let walkSpeed = character == 0 ? 9.6 : 8.4
				for tick = 1 to 10
					advance(fighter, 0, input, 0)
					fighter.vx.assertEquals(walkSpeed * direction, 0.001)
				fighter.x.assertEquals(10 * walkSpeed * direction, 0.001)
				input.walking = false
				advance(fighter, 0, input, 0)
				fighter.vx.assertEquals(11.4 * direction, 0.001)
				fighter.dashFrame.assertEquals(1)
				input.walking = true
				advance(fighter, 0, input, 0)
				fighter.vx.assertEquals(walkSpeed * direction, 0.001)
				fighter.dashFrame.assertEquals(0)
				destroy input
				destroy fighter

@Test function initialDashLastsTenTicksThenUsesCharacterRunSpeed()
	for character = 0 to 1
		for direction = -1 to 1
			if direction != 0
				let fighter = new FighterState(character, 0, -direction)
				let input = new InputSnapshot()
				input.direction = direction
				for tick = 1 to 10
					advance(fighter, 0, input, 0)
					fighter.vx.assertEquals(11.4 * direction, 0.001)
					fighter.facing.assertEquals(direction)
				fighter.x.assertEquals(114. * direction, 0.001)
				advance(fighter, 0, input, 0)
				fighter.vx.assertEquals((character == 0 ? 13.2 : 9.) * direction, 0.001)
				destroy input
				destroy fighter

@Test function initialDashReversalRestartsWindowIncludingAcrossNeutral()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		let input = new InputSnapshot()
		input.direction = 1
		for tick = 1 to 8
			advance(fighter, 0, input, 0)
		input.direction = 0
		advance(fighter, 0, input, 0)
		fighter.vx.assertEquals(10.92, 0.001)
		fighter.dashFrame.assertEquals(9)
		input.direction = -1
		advance(fighter, 0, input, 0)
		fighter.vx.assertEquals(-11.4, 0.001)
		fighter.facing.assertEquals(-1)
		fighter.dashFrame.assertEquals(1)
		for tick = 1 to 6
			input.direction = -input.direction
			advance(fighter, 0, input, 0)
			fighter.vx.assertEquals(11.4 * input.direction, 0.001)
			fighter.dashFrame.assertEquals(1)
		destroy input
		destroy fighter

@Test function runReversalBrakesBeforeStartingANewDash()
	for character = 0 to 1
		for firstDirection = -1 to 1
			if firstDirection != 0
				let fighter = new FighterState(character, 0, firstDirection)
				let input = new InputSnapshot()
				input.direction = firstDirection
				for tick = 1 to 11
					advance(fighter, 0, input, 0)
				input.direction = -firstDirection
				let brakingTicks = character == 0 ? 3 : 2
				for tick = 1 to brakingTicks
					advance(fighter, 0, input, 0)
					fighter.vx.assertEquals(firstDirection * max(0, (character == 0 ? 13.2 : 9.) - 4.8 * tick), 0.001)
					fighter.facing.assertEquals(firstDirection)
				advance(fighter, 0, input, 0)
				fighter.vx.assertEquals(-firstDirection * 11.4, 0.001)
				fighter.facing.assertEquals(-firstDirection)
				fighter.dashFrame.assertEquals(1)
				destroy input
				destroy fighter

@Test function initialDashExpirationPreventsLateInstantReversal()
