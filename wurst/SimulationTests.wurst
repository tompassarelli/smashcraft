package SimulationTests
import Simulation
import MatchRules
import CommandBuffer
import MatchStep

function lCancelTestFighter(int style) returns FighterState
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 500, -1)
	fighter.grounded = false
	fighter.z = 300
	beginAttackPair(fighter, target, style, -1, false, false)
	destroy target
	return fighter

function landLCancelTest(FighterState fighter, InputSnapshot input)
	fighter.z = 1
	fighter.vz = -2
	advance(fighter, 0, input, 0)

@Test function lCancelSevenContactOpportunitiesAndExpiredPress()
	for age = 0 to 7
		let fighter = lCancelTestFighter(AERIAL_UP_STYLE)
		let input = new InputSnapshot()
		input.lCancelPressed = true
		input.shield = true
		if age > 0
			advance(fighter, 0, input, 0)
			input.lCancelPressed = false
			for tick = 1 to age - 1
				advance(fighter, 0, input, 0)
		landLCancelTest(fighter, input)
		fighter.landingLag.assertEquals(age < 7 ? 7 : 15)
		fighter.lCancelSerial.assertEquals(age < 7 ? 1 : 0)
		fighter.lCancelWindow.assertEquals(0)
		destroy input
		destroy fighter

@Test function lCancelHalvesAerialRecoveryAndPreservesActionLockout()
	for style = AERIAL_NEUTRAL_STYLE to AERIAL_DOWN_STYLE
		let fighter = lCancelTestFighter(style)
		let input = new InputSnapshot()
		input.lCancelPressed = true
		input.airDodgePressed = true
		input.techPressed = true
		fighter.techLockout = 20
		landLCancelTest(fighter, input)
		let expected = style == AERIAL_NEUTRAL_STYLE ? 5 : (style == AERIAL_FORWARD_STYLE ? 7 : (style == AERIAL_BACK_STYLE ? 8 : (style == AERIAL_UP_STYLE ? 7 : 9)))
		fighter.landingLag.assertEquals(expected)
		fighter.lCancelSerial.assertEquals(1)
		fighter.airDodging.assertFalse()
		fighter.techWindow.assertEquals(0)
		fighter.attackStyle.assertEquals(-1)
		canAttack(fighter).assertFalse()
		input.lCancelPressed = false
		input.airDodgePressed = false
		input.techPressed = false
		for tick = 1 to expected - 1
			advance(fighter, 0, input, 0)
			canAttack(fighter).assertFalse()
		advance(fighter, 0, input, 0)
		canAttack(fighter).assertTrue()
		fighter.lCancelSerial.assertEquals(1)
		destroy input
		destroy fighter

@Test function lCancelPressDuringHitlagSurvivesFreezeButNotSevenLaterTicks()
	for age = 6 to 7
		let fighter = lCancelTestFighter(AERIAL_UP_STYLE)
		let input = new InputSnapshot()
		fighter.hitlag = 4
		input.lCancelPressed = true
		advance(fighter, 0, input, 0)
		input.lCancelPressed = false
		for tick = 2 to 4
			advance(fighter, 0, input, 0)
			fighter.lCancelWindow.assertEquals(7)
		for tick = 1 to age - 1
			advance(fighter, 0, input, 0)
		landLCancelTest(fighter, input)
		fighter.landingLag.assertEquals(age == 6 ? 7 : 15)
		destroy input
		destroy fighter

@Test function lCancelDoesNotShortenAirDodgeOrEmptyLandingsAndClearsOnStockLoss()
	let fighter = new FighterState(0, 0, 1)
	fighter.grounded = false
	fighter.z = 1
	fighter.vz = -2
	fighter.airDodging = true
	let input = new InputSnapshot()
	input.lCancelPressed = true
	landLCancelTest(fighter, input)
	fighter.landingLag.assertEquals(AIR_DODGE_LANDING_LAG)
	fighter.lCancelSerial.assertEquals(0)
	fighter.lCancelWindow.assertEquals(0)
	reset(fighter, 0)
	landLCancelTest(fighter, input)
	fighter.landingLag.assertEquals(0)
	fighter.lCancelSerial.assertEquals(0)
	fighter.x = 921
	advance(fighter, 0, input, 0)
	fighter.out.assertTrue()
	fighter.lCancelWindow.assertEquals(0)
	fighter.lCancelSerial = 2
	reset(fighter, 0)
	fighter.lCancelWindow.assertEquals(0)
	fighter.lCancelSerial.assertEquals(0)
	destroy input
	destroy fighter

function prepareSmashCharge(FighterState fighter, FighterState target, InputSnapshot input, int style)
	fighter.surface = 0
	target.x = fighter.x + 100
	input.attackHeld = true
	beginAttackPair(fighter, target, style, -1, true, false)
	for tick = 1 to attackStartupFrames(style)
		advance(fighter, 0, input, -240)

@Test function smashChargePausesPreActiveClockAndReleaseEntersHitFrame()
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	prepareSmashCharge(fighter, target, input, 2)
	fighter.smashCharging.assertTrue()
	fighter.attackFrame.assertEquals(attackStartupFrames(2) - 1)
	fighter.smashChargeFrames.assertEquals(1)
	let pausedCooldown = fighter.cooldown
	let pausedX = fighter.x
	input.direction = -1
	input.attackHeld = false
	advance(fighter, 0, input, -240)
	fighter.smashCharging.assertFalse()
	fighter.smashChargeFrames.assertEquals(1)
	fighter.attackFrame.assertEquals(attackStartupFrames(2))
	fighter.cooldown.assertEquals(pausedCooldown - 1)
	fighter.x.assertEquals(pausedX)
	resolveAttackPair(fighter, target)
	target.damage.assertEquals(16 * smashDamageMultiplier(1), 0.001)
	destroy input
	destroy target
	destroy fighter

@Test function smashChargeCapsAtSixtyTicksAndScalesToMeleeDamageMultiplier()
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	prepareSmashCharge(fighter, target, input, 2)
	for tick = 2 to SMASH_MAX_CHARGE_FRAMES
		advance(fighter, 0, input, -240)
	fighter.smashChargeFrames.assertEquals(SMASH_MAX_CHARGE_FRAMES)
	fighter.smashCharging.assertTrue()
	input.attackHeld = false
	advance(fighter, 0, input, -240)
	fighter.smashCharging.assertFalse()
	fighter.smashChargeFrames.assertEquals(SMASH_MAX_CHARGE_FRAMES)
	fighter.attackFrame.assertEquals(attackStartupFrames(2))
	resolveAttackPair(fighter, target)
	target.damage.assertEquals(16 * SMASH_MAX_DAMAGE_MULTIPLIER, 0.001)
	(smashDamageMultiplier(SMASH_MAX_CHARGE_FRAMES) == SMASH_MAX_DAMAGE_MULTIPLIER).assertTrue()
	destroy input
	destroy target
	destroy fighter

@Test function directSmashDoesNotChargeAndChargeFreezesOnlyFighterControlClock()
	let direct = new FighterState(0, 0, 1)
	let directTarget = new FighterState(1, 100, -1)
	let directInput = new InputSnapshot()
	directInput.attackHeld = true
	beginAttackPair(direct, directTarget, 4, -1, false, false)
	for tick = 1 to attackStartupFrames(4)
		advance(direct, 0, directInput, -240)
	direct.smashCharging.assertFalse()
	direct.attackFrame.assertEquals(attackStartupFrames(4))
	resolveAttackPair(direct, directTarget)
	directTarget.damage.assertEquals(18, 0.001)
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	prepareSmashCharge(fighter, target, input, 3)
	let attackFrame = fighter.attackFrame
	let cooldown = fighter.cooldown
	let x = fighter.x
	fighter.invincible = 10
	fighter.dropTime = 10
	fighter.hitlag = 3
	for tick = 1 to 3
		advance(fighter, 0, input, -240)
	fighter.smashChargeFrames.assertEquals(1)
	fighter.attackFrame.assertEquals(attackFrame)
	fighter.cooldown.assertEquals(cooldown)
	advance(fighter, 0, input, -240)
	fighter.smashChargeFrames.assertEquals(2)
	fighter.attackFrame.assertEquals(attackFrame)
	fighter.cooldown.assertEquals(cooldown)
	fighter.invincible.assertEquals(9)
	fighter.dropTime.assertEquals(9)
	fighter.x.assertEquals(x)
	destroy input
	destroy target
	destroy fighter
	destroy directInput
	destroy directTarget
	destroy direct

@Test function smashChargeStopsWhenFighterLeavesGroundAndClearsOnInterruptionOrStockLoss()
	let fighter = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	prepareSmashCharge(fighter, target, input, 2)
	fighter.grounded = false
	advance(fighter, 0, input, -240)
	fighter.smashCharging.assertFalse()
	fighter.smashChargeAllowed.assertFalse()
	fighter.attackFrame.assertEquals(attackStartupFrames(2))
	let attacker = new FighterState(1, 100, -1)
	attacker.attackStyle = 0
	attacker.attackFrame = attackStartupFrames(0)
	resolveAttackPair(fighter, attacker)
	fighter.attackStyle.assertEquals(-1)
	fighter.smashChargeFrames.assertEquals(0)
	let stockFighter = new FighterState(0, 0, 1)
	let stockTarget = new FighterState(1, 100, -1)
	let stockInput = new InputSnapshot()
	prepareSmashCharge(stockFighter, stockTarget, stockInput, 2)
	stockFighter.x = 920
	stockInput.attackHeld = false
	advance(stockFighter, 0, stockInput, -240)
	stockFighter.out.assertTrue()
	stockFighter.smashCharging.assertFalse()
	stockFighter.smashChargeFrames.assertEquals(0)
	destroy stockInput
	destroy stockTarget
	destroy stockFighter
	destroy attacker
	destroy input
	destroy target
	destroy fighter

@Test function simultaneousChargedSmashTradeSnapshotsBothChargeAmounts()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	first.surface = 0
	second.surface = 0
	let firstInput = new InputSnapshot()
	let secondInput = new InputSnapshot()
	firstInput.attackHeld = true
	secondInput.attackHeld = true
	beginAttackPair(first, second, 2, 2, true, true)
	for tick = 1 to attackStartupFrames(2)
		advance(first, 0, firstInput, -240)
		advance(second, 0, secondInput, 240)
	for tick = 2 to SMASH_MAX_CHARGE_FRAMES
		advance(first, 0, firstInput, -240)
		advance(second, 0, secondInput, 240)
	first.smashChargeFrames.assertEquals(SMASH_MAX_CHARGE_FRAMES)
	second.smashChargeFrames.assertEquals(SMASH_MAX_CHARGE_FRAMES)
	firstInput.attackHeld = false
	secondInput.attackHeld = false
	advance(first, 0, firstInput, -240)
	advance(second, 0, secondInput, 240)
	resolveAttackPair(first, second)
	first.damage.assertEquals(16 * SMASH_MAX_DAMAGE_MULTIPLIER, 0.001)
	second.damage.assertEquals(16 * SMASH_MAX_DAMAGE_MULTIPLIER, 0.001)
	destroy firstInput
	destroy secondInput
	destroy first
	destroy second

@Test function jumpEventsFollowTakeoffAndAcceptedAirJump()
	for character = 0 to 1
		let fighter = new FighterState(character, 0, 1)
		let input = new InputSnapshot()
		input.jumpPressed = true
		input.jumpHeld = true
		advance(fighter, 0, input, 0)
		fighter.jumpSerial.assertEquals(0)
		input.jumpPressed = false
		for frame = 2 to jumpSquatFrames(character) - 1
			advance(fighter, 0, input, 0)
			fighter.jumpSerial.assertEquals(0)
		advance(fighter, 0, input, 0)
		fighter.jumpSerial.assertEquals(1)
		fighter.jumpIsDouble.assertFalse()
		fighter.grounded.assertFalse()
		advance(fighter, 0, input, 0)
		fighter.jumpSerial.assertEquals(1)
		input.jumpPressed = true
		advance(fighter, 0, input, 0)
		fighter.jumpSerial.assertEquals(2)
		fighter.jumpIsDouble.assertTrue()
		advance(fighter, 0, input, 0)
		fighter.jumpSerial.assertEquals(2)
		reset(fighter, 0)
		fighter.jumpSerial.assertEquals(0)
		fighter.jumpIsDouble.assertFalse()
		destroy input
		destroy fighter

@Test function blockedJumpDoesNotProduceTakeoffEvent()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	fighter.hitstun = 10
	input.jumpPressed = true
	input.jumpHeld = true
	advance(fighter, 0, input, 0)
	fighter.jumpSerial.assertEquals(0)
	fighter.jumps.assertEquals(2)
	fighter.grounded.assertTrue()
	destroy input
	destroy fighter

function testMatch() returns MatchState
	let game = new MatchState()
	game.confirm()
	game.confirm()
	return game

function runToAttackActive(MatchState game, FighterState first, FighterState second, InputSnapshot firstInput, InputSnapshot secondInput, AttackBuffer firstCommands, AttackBuffer secondCommands, int style, int startFrame)
	firstCommands.enqueue(style, 0, startFrame, false)
	for i = 0 to attackStartupFrames(style)
		stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, startFrame + i)

function setRecovery(FighterState fighter, int cooldown)
	fighter.attackStyle = 0
	fighter.attackFrame = attackStartupFrames(0) + attackActiveFrames(0)
	fighter.attackDuration = attackDurationFramesForGrounding(0, fighter.grounded)
	fighter.attackHit = true
	fighter.cooldown = cooldown

@Test function allStylesExposeStartupActiveAndRecoveryFrames()
	for style = 0 to 10
		let fighter = new FighterState(0, 0, 1)
		let target = new FighterState(1, 400, -1)
		let input = new InputSnapshot()
		beginAttackPair(fighter, target, style, -1, false, false)
		fighter.attackSerial.assertEquals(1)
		fighter.attackFrame.assertEquals(0)
		(attackPhase(fighter) == ATTACK_STARTUP).assertTrue()
		for frame = 1 to attackStartupFrames(style) - 1
			advance(fighter, 0, input, -240)
			(attackPhase(fighter) == ATTACK_STARTUP).assertTrue()
		advance(fighter, 0, input, -240)
		(attackPhase(fighter) == ATTACK_ACTIVE).assertTrue()
		for frame = 1 to attackActiveFrames(style) - 1
			advance(fighter, 0, input, -240)
			(attackPhase(fighter) == ATTACK_ACTIVE).assertTrue()
		advance(fighter, 0, input, -240)
		(attackPhase(fighter) == ATTACK_RECOVERY).assertTrue()
		for frame = 1 to fighter.attackDuration - attackStartupFrames(style) - attackActiveFrames(style)
			advance(fighter, 0, input, -240)
		(attackPhase(fighter) == ATTACK_NONE).assertTrue()
		fighter.cooldown.assertEquals(0)
		canAttack(fighter).assertTrue()
		beginAttackPair(fighter, target, style, -1, false, false)
		fighter.attackSerial.assertEquals(2)
		(attackPhase(fighter) == ATTACK_STARTUP).assertTrue()
		destroy input
		destroy target
		destroy fighter

@Test function recoveryFramesCannotDealDamage()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	let input = new InputSnapshot()
	beginAttackPair(attacker, target, 0, -1, false, false)
	for frame = 1 to attackStartupFrames(0) + attackActiveFrames(0)
		advance(attacker, 0, input, -240)
	(attackPhase(attacker) == ATTACK_RECOVERY).assertTrue()
	for frame = 0 to 5
		resolveAttackPair(attacker, target)
	target.damage.assertEquals(0.)
	destroy input
	destroy target
	destroy attacker

function resolveStartedAttack(int style, FighterState attacker, FighterState target)
	let input = new InputSnapshot()
	beginAttackPair(attacker, target, style, -1, false, false)
	for frame = 1 to attackStartupFrames(style)
		advance(attacker, 0, input, -240)
		resolveAttackPair(attacker, target)
		updateProjectilePair(attacker, target)
	destroy input

function spawnTestProjectile(FighterState owner, FighterState target)
	beginAttackPair(owner, target, 1, -1, false, false)
	owner.attackFrame = attackStartupFrames(1)
	resolveAttackPair(owner, target)

@Test function blasterTravelsBeforeItDealsDamage()
	let game = testMatch()
	let owner = new FighterState(0, 0, 1)
	let target = new FighterState(1, 400, -1)
	let ownerInput = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let ownerCommands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	runToAttackActive(game, owner, target, ownerInput, targetInput, ownerCommands, targetCommands, 1, 1)
	target.damage.assertEquals(0.)
	projectileCount(owner).assertEquals(1)
	for frame = attackStartupFrames(1) + 2 to 11
		stepMatch(game, owner, target, ownerInput, targetInput, ownerCommands, targetCommands, frame)
	target.damage.assertEquals(0.)
	stepMatch(game, owner, target, ownerInput, targetInput, ownerCommands, targetCommands, 12)
	target.damage.assertEquals(3.)
	projectileCount(owner).assertEquals(0)

@Test function projectilePoolExpiresMissesAtItsRange()
	let owner = new FighterState(0, 0, 1)
	let target = new FighterState(1, 5000, -1)
	spawnTestProjectile(owner, target)
	projectileCount(owner).assertEquals(1)
	projectileXAt(owner, 0).assertEquals(35.)
	projectileDirectionAt(owner, 0).assertEquals(1)
	for frame = 1 to 29
		updateProjectilePair(owner, target)
	projectileCount(owner).assertEquals(1)
	updateProjectilePair(owner, target)
	projectileCount(owner).assertEquals(0)

@Test function falcoBlasterFlinchesWhileFoxBlasterDoesNot()
	let fox = new FighterState(0, 0, 1)
	let falcoTarget = new FighterState(1, 100, -1)
	spawnTestProjectile(fox, falcoTarget)
	updateProjectilePair(fox, falcoTarget)
	updateProjectilePair(fox, falcoTarget)
	falcoTarget.damage.assertEquals(3.)
	falcoTarget.hitstun.assertEquals(0)
	let falco = new FighterState(1, 0, 1)
	let foxTarget = new FighterState(0, 100, -1)
	spawnTestProjectile(falco, foxTarget)
	updateProjectilePair(falco, foxTarget)
	updateProjectilePair(falco, foxTarget)
	foxTarget.damage.assertEquals(3.)
	foxTarget.hitstun.assertEquals(11)

@Test function projectilePassesThroughAnIntangibleTargetWithoutConsumingIt()
	let owner = new FighterState(0, 0, 1)
	let target = new FighterState(1, 400, -1)
	target.invincible = 100
	spawnTestProjectile(owner, target)
	for frame = 1 to 11
		updateProjectilePair(owner, target)
	projectileCount(owner).assertEquals(1)
	target.invincible = 0
	for frame = 1 to 5
		updateProjectilePair(owner, target)
	target.damage.assertEquals(0.)
	projectileCount(owner).assertEquals(1)

function damageFromOneAttack(int style) returns real
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	resolveStartedAttack(style, attacker, target)
	let damage = target.damage
	destroy target
	destroy attacker
	return damage

function tiltDamageAt(int style, int facing, real targetX, real targetZ) returns real
	let attacker = new FighterState(0, 0, facing)
	let target = new FighterState(1, targetX, -facing)
	target.z = targetZ
	resolveStartedAttack(style, attacker, target)
	let damage = target.damage
	destroy target
	destroy attacker
	return damage

@Test function tiltsAreLighterAndRecoverSoonerThanSmashes()
	for style = 6 to 8
		damageFromOneAttack(style).assertLessThan(damageFromOneAttack(4))
		attackRecoveryFrames(style, true).assertLessThan(attackRecoveryFrames(2, true))
		attackRecoveryFrames(style, true).assertLessThan(attackRecoveryFrames(3, true))
		attackRecoveryFrames(style, true).assertLessThan(attackRecoveryFrames(4, true))
	damageFromOneAttack(6).assertEquals(10.)
	damageFromOneAttack(7).assertEquals(8.)
	damageFromOneAttack(8).assertEquals(8.)

@Test function angledForwardTiltsShareFlatForwardTiltTimingDamageAndRecovery()
	for style = 9 to 10
		attackStartupFrames(style).assertEquals(5)
		attackActiveFrames(style).assertEquals(2)
		attackDurationFrames(style).assertEquals(28)
		attackRecoveryFrames(style, true).assertEquals(21)

@Test function aerialNormalsHaveDistinctPhasesAndLandingLag()
	for style = AERIAL_NEUTRAL_STYLE to AERIAL_DOWN_STYLE
		isAerialAttack(style).assertTrue()
		attackStartupFrames(style).assertGreaterThan(0)
		attackActiveFrames(style).assertGreaterThan(0)
		attackLandingLag(style).assertGreaterThan(0)
		(attackDurationFrames(style) > attackStartupFrames(style) + attackActiveFrames(style)).assertTrue()
	(attackLandingLag(0) == 0).assertTrue()
	(isAerialAttack(11)).assertFalse()
	(isAerialAttack(17)).assertFalse()

@Test function groundNormalsAndGrabCannotStartInAirButBlasterCan()
	for style = 0 to 10
		if style != 1
			let fighter = new FighterState(0, 0, 1)
			let target = new FighterState(1, 1000, -1)
			fighter.grounded = false
			fighter.z = 100
			beginAttackPair(fighter, target, style, -1, false, false)
			fighter.attackStyle.assertEquals(-1)
			destroy target
			destroy fighter
	let groundTarget = new FighterState(1, 1000, -1)
	let grounded = new FighterState(0, 0, 1)
	beginAttackPair(grounded, groundTarget, AERIAL_NEUTRAL_STYLE, -1, false, false)
	grounded.attackStyle.assertEquals(-1)
	let airborne = new FighterState(0, 0, 1)
	airborne.grounded = false
	airborne.z = 100
	beginAttackPair(airborne, groundTarget, 1, -1, false, false)
	airborne.attackStyle.assertEquals(1)
	destroy airborne
	destroy grounded
	destroy groundTarget

function aerialDamageAt(int style, int facing, real targetX, real targetZ) returns real
	let attacker = new FighterState(0, 0, facing)
	let target = new FighterState(1, targetX, -facing)
	attacker.grounded = false
	attacker.z = 200
	target.z = targetZ
	beginAttackPair(attacker, target, style, -1, false, false)
	for frame = 1 to attackStartupFrames(style)
		attacker.attackFrame = attackStartupFrames(style)
		resolveAttackPair(attacker, target)
	let damage = target.damage
	destroy target
	destroy attacker
	return damage

@Test function aerialNormalsUseDirectionalShapesAndLaunchDirections()
	aerialDamageAt(AERIAL_FORWARD_STYLE, 1, 120, 200).assertGreaterThan(0.)
	aerialDamageAt(AERIAL_FORWARD_STYLE, 1, -120, 200).assertEquals(0.)
	aerialDamageAt(AERIAL_BACK_STYLE, 1, -120, 200).assertGreaterThan(0.)
	aerialDamageAt(AERIAL_BACK_STYLE, 1, 120, 200).assertEquals(0.)
	aerialDamageAt(AERIAL_UP_STYLE, 1, 0, 340).assertGreaterThan(0.)
	aerialDamageAt(AERIAL_UP_STYLE, 1, 0, 10).assertEquals(0.)
	aerialDamageAt(AERIAL_DOWN_STYLE, 1, 0, 50).assertGreaterThan(0.)
	aerialDamageAt(AERIAL_DOWN_STYLE, 1, 0, 191).assertEquals(0.)
	let bairAttacker = new FighterState(0, 0, 1)
	let bairTarget = new FighterState(1, -100, -1)
	bairAttacker.grounded = false
	bairAttacker.z = 200
	bairTarget.z = 200
	beginAttackPair(bairAttacker, bairTarget, AERIAL_BACK_STYLE, -1, false, false)
	bairAttacker.attackFrame = attackStartupFrames(AERIAL_BACK_STYLE)
	resolveAttackPair(bairAttacker, bairTarget)
	bairTarget.knockbackX.assertLessThan(0.)
	let dairAttacker = new FighterState(0, 0, 1)
	let dairTarget = new FighterState(1, 0, -1)
	dairAttacker.grounded = false
	dairAttacker.z = 200
	dairTarget.z = 150
	beginAttackPair(dairAttacker, dairTarget, AERIAL_DOWN_STYLE, -1, false, false)
	dairAttacker.attackFrame = attackStartupFrames(AERIAL_DOWN_STYLE)
	resolveAttackPair(dairAttacker, dairTarget)
	dairTarget.knockbackZ.assertLessThan(0.)
	destroy dairTarget
	destroy dairAttacker
	destroy bairTarget
	destroy bairAttacker

@Test function landingCancelsAerialActiveWindowAndAppliesMoveSpecificLag()
	for style = AERIAL_NEUTRAL_STYLE to AERIAL_DOWN_STYLE
		let fighter = new FighterState(0, 0, 1)
		fighter.grounded = false
		fighter.z = 1
		fighter.vz = -2
		let target = new FighterState(1, 50, -1)
		let input = new InputSnapshot()
		beginAttackPair(fighter, target, style, -1, false, false)
		fighter.attackFrame = attackStartupFrames(style)
		advance(fighter, 0, input, -240)
		fighter.grounded.assertTrue()
		fighter.attackStyle.assertEquals(-1)
		fighter.attackHit.assertFalse()
		fighter.landingLag.assertEquals(attackLandingLag(style))
		resolveAttackPair(fighter, target)
		target.damage.assertEquals(0.)
		destroy input
		destroy target
		destroy fighter

@Test function airDriftChangesVelocityWithoutTurningFighter()
	let fighter = new FighterState(0, 0, 1)
	fighter.grounded = false
	fighter.z = 100
	let input = new InputSnapshot()
	input.direction = -1
	advance(fighter, 0, input, -240)
	fighter.facing.assertEquals(1)
	fighter.vx.assertLessThan(0.)
