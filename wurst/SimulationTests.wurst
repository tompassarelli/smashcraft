	blockedTarget.diPending = true
	blockedTarget.diLaunchSpeed = 10
	shooter.projectileLife[0] = 1
	shooter.projectileX[0] = 0
	shooter.projectileZ[0] = 45
	updateProjectilePair(shooter, blockedTarget)
	blockedTarget.diPending.assertTrue()
	blockedTarget.diLaunchSpeed.assertEquals(10.)
