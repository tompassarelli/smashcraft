@Test function airDodgeProtectsOnlyFramesFourThroughTwentyNine()
	for character = 0 to 1
		for frame = 1 to 30
			let fighter = new FighterState(character, 100, -1)
			fighter.z = 300
			fighter.grounded = false
			simulationAirDodge(fighter, 0, 0)
			let input = new InputSnapshot()
			for tick = 1 to frame
				advance(fighter, 0, input, -240)
			let attacker = new FighterState(0, 0, 1)
			attacker.z = fighter.z
			attacker.attackStyle = 0
			attacker.attackFrame = attackStartupFrames(0)
			resolveAttackPair(attacker, fighter)
			fighter.damage.assertEquals(frame >= 4 and frame <= 29 ? 0. : 12.)
			destroy attacker
			destroy input
			destroy fighter

