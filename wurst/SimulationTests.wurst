function advanceDirectionalInput(FighterState fighter, InputSnapshot input, DirectionalInput direction)
	direction.update(input.direction, input.verticalDirection)
	input.sdiPulse = direction.pulsePending
	input.sdiX = direction.pulseX
	input.sdiZ = direction.pulseZ
	direction.clearPulse()
	advance(fighter, 0, input, -240)

@Test function smashDiPulsesOnNewAxisComponentsButNotOnHeldOrRemovedComponents()
	let fighter = new FighterState(0, 0, 1)
	fighter.grounded = false
	fighter.z = 400
	fighter.hitlag = 8
	fighter.diPending = true
	fighter.diLaunchSpeed = 10
	let input = new InputSnapshot()
	let direction = new DirectionalInput()
	input.direction = 1
	advanceDirectionalInput(fighter, input, direction)
	fighter.x.assertEquals(SDI_DISTANCE)
	fighter.sdiSerial.assertEquals(1)
	advanceDirectionalInput(fighter, input, direction)
	fighter.x.assertEquals(SDI_DISTANCE)
	fighter.sdiSerial.assertEquals(1)
	input.verticalDirection = 1
	advanceDirectionalInput(fighter, input, direction)
	fighter.x.assertEquals(SDI_DISTANCE + SDI_DISTANCE * 0.7071067811865476, 0.001)
	fighter.z.assertEquals(400 + SDI_DISTANCE * 0.7071067811865476, 0.001)
	fighter.sdiSerial.assertEquals(2)
	input.verticalDirection = 0
	advanceDirectionalInput(fighter, input, direction)
	fighter.sdiSerial.assertEquals(2)
	input.direction = -1
	advanceDirectionalInput(fighter, input, direction)
	fighter.x.assertEquals(SDI_DISTANCE * 0.7071067811865476, 0.001)
	fighter.sdiSerial.assertEquals(3)
	destroy direction
	destroy input
	destroy fighter

