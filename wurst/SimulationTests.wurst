@Test function angledForwardTiltsCoverTheirVerticalOffsetAndPreserveFacingRange()
	tiltDamageAt(9, 1, 100, 150).assertEquals(10.)
	tiltDamageAt(9, 1, 100, -150).assertEquals(0.)
