@Test function initialDashHitlagFreezesThenReversalResumes()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	input.direction = 1
	advance(fighter, 0, input, 0)
	fighter.hitlag = 2
	input.direction = -1
	for tick = 1 to 2
		advance(fighter, 0, input, 0)
		fighter.x.assertEquals(11.4, 0.001)
		fighter.dashFrame.assertEquals(1)
	advance(fighter, 0, input, 0)
	fighter.vx.assertEquals(-11.4, 0.001)
	fighter.dashFrame.assertEquals(1)
	fighter.hitstun = 3
	advance(fighter, 0, input, 0)
	fighter.dashFrame.assertEquals(0)
	destroy input
	destroy fighter

@Test function initialDashClearsOnJumpShieldAttackAndStockReset()
	for interruption = 0 to 3
		let fighter = new FighterState(0, 0, 1)
		let target = new FighterState(1, 300, -1)
		let input = new InputSnapshot()
		input.direction = 1
		advance(fighter, 0, input, 0)
		if interruption == 0
			input.jumpPressed = true
			input.jumpHeld = true
			advance(fighter, 0, input, 0)
			fighter.jumpSquat.assertEquals(2)
		else if interruption == 1
			input.shield = true
			advance(fighter, 0, input, 0)
			fighter.shield.assertTrue()
		else if interruption == 2
			beginAttackPair(fighter, target, 0, -1, false, false)
			fighter.attackStyle.assertEquals(0)
		else
			fighter.x = 930
			advance(fighter, 0, input, 0)
			fighter.out.assertTrue()
			fighter.dashFrame.assertEquals(0)
			reset(fighter, 0)
		fighter.dashFrame.assertEquals(0)
		fighter.dashDirection.assertEquals(0)
		destroy input
		destroy target
		destroy fighter

@Test function blasterRecoveryUsesGroundingAtAttackStart()
	let grounded = new FighterState(0, 0, 1)
	let targetA = new FighterState(1, 400, -1)
	beginAttackPair(grounded, targetA, 1, -1, false, false)
	grounded.attackDuration.assertEquals(24)
	grounded.cooldown.assertEquals(24)
	grounded.grounded = false
	let airborne = new FighterState(0, 0, 1)
	airborne.grounded = false
	airborne.z = 120
	let targetB = new FighterState(1, 400, -1)
	beginAttackPair(airborne, targetB, 1, -1, false, false)
	airborne.attackDuration.assertEquals(15)
	airborne.cooldown.assertEquals(15)
	airborne.grounded = true
	let input = new InputSnapshot()
	var groundedTicks = 0
	while grounded.attackStyle >= 0
		advance(grounded, 0, input, -240)
		groundedTicks++
	var airborneTicks = 0
	while airborne.attackStyle >= 0
		advance(airborne, 0, input, -240)
		airborneTicks++
	groundedTicks.assertEquals(24)
	airborneTicks.assertEquals(15)
	grounded.cooldown.assertEquals(0)
	airborne.cooldown.assertEquals(0)

