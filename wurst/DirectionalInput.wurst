package DirectionalInput

public class DirectionalInput
    int heldX = 0
    int heldZ = 0
    boolean pulsePending = false
    int pulseX = 0
    int pulseZ = 0

    function update(int x, int z)
        let nextX = x == 0 ? 0 : (x < 0 ? -1 : 1)
        let nextZ = z == 0 ? 0 : (z < 0 ? -1 : 1)
        let enteredX = nextX != 0 and nextX != heldX
        let enteredZ = nextZ != 0 and nextZ != heldZ
        if enteredX or enteredZ
            pulsePending = true
            pulseX = nextX
            pulseZ = nextZ
        heldX = nextX
        heldZ = nextZ

    function clearPulse()
        pulsePending = false
        pulseX = 0
        pulseZ = 0

    function clear()
        heldX = 0
        heldZ = 0
        clearPulse()
