package CommandBuffer

public function queueHumanAttack(AttackBuffer first, AttackBuffer second, int slot, int style, int direction, int completedFrame)
    if slot < 0 or slot > 1
        return
    let commands = slot == 0 ? first : second
    commands.enqueue(style, direction, completedFrame + 1, false)

function attackPriority(int style, boolean mayCharge) returns int
    if style == 5
        return 5
    if style >= 2 and style <= 4
        return mayCharge ? 3 : 4
    if style >= 6
        return 2
    return style

// Frame numbers are logical simulation frames, never wall-clock timestamps.
public class AttackBuffer
    int windowFrames
    int style = -1
    int facing = 0
    int targetFrame = -1
    int consumedFacing = 0
    boolean mayCharge = false
    boolean consumedMayCharge = false

    construct(int graceFrames)
        windowFrames = max(0, graceFrames)

    function clear()
        style = -1
        facing = 0
        targetFrame = -1
        consumedFacing = 0
        mayCharge = false
        consumedMayCharge = false

    function enqueue(int attackStyle, int direction, int frame, boolean chargeAllowed)
        if attackStyle < 0 or attackStyle > 10
            return
        // Same-frame directional commands take priority over neutral attacks.
        if targetFrame == frame and (attackPriority(style, mayCharge) > attackPriority(attackStyle, chargeAllowed) or (attackPriority(style, mayCharge) == attackPriority(attackStyle, chargeAllowed) and style > attackStyle))
            return
        if targetFrame == frame and style == attackStyle and mayCharge == chargeAllowed and facing != direction
            facing = 0
            return
        style = attackStyle
        mayCharge = chargeAllowed
        facing = direction
        targetFrame = frame

    function hasPending(int frame) returns boolean
        return style >= 0 and frame >= targetFrame and frame - targetFrame <= windowFrames

    function consume(int frame, boolean allowed) returns int
        consumedFacing = 0
        consumedMayCharge = false
        if not hasPending(frame)
            if style >= 0 and frame >= targetFrame
                clear()
            return -1
        if not allowed
            return -1
        let result = style
        consumedFacing = facing
        consumedMayCharge = mayCharge
        style = -1
        return result
