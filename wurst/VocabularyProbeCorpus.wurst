package VocabularyProbeCorpus
import NetworkInput
import InputProtocol
import KeyBindings

public constant int VOCABULARY_PROBE_EPOCH = 36
public constant int VOCABULARY_PROBE_SAMPLES = 300

public function vocabularyProbeRate(int arm) returns int
    return arm < 3 ? 30 : 60

public function vocabularyProbeRows(int arm) returns int
    return arm < 3 ? 2 : 1

public function vocabularyProbeFrame(int arm, int sequence) returns int
    return sequence * vocabularyProbeRows(arm) + 1

function heldAt(int sender, int frame) returns int
    if frame < 1
        return 0
    var held = inputActionBit(((frame div 45 + sender) mod 2 == 0) ? MOVE_RIGHT : MOVE_LEFT)
    if frame mod 24 < 8
        held += inputActionBit(LEFT_TRIGGER)
    if frame mod 19 == 0
        held += inputActionBit(ATTACK)
    if frame mod 31 == 0
        held += inputActionBit(SPECIAL)
    return held

public function vocabularyProbeRow(int sender, int frame, NetworkInput row) returns boolean
    let held = heldAt(sender, frame)
    let previous = heldAt(sender, frame - 1)
    var pressed = 0
    var released = 0
    for action = 0 to ACTION_COUNT - 1
        let bit = inputActionBit(action)
        if (held div bit) mod 2 == 1 and (previous div bit) mod 2 == 0
            pressed += bit
        if (held div bit) mod 2 == 0 and (previous div bit) mod 2 == 1
            released += bit
    // A completed short jump tap retains both edges with no held bit.
    if frame mod 37 == 0
        pressed += inputActionBit(JUMP)
        released += inputActionBit(JUMP)
    if not row.assign(held, pressed, released, (frame * 7 + sender * 29) mod 255 - 127,
            (frame * 11 + sender * 13) mod 255 - 127,
            frame mod 24 < 8 ? (frame * 17) mod 256 : 0, (frame * 5) mod 256)
        return false
    return row.assignPressData(row.actionPressed(SPECIAL) ? 1 : 0, 0,
        row.actionPressed(LEFT_TRIGGER) ? -1 : 0, 0,
        frame mod 23 == 0, frame mod 23 == 0 ? 1 : 0, 0, 0)

public class VocabularyProbeEncoder
    private NetworkInput first = new NetworkInput()
    private NetworkInput second = new NetworkInput()
    private InputPacket packet = new InputPacket()

    function encode(int sender, int arm, int sequence) returns string
        let frame = vocabularyProbeFrame(arm, sequence)
        if not vocabularyProbeRow(sender, frame, first) or not vocabularyProbeRow(sender, frame + 1, second)
            return ""
        if not packet.assign(VOCABULARY_PROBE_EPOCH, frame, vocabularyProbeRows(arm), first, second)
            return ""
        return packet.encode()
