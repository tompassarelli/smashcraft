package ReplayStateTests
import WorldTestSupport
import ReplayState
import Simulation
import MatchRules
import CommandBuffer
import MatchStep

@Test function practiceMatchReplayRestoresModeAndDetectsDifference()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStageSelect(0)
    game.requestStart(0)
    let first = new FighterState(0, -240, 1)
    let second = new FighterState(1, 240, -1)
    initializeMatchFighters(game, testWorld(first, second))
    let commands = new AttackBuffer(0)
    let otherCommands = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()
    let actual = new ReplaySnapshot()
    snapshot.capture(testWorld(first, second), game, testCommands(commands, otherCommands), runtime)
    game.practice = false
    actual.capture(testWorld(first, second), game, testCommands(commands, otherCommands), runtime)
    snapshot.firstDifference(actual).assertEquals("match.practice")
    snapshot.restore(testWorld(first, second), game, testCommands(commands, otherCommands), runtime)
    game.practice.assertTrue()
    actual.capture(testWorld(first, second), game, testCommands(commands, otherCommands), runtime)
    snapshot.firstDifference(actual).assertEquals("")
    destroy actual
    destroy snapshot
    destroy runtime
    destroy otherCommands
    destroy commands
    destroy second
    destroy first
    destroy game

@Test function rematchCanReuseFirstFrameRecord()
    let row = new MatchFrameInput()
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstRequests = new AttackBuffer(0)
    let secondRequests = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    row.capture(1, 3, testControls(firstInput, secondInput, firstRequests, secondRequests), runtime).assertTrue()
    row.capture(1, 3, testControls(firstInput, secondInput, firstRequests, secondRequests), runtime).assertFalse()
    row.reset()
    row.capture(1, 3, testControls(firstInput, secondInput, firstRequests, secondRequests), runtime).assertTrue()

@Test function captureRestoreIncludesCombatPointersProjectilesAndQueuedInput()
    let first = new FighterState(0, -90, 1)
    let second = new FighterState(1, 90, -1)
    let match = new MatchState()
    let firstCommands = new AttackBuffer(4)
    let secondCommands = new AttackBuffer(4)
    let runtime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()

    first.x = -123.5
    first.positionDeltaX = 0.125
    first.positionDeltaZ = -0.25
    first.damage = 47
    first.hitVisualSerial = 7
    first.hitVisualElectric = true
    first.shieldVisualSerial = 3
    first.hitlag = 3
    first.shieldBreakState = SHIELD_BREAK_DIZZY
    first.shieldBreakRemaining = 389.75
    first.crouching = true
    first.fastFalling = true
    first.groundDodgeEntryFacing = -1
    first.jumpDodgeQueued = true
    first.jumpDodgeX = -1
    first.jumpDodgeZ = 1
    first.techWindow = 11
    first.projectileLife[3] = 27
    first.projectileX[3] = -44.25
    first.projectileZ[3] = 81.5
    first.projectileDirection[3] = -1
    first.shieldPushbackX = 2.73600035905838
    first.shieldRecoilX = -1.8
    first.shieldRecoilZ = 2.4
    first.shieldDrainResumePending = true
    first.lastHitAttacker = second
    first.lastHitAttackSerial = 19
    first.lastHitWindow = 2
    match.phase = MATCH
    match.remainingFrames = 91
    match.winner = 1
    runtime.simulationFrame = 38
    runtime.botAttackDelays[1] = 0.17
    firstCommands.enqueue(4, -1, 38, true)
    secondCommands.enqueue(6, 1, 40, false)

    snapshot.capture(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)

    first.x = 700
    first.positionDeltaX = 0
    first.positionDeltaZ = 0
    first.damage = 0
    first.hitlag = 0
    first.hitVisualSerial = 0
    first.hitVisualElectric = false
    first.shieldVisualSerial = 0
    first.shieldBreakState = SHIELD_BREAK_NONE
    first.shieldBreakRemaining = 0.
    first.crouching = false
    first.fastFalling = false
    first.groundDodgeEntryFacing = 0
    first.jumpDodgeQueued = false
    first.jumpDodgeX = 0
    first.jumpDodgeZ = 0
    first.techWindow = 0
    first.projectileLife[3] = 0
    first.projectileX[3] = 0
    first.projectileZ[3] = 0
    first.projectileDirection[3] = 0
    first.shieldPushbackX = 0
    first.shieldRecoilX = 0
    first.shieldRecoilZ = 0
    first.shieldDrainResumePending = false
    first.lastHitAttacker = null
    first.lastHitAttackSerial = -1
    match.phase = RESULT
    match.remainingFrames = 0
    match.winner = -1
    runtime.simulationFrame = 0
    runtime.botAttackDelays[1] = 0
    firstCommands.clear()
    secondCommands.clear()

    snapshot.restore(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)

    first.x.assertEquals(-123.5)
    first.positionDeltaX.assertEquals(0.125)
    first.positionDeltaZ.assertEquals(-0.25)
    first.damage.assertEquals(47)
    first.hitlag.assertEquals(3)
    first.hitVisualSerial.assertEquals(7)
    first.hitVisualElectric.assertTrue()
    first.shieldVisualSerial.assertEquals(3)
    first.shieldBreakState.assertEquals(SHIELD_BREAK_DIZZY)
    first.shieldBreakRemaining.assertEquals(389.75)
    first.crouching.assertTrue()
    first.fastFalling.assertTrue()
    first.groundDodgeEntryFacing.assertEquals(-1)
    first.jumpDodgeQueued.assertTrue()
    first.jumpDodgeX.assertEquals(-1)
    first.jumpDodgeZ.assertEquals(1)
    first.techWindow.assertEquals(11)
    first.projectileLife[3].assertEquals(27)
    first.projectileX[3].assertEquals(-44.25)
    first.projectileZ[3].assertEquals(81.5)
    first.projectileDirection[3].assertEquals(-1)
    first.shieldPushbackX.assertEquals(2.73600035905838)
    first.shieldRecoilX.assertEquals(-1.8)
    first.shieldRecoilZ.assertEquals(2.4)
    first.shieldDrainResumePending.assertTrue()
    (first.lastHitAttacker == second).assertTrue()
    first.lastHitAttackSerial.assertEquals(19)
    first.lastHitWindow.assertEquals(2)
    match.phase.assertEquals(MATCH)
    match.remainingFrames.assertEquals(91)
    match.winner.assertEquals(1)
    runtime.simulationFrame.assertEquals(38)
    runtime.botAttackDelays[1].assertEquals(0.17)
    firstCommands.hasPending(38).assertTrue()
    secondCommands.hasPending(40).assertTrue()

@Test function restoreAndReplayPreservesMovementAndClock()
    let first = new FighterState(0, -30, 1)
    let second = new FighterState(1, 30, -1)
    let match = new MatchState()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()
    match.phase = MATCH
    snapshot.capture(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)

    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    firstInput.direction = 1
    secondInput.direction = -1
    firstInput.jumpPressed = true
    firstInput.jumpHeld = true
    for frame = 0 to 47
        firstInput.jumpPressed = frame == 0
        stepMatch(match, testWorld(first, second), testControls(firstInput, secondInput, firstCommands, secondCommands), frame)
    let expectedX = first.x
    let expectedZ = first.z
    let expectedVx = first.vx
    let expectedVz = first.vz
    let expectedStocks = first.stocks
    let expectedDamage = first.damage
    let expectedSecondX = second.x
    let expectedSecondZ = second.z
    let expectedRemaining = match.remainingFrames

    snapshot.restore(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)
    firstInput.direction = 1
    secondInput.direction = -1
    firstInput.jumpHeld = true
    for frame = 0 to 47
        firstInput.jumpPressed = frame == 0
        stepMatch(match, testWorld(first, second), testControls(firstInput, secondInput, firstCommands, secondCommands), frame)

    first.x.assertEquals(expectedX)
    first.z.assertEquals(expectedZ)
    first.vx.assertEquals(expectedVx)
    first.vz.assertEquals(expectedVz)
    first.stocks.assertEquals(expectedStocks)
    first.damage.assertEquals(expectedDamage)
    second.x.assertEquals(expectedSecondX)
    second.z.assertEquals(expectedSecondZ)
    match.remainingFrames.assertEquals(expectedRemaining)

@Test function restoreIntoIndependentFightersRetainsContactRegistry()
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 100, -1)
    let match = new MatchState()
    let commandsA = new AttackBuffer(0)
    let commandsB = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()
    match.phase = MATCH
    commandsA.enqueue(0, 0, 1, false)
    let inputA = new InputSnapshot()
    let inputB = new InputSnapshot()
    for frame = 1 to attackStartupFrames(0) + 1
        stepMatch(match, testWorld(first, second), testControls(inputA, inputB, commandsA, commandsB), frame)
    second.damage.assertGreaterThan(0.)
    (second.lastHitAttacker == first).assertTrue()
    snapshot.capture(testWorld(first, second), match, testCommands(commandsA, commandsB), runtime)
    let replayFirst = new FighterState(0, 0, 1)
    let replaySecond = new FighterState(1, 0, -1)
    snapshot.restore(testWorld(replayFirst, replaySecond), match, testCommands(commandsA, commandsB), runtime)
    (replaySecond.lastHitAttacker == replayFirst).assertTrue()
    (replaySecond.lastHitAttacker == first).assertFalse()
    let damage = replaySecond.damage
    // The same active attack window must not score a second hit after restoration.
    resolveAttacks(testWorld(replayFirst, replaySecond))
    replaySecond.damage.assertEquals(damage)
    first.damage = 999.
    second.projectileLife[0] = 999
    snapshot.restore(testWorld(replayFirst, replaySecond), match, testCommands(commandsA, commandsB), runtime)
    replayFirst.damage.assertEquals(0.)
    replaySecond.projectileLife[0].assertEquals(0)

@Test function recordedRowsReplayAttackShieldContactFromIndependentRestoredFighters()
    let game = new MatchState()
    game.phase = MATCH
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 100, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstRequests = new AttackBuffer(0)
    let secondRequests = new AttackBuffer(0)
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    let before = new ReplaySnapshot()
    MatchFrameInput array[16] rows
    before.capture(testWorld(first, second), game, testCommands(firstCommands, secondCommands), runtime)

    secondInput.shield = true
    var maximumShieldStun = 0
    for frame = 1 to 16
        rows[frame - 1] = new MatchFrameInput()
        if frame == 1
            firstRequests.enqueue(0, 0, 1, false)
        rows[frame - 1].capture(frame, 3, testControls(firstInput, secondInput, firstRequests, secondRequests), runtime).assertTrue()
        firstRequests.clear()
        secondRequests.clear()
        if frame == 1
            // Mutating producer storage after capture must not change the recorded row.
            firstInput.shield = true
            rows[0].capture(frame, 3, testControls(firstInput, secondInput, firstRequests, secondRequests), runtime).assertFalse()
            firstInput.shield = false
        rows[frame - 1].execute(game, testWorld(first, second), testCommands(firstCommands, secondCommands), runtime, frame).assertTrue()
        maximumShieldStun = max(maximumShieldStun, second.shieldStun)

    first.attackSerial.assertEquals(1)
    second.damage.assertEquals(0.)
    maximumShieldStun.assertGreaterThan(0)
    second.shieldEnergy.assertLessThan(60.)
    let expectedShieldStun = maximumShieldStun
    let expectedShield = second.shieldEnergy
    let expectedAttackFrame = first.attackFrame
    let expectedFirstX = first.x
    let expectedSecondX = second.x
    let expectedClock = game.remainingFrames

    let recoveredFirst = new FighterState(0, 800, 1)
    let recoveredSecond = new FighterState(1, -800, -1)
    let recoveredGame = new MatchState()
    recoveredGame.phase = RESULT
    let recoveredFirstCommands = new AttackBuffer(3)
    let recoveredSecondCommands = new AttackBuffer(3)
    let recoveredRuntime = new ReplayRuntimeState()
    before.restore(testWorld(recoveredFirst, recoveredSecond), recoveredGame, testCommands(recoveredFirstCommands, recoveredSecondCommands), recoveredRuntime)
    var replayMaximumShieldStun = 0
    for frame = 1 to 16
        rows[frame - 1].execute(recoveredGame, testWorld(recoveredFirst, recoveredSecond), testCommands(recoveredFirstCommands, recoveredSecondCommands), recoveredRuntime, frame).assertTrue()
        replayMaximumShieldStun = max(replayMaximumShieldStun, recoveredSecond.shieldStun)

    recoveredFirst.attackSerial.assertEquals(1)
    recoveredSecond.damage.assertEquals(0.)
    replayMaximumShieldStun.assertEquals(expectedShieldStun)
    recoveredSecond.shieldEnergy.assertEquals(expectedShield)
    recoveredFirst.attackFrame.assertEquals(expectedAttackFrame)
    recoveredFirst.x.assertEquals(expectedFirstX)
    recoveredSecond.x.assertEquals(expectedSecondX)
    recoveredGame.remainingFrames.assertEquals(expectedClock)

@Test function exactDifferencePreservesSmallRealsAndCanonicalAttackerSlots()
    let expected = new ReplaySnapshot()
    let actual = new ReplaySnapshot()
    expected.world.fighters[0].lastHitAttacker = expected.world.fighters[1]
    actual.world.fighters[0].lastHitAttacker = actual.world.fighters[1]
    expected.firstDifference(actual).assertEquals("")
    actual.world.fighters[0].x = 0.000001
    expected.firstDifference(actual).assertEquals("fighter[0].x")
    actual.world.fighters[0].x = expected.world.fighters[0].x
    actual.world.fighters[0].lastHitAttacker = actual.world.fighters[0]
    expected.firstDifference(actual).assertEquals("fighter[0].lastHitAttacker")
    actual.world.fighters[0].lastHitAttacker = actual.world.fighters[1]
    actual.world.fighters[1].projectileZ[PROJECTILE_CAPACITY - 1] = 0.000001
    expected.firstDifference(actual).assertEquals("fighter[1].projectileZ[" + I2S(PROJECTILE_CAPACITY - 1) + "]")
    actual.world.fighters[1].projectileZ[PROJECTILE_CAPACITY - 1] = 0
    actual.world.fighters[1].shieldRecoilZ = 0.000001
    expected.firstDifference(actual).assertEquals("fighter[1].shieldRecoilZ")
    actual.world.fighters[1].shieldRecoilZ = 0
    actual.world.fighters[1].positionDeltaZ = 0.000001
    expected.firstDifference(actual).assertEquals("fighter[1].positionDeltaZ")
    actual.world.fighters[1].positionDeltaZ = 0
    actual.match.rematchReadiness[0] = true
    expected.firstDifference(actual).assertEquals("match.slot0.rematch")
    actual.match.rematchReadiness[0] = false
    actual.controls.commands[1].consumedMayCharge = true
    expected.firstDifference(actual).assertEquals("commands[1].consumedMayCharge")
    actual.controls.commands[1].consumedMayCharge = false
    actual.runtime.botAttackDelays[1] = 0.000001
    expected.firstDifference(actual).assertEquals("runtime.botAttackDelays[1]")

@Test function everyPhysicsParameterSurvivesCaptureRestoreAndParticipatesInEquality()
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 100, -1)
    let match = new MatchState()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    let runtime = new ReplayRuntimeState()
    let expected = new ReplaySnapshot()
    let actual = new ReplaySnapshot()
    // Distinct from every roster default, so restore cannot silently reinitialize tuning.
    first.physics = fighterPhysics(101, 2, 17, 23, 0.7, 6, 0.3, 25, 0.9, 13, 15, 8, 7, 26, 14, 29, 0.6, 5, 12, 7, 21, 0.17, 0.08, 0.11, 0.03, 28)
    let assigned = first.physics
    expected.capture(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)
    first.physics = demonHunterPhysics()
    expected.restore(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)
    (first.physics == assigned).assertTrue()
    actual.capture(testWorld(first, second), match, testCommands(firstCommands, secondCommands), runtime)
    expected.firstDifference(actual).assertEquals("")
    actual.world.fighters[0].physics.weight += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.gravity += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.terminalSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.fastFallSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.airAcceleration += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.airSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.airFriction += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.airCap += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.traction += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.dashSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.runSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.walkSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.walkAccelerationMultiplier += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.walkAccelerationBase += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.jumpSquatFrames += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
    actual.world.fighters[0].physics = assigned
    actual.world.fighters[0].physics.fullJumpSpeed += 1
    expected.firstDifference(actual).assertEquals("fighter[0].physics")
