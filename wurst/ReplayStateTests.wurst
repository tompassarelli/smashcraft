@Test function fastFallStateChangesEverySlotChecksumAndSurvivesRollback()
    let source = new ReplaySnapshot()
    let restored = new ReplaySnapshot()
    source.world.mask = 15
    restored.world.mask = 15
    let neutralChecksum = source.checksum()
    for slot = 0 to 3
        source.world.fighters[slot].fastFalling = true
        source.firstDifference(restored).assertEquals("fighter[" + I2S(slot) + "].fastFalling")
        (source.checksum() != neutralChecksum).assertTrue()
        source.restore(restored.world, restored.match, restored.controls, restored.runtime)
        restored.world.fighters[slot].fastFalling.assertTrue()
        restored.firstDifference(source).assertEquals("")
        restored.checksum().assertEquals(source.checksum())
        source.world.fighters[slot].fastFalling = false
        restored.world.fighters[slot].fastFalling = false
