// The test-only reference rig uses PlFc.dat movement values from the locally
// identified NTSC 1.02 extraction; it never changes playable fighter defaults.
@Test function retailWalkUsesCharacterAccelerationAndCommonTaper()
	for hostCharacter = 0 to 1
		let f = new FighterState(hostCharacter, 0, 1)
		f.physics = falcoReferencePhysics()
		let input = new InputSnapshot()
		input.direction = 1
		input.walking = true
		advance(f, 0, input, 0)
		f.vx.assertEquals(1.8, 0.00001)
		advance(f, 0, input, 0)
		f.vx.assertEquals(2.5071428, 0.00001)
		advance(f, 0, input, 0)
		f.vx.assertEquals(3.1385202, 0.00001)
		advance(f, 0, input, 0)
		f.vx.assertEquals(3.7022507, 0.00001)
		destroy input
		destroy f

@Test function retailRunTapersBelowTargetAndBrakesOverspeedByCharacterFriction()
	let belowTarget = new FighterState(0, 0, 1)
	belowTarget.physics = falcoReferencePhysics()
	belowTarget.vx = 0.9 * 6
	belowTarget.dashFrame = INITIAL_DASH_FRAMES + 1
	belowTarget.dashDirection = 1
	belowTarget.groundAction = GROUND_ACTION_RUN
	let input = new InputSnapshot()
	input.direction = 1
	advance(belowTarget, 0, input, 0)
	belowTarget.vx.assertEquals(5.5152, 0.00001)

	let overspeed = new FighterState(0, 100, 1)
	overspeed.physics = falcoReferencePhysics()
	overspeed.vx = 1.9 * 6
	overspeed.dashFrame = INITIAL_DASH_FRAMES + 1
	overspeed.dashDirection = 1
	overspeed.groundAction = GROUND_ACTION_RUN
	advance(overspeed, 0, input, 0)
	overspeed.vx.assertEquals(1.82 * 6, 0.00001)
	destroy input
	destroy belowTarget
	destroy overspeed

@Test function retailRunTurnPreservesFacingUntilGroundVelocityCrosses()
	let f = new FighterState(0, 0, 1)
	f.physics = falcoReferencePhysics()
	f.vx = 1. * 6
	f.dashFrame = INITIAL_DASH_FRAMES + 1
	f.dashDirection = 1
	f.groundAction = GROUND_ACTION_TURN_RUN
	f.groundTurnRunEntryFacing = 1
	let input = new InputSnapshot()
	input.direction = -1
	for tick = 1 to 9
		advance(f, 0, input, 0)
	f.vx.assertEquals(-0.48, 0.00001)
	f.facing.assertEquals(1)
	advance(f, 0, input, 0)
	f.vx.assertEquals(-1.2, 0.00001)
	f.facing.assertEquals(-1)
	f.groundAction.assertEquals(GROUND_ACTION_TURN_RUN)
	destroy input
	destroy f

