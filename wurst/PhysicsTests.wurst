@Test function groundedKnockbackMatchesRecordedFirstReleasedDisplacement()
	for character = 0 to 1
		let f = new FighterState(character, -11.548782348632812 * 6, 1)
		// Captain Falcon observation: only the observed traction is required here.
		f.physics.traction = 0.07999999821186066 * 6
		let input = new InputSnapshot()
		f.knockbackX = 0.7562744617462158 * 6
		f.hitstun = 10
		input.down = true
		input.verticalDirection = -1
		advance(f, 0, input, 0)
		f.knockbackX.assertEquals(0.6762744784355164 * 6, 0.00001)
		f.x.assertEquals(-10.87250804901123 * 6, 0.0001)
		f.hitstun.assertEquals(9)
		f.grounded.assertTrue()
		destroy input
		destroy f

