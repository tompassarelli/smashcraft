		destroy target
		destroy owner

@Test function sameCharacterUsesAssignedGravityAndJumpParameters()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	first.physics.gravity = 1.5
	second.physics.gravity = 3
	first.grounded = false
	second.grounded = false
	first.z = 96
	second.z = 96
	advance(first, 0, input, 0)
	advance(second, 0, input, 0)
	first.z.assertEquals(94.5)
	second.z.assertEquals(93.)
	first.vz.assertEquals(-1.5)
	second.vz.assertEquals(-3.)
	first.grounded = true
	second.grounded = true
	first.z = 0
	second.z = 0
	first.physics.jumpSquatFrames = 2
	second.physics.jumpSquatFrames = 4
	first.physics.fullJumpSpeed = 15
	second.physics.fullJumpSpeed = 20
	input.jumpPressed = true
	input.jumpHeld = true
	advance(first, 0, input, 0)
	advance(second, 0, input, 0)
	input.jumpPressed = false
	for frame = 1 to 2
		advance(first, 0, input, 0)
		advance(second, 0, input, 0)
	first.grounded.assertFalse()
	first.z.assertEquals(15.)
	first.vz.assertEquals(15.)
	second.grounded.assertTrue()
	second.jumpSquat.assertEquals(2)
	for frame = 1 to 2
		advance(second, 0, input, 0)
	second.z.assertEquals(20.)
	second.vz.assertEquals(20.)
	destroy first
	destroy second
	destroy input

@Test function sameCharacterUsesAssignedWeightForActualDamageContact()
	for sample = 0 to 1
		let owner = new FighterState(0, 0, 1)
		let target = new FighterState(0, 100, -1)
		target.physics.weight = sample == 0 ? 50 : 150
		beginAttackPair(owner, target, 0, -1, false, false)
		owner.attackFrame = attackStartupFrames(0)
		resolveAttackPair(owner, target)
		target.damage.assertEquals(12.)
		// Jab at 12 percent: ((12/10 + 12*12/20)*200/(weight+100)*1.4+18)+20.
		target.diLaunchSpeed.assertEquals(sample == 0 ? 9.6624 : 8.53344, 0.00001)
		destroy owner
		destroy target

