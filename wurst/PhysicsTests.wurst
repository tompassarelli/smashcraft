package PhysicsTests
import Simulation
import ReplayState
import Binary32

function retailCombatContact(FighterState owner, FighterState target, real knockback, real dx, real dz)
	beginDamageContacts()
	queueDamageContact(owner, target, hitEffect(5, 0, knockback, dx, dz, false), 1, CONTACT_LAUNCH, false, null)
	finishDamageContacts(owner, target)

@Test function retailCombatStackingStartsOnTenthMovingFrameAndFreezesInHitlag()
	for age = 9 to 10
		let owner = new FighterState(0, -300, 1)
		let target = new FighterState(1, -100, -1)
		let input = new InputSnapshot()
		target.grounded = false
		target.z = 300
		retailCombatContact(owner, target, 100, 1, 0)
		target.knockbackAgeFrames.assertEquals(0)
		target.knockbackX.assertEquals(17.9999995977, 0.000001)
		for frozenFrame = 1 to 3
			advance(target, 0, input, 0)
			target.knockbackAgeFrames.assertEquals(0)
			target.x.assertEquals(-100.)
		for movingFrame = 1 to age
			advance(target, 0, input, 0)
			target.knockbackAgeFrames.assertEquals(movingFrame)
		let residual = target.knockbackX
		retailCombatContact(owner, target, 20, 1, 0)
		if age == 9
			target.knockbackX.assertEquals(3.5999999195, 0.000001)
		else
			target.knockbackX.assertEquals(residual)
		target.knockbackAgeFrames.assertEquals(0)
		target.hitstun.assertEquals(8)
		destroy input
		destroy target
		destroy owner

@Test function retailCombatStackingMergesEachAxisOnceAfterStrongestContactSelection()
	let owner = new FighterState(0, 0, 1)
	let target = new FighterState(1, 100, -1)
	target.grounded = false
	target.z = 300
	target.knockbackX = 18
	target.knockbackZ = -9
	target.knockbackAgeFrames = 10
	beginDamageContacts()
	queueDamageContact(owner, target, hitEffect(5, 0, 100, -0.6, 0.8, false), 1, CONTACT_LAUNCH, false, null)
	queueDamageContact(owner, target, hitEffect(5, 0, 20, 1, 0, false), 1, CONTACT_LAUNCH, false, null)
	finishDamageContacts(owner, target)
	target.damage.assertEquals(10.)
	target.knockbackX.assertEquals(7.2000002414, 0.000001)
	target.knockbackZ.assertEquals(5.3999996781, 0.000001)
	target.damageLevel.assertEquals(3)
	target.hitstun.assertEquals(40)
	// A weaker same-direction axis is retained; an incoming zero cannot erase it.
	target.knockbackAgeFrames = 10
	retailCombatContact(owner, target, 20, 0, 1)
	target.knockbackX.assertEquals(7.2000002414, 0.000001)
	target.knockbackZ.assertEquals(5.3999996781, 0.000001)
	target.knockbackAgeFrames = 10
	retailCombatContact(owner, target, 100, -1, -1)
	target.knockbackX.assertEquals(-10.7999993563, 0.000001)
	target.knockbackZ.assertEquals(-12.5999999196, 0.000001)
	destroy target
	destroy owner

@Test function retailCombatGroundTangentUsesNewContactThenTractionRatherThanAirDecay()
	for facing = -1 to 1
		if facing != 0
			let owner = new FighterState(0, -100, 1)
			let target = new FighterState(1, 0, -1)
			let input = new InputSnapshot()
			target.surface = 0
			target.knockbackX = facing * 30.
			target.knockbackAgeFrames = 10
			retailCombatContact(owner, target, 20, facing * 1., -1)
			target.grounded.assertTrue()
			target.knockbackX.assertEquals(facing * 30.)
			target.groundKnockbackX.assertEquals(facing * 3.5999999195, 0.000001)
			for frame = 1 to 4
				advance(target, 0, input, 0)
			target.x.assertEquals(facing * 3.1199999195, 0.000001)
			target.knockbackX.assertEquals(facing * 3.1199999195, 0.000001)
			target.knockbackZ.assertEquals(0.)
			target.damageLevel.assertEquals(0)
			for frame = 1 to 7
				advance(target, 0, input, 0)
			target.knockbackX.assertEquals(0.)
			target.groundKnockbackX.assertEquals(0.)
			destroy input
			destroy target
			destroy owner

@Test function retailCombatDamageLevelsUseAllThreeUnroundedScaledThresholds()
	damageLevelForKnockback(24.999).assertEquals(0)
	damageLevelForKnockback(25.).assertEquals(1)
	damageLevelForKnockback(52.499).assertEquals(1)
	damageLevelForKnockback(52.5).assertEquals(2)
	damageLevelForKnockback(79.999).assertEquals(2)
	damageLevelForKnockback(80.).assertEquals(3)
	ordinaryHitstunFrames(24.999).assertEquals(9)
	ordinaryHitstunFrames(25.).assertEquals(10)
	ordinaryHitstunFrames(52.5).assertEquals(21)
	ordinaryHitstunFrames(80.).assertEquals(32)

@Test function retailCombatGroundBounceUsesTenDegreeThresholdAndFourFifthsVerticalSpeed()
	for grounded = 0 to 1
		for steep = 0 to 1
			let owner = new FighterState(0, 0, 1)
			let target = new FighterState(1, 100, -1)
			target.grounded = grounded == 1
			target.z = grounded == 1 ? 0. : 300.
			// Unit launch directions at nine and eleven degrees below horizontal.
			let dx = steep == 0 ? 0.987688340595 : 0.981627183448
			let dz = steep == 0 ? -0.156434465040 : -0.190808995377
			retailCombatContact(owner, target, 100, dx, dz)
			target.grounded.assertFalse()
			target.damageLevel.assertEquals(3)
			target.downState.assertEquals(DOWN_TUMBLE)
			// Expected multiplication results include the test interpreter's float32 rounding.
			target.knockbackX.assertEquals(steep == 0 ? 17.7783908844 : 17.6692886353, 0.000001)
			let expectedZ = steep == 0 ? -2.8158203078 : (grounded == 1 ? 2.7476495125 : -3.4345618400)
			target.knockbackZ.assertEquals(expectedZ, 0.000001)
			destroy target
			destroy owner

@Test function retailCombatReplayPreservesStackingAgeGroundTangentAndDamageLevel()
	let state = new ReplaySnapshot()
	let saved = new ReplaySnapshot()
	let after = new ReplaySnapshot()
	let input = new InputSnapshot()
	state.first.grounded = true
	state.first.surface = 0
	state.first.knockbackX = 3
	state.first.groundKnockbackX = 6
	state.first.knockbackAgeFrames = 9
	state.first.damageLevel = 2
	saved.capture(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
	state.first.knockbackAgeFrames = 8
	saved.firstDifference(state).assertEquals("first.knockbackAgeFrames")
	state.first.knockbackAgeFrames = 9
	state.first.damageLevel = 1
	saved.firstDifference(state).assertEquals("first.damageLevel")
	state.first.damageLevel = 2
	state.first.groundKnockbackX = 5
	saved.firstDifference(state).assertEquals("first.groundKnockbackX")
	for replay = 0 to 1
		saved.restore(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
		advance(state.first, 0, input, 0)
		state.first.knockbackAgeFrames.assertEquals(10)
		retailCombatContact(state.second, state.first, 20, -1, 0)
		if replay == 0
			after.capture(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
	state.firstDifference(after).assertEquals("")
	reset(state.first, 0)
	state.first.knockbackAgeFrames.assertEquals(-1)
	state.first.groundKnockbackX.assertEquals(0.)
	state.first.damageLevel.assertEquals(0)
	destroy input
	destroy after
	destroy saved
	destroy state

// Factual original-game inputs from wc3-melee:docs/smash-melee-reference/physics-parameters.json.
// This fixture exercises the production engine without adding a roster character.
function falcoReferencePhysics() returns fighterPhysics
	return fighterPhysics(80, 0.17000000178813934 * 6,
		3.0999999046325684 * 6, 3.5 * 6,
		(0.019999999552965164 + 0.05000000074505806) * 6,
		0.8299999833106995 * 6, 0.019999999552965164 * 6, 4. * 6,
		0.07999999821186066 * 6, 1.899999976158142 * 6, 1.5 * 6, 1.399999976158142 * 6,
		5, 4.099999904632568 * 6, 1.899999976158142 * 6,
		4.099999904632568 * 6 * 0.9399999976158142,
		1., 0.699999988079071 * 6, 1.7000000476837158 * 6,
		0.9399999976158142 * 6, 3.299999952316284 * 6,
		0.20000000298023224, 0.10000000149011612,
		0.10000000149011612, 0.019999999552965164, 3. * 6)

function recordedFalcoFallPosition(int sample) returns real
	if sample == 0
		return 9.872425079345703
	if sample == 1
		return 9.532424926757812
	if sample == 2
		return 9.022424697875977
	if sample == 3
		return 8.342424392700195
	if sample == 4
		return 7.492424488067627
	if sample == 5
		return 6.472424507141113
	if sample == 6
		return 5.282424449920654
	if sample == 7
		return 3.922424554824829
	if sample == 8
		return 2.3924245834350586
	return 0.6924247741699219

function recordedFalcoFallFirstDifference(int hostCharacter, real initialVelocity) returns int
	let f = new FighterState(hostCharacter, -360, 1)
	f.physics = falcoReferencePhysics()
	let input = new InputSnapshot()
	f.grounded = false
	f.surface = -1
	f.z = 10.042425155639648 * 6
	f.vz = initialVelocity
	var firstDifference = 0
	for sample = 0 to 9
		advance(f, 0, input, 0)
		if firstDifference == 0 and (f.grounded or (f.z - recordedFalcoFallPosition(sample) * 6).abs() > 0.0001 or f.x != -360)
			firstDifference = -59 + sample
	destroy input
	destroy f
	return firstDifference

@Test function recordedNtscFalcoNeutralFallMatchesTenIndependentPositions()
	for hostCharacter = 0 to 1
		recordedFalcoFallFirstDifference(hostCharacter, 0).assertEquals(0)

@Test function recordedFalcoFallDetectsPerturbedVelocityAtTheFirstFrame()
	recordedFalcoFallFirstDifference(0, 0.06).assertEquals(-59)

function recordedFalcoJumpFirstDifference(int hostCharacter, int jumpInputFrame) returns int
	let f = new FighterState(hostCharacter, 5.241994857788086 * 6, 1)
	f.physics = falcoReferencePhysics()
	let input = new InputSnapshot()
	var firstDifference = 0
	for frame = 25 to 30
		input.jumpPressed = frame == jumpInputFrame
		input.jumpHeld = true
		advance(f, 0, input, 0)
		let grounded = frame < 30
		let height = grounded ? 0. : (4.100100040435791 - 0.00009999999747378752) * 6
		let velocity = grounded ? 0. : 4.099999904632568 * 6
		if firstDifference == 0 and (f.grounded != grounded or (f.jumpSquat > 0) != grounded or (f.z - height).abs() > 0.0001 or (f.vz - velocity).abs() > 0.0001)
			firstDifference = frame
	destroy input
	destroy f
	return firstDifference

function recordedFalcoDashPosition(int sample) returns real
	if sample == 0
		return 36.60000228881836
	if sample == 1
		return 34.86000061035156
	if sample == 2
		return 33.20000076293945
	if sample == 3
		return 31.6200008392334
	return 30.1200008392334

function recordedFalcoDashSpeed(int sample) returns real
	if sample == 0
		return -1.8200000524520874
	if sample == 1
		return -1.7400000095367432
	if sample == 2
		return -1.659999966621399
	if sample == 3
		return -1.5799999237060547
	return -1.4999998807907104

function recordedFalcoDashEntryMatches(int hostCharacter) returns boolean
	let f = new FighterState(hostCharacter, 38.61000061035156 * 6, -1)
	f.physics = falcoReferencePhysics()
	f.vx = -0.1899999976158142 * 6
	let input = new InputSnapshot()
	input.direction = -1
	advance(f, 0, input, 0)
	let entryMatches = (f.x - 38.42000198364258 * 6).abs() <= 0.0006
		and (f.vx + 1.9000000953674316 * 6).abs() <= 0.00006
		and f.dashFrame == 1
	advance(f, 0, input, 0)
	let nextFrameMatches = (f.x - 36.60000228881836 * 6).abs() <= 0.0006
		and (f.vx + 1.8200000524520874 * 6).abs() <= 0.00006
	destroy input
	destroy f
	return entryMatches and nextFrameMatches

function recordedFalcoDashFirstDifference(int hostCharacter, real initialSpeed) returns int
	let f = new FighterState(hostCharacter, 38.42000198364258 * 6, -1)
	f.physics = falcoReferencePhysics()
	f.vx = initialSpeed * 6
	f.dashFrame = 5
	f.dashDirection = -1
	let input = new InputSnapshot()
	input.direction = -1
	var firstDifference = 0
	for sample = 0 to 4
		advance(f, 0, input, 0)
		if firstDifference == 0 and ((f.x - recordedFalcoDashPosition(sample) * 6).abs() > 0.0006
			or (f.vx - recordedFalcoDashSpeed(sample) * 6).abs() > 0.00006)
			firstDifference = -33 + sample
	destroy input
	destroy f
	return firstDifference

@Test function recordedFalcoDashOverspeedBrakingMatchesBothOriginalFighterHosts()
