@Test function retailAerialFastFallReplayRestoresFreshnessAndConsumedInput()
	let state = new ReplaySnapshot()
	let saved = new ReplaySnapshot()
	let after = new ReplaySnapshot()
	let f = state.first
	f.physics = falcoReferencePhysics()
	f.grounded = false
	f.z = 300
	f.vz = 2.5 * f.physics.gravity
	let input = new InputSnapshot()
	input.down = true
	for frame = 0 to 2
		advance(f, 0, input, 0)
	f.fastFallInputAge.assertEquals(2)
	f.fastFallDownHeld.assertTrue()
	saved.capture(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
	f.fastFallInputAge = 4
	state.firstDifference(saved).assertEquals("first.fastFallInputAge")
	saved.restore(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
	f.fastFallDownHeld = false
	state.firstDifference(saved).assertEquals("first.fastFallDownHeld")
	for replay = 0 to 1
		saved.restore(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
		advance(f, 0, input, 0)
		f.fastFalling.assertTrue()
		f.fastFallInputAge.assertEquals(4)
		if replay == 0
			after.capture(state.first, state.second, state.match, state.firstCommands, state.secondCommands, state.runtime)
	state.firstDifference(after).assertEquals("")
	reset(f, 0)
	f.fastFallDownHeld.assertFalse()
	f.fastFallInputAge.assertEquals(4)
	destroy input
	destroy after
	destroy saved
	destroy state

@Test function retailAerialDodgeUsesExtractedForceAndDecayForEveryDigitalDirection()
	for horizontal = -1 to 1
		for vertical = -1 to 1
			let f = new FighterState(1, 0, 1)
			f.physics = falcoReferencePhysics()
			f.grounded = false
			f.z = 300
			let input = new InputSnapshot()
			simulationAirDodge(f, horizontal, vertical)
			var expectedX = horizontal * (vertical == 0 ? 17.6896506589 : 13.1521857265)
			var expectedZ = horizontal == 0 ? vertical * 18.5999994278 : (vertical == 0 ? -5.7477159186 : vertical * 13.1521857265)
			f.vx.assertEquals(expectedX, 0.00001)
			f.vz.assertEquals(expectedZ, 0.00001)
			// The launch check above permits approximate native trig; the decay
			// and position checks start from that actual launch velocity.
			expectedX = f.vx
			expectedZ = f.vz
			var expectedPositionX = 0.
			var expectedPositionZ = 300.
			for frame = 1 to 3
				expectedX *= 0.8999999761581421
				expectedZ *= 0.8999999761581421
				expectedPositionX += expectedX
				expectedPositionZ = ((expectedPositionZ / 6).roundToFloat32() + (expectedZ / 6).roundToFloat32()).roundToFloat32() * 6
				advance(f, 0, input, 0)
				f.vx.assertEquals(expectedX, 0.00001)
				f.vz.assertEquals(expectedZ, 0.00001)
				f.x.assertEquals(expectedPositionX, 0.00001)
				f.z.assertEquals(expectedPositionZ, 0.00001)
			f.hitlag = 3
			for frame = 1 to 2
				advance(f, 0, input, 0)
				f.airDodgeFrame.assertEquals(3)
				f.x.assertEquals(expectedPositionX, 0.00001)
				f.z.assertEquals(expectedPositionZ, 0.00001)
			advance(f, 0, input, 0)
			f.airDodgeFrame.assertEquals(4)
			f.vx.assertEquals(expectedX * 0.8999999761581421, 0.00001)
			f.vz.assertEquals(expectedZ * 0.8999999761581421, 0.00001)
			destroy input
			destroy f

@Test function retailAerialDodgeResumesGravityAndDriftOnTickThirty()
	for mode = 0 to 2
		for steer = -1 to 1
			let f = new FighterState(1, 0, 1)
			f.physics = falcoReferencePhysics()
			f.grounded = false
			f.z = 300
			let input = new InputSnapshot()
			input.airDodgePressed = true
			input.dodgeX = mode == 0 ? 0 : 1
			input.dodgeZ = mode == 0 ? 0 : (mode == 1 ? 1 : -1)
			input.direction = steer
			for frame = 1 to 29
				advance(f, 0, input, 0)
				input.airDodgePressed = false
				f.airDodgeFrame.assertEquals(frame)
			let directionZ = mode == 1 ? 1 : -1
			let beforeX = mode == 0 ? 0. : 112.79427337646484
			let beforeZ = mode == 0 ? 300. : (mode == 1 ? 412.7943115234375 : 187.20565795898438)
			let beforeVX = mode == 0 ? 0. : 0.6194844245910645
			let beforeVZ = mode == 0 ? 0. : directionZ * 0.6194844245910645
			f.x.assertEquals(beforeX, 0.00001)
			f.z.assertEquals(beforeZ, 0.00001)
			f.vx.assertEquals(beforeVX, 0.00001)
			f.vz.assertEquals(beforeVZ, 0.00001)
			f.airDodgeTime.assertEquals(0)
			advance(f, 0, input, 0)
			let nextVX = steer == 0 ? max(0., beforeVX - 0.1199999973) : beforeVX + steer * 0.4200000018
			let nextVZ = beforeVZ - 1.0200000107
			f.airDodgeFrame.assertEquals(30)
			f.vx.assertEquals(nextVX, 0.00001)
			f.vz.assertEquals(nextVZ, 0.00001)
			f.x.assertEquals(beforeX + nextVX, 0.00001)
			let nextZ = ((beforeZ / 6).roundToFloat32() + (nextVZ / 6).roundToFloat32()).roundToFloat32() * 6
			f.z.assertEquals(nextZ, 0.00001)
			f.airDodging.assertTrue()
			canAttack(f).assertFalse()
			destroy input
			destroy f

