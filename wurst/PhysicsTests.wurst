function recordedGroundedDamagePosition(int sample) returns real
	if sample < 4
		return -11.548782348632812
	if sample == 4
		return -10.87250804901123
	if sample == 5
		return -10.276233673095703
	if sample == 6
		return -9.75995922088623
	if sample == 7
		return -9.323684692382812
	if sample == 8
		return -8.96741008758545
	if sample == 9
		return -8.69113540649414
	if sample == 10
		return -8.494860649108887
	if sample == 11
		return -8.378585815429688
	return -8.342310905456543

function recordedGroundedDamageVelocity(int sample) returns real
	if sample < 4
		return 0.7562744617462158
	if sample == 4
		return 0.6762744784355164
	if sample == 5
		return 0.5962744951248169
	if sample == 6
		return 0.5162745118141174
	if sample == 7
		return 0.43627455830574036
	if sample == 8
		return 0.3562745749950409
	if sample == 9
		return 0.27627459168434143
	if sample == 10
		return 0.19627460837364197
	if sample == 11
		return 0.11627461761236191
	if sample == 12
		return 0.03627462312579155
	return 0

function recordedGroundedDamageFirstDifference(int character, real velocityOffset) returns int
	let f = new FighterState(character, -11.548782348632812 * 6, 1)
	// Shared grounded-damage rule with the observation's traction, not a full character rig.
	f.physics.traction = 0.07999999821186066 * 6
	let input = new InputSnapshot()
	f.knockbackX = 0.7562744617462158 * 6 + velocityOffset
	f.hitlag = 4
	f.hitstun = 10
	f.damage = 11
	input.down = true
	input.verticalDirection = -1
	var firstDifference = 0
	for sample = 1 to 13
		advance(f, 0, input, 0)
		let hitlag = max(0, 4 - sample)
		let hitstun = sample < 4 ? 10 : 13 - sample
		if firstDifference == 0 and ((f.x - recordedGroundedDamagePosition(sample) * 6).abs() > 0.0001 or (f.knockbackX - recordedGroundedDamageVelocity(sample) * 6).abs() > 0.00001 or f.hitlag != hitlag or f.hitstun != hitstun or not f.grounded or f.knockbackZ != 0 or f.vx != 0 or f.damage != 11 or canAttack(f) != (sample == 13) or f.crouching != (sample == 13))
			firstDifference = 3432 + sample
	destroy input
	destroy f
	return firstDifference

@Test function recordedNtscGroundedDamageMatchesFreezeReleaseTractionAndActionability()
	for character = 0 to 1
		recordedGroundedDamageFirstDifference(character, 0).assertEquals(0)

@Test function recordedGroundedDamageDetectsPerturbedKnockbackOnTheFirstFrame()
	recordedGroundedDamageFirstDifference(0, 0.06).assertEquals(3433)

@Test function fastFallPersistsAfterReleaseAndAerialStartupButClearsOnLandingAndJump()
	for character = 0 to 1
		let f = new FighterState(character, 0, 1)
		let other = new FighterState(1, 1000, -1)
		let input = new InputSnapshot()
		f.grounded = false
		f.z = 300
		f.vz = -1
		input.down = true
		advance(f, 0, input, 0)
		f.fastFalling.assertTrue()
		input.down = false
		input.direction = 1
		advance(f, 0, input, 0)
		f.vz.assertEquals(character == 0 ? -20.40000057220459 : -21., 0.000001)
		beginAttackPair(f, other, AERIAL_NEUTRAL_STYLE, -1, false, false)
		advance(f, 0, input, 0)
		f.fastFalling.assertTrue()
		f.vz.assertEquals(character == 0 ? -20.40000057220459 : -21., 0.000001)
		f.z = 1
		advance(f, 0, input, 0)
		f.grounded.assertTrue()
		f.fastFalling.assertFalse()
		f.grounded = false
		f.z = 200
		f.fastFalling = true
		f.cooldown = 0
		f.landingLag = 0
		simulationJump(f, 0)
		f.fastFalling.assertFalse()
		f.vz.assertGreaterThan(0.)
		destroy input
		destroy other
		destroy f

@Test function fastFallRequiresDescendingSelfVelocityAndAirDodgeClearsIt()
	let f = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	f.grounded = false
	f.z = 300
	f.vz = 1
	f.knockbackZ = -5
	input.down = true
	advance(f, 0, input, 0)
	f.fastFalling.assertFalse()
	f.vz.assertEquals(-0.38, 0.00001)
	advance(f, 0, input, 0)
	f.fastFalling.assertTrue()
	simulationAirDodge(f, 0, 0)
	f.fastFalling.assertFalse()
	destroy input
	destroy f

@Test function combatGroundContactThresholdKeepsLowDownwardHitsOnTheFloor()
	for airborne = 0 to 1
		for aboveThreshold = 0 to 1
			let owner = new FighterState(0, 0, 1)
			let target = new FighterState(1, 100, -1)
			let input = new InputSnapshot()
			target.damage = 100. + aboveThreshold
			target.grounded = airborne == 0
			target.surface = airborne == 0 ? 0 : -1
			target.z = airborne == 0 ? 0. : 300.
			contactProjectile(owner, target, 0, PROJECTILE_RECOIL)
			updateProjectilePair(owner, target)
			target.damage.assertEquals(105. + aboveThreshold)
			target.hitlag.assertEquals(4)
			target.hitstun.assertEquals(31 + aboveThreshold)
			target.knockbackX.assertEquals(aboveThreshold == 0 ? 11.5044 : 11.57104, 0.0001)
			target.grounded.assertEquals(airborne == 0 and aboveThreshold == 0)
			target.downState.assertEquals(aboveThreshold == 0 ? DOWN_NONE : DOWN_TUMBLE)
			if airborne == 0 and aboveThreshold == 0
				target.knockbackZ.assertEquals(0.)
				input.verticalDirection = 1
				for frame = 1 to 3
					advance(target, 0, input, 0)
					target.x.assertEquals(100.)
					target.z.assertEquals(0.)
					target.hitstun.assertEquals(31)
					target.knockbackX.assertEquals(11.5044, 0.0001)
					target.grounded.assertTrue()
				target.diSerial.assertEquals(0)
				input.verticalDirection = 0
				for frame = 1 to 30
					advance(target, 0, input, 0)
					canAttack(target).assertFalse()
				advance(target, 0, input, 0)
				canAttack(target).assertTrue()
				target.landingLag.assertEquals(0)
			else
				target.knockbackZ.assertEquals(aboveThreshold == 0 ? -8.6283 : (airborne == 0 ? 6.942624 : -8.67828), 0.0001)
			destroy input
			destroy target
			destroy owner

@Test function combatDiUsesActualLaunchMagnitudeForAuthoredNonUnitDirections()
	let target = new FighterState(2, 0, 1)
	let input = new InputSnapshot()
	target.grounded = false
	target.z = 300
	target.knockbackX = 8
	target.diLaunchSpeed = 10
	target.diPending = true
	target.hitlag = 1
	input.verticalDirection = 1
	advance(target, 0, input, 0)
	target.diAngleDegrees.assertEquals(18, 0.0001)
	target.knockbackX.assertEquals(7.31742804, 0.0001)
	target.knockbackZ.assertEquals(2.37757675, 0.0001)
	target.diPending.assertFalse()
	destroy input
	destroy target

