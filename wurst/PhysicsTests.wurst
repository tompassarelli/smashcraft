@Test function recordedShieldContactDetectsPerturbedRecoilOnFirstReleaseFrame()
	let source = new FighterState(0, 38.56430435180664 * 6, 1)
	let target = new FighterState(1, 45.46552276611328 * 6, -1)
	let sourceInput = new InputSnapshot()
	let targetInput = new InputSnapshot()
	target.shield = true
	targetInput.shield = true
