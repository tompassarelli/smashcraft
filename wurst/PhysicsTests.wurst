@Test function electricContactPreservesAttackerAndVictimPauseBoundaries()
	for electric = 0 to 1
		for crouching = 0 to 1
			for direct = 0 to 1
				let owner = new FighterState(0, 0, 1)
				let target = new FighterState(1, 100, -1)
				let input = new InputSnapshot()
				target.crouching = crouching == 1
				beginDamageContacts()
				queueDamageContact(owner, target, hitEffect(8.99, 0, 50, 1, 0, electric == 1), 1, CONTACT_LAUNCH, direct == 1, null)
				target.damage.assertEquals(0.)
				target.hitlag.assertEquals(0)
				finishDamageContacts(owner, target)
				let pause = electric == 1 ? (crouching == 1 ? 4 : 7) : (crouching == 1 ? 3 : 5)
				let stun = crouching == 1 ? 13 : 20
				target.damage.assertEquals(8.99, 0.00001)
				target.hitlag.assertEquals(pause)
				target.hitstun.assertEquals(stun)
				target.crouching.assertFalse()
				owner.hitlag.assertEquals(direct == 1 ? 5 : 0)
				canAttack(owner).assertEquals(direct == 0)
				for frame = 1 to pause - 1
					advance(target, 0, input, 0)
					target.hitlag.assertEquals(pause - frame)
					target.hitstun.assertEquals(stun)
					target.x.assertEquals(100.)
					canAttack(target).assertFalse()
				for frame = 1 to stun - 1
					advance(target, 0, input, 0)
					canAttack(target).assertFalse()
				advance(target, 0, input, 0)
				canAttack(target).assertTrue()
				for frame = 1 to 5
					advance(owner, 0, input, 0)
					canAttack(owner).assertEquals(direct == 0 or frame == 5)
				destroy input
				destroy target
				destroy owner

@Test function electricContactShieldUsesOrdinaryFreezeBeforeShieldstun()
