@Test function contactBatchThrowAndPummelIncludeDetachedDamage()
	for pummel = 0 to 1
		let owner = new FighterState(0, 0, 1)
		let target = new FighterState(1, 50, -1)
		let input = new InputSnapshot()
		owner.grabTarget = target
		target.grabOwner = owner
		target.grabbedFrames = 100
		owner.grabAction = pummel == 1 ? GRAB_PUMMEL : THROW_FORWARD
		owner.grabFrame = grabContactFrame(owner.grabAction) - 1
		resolveGrabPair(owner, target)
		contactProjectile(owner, target, 0, PROJECTILE_ARROW)
