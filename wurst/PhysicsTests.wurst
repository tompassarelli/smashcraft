@Test function retailAerialFastFallRequiresDownAtMostThreeFramesBeforeDescent()
	for lead = 0 to 5
		let f = new FighterState(1, 0, 1)
		f.physics = falcoReferencePhysics()
		f.grounded = false
		f.z = 300
		f.vz = (lead - 0.5) * f.physics.gravity
		let input = new InputSnapshot()
		input.down = true
		for frame = 0 to lead
			advance(f, 0, input, 0)
		f.fastFalling.assertEquals(lead < 4)
		if lead < 4
			f.vz.assertEquals(-21.)
		else
			input.down = false
			advance(f, 0, input, 0)
			input.down = true
			advance(f, 0, input, 0)
			f.fastFalling.assertTrue()
			f.vz.assertEquals(-21.)
		destroy input
		destroy f

@Test function retailAerialFastFallInputAgesDuringHitlagThroughItsExpiryFrame()
	for freeze = 4 to 5
		let f = new FighterState(1, 0, 1)
		f.physics = falcoReferencePhysics()
		f.grounded = false
		f.z = 300
		f.vz = -1
		f.hitlag = freeze
		let input = new InputSnapshot()
		input.down = true
		for frame = 1 to freeze - 1
			advance(f, 0, input, 0)
			f.z.assertEquals(300.)
			f.fastFalling.assertFalse()
		advance(f, 0, input, 0)
		f.fastFalling.assertEquals(freeze == 4)
		f.vz.assertEquals(freeze == 4 ? -21. : -2.020000010728836, 0.000001)
		destroy input
		destroy f

@Test function retailAerialFastFallDiagonalRestrictionDoesNotRefreshHeldDown()
