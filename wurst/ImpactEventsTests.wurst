package ImpactEventsTests
import WorldTestSupport
import Simulation
import ImpactEvents

@Test function impactCuesDistinguishTechMissAndOrdinaryLanding()
    let fighter = new FighterState(0, 0, 1)
    let events = new ImpactEvents()
    for state = DOWN_TECH to DOWN_TECH_ROLL
        fighter.downState = DOWN_TUMBLE
        events.before(fighter)
        fighter.downState = state
        events.after(fighter)
        events.landing.assertEquals(IMPACT_TECH)
        events.before(fighter)
        fighter.downFrame++
        events.after(fighter)
        events.landing.assertEquals(IMPACT_NONE)
    fighter.downState = DOWN_TUMBLE
    events.before(fighter)
    fighter.downState = DOWN_BOUND
    events.after(fighter)
    events.landing.assertEquals(IMPACT_MISSED_TECH)
    events.before(fighter)
    fighter.downState = DOWN_WAIT
    events.after(fighter)
    events.landing.assertEquals(IMPACT_NONE)
    events.before(fighter)
    fighter.downState = DOWN_NONE
    fighter.grounded = true
    events.after(fighter)
    events.landing.assertEquals(IMPACT_NONE)
    destroy events
    destroy fighter

@Test function hitFlashDoesNotRepeatThroughHitlagOrOnRespawn()
    let fighter = new FighterState(0, 0, 1)
    let attacker = new FighterState(1, -100, 1)
    let events = new ImpactEvents()
    events.before(fighter)
    beginDamageContacts()
    queueDamageContact(attacker, fighter, hitEffect(7, 100, 20, 1, 0, false), 1, CONTACT_LAUNCH, true, null)
    finishDamageContacts(testWorld(attacker, fighter))
    events.after(fighter)
    events.hit.assertTrue()
    events.before(fighter)
    fighter.hitlag--
    events.after(fighter)
    events.hit.assertFalse()
    events.before(fighter)
    fighter.damage = 0
    fighter.out = true
    events.after(fighter)
    events.hit.assertFalse()
    destroy events
    destroy attacker
    destroy fighter

@Test function contactCuesDistinguishOrdinaryElectricAndBlockedHits()
    for mode = 0 to 2
        let attacker = new FighterState(0, -100, 1)
        let fighter = new FighterState(1, 0, -1)
        let events = new ImpactEvents()
        fighter.shield = mode == 2
        events.before(fighter)
        beginDamageContacts()
        queueDamageContact(attacker, fighter, hitEffect(7, 100, 20, 1, 0, mode > 0), 1, CONTACT_LAUNCH, true, null)
        finishDamageContacts(testWorld(attacker, fighter))
        events.after(fighter)
        events.hit.assertEquals(mode != 2)
        events.electric.assertEquals(mode == 1)
        events.shieldHit.assertEquals(mode == 2)
        events.before(fighter)
        events.after(fighter)
        events.hit.assertFalse()
        events.shieldHit.assertFalse()
        destroy events
        destroy fighter
        destroy attacker

@Test function hitCueUsesTheStrongestContactEffectRatherThanLastContactOrDamageDelta()
    let attacker = new FighterState(0, -100, 1)
    let fighter = new FighterState(1, 0, -1)
    let events = new ImpactEvents()
    events.before(fighter)
    beginDamageContacts()
    queueDamageContact(attacker, fighter, hitEffect(7, 100, 100, 1, 0, true), 1, CONTACT_LAUNCH, true, null)
    queueDamageContact(attacker, fighter, hitEffect(20, 0, 1, 1, 0, false), 1, CONTACT_LAUNCH, true, null)
    finishDamageContacts(testWorld(attacker, fighter))
    events.after(fighter)
    events.hit.assertTrue()
    events.electric.assertTrue()
    events.before(fighter)
    fighter.damage += 1
    events.after(fighter)
    events.hit.assertFalse()
    destroy events
    destroy fighter
    destroy attacker

@Test function damageOnlyContactStillHasOneHitCueWithoutInventingHitstun()
    let attacker = new FighterState(0, -100, 1)
    let fighter = new FighterState(1, 0, -1)
    let events = new ImpactEvents()
    events.before(fighter)
    beginDamageContacts()
    queueDamageContact(attacker, fighter, hitEffect(3, 0, 0, 0, 0, false), 1, CONTACT_DAMAGE_ONLY, false, null)
    finishDamageContacts(testWorld(attacker, fighter))
    events.after(fighter)
    events.hit.assertTrue()
    fighter.hitstun.assertEquals(0)
    destroy events
    destroy fighter
    destroy attacker

@Test function presentedImpactFrameCannotBePlayedTwice()
    let cursor = new ImpactPresentationCursor()
    cursor.consume(42).assertTrue()
    cursor.consume(42).assertFalse()
    cursor.consume(40).assertFalse()
    cursor.consume(43).assertTrue()
    cursor.reset()
    cursor.consume(1).assertTrue()
    destroy cursor

@Test function solidSurfaceContactPublishesPositionAndInwardNormalOnce()
    let fighter = new FighterState(0, -240, 1)
    let events = new ImpactEvents()
    events.before(fighter)
    fighter.surfaceContactSerial++
    fighter.surfaceContactKind = SURFACE_WALL
    fighter.surfaceContactX = -240
    fighter.surfaceContactZ = 72
    fighter.surfaceContactNormalX = 1
    fighter.surfaceContactNormalZ = 0
    events.after(fighter)
    events.surface.assertEquals(SURFACE_WALL)
    events.contactX.assertEquals(-240)
    events.contactZ.assertEquals(72)
    events.normalX.assertEquals(1)
    events.normalZ.assertEquals(0)
    events.before(fighter)
    events.after(fighter)
    events.surface.assertEquals(SURFACE_NONE)
    destroy events
    destroy fighter

@Test function dodgeDustEmitsOnEntryAndPreservesRollDirection()
    let fighter = new FighterState(0, 0, 1)
    let events = new ImpactEvents()
    for direction = -1 to 1
        fighter.groundDodgeFrame = 0
        events.before(fighter)
        fighter.groundDodgeFrame = 1
        fighter.groundDodgeDirection = direction
        events.after(fighter)
        events.dodge.assertEquals(direction == 0 ? 1 : 2)
        events.direction.assertEquals(direction)
        events.before(fighter)
        fighter.groundDodgeFrame++
        events.after(fighter)
        events.dodge.assertEquals(0)
    fighter.groundDodgeFrame = 0
    fighter.downState = DOWN_TUMBLE
    events.before(fighter)
    fighter.downState = DOWN_TECH_ROLL
    fighter.downDirection = -1
    events.after(fighter)
    events.landing.assertEquals(IMPACT_TECH)
    events.dodge.assertEquals(2)
    events.direction.assertEquals(-1)
    destroy events
    destroy fighter

@Test function shieldReactionRestartsOnlyOnNewContact()
    let fighter = new FighterState(2, 0, 1)
    let events = new ImpactEvents()
    fighter.shield = true
    events.before(fighter)
    fighter.shieldEnergy -= 0.1
    events.after(fighter)
    events.shieldHit.assertFalse()
    events.before(fighter)
    fighter.shieldVisualSerial++
    fighter.shieldEnergy -= 5
    fighter.shieldStun = 10
    fighter.hitlag = 5
    events.after(fighter)
    events.shieldHit.assertTrue()
    for tick = 1 to 4
        events.before(fighter)
        fighter.hitlag--
        events.after(fighter)
        events.shieldHit.assertFalse()
    events.before(fighter)
    fighter.shieldVisualSerial++
    fighter.shieldEnergy -= 3
    fighter.hitlag = 4
    events.after(fighter)
    events.shieldHit.assertTrue()
    destroy events
    destroy fighter

@Test function grabCueRequiresAcceptedCaptureAndThrowCueRequiresReleaseContact()
    for rejected = 0 to 1
        let owner = new FighterState(0, 0, 1)
        let target = new FighterState(1, 90, -1)
        let world = testWorld(owner, target)
        let controls = testInputs(new InputSnapshot(), new InputSnapshot())
        let events = new ImpactEvents()
        owner.surface = 0
        target.surface = 0
        target.invincible = rejected
        testBeginAttacks(world, 5, -1, false, false)
        owner.attackFrame = attackStartupFrames(5)
        events.before(target)
        resolveAttacks(world)
        resolveGrabs(world)
        events.after(target)
        events.grab.assertEquals(rejected == 0)
        events.throwRelease.assertFalse()
        if rejected == 0
            events.before(target)
            testGrabFrame(world, controls, false)
            events.after(target)
            events.grab.assertFalse()
            controls.inputs[0].grabThrowX = 1
            testGrabFrame(world, controls, false)
            controls.inputs[0].grabThrowX = 0
            for frame = 2 to grabContactFrame(THROW_FORWARD)
                events.before(target)
                testGrabFrame(world, controls, true)
                events.after(target)
                events.throwRelease.assertFalse()
                events.before(target)
                testGrabFrame(world, controls, false)
                events.after(target)
                events.throwRelease.assertEquals(frame == grabContactFrame(THROW_FORWARD))
                events.grab.assertFalse()
            events.before(target)
            testGrabFrame(world, controls, false)
            events.after(target)
            events.throwRelease.assertFalse()

@Test function grabEscapeAndInterruptedThrowDoNotEmitRelease()
    for interrupted = 0 to 1
        let owner = new FighterState(0, 0, 1)
        let target = new FighterState(1, 90, -1)
        let world = testWorld(owner, target)
        let controls = testInputs(new InputSnapshot(), new InputSnapshot())
        let events = new ImpactEvents()
        testBeginAttacks(world, 5, -1, false, false)
        owner.attackFrame = attackStartupFrames(5)
        resolveAttacks(world)
        resolveGrabs(world)
        if interrupted == 1
            controls.inputs[0].grabThrowZ = 1
            testGrabFrame(world, controls, false)
        else
            target.grabbedFrames = 1
        events.before(target)
        if interrupted == 1
            reset(owner, 0)
        else
            testGrabFrame(world, controls, false)
        events.after(target)
        (target.grabOwner == null).assertTrue()
        events.throwRelease.assertFalse()
        events.grab.assertFalse()

@Test function chargeCuesFollowEntryAndFullChargeWithoutRepeatingDuringHitlag()
    for mayCharge = 0 to 1
        let fighter = new FighterState(0, 0, 1)
        let other = new FighterState(1, 300, -1)
        let input = new InputSnapshot()
        let events = new ImpactEvents()
        fighter.surface = 0
        input.attackHeld = true
        testBeginAttacks(testWorld(fighter, other), 2, -1, mayCharge == 1, false)
        for tick = 1 to attackStartupFrames(2)
            events.before(fighter)
            advance(fighter, 0, input, 0)
            events.after(fighter)
            events.charge.assertEquals(mayCharge == 1 and tick == attackStartupFrames(2))
            events.ready.assertFalse()
        if mayCharge == 1
            fighter.hitlag = 2
            events.before(fighter)
            advance(fighter, 0, input, 0)
            events.after(fighter)
            events.charge.assertFalse()
            events.ready.assertFalse()
            fighter.smashChargeFrames.assertEquals(1)
            for tick = 2 to SMASH_MAX_CHARGE_FRAMES
                events.before(fighter)
                advance(fighter, 0, input, 0)
                events.after(fighter)
                events.charge.assertFalse()
                events.ready.assertEquals(tick == SMASH_MAX_CHARGE_FRAMES)
            events.before(fighter)
            advance(fighter, 0, input, 0)
            events.after(fighter)
            events.ready.assertFalse()
            events.charge.assertFalse()

@Test function ledgeCuesUseAcceptedCatchAndOptionsAtTheActualLip()
    for option = 0 to 4
        let fighter = new FighterState(0, -620, 1)
        let other = new FighterState(1, 0, 1)
        let input = new InputSnapshot()
        let controls = testInputs(input, new InputSnapshot())
        let world = testWorld(fighter, other)
        let events = new ImpactEvents()
        fighter.grounded = false
        fighter.z = -30
        fighter.vz = -2
        input.down = true
        events.before(fighter)
        resolveLedges(world, 0, controls)
        events.after(fighter)
        events.ledgeCatch.assertFalse()
        input.down = false
        events.before(fighter)
        resolveLedges(world, 0, controls)
        events.after(fighter)
        events.ledgeCatch.assertTrue()
        events.ledgeX.assertEquals(surfaceLeft(0, 0))
        events.ledgeZ.assertEquals(surfaceZ(0, 0))
        events.before(fighter)
        advance(fighter, 0, input, 0)
        events.after(fighter)
        events.ledgeCatch.assertFalse()
        events.ledgeRecovery.assertFalse()
        input.jumpPressed = option == 0
        input.ledgeVerticalPressed = option == 1 ? 1 : (option == 4 ? -1 : 0)
        input.airDodgePressed = option == 2
        input.getupAttackPressed = option == 3
        events.before(fighter)
        advance(fighter, 0, input, 0)
        events.after(fighter)
        events.ledgeRecovery.assertEquals(option != 4)
        events.jump.assertEquals(0)
        if option != 4
            events.ledgeX.assertEquals(surfaceLeft(0, 0))
            events.ledgeZ.assertEquals(surfaceZ(0, 0))
        events.before(fighter)
        events.after(fighter)
        events.ledgeRecovery.assertFalse()
        events.ledgeCatch.assertFalse()
