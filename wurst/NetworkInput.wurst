package NetworkInput
import KeyBindings

public constant int INPUT_ACTION_MASK = 32767
public constant int INPUT_THROW_CONTRIBUTION_LIMIT = 127

// Bit positions are exactly the KeyBindings action IDs (0 through 14).
public function inputActionBit(int action) returns int
    if action < 0 or action >= ACTION_COUNT
        return 0
    var bit = 1
    for i = 1 to action
        bit *= 2
    return bit

// Reusable producer/read scratch. Accepted storage owns detached private copies.
// Axes use [-127,127]; triggers use [0,255]. Both edges may be set for a tap
// completed inside one capture interval, independently of the final held state.
public class NetworkInput
    private int held = 0
    private int pressed = 0
    private int released = 0
    private int horizontal = 0
    private int vertical = 0
    private int leftTrigger = 0
    private int rightTrigger = 0
    // Press-time vectors survive later releases within this input row.
    private int specialHorizontal = 0
    private int specialVertical = 0
    private int dodgeHorizontal = 0
    private int dodgeVertical = 0
    private boolean sdi = false
    private int sdiHorizontal = 0
    private int sdiVertical = 0
    private int ledgeVertical = 0
    private int throwHorizontal = 0
    private int throwVertical = 0

    function hasAction(int mask, int action) returns boolean
        let bit = inputActionBit(action)
        return bit != 0 and (mask div bit) mod 2 == 1

    function assign(int heldMask, int pressedMask, int releasedMask, int x, int z, int left, int right) returns boolean
        if heldMask < 0 or heldMask > INPUT_ACTION_MASK or pressedMask < 0 or pressedMask > INPUT_ACTION_MASK or releasedMask < 0 or releasedMask > INPUT_ACTION_MASK
            return false
        if x < -127 or x > 127 or z < -127 or z > 127 or left < 0 or left > 255 or right < 0 or right > 255
            return false
        held = heldMask
        pressed = pressedMask
        released = releasedMask
        horizontal = x
        vertical = z
        leftTrigger = left
        rightTrigger = right
        throwHorizontal = (hasAction(pressedMask, MOVE_RIGHT) ? 1 : 0)
            - (hasAction(pressedMask, MOVE_LEFT) ? 1 : 0)
            + (hasAction(pressedMask, SMASH_RIGHT) ? 1 : 0)
            - (hasAction(pressedMask, SMASH_LEFT) ? 1 : 0)
        throwVertical = (hasAction(pressedMask, MOVE_UP) ? 1 : 0)
            - (hasAction(pressedMask, MOVE_DOWN) ? 1 : 0)
            + (hasAction(pressedMask, SMASH_UP) ? 1 : 0)
            - (hasAction(pressedMask, SMASH_DOWN) ? 1 : 0)
        specialHorizontal = 0
        specialVertical = 0
        dodgeHorizontal = 0
        dodgeVertical = 0
        sdi = false
        sdiHorizontal = 0
        sdiVertical = 0
        ledgeVertical = 0
        return true

    function assignThrowContributions(int horizontalCount, int verticalCount) returns boolean
        if horizontalCount < -INPUT_THROW_CONTRIBUTION_LIMIT or horizontalCount > INPUT_THROW_CONTRIBUTION_LIMIT
                or verticalCount < -INPUT_THROW_CONTRIBUTION_LIMIT or verticalCount > INPUT_THROW_CONTRIBUTION_LIMIT
            return false
        throwHorizontal = horizontalCount
        throwVertical = verticalCount
        return true

    function assignPressData(int specialX, int specialZ, int dodgeX, int dodgeZ,
            boolean sdiPulse, int sdiX, int sdiZ, int ledgeDirection) returns boolean
        if not validDirection(specialX) or not validDirection(specialZ)
                or not validDirection(dodgeX) or not validDirection(dodgeZ)
                or not validDirection(sdiX) or not validDirection(sdiZ)
                or not validDirection(ledgeDirection)
            return false
        if (not actionPressed(SPECIAL) and (specialX != 0 or specialZ != 0))
                or (not actionPressed(LEFT_TRIGGER) and not actionPressed(RIGHT_TRIGGER) and (dodgeX != 0 or dodgeZ != 0))
                or (not sdiPulse and (sdiX != 0 or sdiZ != 0))
                or (sdiPulse and sdiX == 0 and sdiZ == 0)
                or (ledgeDirection != 0 and not (actionPressed(MOVE_UP) or actionPressed(MOVE_DOWN)))
            return false
        specialHorizontal = specialX
        specialVertical = specialZ
        dodgeHorizontal = dodgeX
        dodgeVertical = dodgeZ
        sdi = sdiPulse
        sdiHorizontal = sdiX
        sdiVertical = sdiZ
        ledgeVertical = ledgeDirection
        return true

    function validDirection(int direction) returns boolean
        return direction >= -1 and direction <= 1

    function heldMask() returns int
        return held

    function pressedMask() returns int
        return pressed

    function releasedMask() returns int
        return released

    function axisX() returns int
        return horizontal

    function axisZ() returns int
        return vertical

    function triggerLeft() returns int
        return leftTrigger

    function triggerRight() returns int
        return rightTrigger

    function specialX() returns int
        return specialHorizontal

    function specialZ() returns int
        return specialVertical

    function dodgeX() returns int
        return dodgeHorizontal

    function dodgeZ() returns int
        return dodgeVertical

    function sdiPulse() returns boolean
        return sdi

    function sdiX() returns int
        return sdiHorizontal

    function sdiZ() returns int
        return sdiVertical

    function ledgeVerticalPressed() returns int
        return ledgeVertical

    function throwX() returns int
        return throwHorizontal

    function throwZ() returns int
        return throwVertical

    function actionHeld(int action) returns boolean
        let bit = inputActionBit(action)
        return bit != 0 and (held div bit) mod 2 == 1

    function actionPressed(int action) returns boolean
        let bit = inputActionBit(action)
        return bit != 0 and (pressed div bit) mod 2 == 1

    function actionReleased(int action) returns boolean
        let bit = inputActionBit(action)
        return bit != 0 and (released div bit) mod 2 == 1

    function copyTo(NetworkInput destination)
        destination.held = held
        destination.pressed = pressed
        destination.released = released
        destination.horizontal = horizontal
        destination.vertical = vertical
        destination.leftTrigger = leftTrigger
        destination.rightTrigger = rightTrigger
        destination.specialHorizontal = specialHorizontal
        destination.specialVertical = specialVertical
        destination.dodgeHorizontal = dodgeHorizontal
        destination.dodgeVertical = dodgeVertical
        destination.sdi = sdi
        destination.sdiHorizontal = sdiHorizontal
        destination.sdiVertical = sdiVertical
        destination.ledgeVertical = ledgeVertical
        destination.throwHorizontal = throwHorizontal
        destination.throwVertical = throwVertical

    function predictTo(NetworkInput destination)
        copyTo(destination)
        destination.pressed = 0
        destination.released = 0
        destination.specialHorizontal = 0
        destination.specialVertical = 0
        destination.dodgeHorizontal = 0
        destination.dodgeVertical = 0
        destination.sdi = false
        destination.sdiHorizontal = 0
        destination.sdiVertical = 0
        destination.ledgeVertical = 0
        destination.throwHorizontal = 0
        destination.throwVertical = 0

    function sameAs(NetworkInput other) returns boolean
        return held == other.held and pressed == other.pressed and released == other.released and horizontal == other.horizontal and vertical == other.vertical and leftTrigger == other.leftTrigger and rightTrigger == other.rightTrigger and specialHorizontal == other.specialHorizontal and specialVertical == other.specialVertical and dodgeHorizontal == other.dodgeHorizontal and dodgeVertical == other.dodgeVertical and sdi == other.sdi and sdiHorizontal == other.sdiHorizontal and sdiVertical == other.sdiVertical and ledgeVertical == other.ledgeVertical and throwHorizontal == other.throwHorizontal and throwVertical == other.throwVertical
