package FixedInputSchedule
import NetworkInput
import ParticipantInputs
import InputProtocol
import InputLedger
import ReplayHistory

public constant int FIXED_CAPTURED = 0
public constant int FIXED_ALREADY_CAPTURED = 1
public constant int FIXED_WRONG_EPOCH = 2
public constant int FIXED_FRAME_EXHAUSTED = 3
public constant int FIXED_PENDING_FULL = 4

// Zero is an explicit exhausted/invalid target, never a wrapped frame number.
public function fixedCaptureTarget(int frame, int delay) returns int
    if delay < 0 or delay > 5 or delay == 4 or frame < 1 or frame > INPUT_LAST_FRAME - delay
        return 0
    return frame + delay

// Construct in common initialization. Every divergent capture/read operation
// copies into existing storage; none allocates objects or native handles.
public class FixedInputSchedule
    private InputLedger accepted = new InputLedger()
    private NetworkInput array[INPUT_LEDGER_CAPACITY] pending
    private int array[INPUT_LEDGER_CAPACITY] pendingFrames
    private int epoch = -1
    private int delay = 0
    private int nextFrame = 1
    private int preparedFrame = 0

    construct()
        for i = 0 to INPUT_LEDGER_CAPACITY - 1
            pending[i] = new NetworkInput()
            pendingFrames[i] = -1

    function beginEpoch(int newEpoch, int fixedDelay, int participants) returns boolean
        if fixedCaptureTarget(1, fixedDelay) == 0 or not accepted.beginEpoch(newEpoch, 1, fixedDelay, participants)
            return false
        epoch = newEpoch
        delay = fixedDelay
        nextFrame = 1
        preparedFrame = 0
        for i = 0 to INPUT_LEDGER_CAPACITY - 1
            pendingFrames[i] = -1
        return true

    function participantMask() returns int
        return accepted.participantMask()

    function isActive(int sender) returns boolean
        return accepted.isActive(sender)

    function epochNumber() returns int
        return epoch

    function delayFrames() returns int
        return delay

    function nextFrameNumber() returns int
        return nextFrame

    function knownThrough() returns int
        return accepted.knownThrough()

    function confirmedThrough() returns int
        return accepted.consumedThrough()

    function firstRetained() returns int
        return accepted.firstRetained()

    function captureTarget() returns int
        return epoch < 0 ? 0 : fixedCaptureTarget(nextFrame, delay)

    // Call at each service opportunity even while readNext is waiting. A repeated
    // opportunity at the same F returns the original row; new edges belong to
    // the sampler's next uncaptured row, not to this already assigned target.
    function captureLocal(int requestedEpoch, NetworkInput sample) returns int
        if epoch < 0 or requestedEpoch != epoch
            return FIXED_WRONG_EPOCH
        let target = captureTarget()
        if target == 0
            return FIXED_FRAME_EXHAUSTED
        let slot = target mod INPUT_LEDGER_CAPACITY
        if pendingFrames[slot] == target
            return FIXED_ALREADY_CAPTURED
        if pendingFrames[slot] != -1
            return FIXED_PENDING_FULL
        sample.copyTo(pending[slot])
        pendingFrames[slot] = target
        return FIXED_CAPTURED

    function copyPending(int requestedEpoch, int frame, NetworkInput destination) returns boolean
        if epoch < 0 or requestedEpoch != epoch or frame < accepted.firstRetained() or frame > INPUT_LAST_FRAME
            return false
        let slot = frame mod INPUT_LEDGER_CAPACITY
        if pendingFrames[slot] != frame
            return false
        pending[slot].copyTo(destination)
        return true

    // These seams require common receive-event delivery and its authoritative
    // sender slot. A local send return/self echo is not synchronized receipt.
    // Pending storage is deliberately never consulted here or by the F/K gate.
    function acceptSynchronized(int sender, InputPacket packet) returns int
        return accepted.acceptPacket(sender, packet)

    function receiveSynchronized(int sender, string wire) returns int
        return accepted.receive(sender, wire)

    function mayAdvance() returns boolean
        return epoch >= 0 and nextFrame <= INPUT_LAST_FRAME and nextFrame <= accepted.knownThrough()

    // The common frontier proves every active row is present before any
    // destination changes. The set owns distinct preallocated slot storage.
    function readNext(int requestedEpoch, ParticipantInputs inputs) returns boolean
        if requestedEpoch != epoch or not mayAdvance() or inputs == null
            return false
        for sender = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if isActive(sender)
                accepted.copyAccepted(epoch, sender, nextFrame, inputs.row(sender))
        preparedFrame = nextFrame
        return true

    // Completion acknowledges actual common execution in order. Keep the last
    // 64 completed rows, matching ReplayHistory's before-frame snapshot ring.
    function complete(int requestedEpoch, int frame) returns boolean
        if epoch < 0 or requestedEpoch != epoch or frame != nextFrame or preparedFrame != frame
            return false
        if not accepted.markConsumed(epoch, frame)
            return false
        preparedFrame = 0
        nextFrame++
        let discardFrame = frame - REPLAY_HISTORY_CAPACITY
        if discardFrame >= accepted.firstRetained()
            let slot = discardFrame mod INPUT_LEDGER_CAPACITY
            pendingFrames[slot] = -1
            accepted.discardThrough(epoch, discardFrame)
        return true

    function copyAccepted(int requestedEpoch, int sender, int frame, NetworkInput destination) returns boolean
        return accepted.copyAccepted(requestedEpoch, sender, frame, destination)
