package AnalogShieldObservedTests
import Simulation
import Binary32

@Test function observedRetailShieldDrain()
	(60. - shieldDrain(0.4000000059604645)).roundToFloat32().assertEquals(59.879600524902344)
	(30. - shieldDrain(0.4000000059604645)).roundToFloat32().assertEquals(29.879600524902344)
	(1. - shieldDrain(0.4000000059604645)).roundToFloat32().assertEquals(0.8795999884605408)
	(60. - shieldDrain(0.0028011202812194824)).roundToFloat32().assertEquals(59.98525619506836)
	(30. - shieldDrain(0.0028011202812194824)).roundToFloat32().assertEquals(29.985254287719727)
	(1. - shieldDrain(0.0028011202812194824)).roundToFloat32().assertEquals(0.9852548837661743)
	(60. - shieldDrain(0.28851544857025146)).roundToFloat32().assertEquals(59.90925598144531)
	(30. - shieldDrain(0.28851544857025146)).roundToFloat32().assertEquals(29.90925407409668)
	(1. - shieldDrain(0.28851544857025146)).roundToFloat32().assertEquals(0.9092549085617065)
	(60. - shieldDrain(0.6918767690658569)).roundToFloat32().assertEquals(59.80195999145508)
	(30. - shieldDrain(0.6918767690658569)).roundToFloat32().assertEquals(29.801959991455078)
	(1. - shieldDrain(0.6918767690658569)).roundToFloat32().assertEquals(0.8019607663154602)
	(60. - shieldDrain(1.)).roundToFloat32().assertEquals(59.720001220703125)
	(30. - shieldDrain(1.)).roundToFloat32().assertEquals(29.719999313354492)
	(1. - shieldDrain(1.)).roundToFloat32().assertEquals(0.7200000286102295)

@Test function observedRetailShieldStun()
	shieldstunDuration(3., 0.4000000059604645).assertEquals(5.105000019073486)
	shieldstunDuration(10., 0.4000000059604645).assertEquals(12.350000381469727)
	shieldstunDuration(30., 0.4000000059604645).assertEquals(33.05000305175781)
	shieldstunDuration(3., 0.0028011202812194824).assertEquals(6.266806602478027)
	shieldstunDuration(10., 0.0028011202812194824).assertEquals(16.222688674926758)
	shieldstunDuration(30., 0.0028011202812194824).assertEquals(44.668067932128906)
	shieldstunDuration(3., 0.28851544857025146).assertEquals(5.431092262268066)
	shieldstunDuration(10., 0.28851544857025146).assertEquals(13.436975479125977)
	shieldstunDuration(30., 0.28851544857025146).assertEquals(36.31092834472656)
	shieldstunDuration(3., 0.6918767690658569).assertEquals(4.251260757446289)
	shieldstunDuration(10., 0.6918767690658569).assertEquals(9.504201889038086)
	shieldstunDuration(30., 0.6918767690658569).assertEquals(24.512605667114258)
	shieldstunDuration(3., 1.).assertEquals(3.3500001430511475)
	shieldstunDuration(10., 1.).assertEquals(6.5)
	shieldstunDuration(30., 1.).assertEquals(15.5)

@Test function observedRetailShieldSize()
	shieldSizeMultiplier(60., 0.4000000059604645).assertEquals(0.8300000429153442)
	shieldSizeMultiplier(30., 0.4000000059604645).assertEquals(0.49000000953674316)
	shieldSizeMultiplier(1., 0.4000000059604645).assertEquals(0.1613333374261856)
	shieldSizeMultiplier(60., 0.0028011202812194824).assertEquals(0.9988095164299011)
	shieldSizeMultiplier(30., 0.0028011202812194824).assertEquals(0.574404776096344)
	shieldSizeMultiplier(1., 0.0028011202812194824).assertEquals(0.16414682567119598)
	shieldSizeMultiplier(60., 0.28851544857025146).assertEquals(0.8773809671401978)
	shieldSizeMultiplier(30., 0.28851544857025146).assertEquals(0.5136904716491699)
	shieldSizeMultiplier(1., 0.28851544857025146).assertEquals(0.16212302446365356)
	shieldSizeMultiplier(60., 0.6918767690658569).assertEquals(0.7059524059295654)
	shieldSizeMultiplier(30., 0.6918767690658569).assertEquals(0.42797619104385376)
	shieldSizeMultiplier(1., 0.6918767690658569).assertEquals(0.15926587581634521)
	shieldSizeMultiplier(60., 1.).assertEquals(0.5750000476837158)
	shieldSizeMultiplier(30., 1.).assertEquals(0.36250001192092896)
	shieldSizeMultiplier(1., 1.).assertEquals(0.15708333253860474)

@Test function observedRetailShieldDamage()
	(60. - shieldContactDamage(3., 0.4000000059604645)).roundToFloat32().assertEquals(57.540000915527344)
	(60. - shieldContactDamage(10., 0.4000000059604645)).roundToFloat32().assertEquals(51.79999923706055)
	(60. - shieldContactDamage(30., 0.4000000059604645)).roundToFloat32().assertEquals(35.400001525878906)
	(30. - shieldContactDamage(3., 0.4000000059604645)).roundToFloat32().assertEquals(27.540000915527344)
	(30. - shieldContactDamage(10., 0.4000000059604645)).roundToFloat32().assertEquals(21.799999237060547)
	(30. - shieldContactDamage(30., 0.4000000059604645)).roundToFloat32().assertEquals(5.399999618530273)
	(1. - shieldContactDamage(3., 0.4000000059604645)).roundToFloat32().assertEquals(-1.4600000381469727)
	(1. - shieldContactDamage(10., 0.4000000059604645)).roundToFloat32().assertEquals(-7.199999809265137)
	(1. - shieldContactDamage(30., 0.4000000059604645)).roundToFloat32().assertEquals(-23.600000381469727)
	(60. - shieldContactDamage(3., 0.0028011202812194824)).roundToFloat32().assertEquals(57.30168151855469)
	(60. - shieldContactDamage(10., 0.0028011202812194824)).roundToFloat32().assertEquals(51.0056037902832)
	(60. - shieldContactDamage(30., 0.0028011202812194824)).roundToFloat32().assertEquals(33.016807556152344)
	(30. - shieldContactDamage(3., 0.0028011202812194824)).roundToFloat32().assertEquals(27.301681518554688)
	(30. - shieldContactDamage(10., 0.0028011202812194824)).roundToFloat32().assertEquals(21.005603790283203)
	(30. - shieldContactDamage(30., 0.0028011202812194824)).roundToFloat32().assertEquals(3.0168075561523438)
	(1. - shieldContactDamage(3., 0.0028011202812194824)).roundToFloat32().assertEquals(-1.6983191967010498)
	(1. - shieldContactDamage(10., 0.0028011202812194824)).roundToFloat32().assertEquals(-7.994397163391113)
	(1. - shieldContactDamage(30., 0.0028011202812194824)).roundToFloat32().assertEquals(-25.983192443847656)
	(60. - shieldContactDamage(3., 0.28851544857025146)).roundToFloat32().assertEquals(57.47311019897461)
	(60. - shieldContactDamage(10., 0.28851544857025146)).roundToFloat32().assertEquals(51.577030181884766)
	(60. - shieldContactDamage(30., 0.28851544857025146)).roundToFloat32().assertEquals(34.73109436035156)
	(30. - shieldContactDamage(3., 0.28851544857025146)).roundToFloat32().assertEquals(27.47311019897461)
	(30. - shieldContactDamage(10., 0.28851544857025146)).roundToFloat32().assertEquals(21.577030181884766)
	(30. - shieldContactDamage(30., 0.28851544857025146)).roundToFloat32().assertEquals(4.73109245300293)
	(1. - shieldContactDamage(3., 0.28851544857025146)).roundToFloat32().assertEquals(-1.526890754699707)
	(1. - shieldContactDamage(10., 0.28851544857025146)).roundToFloat32().assertEquals(-7.422968864440918)
	(1. - shieldContactDamage(30., 0.28851544857025146)).roundToFloat32().assertEquals(-24.26890754699707)
	(60. - shieldContactDamage(3., 0.6918767690658569)).roundToFloat32().assertEquals(57.715126037597656)
	(60. - shieldContactDamage(10., 0.6918767690658569)).roundToFloat32().assertEquals(52.38375473022461)
	(60. - shieldContactDamage(30., 0.6918767690658569)).roundToFloat32().assertEquals(37.15126037597656)
	(30. - shieldContactDamage(3., 0.6918767690658569)).roundToFloat32().assertEquals(27.715126037597656)
	(30. - shieldContactDamage(10., 0.6918767690658569)).roundToFloat32().assertEquals(22.38375473022461)
	(30. - shieldContactDamage(30., 0.6918767690658569)).roundToFloat32().assertEquals(7.1512603759765625)
	(1. - shieldContactDamage(3., 0.6918767690658569)).roundToFloat32().assertEquals(-1.2848739624023438)
	(1. - shieldContactDamage(10., 0.6918767690658569)).roundToFloat32().assertEquals(-6.616246223449707)
	(1. - shieldContactDamage(30., 0.6918767690658569)).roundToFloat32().assertEquals(-21.848739624023438)
	(60. - shieldContactDamage(3., 1.)).roundToFloat32().assertEquals(57.900001525878906)
	(60. - shieldContactDamage(10., 1.)).roundToFloat32().assertEquals(53.)
	(60. - shieldContactDamage(30., 1.)).roundToFloat32().assertEquals(39.)
	(30. - shieldContactDamage(3., 1.)).roundToFloat32().assertEquals(27.899999618530273)
	(30. - shieldContactDamage(10., 1.)).roundToFloat32().assertEquals(23.)
	(30. - shieldContactDamage(30., 1.)).roundToFloat32().assertEquals(9.)
	(1. - shieldContactDamage(3., 1.)).roundToFloat32().assertEquals(-1.0999999046325684)
	(1. - shieldContactDamage(10., 1.)).roundToFloat32().assertEquals(-6.)
	(1. - shieldContactDamage(30., 1.)).roundToFloat32().assertEquals(-20.)

@Test function observedRetailShieldPushback()
	shieldPushback(3., 0.4000000059604645).assertEquals(0.6126000285148621 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(10., 0.4000000059604645).assertEquals(1.4820001125335693 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(30., 0.4000000059604645).assertEquals(2. * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(3., 0.0028011202812194824).assertEquals(0.7520168423652649 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(10., 0.0028011202812194824).assertEquals(1.9467227458953857 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(30., 0.0028011202812194824).assertEquals(2. * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(3., 0.28851544857025146).assertEquals(0.6517311334609985 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(10., 0.28851544857025146).assertEquals(1.612437129020691 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(30., 0.28851544857025146).assertEquals(2. * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(3., 0.6918767690658569).assertEquals(0.5101513266563416 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(10., 0.6918767690658569).assertEquals(1.140504240989685 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(30., 0.6918767690658569).assertEquals(2. * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(3., 1.).assertEquals(0.4020000398159027 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(10., 1.).assertEquals(0.7800000905990601 * WORLD_UNITS_PER_MELEE_UNIT)
	shieldPushback(30., 1.).assertEquals(1.8600001335144043 * WORLD_UNITS_PER_MELEE_UNIT)

@Test function observedRetailShieldPressure()
	analogShieldStrength(77).assertEquals(0.0028011202812194824)
	analogShieldStrength(128).assertEquals(0.28851544857025146)
	analogShieldStrength(200).assertEquals(0.6918767690658569)
	analogShieldStrength(255).assertEquals(1.)

