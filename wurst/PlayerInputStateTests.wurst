package PlayerInputStateTests
import PlayerInputState
import KeyBindings

@Test function participantsOwnIndependentSameKeyPressAndRelease()
    let first = new PlayerInputState()
    let second = new PlayerInputState()
    let firstBindings = new KeyBindings(false)
    let secondBindings = new KeyBindings(false)
    first.press(78, firstBindings).assertEquals(ATTACK)
    first.actionHeld(ATTACK).assertTrue()
    second.actionHeld(ATTACK).assertFalse()
    second.press(78, secondBindings).assertEquals(ATTACK)
    second.actionHeld(ATTACK).assertTrue()
    first.release(78, firstBindings).assertEquals(ATTACK)
    first.actionHeld(ATTACK).assertFalse()
    second.actionHeld(ATTACK).assertTrue()
    second.release(78, secondBindings).assertEquals(ATTACK)
    second.actionHeld(ATTACK).assertFalse()

@Test function pressAndReleaseWithinOneBatchRetainsOnlyOwnedEdge()
    let first = new PlayerInputState()
    let second = new PlayerInputState()
    let bindings = new KeyBindings(false)
    first.press(78, bindings)
    first.release(78, bindings)
    first.actionHeld(ATTACK).assertFalse()
    first.consumePressed(ATTACK).assertTrue()
    first.consumePressed(ATTACK).assertFalse()
    second.consumePressed(ATTACK).assertFalse()

@Test function resetDropsHeldKeysPulsesAndEdgesWithoutTouchingOtherPlayer()
    let first = new PlayerInputState()
    let second = new PlayerInputState()
    let bindings = new KeyBindings(false)
    first.press(83, bindings)
    second.press(83, bindings)
    first.pulsePending().assertTrue()
    second.pulsePending().assertTrue()
    first.clear()
    first.actionHeld(MOVE_LEFT).assertFalse()
    first.pulsePending().assertFalse()
    first.consumePressed(MOVE_LEFT).assertFalse()
    second.actionHeld(MOVE_LEFT).assertTrue()
    second.pulsePending().assertTrue()

@Test function playerSpecificBindingsRemainIndependent()
    let first = new PlayerInputState()
    let second = new PlayerInputState()
    let firstBindings = new KeyBindings(false)
    let secondBindings = new KeyBindings(false)
    secondBindings.rebind(ATTACK, 0, 79)
    first.press(78, firstBindings)
    second.press(78, secondBindings)
    first.actionHeld(ATTACK).assertTrue()
    second.actionHeld(ATTACK).assertFalse()
    second.press(79, secondBindings)
    second.actionHeld(ATTACK).assertTrue()
