package JournalTextStreamTests
import JournalTextStream
import JournalInputSource
import InputProtocol
import NetworkInput

@Test function journalTextGoldenWireAndReceiptFollowConsumption()
    let stream = new JournalTextStream()
    stream.reset(1)
    let envelope = "@J10000000001000000000102742|I421100;"
    journalTextEnvelope(1, 1, "I421100").assertEquals(envelope)
    stream.inspect(envelope).assertEquals(JOURNAL_TEXT_READY)
    stream.wire().assertEquals("I421100")
    stream.received().assertEquals(1)
    stream.acknowledged().assertEquals(0)
    stream.inspect(envelope).assertEquals(JOURNAL_TEXT_SKIP)
    stream.received().assertEquals(1)
    stream.consumed().assertTrue()
    stream.acknowledged().assertEquals(1)
    stream.inspect(envelope).assertEquals(JOURNAL_TEXT_SKIP)
    stream.consumed().assertFalse()
    stream.acknowledged().assertEquals(1)

@Test function journalTextRecoversInterruptedEnvelopeWithoutAcceptingCorruption()
    let stream = new JournalTextStream()
    stream.reset(1)
    let envelope = journalTextEnvelope(1, 1, "I421100")
    let partial = envelope.substring(0, 33)
    stream.inspect(partial).assertEquals(JOURNAL_TEXT_WAIT)
    stream.inspect(partial + envelope).assertEquals(JOURNAL_TEXT_SKIP)
    stream.discardWidth().assertEquals(partial.length())
    stream.acknowledged().assertEquals(0)
    stream.inspect(envelope.substring(0, 29) + "i421100;").assertEquals(JOURNAL_TEXT_SKIP)
    stream.acknowledged().assertEquals(0)
    stream.inspect(envelope).assertEquals(JOURNAL_TEXT_READY)
    stream.consumed().assertTrue()
    stream.inspect(journalTextEnvelope(1, 1, "I421300")).assertEquals(JOURNAL_TEXT_INVALID)
    stream.acknowledged().assertEquals(1)

@Test function journalTextReplaysFocusGapWithoutRetaggingOrDuplicateApplication()
    let stream = new JournalTextStream()
    let journal = new JournalInputSource()
    let packet = new InputPacket()
    let neutral = new NetworkInput()
    stream.reset(1)
    journal.beginEpoch("focus", 1, 0, 0).assertTrue()
    for sequence = 1 to 23
        packet.assign(1, sequence * 2 - 1, 2, neutral, neutral).assertTrue()
        stream.inspect(journalTextEnvelope(1, sequence, packet.encode())).assertEquals(JOURNAL_TEXT_READY)
        journal.decode(stream.wire(), 100).assertEquals(JOURNAL_READY)
        journal.sent().assertTrue()
        stream.consumed().assertTrue()
    journal.expectedFrame().assertEquals(47)
    packet.assign(1, 57, 2, neutral, neutral).assertTrue()
    stream.inspect(journalTextEnvelope(1, 29, packet.encode())).assertEquals(JOURNAL_TEXT_SKIP)
    stream.acknowledged().assertEquals(23)
    journal.expectedFrame().assertEquals(47)
    for sequence = 24 to 30
        packet.assign(1, sequence * 2 - 1, 2, neutral, neutral).assertTrue()
        let envelope = journalTextEnvelope(1, sequence, packet.encode())
        stream.inspect(envelope).assertEquals(JOURNAL_TEXT_READY)
        journal.decode(stream.wire(), 100).assertEquals(JOURNAL_READY)
        journal.packetFrame().assertEquals(sequence * 2 - 1)
        journal.sent().assertTrue()
        stream.consumed().assertTrue()
        stream.inspect(envelope).assertEquals(JOURNAL_TEXT_SKIP)
    journal.expectedFrame().assertEquals(61)
    stream.acknowledged().assertEquals(30)

@Test function journalTextDrainsDuplicateRetriesWhileConsumptionIsBlocked()
    let stream = new JournalTextStream()
    stream.reset(1)
    for sequence = 1 to JOURNAL_TEXT_WINDOW
        let wire = "I42" + I2S(sequence) + "100"
        stream.inspect(journalTextEnvelope(1, sequence, wire)).assertEquals(JOURNAL_TEXT_READY)
        stream.received().assertEquals(sequence)
        stream.acknowledged().assertEquals(0)
    for sequence = 1 to JOURNAL_TEXT_WINDOW
        let wire = "I42" + I2S(sequence) + "100"
        let envelope = journalTextEnvelope(1, sequence, wire)
        stream.inspect(envelope + envelope).assertEquals(JOURNAL_TEXT_SKIP)
        stream.discardWidth().assertEquals(envelope.length())
        stream.received().assertEquals(JOURNAL_TEXT_WINDOW)
        stream.acknowledged().assertEquals(0)
    for sequence = 1 to JOURNAL_TEXT_WINDOW
        let wire = "I42" + I2S(sequence) + "100"
        stream.wire().assertEquals(wire)
        stream.consumed().assertTrue()
        stream.acknowledged().assertEquals(sequence)
    stream.wire().assertEquals("")
    stream.consumed().assertFalse()

@Test function journalTextEpochChangeDiscardsPreviousSessionAndRestartsReceipt()
    let stream = new JournalTextStream()
    stream.reset(1)
    stream.inspect(journalTextEnvelope(1, 1, "I421100")).assertEquals(JOURNAL_TEXT_READY)
    stream.consumed().assertTrue()
    stream.reset(2)
    stream.inspect(journalTextEnvelope(1, 2, "I421300")).assertEquals(JOURNAL_TEXT_SKIP)
    stream.acknowledged().assertEquals(0)
    stream.inspect(journalTextEnvelope(2, 1, "I422100")).assertEquals(JOURNAL_TEXT_READY)
    stream.consumed().assertTrue()
    stream.acknowledged().assertEquals(1)
