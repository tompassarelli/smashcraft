package KeyBindingsTests
import KeyBindings

@Test function presetNumberRowsMatchTheOwnerMapping()
    let custom = new KeyBindings(true)
    let standard = new KeyBindings(false)
    custom.keyFor(RIGHT_TRIGGER, 0).assertEquals(56)
    standard.keyFor(RIGHT_TRIGGER, 0).assertEquals(55)
    custom.keyFor(JUMP, 1).assertEquals(57)
    standard.keyFor(JUMP, 1).assertEquals(56)
    custom.actionFor(76).assertEquals(GRAB)
    standard.actionFor(76).assertEquals(GRAB)
    custom.keyFor(WALK_MODIFIER, 0).assertEquals(186)
    standard.keyFor(WALK_MODIFIER, 0).assertEquals(186)

@Test function rebindRejectsConflictsAndReservedKeys()
    let bindings = new KeyBindings(true)
    bindings.rebind(GRAB, 0, 78).assertFalse()
    bindings.keyFor(GRAB, 0).assertEquals(76)
    bindings.rebind(GRAB, 0, 117).assertFalse()
    bindings.rebind(GRAB, 0, 118).assertFalse()
    bindings.rebind(GRAB, 0, 71).assertTrue()
    bindings.actionFor(71).assertEquals(GRAB)
    bindings.actionFor(76).assertEquals(-1)

@Test function savedBindingsRoundTripAndMalformedDataIsAtomic()
    let source = new KeyBindings(true)
    source.rebind(GRAB, 0, 71).assertTrue()
    let saved = source.encode()
    let restored = new KeyBindings(false)
    restored.restore(saved).assertTrue()
    restored.encode().assertEquals(saved)
    restored.restore("K1broken").assertFalse()
    restored.encode().assertEquals(saved)
    restored.restore("XX" + saved.substring(2)).assertFalse()
    restored.encode().assertEquals(saved)

@Test function existingSavedControlsGainWalkWithoutLosingRebindings()
    let source = new KeyBindings(true)
    source.rebind(GRAB, 0, 71).assertTrue()
    let previous = "K1" + source.encode().substring(2, 86)
    let restored = new KeyBindings(false)
    restored.restore(previous).assertTrue()
    restored.keyFor(GRAB, 0).assertEquals(71)
    restored.keyFor(RIGHT_TRIGGER, 0).assertEquals(56)
    restored.keyFor(WALK_MODIFIER, 0).assertEquals(186)
    source.rebind(WALK_MODIFIER, 0, 0).assertTrue()
    source.rebind(GRAB, 0, 186).assertTrue()
    restored.restore("K1" + source.encode().substring(2, 86)).assertTrue()
    restored.keyFor(GRAB, 0).assertEquals(186)
    restored.keyFor(WALK_MODIFIER, 0).assertEquals(0)

@Test function movementBlockUsesQwerInBothPresets()
    for preset = 0 to 1
        let bindings = new KeyBindings(preset == 1)
        bindings.actionFor(81).assertEquals(LEFT_TRIGGER)
        bindings.actionFor(87).assertEquals(MOVE_LEFT)
        bindings.actionFor(69).assertEquals(MOVE_DOWN)
        bindings.actionFor(82).assertEquals(MOVE_RIGHT)
        bindings.actionFor(76).assertEquals(GRAB)
        bindings.actionFor(78).assertEquals(ATTACK)
        destroy bindings

@Test function savedDefaultMovementBlockMigratesWithoutLosingCustomAttackBinding()
    let old = new KeyBindings(true)
    old.rebind(MOVE_LEFT, 0, 83).assertTrue()
    old.rebind(MOVE_RIGHT, 0, 70).assertTrue()
    old.rebind(MOVE_DOWN, 0, 68).assertTrue()
    old.rebind(LEFT_TRIGGER, 0, 65).assertTrue()
    old.rebind(ATTACK, 0, 71).assertTrue()
    let restored = new KeyBindings(false)
    restored.restore(old.encode()).assertTrue()
    restored.actionFor(81).assertEquals(LEFT_TRIGGER)
    restored.actionFor(87).assertEquals(MOVE_LEFT)
    restored.actionFor(69).assertEquals(MOVE_DOWN)
    restored.actionFor(82).assertEquals(MOVE_RIGHT)
    restored.actionFor(71).assertEquals(ATTACK)
    restored.keyFor(RIGHT_TRIGGER, 0).assertEquals(56)
    old.rebind(GRAB, 0, 81).assertTrue()
    restored.restore(old.encode()).assertTrue()
    restored.actionFor(81).assertEquals(GRAB)
    restored.actionFor(83).assertEquals(MOVE_LEFT)
    destroy restored
    destroy old
