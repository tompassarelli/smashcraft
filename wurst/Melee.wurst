function traceInput(string entry)
    if inputTraceActive and inputTraceCount < (RESPONSE_SERVICE_PROBE ? 2048 : 256)
        inputTraceLines[inputTraceCount] = I2S(inputTraceTicks) + " " + R2S(TimerGetElapsed(inputTraceClock)) + " " + entry
        inputTraceCount++
    else if inputTraceActive
        inputTraceDropped++

function traceParticipant(int participantId, string entry)
    traceInput("participant " + I2S(participantId) + " frame " + I2S(replayRuntime.simulationFrame) + " phase " + I2S(matchState.phase) + " " + entry)

function resetShadowBatchSummary()
    shadowTraceSentRows = 0
    shadowTraceSingletons = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowTraceReceivedRows[slot] = 0
    shadowTraceBatchWaitSamples = 0
    shadowTraceBatchWaitSumCallbacks = 0
    shadowTraceBatchWaitMaxCallbacks = 0
    shadowTraceBatchWaitSumSeconds = 0
    shadowTraceBatchWaitMaxSeconds = 0

function resetShadowEchoRing()
    shadowTraceEchoPending = 0
    for slot = 0 to SHADOW_TRACE_ECHO_CAPACITY - 1
        shadowTraceSendEpoch[slot] = -1
        shadowTraceSendFrame[slot] = 0
        shadowTraceSendCallback[slot] = 0
        shadowTraceSendTime[slot] = 0

function resetShadowEchoSummary()
    shadowTraceEchoOverwritten = 0
    shadowTraceEchoSamples = 0
    shadowTraceEchoMinCallbacks = 0
    shadowTraceEchoMaxCallbacks = 0
    shadowTraceEchoSumCallbacks = 0
    shadowTraceEchoMinSeconds = 0
    shadowTraceEchoMaxSeconds = 0
    shadowTraceEchoSumSeconds = 0
    for bin = 0 to 5
        shadowTraceEchoBins[bin] = 0

// Local measurements never feed the accepted ledger, prediction, or snapshots.

function recordShadowTraceSend(int epoch, int frame)
    let slot = frame mod SHADOW_TRACE_ECHO_CAPACITY
    if shadowTraceSendFrame[slot] != 0
        shadowTraceEchoOverwritten++
    else
        shadowTraceEchoPending++
    shadowTraceSendEpoch[slot] = epoch
    shadowTraceSendFrame[slot] = frame
    shadowTraceSendCallback[slot] = inputTraceTicks
    shadowTraceSendTime[slot] = TimerGetElapsed(inputTraceClock)

function recordShadowTraceEcho(int epoch, int frame, int callback, real seconds)
    let slot = frame mod SHADOW_TRACE_ECHO_CAPACITY
    if shadowTraceSendFrame[slot] != frame or shadowTraceSendEpoch[slot] != epoch
        return
    let ageCallbacks = callback - shadowTraceSendCallback[slot]
    let ageSeconds = seconds - shadowTraceSendTime[slot]
    shadowTraceSendFrame[slot] = 0
    shadowTraceEchoPending--
    if shadowTraceEchoSamples == 0
        shadowTraceEchoMinCallbacks = ageCallbacks
        shadowTraceEchoMinSeconds = ageSeconds
    shadowTraceEchoSamples++
    shadowTraceEchoMinCallbacks = min(shadowTraceEchoMinCallbacks, ageCallbacks)
    shadowTraceEchoMaxCallbacks = max(shadowTraceEchoMaxCallbacks, ageCallbacks)
    shadowTraceEchoSumCallbacks += ageCallbacks
    shadowTraceEchoMinSeconds = min(shadowTraceEchoMinSeconds, ageSeconds)
    shadowTraceEchoMaxSeconds = max(shadowTraceEchoMaxSeconds, ageSeconds)
    shadowTraceEchoSumSeconds += ageSeconds
    let bin = ageCallbacks <= 3 ? 0 : (ageCallbacks <= 6 ? 1 : (ageCallbacks <= 9 ? 2 : (ageCallbacks <= 12 ? 3 : (ageCallbacks <= 18 ? 4 : 5))))
    shadowTraceEchoBins[bin]++

function traceShadowEchoSummary()
    let divisor = max(1, shadowTraceEchoSamples)
    traceInput("local echo samples " + I2S(shadowTraceEchoSamples)
        + " pending " + I2S(shadowTraceEchoPending) + " overwritten " + I2S(shadowTraceEchoOverwritten)
        + " callbacks min-mean-max " + I2S(shadowTraceEchoMinCallbacks) + ":" + R2S(shadowTraceEchoSumCallbacks * 1.0 / divisor) + ":" + I2S(shadowTraceEchoMaxCallbacks))
    traceInput("local echo native-ms min-mean-max " + R2S(shadowTraceEchoMinSeconds * 1000) + ":" + R2S(shadowTraceEchoSumSeconds * 1000 / divisor) + ":" + R2S(shadowTraceEchoMaxSeconds * 1000)
        + " callbacks bins 0-3,4-6,7-9,10-12,13-18,19+ " + I2S(shadowTraceEchoBins[0]) + ":" + I2S(shadowTraceEchoBins[1]) + ":" + I2S(shadowTraceEchoBins[2]) + ":" + I2S(shadowTraceEchoBins[3]) + ":" + I2S(shadowTraceEchoBins[4]) + ":" + I2S(shadowTraceEchoBins[5]))
    resetShadowEchoSummary()

function traceConfirmedState()
    if participants[matchState.firstHumanSlot()].fighter == null
        return
    let started = TimerGetElapsed(inputTraceClock)
    diagnosticSnapshot.capture(matchWorld, matchState, matchInputs, replayRuntime)
    let checksum = diagnosticSnapshot.checksum()
    let elapsed = TimerGetElapsed(inputTraceClock) - started
    traceInput("confirmed frame " + I2S(replayRuntime.simulationFrame)
        + " state " + checksum)
    traceInput("checksum native-seconds " + R2S(elapsed))

function traceSelectionState(string reason)
    if not inputTraceActive
        return
    traceInput("selection " + reason + " phase " + I2S(matchState.phase)
        + " connected " + I2S(matchState.humanMask) + " human-fighters " + I2S(matchState.humanFighterMask)
        + " computers " + I2S(matchState.computerMask) + " fighters " + I2S(matchState.fighterMask()))
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let mode = matchState.humanFighterActive(slot) ? "HMN" : (matchState.computerActive(slot) ? "CPU" : "EMPTY")
        traceInput("selection slot " + I2S(slot) + " mode " + mode + " choice " + I2S(matchState.characterFor(slot))
            + " ready " + (matchState.characterReady(slot) ? "1" : "0"))

function startInputTrace()
    if inputTraceClock == null
        inputTraceClock = CreateTimer()
    inputTraceTicks = 0
    inputTracePausedTicks = 0
    inputTraceCount = 0
    inputTraceDropped = 0
    inputTraceLastAxes = 999
    inputTraceLastDodge = -1
    inputTraceLastLandingLag = -1
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowTraceAccepted[slot] = 0
    shadowTraceRejected = 0
    shadowTraceRawSyncEvents = 0
    shadowTraceWaitTicks = 0
    shadowTraceConfirmedSteps = 0
    shadowTraceSpeculativeSteps = 0
    shadowTraceSpeculativeFailures = 0
    shadowTraceCorrections = 0
    shadowTraceReplayedFrames = 0
    shadowTraceMaxReplayDepth = 0
    shadowTraceLocalPolls = 0
    shadowTraceLocalCaptures = 0
    shadowTraceLocalSends = 0
    shadowTraceSameTargetSkips = 0
    shadowTraceWindowBlocks = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowTraceKeyDown[slot] = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowTraceKeyUp[slot] = 0
    shadowTraceEchoPending = 0
    resetShadowBatchSummary()
    shadowBatchCaptureTraced[0] = false
    shadowBatchCaptureTraced[1] = false
    resetShadowEchoSummary()
    resetShadowEchoRing()
    inputTraceActive = true
    TimerStart(inputTraceClock, 1000, false, null)
    traceInput("start " + BUILD_ID + " input " + INPUT_PROFILE + " presentation " + PRESENTATION_PROFILE)
    traceInput("humans " + I2S(matchState.humanCount) + " frame " + I2S(replayRuntime.simulationFrame) + " phase " + I2S(matchState.phase))
    traceConfirmedState()
    traceSelectionState("trace-start")
    let receiptStarted = TimerGetElapsed(inputTraceClock)
    PreloadGenClear()
    PreloadGenStart()
    Preload("TRACE START " + BUILD_ID)
    PreloadGenEnd("wc3-melee-input-start.txt")
    traceInput("trace-start receipt native-seconds " + R2S(TimerGetElapsed(inputTraceClock) - receiptStarted))

function finishInputTrace()
    inputTraceActive = false
    PauseTimer(inputTraceClock)
    PreloadGenClear()
    PreloadGenStart()
    for i = 0 to inputTraceCount - 1
        Preload(inputTraceLines[i])
    Preload("dropped " + I2S(inputTraceDropped))
    Preload(I2S(inputTraceTicks) + " " + R2S(TimerGetElapsed(inputTraceClock)) + " end")
    PreloadGenEnd("wc3-melee-input-trace.txt")

class Fighter extends FighterState
    unit body
    effect dizzyEffect = null
    int renderedSelection = 0

    construct(player owner, int fighterType, real startX, int direction)
        super(fighterType, startX, direction)
        body = CreateUnit(owner, fighterType == 2 ? DEMON_HUNTER_FIGHTER_ID : (fighterType == 0 ? ARCHER_FIGHTER_ID : RIFLEMAN_FIGHTER_ID), centerX + startX, centerY, direction > 0 ? 0 : 180)
        SetUnitInvulnerable(body, true)
        SetUnitPathing(body, false)
        UnitAddAbility(body, 'Amrf')
        UnitRemoveAbility(body, 'Amrf')
        UnitAddAbility(body, 'Aloc')
        PauseUnit(body, true)
        // A blended transition can retain the previous pose throughout hitlag.
        SetUnitBlendTime(body, 0.)
        place()

    function place()
        SetUnitX(body, centerX + x)
        SetUnitY(body, centerY)
        SetUnitFlyHeight(body, 1800 + z, 0)
        BlzSetUnitFacingEx(body, fighterPoseFacing(this) > 0 ? 0 : 180)

    function clearDizzyEffect()
        if dizzyEffect != null
            BlzSetSpecialEffectScale(dizzyEffect, 0.)
            DestroyEffect(dizzyEffect)
            dizzyEffect = null

    function renderDizzy()
        if shieldBreakState != SHIELD_BREAK_DIZZY or out or matchState.phase != MATCH
            clearDizzyEffect()
            return
        if dizzyEffect == null
            dizzyEffect = AddSpecialEffect(Abilities.thunderclapTarget, centerX + x, centerY)
        BlzSetSpecialEffectPosition(dizzyEffect, centerX + x, centerY, floorHeight + z + 115)


function frameText(string name, real x, real y, real width, real height, real size) returns framehandle
    let result = BlzCreateFrameByType("TEXT", name, BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
    BlzFrameSetAbsPoint(result, FRAMEPOINT_TOPLEFT, x, y)
    BlzFrameSetSize(result, width, height)
    BlzFrameSetFont(result, "Fonts\\FRIZQT__.TTF", size, 0)
    BlzFrameSetTextAlignment(result, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
    return result

function clearStageDecks()
    for i = 0 to stageDeckCount - 1
        BlzSetSpecialEffectScale(stageDecks[i], 0.)
        DestroyEffect(stageDecks[i])
        stageDecks[i] = null
    stageDeckCount = 0

function clearProjectileModels()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if participants[slot].projectiles != null
            participants[slot].projectiles.clear()

function drawStage()
    clearStageDecks()
    for i = 0 to surfaceCount(matchState.stageChoice) - 1
        let left = surfaceLeft(matchState.stageChoice, i)
        let right = surfaceRight(matchState.stageChoice, i)
        let pass = surfacePass(matchState.stageChoice, i)
        let deck = AddSpecialEffect(STAGE_DECK_MODEL, centerX + (left + right) / 2, centerY)
        BlzSetSpecialEffectPosition(deck, centerX + (left + right) / 2, centerY, floorHeight + surfaceZ(matchState.stageChoice, i))
        // The authored walking plane spans [-50,50] at z=0; the body stays below it.
        BlzSetSpecialEffectMatrixScale(deck, (right - left) / 100, pass ? 0.65 : 1., pass ? 0.45 : 1.)
        stageDecks[stageDeckCount] = deck
        stageDeckCount++

function announce(string message)
    statusText = message
    statusTime = 2

function traceFrameInput(int participantId, InputSnapshot input, AttackBuffer attacks, int frame)
    if inputTraceActive and (input.jumpPressed or input.airDodgePressed or input.specialPressed or attacks.hasPending(frame))
        traceInput("participant " + I2S(participantId) + " frame " + I2S(frame) + " phase " + I2S(matchState.phase) + " sampled x " + I2S(input.direction) + " z " + I2S(input.verticalDirection) + " jump " + (input.jumpPressed ? "1" : "0") + " dodge " + (input.airDodgePressed ? "1" : "0") + " special " + (input.specialPressed ? "1" : "0") + " attack " + I2S(attacks.hasPending(frame) ? attacks.style : -1))

function traceSpecialAction(int participantId, Fighter f, int previousAction)
    if f.specialAction != previousAction
        traceParticipant(participantId, "special " + I2S(f.specialAction) + " action-frame " + I2S(f.specialFrame) + " x " + R2S(f.x) + " z " + R2S(f.z))

function traceRecovery(int participantId, Fighter f, int previousDown, boolean previouslyActionable)
    if inputTraceActive and (f.downState != previousDown or canAttack(f) != previouslyActionable)
        traceParticipant(participantId, "recovery down " + I2S(f.downState) + " actionable " + (canAttack(f) ? "1" : "0") + " hitlag " + I2S(f.hitlag) + " hitstun " + I2S(f.hitstun) + " damage " + R2S(f.damage))

function sendShadowBatch()
    let count = shadowBatch.recordCount()
    if count == 0 or shadowLocalSendFailed
        return
    if not shadowBatch.prepare(shadowOutgoing)
        shadowLocalSendFailed = true
        statusText = "Controls stopped responding. Restart the match."
        statusTime = 3600
        return
    let wire = shadowOutgoing.encode()
    if not inputPacketSizeInRange(wire.length(), count)
        shadowLocalSendFailed = true
        statusText = "Controls stopped responding. Restart the match."
        statusTime = 3600
        return
    let sendStartedMs = responseProbeClockMs()
    let sent = BlzSendSyncData("SC_GP", wire)
    responseProbeSendCallFinish(sendStartedMs)
    if not sent
        shadowLocalSendFailed = true
        statusText = "Controls stopped responding. Restart the match."
        statusTime = 3600
        return
    if RESPONSE_SERVICE_PROBE
        for row = 0 to count - 1
            responseProbeTransportSend(shadowInputEpoch, shadowBatch.firstFrameNumber() + row)
    if inputTraceActive
        shadowTraceLocalSends++
        shadowTraceSentRows += count
        if count == 1
            shadowTraceSingletons++
        for row = 0 to count - 1
            recordShadowTraceSend(shadowInputEpoch, shadowBatch.firstFrameNumber() + row)
            if shadowBatchCaptureTraced[row]
                let callbacks = inputTraceTicks - shadowBatchCaptureCallback[row]
                let seconds = TimerGetElapsed(inputTraceClock) - shadowBatchCaptureTime[row]
                shadowTraceBatchWaitSamples++
                shadowTraceBatchWaitSumCallbacks += callbacks
                shadowTraceBatchWaitMaxCallbacks = max(shadowTraceBatchWaitMaxCallbacks, callbacks)
                shadowTraceBatchWaitSumSeconds += seconds
                shadowTraceBatchWaitMaxSeconds = max(shadowTraceBatchWaitMaxSeconds, seconds)
    shadowBatch.sent()

function failJournalInput(string reason)
	if journalInputFailed
		return
	if transportIsolationPhase == 3
		transportIsolationFailed++
	journalInputFailed = true
	statusText = "Controller input stopped. Restart the match."
	statusTime = 3600
	if inputTraceActive
		traceInput("journal stopped " + reason + " sequence " + I2S(journalInput.sequenceNumber()) + " frame " + I2S(journalInput.expectedFrame()))
	if RESPONSE_SERVICE_PROBE
		let slot = GetPlayerId(GetLocalPlayer())
		PreloadGenClear()
		PreloadGenStart()
		Preload("build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot))
		Preload("reason=" + reason + " sequence=" + I2S(journalInput.sequenceNumber()) + " frame=" + I2S(journalInput.expectedFrame()))
		PreloadGenEnd("smashcraft-journal-failure-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-p" + I2S(slot) + ".txt")

function writeJournalControl(boolean wantPaused)
	if journalInput == null or journalPausePending or (not wantPaused and journalChatBusy())
		return
	let slot = GetPlayerId(GetLocalPlayer())
	let sequence = journalInput.controlSequenceNumber()
	let controlName = "smashcraft-journal-control-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-s" + I2S(slot) + "-n" + I2S(sequence) + ".txt"
	PreloadGenClear()
	PreloadGenStart()
	Preload("SMASHCRAFT JOURNAL CONTROL v=1 build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot) + " sequence=" + I2S(sequence) + " state=" + (wantPaused ? "PAUSE" : "RESUME") + " frame=" + I2S(journalInput.expectedFrame()))
	PreloadGenEnd(controlName)
	if not journalInput.controlRequestSent()
		failJournalInput("could not sequence pause request")
		return
	for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		journalControlAckSeen[participant] = false
		journalControlAckFrameBySlot[participant] = 0
		journalControlAckStateBySlot[participant] = 0
	journalPauseAckReceived = false
	journalPauseCommitSent = false
	journalPausePrepareComplete = false
	journalPauseAckFrame = 0
	journalPausePending = true
	journalPauseAckReceived = false
	journalPauseTarget = wantPaused
	statusText = wantPaused ? "Pausing…" : "Resuming…"
	statusTime = 3600

function serviceJournalPauseAck()
	if not journalPausePending or journalPauseAckReceived
		return
	let localPlayer = GetLocalPlayer()
	let sequence = journalInput.controlSequenceNumber()
	var wire = ""
	if JOURNAL_EDITBOX_INGRESS
		wire = editboxJournalIngress.peek()
		if editboxJournalIngress.failed() != ""
			failJournalInput(editboxJournalIngress.failed())
			return
	else if JOURNAL_KEYBOARD_INGRESS
		keyboardJournalIngress.pollChunk()
		let assembled = keyboardJournalIngress.assembledWire()
		if keyboardJournalIngress.hasFinalChunk() and assembled.length() >= 5 and assembled.substring(0, 5) == "ACK1|"
			wire = assembled
	else
		wire = vocabularyReadControlAck(journalInput.controlAckBase())
	let expectedState = journalPauseTarget ? (journalPauseCommitSent ? "PAUSE" : "PREPARE") : "RESUME"
	if not journalInput.acceptControlAck(wire, expectedState)
		return
	let slot = GetPlayerId(localPlayer)
	let stateCode = expectedState == "PREPARE" ? "Q" : (expectedState == "PAUSE" ? "P" : "R")
	let syncWire = "JC1" + journalPad10(shadowInputEpoch) + I2S(slot) + journalPad10(sequence) + stateCode + journalPad10(journalInput.controlAckFrame())
	if not BlzSendSyncData("SC_JC", syncWire)
		failJournalInput("pause acknowledgment could not be synchronized")
	else if JOURNAL_EDITBOX_INGRESS
		if not editboxJournalIngress.consumed()
			failJournalInput(editboxJournalIngress.failed())
	else if JOURNAL_KEYBOARD_INGRESS
		keyboardJournalIngress.acknowledgeFinalMessage()

function sendJournalPauseCommit()
	if not journalPausePending or not journalPauseTarget or journalPauseCommitSent or not journalPausePrepareComplete
		return
	let slot = GetPlayerId(GetLocalPlayer())
	let sequence = journalInput.controlSequenceNumber()
	let controlName = "smashcraft-journal-control-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-s" + I2S(slot) + "-n" + I2S(sequence) + ".txt"
	PreloadGenClear()
	PreloadGenStart()
	Preload("SMASHCRAFT JOURNAL CONTROL v=1 build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot) + " sequence=" + I2S(sequence) + " state=PAUSE_COMMIT frame=" + I2S(journalPauseAckFrame))
	PreloadGenEnd(controlName)
	if not journalInput.controlRequestSent()
		failJournalInput("could not sequence pause barrier")
		return
	for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		journalControlAckSeen[participant] = false
		journalControlAckFrameBySlot[participant] = 0
		journalControlAckStateBySlot[participant] = 0
	journalPauseAckReceived = false
	journalPauseCommitSent = true
	journalPausePrepareComplete = false

function journalPad10(int value) returns string
	var text = I2S(value)
	while text.length() < 10
		text = "0" + text
	return text

function receiveJournalControlAck()
	let sender = GetTriggerPlayer()
	let wire = BlzGetTriggerSyncData()
	if wire.length() != 35 or wire.substring(0, 3) != "JC1"
		return
	let epoch = S2I(wire.substring(3, 13))
	let slot = S2I(wire.substring(13, 14))
	let sequence = S2I(wire.substring(14, 24))
	let stateCode = wire.substring(24, 25)
	let frame = S2I(wire.substring(25, 35))
	if epoch != shadowInputEpoch or slot != GetPlayerId(sender) or frame <= 0
		return
	let state = stateCode == "Q" ? 1 : (stateCode == "P" ? 2 : (stateCode == "R" ? 3 : 0))
	let expectedState = journalPauseTarget ? (journalPauseCommitSent ? 2 : 1) : 3
	if state == 0 or state != expectedState or not journalPausePending
		return
	if sequence != journalControlAckSeqBySlot[slot] + 1
		failJournalInput("pause acknowledgments arrived out of sequence")
		return
	journalControlAckSeqBySlot[slot] = sequence
	journalControlAckSeen[slot] = true
	journalControlAckFrameBySlot[slot] = frame
	journalControlAckStateBySlot[slot] = state
	var complete = true
	for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		if matchState.humanActive(participant)
			if not journalControlAckSeen[participant]
				complete = false
			else if journalControlAckStateBySlot[participant] != state
				complete = false
	if complete
		let commonFrame = journalPauseBarrierFrame(journalControlAckFrameBySlot[0], journalControlAckFrameBySlot[1], journalControlAckFrameBySlot[2], journalControlAckFrameBySlot[3])
		if state != 1
			for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
				if matchState.humanActive(participant) and journalControlAckFrameBySlot[participant] != commonFrame
					failJournalInput("players acknowledged different pause frames")
					return
		if state == 1
			journalPauseAckFrame = commonFrame
			journalPausePrepareComplete = true
		else
			journalPauseAckReceived = true
			journalPauseAckFrame = commonFrame
		if inputTraceActive
			traceInput("all journal controllers acknowledged state " + (state == 1 ? "PREPARE" : (state == 2 ? "PAUSE" : "RESUME")) + " frame " + I2S(commonFrame))

function commitJournalPauseAtFrame()
	if not journalPausePending or not journalPauseAckReceived
		return
	let nextFrame = shadowSchedule.nextConfirmedFrame()
	if nextFrame < journalPauseAckFrame
		return
	if nextFrame > journalPauseAckFrame
		failJournalInput("pause acknowledgment arrived after its frame boundary")
		return
	matchControls.setPaused(journalPauseTarget)
	pauseMatchPresentation(journalPauseTarget)
	statusText = journalPauseTarget ? (JOURNAL_EDITBOX_INGRESS ? "Paused — press Start to resume." : "Paused — press Y to resume.") : "Resumed."
	statusTime = journalPauseTarget ? 3600 : 1
	journalPausePending = false
	journalPauseAckReceived = false

function serviceJournalInput()
	if journalInputFailed
		return
	if JOURNAL_EDITBOX_INGRESS and not journalLifecycle.started()
		let wire = editboxJournalIngress.peek()
		if editboxJournalIngress.failed() != ""
			failJournalInput(editboxJournalIngress.failed())
			return
		let ready = wire == "JR1" + I2S(shadowInputEpoch)
		// Explicit-clock diagnostic producers announce readiness with their first row.
		let diagnostic = wire.length() >= 2 and wire.substring(0, 2) == "I4"
		if not journalTransportStartSent and (ready or diagnostic)
			if not BlzSendSyncData("SC_GP", "J4" + I2S(shadowInputEpoch))
				failJournalInput("controller readiness could not be synchronized")
				return
			journalTransportStartSent = true
			if ready and not editboxJournalIngress.consumed()
				failJournalInput(editboxJournalIngress.failed())
		return
	if not JOURNAL_EDITBOX_INGRESS and RESPONSE_SERVICE_PROBE and not journalTransportStartSent
		journalTransportStartSent = BlzSendSyncData("SC_GP", "J4" + I2S(shadowInputEpoch))
	if not JOURNAL_EDITBOX_INGRESS and RESPONSE_SERVICE_PROBE and journalTransportReadyMask != matchState.humanMask
		return
	if nativePreloadProbeActive() or nativePreloadProbeStartPending() or nativeTransportProbeActive()
		return
	if transportIsolationPhase == 1 or transportIsolationPhase == 2
		return
	if transportIsolationPhase == 3 and not transportIsolationCOffer
		return
	let slot = GetPlayerId(GetLocalPlayer())
	// Connected controllers retain a journal even when their fighter is CPU or empty.
	// MatchFrameInput selects CPU/empty behavior; every sender must still advance.
	if not matchState.humanActive(slot)
		return
	for readIndex = 1 to JOURNAL_PACKETS_PER_CALLBACK
		let latest = min(INPUT_LAST_FRAME, shadowSchedule.nextConfirmedFrame() - 1 + INPUT_FUTURE_LIMIT)
		if journalInput.expectedFrame() > latest
			return
		var wire = ""
		if transportIsolationPhase == 3
			transportIsolationCOffer = false
			transportIsolationAttempts[2]++
			let generatedFrame = journalInput.expectedFrame()
			if not transportIsolationPacket.assign(shadowInputEpoch, generatedFrame, 2, transportIsolationNeutral, transportIsolationNeutral)
				transportIsolationFailed++
				return
			wire = transportIsolationPacket.encode()
		else
			wire = journalInput.bufferedPacket()
			if JOURNAL_EDITBOX_INGRESS
				wire = editboxJournalIngress.peek()
				if editboxJournalIngress.failed() != ""
					failJournalInput(editboxJournalIngress.failed())
					return
				if (wire.length() >= 5 and wire.substring(0, 5) == "ACK1|") or (wire.length() >= 3 and wire.substring(0, 3) == "JP1")
					return
			else if JOURNAL_KEYBOARD_INGRESS
				keyboardJournalIngress.pollChunk()
				let assembled = keyboardJournalIngress.assembledWire()
				if keyboardJournalIngress.hasFinalChunk() and assembled.length() >= 2 and assembled.substring(0, 2) == "I4"
					wire = assembled
				else
					return
			else if wire == ""
				let fileReadStartedMs = responseProbeClockMs()
				wire = vocabularyReadPacket(journalInput.packetBase())
				if fileReadStartedMs >= 0
					responseProbeFileRead(responseProbeClockMs() - fileReadStartedMs, wire.length())
		if wire == ""
			return
		let decoded = journalInput.decode(wire, latest)
		if decoded == JOURNAL_WAIT
			return
		if decoded != JOURNAL_READY
			failJournalInput("invalid or noncontiguous I4 row: " + wire)
			return
		if RESPONSE_SERVICE_PROBE and journalInput.sequenceNumber() == 1 and not inputTraceActive
			startInputTrace()
		let frame = journalInput.packetFrame()
		let count = journalInput.recordCount()
		for rowIndex = 0 to count - 1
			if not journalInput.copyRow(rowIndex, shadowPending)
				failJournalInput("row validation state was lost")
				return
			let captured = shadowSchedule.captureLocalAt(shadowInputEpoch, frame + rowIndex, shadowPending)
			if captured == SHADOW_TOO_FAR_AHEAD or captured == SHADOW_PENDING_FULL
				return
			if captured != SHADOW_CAPTURED and captured != SHADOW_ALREADY_CAPTURED
				failJournalInput("original frame could not be admitted")
				return
			if RESPONSE_SERVICE_PROBE and captured == SHADOW_CAPTURED
				responseProbePoll(shadowPending.heldMask(), shadowPending.pressedMask(), shadowPending.releasedMask(), frame + rowIndex)
			if inputTraceActive and captured == SHADOW_CAPTURED
				shadowTraceLocalCaptures++
		if not inputPacketSizeInRange(wire.length(), count)
			shadowLocalSendFailed = true
			failJournalInput("synchronized input submission failed")
			return
		let isolationSentAt = transportIsolationPhase == 3 ? TimerGetElapsed(transportIsolationClock) : 0
		let sendStartedMs = responseProbeClockMs()
		let sent = BlzSendSyncData("SC_GP", wire)
		responseProbeSendCallFinish(sendStartedMs)
		if not sent
			shadowLocalSendFailed = true
			failJournalInput("synchronized input submission failed")
			return
		if transportIsolationPhase == 3
			let sequence = (frame - transportIsolationFirstCFrame) div 2
			if sequence >= 0 and sequence < 300
				let cSlot = 600 + sequence
				transportIsolationFrame[cSlot] = frame
				transportIsolationSendTime[cSlot] = isolationSentAt
				transportIsolationSubmitted[cSlot] = true
				transportIsolationSent[2]++
				transportIsolationBytesSent[2] += wire.length()
		if RESPONSE_SERVICE_PROBE
			for rowIndex = 0 to count - 1
				responseProbeTransportSend(shadowInputEpoch, frame + rowIndex)
		if inputTraceActive
			shadowTraceLocalSends++
			shadowTraceSentRows += count
			if count == 1
				shadowTraceSingletons++
			for rowIndex = 0 to count - 1
				recordShadowTraceSend(shadowInputEpoch, frame + rowIndex)
			traceInput("journal sent sequence " + I2S(journalInput.sequenceNumber()) + " frame " + I2S(frame) + " count " + I2S(count))
		if not journalInput.sent()
			shadowLocalSendFailed = true
			failJournalInput("journal cursor could not advance after send")
			return
		if JOURNAL_EDITBOX_INGRESS
			if not editboxJournalIngress.consumed()
				failJournalInput(editboxJournalIngress.failed())
				return
		else if JOURNAL_KEYBOARD_INGRESS
			keyboardJournalIngress.acknowledgeFinalMessage()

function shadowCaptureLocalInput()
	if JOURNAL_INPUT_SOURCE
		serviceJournalInput()
		return
    if inputTraceActive
        shadowTraceLocalPolls++
    // Poll neutral while paused or locally inactive. This latches releases;
    // the sampler keeps them until a not-yet-assigned frame can carry them.
    let heldActions = not matchControls.isPaused() ? shadowPollLocal() : 0
    shadowCapture.sample(heldActions)
    if responseProbeRecording()
        shadowCapture.read(responseProbeSample)
        responseProbePoll(heldActions, responseProbeSample.pressedMask(), responseProbeSample.releasedMask(), shadowSchedule.captureTarget())
    if matchControls.isPaused() or shadowLocalSendFailed
        sendShadowBatch()
        return
    let target = shadowSchedule.captureTarget()
    if target == 0
        sendShadowBatch()
        return
    if target == shadowLastCaptureTarget
        if inputTraceActive
            shadowTraceSameTargetSkips++
        // A stalled cursor must never strand the row needed to unblock it.
        sendShadowBatch()
        return
    shadowCapture.read(shadowSample)
    let result = shadowSchedule.captureLocal(shadowInputEpoch, shadowSample)
    if RESPONSE_SERVICE_PROBE
        responseProbeCapture(result)
    if result == SHADOW_ALREADY_CAPTURED
        shadowLastCaptureTarget = target
        return
    if result != SHADOW_CAPTURED
        statusText = "Controls stopped responding. Restart the match."
        statusTime = 3600
        return
    if inputTraceActive
        shadowTraceLocalCaptures++
    shadowCapture.commitCapturedEdges()
    shadowLastCaptureTarget = target
    let batchSlot = shadowBatch.recordCount()
    if not shadowSchedule.copyPending(shadowInputEpoch, target, shadowPending)
            or not shadowBatch.append(shadowInputEpoch, target, shadowPending)
        shadowLocalSendFailed = true
        statusText = "Controls stopped responding. Restart the match."
        statusTime = 3600
        return
    shadowBatchCaptureTraced[batchSlot] = inputTraceActive
    if inputTraceActive
        shadowBatchCaptureCallback[batchSlot] = inputTraceTicks
        shadowBatchCaptureTime[batchSlot] = TimerGetElapsed(inputTraceClock)
    if not SHADOW_INPUT_BATCH2 or shadowBatch.recordCount() == 2
        sendShadowBatch()

function stepConfirmedShadowFrame() returns boolean
    let frame = shadowSchedule.nextConfirmedFrame()
    if not shadowSchedule.readConfirmed(shadowInputEpoch, shadowAcceptedInputs)
        return false
    if not currentFrameInput.captureNetworkInputs(frame, shadowAcceptedInputs, matchWorld, matchState.humanMask)
        return false
    applyFrame()
    if replayRuntime.simulationFrame != frame
        return false
    return shadowSchedule.completeConfirmed(shadowInputEpoch, frame)

function shadowInputTick()
    if not shadowInputActive
        return
    if matchState.phase != MATCH
        sendShadowBatch()
        return
    if JOURNAL_INPUT_SOURCE
        if not matchControls.isPaused()
            serviceJournalInput()
    else
        shadowCaptureLocalInput()
    if matchControls.isPaused() or (JOURNAL_EDITBOX_INGRESS and not journalLifecycle.started())
        return
    var confirmedSteps = 0
    while matchState.phase == MATCH and shadowSchedule.mayAdvanceConfirmed()
            and confirmedSteps < SHADOW_CONFIRMED_CATCHUP_LIMIT
            and (not journalPauseAckReceived or shadowSchedule.nextConfirmedFrame() < journalPauseAckFrame)
        if not stepConfirmedShadowFrame()
            statusText = "The match could not advance. Restart the match."
            statusTime = 3600
            return
        confirmedSteps++
        if inputTraceActive
            shadowTraceConfirmedSteps++
    if matchState.phase != MATCH
        sendShadowBatch()
    if inputTraceActive and confirmedSteps == 0 and matchState.phase == MATCH
        shadowTraceWaitTicks++
    let correction = shadowPlayback.reconcile(shadowSchedule, shadowInputEpoch,
        GetPlayerId(GetLocalPlayer()),
        shadowWorld, shadowMatch, shadowInputs, shadowRuntime, shadowHistory)
    if correction < REPLAY_CORRECTION_UNCHANGED
        statusText = "The match could not catch up. Restart the match."
        statusTime = 3600
        return
    if inputTraceActive and correction != REPLAY_CORRECTION_UNCHANGED
        shadowTraceCorrections++
        let replayDepth = shadowRuntime.simulationFrame - correction + 1
        shadowTraceReplayedFrames += replayDepth
        shadowTraceMaxReplayDepth = max(shadowTraceMaxReplayDepth, replayDepth)
    // Replay stays numerical. Persistent visuals project only the completed state;
    // event effects, audio, result state and HUD remain confirmed.
    if matchState.phase == MATCH
        let before = shadowSchedule.speculativeFrame()
        let advanced = shadowPlayback.catchUpSpeculative(shadowSchedule, shadowInputEpoch,
            GetPlayerId(GetLocalPlayer()), shadowMatch, shadowWorld, shadowInputs, shadowRuntime, shadowHistory,
            shadowSpeculativeStepBudget(JOURNAL_INPUT_SOURCE), journalPauseAckReceived ? journalPauseAckFrame : 0)
        if inputTraceActive
            shadowTraceSpeculativeSteps += shadowSchedule.speculativeFrame() - before
            if not advanced
                shadowTraceSpeculativeFailures++
            else if shadowSchedule.speculativeFrame() == before
                    and shadowSchedule.speculativeFrame() > shadowSchedule.knownThrough() + shadowSchedule.rollbackFrames()
                shadowTraceWindowBlocks++

    if RESPONSE_SERVICE_PROBE
        responseProbeAdvance(replayRuntime.simulationFrame, shadowSchedule.speculativeFrame(), correction)

function removeBroadKeyEvents()
    if broadKeyDownTrigger != null
        DestroyTrigger(broadKeyDownTrigger)
        broadKeyDownTrigger = null
    if broadKeyUpTrigger != null
        DestroyTrigger(broadKeyUpTrigger)
        broadKeyUpTrigger = null

function syncKeyEventLifecycle()
    let shadowPollingCombat = SHADOW_INPUT_PROFILE and shadowInputActive and matchState.phase == MATCH
    if shadowPollingCombat
        removeBroadKeyEvents()
    else
        registerBroadKeyEvents()

function onResponseProbeStart()
    if not inputTraceActive and GetPlayerId(GetTriggerPlayer()) == matchState.firstHumanSlot()
        responseProbeStart()

function onResponseProbeStartEdges()
    if not inputTraceActive and GetPlayerId(GetTriggerPlayer()) == matchState.firstHumanSlot()
        responseProbeStartEdges()

function onResponseProbeDump()
    if GetPlayerId(GetTriggerPlayer()) == matchState.firstHumanSlot()
        responseProbeDump()

function aerialAttackName(int style) returns string
    if style == AERIAL_NEUTRAL_STYLE
        return "Neutral air!"
    if style == AERIAL_FORWARD_STYLE
        return "Forward air!"
    if style == AERIAL_BACK_STYLE
        return "Back air!"
    if style == AERIAL_UP_STYLE
        return "Up air!"
    return "Down air!"

class NativeParticipant
    Fighter fighter = null
    FighterPoolPresentation pool = null
    ProjectilePresentation projectiles = null
    ShieldPresentation shield = null
    FighterHUD hud = null
    BindingSettings bindings
    SettingsPanel settings = null
    SelectionPanel selection = null
    PlayerInputState keys = new PlayerInputState()
    KeyboardInputCapture callbackCapture = new KeyboardInputCapture()
    NetworkInput callbackRow = new NetworkInput()
    int appliedBindingRevision = -1
    int lastInputAction = -1
    int lastNormalStyle = -1
    boolean wasOut = false
    boolean wasHolding = false
    boolean wasActionable = false
    int previousAttack = 0
    int previousJump = 0
    int previousDown = 0
    int previousLCancel = 0
    int previousShieldBreak = 0
    int previousBreakState = 0
    int previousLedge = 0
    int previousSpecial = 0
    int previousGrab = 0

    construct(int slot)
        bindings = new BindingSettings(Player(slot))

    function sampleCallback()
        var mask = 0
        for action = 0 to ACTION_COUNT - 1
            if keys.actionHeld(action)
                mask += inputActionBit(action)
        callbackCapture.sample(mask)

    function beforeFrame()
        wasOut = fighter.out
        wasHolding = fighter.grabTarget != null
        wasActionable = canAttack(fighter)
        previousAttack = fighter.attackSerial
        previousJump = fighter.jumpSerial
        previousDown = fighter.downState
        previousLCancel = fighter.lCancelSerial
        previousShieldBreak = fighter.shieldBreakSerial
        previousBreakState = fighter.shieldBreakState
        previousLedge = fighter.ledgeState
        previousSpecial = fighter.specialAction
        previousGrab = fighter.grabAction

function localParticipantSlot() returns int
    let slot = GetPlayerId(GetLocalPlayer())
    return matchState.humanActive(slot) ? slot : matchState.firstHumanSlot()

function fighterLabel(int slot) returns string
    return matchState.humanFighterActive(slot) ? "Player " + I2S(slot + 1) : "Computer"

function currentHumanMask() returns int
    var mask = 0
    var bit = 1
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if GetPlayerController(Player(slot)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(slot)) == PLAYER_SLOT_STATE_PLAYING and not participantIsActive(matchState.departedMask, slot)
            mask += bit
        bit *= 2
    return mask

function currentComputerMask() returns int
    var mask = 0
    var bit = 1
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if GetPlayerController(Player(slot)) == MAP_CONTROL_COMPUTER and GetPlayerSlotState(Player(slot)) == PLAYER_SLOT_STATE_PLAYING
            mask += bit
        bit *= 2
    return mask

function clearParticipantInputs(int slot)
    let participant = participants[slot]
    participant.keys.clear()
    participant.callbackCapture.reset(0)
    producedInputs.commands[slot].clear()
    matchInputs.commands[slot].clear()

function clearAllInputs()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        clearParticipantInputs(slot)

function controlsAvailable(int slot) returns boolean
    if not matchState.humanPresent(slot)
        return false
    let participant = participants[slot]
    return participant.bindings.ready and (participant.settings == null or not participant.settings.isOpen())

class MeleeSelectionActions extends SelectionActions
    override function selectChoice(int participantId, int choice)
        if controlsAvailable(participantId) and matchState.phase == CHARACTER_MENU
            matchState.selectCharacter(participantId, choice)
            makePreview()

    override function selectCpuChoice(int participantId, int cpu, int choice)
        if controlsAvailable(participantId) and matchState.phase == CHARACTER_MENU and matchState.canChooseComputer(participantId, cpu)
            matchState.selectCpuCharacter(participantId, cpu, choice)
            makePreview()

    override function cycleMode(int actorId, int fighterSlot)
        if controlsAvailable(actorId) and matchState.cycleSlotMode(actorId, fighterSlot)
            makePreview()
            traceSelectionState("cycle actor " + I2S(actorId) + " slot " + I2S(fighterSlot))

    override function recallChoice(int actorId, int chipSlot)
        if controlsAvailable(actorId) and matchState.phase == CHARACTER_MENU
            matchState.recallCharacter(actorId, chipSlot)
            makePreview()

    override function openSettings(int participantId)
        openSettingsScreen(participantId)

    override function start(int participantId)
        if matchState.phase == CHARACTER_MENU
            confirm(participantId)

class MeleeStageActions extends StageActions
    override function selectStage(int participantId, int choice)
        matchState.selectStage(participantId, choice)
    override function changeStocks(int participantId, int direction)
        matchState.setStocks(participantId, matchState.stockCount + direction)
    override function changeTime(int participantId, int direction)
        matchState.setTimeLimit(participantId, matchState.timeLimitMinutes + direction)
    override function start(int participantId)
        confirm(participantId)
    override function back(int participantId)
        matchState.returnToCharacters(participantId)

class MeleeSettingsActions extends SettingsActions
    int participantId
    construct(int participantId)
        this.participantId = participantId
    override function closeSettings(int _participantId)
        clearParticipantInputs(participantId)

function removeFighters()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let participant = participants[slot]
        if participant.shield != null
            destroy participant.shield
            participant.shield = null
        if participant.projectiles != null
            destroy participant.projectiles
            participant.projectiles = null
        if participant.pool != null
            destroy participant.pool
            participant.pool = null
        if participant.fighter != null
            participant.fighter.clearDizzyEffect()
            RemoveUnit(participant.fighter.body)
            destroy participant.fighter
            participant.fighter = null
            matchWorld.fighters[slot] = null
    if frostEffects != null
        frostEffects.clear()
    if specialEffects != null
        specialEffects.clear()
    if combatEffects != null
        combatEffects.clear()
    clearProjectileModels()

function makePreview()
    clearAllInputs()
    removeFighters()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        destroy producedInputs.inputs[slot]
        producedInputs.inputs[slot] = new InputSnapshot()
    matchWorld.mask = matchState.fighterMask()
    var count = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot)
            count++
    var position = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot)
            participants[slot].hud.layout(position, count)
            position++
            let x = matchSpawnX(slot)
            let fighter = new Fighter(Player(slot), matchState.characterFor(slot), x, x < 0 ? 1 : -1)
            participants[slot].fighter = fighter
            matchWorld.fighters[slot] = fighter
            SetUnitAnimation(fighter.body, "stand")

function applyFrame()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot)
            participants[slot].beforeFrame()
    if not currentFrameInput.execute(matchState, matchWorld, matchInputs, replayRuntime, currentFrameInput.frameNumber())
        return
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot)
            let participant = participants[slot]
            let fighter = participant.fighter
            if shadowInputActive
                currentFrameInput.copyExecutedInput(slot, producedInputs.inputs[slot])
            if participant.previousGrab != fighter.grabAction
                traceParticipant(slot, "grab action " + I2S(fighter.grabAction) + " frame " + I2S(fighter.grabFrame) + " serial " + I2S(fighter.grabSerial))
            if participant.wasHolding != (fighter.grabTarget != null)
                traceParticipant(slot, "grab-hold " + (fighter.grabTarget != null ? "start" : "end"))
            traceSpecialAction(slot, fighter, participant.previousSpecial)
            traceRecovery(slot, fighter, participant.previousDown, participant.wasActionable)
            if fighter.shieldBreakSerial > participant.previousShieldBreak
                announce(fighterLabel(slot) + "'s shield broke!")
            if participant.previousBreakState != fighter.shieldBreakState
                traceParticipant(slot, "shield-break " + I2S(fighter.shieldBreakState) + " z " + R2S(fighter.z) + " remaining " + R2S(fighter.shieldBreakRemaining))
            if participant.previousLedge != fighter.ledgeState
                traceParticipant(slot, "ledge " + I2S(fighter.ledgeState) + " x " + R2S(fighter.x) + " z " + R2S(fighter.z))
            if participant.previousJump != fighter.jumpSerial
                traceParticipant(slot, "applied jump " + I2S(fighter.jumpSerial) + " double " + (fighter.jumpIsDouble ? "1" : "0") + " z " + R2S(fighter.z))
            if fighter.lCancelSerial > participant.previousLCancel
                announce("L-cancel!")
            if participant.previousDown != fighter.downState
                if fighter.downState == DOWN_TECH
                    announce("Tech!")
                else if fighter.downState == DOWN_TECH_ROLL
                    announce("Tech roll!")
            if participant.previousAttack != fighter.attackSerial
                traceParticipant(slot, "applied attack " + I2S(fighter.attackSerial) + " style " + I2S(fighter.attackStyle))
                if isAerialAttack(fighter.attackStyle)
                    announce(aerialAttackName(fighter.attackStyle))
            if participant.pool != null and participant.pool.admitted()
                if not modelSounds.confirm(shadowInputEpoch, replayRuntime.simulationFrame, slot, fighter, replayRuntime.poses[slot], modelSoundPresentation)
                    traceInput("model sound rejected confirmed frame " + I2S(replayRuntime.simulationFrame) + " slot " + I2S(slot))
            renderFighter(slot, replayRuntime.poses[slot], participant.wasOut)
            specialEffects.presentConfirmedAnimated(replayRuntime.simulationFrame, fighter, slot)
    if matchState.phase == RESULT
        frostEffects.clear()
        specialEffects.clear()
        clearProjectileModels()
        announceResult()

function announceResult()
    if matchState.interrupted
        statusText = matchState.winner >= 0 ? fighterLabel(matchState.winner) + " wins by forfeit." : "Match ended because a player left."
        statusTime = 3600
        return
    statusText = matchState.winner >= 0 ? fighterLabel(matchState.winner) + " wins!" : (matchState.timedOut ? "Time! Draw." : "Draw!")
    statusTime = 3600

function shadowPollLocal() returns int
    let slot = GetPlayerId(GetLocalPlayer())
    if not BlzIsLocalClientActive() or not matchState.humanFighterActive(slot)
        return 0
    let activeBindings = participants[slot].bindings.bindings
    var heldActions = 0
    for action = 0 to ACTION_COUNT - 1
        var down = false
        for keySlot = 0 to 1
            let keyCode = activeBindings.keyFor(action, keySlot)
            if keyCode != 0 and BlzIsKeyPressed(ConvertOsKeyType(keyCode))
                down = true
        if down
            heldActions += inputActionBit(action)
    return heldActions

function receiveShadowInput()
    shadowTraceRawSyncEvents++
    let sender = GetPlayerId(GetTriggerPlayer())
    let wire = BlzGetTriggerSyncData()
    if JOURNAL_INPUT_SOURCE and wire == "J4" + I2S(shadowInputEpoch)
        if matchState.humanActive(sender) and not participantIsActive(journalTransportReadyMask, sender)
            var bit = 1
            for slot = 1 to sender
                bit *= 2
            journalTransportReadyMask += bit
            journalLifecycle.ready(shadowInputEpoch, sender)
            traceInput("journal transport start received sender " + I2S(sender))
            if journalTransportReadyMask == matchState.humanMask
                if JOURNAL_EDITBOX_INGRESS
                    writeJournalLifecycle("START", "start", 1 + SHADOW_INPUT_DELAY)
                PreloadGenClear()
                PreloadGenStart()
                Preload("build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(GetPlayerId(GetLocalPlayer())) + " received-mask=" + I2S(journalTransportReadyMask) + " before-journal-reads=yes")
                PreloadGenEnd("smashcraft-journal-transport-ready-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-p" + I2S(GetPlayerId(GetLocalPlayer())) + ".txt")
        return
    if JOURNAL_INPUT_SOURCE and wire == "E4" + I2S(shadowInputEpoch)
        journalLifecycle.stopped(shadowInputEpoch, sender)
        return
    nativePreloadProbeObserveSync(sender, wire)
    if nativePreloadProbeReceive(sender, wire)
        return
    if not shadowInputActive or not matchState.humanActive(sender)
        return
    if wire.length() == 16 and wire.substring(0, 2) == "D0"
        let packetPhase = wire.substring(2, 3)
        if packetPhase == "A" or packetPhase == "B"
            let phaseIndex = packetPhase == "A" ? 0 : 1
            let sequence = S2I(wire.substring(3, 6))
            if sender == GetPlayerId(GetLocalPlayer())
                transportIsolationRecordEcho(phaseIndex, sequence)
            return
        transportIsolationRejected++
        return
    let receivedCallback = inputTraceTicks
    let receivedSeconds = inputTraceActive ? TimerGetElapsed(inputTraceClock) : 0
    var status = INPUT_MALFORMED
    if shadowIncoming.decode(wire)
		status = shadowSchedule.acceptSynchronized(sender, shadowIncoming)
        if RESPONSE_SERVICE_PROBE and sender == GetPlayerId(GetLocalPlayer()) and status == INPUT_ACCEPTED
            for row = 0 to shadowIncoming.recordCount() - 1
                responseProbeTransportReceive(shadowIncoming.epochNumber(), shadowIncoming.firstFrameNumber() + row)
        if transportIsolationPhase == 3 and sender == GetPlayerId(GetLocalPlayer()) and status == INPUT_ACCEPTED
			let sequence = (shadowIncoming.firstFrameNumber() - transportIsolationFirstCFrame) div 2
            transportIsolationRecordEcho(2, sequence)
		if inputTraceActive and sender == GetPlayerId(GetLocalPlayer())
            for row = 0 to shadowIncoming.recordCount() - 1
                recordShadowTraceEcho(shadowIncoming.epochNumber(), shadowIncoming.firstFrameNumber() + row, receivedCallback, receivedSeconds)
    if status != INPUT_ACCEPTED and status != INPUT_WRONG_EPOCH
        statusText = "The players could not stay connected. Restart the match."
        statusTime = 3600
    if inputTraceActive
        if status == INPUT_ACCEPTED
            shadowTraceAccepted[sender]++
            shadowTraceReceivedRows[sender] += shadowIncoming.recordCount()
        else
            shadowTraceRejected++

function transportIsolationSequence(int sequence) returns string
    return I2S(sequence + 1000).substring(1, 4)

function transportIsolationRecordEcho(int arm, int sequence)
    if sequence < 0 or sequence >= 300
        return
    let slot = arm * 300 + sequence
    if transportIsolationSeen[slot]
        transportIsolationDuplicates[arm]++
    else if transportIsolationSubmitted[slot]
        let age = TimerGetElapsed(transportIsolationClock) - transportIsolationSendTime[slot]
        transportIsolationSeen[slot] = true
        transportIsolationReceived[arm]++
        transportIsolationAgeSamples[arm]++
        transportIsolationAge[slot] = age
        transportIsolationAgeSum[arm] += age
        transportIsolationAgeMax[arm] = max(transportIsolationAgeMax[arm], age)

function sendTransportIsolationProbe(int arm)
    let sequence = transportIsolationAttempts[arm]
    if sequence >= 300
        return
    transportIsolationAttempts[arm]++
    let suffix = transportIsolationSequence(sequence)
    var wire = "D0A" + suffix + "0000000000"
    if arm == 1
        wire = "D0B" + suffix + "0000000000"
        let slot = GetPlayerId(localPlayer)
        journalInputFile.filename = "smashcraft-transport-read-" + BUILD_ID + "-s" + I2S(slot) + "-n" + suffix + ".pld"
        let started = TimerGetElapsed(transportIsolationClock)
        wire = journalInputFile.readAsString(localPlayer)
        transportIsolationReadSeconds += TimerGetElapsed(transportIsolationClock) - started
        transportIsolationReadCount++
        transportIsolationReadBytes += wire.length()
        if wire != "D0B" + suffix + "0000000000"
            transportIsolationFileFailures++
            transportIsolationFailed++
            return
    let index = arm * 300 + sequence
    transportIsolationSendTime[index] = TimerGetElapsed(transportIsolationClock)
    transportIsolationFrame[index] = sequence
    if BlzSendSyncData("SC_GP", wire)
        transportIsolationSubmitted[index] = true
        transportIsolationSent[arm]++
        transportIsolationBytesSent[arm] += wire.length()
    else
        transportIsolationFailed++

function dumpTransportIsolation()
    PreloadGenClear()
    PreloadGenStart()
    Preload("build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " timing=native-game-seconds")
    Preload("native-span=" + R2S(TimerGetElapsed(transportIsolationClock)) + " callbacks=" + I2S(transportIsolationTicks))
    Preload("B-file=smashcraft-transport-read-" + BUILD_ID + "-s{localSlot}-n{000..299}.pld exact 16-byte D0B payload no newline")
    Preload("B-reads=" + I2S(transportIsolationReadCount) + " bytes=" + I2S(transportIsolationReadBytes) + " seconds=" + R2S(transportIsolationReadSeconds) + " file-errors=" + I2S(transportIsolationFileFailures))
    for arm = 0 to 2
        let label = arm == 0 ? "A-generated" : (arm == 1 ? "B-file" : "C-I4")
        Preload("arm=" + label + " attempts=" + I2S(transportIsolationAttempts[arm]) + " sent=" + I2S(transportIsolationSent[arm]) + " received=" + I2S(transportIsolationReceived[arm]) + " missing=" + I2S(transportIsolationSent[arm] - transportIsolationReceived[arm]))
        Preload("arm=" + label + " bytes=" + I2S(transportIsolationBytesSent[arm]) + " age-samples=" + I2S(transportIsolationAgeSamples[arm]) + " mean=" + R2S(transportIsolationAgeSamples[arm] > 0 ? transportIsolationAgeSum[arm] / transportIsolationAgeSamples[arm] : 0) + " max=" + R2S(transportIsolationAgeMax[arm]) + " duplicate=" + I2S(transportIsolationDuplicates[arm]))
        Preload("arm=" + label + " drain-callbacks=" + I2S(transportIsolationDrainByArm[arm]))
        Preload("arm=" + label + " native-span=" + R2S(transportIsolationSpanByArm[arm]) + " callbacks=600 simulation-frame=" + I2S(transportIsolationSimulationFrame[arm]))
        Preload("arm=" + label + " state-checksum=" + transportIsolationChecksum[arm])
        for sequence = 0 to transportIsolationAttempts[arm] - 1
            let index = arm * 300 + sequence
            Preload("echo arm=" + label + " seq=" + transportIsolationSequence(sequence) + " frame=" + I2S(transportIsolationFrame[index]) + " seen=" + (transportIsolationSeen[index] ? "1" : "0") + " age=" + R2S(transportIsolationAge[index]))
    Preload("failed=" + I2S(transportIsolationFailed) + " unexpected=" + I2S(transportIsolationRejected) + " C-first-frame=" + I2S(transportIsolationFirstCFrame))
    PreloadGenEnd("wc3-melee-transport-isolation.txt")

function finishTransportIsolationArm()
    let arm = transportIsolationPhase - 1
    transportIsolationDrainByArm[arm] = transportIsolationDrainTicks
    transportIsolationSpanByArm[arm] = TimerGetElapsed(transportIsolationClock) - transportIsolationArmStartedAt
    diagnosticSnapshot.capture(matchWorld, matchState, matchInputs, replayRuntime)
    transportIsolationChecksum[arm] = diagnosticSnapshot.checksum()
    transportIsolationSimulationFrame[arm] = replayRuntime.simulationFrame
    transportIsolationPhase++
    transportIsolationPhaseTicks = 0
    transportIsolationDrainTicks = 0
    transportIsolationCOffer = false
    transportIsolationArmStartedAt = TimerGetElapsed(transportIsolationClock)
    if transportIsolationPhase == 3
        transportIsolationFirstCFrame = journalInput.expectedFrame()
    if transportIsolationPhase > 3
        dumpTransportIsolation()
        transportIsolationPhase = 0

function transportIsolationTick()
    if transportIsolationPhase == 0
        return
    transportIsolationTicks++
    transportIsolationCOffer = false
    if transportIsolationPhaseTicks < 600
        if transportIsolationPhase == 1 or transportIsolationPhase == 2
            if transportIsolationPhaseTicks mod 2 == 0
                sendTransportIsolationProbe(transportIsolationPhase - 1)
        else if transportIsolationPhaseTicks mod 2 == 0 and transportIsolationAttempts[2] < 300
            transportIsolationCOffer = true
        transportIsolationPhaseTicks++
        return
    if transportIsolationReceived[transportIsolationPhase - 1] >= transportIsolationSent[transportIsolationPhase - 1] or transportIsolationDrainTicks >= 600
        finishTransportIsolationArm()
    else
        transportIsolationDrainTicks++

function onTransportIsolationStart()
    if GetPlayerId(GetTriggerPlayer()) != matchState.firstHumanSlot() or transportIsolationClock != null or not JOURNAL_INPUT_SOURCE or not shadowInputActive
        return
    transportIsolationTicks = 0
    transportIsolationClock = CreateTimer()
    TimerStart(transportIsolationClock, 3600, false, null)
    transportIsolationPhase = 1

function beginShadowEpoch() returns boolean
    shadowInputEpoch++
    if not shadowSchedule.beginEpoch(shadowInputEpoch, SHADOW_INPUT_DELAY, SHADOW_INPUT_ROLLBACK, matchState.humanMask)
        return false
    if not shadowPlayback.beginEpoch(shadowInputEpoch)
        return false
    if not shadowHistory.beginEpochWithCorrections(shadowInputEpoch, 1, shadowSchedule.rollbackFrames())
        return false
    shadowLastCaptureTarget = 0
    shadowBatch.beginEpoch(shadowInputEpoch)
    resetShadowEchoRing()
    shadowLocalSendFailed = false
    shadowWorld.mask = matchWorld.mask
    shadowSeed.capture(matchWorld, matchState, matchInputs, replayRuntime)
    shadowSeed.restore(shadowWorld, shadowMatch, shadowInputs, shadowRuntime)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowInputs.commands[slot].clear()
        shadowAcceptedInputs.row(slot).assign(0, 0, 0, 0, 0, 0, 0)
    shadowRuntime.simulationFrame = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowRuntime.botAttackDelays[slot] = 0
    if JOURNAL_INPUT_SOURCE
        shadowCapture.reset(0)
    else
        shadowCapture.reset(shadowPollLocal())
    journalInputFailed = false
    journalTransportReadyMask = 0
    journalTransportStartSent = false
    journalLifecycle.beginEpoch(shadowInputEpoch, matchState.humanMask)
    journalEndSent = false
    journalEndReceived = false
    journalQuiescent = false
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        journalChatRequested[slot] = false
        journalChatSerial[slot] = 0
    journalPausePending = false
    journalPauseAckReceived = false
    journalPauseCommitSent = false
    journalPausePrepareComplete = false
    journalPauseAckFrame = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		journalControlAckSeen[slot] = false
		journalControlAckSeqBySlot[slot] = 0
		journalControlAckFrameBySlot[slot] = 0
		journalControlAckStateBySlot[slot] = 0
    if JOURNAL_INPUT_SOURCE
        let localSlot = GetPlayerId(GetLocalPlayer())
        if not journalInput.beginEpoch(BUILD_ID, shadowInputEpoch, localSlot, SHADOW_INPUT_DELAY)
            failJournalInput("epoch could not be initialized")
        if JOURNAL_EDITBOX_INGRESS
            // Text focus can consume the release of the menu key that started combat.
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                matchControls.keyUp(slot)
            editboxJournalIngress.beginEpoch(BUILD_ID, shadowInputEpoch, localSlot)
        if JOURNAL_KEYBOARD_INGRESS
			keyboardJournalIngress.beginEpoch(BUILD_ID, shadowInputEpoch, localSlot)
    currentFrameInput.reset()
    return true

function usePredictedPresentation() returns boolean
    return PREDICTED_PRESENTATION and shadowInputActive and matchState.phase == MATCH

function presentationWorld() returns FighterRoster
    return usePredictedPresentation() ? shadowWorld : matchWorld

// Called once after all confirmed catch-up and numerical replay for this callback.
function renderPersistentPresentation()
    let world = presentationWorld()
    let runtime = usePredictedPresentation() ? shadowRuntime : replayRuntime
    let game = usePredictedPresentation() ? shadowMatch : matchState
    let playing = game.phase == MATCH and matchState.phase == MATCH
    combatEffects.present(runtime.impacts, replayRuntime.impacts, playing)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let participant = participants[slot]
        let active = world.active(slot)
        if participant.pool != null
            if active
                participant.pool.present(world.fighters[slot], runtime.poses[slot])
            else
                participant.pool.hide()
        specialEffects.presentStatic(runtime.specials, playing and active ? world.fighters[slot] : null, slot)
        specialEffects.presentSummons(runtime.summons, playing and active ? world.fighters[slot] : null, slot)
        if playing and active
            frostEffects.present(world.fighters[slot], slot)
        else
            frostEffects.hideSlot(slot)
        if participant.shield != null
            participant.shield.present(active ? world.fighters[slot] : null, playing)
        if participant.projectiles != null
            participant.projectiles.present(active ? world.fighters[slot] : null, playing, matchControls.isPaused())

function startMatch()
    // Revoke menu output before the match acquires text focus.
    publishJournalMenu()
    let wasPaused = matchControls.isPaused()
    statusText = "GO!"
    statusTime = 1
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if participants[slot].settings != null and participants[slot].settings.isOpen()
            participants[slot].settings.close()
    clearAllInputs()
    replayRuntime.simulationFrame = 0
    replayRuntime.resetPoses()
    matchControls.resume()
    currentFrameInput.reset()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        replayRuntime.botAttackDelays[slot] = 0
    makePreview()
    initializeMatchFighters(matchState, matchWorld)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot)
            participants[slot].shield = new ShieldPresentation(slot, centerX, centerY, floorHeight)
            participants[slot].projectiles = new ProjectilePresentation(participants[slot].fighter.character, centerX, centerY, floorHeight)
    drawStage()
    if wasPaused
        pauseMatchPresentation(false)
    initializeScenario()
    shadowInputActive = false
    if SHADOW_INPUT_PROFILE
        shadowInputActive = beginShadowEpoch()
        if not shadowInputActive
            statusText = "The players could not connect. Restart the match."
            statusTime = 3600
        else if JOURNAL_INPUT_SOURCE
            let slot = GetPlayerId(GetLocalPlayer())
            journalPausePending = false
            journalPauseAckReceived = false
            journalPauseCommitSent = false
            journalPausePrepareComplete = false
            PreloadGenClear()
            PreloadGenStart()
            Preload("SMASHCRAFT JOURNAL v=1 build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot))
            Preload("input=" + INPUT_PROFILE + " delay=" + I2S(SHADOW_INPUT_DELAY) + " rollback=" + I2S(SHADOW_INPUT_ROLLBACK) + " first_frame=" + I2S(1 + SHADOW_INPUT_DELAY))
            Preload("filename=smashcraft-journal-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-s" + I2S(slot) + "-n{SEQUENCE}.pld")
            Preload("packet=canonical I4; records=1 or 2 consecutive original frames; include neutral rows; no sparse events")
            Preload(JOURNAL_EDITBOX_INGRESS ? "transport=editbox-v1; semicolon-delimited I4; local poll and consumed-prefix drain; text-capacity=4096" : (JOURNAL_KEYBOARD_INGRESS ? "transport=keyboard-mailbox-v1; seven printable ASCII bytes per committed chunk; exact ACK before data is reused" : "transport=SC_GP; files are immutable; absent next filename is retried; sequence advances after local capture and successful submission"))
            Preload("pause=sequenced control request; companion ACK names the next input frame; simulation pauses or resumes only at that acknowledged confirmed frame")
            PreloadGenEnd("smashcraft-journal-ready-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-p" + I2S(slot) + ".txt")
    if POOL_PRESENTATION and shadowInputActive
        modelSounds.beginEpoch(shadowInputEpoch)
        modelSoundPresentation.setOrigin(centerX, centerY, floorHeight)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchWorld.active(slot)
                let participant = participants[slot]
                participant.pool = new FighterPoolPresentation(participant.fighter.character, slot, centerX, centerY, floorHeight)
                if participant.pool.admitted()
                    SetUnitTimeScale(participant.fighter.body, 0.)
                    ShowUnit(participant.fighter.body, false)
                    modelSounds.confirm(shadowInputEpoch, 0, slot, participant.fighter, replayRuntime.poses[slot], modelSoundPresentation)
                else
                    statusText = "This fighter is unavailable in the movement preview."
                    statusTime = 3600
    renderPersistentPresentation()
    syncKeyEventLifecycle()

function initializeScenario()
    let first = participants[matchState.firstHumanSlot()].fighter
    if first == null
        return
    var other = matchState.cpuSlot()
    if other < 0
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchWorld.active(slot) and slot != matchState.firstHumanSlot() and other < 0
                other = slot
    if other < 0
        return
    let second = participants[other].fighter
    if PARRY_SCENARIO
        initializeParryScenario(first, second)
    if SPIKE_SCENARIO
        initializeSpikeScenario(first, second, matchState.stageChoice, 1)
    if KO_SCENARIO
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchWorld.active(slot)
                let fighter = participants[slot].fighter
                fighter.z = 761
                fighter.grounded = false
                fighter.knockbackZ = TOP_KO_MINIMUM_UPWARD_KNOCKBACK + 10
                fighter.downState = DOWN_TUMBLE
                fighter.downFrame = 1
    if KNOCKDOWN_SCENARIO
        first.downState = DOWN_TUMBLE
        first.grounded = false
        first.z = TECH_SCENARIO ? 300 : 80
        first.vz = -8
        first.hitstun = TECH_SCENARIO ? 60 : 30
        second.x = TECH_SCENARIO ? 350 : first.x + 100
    if SHIELD_BREAK_SCENARIO
        first.shieldEnergy = 1
        second.x = 350
    if LEDGE_SCENARIO
        first.x = surfaceLeft(matchState.stageChoice, 0) - 16
        first.z = 15
        first.grounded = false
        first.surface = -1
        first.facing = 1
        first.vz = -1
        first.jumps = 0
        second.x = 350

function choose(int slot, int direction)
    if not controlsAvailable(slot)
        return
    if matchState.phase == CHARACTER_MENU
        matchState.selectCharacter(slot, (matchState.characterFor(slot) + direction + 3) mod 3)
        makePreview()
    else if matchState.phase == STAGE_MENU
        matchState.selectStage(slot, 1 - matchState.stageChoice)

function confirm(int slot)
    if not controlsAvailable(slot)
        announce("Controls are still loading or settings are open.")
        return
    if matchState.phase == CHARACTER_MENU
        if matchState.requestStageSelect(slot)
            for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                participants[participant].settings.close()
    else if matchState.phase == STAGE_MENU
        if matchState.requestStart(slot)
            startMatch()
    else if matchState.phase == RESULT
        if matchState.confirmRematch(slot)
            matchState.updateConnectedHumans(currentHumanMask())
            statusText = ""
            statusTime = 0
            makePreview()

function back(int slot)
    if not controlsAvailable(slot)
        return
    if matchState.phase == CHARACTER_MENU
        participants[slot].selection.recallHeld()
    else if matchState.phase == STAGE_MENU
        matchState.returnToCharacters(slot)

function openSettingsScreen(int slot)
    if matchState.phase != CHARACTER_MENU or not matchState.humanActive(slot)
        return
    let participant = participants[slot]
    if not participant.bindings.ready or participant.settings == null
        announce("Controls are still loading.")
        return
    clearParticipantInputs(slot)
    participant.settings.show()

function onParticipantKeyDown(int slot)
    if not matchState.humanActive(slot)
        return
    let key = BlzGetTriggerPlayerKey()
    let keyCode = GetHandleId(key)
    if JOURNAL_EDITBOX_INGRESS and shadowInputActive and matchState.phase != MATCH and not journalLifecycle.quiescent()
        return
    if JOURNAL_EDITBOX_INGRESS and shadowInputActive and matchState.phase == MATCH and key == OSKEY_Y
        return
    if JOURNAL_KEYBOARD_INGRESS and shadowInputActive and keyboardJournalIngress.isCarrierCode(keyCode)
		return
    if inputTraceActive
        shadowTraceKeyDown[slot]++
    traceParticipant(slot, "received down " + I2S(keyCode))
    let participant = participants[slot]
    let state = participant.keys
    let bindings = participant.bindings
    let controls = participant.settings
    if keyCode < 0 or keyCode > 255 or state.isKeyHeld(keyCode)
        return
    if key == OSKEY_Y
        if JOURNAL_EDITBOX_INGRESS and journalChatBusy()
            return
		if JOURNAL_INPUT_SOURCE and shadowInputActive and matchState.phase == MATCH and journalPausePending
			return
		let controlAction = JOURNAL_INPUT_SOURCE and shadowInputActive and matchState.phase == MATCH
			? matchControls.keyDownDeferred(slot, matchState.phase, controls != null and controls.isOpen())
			: matchControls.keyDown(slot, matchState.phase, controls != null and controls.isOpen())
		if controlAction == START_PAUSE_TOGGLED
			if JOURNAL_INPUT_SOURCE and shadowInputActive and matchState.phase == MATCH
				writeJournalControl(not matchControls.isPaused())
			else
				clearAllInputs()
				pauseMatchPresentation(matchControls.isPaused())
				statusText = matchControls.isPaused() ? "Paused — press Y to resume." : "Resumed."
				statusTime = matchControls.isPaused() ? 3600 : 1
        else if controlAction == START_PAUSE_CONFIRM
            confirm(slot)
        return
    if slot == matchState.firstHumanSlot() and key == OSKEY_F5
        if RESPONSE_SERVICE_PROBE
            PreloadGenClear()
            PreloadGenStart()
            Preload("build=" + BUILD_ID + " slot=" + I2S(slot) + " key=" + I2S(keyCode) + " phase=" + I2S(matchState.phase))
            PreloadGenEnd("smashcraft-developer-exit-" + BUILD_ID + ".txt")
        EndGame(false)
        return
    if key == OSKEY_ESCAPE and controls != null and controls.isOpen()
        controls.close()
        return
    if controls != null and controls.isOpen()
        if bindings.capturing
            bindings.capture(keyCode)
        return
    if key == OSKEY_F1
        openSettingsScreen(slot)
        return
    if not bindings.ready
        return
    // Journal menus have fixed controller keys, independent of combat rebindings
    // and the mouse cursor used by drag-and-drop character selection.
    if JOURNAL_EDITBOX_INGRESS and matchState.phase != MATCH
        if key == OSKEY_W or key == OSKEY_R
            choose(slot, key == OSKEY_W ? -1 : 1)
            return
        if key == OSKEY_N
            if matchState.phase == CHARACTER_MENU
                matchState.selectCharacter(slot, matchState.characterFor(slot))
                makePreview()
            else
                confirm(slot)
            return
        if key == OSKEY_U
            if matchState.phase == CHARACTER_MENU
                matchState.recallCharacter(slot, slot)
            else
                back(slot)
            return
    if key == OSKEY_ESCAPE and matchState.phase == STAGE_MENU
        back(slot)
        return
    if key == OSKEY_ESCAPE and matchControls.isPaused() and matchState.leavePractice(slot)
        matchControls.resume()
        statusText = ""
        statusTime = 0
        makePreview()
        pauseMatchPresentation(false)
        return
    if matchState.phase == MATCH and matchControls.isPaused()
        return
    if shadowInputActive and matchState.phase == MATCH
        return
    let action = state.press(keyCode, bindings.bindings)
    if action < 0
        return
    participant.lastInputAction = action
    traceParticipant(slot, "mapped action " + I2S(action))
    if matchState.phase == MATCH
        participant.sampleCallback()
    else if action == MOVE_LEFT or action == MOVE_RIGHT
        choose(slot, 1)
    else if action == ATTACK
        if matchState.phase == CHARACTER_MENU
            participant.selection.placeHovered()
        else
            confirm(slot)
    else if action == SPECIAL
        back(slot)

function onParticipantKeyUp(int slot)
    if not matchState.humanActive(slot)
        return
    let key = BlzGetTriggerPlayerKey()
    let keyCode = GetHandleId(key)
    // Starting a match changes phase before its confirmation key is released.
    if key == OSKEY_Y
        matchControls.keyUp(slot)
        return
    if JOURNAL_EDITBOX_INGRESS and shadowInputActive and matchState.phase != MATCH and not journalLifecycle.quiescent()
        return
    if JOURNAL_KEYBOARD_INGRESS and shadowInputActive and keyboardJournalIngress.isCarrierCode(keyCode)
		return
    if inputTraceActive
        shadowTraceKeyUp[slot]++
    traceParticipant(slot, "received up " + I2S(keyCode))
    let participant = participants[slot]
    participant.keys.release(keyCode, participant.bindings.bindings)
    if matchState.phase == MATCH
        participant.sampleCallback()

function onKeyDown()
    onParticipantKeyDown(GetPlayerId(GetTriggerPlayer()))

function onKeyUp()
    onParticipantKeyUp(GetPlayerId(GetTriggerPlayer()))

function registerKey(trigger eventTrigger, player participant, oskeytype key, boolean down)
    BlzTriggerRegisterPlayerKeyEvent(eventTrigger, participant, key, 0, down)

function registerDeveloperChord(trigger eventTrigger, oskeytype key)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.humanActive(slot)
            BlzTriggerRegisterPlayerKeyEvent(eventTrigger, Player(slot), key, 2, true)

function registerBroadKeyEvents()
    if broadKeyDownTrigger != null or broadKeyUpTrigger != null
        return
    broadKeyDownTrigger = CreateTrigger()
    broadKeyUpTrigger = CreateTrigger()
    for keyCode = 1 to 255
        let key = ConvertOsKeyType(keyCode)
        if key != OSKEY_Y and key != OSKEY_F5
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if matchState.humanActive(slot)
                    registerKey(broadKeyDownTrigger, Player(slot), key, true)
                    registerKey(broadKeyUpTrigger, Player(slot), key, false)
    TriggerAddAction(broadKeyDownTrigger, function onKeyDown)
    TriggerAddAction(broadKeyUpTrigger, function onKeyUp)

function onDeveloperRestart()
    if GetPlayerId(GetTriggerPlayer()) != matchState.firstHumanSlot() or developerRestartRequested
        return
    developerRestartRequested = true
    RestartGame(false)

function onDeveloperTrace()
    if GetPlayerId(GetTriggerPlayer()) != matchState.firstHumanSlot() or inputTraceActive or responseProbeRecording()
        return
    startInputTrace()

function onNativePreloadProbeStart()
    if GetTriggerPlayer() != GetLocalPlayer() or not shadowInputActive or transportIsolationPhase != 0 or inputTraceActive
        return
    nativePreloadProbeRequestStart()

function onNativeTransportProbeStart()
    if GetTriggerPlayer() == GetLocalPlayer() and shadowInputActive and not nativePreloadProbeActive() and transportIsolationPhase == 0
        nativeTransportProbeRequestStart()

function journalChatBusy() returns boolean
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if journalChatRequested[slot]
            return true
    return false

// Custom frame callbacks already synchronize the triggering player.
function onJournalChatEnter()
    let slot = GetPlayerId(GetTriggerPlayer())
    if not shadowInputActive or matchState.phase != MATCH or journalInputFailed or not matchState.humanActive(slot) or journalChatRequested[slot]
        return
    journalChatRequested[slot] = true
    journalChatSerial[slot]++
    if GetTriggerPlayer() == GetLocalPlayer()
        editboxJournalIngress.requestChat(journalChatSerial[slot])

function receiveJournalChatClosed()
    let slot = GetPlayerId(GetTriggerPlayer())
    if BlzGetTriggerSyncData() == I2S(shadowInputEpoch) + "|" + I2S(journalChatSerial[slot])
        journalChatRequested[slot] = false

function serviceJournalChat()
    if not JOURNAL_EDITBOX_INGRESS or not shadowInputActive or matchState.phase != MATCH or journalInputFailed
        return
    if journalChatBusy() and not matchControls.isPaused() and not journalPausePending
        writeJournalControl(true)
    if editboxJournalIngress.serviceChat(matchControls.isPaused() and not journalPausePending)
        if not BlzSendSyncData("SC_JH", I2S(shadowInputEpoch) + "|" + I2S(editboxJournalIngress.chatSequence()))
            failJournalInput("chat close could not be synchronized")

// The controller's Start request shares the ordered text stream with its rows.
// It crosses a sync event before starting the shared pause barrier.
function serviceEditboxJournalPauseRequest()
    if not JOURNAL_EDITBOX_INGRESS or not shadowInputActive or matchState.phase != MATCH or journalInputFailed
        return
    let wire = editboxJournalIngress.peek()
    if wire.length() < 3 or wire.substring(0, 3) != "JP1"
        return
    if not BlzSendSyncData("SC_JP", wire)
        failJournalInput("pause request could not be synchronized")
    else if not editboxJournalIngress.consumed()
        failJournalInput(editboxJournalIngress.failed())

function receiveEditboxJournalPause()
    if not shadowInputActive or matchState.phase != MATCH or journalPausePending or journalInputFailed
        return
    if not matchState.humanActive(GetPlayerId(GetTriggerPlayer()))
        return
    let wire = BlzGetTriggerSyncData()
    let expected = "JP1" + journalPad10(shadowInputEpoch) + journalPad10(journalInput.controlSequenceNumber()) + (matchControls.isPaused() ? "R" : "P")
    // The epoch and control sequence discard delayed or simultaneous requests.
    if wire == expected
        writeJournalControl(not matchControls.isPaused())

function setupKeys()
    if RESPONSE_SERVICE_PROBE and JOURNAL_INPUT_SOURCE
        nativePreloadProbeSetup(matchState.humanMask)
        nativeTransportProbeSetup(matchState.humanMask)
        let nativePreloadStart = CreateTrigger()
        let nativeTransportStart = CreateTrigger()
        registerDeveloperChord(nativePreloadStart, OSKEY_P)
        registerDeveloperChord(nativeTransportStart, OSKEY_N)
        TriggerAddAction(nativePreloadStart, function onNativePreloadProbeStart)
        TriggerAddAction(nativeTransportStart, function onNativeTransportProbeStart)
    let transportIsolationStart = CreateTrigger()
    registerDeveloperChord(transportIsolationStart, OSKEY_B)
    TriggerAddAction(transportIsolationStart, function onTransportIsolationStart)
    if RESPONSE_SERVICE_PROBE
        responseProbeSetup()
        responseProbeSample = new NetworkInput()
        let probeStart = CreateTrigger()
        let probeStartEdges = CreateTrigger()
        let probeDump = CreateTrigger()
        registerDeveloperChord(probeStart, OSKEY_G)
        registerDeveloperChord(probeStartEdges, OSKEY_J)
        registerDeveloperChord(probeDump, OSKEY_H)
        TriggerAddAction(probeStart, function onResponseProbeStart)
        TriggerAddAction(probeStartEdges, function onResponseProbeStartEdges)
        TriggerAddAction(probeDump, function onResponseProbeDump)
    let restartTrigger = CreateTrigger()
    let traceTrigger = CreateTrigger()
    let controlDownTrigger = CreateTrigger()
    let controlUpTrigger = CreateTrigger()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.humanActive(slot)
            registerKey(controlDownTrigger, Player(slot), OSKEY_Y, true)
            registerKey(controlDownTrigger, Player(slot), OSKEY_F5, true)
            registerKey(controlUpTrigger, Player(slot), OSKEY_Y, false)
            registerKey(controlUpTrigger, Player(slot), OSKEY_F5, false)
    registerDeveloperChord(restartTrigger, OSKEY_R)
    registerDeveloperChord(traceTrigger, OSKEY_T)
    TriggerAddAction(restartTrigger, function onDeveloperRestart)
    TriggerAddAction(traceTrigger, function onDeveloperTrace)
    TriggerAddAction(controlDownTrigger, function onKeyDown)
    TriggerAddAction(controlUpTrigger, function onKeyUp)
    syncKeyEventLifecycle()
function renderFighter(int slot, FighterPose pose, boolean wasOut)
    let participant = participants[slot]
    let fighter = participant.fighter
    fighter.renderDizzy()
    if wasOut and not fighter.out
        ShowUnit(fighter.body, true)
    else if not wasOut and fighter.out
        ShowUnit(fighter.body, false)
        if fighter.stocks > 0
            announce(fighterLabel(slot) + " lost a stock!")
    let pooled = participant.pool != null and participant.pool.admitted()
    if pooled
        ShowUnit(fighter.body, false)
    if fighter.renderedSelection != pose.selectionSerial
        if not pooled
            if pose.clipIndex >= 0
                SetUnitAnimationByIndex(fighter.body, pose.clipIndex)
            else
                SetUnitAnimation(fighter.body, pose.clipName)
        fighter.renderedSelection = pose.selectionSerial
        let reaction = damagePose(fighter)
        if reaction != DAMAGE_POSE_NONE
            traceParticipant(slot, "damage pose " + I2S(reaction) + " hitlag " + I2S(fighter.hitlag) + " hitstun " + I2S(fighter.hitstun) + " x " + R2S(fighter.x) + " z " + R2S(fighter.z) + " launch " + R2S(fighter.knockbackX) + ":" + R2S(fighter.knockbackZ))
    if not pooled
        SetUnitTimeScale(fighter.body, pose.rate)
    if fighter.out
        return
    fighter.place()
    if fighter.frozenFrames > 0
        SetUnitVertexColor(fighter.body, 155, 210, 255, 255)
    else
        SetUnitVertexColor(fighter.body, fighter.shield ? 100 : 255, fighter.shield ? 160 : 255, 255, isIntangible(fighter) ? 140 : 255)

function pauseMatchPresentation(boolean paused)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot) and participants[slot].fighter != null
            if paused
                SetUnitTimeScale(participants[slot].fighter.body, 0.)
            else if not participants[slot].fighter.out
                renderFighter(slot, replayRuntime.poses[slot], false)
    if combatEffects != null
        combatEffects.setPaused(paused)
    if specialEffects != null
        specialEffects.setPaused(paused)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if participants[slot].projectiles != null
            participants[slot].projectiles.setPaused(paused)

function rematchStatus() returns string
    var ready = 0
    var present = 0
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.humanPresent(slot)
            present++
            if matchState.rematchReadiness[slot]
                ready++
    return I2S(ready) + "/" + I2S(present) + " ready. Press " + (JOURNAL_EDITBOX_INGRESS ? "A or Start" : "Y") + " to choose your next match."

function renderUI()
    let selecting = matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
    let localSlot = localParticipantSlot()
    let localParticipant = participants[localSlot]
    let localFighter = localParticipant.fighter
    let controlsOpen = localParticipant.settings != null and localParticipant.settings.isOpen()
    BlzFrameSetVisible(titleFrame, false)
    BlzFrameSetVisible(menuFrame, false)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let fighter = participants[slot].fighter
        if fighter != null
            participants[slot].hud.update(not selecting and not controlsOpen, fighter.character, fighter.damage, fighter.stocks)
        else
            participants[slot].hud.update(false, 0, 0., 0)
        participants[slot].selection.update(matchState, participants[slot].settings.isOpen())
        participants[slot].settings.update()
    matchClock.update(not selecting and not controlsOpen and matchState.timeLimitMinutes > 0, matchState.remainingSeconds())
    BlzFrameSetVisible(helpFrame, not selecting and not controlsOpen)
    BlzFrameSetVisible(noticeFrame, not selecting and not controlsOpen)
    BlzFrameSetVisible(developerFrame, not selecting and not controlsOpen)
    if not selecting
        BlzFrameSetText(helpFrame, matchState.phase == RESULT ? rematchStatus() : (matchControls.isPaused() ? "PAUSED — Press " + (JOURNAL_EDITBOX_INGRESS ? "Start" : "Y") + " to resume. Combat is frozen." : (JOURNAL_EDITBOX_INGRESS ? "Start" : "Y") + ": pause. Tap Shield before a hard landing to tech; hold Left/Right for a tech roll.\nHold Shield on the ground, then tap Left/Right to roll or Down to dodge."))
        if localFighter != null and matchState.phase == MATCH and not matchControls.isPaused() and localFighter.downState == DOWN_WAIT
            BlzFrameSetText(helpFrame, "Knocked down: Attack/Special to strike, Up/Jump/Shield to stand, Left/Right to roll.")
        else if localFighter != null and matchState.phase == MATCH and not matchControls.isPaused() and localFighter.ledgeState == LEDGE_HANG
            BlzFrameSetText(helpFrame, "Ledge: Up or toward stage to climb; Jump to leap; Shield to roll; Attack to strike.\nDown or away from stage lets go.")
        BlzFrameSetText(noticeFrame, localFighter != null and localFighter.smashCharging ? "Charging smash: release Attack to strike." : (statusTime > 0 ? statusText : ""))
    stagePanel.update(matchState)
    if localFighter != null
        BlzFrameSetText(developerFrame, "Developer test: " + BUILD_ID + " | player=" + I2S(localSlot + 1) + " | phase=" + I2S(matchState.phase) + " | x=" + I2S(R2I(localFighter.x)) + " z=" + I2S(R2I(localFighter.z)) + " | input=" + I2S(localParticipant.lastInputAction) + " mode=" + (shadowInputActive ? INPUT_PROFILE + " " + PRESENTATION_PROFILE : "callback") + " normal=" + I2S(localParticipant.lastNormalStyle) + " move=" + I2S(localFighter.attackStyle) + " attack-frame=" + I2S(localFighter.attackFrame) + " simulation=" + I2S(replayRuntime.simulationFrame) + " predicted=" + I2S(shadowInputActive ? shadowSchedule.speculativeFrame() : replayRuntime.simulationFrame) + " serial=" + I2S(localFighter.attackSerial) + " down=" + I2S(localFighter.downState) + ":" + I2S(localFighter.downFrame) + " DI=" + I2S(localFighter.diSerial) + ":" + I2S(R2I(localFighter.diAngleDegrees)) + " S=" + I2S(localFighter.sdiSerial) + " A=" + I2S(localFighter.asdiSerial) + " | Ctrl+R restart")

function lockArenaCamera()
    var left = 0.
    var right = 0.
    var bottom = 0.
    var top = 0.
    var live = 0
    let world = presentationWorld()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchWorld.active(slot) and participants[slot].fighter != null
            let fighter = world.fighters[slot]
            if not fighter.out
                if live == 0
                    left = fighter.x
                    right = fighter.x
                    bottom = fighter.z
                    top = fighter.z
                else
                    left = min(left, fighter.x)
                    right = max(right, fighter.x)
                    bottom = min(bottom, fighter.z)
                    top = max(top, fighter.z)
                live++
    let targetX = centerX + (left + right) / 2
    let targetZ = max(160., (bottom + top) / 2)
    let distance = max(1450., max((right - left + 500) * 1.15, (top - bottom + 350) * 1.5))
    SetCameraBounds(targetX, centerY, targetX, centerY, targetX, centerY, targetX, centerY)
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, distance, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1800 + targetZ, 0)
    SetCameraField(CAMERA_FIELD_ROLL, 0, 0)
    SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW, 70, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(targetX, centerY)

function traceTick()
    if not inputTraceActive
        return
    inputTraceTicks++
    // Keep callback timestamps intact, but reserve the trace duration for
    // active play so a chat pause cannot consume the post-resume observation.
    if matchControls.isPaused()
        inputTracePausedTicks++
    let localSlot = localParticipantSlot()
    let participant = participants[localSlot]
    let fighter = participant.fighter
    if fighter != null
        let axes = participant.keys.directionX() + 3 * participant.keys.directionZ()
        if axes != inputTraceLastAxes or participant.keys.pulsePending() or inputTraceTicks mod 60 == 0
            traceInput("sample " + I2S(axes) + " pulse " + (participant.keys.pulsePending() ? I2S(participant.keys.pulseX()) + ":" + I2S(participant.keys.pulseZ()) : "none") + " hitlag " + I2S(fighter.hitlag))
            inputTraceLastAxes = axes
        if inputTraceLastDodge != fighter.airDodgeFrame or inputTraceLastLandingLag != fighter.landingLag
            traceInput("motion air " + I2S(fighter.airDodgeFrame) + " landing " + I2S(fighter.landingLag) + " x " + R2S(fighter.x) + " z " + R2S(fighter.z))
            inputTraceLastDodge = fighter.airDodgeFrame
            inputTraceLastLandingLag = fighter.landingLag
    if inputTraceTicks mod 60 == 0
        traceConfirmedState()
        if shadowInputActive
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                if matchWorld.active(slot)
                    let pool = participants[slot].pool
                    if pool != null
                        traceInput("local presentation " + PRESENTATION_PROFILE + " participant " + I2S(slot) + " admitted " + (pool.admitted() ? "1" : "0") + " missing-selections " + I2S(pool.missingSelections))
                    traceInput("participant " + I2S(slot) + " received-packets " + I2S(shadowTraceAccepted[slot]) + " received-rows " + I2S(shadowTraceReceivedRows[slot]) + " key-down " + I2S(shadowTraceKeyDown[slot]) + " key-up " + I2S(shadowTraceKeyUp[slot]))
            traceInput("common K " + I2S(shadowSchedule.knownThrough()) + " confirmed " + I2S(shadowSchedule.nextConfirmedFrame() - 1) + " R " + I2S(shadowSchedule.rollbackFrames()))
            traceInput("raw sync events since trace start " + I2S(shadowTraceRawSyncEvents) + " journal-start-mask " + I2S(journalTransportReadyMask))
            traceInput("local callbacks " + I2S(inputTraceTicks) + " F " + I2S(shadowSchedule.speculativeFrame()) + " rejected " + I2S(shadowTraceRejected) + " no-confirmed " + I2S(shadowTraceWaitTicks) + " confirmed-steps " + I2S(shadowTraceConfirmedSteps) + " speculative-steps " + I2S(shadowTraceSpeculativeSteps) + " failed " + I2S(shadowTraceSpeculativeFailures) + " corrections " + I2S(shadowTraceCorrections) + " replayed-frames " + I2S(shadowTraceReplayedFrames) + " max-replay-depth " + I2S(shadowTraceMaxReplayDepth))
            traceInput("local target " + I2S(shadowSchedule.captureTarget()) + " polls " + I2S(shadowTraceLocalPolls) + " captures " + I2S(shadowTraceLocalCaptures) + " sent-packets " + I2S(shadowTraceLocalSends) + " same-target " + I2S(shadowTraceSameTargetSkips) + " window-blocks " + I2S(shadowTraceWindowBlocks))
            traceInput("local sent-rows " + I2S(shadowTraceSentRows) + " singleton-packets " + I2S(shadowTraceSingletons) + " batch-pending " + I2S(shadowBatch.recordCount()))
            let divisor = max(1, shadowTraceBatchWaitSamples)
            traceInput("local capture-send samples " + I2S(shadowTraceBatchWaitSamples) + " callbacks mean-max " + R2S(shadowTraceBatchWaitSumCallbacks * 1.0 / divisor) + ":" + I2S(shadowTraceBatchWaitMaxCallbacks) + " native-ms mean-max " + R2S(shadowTraceBatchWaitSumSeconds * 1000 / divisor) + ":" + R2S(shadowTraceBatchWaitMaxSeconds * 1000))
            resetShadowBatchSummary()
            traceShadowEchoSummary()
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                shadowTraceAccepted[slot] = 0
                shadowTraceKeyDown[slot] = 0
                shadowTraceKeyUp[slot] = 0
            shadowTraceRejected = 0
            shadowTraceWaitTicks = 0
            shadowTraceConfirmedSteps = 0
            shadowTraceSpeculativeSteps = 0
            shadowTraceSpeculativeFailures = 0
            shadowTraceCorrections = 0
            shadowTraceReplayedFrames = 0
            shadowTraceMaxReplayDepth = 0
            shadowTraceLocalPolls = 0
            shadowTraceLocalCaptures = 0
            shadowTraceLocalSends = 0
            shadowTraceSameTargetSkips = 0
            shadowTraceWindowBlocks = 0
    if inputTraceTicks - inputTracePausedTicks >= (RESPONSE_SERVICE_PROBE ? 1200 : (SHIELD_BREAK_SCENARIO or LEDGE_SCENARIO ? 600 : 300))
        finishInputTrace()

function produceCpuInput(int slot, int frame)
    let fighter = participants[slot].fighter
    let targetSlot = matchState.firstHumanSlot()
    let input = producedInputs.inputs[slot]
    let commands = producedInputs.commands[slot]
    input.direction = 0
    input.jumpPressed = false
    input.jumpHeld = false
    input.specialPressed = false
    input.verticalDirection = 0
    input.ledgeVerticalPressed = 0
    commands.clear()
    if not KNOCKDOWN_SCENARIO and not SHIELD_BREAK_SCENARIO and not LEDGE_SCENARIO and not PARRY_SCENARIO and not SPIKE_SCENARIO and not fighter.out
        produceComputerInput(matchState, matchWorld, replayRuntime, slot, frame, input, commands)
    if PARRY_SCENARIO
        queueParryScenarioJab(producedInputs.inputs[targetSlot], fighter, commands, frame)

function callbackMatchTick()
    let frame = replayRuntime.simulationFrame + 1
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.humanFighterActive(slot)
            let participant = participants[slot]
            participant.callbackCapture.read(participant.callbackRow)
            adaptInput(participant.callbackRow, participant.fighter, frame, producedInputs.inputs[slot], producedInputs.commands[slot])
            participant.callbackCapture.commitCapturedEdges()
            if producedInputs.commands[slot].hasPending(frame)
                participant.lastNormalStyle = producedInputs.commands[slot].style
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.computerActive(slot)
            produceCpuInput(slot, frame)
    if currentFrameInput.capture(frame, matchWorld.mask, producedInputs, replayRuntime)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchWorld.active(slot)
                traceFrameInput(slot, producedInputs.inputs[slot], producedInputs.commands[slot], frame)
                producedInputs.commands[slot].clear()
        applyFrame()

function writeJournalLifecycle(string state, string kind, int frame)
    let slot = GetPlayerId(GetLocalPlayer())
    PreloadGenClear()
    PreloadGenStart()
    Preload("SMASHCRAFT JOURNAL CONTROL v=1 build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot) + " sequence=0 state=" + state + " frame=" + I2S(frame))
    PreloadGenEnd("smashcraft-journal-" + kind + "-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-s" + I2S(slot) + ".txt")

function publishJournalMenu()
    if not JOURNAL_EDITBOX_INGRESS
        return
    let slot = GetPlayerId(GetLocalPlayer())
    var phase = -1
    if controlsAvailable(slot) and (matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU or matchState.phase == RESULT)
        if not shadowInputActive or journalLifecycle.quiescent()
            phase = matchState.phase
    journalMenuPublishTicks++
    if phase == journalMenuPublishedPhase and (phase < 0 or journalMenuPublishTicks < 15)
        return
    journalMenuPublishedPhase = phase
    journalMenuPublishTicks = 0
    let name = phase == CHARACTER_MENU ? "CHARACTER" : (phase == STAGE_MENU ? "STAGE" : (phase == RESULT ? "RESULT" : "BLOCKED"))
    PreloadGenClear()
    PreloadGenStart()
    Preload("SMASHCRAFT JOURNAL MENU v=1 build=" + BUILD_ID + " epoch=" + I2S(shadowInputEpoch) + " slot=" + I2S(slot) + " phase=" + name)
    Preload("connected=" + I2S(matchState.humanMask) + " human-fighters=" + I2S(matchState.humanFighterMask)
        + " computers=" + I2S(matchState.computerMask) + " fighters=" + I2S(matchState.fighterMask()))
    PreloadGenEnd("smashcraft-journal-menu-" + BUILD_ID + "-s" + I2S(slot) + ".txt")

function serviceJournalEnd()
    if not journalEndSent
        writeJournalLifecycle("END", "end", journalInput.expectedFrame())
        journalEndSent = true
        journalPausePending = false
    if journalQuiescent
        return
    if journalEndReceived
        let slot = GetPlayerId(GetLocalPlayer())
        let quiet = vocabularyReadTooltip("smashcraft-journal-quiescent-" + BUILD_ID + "-e" + I2S(shadowInputEpoch) + "-s" + I2S(slot) + ".pld")
        if quiet == "Q"
            if not BlzSendSyncData("SC_GP", "E4" + I2S(shadowInputEpoch))
                failJournalInput("controller stop could not be synchronized")
                return
            journalQuiescent = true
            editboxJournalIngress.endEpoch()
            return
    // Ordered old-epoch rows are terminal data now; consume them without combat.
    for index = 1 to JOURNAL_TEXT_WINDOW
        let wire = editboxJournalIngress.peek()
        if wire == ""
            return
        let ended = wire == "JE1" + I2S(shadowInputEpoch)
        if not editboxJournalIngress.consumed()
            failJournalInput(editboxJournalIngress.failed())
            return
        if ended
            journalEndReceived = true
            editboxJournalIngress.flushReceipt()
            return

function gameTick()
    if JOURNAL_EDITBOX_INGRESS
        editboxJournalIngress.tick()
    serviceJournalChat()
    serviceEditboxJournalPauseRequest()
    if JOURNAL_EDITBOX_INGRESS and shadowInputActive and matchState.phase != MATCH
        serviceJournalEnd()
    transportIsolationTick()
    if RESPONSE_SERVICE_PROBE
        responseProbeBegin(replayRuntime.simulationFrame, shadowInputActive ? shadowSchedule.speculativeFrame() : -1, shadowInputActive ? shadowSchedule.knownThrough() : -1, matchState.phase)
    traceTick()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let participant = participants[slot]
        if participant.appliedBindingRevision != participant.bindings.revision
            clearParticipantInputs(slot)
            participant.appliedBindingRevision = participant.bindings.revision
    statusTime = max(0, statusTime - FRAME_SECONDS)
    if shadowInputActive and matchState.phase == MATCH
		serviceJournalPauseAck()
        shadowInputTick()
		sendJournalPauseCommit()
		commitJournalPauseAtFrame()
    else if matchState.phase == MATCH and not matchControls.isPaused()
        callbackMatchTick()
    if matchState.phase != MATCH
        clearAllInputs()
    else
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            participants[slot].keys.clearPulse()
    syncKeyEventLifecycle()
    renderPersistentPresentation()
    lockArenaCamera()
    renderUI()
    if JOURNAL_EDITBOX_INGRESS
        editboxJournalIngress.updatePauseLabel(matchControls.isPaused(), journalPausePending, journalPauseTarget)
        publishJournalMenu()
    let localSlot = localParticipantSlot()
    if RESPONSE_SERVICE_PROBE
        responseProbePresent(participants[localSlot].fighter != null and participants[localSlot].fighter.shield, shadowInputActive and shadowWorld.active(localSlot) and shadowWorld.fighters[localSlot].shield, shadowInputActive and shadowWorld.active(localSlot) ? shadowRuntime.poses[localSlot].selectionSerial : -1)
    if not readyMarkerWritten and participants[localSlot].bindings.ready
        readyMarkerWritten = true
        PreloadGenClear()
        PreloadGenStart()
        Preload("BUILD " + BUILD_ID)
        Preload("INPUT " + INPUT_PROFILE + " PRESENTATION " + PRESENTATION_PROFILE)
        Preload("SCENARIO " + (SPIKE_SCENARIO ? "spike" : (PARRY_SCENARIO ? "parry" : (LEDGE_SCENARIO ? "ledge" : (SHIELD_BREAK_SCENARIO ? "shield-break" : (TECH_SCENARIO ? "tech" : (KNOCKDOWN_SCENARIO ? "knockdown" : "normal")))))))
        Preload("BINDINGS " + participants[localSlot].bindings.bindings.encode())
        Preload("HUMANS " + I2S(matchState.humanMask) + " FIGHTERS " + I2S(matchWorld.mask))
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchWorld.active(slot)
                Preload("BINDINGS" + I2S(slot) + " " + (matchState.humanActive(slot) ? participants[slot].bindings.bindings.encode() : "BOT"))
        PreloadGenEnd("wc3-melee-ready.txt")

function initializeShadowInput()
    if not SHADOW_INPUT_PROFILE
        return
    shadowSchedule = new ShadowInputSchedule()
    shadowPlayback = new ShadowInputPlayback()
    shadowCapture = new KeyboardInputCapture()
    if JOURNAL_INPUT_SOURCE
        journalInput = new JournalInputSource()
        journalInputFile = new File("")
        if JOURNAL_KEYBOARD_INGRESS
			keyboardJournalIngress = new KeyboardJournalIngress()
        if JOURNAL_EDITBOX_INGRESS
            editboxJournalIngress = new EditboxJournalIngress()
    shadowBatch = new InputBatch()
    shadowOutgoing = new InputPacket()
    shadowIncoming = new InputPacket()
    transportIsolationPacket = new InputPacket()
    transportIsolationNeutral = new NetworkInput()
    transportIsolationNeutral.assign(0, 0, 0, 0, 0, 0, 0)
    shadowSample = new NetworkInput()
    shadowPending = new NetworkInput()
    shadowAcceptedInputs = new ParticipantInputs()
    shadowMatch = new MatchState()
    shadowRuntime = new ReplayRuntimeState()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        shadowWorld.fighters[slot] = new FighterState(slot mod 3, matchSpawnX(slot), slot mod 2 == 0 ? 1 : -1)
    shadowHistory = new ReplayHistory()
    shadowSeed = new ReplaySnapshot()
    let sync = CreateTrigger()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if matchState.humanActive(slot)
            BlzTriggerRegisterPlayerSyncEvent(sync, Player(slot), "SC_GP", false)
    TriggerAddAction(sync, function receiveShadowInput)
    if JOURNAL_EDITBOX_INGRESS
        editboxJournalIngress.onEnter(function onJournalChatEnter)
        let chatClosed = CreateTrigger()
        let pauseRequest = CreateTrigger()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchState.humanActive(slot)
                BlzTriggerRegisterPlayerSyncEvent(pauseRequest, Player(slot), "SC_JP", false)
                BlzTriggerRegisterPlayerSyncEvent(chatClosed, Player(slot), "SC_JH", false)
        TriggerAddAction(pauseRequest, function receiveEditboxJournalPause)
        TriggerAddAction(chatClosed, function receiveJournalChatClosed)
    if JOURNAL_INPUT_SOURCE
		journalControlSync = CreateTrigger()
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if matchState.humanActive(slot)
				BlzTriggerRegisterPlayerSyncEvent(journalControlSync, Player(slot), "SC_JC", false)
		TriggerAddAction(journalControlSync, function receiveJournalControlAck)

function initGame()
    DestroyTimer(GetExpiredTimer())
    matchState.setParticipants(currentHumanMask(), currentComputerMask())
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        participants[slot] = new NativeParticipant(slot)
        destroy matchInputs.commands[slot]
        matchInputs.commands[slot] = new AttackBuffer(ATTACK_BUFFER_FRAMES)
        destroy shadowInputs.commands[slot]
        shadowInputs.commands[slot] = new AttackBuffer(ATTACK_BUFFER_FRAMES)
    if PARRY_SCENARIO or SPIKE_SCENARIO
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if matchState.humanActive(slot)
                matchState.selectCharacter(slot, SPIKE_SCENARIO or slot == matchState.firstHumanSlot() ? 2 : 0)
        if matchState.humanCount == 1
            matchState.selectCpuCharacter(matchState.firstHumanSlot(), matchState.cpuSlot(), SPIKE_SCENARIO ? 2 : 0)
    let center = GetRectCenter(GetPlayableMapRect())
    centerX = GetLocationX(center)
    centerY = GetLocationY(center)
    floorHeight = GetLocationZ(center) + 1800
    RemoveLocation(center)
    BlzHideOriginFrames(true)
    if not loadTOCFile("war3mapImported\\SmashcraftHUD.toc")
        print("Developer: failed to load Smashcraft HUD definitions")
    BlzEnableSelections(false, false)
    EnableUserControl(true)
    FogEnable(false)
    FogMaskEnable(false)
    titleFrame = frameText("MeleeTitle", 0.06, 0.56, 0.68, 0.04, 0.023)
    menuFrame = frameText("MeleeMenu", 0.06, 0.505, 0.68, 0.19, 0.017)
    matchClock = new MatchClock()
    helpFrame = frameText("MeleeHelp", 0.06, 0.54, 0.58, 0.055, 0.010)
    noticeFrame = frameText("MeleeNotice", 0.26, 0.47, 0.42, 0.07, 0.019)
    developerFrame = frameText("MeleeDeveloper", 0.06, 0.012, 0.72, 0.01, 0.007)
    stagePanel = new StagePanel(new MeleeStageActions())
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let participant = participants[slot]
        participant.hud = new FighterHUD(slot, 4)
        participant.selection = new SelectionPanel(new MeleeSelectionActions(), slot)
        participant.settings = new SettingsPanel(participant.bindings, new MeleeSettingsActions(slot), slot)
    drawStage()
    CameraSetSmoothingFactor(0)
    SetTimeOfDay(12)
    SetTimeOfDayScale(0)
    SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    combatEffects = new CombatEffects(centerX, centerY, floorHeight)
    frostEffects = new FrostEffects(centerX, centerY, floorHeight)
    specialEffects = new SpecialEffects(centerX, centerY, floorHeight)
    initializeShadowInput()
    makePreview()
    lockArenaCamera()
    renderUI()
    setupKeys()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        let participant = participants[slot]
        if matchState.humanActive(slot)
            participant.bindings.initialize()
        else
            participant.bindings.bindings.preset(false)
            participant.bindings.ready = true
            participant.bindings.revision++
    let leave = CreateTrigger()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        TriggerRegisterPlayerEvent(leave, Player(slot), EVENT_PLAYER_LEAVE)
    TriggerAddAction(leave, function playerLeaves)
    gameTimer = CreateTimer()
    TimerStart(gameTimer, FRAME_SECONDS, true, function gameTick)

function playerLeaves()
    let slot = GetPlayerId(GetTriggerPlayer())
    if not matchState.humanPresent(slot)
        return
    let wasMatch = matchState.phase == MATCH
    matchState.participantLeft(slot, matchWorld)
    clearAllInputs()
    matchControls.keyUp(slot)
    participants[slot].bindings.capturing = false
    if shadowInputActive
        shadowInputActive = false
        shadowBatch.beginEpoch(-1)
    if wasMatch
        frostEffects.clear()
        specialEffects.clear()
        clearProjectileModels()
        matchControls.resume()
        pauseMatchPresentation(false)
        announceResult()
    else if matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
        matchState.phase = CHARACTER_MENU
        let mask = currentHumanMask()
        if validParticipantMask(mask)
            matchState.updateConnectedHumans(mask)
            makePreview()
        announce("A player left. Choose the next match.")
    removeBroadKeyEvents()
    syncKeyEventLifecycle()


init
    // Custom frame creation and font setup require the running game UI.
    TimerStart(CreateTimer(), 0., false, function initGame)
