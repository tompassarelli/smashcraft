package Melee
import Wurst
import BuildInfo
import Simulation
import MatchRules
import CommandBuffer
import CombatInput
import MatchStep
import SelectionUI
import BindingSettings
import KeyBindings
import SettingsUI
import FighterAssets

constant real FRAME_SECONDS = 0.016666667

real centerX = 0
real centerY = 0
real floorHeight = 0
MatchState matchState = new MatchState()
Fighter playerFighter = null
Fighter botFighter = null
timer gameTimer = null
boolean moveLeft = false
boolean moveRight = false
boolean moveDown = false
boolean moveUp = false
boolean walkHeld = false
boolean playerNormalAttackQueued = false
boolean playerLeftPressed = false
boolean playerRightPressed = false
boolean playerDownPressed = false
boolean playerGetupAttackPressed = false
boolean playerGetupStandPressed = false
boolean playerTechPressed = false
boolean playerLCancelPressed = false
boolean shieldLeft = false
boolean shieldRight = false
boolean array held
boolean array heldBindingSlots
lightning array stageLines
int stageLineCount = 0
lightning array blastLines
lightning array projectileLines
int projectileLineCount = 0
framehandle titleFrame
framehandle menuFrame
framehandle hudFrame
framehandle helpFrame
framehandle noticeFrame
framehandle developerFrame
string statusText = ""
real statusTime = 0
real botAttackDelay = 0
boolean readyMarkerWritten = false
boolean playerJumpQueued = false
boolean playerJumpHeld = false
boolean playerAirDodgeQueued = false
int playerDodgeX = 0
int playerDodgeZ = 0
boolean botJumpQueued = false
boolean botJumpHeld = false
InputSnapshot playerInput = null
InputSnapshot botInput = null
SelectionPanel selectionPanel = null
SettingsPanel settingsPanel = null
BindingSettings playerBindings = new BindingSettings()
int appliedBindingRevision = -1
AttackBuffer playerAttacks = new AttackBuffer(0)
AttackBuffer botAttacks = new AttackBuffer(0)
int simulationFrame = 0
int playerAttackFacing = 0
int lastInputAction = -1
int lastNormalStyle = -1

class MeleeSelectionActions extends SelectionActions
    override function selectChoice(int choice)
        if not playerBindings.ready or settingsPanel.isOpen()
            return
        matchState.selectChoice(choice)
        if matchState.phase == CHARACTER_MENU
            makePreview()
        else if matchState.phase == STAGE_MENU
            drawStage()

    override function confirmSelection()
        confirm()

    override function backSelection()
        back()

    override function openSettings()
        openSettingsScreen()

class MeleeSettingsActions extends SettingsActions
    override function closeSettings()
        clearHeldInputs()


class Fighter extends FighterState
    unit body
    string animation = ""
    int jumpAnimationRemaining = 0
    boolean doubleJumpAnimation = false

    construct(player owner, int fighterType, real startX, int direction)
        super(fighterType, startX, direction)
        body = CreateUnit(owner, fighterType == 0 ? ARCHER_FIGHTER_ID : 'hrif', centerX + startX, centerY, direction > 0 ? 0 : 180)
        SetUnitInvulnerable(body, true)
        SetUnitPathing(body, false)
        UnitAddAbility(body, 'Amrf')
        UnitRemoveAbility(body, 'Amrf')
        UnitAddAbility(body, 'Aloc')
        PauseUnit(body, true)
        place()

    function place()
        SetUnitX(body, centerX + x)
        SetUnitY(body, centerY)
        SetUnitFlyHeight(body, 1800 + z, 0)
        BlzSetUnitFacingEx(body, facing > 0 ? 0 : 180)


function charName(int which) returns string
    return which == 0 ? "Fox" : "Falco"

function charModel(int which) returns string
    return which == 0 ? "Archer" : "Rifleman"

function frameText(string name, real x, real y, real width, real height, real size) returns framehandle
    let result = BlzCreateFrameByType("TEXT", name, BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
    BlzFrameSetAbsPoint(result, FRAMEPOINT_TOPLEFT, x, y)
    BlzFrameSetSize(result, width, height)
    BlzFrameSetFont(result, "Fonts\\FRIZQT__.TTF", size, 0)
    BlzFrameSetTextAlignment(result, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
    return result

function drawLine(real x1, real z1, real x2, real z2, real r, real g, real b) returns lightning
    let bolt = AddLightningEx("DRAM", false, centerX + x1, centerY, floorHeight + z1,
        centerX + x2, centerY, floorHeight + z2)
    SetLightningColor(bolt, r, g, b, 1)
    return bolt

function clearStageLines()
    for i = 0 to stageLineCount - 1
        DestroyLightning(stageLines[i])
    stageLineCount = 0

function clearProjectileLines()
    for i = 0 to projectileLineCount - 1
        if projectileLines[i] != null
            DestroyLightning(projectileLines[i])
            projectileLines[i] = null
    projectileLineCount = 0

function renderProjectile(int index, boolean active, real x, real z, int direction, int character)
    projectileLineCount = max(projectileLineCount, index + 1)
    if not active
        if projectileLines[index] != null
            DestroyLightning(projectileLines[index])
            projectileLines[index] = null
        return
    let tailX = x - direction * 65
    if projectileLines[index] == null
        projectileLines[index] = AddLightningEx("AFOD", false, centerX + tailX, centerY, floorHeight + z,
            centerX + x, centerY, floorHeight + z)
        SetLightningColor(projectileLines[index], character == 0 ? 1 : 0.3, character == 0 ? 0.2 : 0.65, character == 0 ? 0.15 : 1, 1)
    else
        MoveLightningEx(projectileLines[index], false, centerX + tailX, centerY, floorHeight + z,
            centerX + x, centerY, floorHeight + z)

function renderProjectiles(FighterState fighter, int offset)
    for index = 0 to PROJECTILE_CAPACITY - 1
        renderProjectile(offset + index, projectileActive(fighter, index), projectileXAt(fighter, index),
            projectileZAt(fighter, index), projectileDirectionAt(fighter, index), fighter.character)

function drawStage()
    clearStageLines()
    for i = 0 to surfaceCount(matchState.stageChoice) - 1
        let z = surfaceZ(matchState.stageChoice, i)
        let pass = surfacePass(matchState.stageChoice, i)
        for depth = 0 to 4
            let y = z - depth * 6
            stageLines[stageLineCount] = drawLine(surfaceLeft(matchState.stageChoice, i), y, surfaceRight(matchState.stageChoice, i), y,
                pass ? 0.45 : 0.15, 0.85, 1)
            stageLineCount++

function removeFighters()
    clearProjectileLines()
    if playerFighter != null
        RemoveUnit(playerFighter.body)
        destroy playerFighter
        playerFighter = null
    if botFighter != null
        RemoveUnit(botFighter.body)
        destroy botFighter
        botFighter = null

function makePreview()
    removeFighters()
    playerFighter = new Fighter(Player(0), matchState.characterChoice, -240, 1)
    botFighter = new Fighter(Player(1), 1 - matchState.characterChoice, 240, -1)
    SetUnitAnimation(playerFighter.body, "stand")
    SetUnitAnimation(botFighter.body, "stand")

function announce(string message)
    statusText = message
    statusTime = 2

function loseStock(Fighter f)
    ShowUnit(f.body, false)
    if f.stocks > 0
        announce(f == playerFighter ? "You lost a stock!" : "Opponent lost a stock!")

function attack(Fighter attacker, Fighter target, int style)
    if matchState.phase != MATCH
        return
    if attacker == playerFighter
        playerAttacks.enqueue(style, style == 4 ? playerAttackFacing : 0, simulationFrame + 1, false)
    else
        botAttacks.enqueue(style, target.x >= attacker.x ? 1 : -1, simulationFrame, false)

function applyFrame()
    let playerWasOut = playerFighter.out
    let botWasOut = botFighter.out
    let playerPreviousAttack = playerFighter.attackSerial
    let botPreviousAttack = botFighter.attackSerial
    let playerPreviousStun = playerFighter.hitstun
    let botPreviousStun = botFighter.hitstun
    let playerPreviousJump = playerFighter.jumpSerial
    let botPreviousJump = botFighter.jumpSerial
    let playerPreviousDown = playerFighter.downState
    let playerPreviousLCancel = playerFighter.lCancelSerial
    stepMatch(matchState, playerFighter, botFighter, playerInput, botInput, playerAttacks, botAttacks, simulationFrame)
    if playerFighter.lCancelSerial > playerPreviousLCancel
        announce("L-cancel!")
    if playerFighter.downState != playerPreviousDown
        if playerFighter.downState == DOWN_TECH
            announce("Tech!")
        else if playerFighter.downState == DOWN_TECH_ROLL
            announce("Tech roll!")
    renderFighter(playerFighter, playerWasOut, playerFighter.jumpSerial != playerPreviousJump)
    renderFighter(botFighter, botWasOut, botFighter.jumpSerial != botPreviousJump)
    renderProjectiles(playerFighter, 0)
    renderProjectiles(botFighter, PROJECTILE_CAPACITY)
    if matchState.phase == RESULT
        clearProjectileLines()
    if playerFighter.attackSerial != playerPreviousAttack
        playAttackAnimation(playerFighter)
        if isAerialAttack(playerFighter.attackStyle)
            announce(aerialAttackName(playerFighter.attackStyle))
    if botFighter.attackSerial != botPreviousAttack
        playAttackAnimation(botFighter)
    if playerFighter.hitstun > playerPreviousStun
        SetUnitAnimation(playerFighter.body, "stand hit")
    if botFighter.hitstun > botPreviousStun
        SetUnitAnimation(botFighter.body, "stand hit")

function jump(Fighter f)
    if matchState.phase != MATCH
        return
    if f == playerFighter
        playerJumpQueued = true
        playerJumpHeld = true
    else
        botJumpQueued = true
        botJumpHeld = true

function airDodge(Fighter _f, int horizontal, int vertical)
    if matchState.phase != MATCH
        return
    playerAirDodgeQueued = true
    playerDodgeX = horizontal
    playerDodgeZ = vertical

function startMatch()
    statusText = "GO!"
    statusTime = 1
    moveLeft = false
    moveRight = false
    moveDown = false
    playerAttacks.clear()
    botAttacks.clear()
    simulationFrame = 0
    playerAttackFacing = 0
    playerJumpQueued = false
    playerAirDodgeQueued = false
    makePreview()
    if KNOCKDOWN_SCENARIO
        playerFighter.downState = DOWN_TUMBLE
        playerFighter.grounded = false
        playerFighter.z = TECH_SCENARIO ? 300 : 80
        playerFighter.vz = -8
        playerFighter.hitstun = TECH_SCENARIO ? 60 : 30
        botFighter.x = 350

function choose()
    if not playerBindings.ready or (settingsPanel != null and settingsPanel.isOpen())
        return
    if matchState.phase == CHARACTER_MENU
        matchState.selectChoice(1 - matchState.characterChoice)
        makePreview()
    else if matchState.phase == STAGE_MENU
        matchState.selectChoice(1 - matchState.stageChoice)
        drawStage()

function confirm()
    if not playerBindings.ready or (settingsPanel != null and settingsPanel.isOpen())
        announce("Controls are still loading or settings are open.")
        return
    let previousPhase = matchState.phase
    matchState.confirm()
    if previousPhase == STAGE_MENU
        startMatch()
    else if previousPhase == RESULT
        statusText = ""
        statusTime = 0
        makePreview()
    else if previousPhase == MATCH
        playerNormalAttackQueued = true

function back()
    if not playerBindings.ready or (settingsPanel != null and settingsPanel.isOpen())
        return
    if matchState.phase == STAGE_MENU
        matchState.back()
    else if matchState.phase == MATCH
        attack(playerFighter, botFighter, 1)

function actionHeld(int action) returns boolean
    return heldBindingSlots[action * 2] or heldBindingSlots[action * 2 + 1]

function bindingSlot(int action, int keyCode) returns int
    if playerBindings.bindings.keyFor(action, 0) == keyCode
        return 0
    if playerBindings.bindings.keyFor(action, 1) == keyCode
        return 1
    return -1

function clearHeldInputs()
    for i = 0 to 255
        held[i] = false
    for i = 0 to KEY_SLOT_COUNT - 1
        heldBindingSlots[i] = false
    moveLeft = false
    moveRight = false
    moveDown = false
    moveUp = false
    walkHeld = false
    playerNormalAttackQueued = false
    playerLeftPressed = false
    playerRightPressed = false
    playerDownPressed = false
    playerGetupAttackPressed = false
    playerGetupStandPressed = false
    playerTechPressed = false
    playerLCancelPressed = false
    shieldLeft = false
    shieldRight = false
    playerJumpHeld = false
    playerJumpQueued = false
    playerAirDodgeQueued = false
    playerDodgeX = 0
    playerDodgeZ = 0
    playerAttackFacing = 0
    if playerAttacks != null
        playerAttacks.clear()

function openSettingsScreen()
    if matchState.phase != CHARACTER_MENU and matchState.phase != STAGE_MENU
        return
    if not playerBindings.ready or settingsPanel == null
        announce("Controls are still loading.")
        return
    clearHeldInputs()
    settingsPanel.show()
    if selectionPanel != null
        selectionPanel.update(matchState.phase, matchState.phase == CHARACTER_MENU ? matchState.characterChoice : matchState.stageChoice, true)

function onKeyDown()
    let key = BlzGetTriggerPlayerKey()
    let keyCode = GetHandleId(key)
    if keyCode < 0 or keyCode > 255 or held[keyCode]
        return
    held[keyCode] = true
    if key == OSKEY_F6
        RestartGame(false)
        return
    if key == OSKEY_F5
        EndGame(false)
        return
    if key == OSKEY_ESCAPE and settingsPanel != null and settingsPanel.isOpen()
        settingsPanel.close()
        return
    if settingsPanel != null and settingsPanel.isOpen()
        if playerBindings.capturing
            playerBindings.capture(keyCode)
        return
    if key == OSKEY_F1
        openSettingsScreen()
        return
    if not playerBindings.ready
        return
    let action = playerBindings.bindings.actionFor(keyCode)
    if action < 0
        return
    lastInputAction = action
    let wasHeld = actionHeld(action)
    let slot = bindingSlot(action, keyCode)
    if slot < 0
        return
    heldBindingSlots[action * 2 + slot] = true
    if not wasHeld and matchState.phase == MATCH
        if action == LEFT_TRIGGER or action == RIGHT_TRIGGER or action == GRAB
            playerLCancelPressed = true
        if action == ATTACK or action == SPECIAL
            playerGetupAttackPressed = true
        if action == MOVE_UP or action == JUMP or action == LEFT_TRIGGER or action == RIGHT_TRIGGER
            playerGetupStandPressed = true
    if action == MOVE_LEFT
        moveLeft = true
        if not wasHeld and matchState.phase == MATCH
            playerLeftPressed = true
        if matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
            choose()
    else if action == MOVE_RIGHT
        moveRight = true
        if not wasHeld and matchState.phase == MATCH
            playerRightPressed = true
        if matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
            choose()
    else if action == MOVE_DOWN
        moveDown = true
        if not wasHeld and matchState.phase == MATCH
            playerDownPressed = true
    else if action == MOVE_UP
        moveUp = true
    else if action == WALK_MODIFIER
        walkHeld = true
    else if action == JUMP
        if not wasHeld
            jump(playerFighter)
        playerJumpHeld = true
    else if action == ATTACK
        confirm()
    else if action == SPECIAL
        back()
    else if action == GRAB
        attack(playerFighter, botFighter, 5)
    else if action == LEFT_TRIGGER or action == RIGHT_TRIGGER
        if action == LEFT_TRIGGER
            shieldLeft = true
        else
            shieldRight = true
        if not wasHeld
            if matchState.phase == MATCH
                playerTechPressed = true
            airDodge(playerFighter, (moveRight ? 1 : 0) - (moveLeft ? 1 : 0), (moveUp ? 1 : 0) - (moveDown ? 1 : 0))
    else if action == SMASH_LEFT
        playerAttackFacing = -1
        attack(playerFighter, botFighter, 4)
    else if action == SMASH_RIGHT
        playerAttackFacing = 1
        attack(playerFighter, botFighter, 4)
    else if action == SMASH_UP
        attack(playerFighter, botFighter, 2)
    else if action == SMASH_DOWN
        attack(playerFighter, botFighter, 3)
    if matchState.phase == MATCH and action >= MOVE_LEFT and action <= MOVE_UP and actionHeld(ATTACK)
        playerNormalAttackQueued = true

function onKeyUp()
    let keyCode = GetHandleId(BlzGetTriggerPlayerKey())
    if keyCode < 0 or keyCode > 255
        return
    held[keyCode] = false
    let action = playerBindings.bindings.actionFor(keyCode)
    if action < 0
        return
    let slot = bindingSlot(action, keyCode)
    if slot >= 0
        heldBindingSlots[action * 2 + slot] = false
    if action == MOVE_LEFT
        moveLeft = actionHeld(action)
    else if action == MOVE_RIGHT
        moveRight = actionHeld(action)
    else if action == MOVE_DOWN
        moveDown = actionHeld(action)
    else if action == MOVE_UP
        moveUp = actionHeld(action)
    else if action == WALK_MODIFIER
        walkHeld = actionHeld(action)
    else if action == JUMP
        playerJumpHeld = actionHeld(action)
    else if action == LEFT_TRIGGER
        shieldLeft = actionHeld(action)
    else if action == RIGHT_TRIGGER
        shieldRight = actionHeld(action)

function registerKey(trigger eventTrigger, oskeytype key, boolean down)
    BlzTriggerRegisterPlayerKeyEvent(eventTrigger, Player(0), key, 0, down)

function setupKeys()
    let downTrigger = CreateTrigger()
    let upTrigger = CreateTrigger()
    for keyCode = 1 to 255
        let key = ConvertOsKeyType(keyCode)
        registerKey(downTrigger, key, true)
        registerKey(upTrigger, key, false)
    TriggerAddAction(downTrigger, function onKeyDown)
    TriggerAddAction(upTrigger, function onKeyUp)

function playAttackAnimation(Fighter fighter)
    if fighter.character == 0
        if fighter.attackStyle == 0
            SetUnitAnimationByIndex(fighter.body, ARCHER_JAB_INDEX)
            return
        if fighter.attackStyle == 6
            SetUnitAnimationByIndex(fighter.body, ARCHER_FORWARD_TILT_INDEX)
            return
        if fighter.attackStyle == 9
            SetUnitAnimationByIndex(fighter.body, ARCHER_FORWARD_TILT_UP_INDEX)
            return
        if fighter.attackStyle == 10
            SetUnitAnimationByIndex(fighter.body, ARCHER_FORWARD_TILT_DOWN_INDEX)
            return
        if fighter.attackStyle == DOWN_ATTACK_STYLE
            SetUnitAnimationByIndex(fighter.body, ARCHER_GET_UP_ATTACK_INDEX)
            return
    SetUnitAnimation(fighter.body, "attack")

function aerialAttackName(int style) returns string
    if style == AERIAL_NEUTRAL_STYLE
        return "Neutral air!"
    if style == AERIAL_FORWARD_STYLE
        return "Forward air!"
    if style == AERIAL_BACK_STYLE
        return "Back air!"
    if style == AERIAL_UP_STYLE
        return "Up air!"
    return "Down air!"

function attackAnimationRate(Fighter fighter) returns real
    if fighter.character != 0 or attackPhase(fighter) == ATTACK_NONE
        return 1.
    let seconds = fighter.attackDuration * FRAME_SECONDS
    if fighter.attackStyle == 0
        return ARCHER_JAB_SECONDS / seconds
    if fighter.attackStyle == 6
        return ARCHER_FORWARD_TILT_SECONDS / seconds
    if fighter.attackStyle == 9
        return ARCHER_FORWARD_TILT_UP_SECONDS / seconds
    if fighter.attackStyle == 10
        return ARCHER_FORWARD_TILT_DOWN_SECONDS / seconds
    if fighter.attackStyle == DOWN_ATTACK_STYLE
        return ARCHER_GET_UP_ATTACK_SECONDS / seconds
    return 1.

function downAnimationIndex(Fighter fighter) returns int
    if fighter.downState == DOWN_BOUND or fighter.downState == DOWN_WAIT
        return ARCHER_KNOCKDOWN_INDEX
    if fighter.downState == DOWN_STAND or fighter.downState == DOWN_TECH
        return ARCHER_GET_UP_INDEX
    return fighter.downDirection == fighter.facing ? ARCHER_ROLL_FORWARD_INDEX : ARCHER_ROLL_BACKWARD_INDEX

function downAnimationRate(Fighter fighter) returns real
    if fighter.downState == DOWN_WAIT
        return 0.
    if fighter.character != 0
        return 1.
    if fighter.downState == DOWN_BOUND
        return ARCHER_KNOCKDOWN_SECONDS / (DOWN_BOUND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_STAND
        return ARCHER_GET_UP_SECONDS / (DOWN_STAND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_TECH
        return ARCHER_GET_UP_SECONDS / (TECH_IN_PLACE_FRAMES * FRAME_SECONDS)
    let seconds = fighter.downDirection == fighter.facing ? ARCHER_ROLL_FORWARD_SECONDS : ARCHER_ROLL_BACKWARD_SECONDS
    return seconds / ((fighter.downState == DOWN_TECH_ROLL ? TECH_ROLL_FRAMES : DOWN_ROLL_FRAMES) * FRAME_SECONDS)

function groundDodgeAnimation(Fighter fighter) returns int
    if fighter.groundDodgeDirection == 0
        return ARCHER_SPOT_DODGE_INDEX
    return fighter.groundDodgeDirection == fighter.facing ? ARCHER_ROLL_FORWARD_INDEX : ARCHER_ROLL_BACKWARD_INDEX

function groundDodgeAnimationSeconds(Fighter fighter) returns real
    if fighter.groundDodgeDirection == 0
        return ARCHER_SPOT_DODGE_SECONDS
    return fighter.groundDodgeDirection == fighter.facing ? ARCHER_ROLL_FORWARD_SECONDS : ARCHER_ROLL_BACKWARD_SECONDS

function renderFighter(Fighter f, boolean wasOut, boolean jumped)
    if wasOut and not f.out
        ShowUnit(f.body, true)
    else if not wasOut and f.out
        loseStock(f)
    if f.out
        return
    f.place()
    if f.grounded or f.hitstun > 0 or f.airDodging or attackPhase(f) != ATTACK_NONE or f.downState != DOWN_NONE
        f.jumpAnimationRemaining = 0
    else if jumped and not wasOut
        f.doubleJumpAnimation = f.jumpIsDouble
        f.jumpAnimationRemaining = f.doubleJumpAnimation ? 30 : 24
        f.animation = ""
    else if f.jumpAnimationRemaining > 0 and f.hitlag <= 0
        f.jumpAnimationRemaining--
    var animationRate = attackAnimationRate(f)
    if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
        animationRate = downAnimationRate(f)
    else if f.character == 0 and isGroundDodging(f)
        let duration = f.groundDodgeDirection == 0 ? SPOT_DODGE_FRAMES : GROUND_ROLL_FRAMES
        animationRate = groundDodgeAnimationSeconds(f) / (duration * FRAME_SECONDS)
    else if f.character == 0 and f.jumpAnimationRemaining > 0
        animationRate = f.doubleJumpAnimation ? ARCHER_DOUBLE_JUMP_SECONDS / (30 * FRAME_SECONDS) : ARCHER_JUMP_SECONDS / (24 * FRAME_SECONDS)
    SetUnitTimeScale(f.body, f.hitlag > 0 or f.smashCharging ? 0 : animationRate)
    SetUnitVertexColor(f.body, f.shield ? 100 : 255, f.shield ? 160 : 255, 255, isIntangible(f) ? 140 : 255)
    if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
        let anim = "down" + I2S(f.downState)
        if f.animation != anim
            if f.downState != DOWN_WAIT
                if f.character == 0
                    SetUnitAnimationByIndex(f.body, downAnimationIndex(f))
                else
                    SetUnitAnimation(f.body, f.downState == DOWN_BOUND ? "death" : "stand")
            f.animation = anim
    else if isTumbling(f)
        if f.animation != "tumble"
            SetUnitAnimation(f.body, "stand hit")
            f.animation = "tumble"
    else if f.character == 0 and isGroundDodging(f)
        if f.animation != "dodge"
            SetUnitAnimationByIndex(f.body, groundDodgeAnimation(f))
            f.animation = "dodge"
    else if f.character == 0 and f.jumpAnimationRemaining > 0
        if f.animation != "jump"
            SetUnitAnimationByIndex(f.body, f.doubleJumpAnimation ? ARCHER_DOUBLE_JUMP_INDEX : ARCHER_JUMP_INDEX)
            f.animation = "jump"
    else if attackPhase(f) == ATTACK_NONE and f.hitstun == 0 and f.hitlag == 0
        let anim = f.grounded and totalVelocityX(f).abs() > 0.1 ? "walk" : "stand"
        if f.animation != anim
            SetUnitAnimation(f.body, anim)
            f.animation = anim
    else
        f.animation = ""

function renderUI()
    let selecting = matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
    let controlsOpen = settingsPanel != null and settingsPanel.isOpen()
    BlzFrameSetVisible(titleFrame, selecting and not controlsOpen)
    BlzFrameSetVisible(menuFrame, false)
    BlzFrameSetVisible(hudFrame, not selecting)
    BlzFrameSetVisible(helpFrame, not controlsOpen)
    BlzFrameSetVisible(noticeFrame, not controlsOpen)
    if matchState.phase == CHARACTER_MENU
        BlzFrameSetText(titleFrame, "CHOOSE YOUR FIGHTER")
        BlzFrameSetText(menuFrame, (matchState.characterChoice == 0 ? "|cffffd45a> " : "  ") + "FOX  -  Archer|r\n\n" + (matchState.characterChoice == 1 ? "|cffffd45a> " : "  ") + "FALCO  -  Rifleman|r\n\nYou: " + charName(matchState.characterChoice) + "     Opponent: " + charName(1 - matchState.characterChoice))
        BlzFrameSetText(helpFrame, "Choose Controls with the button or F1. Select a fighter, then press Attack to continue.")
    else if matchState.phase == STAGE_MENU
        BlzFrameSetText(titleFrame, "CHOOSE A STAGE")
        BlzFrameSetText(menuFrame, (matchState.stageChoice == 0 ? "|cffffd45a> " : "  ") + "SKY DECK|r\n\n" + (matchState.stageChoice == 1 ? "|cffffd45a> " : "  ") + "THREE BRIDGES|r\n\n" + (matchState.stageChoice == 0 ? "One wide platform. Open skies on every side." : "A main deck and two raised platforms. Jump through them; hold D to drop."))
        BlzFrameSetText(helpFrame, "Choose Controls with the button or F1. Select a stage, then press Attack to fight.")
    else
        BlzFrameSetText(hudFrame, charName(playerFighter.character) + "   " + I2S(R2I(playerFighter.damage)) + "%   Stocks: " + I2S(playerFighter.stocks) + "          " + charName(botFighter.character) + "   " + I2S(R2I(botFighter.damage)) + "%   Stocks: " + I2S(botFighter.stocks) + "\n" + (matchState.stageChoice == 0 ? "Sky Deck" : "Three Bridges") + "   |cffff6666Red border = KO|r")
        BlzFrameSetText(helpFrame, matchState.phase == RESULT ? "Press Attack to choose your next match     F6: restart" : "Tap Shield before a hard landing to tech; hold Left/Right for a tech roll.\nHold Shield on the ground, then tap Left/Right to roll or Down to dodge.")
        if matchState.phase == MATCH and playerFighter.downState == DOWN_WAIT
            BlzFrameSetText(helpFrame, "Knocked down: Attack/Special to strike, Up/Jump/Shield to stand, Left/Right to roll.")
    BlzFrameSetText(noticeFrame, playerFighter != null and playerFighter.smashCharging ? "Charging smash: release Attack to strike." : (statusTime > 0 ? statusText : ""))
    selectionPanel.update(matchState.phase, matchState.phase == CHARACTER_MENU ? matchState.characterChoice : matchState.stageChoice,
        settingsPanel != null and settingsPanel.isOpen())
    if settingsPanel != null
        settingsPanel.update()
    if playerFighter != null
        BlzFrameSetText(developerFrame, "Developer test: " + BUILD_ID + " | phase=" + I2S(matchState.phase) + " | x=" + I2S(R2I(playerFighter.x)) + " z=" + I2S(R2I(playerFighter.z)) + " | input=" + I2S(lastInputAction) + " normal=" + I2S(lastNormalStyle) + " move=" + I2S(playerFighter.attackStyle) + " frame=" + I2S(playerFighter.attackFrame) + " serial=" + I2S(playerFighter.attackSerial) + " down=" + I2S(playerFighter.downState) + ":" + I2S(playerFighter.downFrame) + " DI=" + I2S(playerFighter.diSerial) + ":" + I2S(R2I(playerFighter.diAngleDegrees)) + " | F6 restart")

function lockArenaCamera()
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 2050, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1960, 0)
    SetCameraField(CAMERA_FIELD_ROLL, 0, 0)
    SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW, 70, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(centerX, centerY)

function gameTick()
    if appliedBindingRevision != playerBindings.revision
        clearHeldInputs()
        appliedBindingRevision = playerBindings.revision
    lockArenaCamera()
    statusTime = max(0, statusTime - FRAME_SECONDS)
    if matchState.phase == MATCH
        simulationFrame++
        let direction = (moveRight ? 1 : 0) - (moveLeft ? 1 : 0)
        if playerNormalAttackQueued
            let style = normalAttackStyle(direction, (moveUp ? 1 : 0) - (moveDown ? 1 : 0), walkHeld)
            lastNormalStyle = style
            playerAttacks.enqueue(style, direction, simulationFrame, true)
        var botDirection = 0
        if not KNOCKDOWN_SCENARIO and not botFighter.out and not playerFighter.out
            let gap = playerFighter.x - botFighter.x
            if gap.abs() > 95
                botDirection = gap > 0 ? 1 : -1
            if not botFighter.grounded and botFighter.z < -30 and totalVelocityZ(botFighter) < 0 and botFighter.jumps > 0
                botJumpQueued = true
            if botFighter.grounded and playerFighter.z > botFighter.z + 130
                botJumpQueued = true
            botAttackDelay -= FRAME_SECONDS
            if gap.abs() < 135 and botAttackDelay <= 0
                attack(botFighter, playerFighter, 0)
                botAttackDelay = 0.35
        playerInput.direction = direction
        playerInput.verticalDirection = (moveUp ? 1 : 0) - (moveDown ? 1 : 0)
        playerInput.attackHeld = actionHeld(ATTACK)
        playerInput.techPressed = playerTechPressed
        playerInput.lCancelPressed = playerLCancelPressed
        playerInput.getupAttackPressed = playerGetupAttackPressed
        playerInput.getupStandPressed = playerGetupStandPressed
        playerInput.getupDirection = (playerRightPressed ? 1 : 0) - (playerLeftPressed ? 1 : 0)
        playerInput.getupDirectionPressed = playerInput.getupDirection != 0
        playerInput.walking = walkHeld
        playerInput.down = moveDown
        playerInput.shield = shieldLeft or shieldRight
        let groundDodge = groundDodgeIntent(playerInput.shield, playerLeftPressed, playerRightPressed, playerDownPressed)
        playerInput.groundDodgePressed = groundDodge != NO_GROUND_DODGE
        playerInput.groundDodgeDirection = groundDodge == NO_GROUND_DODGE ? 0 : groundDodge
        playerInput.jumpPressed = playerJumpQueued
        playerInput.jumpHeld = playerJumpHeld
        playerInput.airDodgePressed = playerAirDodgeQueued
        playerInput.dodgeX = playerDodgeX
        playerInput.dodgeZ = playerDodgeZ
        botInput.direction = botDirection
        botInput.jumpPressed = botJumpQueued
        botInput.jumpHeld = botJumpHeld
        applyFrame()
        playerAttackFacing = 0
        playerNormalAttackQueued = false
        playerLeftPressed = false
        playerRightPressed = false
        playerDownPressed = false
        playerGetupAttackPressed = false
        playerGetupStandPressed = false
        playerTechPressed = false
        playerLCancelPressed = false
        playerJumpQueued = false
        playerInput.jumpPressed = false
        playerAirDodgeQueued = false
        playerDodgeX = 0
        playerDodgeZ = 0
        botJumpQueued = false
        botJumpHeld = false
        botInput.jumpPressed = false
        if matchState.phase == RESULT
            statusText = matchState.winner == 0 ? "Victory! You win!" : (matchState.winner == 1 ? "Defeat! The opponent wins." : "Draw! Both fighters are out.")
            statusTime = 3600
    renderUI()
    if not readyMarkerWritten and playerBindings.ready
        readyMarkerWritten = true
        PreloadGenClear()
        PreloadGenStart()
        Preload("BUILD " + BUILD_ID)
        Preload("SCENARIO " + (TECH_SCENARIO ? "tech" : (KNOCKDOWN_SCENARIO ? "knockdown" : "normal")))
        Preload("BINDINGS " + playerBindings.bindings.encode())
        PreloadGenEnd("wc3-melee-ready.txt")

function initGame()
    playerInput = new InputSnapshot()
    botInput = new InputSnapshot()
    let center = GetRectCenter(GetPlayableMapRect())
    centerX = GetLocationX(center)
    centerY = GetLocationY(center)
    floorHeight = GetLocationZ(center) + 1800
    RemoveLocation(center)
    BlzHideOriginFrames(true)
    BlzEnableSelections(false, false)
    EnableUserControl(true)
    FogEnable(false)
    FogMaskEnable(false)
    titleFrame = frameText("MeleeTitle", 0.06, 0.56, 0.68, 0.04, 0.023)
    menuFrame = frameText("MeleeMenu", 0.06, 0.505, 0.68, 0.19, 0.017)
    hudFrame = frameText("MeleeScore", 0.06, 0.555, 0.68, 0.06, 0.019)
    helpFrame = frameText("MeleeHelp", 0.06, 0.095, 0.69, 0.055, 0.013)
    noticeFrame = frameText("MeleeNotice", 0.26, 0.47, 0.42, 0.07, 0.019)
    developerFrame = frameText("MeleeDeveloper", 0.06, 0.035, 0.72, 0.03, 0.010)
    selectionPanel = new SelectionPanel(new MeleeSelectionActions())
    settingsPanel = new SettingsPanel(playerBindings, new MeleeSettingsActions())
    blastLines[0] = drawLine(-920, -420, 920, -420, 1, 0.15, 0.15)
    blastLines[1] = drawLine(-920, 760, 920, 760, 1, 0.15, 0.15)
    blastLines[2] = drawLine(-920, -420, -920, 760, 1, 0.15, 0.15)
    blastLines[3] = drawLine(920, -420, 920, 760, 1, 0.15, 0.15)
    drawStage()
    lockArenaCamera()
    CameraSetSmoothingFactor(0)
    SetTimeOfDay(12)
    SetTimeOfDayScale(0)
    SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    PanCameraToTimed(centerX, centerY, 0)
    makePreview()
    renderUI()
    setupKeys()
    playerBindings.initialize()
    gameTimer = CreateTimer()
    TimerStart(gameTimer, FRAME_SECONDS, true, function gameTick)

init
    initGame()
