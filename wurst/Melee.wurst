class MeleeSelectionActions extends SelectionActions
    override function selectChoice(int participantId, int choice)
        let bindings = participantId == 0 ? playerBindings : secondBindings
        let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
        if not bindings.ready or controls.isOpen() or matchState.phase != CHARACTER_MENU
            return
        matchState.selectCharacter(participantId, choice)
        makePreview()

    override function selectCpuChoice(int participantId, int choice)
        if participantId != 0 or twoHumanPlayers or not playerBindings.ready or matchState.phase != CHARACTER_MENU
            return
        if settingsPanel != null and settingsPanel.isOpen()
            return
        matchState.selectCpuCharacter(participantId, choice)
        makePreview()

    override function recallChoice(int actorId, int chipSlot)
        if actorId != 0 and actorId != 1
            return
        if actorId == 1 and not twoHumanPlayers
            return
        if not matchState.characterReady(chipSlot)
            return
        let bindings = actorId == 0 ? playerBindings : secondBindings
        let controls = actorId == 0 ? settingsPanel : secondSettingsPanel
        if not bindings.ready or (controls != null and controls.isOpen())
            return
        matchState.recallCharacter(actorId, chipSlot)
        makePreview()

    override function openSettings(int participantId)
        openSettingsScreen(participantId)

    override function start(int participantId)
        if matchState.phase == CHARACTER_MENU
            confirm(participantId)

class MeleeStageActions extends StageActions
    override function selectStage(int participantId, int choice)
        matchState.selectStage(participantId, choice)
    override function changeStocks(int participantId, int direction)
        matchState.setStocks(participantId, matchState.stockCount + direction)
    override function changeTime(int participantId, int direction)
        matchState.setTimeLimit(participantId, matchState.timeLimitMinutes + direction)
    override function start(int participantId)
        confirm(participantId)
    override function back(int participantId)
        matchState.returnToCharacters(participantId)

class MeleeSettingsActions extends SettingsActions
    int participantId
    construct(int participantId)
        this.participantId = participantId
    override function closeSettings(int _participantId)
        if participantId == 0
            clearHeldInputs()
        else
            clearSecondInputs()


class Fighter extends FighterState
    unit body
    effect shieldEffect = null
    effect dizzyEffect = null
    string animation = ""
    int jumpAnimationRemaining = 0
    boolean doubleJumpAnimation = false

    construct(player owner, int fighterType, real startX, int direction)
        super(fighterType, startX, direction)
        body = CreateUnit(owner, fighterType == 0 ? ARCHER_FIGHTER_ID : RIFLEMAN_FIGHTER_ID, centerX + startX, centerY, direction > 0 ? 0 : 180)
        SetUnitInvulnerable(body, true)
        SetUnitPathing(body, false)
        UnitAddAbility(body, 'Amrf')
        UnitRemoveAbility(body, 'Amrf')
        UnitAddAbility(body, 'Aloc')
        PauseUnit(body, true)
        // A blended transition can retain the previous pose throughout hitlag.
        SetUnitBlendTime(body, 0.)
        place()

    function place()
        SetUnitX(body, centerX + x)
        SetUnitY(body, centerY)
        SetUnitFlyHeight(body, 1800 + z, 0)
        BlzSetUnitFacingEx(body, facing > 0 ? 0 : 180)

    function clearShieldEffect()
        if shieldEffect != null
            BlzSetSpecialEffectScale(shieldEffect, 0.)
            DestroyEffect(shieldEffect)
            shieldEffect = null

    function renderShield()
        if not shield or out or matchState.phase != MATCH
            clearShieldEffect()
            return
        if shieldEffect == null
            shieldEffect = AddSpecialEffect(Abilities.antiMagicShell, centerX + x, centerY)
            BlzSetSpecialEffectAlpha(shieldEffect, 180)
        let scale = 0.7 + 0.5 * shieldEnergy / SHIELD_MAX
        // AntiMagicShell's Stand bounds center is 47.6 units below its origin.
        BlzSetSpecialEffectPosition(shieldEffect, centerX + x, centerY, floorHeight + z + 50 + 47.6 * scale)
        BlzSetSpecialEffectScale(shieldEffect, scale)

    function clearDizzyEffect()
        if dizzyEffect != null
            BlzSetSpecialEffectScale(dizzyEffect, 0.)
            DestroyEffect(dizzyEffect)
            dizzyEffect = null

    function renderDizzy()
        if shieldBreakState != SHIELD_BREAK_DIZZY or out or matchState.phase != MATCH
            clearDizzyEffect()
            return
        if dizzyEffect == null
            dizzyEffect = AddSpecialEffect(Abilities.thunderclapTarget, centerX + x, centerY)
        BlzSetSpecialEffectPosition(dizzyEffect, centerX + x, centerY, floorHeight + z + 115)


function charName(int which) returns string
    return which == 0 ? "Archer" : "Rifleman"

function charModel(int which) returns string
    return which == 0 ? "Archer" : "Rifleman"

function frameText(string name, real x, real y, real width, real height, real size) returns framehandle
    let result = BlzCreateFrameByType("TEXT", name, BlzGetOriginFrame(ORIGIN_FRAME_GAME_UI, 0), "", 0)
    BlzFrameSetAbsPoint(result, FRAMEPOINT_TOPLEFT, x, y)
    BlzFrameSetSize(result, width, height)
    BlzFrameSetFont(result, "Fonts\\FRIZQT__.TTF", size, 0)
    BlzFrameSetTextAlignment(result, TEXT_JUSTIFY_TOP, TEXT_JUSTIFY_LEFT)
    return result

function clearStageDecks()
    for i = 0 to stageDeckCount - 1
        BlzSetSpecialEffectScale(stageDecks[i], 0.)
        DestroyEffect(stageDecks[i])
        stageDecks[i] = null
    stageDeckCount = 0

function clearProjectileModels()
    for i = 0 to projectileModelCount - 1
        if projectileModels[i] != null
            DestroyEffect(projectileModels[i])
            projectileModels[i] = null
    projectileModelCount = 0

function renderProjectile(int index, boolean active, real x, real z, real velocityX, real velocityZ, int character)
    projectileModelCount = max(projectileModelCount, index + 1)
    if not active
        if projectileModels[index] != null
            DestroyEffect(projectileModels[index])
            projectileModels[index] = null
        return
    if projectileModels[index] == null
        let model = character == 0 ? Abilities.arrowMissile1 : Abilities.gyroCopterMissile
        projectileModels[index] = AddSpecialEffect(model, centerX + x, centerY)
        if character == 1
            BlzSetSpecialEffectScale(projectileModels[index], 0.65)
    BlzSetSpecialEffectYaw(projectileModels[index], velocityX >= 0 ? 0. : 3.141592654)
    BlzSetSpecialEffectPitch(projectileModels[index], -Atan2(velocityZ, velocityX.abs()))
    BlzSetSpecialEffectPosition(projectileModels[index], centerX + x, centerY, floorHeight + z)

function renderProjectiles(FighterState fighter, int offset)
    for index = 0 to PROJECTILE_CAPACITY - 1
        renderProjectile(offset + index, projectileActive(fighter, index), projectileXAt(fighter, index),
            projectileZAt(fighter, index), projectileVelocityXAt(fighter, index), projectileVelocityZAt(fighter, index), fighter.character)

function drawStage()
    clearStageDecks()
    for i = 0 to surfaceCount(matchState.stageChoice) - 1
        let left = surfaceLeft(matchState.stageChoice, i)
        let right = surfaceRight(matchState.stageChoice, i)
        let pass = surfacePass(matchState.stageChoice, i)
        let deck = AddSpecialEffect(STAGE_DECK_MODEL, centerX + (left + right) / 2, centerY)
        BlzSetSpecialEffectPosition(deck, centerX + (left + right) / 2, centerY, floorHeight + surfaceZ(matchState.stageChoice, i))
        // The authored walking plane spans [-50,50] at z=0; the body stays below it.
        BlzSetSpecialEffectMatrixScale(deck, (right - left) / 100, pass ? 0.65 : 1., pass ? 0.45 : 1.)
        stageDecks[stageDeckCount] = deck
        stageDeckCount++

function removeFighters()
    if frostEffects != null
        frostEffects.clear()
    if specialEffects != null
        specialEffects.clear()
    if combatEffects != null
        combatEffects.clear()
    clearProjectileModels()
    if playerFighter != null
        playerFighter.clearShieldEffect()
        playerFighter.clearDizzyEffect()
        RemoveUnit(playerFighter.body)
        destroy playerFighter
        playerFighter = null
    if botFighter != null
        botFighter.clearShieldEffect()
        botFighter.clearDizzyEffect()
        RemoveUnit(botFighter.body)
        destroy botFighter
        botFighter = null

function makePreview()
    clearHeldInputs()
    clearSecondInputs()
    removeFighters()
    playerFighter = new Fighter(Player(0), matchState.characterChoice, -240, 1)
    botFighter = new Fighter(Player(1), matchState.secondCharacterChoice, 240, -1)
    SetUnitAnimation(playerFighter.body, "stand")
    SetUnitAnimation(botFighter.body, "stand")

function announce(string message)
    statusText = message
    statusTime = 2

function loseStock(Fighter f)
    ShowUnit(f.body, false)
    if f.stocks > 0
        announce(f == playerFighter ? "Player 1 lost a stock!" : (twoHumanPlayers ? "Player 2 lost a stock!" : "Opponent lost a stock!"))

function attack(Fighter attacker, Fighter target, int style)
    if matchState.phase != MATCH
        return
    if attacker == playerFighter
        queueHumanAttack(playerAttackRequests, secondAttackRequests, 0, style, style == 4 ? playerAttackFacing : 0, replayRuntime.simulationFrame)
    else if twoHumanPlayers
        queueHumanAttack(playerAttackRequests, secondAttackRequests, 1, style, style == 4 ? secondAttackFacing : 0, replayRuntime.simulationFrame)
    else
        secondAttackRequests.enqueue(style, target.x >= attacker.x ? 1 : -1, replayRuntime.simulationFrame, false)

function traceFrameInput(int participantId, InputSnapshot input, AttackBuffer attacks, int frame)
    if inputTraceActive and (input.jumpPressed or input.airDodgePressed or input.specialPressed or attacks.hasPending(frame))
        traceInput("participant " + I2S(participantId) + " frame " + I2S(frame) + " phase " + I2S(matchState.phase) + " sampled x " + I2S(input.direction) + " z " + I2S(input.verticalDirection) + " jump " + (input.jumpPressed ? "1" : "0") + " dodge " + (input.airDodgePressed ? "1" : "0") + " special " + (input.specialPressed ? "1" : "0") + " attack " + I2S(attacks.hasPending(frame) ? attacks.style : -1))

function traceSpecialAction(int participantId, Fighter f, int previousAction)
    if f.specialAction != previousAction
        traceParticipant(participantId, "special " + I2S(f.specialAction) + " action-frame " + I2S(f.specialFrame) + " x " + R2S(f.x) + " z " + R2S(f.z))

function traceRecovery(int participantId, Fighter f, int previousDown, boolean previouslyActionable)
    if inputTraceActive and (f.downState != previousDown or canAttack(f) != previouslyActionable)
        traceParticipant(participantId, "recovery down " + I2S(f.downState) + " actionable " + (canAttack(f) ? "1" : "0") + " hitlag " + I2S(f.hitlag) + " hitstun " + I2S(f.hitstun) + " damage " + R2S(f.damage))

function applyFrame()
    firstImpacts.before(playerFighter)
    secondImpacts.before(botFighter)
    let playerWasOut = playerFighter.out
    let botWasOut = botFighter.out
    let playerPreviousAttack = playerFighter.attackSerial
    let botPreviousAttack = botFighter.attackSerial
    let playerPreviousJump = playerFighter.jumpSerial
    let botPreviousJump = botFighter.jumpSerial
    let playerPreviousDown = playerFighter.downState
    let botPreviousDown = botFighter.downState
    let playerPreviouslyActionable = canAttack(playerFighter)
    let botPreviouslyActionable = canAttack(botFighter)
    let playerPreviousLCancel = playerFighter.lCancelSerial
    let playerPreviousShieldBreak = playerFighter.shieldBreakSerial
    let botPreviousShieldBreak = botFighter.shieldBreakSerial
    let playerPreviousBreakState = playerFighter.shieldBreakState
    let playerPreviousLedge = playerFighter.ledgeState
    let playerPreviousSpecial = playerFighter.specialAction
    let botPreviousSpecial = botFighter.specialAction
    let playerWasHolding = playerFighter.grabTarget != null
    let botWasHolding = botFighter.grabTarget != null
    let playerPreviousGrab = playerFighter.grabAction
    let botPreviousGrab = botFighter.grabAction
    if not currentFrameInput.execute(matchState, playerFighter, botFighter,
            playerAttacks, botAttacks, replayRuntime, currentFrameInput.frameNumber())
        return
    firstImpacts.after(playerFighter)
    secondImpacts.after(botFighter)
    if playerPreviousGrab != playerFighter.grabAction
        traceParticipant(0, "grab action " + I2S(playerFighter.grabAction) + " frame " + I2S(playerFighter.grabFrame) + " serial " + I2S(playerFighter.grabSerial))
    if botPreviousGrab != botFighter.grabAction
        traceParticipant(1, "grab action " + I2S(botFighter.grabAction) + " frame " + I2S(botFighter.grabFrame) + " serial " + I2S(botFighter.grabSerial))
    if playerWasHolding != (playerFighter.grabTarget != null)
        traceParticipant(0, "grab-hold " + (playerFighter.grabTarget != null ? "start" : "end"))
    if botWasHolding != (botFighter.grabTarget != null)
        traceParticipant(1, "grab-hold " + (botFighter.grabTarget != null ? "start" : "end"))
    traceSpecialAction(0, playerFighter, playerPreviousSpecial)
    traceSpecialAction(1, botFighter, botPreviousSpecial)
    traceRecovery(0, playerFighter, playerPreviousDown, playerPreviouslyActionable)
    traceRecovery(1, botFighter, botPreviousDown, botPreviouslyActionable)
    combatEffects.present(replayRuntime.simulationFrame, firstImpacts, secondImpacts)
    if playerFighter.shieldBreakSerial > playerPreviousShieldBreak
        announce("Player 1's shield broke!")
    else if botFighter.shieldBreakSerial > botPreviousShieldBreak
        announce(twoHumanPlayers ? "Player 2's shield broke!" : "Opponent's shield broke!")
    if playerPreviousBreakState != playerFighter.shieldBreakState
        traceInput("shield-break " + I2S(playerFighter.shieldBreakState) + " z " + R2S(playerFighter.z) + " remaining " + I2S(playerFighter.shieldBreakRemaining))
    if playerPreviousLedge != playerFighter.ledgeState
        traceInput("ledge " + I2S(playerFighter.ledgeState) + " x " + R2S(playerFighter.x) + " z " + R2S(playerFighter.z))
    if playerFighter.jumpSerial != playerPreviousJump
        traceInput("jump " + I2S(playerFighter.jumpSerial) + " double " + (playerFighter.jumpIsDouble ? "1" : "0") + " z " + R2S(playerFighter.z))
        traceParticipant(0, "applied jump " + I2S(playerFighter.jumpSerial))
    if botFighter.jumpSerial != botPreviousJump
        traceParticipant(1, "applied jump " + I2S(botFighter.jumpSerial))
    if playerFighter.lCancelSerial > playerPreviousLCancel
        announce("L-cancel!")
    if playerFighter.downState != playerPreviousDown
        if playerFighter.downState == DOWN_TECH
            announce("Tech!")
        else if playerFighter.downState == DOWN_TECH_ROLL
            announce("Tech roll!")
    if playerFighter.attackSerial != playerPreviousAttack
        traceParticipant(0, "applied attack " + I2S(playerFighter.attackSerial) + " style " + I2S(playerFighter.attackStyle))
        if attackPhase(playerFighter) != ATTACK_NONE
            playAttackAnimation(playerFighter)
        if isAerialAttack(playerFighter.attackStyle)
            announce(aerialAttackName(playerFighter.attackStyle))
    if botFighter.attackSerial != botPreviousAttack
        traceParticipant(1, "applied attack " + I2S(botFighter.attackSerial) + " style " + I2S(botFighter.attackStyle))
        if attackPhase(botFighter) != ATTACK_NONE
            playAttackAnimation(botFighter)
    renderFighter(playerFighter, playerWasOut, playerFighter.jumpSerial != playerPreviousJump, firstImpacts.hit)
    renderFighter(botFighter, botWasOut, botFighter.jumpSerial != botPreviousJump, secondImpacts.hit)
    frostEffects.present(playerFighter, botFighter)
    specialEffects.present(playerFighter, botFighter)
    renderProjectiles(playerFighter, 0)
    renderProjectiles(botFighter, PROJECTILE_CAPACITY)
    if matchState.phase == RESULT
        clearProjectileModels()

function jump(Fighter f)
    if matchState.phase != MATCH
        return
    if f == playerFighter
        playerJumpQueued = true
        playerJumpHeld = true
    else if twoHumanPlayers
        secondJumpQueued = true
    else
        botJumpQueued = true
        botJumpHeld = true

function airDodge(Fighter _f, int horizontal, int vertical)
    if matchState.phase != MATCH
        return
    if _f == playerFighter
        playerAirDodgeQueued = true
        playerDodgeX = horizontal
        playerDodgeZ = vertical
    else
        secondAirDodgeQueued = true
        secondDodgeX = horizontal
        secondDodgeZ = vertical

function startMatch()
    let wasPaused = matchControls.isPaused()
    statusText = "GO!"
    statusTime = 1
    if settingsPanel != null and settingsPanel.isOpen()
        settingsPanel.close()
    if secondSettingsPanel != null and secondSettingsPanel.isOpen()
        secondSettingsPanel.close()
    playerAttacks.clear()
    botAttacks.clear()
    playerAttackRequests.clear()
    secondAttackRequests.clear()
    clearHeldInputs()
    clearSecondInputs()
    replayRuntime.simulationFrame = 0
    matchControls.resume()
    currentFrameInput.reset()
    replayRuntime.botAttackDelay = 0
    botJumpHeld = false
    playerAttackFacing = 0
    playerJumpQueued = false
    playerAirDodgeQueued = false
    makePreview()
    initializeMatchFighters(matchState, playerFighter, botFighter)
    drawStage()
    if wasPaused
        pauseMatchPresentation(false)
    if KNOCKDOWN_SCENARIO
        playerFighter.downState = DOWN_TUMBLE
        playerFighter.grounded = false
        playerFighter.z = TECH_SCENARIO ? 300 : 80
        playerFighter.vz = -8
        playerFighter.hitstun = TECH_SCENARIO ? 60 : 30
        botFighter.x = TECH_SCENARIO ? 350 : playerFighter.x + 100
    if SHIELD_BREAK_SCENARIO
        playerFighter.shieldEnergy = 1
        botFighter.x = 350
    if LEDGE_SCENARIO
        playerFighter.x = surfaceLeft(matchState.stageChoice, 0) - 16
        playerFighter.z = 15
        playerFighter.grounded = false
        playerFighter.surface = -1
        playerFighter.facing = 1
        playerFighter.vz = -1
        playerFighter.jumps = 0
        botFighter.x = 350

function choose(int participantId)
    let bindings = participantId == 0 ? playerBindings : secondBindings
    let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
    if not bindings.ready or (controls != null and controls.isOpen())
        return
    if matchState.phase == CHARACTER_MENU
        matchState.selectCharacter(participantId, 1 - matchState.characterFor(participantId))
        makePreview()
    else if matchState.phase == STAGE_MENU
        matchState.selectStage(participantId, 1 - matchState.stageChoice)

function confirm(int participantId)
    let bindings = participantId == 0 ? playerBindings : secondBindings
    let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
    if not bindings.ready or (controls != null and controls.isOpen())
        announce("Controls are still loading or settings are open.")
        return
    let previousPhase = matchState.phase
    if previousPhase == CHARACTER_MENU
        if matchState.requestStageSelect(participantId)
            if settingsPanel != null
                settingsPanel.close()
            if secondSettingsPanel != null
                secondSettingsPanel.close()
    else if previousPhase == STAGE_MENU
        if matchState.requestStart(participantId)
            startMatch()
    else if previousPhase == RESULT
        if matchState.confirmRematch(participantId)
            statusText = ""
            statusTime = 0
            makePreview()
    else if previousPhase == MATCH
        if participantId == 0
            playerNormalAttackQueued = true
        else
            secondNormalAttackQueued = true

function back(int participantId)
    let bindings = participantId == 0 ? playerBindings : secondBindings
    let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
    if not bindings.ready or (controls != null and controls.isOpen())
        return
    if matchState.phase == CHARACTER_MENU
        if participantId == 0
            selectionPanel.recallHeld()
        else
            secondSelectionPanel.recallHeld()
    else if matchState.phase == STAGE_MENU
        matchState.returnToCharacters(participantId)
    else if matchState.phase == MATCH
        attack(participantId == 0 ? playerFighter : botFighter, participantId == 0 ? botFighter : playerFighter, 1)

function actionHeld(int action) returns boolean
    return firstKeyState.actionHeld(action)

function clearSecondInputs()
    secondMashPressed = false
    secondGrabMashPressed = false
    secondAttackPressed = false
    secondThrowX = 0
    secondThrowZ = 0
    secondLedgeVerticalPressed = 0
    secondKeyState.clear()
    secondNormalAttackQueued = false
    secondLeftPressed = false
    secondRightPressed = false
    secondDownPressed = false
    secondSpecialPressed = false
    secondTechPressed = false
    secondLCancelPressed = false
    secondGetupAttackPressed = false
    secondGetupStandPressed = false
    secondJumpQueued = false
    secondAirDodgeQueued = false
    secondDodgeX = 0
    secondDodgeZ = 0
    secondAttackFacing = 0
    botJumpQueued = false
    botJumpHeld = false
    if secondAttackRequests != null
        secondAttackRequests.clear()
    if botAttacks != null
        botAttacks.clear()

function clearHeldInputs()
    playerMashPressed = false
    playerGrabMashPressed = false
    playerAttackPressed = false
    playerThrowX = 0
    playerThrowZ = 0
    playerLedgeVerticalPressed = 0
    firstKeyState.clear()
    playerNormalAttackQueued = false
    playerLeftPressed = false
    playerRightPressed = false
    playerDownPressed = false
    playerSpecialPressed = false
    playerGetupAttackPressed = false
    playerGetupStandPressed = false
    playerTechPressed = false
    playerLCancelPressed = false
    playerJumpHeld = false
    playerJumpQueued = false
    playerAirDodgeQueued = false
    playerDodgeX = 0
    playerDodgeZ = 0
    playerAttackFacing = 0
    if playerAttackRequests != null
        playerAttackRequests.clear()
    if playerAttacks != null
        playerAttacks.clear()

function openSettingsScreen(int participantId)
    if matchState.phase != CHARACTER_MENU
        return
    let bindings = participantId == 0 ? playerBindings : secondBindings
    let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
    if not bindings.ready or controls == null
        announce("Controls are still loading.")
        return
    if participantId == 0
        clearHeldInputs()
    else
        clearSecondInputs()
    controls.show()

function onParticipantKeyDown(int participantId)
    let key = BlzGetTriggerPlayerKey()
    let keyCode = GetHandleId(key)
    traceParticipant(participantId, "received down " + I2S(keyCode))
    let state = participantId == 0 ? firstKeyState : secondKeyState
    let bindings = participantId == 0 ? playerBindings : secondBindings
    let controls = participantId == 0 ? settingsPanel : secondSettingsPanel
    let fighter = participantId == 0 ? playerFighter : botFighter
    let opponent = participantId == 0 ? botFighter : playerFighter
    if keyCode < 0 or keyCode > 255 or state.isKeyHeld(keyCode)
        return
    if key == OSKEY_Y
        let controlAction = matchControls.keyDown(participantId, matchState.phase, controls != null and controls.isOpen())
        if controlAction == START_PAUSE_TOGGLED
            clearHeldInputs()
            clearSecondInputs()
            if matchControls.isPaused()
                statusText = "Paused — press Y to resume."
                statusTime = 3600
                pauseMatchPresentation(true)
            else
                pauseMatchPresentation(false)
                statusText = "Resumed."
                statusTime = 1
        else if controlAction == START_PAUSE_CONFIRM
            confirm(participantId)
        return
    if participantId == 0 and key == OSKEY_F5
        EndGame(false)
        return
    if key == OSKEY_ESCAPE and controls != null and controls.isOpen()
        controls.close()
        return
    if controls != null and controls.isOpen()
        if bindings.capturing
            bindings.capture(keyCode)
        return
    if key == OSKEY_F1
        openSettingsScreen(participantId)
        return
    if participantId == 1 and not twoHumanPlayers
        return
    if not bindings.ready
        return
    if key == OSKEY_ESCAPE and matchState.phase == STAGE_MENU
        back(participantId)
        return
    if matchState.phase == MATCH and matchControls.isPaused()
        return
    let action = bindings.bindings.actionFor(keyCode)
    let wasHeld = action >= 0 and state.actionHeld(action)
    if state.press(keyCode, bindings.bindings) < 0
        return
    traceParticipant(participantId, "mapped action " + I2S(action))
    if participantId == 0
        traceInput("down " + I2S(keyCode))
        lastInputAction = action
    else
        secondLastInputAction = action
    if not wasHeld and matchState.phase == MATCH
        let mashButton = action == ATTACK or action == SPECIAL or action == JUMP or action == GRAB or action == LEFT_TRIGGER or action == RIGHT_TRIGGER
        let throwX = action == MOVE_LEFT or action == SMASH_LEFT ? -1 : (action == MOVE_RIGHT or action == SMASH_RIGHT ? 1 : 0)
        let throwZ = action == MOVE_DOWN or action == SMASH_DOWN ? -1 : (action == MOVE_UP or action == SMASH_UP ? 1 : 0)
        if participantId == 0
            playerGrabMashPressed = playerGrabMashPressed or mashButton
            playerAttackPressed = playerAttackPressed or action == ATTACK
            playerThrowX += throwX
            playerThrowZ += throwZ
        else
            secondGrabMashPressed = secondGrabMashPressed or mashButton
            secondAttackPressed = secondAttackPressed or action == ATTACK
            secondThrowX += throwX
            secondThrowZ += throwZ
        if action == MOVE_UP or action == MOVE_DOWN
            if participantId == 0
                playerLedgeVerticalPressed = action == MOVE_UP ? 1 : -1
            else
                secondLedgeVerticalPressed = action == MOVE_UP ? 1 : -1
        if participantId == 0
            playerMashPressed = true
        else
            secondMashPressed = true
        if action == LEFT_TRIGGER or action == RIGHT_TRIGGER or action == GRAB
            if participantId == 0
                playerLCancelPressed = true
            else
                secondLCancelPressed = true
        if action == ATTACK or (action == SPECIAL and (fighter.character != 1 or not state.actionHeld(MOVE_DOWN)))
            if participantId == 0
                playerGetupAttackPressed = true
            else
                secondGetupAttackPressed = true
        if action == MOVE_UP or action == JUMP or action == LEFT_TRIGGER or action == RIGHT_TRIGGER
            if participantId == 0
                playerGetupStandPressed = true
            else
                secondGetupStandPressed = true
    if action == MOVE_LEFT
        if not wasHeld and matchState.phase == MATCH
            if participantId == 0
                playerLeftPressed = true
            else
                secondLeftPressed = true
        if matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
            choose(participantId)
    else if action == MOVE_RIGHT
        if not wasHeld and matchState.phase == MATCH
            if participantId == 0
                playerRightPressed = true
            else
                secondRightPressed = true
        if matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
            choose(participantId)
    else if action == MOVE_DOWN
        if not wasHeld and matchState.phase == MATCH
            if participantId == 0
                playerDownPressed = true
            else
                secondDownPressed = true
    else if action == JUMP
        if not wasHeld
            jump(fighter)
    else if action == ATTACK
        if matchState.phase == CHARACTER_MENU
            if participantId == 0
                selectionPanel.placeHovered()
            else
                secondSelectionPanel.placeHovered()
        else
            confirm(participantId)
    else if action == SPECIAL
        if matchState.phase == MATCH
            if not wasHeld
                if participantId == 0
                    playerSpecialPressed = true
                else
                    secondSpecialPressed = true
        else
            back(participantId)
    else if action == GRAB
        attack(fighter, opponent, 5)
    else if action == LEFT_TRIGGER or action == RIGHT_TRIGGER
        if not wasHeld
            if matchState.phase == MATCH
                if participantId == 0
                    playerTechPressed = true
                else
                    secondTechPressed = true
            airDodge(fighter, state.directionX(), state.directionZ())
    else if action == SMASH_LEFT
        if participantId == 0
            playerAttackFacing = -1
        else
            secondAttackFacing = -1
        attack(fighter, opponent, 4)
    else if action == SMASH_RIGHT
        if participantId == 0
            playerAttackFacing = 1
        else
            secondAttackFacing = 1
        attack(fighter, opponent, 4)
    else if action == SMASH_UP
        attack(fighter, opponent, 2)
    else if action == SMASH_DOWN
        attack(fighter, opponent, 3)
    if matchState.phase == MATCH and action >= MOVE_LEFT and action <= MOVE_UP and state.actionHeld(ATTACK)
        if participantId == 0
            playerNormalAttackQueued = true
        else
            secondNormalAttackQueued = true

function onParticipantKeyUp(int participantId)
    let key = BlzGetTriggerPlayerKey()
    let keyCode = GetHandleId(key)
    if key == OSKEY_Y
        matchControls.keyUp(participantId)
        return
    traceParticipant(participantId, "received up " + I2S(keyCode))
    let state = participantId == 0 ? firstKeyState : secondKeyState
    let bindings = participantId == 0 ? playerBindings : secondBindings
    if participantId == 0
        traceInput("up " + I2S(keyCode))
    state.release(keyCode, bindings.bindings)

function onKeyDown()
    if GetTriggerPlayer() == Player(0) and hostHumanPlayer
        onParticipantKeyDown(0)
    else if GetTriggerPlayer() == Player(1) and twoHumanPlayers
        onParticipantKeyDown(1)

function onKeyUp()
    if GetTriggerPlayer() == Player(0) and hostHumanPlayer
        onParticipantKeyUp(0)
    else if GetTriggerPlayer() == Player(1) and twoHumanPlayers
        onParticipantKeyUp(1)

function registerKey(trigger eventTrigger, player participant, oskeytype key, boolean down)
    BlzTriggerRegisterPlayerKeyEvent(eventTrigger, participant, key, 0, down)

function registerDeveloperChord(trigger eventTrigger, oskeytype key)
    BlzTriggerRegisterPlayerKeyEvent(eventTrigger, Player(0), key, 2, true)

function onDeveloperRestart()
    if GetTriggerPlayer() != Player(0) or not hostHumanPlayer or developerRestartRequested
        return
    developerRestartRequested = true
    RestartGame(false)

function onDeveloperTrace()
    if GetTriggerPlayer() != Player(0) or not hostHumanPlayer or inputTraceActive
        return
    startInputTrace()

function setupKeys()
    let downTrigger = CreateTrigger()
    let upTrigger = CreateTrigger()
    let restartTrigger = CreateTrigger()
    let traceTrigger = CreateTrigger()
    registerDeveloperChord(restartTrigger, OSKEY_R)
    registerDeveloperChord(traceTrigger, OSKEY_T)
    TriggerAddAction(restartTrigger, function onDeveloperRestart)
    TriggerAddAction(traceTrigger, function onDeveloperTrace)
    for keyCode = 1 to 255
        let key = ConvertOsKeyType(keyCode)
        if hostHumanPlayer
            registerKey(downTrigger, Player(0), key, true)
            registerKey(upTrigger, Player(0), key, false)
        if twoHumanPlayers
            registerKey(downTrigger, Player(1), key, true)
            registerKey(upTrigger, Player(1), key, false)
    TriggerAddAction(downTrigger, function onKeyDown)
    TriggerAddAction(upTrigger, function onKeyUp)

function secondPlayerLeaves()
    if not twoHumanPlayers
        return
    twoHumanPlayers = false
    matchState.unreadyCharacter(1)
    matchState.setHumanCount(1)
    clearSecondInputs()
    secondBindings.capturing = false
    announce("Player 2 left. The opponent is now controlled by the computer.")

function firstPlayerLeaves()
    clearHeldInputs()
    clearSecondInputs()
    matchState.forfeit(0)

function playAttackAnimation(Fighter fighter)
    if fighter.attackStyle == AERIAL_NEUTRAL_STYLE
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_AERIAL_NEUTRAL_INDEX : RIFLEMAN_AERIAL_NEUTRAL_INDEX)
        return
    if fighter.attackStyle == AERIAL_FORWARD_STYLE
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_AERIAL_FORWARD_INDEX : RIFLEMAN_AERIAL_FORWARD_INDEX)
        return
    if fighter.attackStyle == AERIAL_BACK_STYLE
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_AERIAL_BACK_INDEX : RIFLEMAN_AERIAL_BACK_INDEX)
        return
    if fighter.attackStyle == AERIAL_UP_STYLE
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_AERIAL_UP_INDEX : RIFLEMAN_AERIAL_UP_INDEX)
        return
    if fighter.attackStyle == AERIAL_DOWN_STYLE
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_AERIAL_DOWN_INDEX : RIFLEMAN_AERIAL_DOWN_INDEX)
        return
    if fighter.attackStyle == 0
        SetUnitAnimationByIndex(fighter.body, (fighter.character == 0 ? ARCHER_JAB_INDEX : RIFLEMAN_JAB_INDEX))
        return
    if fighter.attackStyle == 5
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_GRAB_INDEX : RIFLEMAN_GRAB_INDEX)
        return
    if fighter.attackStyle == 6
        SetUnitAnimationByIndex(fighter.body, (fighter.character == 0 ? ARCHER_FORWARD_TILT_INDEX : RIFLEMAN_FORWARD_TILT_INDEX))
        return
    if fighter.attackStyle == 7
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_UP_TILT_INDEX : RIFLEMAN_UP_TILT_INDEX)
        return
    if fighter.attackStyle == 8
        SetUnitAnimationByIndex(fighter.body, fighter.character == 0 ? ARCHER_DOWN_TILT_INDEX : RIFLEMAN_DOWN_TILT_INDEX)
        return
    if fighter.attackStyle == 9
        SetUnitAnimationByIndex(fighter.body, (fighter.character == 0 ? ARCHER_FORWARD_TILT_UP_INDEX : RIFLEMAN_FORWARD_TILT_UP_INDEX))
        return
    if fighter.attackStyle == 10
        SetUnitAnimationByIndex(fighter.body, (fighter.character == 0 ? ARCHER_FORWARD_TILT_DOWN_INDEX : RIFLEMAN_FORWARD_TILT_DOWN_INDEX))
        return
    if fighter.attackStyle == DOWN_ATTACK_STYLE or fighter.attackStyle == LEDGE_ATTACK_STYLE
        SetUnitAnimationByIndex(fighter.body, (fighter.character == 0 ? ARCHER_GET_UP_ATTACK_INDEX : RIFLEMAN_GET_UP_ATTACK_INDEX))
        return
    SetUnitAnimation(fighter.body, "attack")

function aerialAttackName(int style) returns string
    if style == AERIAL_NEUTRAL_STYLE
        return "Neutral air!"
    if style == AERIAL_FORWARD_STYLE
        return "Forward air!"
    if style == AERIAL_BACK_STYLE
        return "Back air!"
    if style == AERIAL_UP_STYLE
        return "Up air!"
    return "Down air!"

function attackAnimationRate(Fighter fighter) returns real
    if attackPhase(fighter) == ATTACK_NONE
        return 1.
    let seconds = fighter.attackDuration * FRAME_SECONDS
    if fighter.attackStyle == AERIAL_NEUTRAL_STYLE
        return (fighter.character == 0 ? ARCHER_AERIAL_NEUTRAL_SECONDS : RIFLEMAN_AERIAL_NEUTRAL_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_FORWARD_STYLE
        return (fighter.character == 0 ? ARCHER_AERIAL_FORWARD_SECONDS : RIFLEMAN_AERIAL_FORWARD_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_BACK_STYLE
        return (fighter.character == 0 ? ARCHER_AERIAL_BACK_SECONDS : RIFLEMAN_AERIAL_BACK_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_UP_STYLE
        return (fighter.character == 0 ? ARCHER_AERIAL_UP_SECONDS : RIFLEMAN_AERIAL_UP_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_DOWN_STYLE
        return (fighter.character == 0 ? ARCHER_AERIAL_DOWN_SECONDS : RIFLEMAN_AERIAL_DOWN_SECONDS) / seconds
    if fighter.attackStyle == 0
        return (fighter.character == 0 ? ARCHER_JAB_SECONDS : RIFLEMAN_JAB_SECONDS) / seconds
    if fighter.attackStyle == 5
        return (fighter.character == 0 ? ARCHER_GRAB_SECONDS : RIFLEMAN_GRAB_SECONDS) / seconds
    if fighter.attackStyle == 6
        return (fighter.character == 0 ? ARCHER_FORWARD_TILT_SECONDS : RIFLEMAN_FORWARD_TILT_SECONDS) / seconds
    if fighter.attackStyle == 7
        return (fighter.character == 0 ? ARCHER_UP_TILT_SECONDS : RIFLEMAN_UP_TILT_SECONDS) / seconds
    if fighter.attackStyle == 8
        return (fighter.character == 0 ? ARCHER_DOWN_TILT_SECONDS : RIFLEMAN_DOWN_TILT_SECONDS) / seconds
    if fighter.attackStyle == 9
        return (fighter.character == 0 ? ARCHER_FORWARD_TILT_UP_SECONDS : RIFLEMAN_FORWARD_TILT_UP_SECONDS) / seconds
    if fighter.attackStyle == 10
        return (fighter.character == 0 ? ARCHER_FORWARD_TILT_DOWN_SECONDS : RIFLEMAN_FORWARD_TILT_DOWN_SECONDS) / seconds
    if fighter.attackStyle == DOWN_ATTACK_STYLE
        return (fighter.character == 0 ? ARCHER_GET_UP_ATTACK_SECONDS : RIFLEMAN_GET_UP_ATTACK_SECONDS) / seconds
    if fighter.attackStyle == LEDGE_ATTACK_STYLE
        return (fighter.character == 0 ? ARCHER_GET_UP_ATTACK_SECONDS : RIFLEMAN_GET_UP_ATTACK_SECONDS) / (LEDGE_ATTACK_FRAMES * FRAME_SECONDS)
    return 1.

function downAnimationIndex(Fighter fighter) returns int
    if fighter.downState == DOWN_DAMAGE
        return fighter.character == 0 ? ARCHER_DOWN_DAMAGE_INDEX : RIFLEMAN_DOWN_DAMAGE_INDEX
    if fighter.downState == DOWN_BOUND or fighter.downState == DOWN_WAIT
        return (fighter.character == 0 ? ARCHER_KNOCKDOWN_INDEX : RIFLEMAN_KNOCKDOWN_INDEX)
    if fighter.downState == DOWN_STAND or fighter.downState == DOWN_TECH
        return (fighter.character == 0 ? ARCHER_GET_UP_INDEX : RIFLEMAN_GET_UP_INDEX)
    return fighter.downDirection == fighter.facing ? (fighter.character == 0 ? ARCHER_ROLL_FORWARD_INDEX : RIFLEMAN_ROLL_FORWARD_INDEX) : (fighter.character == 0 ? ARCHER_ROLL_BACKWARD_INDEX : RIFLEMAN_ROLL_BACKWARD_INDEX)

function downAnimationRate(Fighter fighter) returns real
    if fighter.downState == DOWN_DAMAGE
        return (fighter.character == 0 ? ARCHER_DOWN_DAMAGE_SECONDS : RIFLEMAN_DOWN_DAMAGE_SECONDS) / (DOWN_DAMAGE_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_WAIT
        return 0.
    if fighter.downState == DOWN_BOUND
        return (fighter.character == 0 ? ARCHER_KNOCKDOWN_SECONDS : RIFLEMAN_KNOCKDOWN_SECONDS) / (DOWN_BOUND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_STAND
        return (fighter.character == 0 ? ARCHER_GET_UP_SECONDS : RIFLEMAN_GET_UP_SECONDS) / (DOWN_STAND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_TECH
        return (fighter.character == 0 ? ARCHER_GET_UP_SECONDS : RIFLEMAN_GET_UP_SECONDS) / (TECH_IN_PLACE_FRAMES * FRAME_SECONDS)
    let seconds = fighter.downDirection == fighter.facing ? (fighter.character == 0 ? ARCHER_ROLL_FORWARD_SECONDS : RIFLEMAN_ROLL_FORWARD_SECONDS) : (fighter.character == 0 ? ARCHER_ROLL_BACKWARD_SECONDS : RIFLEMAN_ROLL_BACKWARD_SECONDS)
    return seconds / ((fighter.downState == DOWN_TECH_ROLL ? TECH_ROLL_FRAMES : DOWN_ROLL_FRAMES) * FRAME_SECONDS)

function groundDodgeAnimation(Fighter fighter) returns int
    if fighter.groundDodgeDirection == 0
        return (fighter.character == 0 ? ARCHER_SPOT_DODGE_INDEX : RIFLEMAN_SPOT_DODGE_INDEX)
    return fighter.groundDodgeDirection == fighter.facing ? (fighter.character == 0 ? ARCHER_ROLL_FORWARD_INDEX : RIFLEMAN_ROLL_FORWARD_INDEX) : (fighter.character == 0 ? ARCHER_ROLL_BACKWARD_INDEX : RIFLEMAN_ROLL_BACKWARD_INDEX)

function groundDodgeAnimationSeconds(Fighter fighter) returns real
    if fighter.groundDodgeDirection == 0
        return (fighter.character == 0 ? ARCHER_SPOT_DODGE_SECONDS : RIFLEMAN_SPOT_DODGE_SECONDS)
    return fighter.groundDodgeDirection == fighter.facing ? (fighter.character == 0 ? ARCHER_ROLL_FORWARD_SECONDS : RIFLEMAN_ROLL_FORWARD_SECONDS) : (fighter.character == 0 ? ARCHER_ROLL_BACKWARD_SECONDS : RIFLEMAN_ROLL_BACKWARD_SECONDS)

function specialAnimationIndex(Fighter f) returns int
    if f.specialAction == SPECIAL_ARCHER_ARROW
        return ARCHER_SPECIAL_NEUTRAL_INDEX
    if f.specialAction == SPECIAL_ARCHER_MULTISHOT
        return ARCHER_SPECIAL_SIDE_INDEX
    if f.specialAction == SPECIAL_ARCHER_DISENGAGE
        return ARCHER_SPECIAL_DOWN_INDEX
    if f.specialAction == SPECIAL_ARCHER_RECOVERY
        return ARCHER_SPECIAL_UP_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_BEAR
        return RIFLEMAN_SPECIAL_SIDE_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_TRAP
        return RIFLEMAN_SPECIAL_DOWN_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_RECOVERY
        return RIFLEMAN_SPECIAL_UP_INDEX
    if f.specialDuration == attackDurationFramesForGrounding(1, false)
        return RIFLEMAN_SPECIAL_NEUTRAL_AIR_INDEX
    return RIFLEMAN_SPECIAL_NEUTRAL_INDEX

function specialAnimationSeconds(Fighter f) returns real
    if f.specialAction == SPECIAL_ARCHER_ARROW
        return ARCHER_SPECIAL_NEUTRAL_SECONDS
    if f.specialAction == SPECIAL_ARCHER_MULTISHOT
        return ARCHER_SPECIAL_SIDE_SECONDS
    if f.specialAction == SPECIAL_ARCHER_DISENGAGE
        return ARCHER_SPECIAL_DOWN_SECONDS
    if f.specialAction == SPECIAL_ARCHER_RECOVERY
        return ARCHER_SPECIAL_UP_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_BEAR
        return RIFLEMAN_SPECIAL_SIDE_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_TRAP
        return RIFLEMAN_SPECIAL_DOWN_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_RECOVERY
        return RIFLEMAN_SPECIAL_UP_SECONDS
    if f.specialDuration == attackDurationFramesForGrounding(1, false)
        return RIFLEMAN_SPECIAL_NEUTRAL_AIR_SECONDS
    return RIFLEMAN_SPECIAL_NEUTRAL_SECONDS

function damageAnimationIndex(Fighter f, int pose) returns int
    if pose == DAMAGE_POSE_GROUND
        return f.character == 0 ? ARCHER_DAMAGE_GROUND_INDEX : RIFLEMAN_DAMAGE_GROUND_INDEX
    if pose == DAMAGE_POSE_TUMBLE
        return f.character == 0 ? ARCHER_DAMAGE_TUMBLE_INDEX : RIFLEMAN_DAMAGE_TUMBLE_INDEX
    if pose == DAMAGE_POSE_SHIELD
        return f.character == 0 ? ARCHER_DAMAGE_SHIELD_INDEX : RIFLEMAN_DAMAGE_SHIELD_INDEX
    return f.character == 0 ? ARCHER_DAMAGE_AIR_INDEX : RIFLEMAN_DAMAGE_AIR_INDEX

function damageAnimationSeconds(Fighter f, int pose) returns real
    if pose == DAMAGE_POSE_GROUND
        return f.character == 0 ? ARCHER_DAMAGE_GROUND_SECONDS : RIFLEMAN_DAMAGE_GROUND_SECONDS
    if pose == DAMAGE_POSE_TUMBLE
        return f.character == 0 ? ARCHER_DAMAGE_TUMBLE_SECONDS : RIFLEMAN_DAMAGE_TUMBLE_SECONDS
    if pose == DAMAGE_POSE_SHIELD
        return f.character == 0 ? ARCHER_DAMAGE_SHIELD_SECONDS : RIFLEMAN_DAMAGE_SHIELD_SECONDS
    return f.character == 0 ? ARCHER_DAMAGE_AIR_SECONDS : RIFLEMAN_DAMAGE_AIR_SECONDS

function grabAnimationIndex(int character, int action, boolean victim) returns int
    if action == GRAB_PUMMEL
        if victim
            return character == 0 ? ARCHER_VICTIM_PUMMEL_INDEX : RIFLEMAN_VICTIM_PUMMEL_INDEX
        return character == 0 ? ARCHER_PUMMEL_INDEX : RIFLEMAN_PUMMEL_INDEX
    if action == THROW_FORWARD
        if victim
            return character == 0 ? ARCHER_VICTIM_THROW_FORWARD_INDEX : RIFLEMAN_VICTIM_THROW_FORWARD_INDEX
        return character == 0 ? ARCHER_THROW_FORWARD_INDEX : RIFLEMAN_THROW_FORWARD_INDEX
    if action == THROW_BACK
        if victim
            return character == 0 ? ARCHER_VICTIM_THROW_BACK_INDEX : RIFLEMAN_VICTIM_THROW_BACK_INDEX
        return character == 0 ? ARCHER_THROW_BACK_INDEX : RIFLEMAN_THROW_BACK_INDEX
    if action == THROW_UP
        if victim
            return character == 0 ? ARCHER_VICTIM_THROW_UP_INDEX : RIFLEMAN_VICTIM_THROW_UP_INDEX
        return character == 0 ? ARCHER_THROW_UP_INDEX : RIFLEMAN_THROW_UP_INDEX
    if action == THROW_DOWN
        if victim
            return character == 0 ? ARCHER_VICTIM_THROW_DOWN_INDEX : RIFLEMAN_VICTIM_THROW_DOWN_INDEX
        return character == 0 ? ARCHER_THROW_DOWN_INDEX : RIFLEMAN_THROW_DOWN_INDEX
    return character == 0 ? (victim ? ARCHER_GRABBED_INDEX : ARCHER_GRAB_HOLD_INDEX) : (victim ? RIFLEMAN_GRABBED_INDEX : RIFLEMAN_GRAB_HOLD_INDEX)

function grabAnimationSeconds(int character, int action) returns real
    if action == GRAB_PUMMEL
        return character == 0 ? ARCHER_PUMMEL_SECONDS : RIFLEMAN_PUMMEL_SECONDS
    if action == THROW_FORWARD
        return character == 0 ? ARCHER_THROW_FORWARD_SECONDS : RIFLEMAN_THROW_FORWARD_SECONDS
    if action == THROW_BACK
        return character == 0 ? ARCHER_THROW_BACK_SECONDS : RIFLEMAN_THROW_BACK_SECONDS
    if action == THROW_UP
        return character == 0 ? ARCHER_THROW_UP_SECONDS : RIFLEMAN_THROW_UP_SECONDS
    if action == THROW_DOWN
        return character == 0 ? ARCHER_THROW_DOWN_SECONDS : RIFLEMAN_THROW_DOWN_SECONDS
    return 0.

function renderFighter(Fighter f, boolean wasOut, boolean jumped, boolean hit)
    f.renderShield()
    f.renderDizzy()
    if wasOut and not f.out
        ShowUnit(f.body, true)
    else if not wasOut and f.out
        loseStock(f)
    if f.out
        return
    f.place()
    if f.frozenFrames > 0
        SetUnitTimeScale(f.body, 0.)
        SetUnitVertexColor(f.body, 155, 210, 255, 255)
        return
    if f.grounded or f.hitstun > 0 or f.airDodging or attackPhase(f) != ATTACK_NONE or f.specialAction != SPECIAL_NONE or f.downState != DOWN_NONE or f.shieldBreakState != SHIELD_BREAK_NONE or f.ledgeState != LEDGE_NONE
        f.jumpAnimationRemaining = 0
    else if jumped and not wasOut
        f.doubleJumpAnimation = f.jumpIsDouble
        f.jumpAnimationRemaining = f.doubleJumpAnimation ? 30 : 24
        f.animation = ""
    else if f.jumpAnimationRemaining > 0 and f.hitlag <= 0
        f.jumpAnimationRemaining--
    let reaction = damagePose(f)
    var animationRate = attackAnimationRate(f)
    if f.ledgeState == LEDGE_CLIMB
        animationRate = (f.character == 0 ? ARCHER_LEDGE_CLIMB_SECONDS : RIFLEMAN_LEDGE_CLIMB_SECONDS) / (LEDGE_CLIMB_FRAMES * FRAME_SECONDS)
    else if f.ledgeState == LEDGE_ROLL
        animationRate = (f.character == 0 ? ARCHER_ROLL_FORWARD_SECONDS : RIFLEMAN_ROLL_FORWARD_SECONDS) / (LEDGE_ROLL_FRAMES * FRAME_SECONDS)
    else if f.ledgeState == LEDGE_ATTACK
        animationRate = (f.character == 0 ? ARCHER_GET_UP_ATTACK_SECONDS : RIFLEMAN_GET_UP_ATTACK_SECONDS) / (LEDGE_ATTACK_FRAMES * FRAME_SECONDS)
    else if f.shieldBreakState == SHIELD_BREAK_LAND
        animationRate = (f.character == 0 ? ARCHER_KNOCKDOWN_SECONDS : RIFLEMAN_KNOCKDOWN_SECONDS) / (SHIELD_BREAK_LAND_FRAMES * FRAME_SECONDS)
    else if f.shieldBreakState == SHIELD_BREAK_STAND
        animationRate = (f.character == 0 ? ARCHER_GET_UP_SECONDS : RIFLEMAN_GET_UP_SECONDS) / (SHIELD_BREAK_STAND_FRAMES * FRAME_SECONDS)
    else if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
        animationRate = downAnimationRate(f)
    else if reaction != DAMAGE_POSE_NONE
        animationRate = damageAnimationSeconds(f, reaction) / (24 * FRAME_SECONDS)
    else if f.specialFall
        animationRate = 0.
    else if isGroundDodging(f)
        let duration = f.groundDodgeDirection == 0 ? SPOT_DODGE_FRAMES : GROUND_ROLL_FRAMES
        animationRate = groundDodgeAnimationSeconds(f) / (duration * FRAME_SECONDS)
    else if f.specialAction != SPECIAL_NONE and f.hitstun == 0
        animationRate = specialAnimationSeconds(f) / (f.specialDuration * FRAME_SECONDS)
    else if f.jumpAnimationRemaining > 0
        animationRate = f.doubleJumpAnimation ? (f.character == 0 ? ARCHER_DOUBLE_JUMP_SECONDS : RIFLEMAN_DOUBLE_JUMP_SECONDS) / (30 * FRAME_SECONDS) : (f.character == 0 ? ARCHER_JUMP_SECONDS : RIFLEMAN_JUMP_SECONDS) / (24 * FRAME_SECONDS)
    SetUnitVertexColor(f.body, f.shield ? 100 : 255, f.shield ? 160 : 255, 255, isIntangible(f) ? 140 : 255)
    if inGrabContext(f)
        let victim = f.grabOwner != null
        let owner = victim ? f.grabOwner : f
        let action = owner.grabAction
        let anim = "grab" + I2S(action) + ":" + I2S(owner.grabSerial) + (victim ? ":victim" : ":holder")
        if f.animation != anim
            if action == GRAB_ESCAPE
                SetUnitAnimation(f.body, "stand ready")
            else
                SetUnitAnimationByIndex(f.body, grabAnimationIndex(f.character, action, victim))
            f.animation = anim
        animationRate = action >= GRAB_PUMMEL and action <= THROW_DOWN ? grabAnimationSeconds(f.character, action) / (grabActionDuration(action) * FRAME_SECONDS) : 0
    else if f.ledgeState != LEDGE_NONE
        let anim = "ledge" + I2S(f.ledgeState)
        if f.animation != anim
            if f.ledgeState == LEDGE_CLIMB
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_LEDGE_CLIMB_INDEX : RIFLEMAN_LEDGE_CLIMB_INDEX)
            else if f.ledgeState == LEDGE_ROLL
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_ROLL_FORWARD_INDEX : RIFLEMAN_ROLL_FORWARD_INDEX)
            else if f.ledgeState == LEDGE_ATTACK
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_GET_UP_ATTACK_INDEX : RIFLEMAN_GET_UP_ATTACK_INDEX)
            else
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_LEDGE_HANG_INDEX : RIFLEMAN_LEDGE_HANG_INDEX)
            f.animation = anim
    else if f.shieldBreakState != SHIELD_BREAK_NONE
        let anim = "shieldbreak" + I2S(f.shieldBreakState)
        if f.animation != anim
            if f.shieldBreakState == SHIELD_BREAK_LAND
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_KNOCKDOWN_INDEX : RIFLEMAN_KNOCKDOWN_INDEX)
            else if f.shieldBreakState == SHIELD_BREAK_STAND
                SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_GET_UP_INDEX : RIFLEMAN_GET_UP_INDEX)
            else
                SetUnitAnimation(f.body, "stand hit")
            f.animation = anim
    else if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
        let anim = "down" + I2S(f.downState)
        if f.animation != anim or (f.downState == DOWN_DAMAGE and hit)
            if f.downState != DOWN_WAIT
                SetUnitAnimationByIndex(f.body, downAnimationIndex(f))
            f.animation = anim
    else if reaction != DAMAGE_POSE_NONE
        let anim = "damage" + I2S(reaction)
        if hit or f.animation != anim
            SetUnitAnimationByIndex(f.body, damageAnimationIndex(f, reaction))
            f.animation = anim
            traceParticipant(f == playerFighter ? 0 : 1, "damage pose " + I2S(reaction) + " hitlag " + I2S(f.hitlag) + " hitstun " + I2S(f.hitstun))
    else if f.specialFall
        if f.animation != "specialfall"
            SetUnitAnimationByIndex(f.body, f.character == 0 ? ARCHER_FALL_SPECIAL_INDEX : RIFLEMAN_FALL_SPECIAL_INDEX)
            f.animation = "specialfall"
    else if isGroundDodging(f)
        if f.animation != "dodge"
            SetUnitAnimationByIndex(f.body, groundDodgeAnimation(f))
            f.animation = "dodge"
    else if f.specialAction != SPECIAL_NONE and f.hitstun == 0
        let anim = "special" + I2S(f.specialAction)
        if f.animation != anim
            SetUnitAnimationByIndex(f.body, specialAnimationIndex(f))
            f.animation = anim
    else if f.jumpAnimationRemaining > 0
        if f.animation != "jump"
            SetUnitAnimationByIndex(f.body, f.doubleJumpAnimation ? (f.character == 0 ? ARCHER_DOUBLE_JUMP_INDEX : RIFLEMAN_DOUBLE_JUMP_INDEX) : (f.character == 0 ? ARCHER_JUMP_INDEX : RIFLEMAN_JUMP_INDEX))
            f.animation = "jump"
    else if attackPhase(f) == ATTACK_NONE and f.hitstun == 0 and f.hitlag == 0
        let anim = f.grounded and totalVelocityX(f).abs() > 0.1 ? "walk" : "stand"
        if anim == "walk"
            animationRate = min(1.4, max(0.2, f.vx.abs() / characterSpeed(f.character)))
        if f.animation != anim
            SetUnitAnimation(f.body, anim)
            f.animation = anim
    else
        if f.animation == "grab-hold" or f.animation == "grabbed"
            SetUnitAnimation(f.body, "stand ready")
        f.animation = ""
    // Select the victim's reaction first; retain the attacker's contact pose.
    // On release only the playback rate changes, so the held clip resumes.
    SetUnitTimeScale(f.body, f.hitlag > 0 or f.smashCharging ? 0 : animationRate)

function pauseMatchPresentation(boolean paused)
    if playerFighter != null
        if paused
            SetUnitTimeScale(playerFighter.body, 0.)
        else if not playerFighter.out
            let jumpAnimationRemaining = playerFighter.jumpAnimationRemaining
            renderFighter(playerFighter, false, false, false)
            playerFighter.jumpAnimationRemaining = jumpAnimationRemaining
    if botFighter != null
        if paused
            SetUnitTimeScale(botFighter.body, 0.)
        else if not botFighter.out
            let jumpAnimationRemaining = botFighter.jumpAnimationRemaining
            renderFighter(botFighter, false, false, false)
            botFighter.jumpAnimationRemaining = jumpAnimationRemaining
    if combatEffects != null
        combatEffects.setPaused(paused)
    if specialEffects != null
        specialEffects.setPaused(paused)
    for i = 0 to projectileModelCount - 1
        if projectileModels[i] != null
            BlzSetSpecialEffectTimeScale(projectileModels[i], paused ? 0. : 1.)

function renderUI()
    let selecting = matchState.phase == CHARACTER_MENU or matchState.phase == STAGE_MENU
    let localSlot = GetLocalPlayer() == Player(1) and twoHumanPlayers ? 1 : 0
    let localFighter = localSlot == 0 ? playerFighter : botFighter
    let controls = localSlot == 0 ? settingsPanel : secondSettingsPanel
    let controlsOpen = controls != null and controls.isOpen()
    if GetLocalPlayer() == Player(localSlot)
        BlzFrameSetVisible(titleFrame, false)
        BlzFrameSetVisible(menuFrame, false)
        firstHUD.update(not selecting and not controlsOpen, playerFighter.character, playerFighter.damage, playerFighter.stocks)
        secondHUD.update(not selecting and not controlsOpen, botFighter.character, botFighter.damage, botFighter.stocks)
        matchClock.update(not selecting and not controlsOpen and matchState.timeLimitMinutes > 0, matchState.remainingSeconds())
        BlzFrameSetVisible(helpFrame, not selecting and not controlsOpen)
        BlzFrameSetVisible(noticeFrame, not selecting and not controlsOpen)
        BlzFrameSetVisible(developerFrame, not selecting and not controlsOpen)
        if not selecting
            BlzFrameSetText(helpFrame, matchState.phase == RESULT ? (matchState.firstRematchReady and twoHumanPlayers ? "Player 1 ready; waiting for Player 2. Press Y to choose the next match." : (matchState.secondRematchReady and twoHumanPlayers ? "Player 2 ready; waiting for Player 1. Press Y to choose the next match." : "Press Y to choose your next match.")) : (matchControls.isPaused() ? "PAUSED — Press Y to resume. Combat is frozen." : "Y: pause. Tap Shield before a hard landing to tech; hold Left/Right for a tech roll.\nHold Shield on the ground, then tap Left/Right to roll or Down to dodge."))
            if matchState.phase == MATCH and not matchControls.isPaused() and localFighter.downState == DOWN_WAIT
                BlzFrameSetText(helpFrame, "Knocked down: Attack/Special to strike, Up/Jump/Shield to stand, Left/Right to roll.")
            else if matchState.phase == MATCH and not matchControls.isPaused() and localFighter.ledgeState == LEDGE_HANG
                BlzFrameSetText(helpFrame, "Ledge: Up or toward stage to climb; Jump to leap; Shield to roll; Attack to strike.\nDown or away from stage lets go.")
            BlzFrameSetText(noticeFrame, playerFighter != null and playerFighter.smashCharging ? "Charging smash: release Attack to strike." : (statusTime > 0 ? statusText : ""))
    selectionPanel.update(matchState.phase, matchState.characterFor(0),
        settingsPanel != null and settingsPanel.isOpen(), true, matchState.characterReady(0),
        matchState.characterFor(1), twoHumanPlayers, matchState.characterReady(1))
    secondSelectionPanel.update(matchState.phase, matchState.characterFor(1),
        secondSettingsPanel != null and secondSettingsPanel.isOpen(), twoHumanPlayers, matchState.characterReady(1),
        matchState.characterFor(0), true, matchState.characterReady(0))
    stagePanel.update(matchState)
    if settingsPanel != null
        settingsPanel.update()
    if secondSettingsPanel != null
        secondSettingsPanel.update()
    if GetLocalPlayer() == Player(0) and playerFighter != null
        BlzFrameSetText(developerFrame, "Developer test: " + BUILD_ID + " | phase=" + I2S(matchState.phase) + " | x=" + I2S(R2I(playerFighter.x)) + " z=" + I2S(R2I(playerFighter.z)) + " | input=" + I2S(lastInputAction) + " normal=" + I2S(lastNormalStyle) + " move=" + I2S(playerFighter.attackStyle) + " frame=" + I2S(playerFighter.attackFrame) + " serial=" + I2S(playerFighter.attackSerial) + " down=" + I2S(playerFighter.downState) + ":" + I2S(playerFighter.downFrame) + " DI=" + I2S(playerFighter.diSerial) + ":" + I2S(R2I(playerFighter.diAngleDegrees)) + " S=" + I2S(playerFighter.sdiSerial) + " A=" + I2S(playerFighter.asdiSerial) + " | Ctrl+R restart")

function lockArenaCamera()
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1450, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1960, 0)
    SetCameraField(CAMERA_FIELD_ROLL, 0, 0)
    SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW, 70, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(centerX, centerY)

function gameTick()
    if inputTraceActive
        inputTraceTicks++
        let axes = firstKeyState.directionX() + 3 * firstKeyState.directionZ()
        if axes != inputTraceLastAxes or firstKeyState.pulsePending() or inputTraceTicks % 60 == 0
            traceInput("sample " + I2S(axes) + " pulse " + (firstKeyState.pulsePending() ? I2S(firstKeyState.pulseX()) + ":" + I2S(firstKeyState.pulseZ()) : "none") + " hitlag " + I2S(playerFighter.hitlag))
            inputTraceLastAxes = axes
        if inputTraceLastDodge != playerFighter.airDodgeFrame or inputTraceLastLandingLag != playerFighter.landingLag
            traceInput("motion air " + I2S(playerFighter.airDodgeFrame) + " landing " + I2S(playerFighter.landingLag) + " x " + R2S(playerFighter.x) + " z " + R2S(playerFighter.z))
            inputTraceLastDodge = playerFighter.airDodgeFrame
            inputTraceLastLandingLag = playerFighter.landingLag
        if inputTraceTicks >= (SHIELD_BREAK_SCENARIO or LEDGE_SCENARIO ? 600 : 300)
            finishInputTrace()
    if appliedBindingRevision != playerBindings.revision
        clearHeldInputs()
        appliedBindingRevision = playerBindings.revision
    if appliedSecondBindingRevision != secondBindings.revision
        clearSecondInputs()
        appliedSecondBindingRevision = secondBindings.revision
    if not matchControls.isPaused()
        combatEffects.tick()
    lockArenaCamera()
    statusTime = max(0, statusTime - FRAME_SECONDS)
    if matchState.phase == MATCH and not matchControls.isPaused()
        let frame = replayRuntime.simulationFrame + 1
        let direction = firstKeyState.consumeMovementX()
        let verticalDirection = firstKeyState.consumeMovementZ()
        if playerNormalAttackQueued
            let style = normalAttackStyle(direction, verticalDirection, firstKeyState.actionHeld(WALK_MODIFIER), playerFighter.grounded and (playerFighter.shield or firstKeyState.actionHeld(LEFT_TRIGGER) or firstKeyState.actionHeld(RIGHT_TRIGGER)))
            lastNormalStyle = style
            playerAttackRequests.enqueue(style, direction, frame, true)
        botInput.direction = 0
        botInput.jumpPressed = botJumpQueued
        botInput.jumpHeld = botJumpHeld
        botInput.specialPressed = false
        botInput.verticalDirection = 0
        botInput.ledgeVerticalPressed = 0
        if not twoHumanPlayers and not KNOCKDOWN_SCENARIO and not SHIELD_BREAK_SCENARIO and not LEDGE_SCENARIO and not botFighter.out
            let recovering = chooseRecoveryInput(botFighter, matchState.stageChoice, botInput)
            let gap = playerFighter.x - botFighter.x
            if not recovering and not playerFighter.out
                let chaseX = min(surfaceRight(matchState.stageChoice, 0) - 40, max(surfaceLeft(matchState.stageChoice, 0) + 40, playerFighter.x))
                if (chaseX - botFighter.x).abs() > 95
                    botInput.direction = chaseX > botFighter.x ? 1 : -1
                if botFighter.grounded and playerFighter.z > botFighter.z + 130
                    botInput.jumpPressed = true
                    botInput.jumpHeld = true
            replayRuntime.botAttackDelay -= FRAME_SECONDS
            if not recovering and not playerFighter.out and gap.abs() < 135 and replayRuntime.botAttackDelay <= 0
                secondAttackRequests.enqueue(0, playerFighter.x >= botFighter.x ? 1 : -1, frame, false)
                replayRuntime.botAttackDelay = 0.35
        playerInput.direction = direction
        playerInput.verticalDirection = verticalDirection
        playerInput.sdiPulse = firstKeyState.pulsePending()
        playerInput.sdiX = firstKeyState.pulseX()
        playerInput.sdiZ = firstKeyState.pulseZ()
        playerInput.cStickX = (actionHeld(SMASH_RIGHT) ? 1 : 0) - (actionHeld(SMASH_LEFT) ? 1 : 0)
        playerInput.cStickZ = (actionHeld(SMASH_UP) ? 1 : 0) - (actionHeld(SMASH_DOWN) ? 1 : 0)
        playerInput.attackHeld = actionHeld(ATTACK)
        playerInput.techPressed = playerTechPressed
        playerInput.lCancelPressed = playerLCancelPressed
        playerInput.mashPressed = playerMashPressed
        playerInput.grabMashPressed = playerGrabMashPressed
        playerInput.attackPressed = playerAttackPressed
        playerInput.grabThrowX = playerThrowX > 0 ? 1 : (playerThrowX < 0 ? -1 : 0)
        playerInput.grabThrowZ = playerThrowZ > 0 ? 1 : (playerThrowZ < 0 ? -1 : 0)
        playerInput.ledgeVerticalPressed = playerLedgeVerticalPressed
        playerInput.getupAttackPressed = playerGetupAttackPressed
        playerInput.specialPressed = playerSpecialPressed
        playerInput.getupStandPressed = playerGetupStandPressed
        playerInput.getupDirection = (playerRightPressed ? 1 : 0) - (playerLeftPressed ? 1 : 0)
        playerInput.getupDirectionPressed = playerInput.getupDirection != 0
        playerInput.walking = firstKeyState.actionHeld(WALK_MODIFIER)
        playerInput.down = firstKeyState.actionHeld(MOVE_DOWN)
        playerInput.shield = firstKeyState.actionHeld(LEFT_TRIGGER) or firstKeyState.actionHeld(RIGHT_TRIGGER)
        let groundDodge = groundDodgeIntent(playerInput.shield, playerLeftPressed, playerRightPressed, playerDownPressed)
        playerInput.groundDodgePressed = groundDodge != NO_GROUND_DODGE
        playerInput.groundDodgeDirection = groundDodge == NO_GROUND_DODGE ? 0 : groundDodge
        playerInput.jumpPressed = playerJumpQueued
        playerInput.jumpHeld = firstKeyState.actionHeld(JUMP)
        playerInput.airDodgePressed = playerAirDodgeQueued
        playerInput.dodgeX = playerDodgeX
        playerInput.dodgeZ = playerDodgeZ
        playerInput.attackHeld = actionHeld(ATTACK)
        secondPlayerInput.direction = secondKeyState.consumeMovementX()
        secondPlayerInput.verticalDirection = secondKeyState.consumeMovementZ()
        secondPlayerInput.sdiPulse = secondKeyState.pulsePending()
        secondPlayerInput.sdiX = secondKeyState.pulseX()
        secondPlayerInput.sdiZ = secondKeyState.pulseZ()
        secondPlayerInput.cStickX = (secondKeyState.actionHeld(SMASH_RIGHT) ? 1 : 0) - (secondKeyState.actionHeld(SMASH_LEFT) ? 1 : 0)
        secondPlayerInput.cStickZ = (secondKeyState.actionHeld(SMASH_UP) ? 1 : 0) - (secondKeyState.actionHeld(SMASH_DOWN) ? 1 : 0)
        secondPlayerInput.attackHeld = secondKeyState.actionHeld(ATTACK)
        secondPlayerInput.techPressed = secondTechPressed
        secondPlayerInput.lCancelPressed = secondLCancelPressed
        secondPlayerInput.mashPressed = secondMashPressed
        secondPlayerInput.grabMashPressed = secondGrabMashPressed
        secondPlayerInput.attackPressed = secondAttackPressed
        secondPlayerInput.grabThrowX = secondThrowX > 0 ? 1 : (secondThrowX < 0 ? -1 : 0)
        secondPlayerInput.grabThrowZ = secondThrowZ > 0 ? 1 : (secondThrowZ < 0 ? -1 : 0)
        secondPlayerInput.ledgeVerticalPressed = secondLedgeVerticalPressed
        secondPlayerInput.getupAttackPressed = secondGetupAttackPressed
        secondPlayerInput.specialPressed = secondSpecialPressed
        secondPlayerInput.getupStandPressed = secondGetupStandPressed
        secondPlayerInput.getupDirection = (secondRightPressed ? 1 : 0) - (secondLeftPressed ? 1 : 0)
        secondPlayerInput.getupDirectionPressed = secondPlayerInput.getupDirection != 0
        secondPlayerInput.walking = secondKeyState.actionHeld(WALK_MODIFIER)
        secondPlayerInput.down = secondKeyState.actionHeld(MOVE_DOWN)
        secondPlayerInput.shield = secondKeyState.actionHeld(LEFT_TRIGGER) or secondKeyState.actionHeld(RIGHT_TRIGGER)
        let secondGroundDodge = groundDodgeIntent(secondPlayerInput.shield, secondLeftPressed, secondRightPressed, secondDownPressed)
        secondPlayerInput.groundDodgePressed = secondGroundDodge != NO_GROUND_DODGE
        secondPlayerInput.groundDodgeDirection = secondGroundDodge == NO_GROUND_DODGE ? 0 : secondGroundDodge
        secondPlayerInput.jumpPressed = secondJumpQueued
        secondPlayerInput.jumpHeld = secondKeyState.actionHeld(JUMP)
        secondPlayerInput.airDodgePressed = secondAirDodgeQueued
        secondPlayerInput.dodgeX = secondDodgeX
        secondPlayerInput.dodgeZ = secondDodgeZ
        if twoHumanPlayers and secondNormalAttackQueued
            let style = normalAttackStyle(secondPlayerInput.direction, secondPlayerInput.verticalDirection, secondPlayerInput.walking, botFighter.grounded and (botFighter.shield or secondPlayerInput.shield))
            secondAttackRequests.enqueue(style, secondPlayerInput.direction, frame, true)
        if currentFrameInput.capture(frame,
                playerInput, twoHumanPlayers ? secondPlayerInput : botInput,
                playerAttackRequests, secondAttackRequests, replayRuntime)
            traceFrameInput(0, playerInput, playerAttackRequests, frame)
            traceFrameInput(1, twoHumanPlayers ? secondPlayerInput : botInput, secondAttackRequests, frame)
            playerAttackRequests.clear()
            secondAttackRequests.clear()
            applyFrame()
        playerMashPressed = false
        playerGrabMashPressed = false
        playerAttackPressed = false
        playerThrowX = 0
        playerThrowZ = 0
        secondMashPressed = false
        secondGrabMashPressed = false
        secondAttackPressed = false
        secondThrowX = 0
        secondThrowZ = 0
        playerLedgeVerticalPressed = 0
        secondLedgeVerticalPressed = 0
        playerAttackFacing = 0
        playerNormalAttackQueued = false
        playerLeftPressed = false
        playerRightPressed = false
        playerDownPressed = false
        playerSpecialPressed = false
        playerGetupAttackPressed = false
        playerGetupStandPressed = false
        playerTechPressed = false
        playerLCancelPressed = false
        playerJumpQueued = false
        playerInput.jumpPressed = false
        playerAirDodgeQueued = false
        playerDodgeX = 0
        playerDodgeZ = 0
        botJumpQueued = false
        botJumpHeld = false
        botInput.jumpPressed = false
        secondAttackFacing = 0
        secondNormalAttackQueued = false
        secondLeftPressed = false
        secondRightPressed = false
        secondDownPressed = false
        secondSpecialPressed = false
        secondGetupAttackPressed = false
        secondGetupStandPressed = false
        secondTechPressed = false
        secondLCancelPressed = false
        secondJumpQueued = false
        secondAirDodgeQueued = false
        secondDodgeX = 0
        secondDodgeZ = 0
        secondKeyState.clearPulse()
        if matchState.phase == RESULT
            statusText = matchState.winner == 0 ? "Player 1 wins!" : (matchState.winner == 1 ? (twoHumanPlayers ? "Player 2 wins!" : "Computer wins!") : (matchState.timedOut ? "Time! Draw." : "Draw! Both fighters are out."))
            statusTime = 3600
    if matchState.phase != MATCH
        clearHeldInputs()
        clearSecondInputs()
    else
        firstKeyState.clearPulse()
        secondKeyState.clearPulse()
    renderUI()
    if not readyMarkerWritten and playerBindings.ready
        readyMarkerWritten = true
        PreloadGenClear()
        PreloadGenStart()
        Preload("BUILD " + BUILD_ID)
        Preload("SCENARIO " + (LEDGE_SCENARIO ? "ledge" : (SHIELD_BREAK_SCENARIO ? "shield-break" : (TECH_SCENARIO ? "tech" : (KNOCKDOWN_SCENARIO ? "knockdown" : "normal")))))
        Preload("BINDINGS " + playerBindings.bindings.encode())
        Preload("BINDINGS1 " + (twoHumanPlayers ? secondBindings.bindings.encode() : "BOT"))
        PreloadGenEnd("wc3-melee-ready.txt")

function initGame()
    DestroyTimer(GetExpiredTimer())
    hostHumanPlayer = GetPlayerController(Player(0)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(0)) == PLAYER_SLOT_STATE_PLAYING
    twoHumanPlayers = hostHumanPlayer and GetPlayerController(Player(1)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(1)) == PLAYER_SLOT_STATE_PLAYING
    matchState.setHumanCount(twoHumanPlayers ? 2 : 1)
    playerInput = new InputSnapshot()
    botInput = new InputSnapshot()
    secondPlayerInput = new InputSnapshot()
    let center = GetRectCenter(GetPlayableMapRect())
    centerX = GetLocationX(center)
    centerY = GetLocationY(center)
    floorHeight = GetLocationZ(center) + 1800
    RemoveLocation(center)
    BlzHideOriginFrames(true)
    if not loadTOCFile("war3mapImported\\SmashcraftHUD.toc")
        print("Developer: failed to load Smashcraft HUD definitions")
    BlzEnableSelections(false, false)
    EnableUserControl(true)
    FogEnable(false)
    FogMaskEnable(false)
    titleFrame = frameText("MeleeTitle", 0.06, 0.56, 0.68, 0.04, 0.023)
    menuFrame = frameText("MeleeMenu", 0.06, 0.505, 0.68, 0.19, 0.017)
    firstHUD = new FighterHUD(0, 2)
    secondHUD = new FighterHUD(1, 2)
    matchClock = new MatchClock()
    helpFrame = frameText("MeleeHelp", 0.06, 0.54, 0.58, 0.055, 0.010)
    noticeFrame = frameText("MeleeNotice", 0.26, 0.47, 0.42, 0.07, 0.019)
    developerFrame = frameText("MeleeDeveloper", 0.06, 0.012, 0.72, 0.01, 0.007)
    stagePanel = new StagePanel(new MeleeStageActions())
    selectionPanel = new SelectionPanel(new MeleeSelectionActions(), 0)
    settingsPanel = new SettingsPanel(playerBindings, new MeleeSettingsActions(0), 0)
    secondSelectionPanel = new SelectionPanel(new MeleeSelectionActions(), 1)
    secondSettingsPanel = new SettingsPanel(secondBindings, new MeleeSettingsActions(1), 1)
    drawStage()
    // Native camera hotkeys run before synchronized key callbacks. Constrain
    // their target so Space cannot pan away between simulation ticks.
    SetCameraBounds(centerX, centerY, centerX, centerY, centerX, centerY, centerX, centerY)
    lockArenaCamera()
    CameraSetSmoothingFactor(0)
    SetTimeOfDay(12)
    SetTimeOfDayScale(0)
    SetSkyModel("Environment\\Sky\\LordaeronSummerSky\\LordaeronSummerSky.mdl")
    PanCameraToTimed(centerX, centerY, 0)
    combatEffects = new CombatEffects(centerX, centerY, floorHeight)
    frostEffects = new FrostEffects(centerX, centerY, floorHeight)
    specialEffects = new SpecialEffects(centerX, centerY, floorHeight)
    makePreview()
    renderUI()
    setupKeys()
    playerBindings.initialize()
    if twoHumanPlayers
        secondBindings.initialize()
    else
        secondBindings.bindings.preset(false)
        secondBindings.ready = true
        secondBindings.revision++
    let leaveTrigger = CreateTrigger()
    TriggerRegisterPlayerEvent(leaveTrigger, Player(1), EVENT_PLAYER_LEAVE)
    TriggerAddAction(leaveTrigger, function secondPlayerLeaves)
    let hostLeaveTrigger = CreateTrigger()
    TriggerRegisterPlayerEvent(hostLeaveTrigger, Player(0), EVENT_PLAYER_LEAVE)
    TriggerAddAction(hostLeaveTrigger, function firstPlayerLeaves)
    gameTimer = CreateTimer()
    TimerStart(gameTimer, FRAME_SECONDS, true, function gameTick)

init
    // Custom frame creation and font setup require the running game UI.
    TimerStart(CreateTimer(), 0., false, function initGame)
