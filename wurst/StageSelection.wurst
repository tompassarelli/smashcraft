package StageSelection

public function stageTileLeft(int choice) returns real
    return choice == 0 ? 0.454 : 0.612

public function stageTileAt(real x, real y) returns int
    if y < 0.298 or y > 0.416
        return -1
    if x >= 0.454 and x <= 0.596
        return 0
    if x >= 0.612 and x <= 0.754
        return 1
    return -1

// Cursor state stays local; only a completed choice crosses the sync event.
public class StageDrag
    boolean active = false
    boolean wasDown = false
    int pressedTile = -1

    function update(boolean enabled, boolean down, real x, real y, int choice) returns int
        var dropped = -1
        if not enabled
            active = false
            pressedTile = -1
        else if down and not wasDown
            let dx = x - (stageTileLeft(choice) + 0.071)
            let dy = y - 0.357
            active = dx * dx + dy * dy <= 0.0004
            pressedTile = active ? -1 : stageTileAt(x, y)
        else if wasDown and not down
            if active
                dropped = stageTileAt(x, y)
            else if pressedTile >= 0 and stageTileAt(x, y) == pressedTile
                dropped = pressedTile
            active = false
            pressedTile = -1
        wasDown = down
        return dropped
