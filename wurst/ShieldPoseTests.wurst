package ShieldPoseTests
import Wurst
import ShieldPose
import Simulation
import MatchRules
import ReplayState

@Test function shieldFollowsEnergyAndHidesOnReleaseKoAndResult()
    let fighter = new FighterState(0, 83., 1)
    projectedShield(fighter, true).visible.assertFalse()
    fighter.shield = true
    fighter.z = 27.
    fighter.shieldEnergy = SHIELD_MAX
    let full = projectedShield(fighter, true)
    full.visible.assertTrue()
    full.x.assertEquals(83.)
    full.z.assertEquals(77.)
    full.scale.assertEquals(1.2)
    fighter.shieldEnergy = SHIELD_MAX / 2
    projectedShield(fighter, true).scale.assertEquals(0.95)
    fighter.shieldEnergy = 0
    projectedShield(fighter, true).scale.assertEquals(0.7)
    fighter.shield = false
    projectedShield(fighter, true).visible.assertFalse()
    fighter.shield = true
    fighter.out = true
    projectedShield(fighter, true).visible.assertFalse()
    fighter.out = false
    projectedShield(fighter, false).visible.assertFalse()
    projectedShield(null, true).visible.assertFalse()

@Test function correctedShieldUsesRestoredSparseParticipantState()
    let world = new FighterRoster(9)
    world.fighters[0] = new FighterState(0, -100., 1)
    world.fighters[3] = new FighterState(2, 100., -1)
    let fighter = world.fighters[3]
    let game = new MatchState()
    game.phase = MATCH
    let inputs = new FrameInputs()
    let runtime = new ReplayRuntimeState()
    let snapshot = new ReplaySnapshot()
    snapshot.capture(world, game, inputs, runtime)
    fighter.shield = true
    fighter.x = 211.
    fighter.z = 17.
    fighter.shieldEnergy = 10.
    projectedShield(fighter, true).visible.assertTrue()
    snapshot.restore(world, game, inputs, runtime)
    projectedShield(fighter, true).visible.assertFalse()
    fighter.shield = true
    fighter.shieldEnergy = SHIELD_MAX
    snapshot.capture(world, game, inputs, runtime)
    fighter.x = -333.
    fighter.shieldEnergy = 4.
    snapshot.restore(world, game, inputs, runtime)
    let restored = projectedShield(fighter, true)
    restored.visible.assertTrue()
    restored.x.assertEquals(100.)
    restored.z.assertEquals(50.)
    restored.scale.assertEquals(1.2)
    let repeated = projectedShield(fighter, true)
    repeated.x.assertEquals(restored.x)
    repeated.z.assertEquals(restored.z)
    repeated.scale.assertEquals(restored.scale)
    fighter.shieldEnergy.assertEquals(SHIELD_MAX)
    world.mask.assertEquals(9)
