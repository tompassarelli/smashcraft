package JournalMatchLifecycle

// All participants cross both barriers; local receipt alone cannot release menus.
public class JournalMatchLifecycle
    private int epoch = 0
    private int humans = 0
    private int readyMask = 0
    private int stoppedMask = 0

    function beginEpoch(int newEpoch, int humanMask)
        epoch = newEpoch
        humans = humanMask
        readyMask = 0
        stoppedMask = 0

    private function bit(int slot) returns int
        if slot < 0 or slot > 3
            return 0
        var result = 1
        for index = 1 to slot
            result *= 2
        return result

    function ready(int messageEpoch, int slot)
        let participant = bit(slot)
        if messageEpoch == epoch and participant > 0 and (humans div participant) mod 2 == 1 and (readyMask div participant) mod 2 == 0
            readyMask += participant

    function stopped(int messageEpoch, int slot)
        let participant = bit(slot)
        if messageEpoch == epoch and participant > 0 and (humans div participant) mod 2 == 1 and (stoppedMask div participant) mod 2 == 0
            stoppedMask += participant

    function started() returns boolean
        return humans > 0 and readyMask == humans

    function quiescent() returns boolean
        return humans > 0 and stoppedMask == humans
