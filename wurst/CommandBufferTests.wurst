package CommandBufferTests
import CommandBuffer

@Test function repeatedConflictingDirectionsRemainNeutralInEveryOrder()
    for repeatedDirection = -1 to 1
        if repeatedDirection != 0
            for oppositePosition = 0 to 2
                let commands = new AttackBuffer(0)
                for eventIndex = 0 to 2
                    commands.enqueue(4, eventIndex == oppositePosition ? -repeatedDirection : repeatedDirection, 10, false)
                commands.consume(10, true).assertEquals(4)
                commands.consumedFacing.assertEquals(0)
                commands.enqueue(4, repeatedDirection, 11, false)
                commands.consume(11, true).assertEquals(4)
                commands.consumedFacing.assertEquals(repeatedDirection)
                destroy commands

@Test function immediateCStickSmashWinsOverChargeableNormalInEitherOrder()
    for directStyle = 2 to 4
        for normalStyle = 2 to 4
            let first = new AttackBuffer(0)
            let reverse = new AttackBuffer(0)
            first.enqueue(normalStyle, -1, 1, true)
            first.enqueue(directStyle, 1, 1, false)
            reverse.enqueue(directStyle, 1, 1, false)
            reverse.enqueue(normalStyle, -1, 1, true)
            first.consume(1, true).assertEquals(directStyle)
            reverse.consume(1, true).assertEquals(directStyle)
            first.consumedMayCharge.assertFalse()
            reverse.consumedMayCharge.assertFalse()
            first.consumedFacing.assertEquals(1)
            reverse.consumedFacing.assertEquals(1)
            destroy first
            destroy reverse

@Test function chargePermissionTravelsWithOneCommandAndExpiresWithIt()
    let commands = new AttackBuffer(0)
    commands.enqueue(4, 1, 1, true)
    commands.consume(1, true).assertEquals(4)
    commands.consumedMayCharge.assertTrue()
    commands.consume(1, true).assertEquals(-1)
    commands.consumedMayCharge.assertFalse()
    commands.enqueue(4, 1, 2, true)
    commands.consume(2, false).assertEquals(-1)
    commands.consume(3, true).assertEquals(-1)
    commands.consumedMayCharge.assertFalse()
    commands.enqueue(4, 1, 4, false)
    commands.consume(4, true).assertEquals(4)
    commands.consumedMayCharge.assertFalse()
    destroy commands

@Test function pressIsConsumedOnceOnItsTargetFrame()
    let commands = new AttackBuffer(0)
    commands.enqueue(0, 0, 10, false)
    commands.consume(9, true).assertEquals(-1)
    commands.consume(10, true).assertEquals(0)
    commands.consume(10, true).assertEquals(-1)
    commands.consume(11, true).assertEquals(-1)

@Test function zeroGraceDoesNotStoreAnAttackThroughRecovery()
    let commands = new AttackBuffer(0)
    commands.enqueue(1, 0, 10, false)
    commands.consume(10, false).assertEquals(-1)
    commands.consume(11, true).assertEquals(-1)

@Test function configuredBufferWaitsForRecoveryButExpires()
    let commands = new AttackBuffer(3)
    commands.enqueue(4, -1, 10, false)
    commands.consume(10, false).assertEquals(-1)
    commands.consume(13, true).assertEquals(4)
    commands.consumedFacing.assertEquals(-1)
    commands.enqueue(0, 0, 20, false)
    commands.consume(24, true).assertEquals(-1)

@Test function simultaneousAttackPriorityDoesNotDependOnCallbackOrder()
    let firstOrder = new AttackBuffer(0)
    let reverseOrder = new AttackBuffer(0)
    firstOrder.enqueue(0, 0, 10, false)
    firstOrder.enqueue(4, 1, 10, false)
    reverseOrder.enqueue(4, 1, 10, false)
    reverseOrder.enqueue(0, 0, 10, false)
    firstOrder.consume(10, true).assertEquals(4)
    reverseOrder.consume(10, true).assertEquals(4)
    firstOrder.consumedFacing.assertEquals(1)
    reverseOrder.consumedFacing.assertEquals(1)

@Test function cStickSmashWinsOverSameFrameNormalTilt()
    let first = new AttackBuffer(0)
    let second = new AttackBuffer(0)
    first.enqueue(6, -1, 10, false)
    first.enqueue(4, 1, 10, false)
    second.enqueue(4, 1, 10, false)
    second.enqueue(6, -1, 10, false)
    first.consume(10, true).assertEquals(4)
    second.consume(10, true).assertEquals(4)
    first.consumedFacing.assertEquals(1)
    second.consumedFacing.assertEquals(1)

@Test function angledTiltsReachTheirFrameAndYieldToCStickSmashes()
    for style = 9 to 10
        let commands = new AttackBuffer(0)
        commands.enqueue(style, -1, 10, false)
        commands.consume(10, true).assertEquals(style)
        commands.consumedFacing.assertEquals(-1)
        commands.enqueue(style, -1, 11, false)
        commands.enqueue(4, 1, 11, false)
        commands.consume(11, true).assertEquals(4)
        commands.enqueue(4, 1, 12, false)
        commands.enqueue(style, -1, 12, false)
        commands.consume(12, true).assertEquals(4)
        commands.enqueue(11, 1, 13, false)
        commands.consume(13, true).assertEquals(-1)
