@Test function jumpSquatBuffersBackAirUntilFirstAirborneFrame()
    for character = 0 to 1
        for facing = -1 to 1
            if facing != 0
                for squatRemaining = 1 to jumpSquatFrames(character)
                    let game = new MatchState()
                    game.phase = MATCH
                    let fighter = new FighterState(character, 0, facing)
                    let target = new FighterState(1 - character, 350, -facing)
                    let input = new InputSnapshot()
                    let otherInput = new InputSnapshot()
                    let commands = new AttackBuffer(ATTACK_BUFFER_FRAMES)
                    let otherCommands = new AttackBuffer(ATTACK_BUFFER_FRAMES)
                    fighter.jumpSquat = squatRemaining
                    fighter.jumpHeld = true
                    input.jumpHeld = true
                    commands.enqueue(4, -facing, 1, false)
                    for frame = 1 to squatRemaining
                        stepMatch(game, fighter, target, input, otherInput, commands, otherCommands, frame)
                        fighter.facing.assertEquals(facing)
                        if frame < squatRemaining
                            fighter.grounded.assertTrue()
                            fighter.attackStyle.assertEquals(-1)
                        else
                            fighter.grounded.assertFalse()
                            fighter.attackStyle.assertEquals(AERIAL_BACK_STYLE)
                            fighter.attackFrame.assertEquals(0)
                            fighter.attackSerial.assertEquals(1)
                    commands.hasPending(squatRemaining + 1).assertFalse()
                    destroy otherCommands
                    destroy commands
                    destroy otherInput
                    destroy input
                    destroy target
                    destroy fighter
                    destroy game

@Test function attackSelectionUsesGroundingAfterTheMovementStep()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, 1)
    game.requestStageSelect(0)
    game.requestStart(0)
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 350, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.jumpSquat = 1
    first.jumpHeld = true
    firstInput.jumpHeld = true
    firstCommands.enqueue(0, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.grounded.assertFalse()
    first.attackStyle.assertEquals(AERIAL_NEUTRAL_STYLE)
    first.attackStyle = -1
    first.cooldown = 0
    first.z = 1
    first.vz = -3
    firstCommands.enqueue(0, 0, 2, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.grounded.assertTrue()
    first.landingLag.assertEquals(4)
    first.attackStyle.assertEquals(-1)
    for frame = 3 to 5
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        first.attackStyle.assertEquals(-1)
    firstCommands.hasPending(5).assertFalse()
    firstCommands.enqueue(0, 0, 6, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 6)
    first.landingLag.assertEquals(0)
    first.attackStyle.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

