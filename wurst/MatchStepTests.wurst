package MatchStepTests
import Simulation
import MatchRules
import CommandBuffer
import MatchStep

@Test function humanDirectAttacksReachBothSlotsOnTheNextStep()
    for style = 1 to 5
        let game = new MatchState()
        game.selectCharacter(0, 0)
        game.requestStart(0)
        let first = new FighterState(0, -240, 1)
        let second = new FighterState(1, 240, -1)
        let firstInput = new InputSnapshot()
        let secondInput = new InputSnapshot()
        let firstCommands = new AttackBuffer(0)
        let secondCommands = new AttackBuffer(0)
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 10)
        queueHumanAttack(firstCommands, secondCommands, 0, style, 1, 10)
        queueHumanAttack(firstCommands, secondCommands, 1, style, -1, 10)
        first.attackSerial.assertEquals(0)
        second.attackSerial.assertEquals(0)
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 11)
        first.attackSerial.assertEquals(1)
        second.attackSerial.assertEquals(1)
        first.attackStyle.assertEquals(style)
        second.attackStyle.assertEquals(style)
        first.attackFrame.assertEquals(second.attackFrame)
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 12)
        first.attackSerial.assertEquals(1)
        second.attackSerial.assertEquals(1)
        destroy firstCommands
        destroy secondCommands
        destroy firstInput
        destroy secondInput
        destroy first
        destroy second
        destroy game

@Test function activeShieldConsumesGrabButRejectsOrdinaryAttackCommand()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 350, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    firstInput.shield = true
    firstCommands.enqueue(0, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.shield.assertTrue()
    first.attackStyle.assertEquals(-1)
    firstCommands.hasPending(1).assertTrue()
    firstCommands.clear()
    firstCommands.enqueue(5, 0, 2, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.attackStyle.assertEquals(5)
    first.shield.assertFalse()
    first.shieldReleaseLag.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function downOnlyDropsWhenAttackQueueIsEmptyExpiredOrFuture()
    for mode = 0 to 2
        let game = new MatchState()
        game.selectCharacter(0, 0)
        game.selectStage(0, 1)
        game.requestStart(0)
        let first = new FighterState(0, -240, 1)
        first.z = 170
        first.surface = 1
        let second = new FighterState(1, 350, -1)
        let firstInput = new InputSnapshot()
        firstInput.down = true
        let secondInput = new InputSnapshot()
        let firstCommands = new AttackBuffer(0)
        let secondCommands = new AttackBuffer(0)
        if mode > 0
            firstCommands.enqueue(3, 0, mode == 1 ? 0 : 2, true)
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
        first.grounded.assertFalse()
        first.z.assertLessThan(170.)
        first.attackStyle.assertEquals(-1)
        firstInput.attackRequested.assertFalse()
        destroy firstCommands
        destroy secondCommands
        destroy firstInput
        destroy secondInput
        destroy first
        destroy second
        destroy game

@Test function downwardNormalsTakePriorityOverDroppingThroughUpperPlatforms()
    for style = 3 to 8
        if style == 3 or style == 8
            let game = new MatchState()
            game.selectCharacter(0, 0)
            game.selectStage(0, 1)
            game.requestStart(0)
            let first = new FighterState(0, -240, 1)
            first.z = 170
            first.surface = 1
            let second = new FighterState(1, 350, -1)
            let firstInput = new InputSnapshot()
            firstInput.down = true
            firstInput.attackHeld = true
            let secondInput = new InputSnapshot()
            let firstCommands = new AttackBuffer(0)
            let secondCommands = new AttackBuffer(0)
            firstCommands.enqueue(style, 0, 1, true)
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
            first.grounded.assertTrue()
            first.z.assertEquals(170.)
            first.attackStyle.assertEquals(style)
            for frame = 2 to 12
                stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
                first.grounded.assertTrue()
            first.smashCharging.assertEquals(style == 3)
            destroy firstCommands
            destroy secondCommands
            destroy firstInput
            destroy secondInput
            destroy first
            destroy second
            destroy game

@Test function heldNormalSmashChargesAndReleasesButDirectCommandStaysImmediate()
    for mode = 0 to 1
        let game = new MatchState()
        game.selectCharacter(0, 0)
        game.requestStart(0)
        let first = new FighterState(0, 0, 1)
        let second = new FighterState(1, 350, -1)
        let firstInput = new InputSnapshot()
        firstInput.attackHeld = true
        let secondInput = new InputSnapshot()
        let firstCommands = new AttackBuffer(0)
        let secondCommands = new AttackBuffer(0)
        firstCommands.enqueue(4, 1, 1, mode == 1)
        for frame = 1 to 12
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        first.smashCharging.assertEquals(mode == 1)
        if mode == 1
            first.smashChargeFrames.assertGreaterThan(0)
            attackPhase(first).assertEquals(ATTACK_STARTUP)
        else
            first.smashChargeFrames.assertEquals(0)
            first.attackFrame.assertGreaterThan(attackStartupFrames(4))
        let heldFrame = first.attackFrame
        firstInput.attackHeld = false
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 13)
        first.smashCharging.assertFalse()
        first.attackFrame.assertGreaterThan(heldFrame)
        first.attackSerial.assertEquals(1)
        destroy firstCommands
        destroy secondCommands
        destroy firstInput
        destroy secondInput
        destroy first
        destroy second
        destroy game

@Test function airborneBackAttackKeepsFacingWhileDriftingBackwards()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 350, -1)
    first.grounded = false
    first.z = 200
    let firstInput = new InputSnapshot()
    firstInput.direction = -1
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    firstCommands.enqueue(4, -1, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.attackStyle.assertEquals(AERIAL_BACK_STYLE)
    first.facing.assertEquals(1)
    first.vx.assertLessThan(0.)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function attackSelectionUsesGroundingAfterTheMovementStep()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 350, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.jumpSquat = 1
    first.jumpHeld = true
    firstInput.jumpHeld = true
    firstCommands.enqueue(0, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.grounded.assertFalse()
    first.attackStyle.assertEquals(AERIAL_NEUTRAL_STYLE)
    first.attackStyle = -1
    first.cooldown = 0
    first.z = 1
    first.vz = -3
    firstCommands.enqueue(0, 0, 2, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.grounded.assertTrue()
    first.landingLag.assertEquals(4)
    first.attackStyle.assertEquals(-1)
    for frame = 3 to 5
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        first.attackStyle.assertEquals(-1)
    firstCommands.hasPending(5).assertFalse()
    firstCommands.enqueue(0, 0, 6, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 6)
    first.landingLag.assertEquals(0)
    first.attackStyle.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function shieldPressAppliesBeforeSameFrameAttack()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 100, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    secondInput.shield = true
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    firstCommands.enqueue(0, 0, 1, false)
    for frame = 1 to attackStartupFrames(0) + 1
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
    second.damage.assertEquals(0.)
    second.shieldStun.assertGreaterThan(0)
    second.shieldEnergy.assertLessThan(60.)

@Test function bothFinalStocksResolveAfterTheSameStep()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, -921, 1)
    let second = new FighterState(1, 921, -1)
    first.stocks = 1
    second.stocks = 1
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(-1)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.stocks.assertEquals(0)
    second.stocks.assertEquals(0)

@Test function ledgeSharedMatchStepCatchesBothSlotsThenAcceptsFreshOptions()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.requestStart(0)
    let first = new FighterState(0, -620, 1)
    let second = new FighterState(1, 620, -1)
    first.grounded = false
    second.grounded = false
    first.z = -30
    second.z = -30
    first.vz = -2
    second.vz = -2
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.ledgeState.assertEquals(LEDGE_HANG)
    second.ledgeState.assertEquals(LEDGE_HANG)
    first.ledgeFrame.assertEquals(1)
    second.ledgeFrame.assertEquals(1)
    firstInput.getupAttackPressed = true
    secondInput.ledgeVerticalPressed = 1
    firstCommands.enqueue(0, 0, 2, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.ledgeState.assertEquals(LEDGE_ATTACK)
    second.ledgeState.assertEquals(LEDGE_CLIMB)
    first.attackStyle.assertEquals(LEDGE_ATTACK_STYLE)
    first.attackSerial.assertEquals(1)
    second.attackStyle.assertEquals(-1)
    first.ledgeFrame.assertEquals(0)
    second.ledgeFrame.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game
