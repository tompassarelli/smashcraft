@Test function ledgeSharedMatchStepCatchesBothSlotsThenAcceptsFreshOptions()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, 1)
    game.requestStageSelect(0)
    game.requestStart(0)
    let first = new FighterState(0, -620, 1)
    let second = new FighterState(1, 620, -1)
    first.grounded = false
    second.grounded = false
    first.z = -30
    second.z = -30
    first.vz = -2
    second.vz = -2
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.ledgeState.assertEquals(LEDGE_HANG)
    second.ledgeState.assertEquals(LEDGE_HANG)
    first.ledgeFrame.assertEquals(1)
    second.ledgeFrame.assertEquals(1)
    firstInput.getupAttackPressed = true
    secondInput.ledgeVerticalPressed = 1
    firstCommands.enqueue(0, 0, 2, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.ledgeState.assertEquals(LEDGE_ATTACK)
    second.ledgeState.assertEquals(LEDGE_CLIMB)
    first.attackStyle.assertEquals(LEDGE_ATTACK_STYLE)
    first.attackSerial.assertEquals(1)
    second.attackStyle.assertEquals(-1)
    first.ledgeFrame.assertEquals(0)
    second.ledgeFrame.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function configuredStocksAndLastTickKnockoutPrecedeTimeout()
    let game = new MatchState()
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, 1)
    game.requestStageSelect(0)
    game.setStocks(0, 1)
    game.requestStart(0)
    let first = new FighterState(0, -921, 1)
    let second = new FighterState(1, 240, -1)
    initializeMatchFighters(game, first, second)
    first.stocks.assertEquals(1)
    second.stocks.assertEquals(1)
    game.remainingFrames = 1
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(1)
    game.timedOut.assertFalse()
    first.stocks.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function sharedStepClockRunsOnlyDuringMatch()
    let game = new MatchState()
    let first = new FighterState(0, -240, 1)
    let second = new FighterState(1, 240, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    game.remainingFrames.assertEquals(25200)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, 1)
    game.requestStageSelect(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    game.remainingFrames.assertEquals(25200)
    game.requestStart(0)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 3)
    game.remainingFrames.assertEquals(25199)
    game.remainingFrames = 1
    first.damage = 30
    second.damage = 10
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 4)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(1)
    game.timedOut.assertTrue()
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 5)
    game.remainingFrames.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function dashGrabUsesTestActorTimingAndWindowIsReplayable()
    let game = new MatchState()
    game.phase = MATCH
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 80, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.dashGrabTiming = ntscFoxDashGrabRules()
    first.groundRules = ntscFoxGroundMovementRules()
    first.dashFrame = 5
    first.dashDirection = 1
    first.groundAction = GROUND_ACTION_DASH
    first.groundActionFrame = 5
    firstInput.direction = 1
    firstCommands.enqueue(5, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.attackStyle.assertEquals(5)
    first.dashGrabAttack.assertTrue()
    first.attackDuration.assertEquals(40)
    first.dashGrabTiming.startupFrames.assertEquals(10)
    firstInput.attackPressed = false
    for frame = 2 to 10
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        second.grabbedFrames.assertEquals(0)
    first.attackFrame.assertEquals(9)
    attackPhase(first).assertEquals(ATTACK_STARTUP)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 11)
    second.grabbedFrames.assertGreaterThan(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function ordinaryDashAttackStaysAnAttackWhileGrabIntentStartsDashGrab()
    let game = new MatchState()
    game.phase = MATCH
    let first = new FighterState(0, -240, 1)
    let second = new FighterState(1, 240, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.dashFrame = INITIAL_DASH_FRAMES + 1
    first.dashDirection = 1
    first.groundAction = GROUND_ACTION_DASH
    first.groundActionFrame = 5
    second.dashFrame = INITIAL_DASH_FRAMES + 1
    second.dashDirection = -1
    second.groundAction = GROUND_ACTION_DASH
    second.groundActionFrame = 5
    firstInput.direction = 1
    firstInput.attackPressed = true
    secondInput.direction = -1
    firstCommands.enqueue(0, 0, 1, false)
    secondCommands.enqueue(5, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.attackStyle.assertEquals(0)
    first.dashGrabAttack.assertFalse()
    first.dashGrabTiming.startupFrames.assertEquals(attackStartupFrames(5))
    first.dashGrabTiming.totalFrames.assertEquals(attackDurationFramesForGrounding(5, true))
    second.attackStyle.assertEquals(5)
    second.dashGrabAttack.assertTrue()
    second.dashGrabTiming.startupFrames.assertEquals(attackStartupFrames(5))
    second.attackDuration.assertEquals(attackDurationFramesForGrounding(5, true))
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

