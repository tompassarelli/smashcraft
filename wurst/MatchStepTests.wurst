@Test function dashGrabWhiffEndsAfterFortySubsequentTicks()
    let game = new MatchState()
    game.phase = MATCH
    let first = new FighterState(0, -240, 1)
    let second = new FighterState(1, -500, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.dashGrabTiming = ntscFoxDashGrabRules()
    first.dashFrame = 5
    first.dashDirection = 1
    first.groundAction = GROUND_ACTION_DASH
    first.groundActionFrame = 5
    firstInput.direction = 1
    firstCommands.enqueue(5, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.attackFrame.assertEquals(0)
    first.dashGrabAttack.assertTrue()
    firstInput.direction = 0
    for frame = 2 to 40
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        first.out.assertFalse()
        second.grabbedFrames.assertEquals(0)
    first.attackFrame.assertEquals(39)
    first.attackStyle.assertEquals(5)
    first.cooldown.assertEquals(1)
    firstInput.jumpPressed = true
    firstInput.jumpHeld = true
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 41)
    first.attackStyle.assertEquals(-1)
    first.cooldown.assertEquals(0)
    first.jumpSquat.assertGreaterThan(0)
    second.grabbedFrames.assertEquals(0)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function dashGrabSecondActiveTickCapturesButFollowingTickDoesNot()
    for lateByOne = 0 to 1
        let game = new MatchState()
        game.phase = MATCH
        let first = new FighterState(0, 0, 1)
        let second = new FighterState(1, 80, -1)
        let firstInput = new InputSnapshot()
        let secondInput = new InputSnapshot()
        let firstCommands = new AttackBuffer(0)
        let secondCommands = new AttackBuffer(0)
        first.dashGrabTiming = ntscFoxDashGrabRules()
        first.dashFrame = 5
        first.dashDirection = 1
        first.groundAction = GROUND_ACTION_DASH
        first.groundActionFrame = 5
        firstInput.direction = 1
        second.invincible = 12 + lateByOne
        firstCommands.enqueue(5, 0, 1, false)
        for frame = 1 to 11
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
            second.grabbedFrames.assertEquals(0)
        first.attackFrame.assertEquals(10)
        attackPhase(first).assertEquals(ATTACK_ACTIVE)
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 12)
        if lateByOne == 0
            second.grabbedFrames.assertGreaterThan(0)
        else
            second.grabbedFrames.assertEquals(0)
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 13)
            second.invincible.assertEquals(0)
            first.attackFrame.assertEquals(12)
            attackPhase(first).assertEquals(ATTACK_RECOVERY)
            second.grabbedFrames.assertEquals(0)
        destroy firstCommands
        destroy secondCommands
        destroy firstInput
        destroy secondInput
        destroy first
        destroy second
        destroy game
