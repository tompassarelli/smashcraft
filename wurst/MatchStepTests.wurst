    let secondCommands = new AttackBuffer(0)
    first.shield = true
    second.shield = true
    first.shieldEnergy = 20
    second.shieldEnergy = 20
    firstInput.shield = true
    secondInput.shield = true
    firstCommands.enqueue(5, 0, 1, false)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.attackStyle.assertEquals(5)
    first.shield.assertFalse()
    first.shieldEnergy.assertEquals(19.79, 0.0001)
    second.shield.assertTrue()
    second.shieldEnergy.assertEquals(19.72, 0.0001)
    first.hitlag = 3
    second.hitlag = 3
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.shieldEnergy.assertEquals(19.86, 0.0001)
    second.shieldEnergy.assertEquals(19.72, 0.0001)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

@Test function shieldRegenMatchFollowsDizzyRestoreExactlyOnce()
    let game = new MatchState()
    game.phase = MATCH
    let first = new FighterState(0, 0, 1)
    let second = new FighterState(1, 500, -1)
    let firstInput = new InputSnapshot()
    let secondInput = new InputSnapshot()
    let firstCommands = new AttackBuffer(0)
    let secondCommands = new AttackBuffer(0)
    first.shieldEnergy = 10
    first.shieldBreakState = SHIELD_BREAK_STAND
    first.shieldBreakFrame = first.shieldBreakStandFrames - 1
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 1)
    first.shieldBreakState.assertEquals(SHIELD_BREAK_DIZZY)
    first.shieldEnergy.assertEquals(30.07, 0.0001)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 2)
    first.shieldEnergy.assertEquals(30.07, 0.0001)
    first.shieldBreakRemaining = 1
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 3)
    first.shieldBreakState.assertEquals(SHIELD_BREAK_NONE)
    first.shieldEnergy.assertEquals(30.07, 0.0001)
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 4)
    first.shieldEnergy.assertEquals(30.14, 0.0001)
    first.out = true
    first.respawn = 10
    stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 5)
    first.shieldEnergy.assertEquals(30.14, 0.0001)
    destroy firstCommands
    destroy secondCommands
    destroy firstInput
    destroy secondInput
    destroy first
    destroy second
    destroy game

