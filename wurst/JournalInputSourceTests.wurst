package JournalInputSourceTests
import JournalInputSource
import InputProtocol
import NetworkInput
import KeyBindings

@Test function immutableSingletonRowsKeepEpochSlotAndOriginalFrameCursor()
	let source = new JournalInputSource()
	let packet = new InputPacket()
	let row = new NetworkInput()
	let copied = new NetworkInput()
	source.beginEpoch("candidate", 91, 2, 3).assertTrue()
	source.expectedFrame().assertEquals(4)
	source.packetBase().assertEquals("smashcraft-journal-candidate-e91-s2-n4")
	row.assign(inputActionBit(LEFT_TRIGGER), inputActionBit(LEFT_TRIGGER), 0, 0, 0, 255, 0).assertTrue()
	packet.assign(91, 4, 1, row, row).assertTrue()
	source.decode(packet.encode(), 3).assertEquals(JOURNAL_WAIT)
	source.sequenceNumber().assertEquals(1)
	source.decode(packet.encode(), 4).assertEquals(JOURNAL_READY)
	source.copyRow(0, copied).assertTrue()
	copied.sameAs(row).assertTrue()
	source.sent().assertTrue()
	source.sequenceNumber().assertEquals(2)
	source.expectedFrame().assertEquals(5)
	source.packetBase().assertEquals("smashcraft-journal-candidate-e91-s2-n5")
	source.decode(packet.encode(), 5).assertEquals(JOURNAL_INVALID)
	source.sequenceNumber().assertEquals(2)

@Test function journalRejectsWrongEpochNonContiguousAndMalformedPackets()
	let source = new JournalInputSource()
	let packet = new InputPacket()
	let row = new NetworkInput()
	source.beginEpoch("candidate", 92, 0, 0).assertTrue()
	packet.assign(93, 1, 1, row, row).assertTrue()
	source.decode(packet.encode(), 64).assertEquals(JOURNAL_INVALID)
	packet.assign(92, 2, 1, row, row).assertTrue()
	source.decode(packet.encode(), 64).assertEquals(JOURNAL_INVALID)
	source.decode("I4 malformed", 64).assertEquals(JOURNAL_INVALID)
	source.decode("", 64).assertEquals(JOURNAL_WAIT)
	source.sequenceNumber().assertEquals(1)

@Test function pauseControlWaitsForExactSequencedAcknowledgment()
	let source = new JournalInputSource()
	source.beginEpoch("candidate", 95, 0, 0).assertTrue()
	source.controlSequenceNumber().assertEquals(1)
	source.controlAckBase().assertEquals("smashcraft-journal-ack-candidate-e95-s0-n1")
	source.acceptControlAck("ACK1|2|PREPARE|12", "PREPARE").assertFalse()
	source.controlSequenceNumber().assertEquals(1)
	source.acceptControlAck("ACK1|1|RESUME|12", "PREPARE").assertFalse()
	source.controlSequenceNumber().assertEquals(1)
	source.acceptControlAck("ACK1|1|PREPARE|12", "PREPARE").assertTrue()
	source.controlAckFrame().assertEquals(12)
	source.controlSequenceNumber().assertEquals(2)
	source.acceptControlAck("ACK1|2|PAUSE|12", "PAUSE").assertTrue()
	source.controlSequenceNumber().assertEquals(3)
	source.acceptControlAck("ACK1|3|RESUME|12", "RESUME").assertTrue()
	source.controlAckFrame().assertEquals(12)

@Test function pairedRowsWaitForEntireHorizonAndAdvanceByExactCount()
	let source = new JournalInputSource()
	let packet = new InputPacket()
	let first = new NetworkInput()
	let second = new NetworkInput()
	let copied = new NetworkInput()
	source.beginEpoch("candidate", 94, 1, 3).assertTrue()
	first.assign(inputActionBit(ATTACK), inputActionBit(ATTACK), 0, 0, 0, 0, 0).assertTrue()
	second.assign(0, 0, inputActionBit(ATTACK), 0, 0, 0, 0).assertTrue()
	packet.assign(94, 4, 2, first, second).assertTrue()
	source.decode(packet.encode(), 4).assertEquals(JOURNAL_WAIT)
	source.copyRow(0, copied).assertFalse()
	source.sent().assertFalse()
	source.sequenceNumber().assertEquals(1)
	source.decode(packet.encode(), 5).assertEquals(JOURNAL_READY)
	source.recordCount().assertEquals(2)
	source.copyRow(0, copied).assertTrue()
	copied.sameAs(first).assertTrue()
	source.copyRow(1, copied).assertTrue()
	copied.sameAs(second).assertTrue()
	source.copyRow(2, copied).assertFalse()
	// Re-reading before successful submission preserves the same cursor and rows.
	source.decode(packet.encode(), 5).assertEquals(JOURNAL_READY)
	source.sequenceNumber().assertEquals(1)
	source.sent().assertTrue()
	source.sequenceNumber().assertEquals(3)
	source.expectedFrame().assertEquals(6)
	source.packetBase().assertEquals("smashcraft-journal-candidate-e94-s1-n6")
	source.decode(packet.encode(), 64).assertEquals(JOURNAL_INVALID)
	packet.assign(94, 7, 2, first, second).assertTrue()
	source.decode(packet.encode(), 6).assertEquals(JOURNAL_INVALID)
