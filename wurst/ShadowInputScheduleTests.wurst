package ShadowInputScheduleTests
import ShadowInputSchedule
import NetworkInput
import ParticipantInputs
import InputProtocol
import InputLedger
import KeyBindings
import ReplayHistory

function shadowNeutral(NetworkInput row)
	row.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
	row.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
	row.assignThrowContributions(0, 0).assertTrue()

function shadowDeliver(ShadowInputSchedule schedule, int sender, int epoch, int frame,
		NetworkInput row, InputPacket packet)
	packet.assign(epoch, frame, 1, row, row).assertTrue()
	schedule.acceptSynchronized(sender, packet).assertEquals(INPUT_ACCEPTED)

function shadowAdvanceOne(ShadowInputSchedule schedule, int epoch, NetworkInput sample,
		ParticipantInputs inputs)
	let frame = schedule.speculativeFrame()
	schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
	schedule.resolveSpeculative(epoch, 0, inputs).assertTrue()
	schedule.completeSpeculative(epoch, frame).assertTrue()

@Test function missingLocalFrameWaitsUntilItsExactInputArrives()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	schedule.beginEpoch(1400, 0, 6, 3).assertTrue()
	schedule.mayAdvanceSpeculative().assertTrue()
	schedule.mayAdvanceSpeculativeFor(0).assertFalse()
	schedule.resolveSpeculative(1400, 0, inputs).assertFalse()
	schedule.speculativeFrame().assertEquals(1)
	// A later local row cannot substitute for the missing original frame.
	schedule.captureLocalAt(1400, 2, sample).assertEquals(SHADOW_CAPTURED)
	schedule.mayAdvanceSpeculativeFor(0).assertFalse()
	schedule.captureLocalAt(1400, 1, sample).assertEquals(SHADOW_CAPTURED)
	schedule.mayAdvanceSpeculativeFor(0).assertTrue()
	schedule.mayAdvanceSpeculativeFor(2).assertFalse()
	schedule.resolveSpeculative(1400, 0, inputs).assertTrue()
	schedule.completeSpeculative(1400, 1).assertTrue()
	schedule.mayAdvanceSpeculativeFor(0).assertTrue()
	schedule.resolveSpeculative(1400, 0, inputs).assertTrue()
	schedule.completeSpeculative(1400, 2).assertTrue()
	schedule.mayAdvanceSpeculativeFor(0).assertFalse()
	schedule.speculativeFrame().assertEquals(3)
	let packet = new InputPacket()
	shadowDeliver(schedule, 0, 1400, 3, sample, packet)
	schedule.mayAdvanceSpeculativeFor(0).assertTrue()
	schedule.resolveSpeculative(1400, 0, inputs).assertTrue()
	schedule.completeSpeculative(1400, 3).assertTrue()
	schedule.mayAdvanceSpeculativeFor(0).assertFalse()

@Test function maximumDelayStillCapturesFirstPostSeedRowBeforeConfirmation()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let result = new NetworkInput()
	schedule.beginEpoch(1304, 5, 6, 3).assertTrue()
	schedule.captureTarget().assertEquals(6)
	schedule.captureLocal(1304, sample).assertEquals(SHADOW_CAPTURED)
	schedule.copyPending(1304, 6, result).assertTrue()
	result.sameAs(sample).assertTrue()
	schedule.speculativeFrame().assertEquals(1)
	schedule.nextConfirmedFrame().assertEquals(1)

@Test function taggedBacklogKeepsEightOriginalFramesWhileSpeculationStalls()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	schedule.beginEpoch(1300, 0, 6, 3).assertTrue()
	for frame = 1 to 8
		// The producer's timeline progresses while the service cursor stays at 1.
		sample.assign(frame, frame, frame, frame, -frame, frame, frame).assertTrue()
		schedule.captureLocalAt(1300, frame, sample).assertEquals(SHADOW_CAPTURED)
		schedule.speculativeFrame().assertEquals(1)
		schedule.knownThrough().assertEquals(0)
		schedule.nextConfirmedFrame().assertEquals(1)
	for frame = 1 to 6
		schedule.resolveSpeculative(1300, 0, inputs).assertTrue()
		inputs.row(0).heldMask().assertEquals(frame)
		inputs.row(0).pressedMask().assertEquals(frame)
		inputs.row(0).releasedMask().assertEquals(frame)
		schedule.completeSpeculative(1300, frame).assertTrue()
	schedule.speculativeFrame().assertEquals(7)
	schedule.mayAdvanceSpeculative().assertFalse()
	for frame = 7 to 8
		schedule.copyPending(1300, frame, sample).assertTrue()
		sample.heldMask().assertEquals(frame)
		sample.axisZ().assertEquals(-frame)
		schedule.captureLocalAt(1300, frame, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	schedule.speculativeFrame().assertEquals(7)
	schedule.knownThrough().assertEquals(0)

@Test function taggedDuplicateConflictsPreserveAllRowMetadataAndCursors()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let original = new NetworkInput()
	let result = new NetworkInput()
	schedule.beginEpoch(1301, 3, 6, 3).assertTrue()
	sample.assign(7, inputActionBit(SPECIAL), 5, -12, 27, 42, 255).assertTrue()
	sample.assignPressData(-1, 1, 0, 0, true, 1, -1, 0).assertTrue()
	sample.assignThrowContributions(8, -3).assertTrue()
	sample.copyTo(original)
	schedule.captureLocalAt(1301, 4, sample).assertEquals(SHADOW_CAPTURED)
	schedule.captureLocalAt(1301, 4, original).assertEquals(SHADOW_ALREADY_CAPTURED)
	sample.assignThrowContributions(8, -2).assertTrue()
	schedule.captureLocalAt(1301, 4, sample).assertEquals(SHADOW_CAPTURE_CONFLICT)
	// Legacy polling still reports an immutable repeat, even if its row changed.
	schedule.captureLocal(1301, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	schedule.copyPending(1301, 4, result).assertTrue()
	result.sameAs(original).assertTrue()
	schedule.captureTarget().assertEquals(4)
	schedule.speculativeFrame().assertEquals(1)
	schedule.nextConfirmedFrame().assertEquals(1)
	schedule.knownThrough().assertEquals(3)

@Test function taggedInvalidEpochFrameAndFutureRejectWithoutOccupyingRing()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let result = new NetworkInput()
	schedule.captureLocalAt(1302, 1, sample).assertEquals(SHADOW_WRONG_EPOCH)
	schedule.beginEpoch(1302, 0, 6, 3).assertTrue()
	schedule.captureLocalAt(1301, 1, sample).assertEquals(SHADOW_WRONG_EPOCH)
	schedule.captureLocalAt(1302, 0, sample).assertEquals(SHADOW_FRAME_EXHAUSTED)
	schedule.captureLocalAt(1302, -1, sample).assertEquals(SHADOW_FRAME_EXHAUSTED)
	schedule.captureLocalAt(1302, INPUT_LAST_FRAME + 1, sample).assertEquals(SHADOW_FRAME_EXHAUSTED)
	schedule.captureLocalAt(1302, 1, null).assertEquals(SHADOW_INVALID_SAMPLE)
	schedule.copyPending(1302, 1, result).assertFalse()
	schedule.captureLocalAt(1302, 1, sample).assertEquals(SHADOW_CAPTURED)
	schedule.captureLocalAt(1302, INPUT_FUTURE_LIMIT, sample).assertEquals(SHADOW_CAPTURED)
	schedule.captureLocalAt(1302, INPUT_FUTURE_LIMIT + 1, sample).assertEquals(SHADOW_TOO_FAR_AHEAD)
	schedule.captureLocalAt(1302, 1 + SHADOW_PENDING_CAPACITY, sample).assertEquals(SHADOW_TOO_FAR_AHEAD)
	schedule.copyPending(1302, 1 + SHADOW_PENDING_CAPACITY, result).assertFalse()
	schedule.copyPending(1302, 1, result).assertTrue()
	result.sameAs(sample).assertTrue()
	schedule.speculativeFrame().assertEquals(1)
	schedule.nextConfirmedFrame().assertEquals(1)
	schedule.knownThrough().assertEquals(0)

@Test function taggedRetentionAndRingReuseFollowConfirmedConsumption()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let result = new NetworkInput()
	let inputs = new ParticipantInputs()
	let packet = new InputPacket()
	schedule.beginEpoch(1303, 0, 6, 1).assertTrue()
	let consumed = SHADOW_PENDING_CAPACITY + 1 - INPUT_FUTURE_LIMIT
	for frame = 1 to consumed
		shadowAdvanceOne(schedule, 1303, sample, inputs)
		shadowDeliver(schedule, 0, 1303, frame, sample, packet)
		schedule.readConfirmed(1303, inputs).assertTrue()
		schedule.completeConfirmed(1303, frame).assertTrue()
		if frame == REPLAY_HISTORY_CAPACITY
			schedule.captureLocalAt(1303, 1, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
		if frame == REPLAY_HISTORY_CAPACITY + 1
			schedule.captureLocalAt(1303, 1, sample).assertEquals(SHADOW_OUT_OF_HISTORY)
			schedule.copyPending(1303, 1, result).assertFalse()
	let firstRetained = consumed - REPLAY_HISTORY_CAPACITY + 1
	schedule.firstAcceptedFrame().assertEquals(firstRetained)
	schedule.captureLocalAt(1303, firstRetained - 1, sample).assertEquals(SHADOW_OUT_OF_HISTORY)
	schedule.captureLocalAt(1303, firstRetained, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	sample.assign(1, 2, 4, 99, -99, 12, 34).assertTrue()
	schedule.captureLocalAt(1303, 1 + SHADOW_PENDING_CAPACITY, sample).assertEquals(SHADOW_CAPTURED)
	schedule.captureLocalAt(1303, 1, sample).assertEquals(SHADOW_OUT_OF_HISTORY)
	schedule.copyPending(1303, 1 + SHADOW_PENDING_CAPACITY, result).assertTrue()
	result.sameAs(sample).assertTrue()
	schedule.captureLocalAt(1303, consumed + INPUT_FUTURE_LIMIT + 1, sample).assertEquals(SHADOW_TOO_FAR_AHEAD)
	schedule.speculativeFrame().assertEquals(consumed + 1)
	schedule.nextConfirmedFrame().assertEquals(consumed + 1)
	schedule.knownThrough().assertEquals(consumed)

@Test function zeroAndOneDelayKeepSeedAssignmentConfirmationAndEpochBoundaries()
	for delay = 0 to 1
		let epoch = 1000 + delay
		let schedule = new ShadowInputSchedule()
		let sample = new NetworkInput()
		let neutral = new NetworkInput()
		let inputs = new ParticipantInputs()
		let first = inputs.row(0)
		let second = inputs.row(1)
		let packet = new InputPacket()
		schedule.beginEpoch(epoch, delay, 12, 3).assertTrue()
		schedule.knownThrough().assertEquals(delay)
		schedule.captureTarget().assertEquals(1 + delay)
		sample.assign(inputActionBit(MOVE_RIGHT), inputActionBit(JUMP), 0, 127, 0, 0, 0).assertTrue()
		schedule.captureLocal(epoch, sample).assertEquals(SHADOW_CAPTURED)
		schedule.captureLocal(epoch, neutral).assertEquals(SHADOW_ALREADY_CAPTURED)
		schedule.copyPending(epoch, 1 + delay, first).assertTrue()
		first.sameAs(sample).assertTrue()
		schedule.copyAccepted(epoch, 0, 1 + delay, first).assertFalse()
		for frame = 1 to delay + 1
			if frame > 1
				schedule.captureLocal(epoch, neutral).assertEquals(SHADOW_CAPTURED)
			schedule.resolveSpeculative(epoch, 0, inputs).assertTrue()
			first.sameAs(frame <= delay ? neutral : sample).assertTrue()
			second.sameAs(neutral).assertTrue()
			schedule.completeSpeculative(epoch, frame).assertTrue()
			if frame <= delay
				schedule.readConfirmed(epoch, inputs).assertTrue()
				first.sameAs(neutral).assertTrue()
				schedule.completeConfirmed(epoch, frame).assertTrue()
		schedule.knownThrough().assertEquals(delay)
		schedule.mayAdvanceConfirmed().assertFalse()
		shadowDeliver(schedule, 0, epoch, 1 + delay, sample, packet)
		schedule.mayAdvanceConfirmed().assertFalse()
		shadowDeliver(schedule, 1, epoch, 1 + delay, neutral, packet)
		schedule.knownThrough().assertEquals(1 + delay)
		schedule.readConfirmed(epoch, inputs).assertTrue()
		first.sameAs(sample).assertTrue()
		second.sameAs(neutral).assertTrue()
		schedule.completeConfirmed(epoch, 1 + delay).assertTrue()
		schedule.beginEpoch(epoch, delay, 12, 3).assertFalse()
		schedule.beginEpoch(epoch + 10, delay, 12, 3).assertTrue()
		schedule.knownThrough().assertEquals(delay)
		schedule.captureTarget().assertEquals(1 + delay)
		schedule.copyPending(epoch + 10, 1 + delay, first).assertFalse()
		schedule.captureLocal(epoch, sample).assertEquals(SHADOW_WRONG_EPOCH)

@Test function pendingLocalSamplesNeverMoveTheCommonFrontier()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	let first = inputs.row(0)
	let second = inputs.row(1)
	schedule.beginEpoch(901, 3, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	schedule.knownThrough().assertEquals(3)
	sample.assign(inputActionBit(MOVE_RIGHT), 0, 0, 127, 0, 0, 0).assertTrue()
	schedule.captureLocal(901, sample).assertEquals(SHADOW_CAPTURED)
	schedule.captureLocal(901, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	schedule.knownThrough().assertEquals(3)
	schedule.speculativeFrame().assertEquals(1)
	schedule.mayAdvanceSpeculative().assertTrue()
	schedule.resolveSpeculative(901, 0, inputs).assertTrue()
	first.heldMask().assertEquals(0)
	second.heldMask().assertEquals(0)
	schedule.completeSpeculative(901, 1).assertTrue()
	schedule.knownThrough().assertEquals(3)

@Test function speculativeWindowStopsAtSixFramesPastContiguousCommonInput()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	schedule.beginEpoch(902, 3, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	shadowNeutral(sample)
	for frame = 1 to 9
		shadowAdvanceOne(schedule, 902, sample, inputs)
	schedule.speculativeFrame().assertEquals(10)
	schedule.knownThrough().assertEquals(3)
	schedule.mayAdvanceSpeculative().assertFalse()
	schedule.captureLocal(902, sample).assertEquals(SHADOW_CAPTURED)
	schedule.speculativeFrame().assertEquals(10)
	schedule.knownThrough().assertEquals(3)

@Test function lateRemotePredictionKeepsHoldsButDropsEdges()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let remote = new NetworkInput()
	let inputs = new ParticipantInputs()
	let first = inputs.row(0)
	let second = inputs.row(1)
	let packet = new InputPacket()
	schedule.beginEpoch(903, 3, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	shadowNeutral(sample)
	for frame = 1 to 3
		shadowAdvanceOne(schedule, 903, sample, inputs)
	remote.assign(inputActionBit(MOVE_RIGHT), inputActionBit(ATTACK), 0, 127, 0, 0, 0).assertTrue()
	shadowDeliver(schedule, 1, 903, 4, remote, packet)
	shadowNeutral(remote)
	shadowDeliver(schedule, 0, 903, 4, remote, packet)
	shadowAdvanceOne(schedule, 903, sample, inputs)
	first.heldMask().assertEquals(0)
	second.actionPressed(ATTACK).assertTrue()
	sample.assign(inputActionBit(MOVE_RIGHT), 0, 0, 127, 0, 0, 0).assertTrue()
	schedule.captureLocal(903, sample).assertEquals(SHADOW_CAPTURED)
	schedule.resolveSpeculative(903, 0, inputs).assertTrue()
	second.heldMask().assertEquals(inputActionBit(MOVE_RIGHT))
	second.pressedMask().assertEquals(0)
	second.releasedMask().assertEquals(0)

@Test function staleEpochSamplingIsRejected()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	schedule.beginEpoch(904, 2, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	schedule.beginEpoch(905, 5, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	schedule.captureLocal(904, sample).assertEquals(SHADOW_WRONG_EPOCH)
	schedule.beginEpoch(904, 3, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertFalse()

@Test function twelveFrameWindowKeepsEpochBoundAndImmutableCapture()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	let first = inputs.row(0)
	let packet = new InputPacket()
	schedule.beginEpoch(906, 3, 12, 3).assertTrue()
	schedule.rollbackFrames().assertEquals(12)
	shadowNeutral(sample)
	for frame = 1 to 15
		schedule.captureTarget().assertEquals(frame + 3)
		shadowAdvanceOne(schedule, 906, sample, inputs)
	schedule.speculativeFrame().assertEquals(16)
	schedule.knownThrough().assertEquals(3)
	schedule.mayAdvanceSpeculative().assertFalse()
	schedule.captureLocal(906, sample).assertEquals(SHADOW_CAPTURED)
	sample.assign(inputActionBit(MOVE_RIGHT), 0, 0, 127, 0, 0, 0).assertTrue()
	schedule.captureLocal(906, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	schedule.copyPending(906, 19, first).assertTrue()
	first.heldMask().assertEquals(0)
	shadowNeutral(sample)
	shadowDeliver(schedule, 0, 906, 4, sample, packet)
	schedule.mayAdvanceSpeculative().assertFalse()
	shadowDeliver(schedule, 1, 906, 4, sample, packet)
	schedule.knownThrough().assertEquals(4)
	schedule.mayAdvanceSpeculative().assertTrue()
	schedule.beginEpoch(906, 3, 6, 3).assertFalse()
	schedule.beginEpoch(907, 3, 0, 3).assertFalse()
	schedule.beginEpoch(907, 3, REPLAY_MAX_CORRECTION_FRAMES + 1, 3).assertFalse()
	schedule.rollbackFrames().assertEquals(12)
	schedule.speculativeFrame().assertEquals(16)
	schedule.beginEpoch(907, 3, SHADOW_DEFAULT_ROLLBACK_WINDOW, 3).assertTrue()
	schedule.rollbackFrames().assertEquals(6)

@Test function twentyFourFrameWindowStopsAndResumesWithoutReassigningLocalInput()
	let schedule = new ShadowInputSchedule()
	let sample = new NetworkInput()
	let inputs = new ParticipantInputs()
	let first = inputs.row(0)
	let packet = new InputPacket()
	schedule.beginEpoch(908, 0, 24, 3).assertTrue()
	schedule.rollbackFrames().assertEquals(24)
	shadowNeutral(sample)
	for frame = 1 to 24
		schedule.captureTarget().assertEquals(frame)
		shadowAdvanceOne(schedule, 908, sample, inputs)
	schedule.speculativeFrame().assertEquals(25)
	schedule.knownThrough().assertEquals(0)
	schedule.mayAdvanceSpeculative().assertFalse()
	schedule.captureLocal(908, sample).assertEquals(SHADOW_CAPTURED)
	sample.assign(inputActionBit(MOVE_RIGHT), 0, 0, 127, 0, 0, 0).assertTrue()
	schedule.captureLocal(908, sample).assertEquals(SHADOW_ALREADY_CAPTURED)
	schedule.resolveSpeculative(908, 0, inputs).assertFalse()
	shadowNeutral(sample)
	shadowDeliver(schedule, 1, 908, 1, sample, packet)
	schedule.mayAdvanceSpeculative().assertFalse()
	shadowDeliver(schedule, 0, 908, 1, sample, packet)
	schedule.knownThrough().assertEquals(1)
	schedule.mayAdvanceSpeculative().assertTrue()
	schedule.resolveSpeculative(908, 0, inputs).assertTrue()
	first.sameAs(sample).assertTrue()
	schedule.completeSpeculative(908, 25).assertTrue()
	schedule.mayAdvanceSpeculative().assertFalse()
	schedule.beginEpoch(908, 0, 12, 3).assertFalse()
	schedule.beginEpoch(909, 0, REPLAY_MAX_CORRECTION_FRAMES + 1, 3).assertFalse()
	schedule.rollbackFrames().assertEquals(24)
	schedule.speculativeFrame().assertEquals(26)

@Test function everyActiveLocalSlotKeepsThreeDistinctCausalRemoteHistories()
	let schedule = new ShadowInputSchedule()
	let inputs = new ParticipantInputs()
	let source = new ParticipantInputs()
	let predicted = new NetworkInput()
	let packet = new InputPacket()
	for localPlayer = 0 to 3
		let epoch = 1100 + localPlayer
		schedule.beginEpoch(epoch, 0, 6, 15).assertTrue()
		for sender = 0 to 3
			let row = source.row(sender)
			row.assign(1 + sender, inputActionBit(SPECIAL) + inputActionBit(LEFT_TRIGGER) + inputActionBit(MOVE_UP), 7,
				10 + sender, -10 - sender, 31 + sender, 250 - sender).assertTrue()
			row.assignPressData(1, -1, -1, 1, true, -1, 1, 1).assertTrue()
			row.assignThrowContributions(sender + 3, -sender - 5).assertTrue()
			if sender != localPlayer
				shadowDeliver(schedule, sender, epoch, 1, row, packet)
		schedule.captureLocal(epoch, source.row(localPlayer)).assertEquals(SHADOW_CAPTURED)
		schedule.captureLocal(epoch, predicted).assertEquals(SHADOW_ALREADY_CAPTURED)
		schedule.resolveSpeculative(epoch, localPlayer, inputs).assertTrue()
		for sender = 0 to 3
			inputs.row(sender).sameAs(source.row(sender)).assertTrue()
		schedule.completeSpeculative(epoch, 1).assertTrue()
		schedule.knownThrough().assertEquals(0)
		schedule.captureLocal(epoch, source.row(localPlayer)).assertEquals(SHADOW_CAPTURED)
		// A future accepted remote row cannot influence an earlier prediction.
		let remote = (localPlayer + 1) mod 4
		predicted.assign(99, 0, 0, 99, 99, 99, 99).assertTrue()
		shadowDeliver(schedule, remote, epoch, 3, predicted, packet)
		schedule.resolveSpeculative(epoch, localPlayer, inputs).assertTrue()
		for sender = 0 to 3
			if sender == localPlayer
				inputs.row(sender).sameAs(source.row(sender)).assertTrue()
			else
				source.row(sender).predictTo(predicted)
				inputs.row(sender).sameAs(predicted).assertTrue()
		schedule.completeSpeculative(epoch, 2).assertTrue()
		shadowDeliver(schedule, localPlayer, epoch, 1, source.row(localPlayer), packet)
		schedule.knownThrough().assertEquals(1)
		schedule.readConfirmed(epoch, inputs).assertTrue()
		for sender = 0 to 3
			inputs.row(sender).sameAs(source.row(sender)).assertTrue()
		schedule.completeConfirmed(epoch, 1).assertTrue()

@Test function sparseShadowLocalSlotThreeDoesNotInventInactiveOrMissingAcceptedRows()
	let schedule = new ShadowInputSchedule()
	let inputs = new ParticipantInputs()
	let row = new NetworkInput()
	let packet = new InputPacket()
	schedule.beginEpoch(1200, 0, 6, 13).assertTrue()
	row.assign(45, 0, 0, -127, 81, 7, 89).assertTrue()
	inputs.row(1).assign(123, 0, 0, 0, 0, 0, 0).assertTrue()
	schedule.resolveSpeculative(1200, 3, inputs).assertFalse()
	schedule.captureLocal(1200, row).assertEquals(SHADOW_CAPTURED)
	schedule.resolveSpeculative(1200, 1, inputs).assertFalse()
	schedule.rememberResolvedInput(1, row).assertFalse()
	schedule.rememberResolvedInput(2, row).assertTrue()
	schedule.resolveSpeculative(1200, 3, inputs).assertTrue()
	inputs.row(1).heldMask().assertEquals(123)
	inputs.row(2).sameAs(row).assertTrue()
	inputs.row(3).sameAs(row).assertTrue()
	schedule.completeSpeculative(1200, 1).assertTrue()
	shadowDeliver(schedule, 0, 1200, 1, row, packet)
	shadowDeliver(schedule, 2, 1200, 1, row, packet)
	schedule.knownThrough().assertEquals(0)
	schedule.readConfirmed(1200, inputs).assertFalse()
	shadowDeliver(schedule, 3, 1200, 1, row, packet)
	schedule.knownThrough().assertEquals(1)
	schedule.readConfirmed(1200, inputs).assertTrue()
	schedule.completeConfirmed(1200, 1).assertTrue()
	schedule.beginEpoch(1201, 0, 6, 0).assertFalse()
	schedule.participantMask().assertEquals(13)
	schedule.beginEpoch(1201, 0, 6, 8).assertTrue()
	schedule.copyPending(1201, 1, row).assertFalse()
	schedule.isActive(2).assertFalse()
