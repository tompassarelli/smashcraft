package SpikeScenarioTests
import Simulation
import MatchRules
import MatchStep
import CommandBuffer
import SpikeScenario

@Test function offstageImmolateLaunchesDownwardThroughOrdinaryMatchStep()
    for sideIndex = 0 to 1
        let side = sideIndex == 0 ? -1 : 1
        let game = new MatchState()
        game.phase = MATCH
        let first = new FighterState(2, 0, side)
        let second = new FighterState(2, 0, -side)
        initializeSpikeScenario(first, second, 0, side)
        let firstInput = new InputSnapshot()
        let secondInput = new InputSnapshot()
        let firstCommands = new AttackBuffer(ATTACK_BUFFER_FRAMES)
        let secondCommands = new AttackBuffer(ATTACK_BUFFER_FRAMES)
        // Allow a real-input-sized interval after starting the airborne fixture.
        for frame = 1 to 12
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        firstInput.specialPressed = true
        firstInput.specialZ = -1
        firstInput.down = true
        stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, 13)
        firstInput.specialPressed = false
        firstInput.specialZ = 0
        firstInput.down = false
        for frame = 14 to 16
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        second.damage.assertEquals(9.)
        second.grounded.assertFalse()
        second.knockbackZ.assertLessThan(0.)
        second.hitstun.assertGreaterThan(0)
        let contactHeight = second.z
        for frame = 17 to 30
            stepMatch(game, first, second, firstInput, secondInput, firstCommands, secondCommands, frame)
        second.damage.assertEquals(9.)
        second.z.assertLessThan(contactHeight)
        second.grounded.assertFalse()
        destroy secondCommands
        destroy firstCommands
        destroy secondInput
        destroy firstInput
        destroy second
        destroy first
        destroy game
