package SelectionDrag

public function selectionPointerX(real pixelX, real width, real height) returns real
    return (pixelX - (width - height * 4 / 3) / 2) * 0.6 / height

public function selectionPointerY(real pixelY, real height) returns real
    return 0.6 - pixelY * 0.6 / height

public function selectionTile(real x, real y) returns int
    if y < 0.292 or y > 0.424
        return -1
    if x >= 0.260 and x <= 0.372
        return 0
    if x >= 0.440 and x <= 0.552
        return 1
    return -1

public function selectionChipX(int slot, int choice) returns real
    return (choice == 0 ? 0.272 : 0.452) + (slot == 0 ? 0 : 0.051)

function onChip(int slot, int choice, real x, real y) returns boolean
    let dx = x - (selectionChipX(slot, choice) + 0.020)
    let dy = y - 0.346
    return dx * dx + dy * dy <= 0.0004

// This state belongs only to the local cursor. Its result must cross a player
// sync event before changing a selected fighter.
public class SelectionDrag
    boolean active = false
    boolean wasDown = false
    int activeSlot = -1
    int releasedSlot = -1
    int pressedTile = -1

    function update(boolean enabled, boolean down, real x, real y, int slot, int choice,
        int opponentChoice, boolean opponentDraggable) returns int
        var dropped = -1
        releasedSlot = -1
        if not enabled
            active = false
            activeSlot = -1
            pressedTile = -1
        else if down and not wasDown
            active = onChip(slot, choice, x, y)
            activeSlot = active ? slot : -1
            let overOpponent = onChip(1 - slot, opponentChoice, x, y)
            if not active and overOpponent and opponentDraggable
                active = true
                activeSlot = 1 - slot
            // A chip owns the whole gesture, including a release without motion.
            pressedTile = active or overOpponent ? -1 : selectionTile(x, y)
        else if wasDown and not down
            if active
                dropped = selectionTile(x, y)
                releasedSlot = activeSlot
            else if pressedTile >= 0 and selectionTile(x, y) == pressedTile
                dropped = pressedTile
                releasedSlot = slot
            active = false
            activeSlot = -1
            pressedTile = -1
        wasDown = down
        return dropped
