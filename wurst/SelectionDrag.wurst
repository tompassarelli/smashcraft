package SelectionDrag
import ParticipantInputs

public function selectionPointerX(real pixelX, real width, real height) returns real
    return (pixelX - (width - height * 4 / 3) / 2) * 0.6 / height

public function selectionPointerY(real pixelY, real height) returns real
    return 0.6 - pixelY * 0.6 / height

public function selectionTile(real x, real y) returns int
    if y < 0.292 or y > 0.424
        return -1
    if x >= 0.260 and x <= 0.372
        return 0
    if x >= 0.440 and x <= 0.552
        return 1
    if x >= 0.620 and x <= 0.732
        return 2
    return -1

public function selectionChipX(int slot, int choice) returns real
    return (choice == 0 ? 0.272 : (choice == 1 ? 0.452 : 0.632)) + (slot mod 2) * 0.051

public function selectionChipY(int slot) returns real
    return slot < 2 ? 0.366 : 0.326

public function selectionCardX(int slot) returns real
    return 0.055 + slot * 0.175

function onChip(int slot, int choice, real x, real y) returns boolean
    let dx = x - (selectionChipX(slot, choice) + 0.020)
    let dy = y - (selectionChipY(slot) - 0.020)
    return dx * dx + dy * dy <= 0.0004

public function selectionCardSlot(real x, real y, int selectableMask) returns int
    if y < 0.075 or y > 0.242
        return -1
    for cardSlot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if x >= selectionCardX(cardSlot) and x <= selectionCardX(cardSlot) + 0.160
            if participantIsActive(selectableMask, cardSlot)
                return cardSlot
    return -1

// This state belongs only to the local cursor. Its result must cross a player
// sync event before changing a selected fighter.
public class SelectionDrag
    int selectableMask = 0
    int array[INPUT_PARTICIPANT_CAPACITY] choices
    boolean array[INPUT_PARTICIPANT_CAPACITY] ready
    boolean active = false
    boolean wasDown = false
    int activeSlot = -1
    int releasedSlot = -1
    int pressedTile = -1
    int heldSlot = -1
    int hoverTile = -1

    function setHover(int tile)
        hoverTile = tile

    function selectHeldChip(int slot, boolean available)
        if available and slot >= 0 and slot < INPUT_PARTICIPANT_CAPACITY
            heldSlot = slot

    function placeHovered() returns int
        if hoverTile < 0 or heldSlot < 0
            return -1
        releasedSlot = heldSlot
        return hoverTile

    function recallHeld() returns int
        if heldSlot < 0
            return -1
        releasedSlot = heldSlot
        return heldSlot

    function update(boolean enabled, boolean down, real x, real y, int slot) returns int
        var dropped = -1
        releasedSlot = -1
        if not enabled
            active = false
            activeSlot = -1
            pressedTile = -1
            heldSlot = -1
            hoverTile = -1
        else
            hoverTile = selectionTile(x, y)
            if down and not wasDown
                let cardOwner = selectionCardSlot(x, y, selectableMask)
                if cardOwner >= 0
                    heldSlot = cardOwner
                    active = true
                    activeSlot = cardOwner
                else
                    for chip = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                        if participantIsActive(selectableMask, chip) and ready[chip] and onChip(chip, choices[chip], x, y)
                            active = true
                            activeSlot = chip
                            heldSlot = chip
                    if not active and heldSlot >= 0 and hoverTile >= 0
                        active = true
                        activeSlot = heldSlot
                pressedTile = active or heldSlot < 0 ? -1 : selectionTile(x, y)
            if wasDown and not down
                if active
                    dropped = selectionTile(x, y)
                    releasedSlot = activeSlot
                else if pressedTile >= 0 and selectionTile(x, y) == pressedTile
                    dropped = pressedTile
                    releasedSlot = slot
                active = false
                activeSlot = -1
                pressedTile = -1
        wasDown = down
        return dropped
