package ParticipantInputs
import NetworkInput

public constant int INPUT_PARTICIPANT_CAPACITY = 4

// The mask is copied into each epoch; bits name Warcraft player slots, not
// packet records (which are consecutive time rows from one sender).
public function validParticipantMask(int mask) returns boolean
    return mask > 0 and mask < 16

public function participantIsActive(int mask, int slot) returns boolean
    if not validParticipantMask(mask) or slot < 0 or slot >= INPUT_PARTICIPANT_CAPACITY
        return false
    var bit = 1
    for i = 1 to slot
        bit *= 2
    return (mask div bit) mod 2 == 1

// Owns distinct rows for every supported slot, allocated only at construction.
// A read fills active slots only; inactive slots never stand for neutral input.
public class ParticipantInputs
    private NetworkInput array[INPUT_PARTICIPANT_CAPACITY] rows

    construct()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            rows[slot] = new NetworkInput()

    function row(int slot) returns NetworkInput
        if slot < 0 or slot >= INPUT_PARTICIPANT_CAPACITY
            return null
        return rows[slot]
