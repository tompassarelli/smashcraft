package KeyboardJournalIngressTests
import KeyboardJournalIngress

function setSignal(string state, int index) returns string
	return state.substring(0, index) + "1" + state.substring(index + 1)

function chunkState(string wire, bool finalChunk) returns string
	var state = ""
	for i = 0 to 53
		state += "0"
	for offset = 0 to wire.length() - 1
		let charValue = KEYBOARD_JOURNAL_ASCII.indexOf(wire.substring(offset, offset + 1)) + 32
		var place = 1
		for bit = 0 to 6
			if (charValue div place) mod 2 == 1
				state = setSignal(state, offset * 7 + bit)
			place = place * 2
	var lengthBits = wire.length()
	for bit = 0 to 2
		if lengthBits mod 2 == 1
			state = setSignal(state, 49 + bit)
		lengthBits = lengthBits div 2
	if finalChunk
		state = setSignal(state, 52)
	return state

@Test function asciiChunksPreserveI4AndControlWiresExactly()
	let chunk = chunkState("I40001a", false)
	KEYBOARD_JOURNAL_ASCII.indexOf("I").assertEquals(41)
	keyboardJournalDecodeChar(chunk, 0).assertEquals(73)
	keyboardJournalDecodeChar(chunk, 6).assertEquals(97)
	keyboardJournalDecodeChunk(chunk).assertEquals("I40001a")
	keyboardJournalDecodeChunk(chunkState("ACK1|4|", false)).assertEquals("ACK1|4|")
	keyboardJournalDecodeChunk(chunkState("PREPARE", false)).assertEquals("PREPARE")
	keyboardJournalDecodeChunk(chunkState("|19", true)).assertEquals("|19")

@Test function emptyCarrierIsIgnoredAndMaximumChunkIsSevenBytes()
	var neutral = ""
	for i = 0 to 53
		neutral += "0"
	keyboardJournalDecodeChunk(neutral).assertEquals("")
	keyboardJournalDecodeChunk(chunkState("0123456", false)).assertEquals("0123456")
	keyboardJournalDecodeChunk(chunkState("abcdefg", true)).assertEquals("abcdefg")

@Test function rejectsNonPrintablePayloadAndInvalidLength()
	var controlByte = ""
	for i = 0 to 53
		controlByte += "0"
	controlByte = setSignal(controlByte, 49)
	controlByte = setSignal(controlByte, 0)
	controlByte = setSignal(controlByte, 1)
	keyboardJournalDecodeChunk(controlByte).assertEquals("!invalid!")
	var invalidLength = ""
	for i = 0 to 53
		invalidLength += "0"
	for bit = 0 to 2
		invalidLength = setSignal(invalidLength, 49 + bit)
	keyboardJournalDecodeChunk(invalidLength).assertEquals("!invalid!")
