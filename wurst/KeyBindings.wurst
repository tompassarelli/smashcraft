package KeyBindings

public constant int MOVE_LEFT = 0
public constant int MOVE_RIGHT = 1
public constant int MOVE_DOWN = 2
public constant int MOVE_UP = 3
public constant int JUMP = 4
public constant int ATTACK = 5
public constant int SPECIAL = 6
public constant int GRAB = 7
public constant int LEFT_TRIGGER = 8
public constant int RIGHT_TRIGGER = 9
public constant int SMASH_LEFT = 10
public constant int SMASH_RIGHT = 11
public constant int SMASH_UP = 12
public constant int SMASH_DOWN = 13
public constant int WALK_MODIFIER = 14
public constant int ACTION_COUNT = 15
public constant int KEY_SLOT_COUNT = 30

public class KeyBindings
    private int array[30] keys

    construct(boolean custom)
        preset(custom)

    function preset(boolean custom)
        for i = 0 to KEY_SLOT_COUNT - 1
            keys[i] = 0
        keys[MOVE_LEFT * 2] = 87
        keys[MOVE_RIGHT * 2] = 82
        keys[MOVE_DOWN * 2] = 69
        keys[MOVE_UP * 2] = 32
        keys[JUMP * 2] = 73
        keys[JUMP * 2 + 1] = custom ? 57 : 56
        keys[ATTACK * 2] = 78
        keys[SPECIAL * 2] = 85
        keys[GRAB * 2] = 79
        keys[LEFT_TRIGGER * 2] = 81
        keys[RIGHT_TRIGGER * 2] = custom ? 56 : 55
        keys[SMASH_LEFT * 2] = 66
        keys[SMASH_LEFT * 2 + 1] = 191
        keys[SMASH_RIGHT * 2] = 77
        keys[SMASH_UP * 2] = 74
        keys[SMASH_DOWN * 2] = 72
        keys[WALK_MODIFIER * 2] = 80

    function keyFor(int action, int slot) returns int
        if action < 0 or action >= ACTION_COUNT or slot < 0 or slot > 1
            return 0
        return keys[action * 2 + slot]

    function actionFor(int key) returns int
        if key == 0
            return -1
        for i = 0 to KEY_SLOT_COUNT - 1
            if keys[i] == key
                return i div 2
        return -1

    function rebind(int action, int slot, int key) returns boolean
        if action < 0 or action >= ACTION_COUNT or slot < 0 or slot > 1 or key < 0 or key > 255
            return false
        // Menu and developer controls remain available independently.
        if key == 27 or key == 112 or key == 116 or key == 117 or key == 118
            return false
        let index = action * 2 + slot
        if key != 0
            for i = 0 to KEY_SLOT_COUNT - 1
                if i != index and keys[i] == key
                    return false
        keys[index] = key
        return true

    function encode() returns string
        var result = "K3"
        for i = 0 to KEY_SLOT_COUNT - 1
            let number = I2S(keys[i])
            result += keys[i] < 10 ? "00" + number : (keys[i] < 100 ? "0" + number : number)
        return result

    function keyName(int key) returns string
        if key == 0
            return "—"
        if key == 32
            return "SPACE"
        if key == 191
            return "/"
        if key == 186
            return ";"
        if key >= 65 and key <= 90
            return "ABCDEFGHIJKLMNOPQRSTUVWXYZ".charAt(key - 65)
        if key >= 48 and key <= 57
            return "0123456789".charAt(key - 48)
        return "KEY " + I2S(key)

    static function actionName(int action) returns string
        if action == MOVE_LEFT
            return "Move left"
        if action == MOVE_RIGHT
            return "Move right"
        if action == MOVE_DOWN
            return "Move down"
        if action == MOVE_UP
            return "Move up"
        if action == JUMP
            return "Jump"
        if action == ATTACK
            return "Attack"
        if action == SPECIAL
            return "Special"
        if action == GRAB
            return "Grab"
        if action == LEFT_TRIGGER
            return "Left trigger"
        if action == RIGHT_TRIGGER
            return "Right trigger"
        if action == SMASH_LEFT
            return "C-stick left"
        if action == SMASH_RIGHT
            return "C-stick right"
        if action == SMASH_UP
            return "C-stick up"
        if action == SMASH_DOWN
            return "C-stick down"
        if action == WALK_MODIFIER
            return "Walk / tilts"
        return "Unknown"

    function restore(string encoded) returns boolean
        let previousSave = encoded.length() == 86 and encoded.substring(0, 2) == "K1"
        let currentSave = encoded.length() == 92 and encoded.substring(0, 2) == "K3"
        if not previousSave and not currentSave and (encoded.length() != 92 or encoded.substring(0, 2) != "K2")
            return false
        let candidate = new KeyBindings(false)
        for i = 0 to KEY_SLOT_COUNT - 1
            candidate.keys[i] = 0
        for i = 0 to (previousSave ? 28 : KEY_SLOT_COUNT) - 1
            var value = 0
            for digit = 0 to 2
                let parsed = "0123456789".indexOf(encoded.charAt(2 + i * 3 + digit))
                if parsed < 0
                    destroy candidate
                    return false
                value = value * 10 + parsed
            if not candidate.rebind(i div 2, i mod 2, value)
                destroy candidate
                return false
        if previousSave and candidate.actionFor(80) < 0
            candidate.rebind(WALK_MODIFIER, 0, 80)
        // Upgrade old defaults once; new saves can intentionally bind L or ;.
        if not currentSave
            if candidate.keyFor(GRAB, 0) == 76 and candidate.actionFor(79) < 0
                candidate.rebind(GRAB, 0, 79)
            if candidate.keyFor(WALK_MODIFIER, 0) == 186 and candidate.actionFor(80) < 0
                candidate.rebind(WALK_MODIFIER, 0, 80)
        // Migrate the previous default block without moving custom bindings.
        if not currentSave and candidate.keyFor(MOVE_LEFT, 0) == 83 and candidate.keyFor(MOVE_RIGHT, 0) == 70 and candidate.keyFor(MOVE_DOWN, 0) == 68 and candidate.keyFor(LEFT_TRIGGER, 0) == 65 and candidate.actionFor(81) < 0 and candidate.actionFor(87) < 0 and candidate.actionFor(69) < 0 and candidate.actionFor(82) < 0
            candidate.rebind(MOVE_LEFT, 0, 87)
            candidate.rebind(MOVE_RIGHT, 0, 82)
            candidate.rebind(MOVE_DOWN, 0, 69)
            candidate.rebind(LEFT_TRIGGER, 0, 81)
        for i = 0 to KEY_SLOT_COUNT - 1
            keys[i] = candidate.keys[i]
        destroy candidate
        return true
