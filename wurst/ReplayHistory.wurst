package ReplayHistory
import Execute
import ReplayState
import MatchStep
import Simulation
import MatchRules
import CommandBuffer

public constant int REPLAY_HISTORY_CAPACITY = 64
public constant int REPLAY_MAX_CORRECTION_FRAMES = 24
public constant int REPLAY_CORRECTION_REJECTED = -1
public constant int REPLAY_CORRECTION_UNCHANGED = 0

// Detached replacements for used rows. Adding a row never edits
// its producer; identical duplicates are harmless and conflicting ones fail.
public class ReplayCorrections
    private MatchFrameInput array[REPLAY_MAX_CORRECTION_FRAMES] rows
    private boolean array[REPLAY_MAX_CORRECTION_FRAMES] speculative
    private int count = 0
    private int epoch = -1

    construct()
        for i = 0 to REPLAY_MAX_CORRECTION_FRAMES - 1
            rows[i] = new MatchFrameInput()

    function beginEpoch(int newEpoch) returns boolean
        if newEpoch <= epoch
            return false
        epoch = newEpoch
        count = 0
        return true

    function epochNumber() returns int
        return epoch

    function clear()
        count = 0

    function size() returns int
        return count

    function add(MatchFrameInput row) returns boolean
        return addRow(row, false)

    function addSpeculative(MatchFrameInput row) returns boolean
        return addRow(row, true)

    function isSpeculative(int index) returns boolean
        return index >= 0 and index < count and speculative[index]

    private function addRow(MatchFrameInput row, boolean predicted) returns boolean
        if epoch < 0 or row.frameNumber() < 1
            return false
        for i = 0 to count - 1
            if rows[i].frameNumber() == row.frameNumber()
                return rows[i].sameAs(row) and speculative[i] == predicted
        if count == REPLAY_MAX_CORRECTION_FRAMES
            return false
        row.copyTo(rows[count])
        speculative[count] = predicted
        count++
        return true

    function copyRow(int index, MatchFrameInput destination) returns boolean
        if index < 0 or index >= count
            return false
        rows[index].copyTo(destination)
        return true

// Construct in common initialization. Used rows are private detached copies;
// save, restore and replay allocate neither Wurst objects nor native handles.
public class ReplayHistory
    private ReplaySnapshot array[REPLAY_HISTORY_CAPACITY] snapshots
    private MatchFrameInput array[REPLAY_HISTORY_CAPACITY] inputs
    private boolean array[REPLAY_HISTORY_CAPACITY] speculative
    private MatchFrameInput correctionScratch = new MatchFrameInput()
    private int correctionWindow = 0
    private int authoritativeThrough = 0
    private int epoch = -1
    private int nextFrame = 1
    private int count = 0

    construct()
        for i = 0 to REPLAY_HISTORY_CAPACITY - 1
            // Each detached slot has its own JASS operation budget.
            execute() ->
                snapshots[i] = new ReplaySnapshot()
                inputs[i] = new MatchFrameInput()

    // Epochs increase across rematches; a repeated/stale reset cannot erase history.
    function beginEpoch(int newEpoch, int firstFrame) returns boolean
        return beginEpochWithCorrections(newEpoch, firstFrame, 0)

    function beginEpochWithCorrections(int newEpoch, int firstFrame, int window) returns boolean
        if newEpoch <= epoch or firstFrame < 1 or window < 0 or window > REPLAY_MAX_CORRECTION_FRAMES
            return false
        epoch = newEpoch
        nextFrame = firstFrame
        count = 0
        correctionWindow = window
        authoritativeThrough = firstFrame - 1
        for i = 0 to REPLAY_HISTORY_CAPACITY - 1
            inputs[i].reset()
            speculative[i] = false
        return true

    function contains(int requestedEpoch, int frame) returns boolean
        if requestedEpoch != epoch or epoch < 0 or frame < nextFrame - count or frame >= nextFrame
            return false
        return inputs[frame mod REPLAY_HISTORY_CAPACITY].frameNumber() == frame

    function isSpeculative(int requestedEpoch, int frame) returns boolean
        return contains(requestedEpoch, frame) and speculative[frame mod REPLAY_HISTORY_CAPACITY]

    function firstRetainedFrame() returns int
        return nextFrame - count

    function lastRecordedFrame() returns int
        return nextFrame - 1

    function copyInputRow(int requestedEpoch, int frame, MatchFrameInput destination) returns boolean
        if not contains(requestedEpoch, frame)
            return false
        inputs[frame mod REPLAY_HISTORY_CAPACITY].copyTo(destination)
        return true

    // The snapshot is before row.frameNumber(), never after its execution.
    function save(int requestedEpoch, MatchFrameInput row,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns boolean
        return saveRow(requestedEpoch, row, false, world, game, controls, runtime)

    function saveSpeculative(int requestedEpoch, MatchFrameInput row,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns boolean
        return saveRow(requestedEpoch, row, true, world, game, controls, runtime)

    private function advanceAuthoritative()
        while authoritativeThrough + 1 < nextFrame and not speculative[(authoritativeThrough + 1) mod REPLAY_HISTORY_CAPACITY]
            authoritativeThrough++

    private function saveRow(int requestedEpoch, MatchFrameInput row, boolean predicted,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns boolean
        if row.participantMask() != world.mask or epoch < 0 or requestedEpoch != epoch or row.frameNumber() != nextFrame or runtime.simulationFrame != nextFrame - 1
            return false
        // Even an authoritative future row cannot bypass an unresolved earlier
        // prediction. The retained ring size does not grant speculation distance.
        if (predicted or authoritativeThrough < nextFrame - 1) and nextFrame - authoritativeThrough > correctionWindow
            return false
        // Keep the signed frame counter from wrapping into a different history.
        if nextFrame == 2147483647
            return false
        let slot = nextFrame mod REPLAY_HISTORY_CAPACITY
        snapshots[slot].capture(world, game, controls, runtime)
        row.copyTo(inputs[slot])
        speculative[slot] = predicted
        nextFrame++
        count = min(count + 1, REPLAY_HISTORY_CAPACITY)
        advanceAuthoritative()
        return true

    function restore(int requestedEpoch, int frame,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns boolean
        if not contains(requestedEpoch, frame)
            return false
        snapshots[frame mod REPLAY_HISTORY_CAPACITY].restore(world, game, controls, runtime)
        return true

    // Validate the whole inclusive interval before touching live state. This
    // consumes recorded input only, without capture, polling or presentation.
    function replay(int requestedEpoch, int fromFrame, int throughFrame,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns boolean
        if fromFrame > throughFrame or not contains(requestedEpoch, fromFrame) or not contains(requestedEpoch, throughFrame)
            return false
        for frame = fromFrame to throughFrame
            if not contains(requestedEpoch, frame)
                return false
        restore(requestedEpoch, fromFrame, world, game, controls, runtime)
        for frame = fromFrame to throughFrame
            let row = inputs[frame mod REPLAY_HISTORY_CAPACITY]
            if row.hasNetworkRows() and not row.refreshNetworkAdaptation(world, frame)
                return false
            row.execute(game, world, controls, runtime, frame)
        return true

    // Returns the earliest replayed frame, zero for no mismatch, or -1 on
    // rejection. This edits only used speculative copies, never accepted input
    // storage. The caller must supply the live state at the saved present.
    function correct(int requestedEpoch, ReplayCorrections corrections,
            FighterRoster world, MatchState game, FrameInputs controls,
            ReplayRuntimeState runtime) returns int
        if epoch < 0 or requestedEpoch != epoch or corrections.epochNumber() != epoch or runtime.simulationFrame != nextFrame - 1
            return REPLAY_CORRECTION_REJECTED
        var earliest = nextFrame
        for i = 0 to corrections.size() - 1
            corrections.copyRow(i, correctionScratch)
            let frame = correctionScratch.frameNumber()
            if not contains(requestedEpoch, frame) or correctionScratch.participantMask() != world.mask
                return REPLAY_CORRECTION_REJECTED
            let slot = frame mod REPLAY_HISTORY_CAPACITY
            if not inputs[slot].sameAs(correctionScratch)
                if not speculative[slot] or nextFrame - frame > correctionWindow
                    return REPLAY_CORRECTION_REJECTED
                earliest = min(earliest, frame)
        // Preflight every replay row before changing either history or live state.
        for frame = earliest to nextFrame - 1
            if not contains(requestedEpoch, frame)
                return REPLAY_CORRECTION_REJECTED
        for i = 0 to corrections.size() - 1
            corrections.copyRow(i, correctionScratch)
            let slot = correctionScratch.frameNumber() mod REPLAY_HISTORY_CAPACITY
            if speculative[slot]
                correctionScratch.copyTo(inputs[slot])
                speculative[slot] = corrections.isSpeculative(i)
        advanceAuthoritative()
        if earliest == nextFrame
            return REPLAY_CORRECTION_UNCHANGED
        restore(requestedEpoch, earliest, world, game, controls, runtime)
        for frame = earliest to nextFrame - 1
            let slot = frame mod REPLAY_HISTORY_CAPACITY
            snapshots[slot].capture(world, game, controls, runtime)
            if inputs[slot].hasNetworkRows() and not inputs[slot].refreshNetworkAdaptation(world, frame)
                return REPLAY_CORRECTION_REJECTED
            inputs[slot].execute(game, world, controls, runtime, frame)
        return earliest
