	capsuleCircleIntersects(9.86154556274414, -6.86391019821167, -5.6012959480285645, 7.704383373260498, 0., 0., 0., 1.7665791511535645, 1.).assertEquals(true)
	capsuleCircleIntersects(8.760266304016113, 6.5879974365234375, -8.983579635620117, -8.832010269165039, 0., 0., 0., 0.7736536860466003, 1.).assertEquals(false)
	capsuleCircleIntersects(-6.00670051574707, 1.2787494659423828, -4.775786399841309, 9.034687042236328, 0., 0., 0., 6.1413068771362305, 1.).assertEquals(false)
