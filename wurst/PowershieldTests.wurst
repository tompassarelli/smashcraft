package PowershieldTests
import Simulation
import ReplayState
import CommandBuffer
import MatchRules
import MatchStep
import ImpactEvents

@Test function fullTriggerWithinObservedWindowStartsAndExpiresReflectState()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	input.shield = true
	input.shieldPressed = true
	input.shieldTriggerActive = true
	input.shieldStrength = 1
	advance(fighter, 0, input, 0)
	fighter.shield.assertTrue()
	fighter.shieldReflectFrames.assertEquals(SHIELD_REFLECTOR_ACTIVE_FRAMES)
	input.shieldPressed = false
	advance(fighter, 0, input, 0)
	fighter.shieldReflectFrames.assertEquals(1)
	advance(fighter, 0, input, 0)
	fighter.shieldReflectFrames.assertEquals(0)
	destroy input
	destroy fighter

@Test function pressureToFullPressHonorsTwoFrameInputWindow()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	input.shieldTriggerActive = true
	advance(fighter, 0, input, 0)
	input.shield = true
	input.shieldPressed = true
	input.shieldStrength = 1
	advance(fighter, 0, input, 0)
	fighter.shieldReflectFrames.assertEquals(SHIELD_REFLECTOR_ACTIVE_FRAMES)
	destroy fighter
	let late = new FighterState(0, 0, 1)
	input.shield = false
	input.shieldPressed = false
	input.shieldStrength = 1
	input.shieldTriggerActive = true
	advance(late, 0, input, 0)
	advance(late, 0, input, 0)
	advance(late, 0, input, 0)
	input.shield = true
	input.shieldPressed = true
	advance(late, 0, input, 0)
	late.shield.assertTrue()
	late.shieldReflectFrames.assertEquals(0)
	destroy input
	destroy late

@Test function reflectorUsesAuthoredCircleAndTransfersScaledProjectile()
	let shooter = new FighterState(0, -30, 1)
	let defender = new FighterState(1, 0, -1)
	shooter.projectileX[0] = -50
	shooter.projectileZ[0] = 45
	shooter.projectileVelocityX[0] = 60
	shooter.projectileVelocityZ[0] = 0
	shooter.projectileDirection[0] = 1
	shooter.projectileKind[0] = PROJECTILE_BLASTER
	shooter.projectileVisualFamily[0] = 0
	shooter.projectileLife[0] = 3
	shooter.projectileDamageMultiplier[0] = 1
	defender.shield = true
	defender.shieldReflectFrames = SHIELD_REFLECTOR_ACTIVE_FRAMES
	defender.shieldGeometry = fighterShieldGeometry(0, 45, 60)
	let events = new ImpactEvents()
	events.before(defender)
	updateProjectilePair(shooter, defender)
	events.after(defender)
    projectileActive(shooter, 0).assertFalse()
    projectileActive(defender, 0).assertTrue()
    projectileDirectionAt(defender, 0).assertEquals(-1)
    projectileVelocityXAt(defender, 0).assertEquals(-42.)
    projectileDamageMultiplierAt(defender, 0).assertEquals(SHIELD_PROJECTILE_DAMAGE_MULTIPLIER)
    projectileVisualFamilyAt(defender, 0).assertEquals(0)
    projectileXAt(defender, 0).assertEquals(10.)
	events.shieldReflect.assertTrue()
	events.shieldHit.assertFalse()
	events.before(defender)
	events.after(defender)
	events.shieldReflect.assertFalse()
	destroy events
	defender.shield = false
	defender.shieldReflectFrames = 0
	updateProjectilePair(shooter, defender)
	let baselineShooter = new FighterState(0, -30, 1)
	let baselineDefender = new FighterState(1, 0, -1)
	baselineShooter.projectileX[0] = -50
	baselineShooter.projectileZ[0] = 45
	baselineShooter.projectileVelocityX[0] = 60
	baselineShooter.projectileKind[0] = PROJECTILE_BLASTER
	baselineShooter.projectileLife[0] = 3
	updateProjectilePair(baselineShooter, baselineDefender)
	(shooter.damage * 2).assertEquals(baselineDefender.damage)
	destroy baselineDefender
	destroy baselineShooter
	destroy defender
	destroy shooter

@Test function replayPreservesReflectClockGeometryAndReflectedProjectilePower()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	let game = new MatchState()
	let commands = new AttackBuffer(0)
	let otherCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let snapshot = new ReplaySnapshot()
	let actual = new ReplaySnapshot()
	first.shieldTriggerWasActive = true
	first.shieldTriggerAge = 1
	first.shieldReflectFrames = 1
	first.shieldGeometry = fighterShieldGeometry(12, 34, 56)
	first.projectileLife[2] = 8
	first.projectileVisualFamily[2] = 0
	first.projectileDamageMultiplier[2] = 0.5
	first.projectileNewlyReflected[2] = true
	snapshot.capture(first, second, game, commands, otherCommands, runtime)
	first.shieldReflectFrames = 0
	first.shieldGeometry = authoredShieldGeometry()
	first.projectileDamageMultiplier[2] = 1
	first.projectileVisualFamily[2] = 1
	first.projectileNewlyReflected[2] = false
	actual.capture(first, second, game, commands, otherCommands, runtime)
	snapshot.firstDifference(actual).assertEquals("first.shieldReflectFrames")
	snapshot.restore(first, second, game, commands, otherCommands, runtime)
	first.shieldTriggerWasActive.assertTrue()
	first.shieldTriggerAge.assertEquals(1)
	first.shieldReflectFrames.assertEquals(1)
	first.shieldGeometry.centerX.assertEquals(12.)
	first.shieldGeometry.centerZ.assertEquals(34.)
	first.shieldGeometry.radius.assertEquals(56.)
	first.projectileDamageMultiplier[2].assertEquals(0.5)
	first.projectileVisualFamily[2].assertEquals(0)
	first.projectileNewlyReflected[2].assertTrue()
	destroy actual
	destroy snapshot
	destroy runtime
	destroy otherCommands
	destroy commands
	destroy game
	destroy second
	destroy first
