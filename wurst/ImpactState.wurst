package ImpactState
import Wurst
import ImpactEvents
import Simulation

public constant int IMPACTS_PER_KIND = 8
public constant int IMPACT_GRAB = 10
public constant int IMPACT_THROW = 11
public constant int IMPACT_CHARGE = 12
public constant int IMPACT_READY = 13
public constant int IMPACT_LEDGE_CATCH = 14
public constant int IMPACT_LEDGE_RECOVERY = 15
public constant int IMPACT_KIND_COUNT = 16
public constant int IMPACT_COUNT = IMPACTS_PER_KIND * IMPACT_KIND_COUNT

public tuple ImpactPose(boolean visible, int alpha, real scale, real x, real z, real pitch)

public function impactLifetime(int kind) returns int
    return kind == 0 or kind == 5 or kind == 6 ? 9 : (kind == 1 ? 15 : (kind == 3 ? 32 : (kind == 8 ? 24 : 12)))

// Ages name completed simulation frames: a newly emitted impact has age zero.
// Projection reads this pool without advancing time or consuming events.
public class ImpactState
    int array[IMPACT_COUNT] ages
    int array[IMPACT_KIND_COUNT] nextSlot
    real array[IMPACT_COUNT] originX
    real array[IMPACT_COUNT] originZ
    int array[IMPACT_COUNT] drift
    real array[IMPACT_COUNT] driftZ
    real array[IMPACT_COUNT] pitch
    real array[IMPACT_COUNT] strength

    construct()
        clear()

    function clear()
        for i = 0 to IMPACT_COUNT - 1
            ages[i] = -1
            originX[i] = 0
            originZ[i] = 0
            drift[i] = 0
            driftZ[i] = 0
            pitch[i] = 0
            strength[i] = 0
        for kind = 0 to IMPACT_KIND_COUNT - 1
            nextSlot[kind] = 0

    function copyTo(ImpactState destination)
        for i = 0 to IMPACT_COUNT - 1
            destination.ages[i] = ages[i]
            destination.originX[i] = originX[i]
            destination.originZ[i] = originZ[i]
            destination.drift[i] = drift[i]
            destination.driftZ[i] = driftZ[i]
            destination.pitch[i] = pitch[i]
            destination.strength[i] = strength[i]
        for kind = 0 to IMPACT_KIND_COUNT - 1
            destination.nextSlot[kind] = nextSlot[kind]

    function firstDifference(ImpactState actual) returns string
        for kind = 0 to IMPACT_KIND_COUNT - 1
            if nextSlot[kind] != actual.nextSlot[kind]
                return "nextSlot[" + I2S(kind) + "]"
        for i = 0 to IMPACT_COUNT - 1
            let prefix = "slot[" + I2S(i) + "]."
            if ages[i] != actual.ages[i]
                return prefix + "age"
            if originX[i] != actual.originX[i]
                return prefix + "originX"
            if originZ[i] != actual.originZ[i]
                return prefix + "originZ"
            if drift[i] != actual.drift[i]
                return prefix + "drift"
            if driftZ[i] != actual.driftZ[i]
                return prefix + "driftZ"
            if pitch[i] != actual.pitch[i]
                return prefix + "pitch"
            if strength[i] != actual.strength[i]
                return prefix + "strength"
        return ""

    function advance()
        for i = 0 to IMPACT_COUNT - 1
            if ages[i] >= 0
                ages[i]++
                if ages[i] >= impactLifetime(i div IMPACTS_PER_KIND)
                    ages[i] = -1

    private function spawn(int kind, real x, real z, int direction, real size) returns int
        let slot = kind * IMPACTS_PER_KIND + nextSlot[kind]
        nextSlot[kind] = (nextSlot[kind] + 1) mod IMPACTS_PER_KIND
        ages[slot] = 0
        originX[slot] = x
        originZ[slot] = z
        drift[slot] = direction
        driftZ[slot] = 0
        pitch[slot] = 0
        strength[slot] = size
        return slot

    private function surfaceFlash(int kind, ImpactEvents events)
        let slot = spawn(kind, events.contactX, events.contactZ, R2I(events.normalX), 0.8)
        pitch[slot] = events.normalX == 0 ? 0. : 1.570796327
        driftZ[slot] = events.normalZ

    function emit(ImpactEvents events, int frame)
        if events.grab
            spawn(IMPACT_GRAB, events.x, events.z + 50, 0, 0.65)
        if events.throwRelease
            spawn(IMPACT_THROW, events.x, events.z + 50, 0, 1.1)
        if events.charge
            spawn(IMPACT_CHARGE, events.x, events.z + 50, 0, 0.5)
        if events.ready
            spawn(IMPACT_READY, events.x, events.z + 65, 0, 0.9)
        if events.ledgeCatch
            spawn(IMPACT_LEDGE_CATCH, events.ledgeX, events.ledgeZ, 0, 0.6)
        if events.ledgeRecovery
            spawn(IMPACT_LEDGE_RECOVERY, events.ledgeX, events.ledgeZ, 0, 0.8)
        if events.hit
            spawn(events.electric ? 5 : 0, events.x, events.z + 50, 0, 1.)
        if events.shieldHit
            spawn(6, events.x, events.z + 50, 0, 1.)
        if events.shieldBreak
            spawn(6, events.x, events.z + 50, 0, 2.)
        if events.landing == IMPACT_TECH
            spawn(1, events.x, events.z + 3, 0, 1.)
        else if events.landing == IMPACT_MISSED_TECH
            spawn(2, events.x, events.z + 2, 0, 1.)
            spawn(3, events.x - 15, events.z + 3, -1, 1.)
            spawn(3, events.x + 15, events.z + 3, 1, 1.)
        if events.surface == SURFACE_TECH_WALL or events.surface == SURFACE_TECH_CEILING
            surfaceFlash(1, events)
        else if events.surfaceMissedTech
            surfaceFlash(2, events)
            surfaceFlash(3, events)
        if events.ordinaryLanding
            spawn(3, events.x - 12, events.z + 2, -1, 0.7)
            spawn(3, events.x + 12, events.z + 2, 1, 0.7)
        if events.jump == 1
            spawn(3, events.jumpOriginX - 12, events.jumpOriginZ + 2, -1, 0.7)
            spawn(3, events.jumpOriginX + 12, events.jumpOriginZ + 2, 1, 0.7)
        else if events.jump == 2 or events.jump == 3
            spawn(7, events.jumpOriginX, events.jumpOriginZ - 5, 0, 1.)
        if events.airDodge
            spawn(4, events.x, events.z + 50, 0, 0.6)
        if events.movementDust or events.dodgeTrail or (events.runningDust and frame mod 8 == 0)
            spawn(3, events.x - events.direction * 12, events.z + 2, -events.direction, 0.45)
        if events.launchTrail
            spawn(3, events.x, events.z + 45, 0, 0.6)
        if events.koDirectionX != 0 or events.koDirectionZ != 0
            let slot = spawn(8, events.x, events.z + 35, events.koDirectionX, 2.)
            driftZ[slot] = events.koDirectionZ * 2.
        if events.respawn
            spawn(9, events.x, events.z + 50, 0, 1.3)
        if events.dodge == 1
            spawn(3, events.x - 8, events.z + 2, -1, 0.65)
            spawn(3, events.x + 8, events.z + 2, 1, 0.65)
        else if events.dodge == 2
            spawn(4, events.x, events.z + 12, 0, 1.)
            spawn(3, events.x - events.direction * 15, events.z + 2, -events.direction, 0.55)

    function project(int i) returns ImpactPose
        if i < 0 or i >= IMPACT_COUNT or ages[i] < 0
            return ImpactPose(false, 0, 0., 0., 0., 0.)
        let kind = i div IMPACTS_PER_KIND
        let age = ages[i]
        let progress = age * 1. / impactLifetime(kind)
        let scale = kind == 3 ? 0.75 + progress * 1.1 : (kind == 2 ? 0.7 + progress * 0.5 : 1. + progress * 0.25)
        let fade = 1. - progress
        return ImpactPose(true, R2I((kind == 3 ? 220 * strength[i] : 255) * fade * fade), scale * strength[i], originX[i] + drift[i] * age * 1.3, originZ[i] + driftZ[i] * age * 1.3 + (kind == 3 ? progress * 9 : 0), pitch[i])
