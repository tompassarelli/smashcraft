package ParryScenario
import Simulation
import CommandBuffer

// A 90-unit gap puts an ordinary Archer jab in range with or without Parry Step.
public function initializeParryScenario(FighterState first, FighterState second)
    first.x = -45
    second.x = 45
    first.facing = 1
    second.facing = -1

// No timing offset: jab frame zero and the human special start in the same row.
// Neutral Special supplies the unprotected control using the same input path.
public function queueParryScenarioJab(InputSnapshot firstInput, FighterState second, AttackBuffer requests, int frame)
    if firstInput.specialPressed and not second.out
        requests.enqueue(0, -1, frame, false)
