package FighterPose
import Simulation
import IllidanMotion
import DamagePose
import FighterAssetInfo
import DemonHunterAssetInfo

public constant real FRAME_SECONDS = 0.016666667

// Completed-frame presentation state. The clip clock is seconds from the most
// recent selection; the asset renderer owns loop/clamp sampling. No engine handles.
public class FighterPose
    string animation = ""
    int jumpAnimationRemaining = 0
    boolean doubleJumpAnimation = false
    real landingAnimationRate = 1.
    IllidanMotion motion = new IllidanMotion()
    int clipIndex = -1
    string clipName = "stand"
    real clipTime = 0.
    real rate = 1.
    int selectionSerial = 0

    ondestroy
        destroy motion

    function selectIndex(int index)
        clipIndex = index
        clipName = ""
        clipTime = 0.
        selectionSerial++

    function selectName(string name)
        clipIndex = -1
        clipName = name
        clipTime = 0.
        selectionSerial++

    function setRate(real value)
        rate = value

    function copyTo(FighterPose destination, FighterRoster source, FighterRoster target)
        destination.animation = animation
        destination.jumpAnimationRemaining = jumpAnimationRemaining
        destination.doubleJumpAnimation = doubleJumpAnimation
        destination.landingAnimationRate = landingAnimationRate
        destination.clipIndex = clipIndex
        destination.clipName = clipName
        destination.clipTime = clipTime
        destination.rate = rate
        destination.selectionSerial = selectionSerial
        motion.copyTo(destination.motion, source, target)

    function firstDifference(FighterPose other, FighterRoster world, FighterRoster otherWorld) returns string
        if animation != other.animation
            return "animation"
        if jumpAnimationRemaining != other.jumpAnimationRemaining
            return "jumpAnimationRemaining"
        if doubleJumpAnimation != other.doubleJumpAnimation
            return "doubleJumpAnimation"
        if landingAnimationRate != other.landingAnimationRate
            return "landingAnimationRate"
        if clipIndex != other.clipIndex
            return "clipIndex"
        if clipName != other.clipName
            return "clipName"
        if clipTime != other.clipTime
            return "clipTime"
        if rate != other.rate
            return "rate"
        if selectionSerial != other.selectionSerial
            return "selectionSerial"
        return motion.firstDifference(other.motion, world, otherWorld)

    function advance(FighterState f, InputSnapshot input, boolean wasOut, boolean jumped, boolean attacked, boolean hit)
        // Integrate the interval that just elapsed, before this frame changes
        // the selection or freezes its rate. A new selection starts at zero.
        clipTime += rate * FRAME_SECONDS
        if attacked and attackPhase(f) != ATTACK_NONE
            playAttackAnimation(f, this)
        motion.advance(f, input)
        if hit
            motion.escapeRemaining = 0
            motion.respawnRemaining = 0
        if f.out
            if f.character == 2 and not wasOut
                selectIndex(DEMON_HUNTER_KO_INDEX)
                setRate(1.)
                animation = "ko"
            return
        if f.frozenFrames > 0
            setRate(0.)
            return
        if f.grounded or f.hitstun > 0 or f.airDodging or attackPhase(f) != ATTACK_NONE or f.specialAction != SPECIAL_NONE or f.downState != DOWN_NONE or f.shieldBreakState != SHIELD_BREAK_NONE or f.ledgeState != LEDGE_NONE
            jumpAnimationRemaining = 0
        else if jumped and not wasOut
            doubleJumpAnimation = f.jumpIsDouble
            jumpAnimationRemaining = doubleJumpAnimation ? 30 : 24
            animation = ""
        else if jumpAnimationRemaining > 0 and f.hitlag <= 0
            jumpAnimationRemaining--
        if f.character == 2 and f.vz < 0 and not motion.ledgeJump
            jumpAnimationRemaining = 0
        let reaction = damagePose(f)
        var animationRate = attackAnimationRate(f)
        if f.ledgeState == LEDGE_CLIMB
            animationRate = characterAnimationSeconds(f.character, ARCHER_LEDGE_CLIMB_SECONDS, RIFLEMAN_LEDGE_CLIMB_SECONDS, DEMON_HUNTER_LEDGE_CLIMB_SECONDS) / (LEDGE_CLIMB_FRAMES * FRAME_SECONDS)
        else if f.ledgeState == LEDGE_ROLL
            animationRate = characterAnimationSeconds(f.character, ARCHER_ROLL_FORWARD_SECONDS, RIFLEMAN_ROLL_FORWARD_SECONDS, DEMON_HUNTER_LEDGE_ROLL_SECONDS) / (LEDGE_ROLL_FRAMES * FRAME_SECONDS)
        else if f.ledgeState == LEDGE_ATTACK
            animationRate = characterAnimationSeconds(f.character, ARCHER_GET_UP_ATTACK_SECONDS, RIFLEMAN_GET_UP_ATTACK_SECONDS, DEMON_HUNTER_LEDGE_ATTACK_SECONDS) / (LEDGE_ATTACK_FRAMES * FRAME_SECONDS)
        else if f.shieldBreakState == SHIELD_BREAK_LAND
            animationRate = characterAnimationSeconds(f.character, ARCHER_KNOCKDOWN_SECONDS, RIFLEMAN_KNOCKDOWN_SECONDS, DEMON_HUNTER_KNOCKDOWN_SECONDS) / (SHIELD_BREAK_LAND_FRAMES * FRAME_SECONDS)
        else if f.shieldBreakState == SHIELD_BREAK_STAND
            animationRate = characterAnimationSeconds(f.character, ARCHER_GET_UP_SECONDS, RIFLEMAN_GET_UP_SECONDS, DEMON_HUNTER_GET_UP_SECONDS) / (SHIELD_BREAK_STAND_FRAMES * FRAME_SECONDS)
        else if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
            animationRate = downAnimationRate(f)
        else if reaction != DAMAGE_POSE_NONE
            animationRate = damageAnimationSeconds(f, reaction) / (24 * FRAME_SECONDS)
        else if f.specialFall
            animationRate = 0.
        else if isGroundDodging(f)
            let duration = f.groundDodgeDirection == 0 ? SPOT_DODGE_FRAMES : GROUND_ROLL_FRAMES
            animationRate = groundDodgeAnimationSeconds(f) / (duration * FRAME_SECONDS)
        else if f.specialAction != SPECIAL_NONE and f.hitstun == 0
            animationRate = specialAnimationSeconds(f) / (f.specialDuration * FRAME_SECONDS)
        else if jumpAnimationRemaining > 0
            animationRate = doubleJumpAnimation ? characterAnimationSeconds(f.character, ARCHER_DOUBLE_JUMP_SECONDS, RIFLEMAN_DOUBLE_JUMP_SECONDS, DEMON_HUNTER_DOUBLE_JUMP_SECONDS) / (30 * FRAME_SECONDS) : characterAnimationSeconds(f.character, ARCHER_JUMP_SECONDS, RIFLEMAN_JUMP_SECONDS, DEMON_HUNTER_JUMP_SECONDS) / (24 * FRAME_SECONDS)
        if inGrabContext(f)
            let victim = f.grabOwner != null
            let owner = victim ? f.grabOwner : f
            let action = owner.grabAction
            let anim = "grab" + I2S(action) + ":" + I2S(owner.grabSerial) + (victim ? ":victim" : ":holder")
            if animation != anim
                if action == GRAB_ESCAPE
                    if f.character == 2
                        selectIndex(DEMON_HUNTER_GRAB_ESCAPE_INDEX)
                    else
                        selectName("stand ready")
                else
                    selectIndex(grabAnimationIndex(f.character, action, victim))
                animation = anim
            animationRate = action >= GRAB_PUMMEL and action <= THROW_DOWN ? grabAnimationSeconds(f.character, action) / (grabActionDuration(action) * FRAME_SECONDS) : 0
            if f.character == 2 and action == GRAB_ESCAPE
                animationRate = DEMON_HUNTER_GRAB_ESCAPE_SECONDS / (grabActionDuration(action) * FRAME_SECONDS)
        else if f.ledgeState != LEDGE_NONE
            let catching = f.character == 2 and f.ledgeState == LEDGE_HANG and motion.ledgeCatchRemaining > 0
            let anim = "ledge" + I2S(f.ledgeState) + (catching ? ":catch" : "")
            if animation != anim
                if catching
                    selectIndex(DEMON_HUNTER_LEDGE_CATCH_INDEX)
                else if f.ledgeState == LEDGE_CLIMB
                    selectIndex(characterAnimationIndex(f.character, ARCHER_LEDGE_CLIMB_INDEX, RIFLEMAN_LEDGE_CLIMB_INDEX, DEMON_HUNTER_LEDGE_CLIMB_INDEX))
                else if f.ledgeState == LEDGE_ROLL
                    selectIndex(characterAnimationIndex(f.character, ARCHER_ROLL_FORWARD_INDEX, RIFLEMAN_ROLL_FORWARD_INDEX, DEMON_HUNTER_LEDGE_ROLL_INDEX))
                else if f.ledgeState == LEDGE_ATTACK
                    selectIndex(characterAnimationIndex(f.character, ARCHER_GET_UP_ATTACK_INDEX, RIFLEMAN_GET_UP_ATTACK_INDEX, DEMON_HUNTER_LEDGE_ATTACK_INDEX))
                else
                    selectIndex(characterAnimationIndex(f.character, ARCHER_LEDGE_HANG_INDEX, RIFLEMAN_LEDGE_HANG_INDEX, DEMON_HUNTER_LEDGE_HANG_INDEX))
                animation = anim
            if catching
                animationRate = DEMON_HUNTER_LEDGE_CATCH_SECONDS / (6 * FRAME_SECONDS)
            else if f.character == 2 and f.ledgeState == LEDGE_HANG
                animationRate = 0.
        else if f.shieldBreakState != SHIELD_BREAK_NONE
            let anim = "shieldbreak" + I2S(f.shieldBreakState)
            if animation != anim
                if f.shieldBreakState == SHIELD_BREAK_LAND
                    selectIndex(characterAnimationIndex(f.character, ARCHER_KNOCKDOWN_INDEX, RIFLEMAN_KNOCKDOWN_INDEX, DEMON_HUNTER_KNOCKDOWN_INDEX))
                else if f.shieldBreakState == SHIELD_BREAK_STAND
                    selectIndex(characterAnimationIndex(f.character, ARCHER_GET_UP_INDEX, RIFLEMAN_GET_UP_INDEX, DEMON_HUNTER_GET_UP_INDEX))
                else if f.character == 2
                    selectIndex(DEMON_HUNTER_SHIELD_BREAK_INDEX)
                else
                    selectName("stand hit")
                animation = anim
        else if f.downState != DOWN_NONE and f.downState != DOWN_TUMBLE and f.downState != DOWN_ATTACK
            let anim = "down" + I2S(f.downState)
            if animation != anim or (f.downState == DOWN_DAMAGE and hit)
                if f.downState == DOWN_WAIT and f.character == 2
                    selectIndex(DEMON_HUNTER_DOWN_WAIT_INDEX)
                else if f.downState != DOWN_WAIT
                    selectIndex(downAnimationIndex(f))
                animation = anim
        else if f.character == 2 and motion.escapeRemaining > 0
            if animation != "grab-escape"
                selectIndex(DEMON_HUNTER_GRAB_ESCAPE_INDEX)
                animation = "grab-escape"
            animationRate = DEMON_HUNTER_GRAB_ESCAPE_SECONDS / (10 * FRAME_SECONDS)
        else if reaction != DAMAGE_POSE_NONE
            let anim = "damage" + I2S(reaction)
            if hit or animation != anim
                selectIndex(damageAnimationIndex(f, reaction))
                animation = anim
        else if f.specialFall
            if animation != "specialfall"
                selectIndex(characterAnimationIndex(f.character, ARCHER_FALL_SPECIAL_INDEX, RIFLEMAN_FALL_SPECIAL_INDEX, DEMON_HUNTER_FALL_SPECIAL_INDEX))
                animation = "specialfall"
        else if isGroundDodging(f)
            if animation != "dodge"
                selectIndex(groundDodgeAnimation(f))
                animation = "dodge"
        else if f.specialAction != SPECIAL_NONE and f.hitstun == 0
            let anim = "special" + I2S(f.specialAction)
            if animation != anim
                selectIndex(specialAnimationIndex(f))
                animation = anim
        else if f.character == 2 and f.airDodging
            if animation != "air-dodge"
                selectIndex(DEMON_HUNTER_AIR_DODGE_INDEX)
                animation = "air-dodge"
            animationRate = DEMON_HUNTER_AIR_DODGE_SECONDS / (AIR_DODGE_ANIMATION_FRAMES * FRAME_SECONDS)
        else if f.character == 2 and f.jumpSquat > 0
            if animation != "jump-squat"
                selectIndex(DEMON_HUNTER_JUMP_SQUAT_INDEX)
                animation = "jump-squat"
            animationRate = DEMON_HUNTER_JUMP_SQUAT_SECONDS / (jumpSquatFrames(f.character) * FRAME_SECONDS)
        else if f.character == 2 and f.grounded and f.landingLag > 0
            if animation != "landing"
                let specialLanding = animation == "specialfall" or animation == "air-dodge"
                selectIndex(specialLanding ? DEMON_HUNTER_LAND_SPECIAL_INDEX : DEMON_HUNTER_LAND_INDEX)
                let seconds = specialLanding ? DEMON_HUNTER_LAND_SPECIAL_SECONDS : DEMON_HUNTER_LAND_SECONDS
                landingAnimationRate = seconds / (f.landingLag * FRAME_SECONDS)
                animation = "landing"
            animationRate = landingAnimationRate
        else if f.character == 2 and f.shield
            let raising = f.shieldHeldFrames <= 4
            let anim = raising ? "shield-raise" : "shield-hold"
            if animation != anim
                selectIndex(raising ? DEMON_HUNTER_SHIELD_RAISE_INDEX : DEMON_HUNTER_SHIELD_HOLD_INDEX)
                animation = anim
            animationRate = raising ? DEMON_HUNTER_SHIELD_RAISE_SECONDS / (4 * FRAME_SECONDS) : 0.
        else if f.character == 2 and f.shieldReleaseLag > 0
            if animation != "shield-release"
                selectIndex(DEMON_HUNTER_SHIELD_RELEASE_INDEX)
                animation = "shield-release"
            animationRate = DEMON_HUNTER_SHIELD_RELEASE_SECONDS / (SHIELD_RELEASE_LAG_FRAMES * FRAME_SECONDS)
        else if f.character == 2 and f.smashCharging
            if animation != "smash-charge"
                selectIndex(illidanSmashIndex(f.attackStyle, true))
                animation = "smash-charge"
            animationRate = 0.
        else if f.character == 2 and attackPhase(f) != ATTACK_NONE and (animation == "smash-charge" or animation == "smash-release")
            if animation == "smash-charge"
                selectIndex(illidanSmashIndex(f.attackStyle, false))
                animation = "smash-release"
            let seconds = f.attackStyle == 2 ? DEMON_HUNTER_UP_SMASH_RELEASE_SECONDS : (f.attackStyle == 3 ? DEMON_HUNTER_DOWN_SMASH_RELEASE_SECONDS : DEMON_HUNTER_FORWARD_SMASH_RELEASE_SECONDS)
            animationRate = seconds / ((f.attackDuration - attackStartupFrames(f.attackStyle)) * FRAME_SECONDS)
        else if f.character == 2 and motion.respawnRemaining > 0
            if animation != "respawn"
                selectIndex(DEMON_HUNTER_RESPAWN_INDEX)
                animation = "respawn"
            animationRate = DEMON_HUNTER_RESPAWN_SECONDS / (24 * FRAME_SECONDS)
        else if f.character == 2 and motion.ledgeJump and jumpAnimationRemaining > 0
            if animation != "ledge-jump"
                selectIndex(DEMON_HUNTER_LEDGE_JUMP_INDEX)
                animation = "ledge-jump"
            animationRate = DEMON_HUNTER_LEDGE_JUMP_SECONDS / (24 * FRAME_SECONDS)
        else if jumpAnimationRemaining > 0
            if animation != "jump"
                selectIndex(doubleJumpAnimation ? characterAnimationIndex(f.character, ARCHER_DOUBLE_JUMP_INDEX, RIFLEMAN_DOUBLE_JUMP_INDEX, DEMON_HUNTER_DOUBLE_JUMP_INDEX) : characterAnimationIndex(f.character, ARCHER_JUMP_INDEX, RIFLEMAN_JUMP_INDEX, DEMON_HUNTER_JUMP_INDEX))
                animation = "jump"
        else if f.character == 2 and attackPhase(f) == ATTACK_NONE and f.hitstun == 0 and f.hitlag == 0
            let anim = "motion" + I2S(motion.motion)
            if animation != anim
                selectIndex(illidanMotionIndex(motion.motion))
                animation = anim
            animationRate = illidanMotionRate(f, motion)
        else if attackPhase(f) == ATTACK_NONE and f.hitstun == 0 and f.hitlag == 0
            let anim = f.character == 2 and not f.grounded ? "fall" : (f.grounded and totalVelocityX(f).abs() > 0.1 ? "walk" : "stand")
            if anim == "walk"
                animationRate = min(1.4, max(0.2, f.vx.abs() / f.physics.runSpeed))
            if anim == "fall"
                animationRate = 0.
            if animation != anim
                if anim == "fall"
                    selectIndex(DEMON_HUNTER_FALL_INDEX)
                else
                    selectName(anim)
                animation = anim
        else
            if animation == "grab-hold" or animation == "grabbed"
                selectName("stand ready")
            animation = ""
        // Select the victim's reaction first; retain the attacker's contact pose.
        // On release only the playback rate changes, so the held clip resumes.
        setRate(f.hitlag > 0 or f.smashCharging ? 0 : animationRate)


function characterAnimationIndex(int character, int archer, int rifleman, int illidan) returns int
    return character == 2 ? illidan : (character == 0 ? archer : rifleman)

function characterAnimationSeconds(int character, real archer, real rifleman, real illidan) returns real
    return character == 2 ? illidan : (character == 0 ? archer : rifleman)

function playAttackAnimation(FighterState fighter, FighterPose pose)
    if fighter.character == 2
        pose.animation = ""
        if fighter.attackStyle == 2
            pose.selectIndex(DEMON_HUNTER_UP_SMASH_INDEX)
            return
        if fighter.attackStyle == 3
            pose.selectIndex(DEMON_HUNTER_DOWN_SMASH_INDEX)
            return
        if fighter.attackStyle == 4
            pose.selectIndex(DEMON_HUNTER_FORWARD_SMASH_INDEX)
            return
        if fighter.attackStyle == DEMONHUNTER_DASH_ATTACK_STYLE
            pose.selectIndex(DEMON_HUNTER_DASH_ATTACK_INDEX)
            return
    if fighter.attackStyle == AERIAL_NEUTRAL_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_AERIAL_NEUTRAL_INDEX, RIFLEMAN_AERIAL_NEUTRAL_INDEX, DEMON_HUNTER_AERIAL_NEUTRAL_INDEX))
        return
    if fighter.attackStyle == AERIAL_FORWARD_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_AERIAL_FORWARD_INDEX, RIFLEMAN_AERIAL_FORWARD_INDEX, DEMON_HUNTER_AERIAL_FORWARD_INDEX))
        return
    if fighter.attackStyle == AERIAL_BACK_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_AERIAL_BACK_INDEX, RIFLEMAN_AERIAL_BACK_INDEX, DEMON_HUNTER_AERIAL_BACK_INDEX))
        return
    if fighter.attackStyle == AERIAL_UP_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_AERIAL_UP_INDEX, RIFLEMAN_AERIAL_UP_INDEX, DEMON_HUNTER_AERIAL_UP_INDEX))
        return
    if fighter.attackStyle == AERIAL_DOWN_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_AERIAL_DOWN_INDEX, RIFLEMAN_AERIAL_DOWN_INDEX, DEMON_HUNTER_AERIAL_DOWN_INDEX))
        return
    if fighter.attackStyle == 0
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_JAB_INDEX, RIFLEMAN_JAB_INDEX, DEMON_HUNTER_ATTACK_JAB_INDEX))
        return
    if fighter.attackStyle == 5
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_GRAB_INDEX, RIFLEMAN_GRAB_INDEX, DEMON_HUNTER_GRAB_INDEX))
        return
    if fighter.attackStyle == 6
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_FORWARD_TILT_INDEX, RIFLEMAN_FORWARD_TILT_INDEX, DEMON_HUNTER_FORWARD_TILT_INDEX))
        return
    if fighter.attackStyle == 7
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_UP_TILT_INDEX, RIFLEMAN_UP_TILT_INDEX, DEMON_HUNTER_UP_TILT_INDEX))
        return
    if fighter.attackStyle == 8
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_DOWN_TILT_INDEX, RIFLEMAN_DOWN_TILT_INDEX, DEMON_HUNTER_DOWN_TILT_INDEX))
        return
    if fighter.attackStyle == 9
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_FORWARD_TILT_UP_INDEX, RIFLEMAN_FORWARD_TILT_UP_INDEX, DEMON_HUNTER_FORWARD_TILT_UP_INDEX))
        return
    if fighter.attackStyle == 10
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_FORWARD_TILT_DOWN_INDEX, RIFLEMAN_FORWARD_TILT_DOWN_INDEX, DEMON_HUNTER_FORWARD_TILT_DOWN_INDEX))
        return
    if fighter.attackStyle == DOWN_ATTACK_STYLE or fighter.attackStyle == LEDGE_ATTACK_STYLE
        pose.selectIndex(characterAnimationIndex(fighter.character, ARCHER_GET_UP_ATTACK_INDEX, RIFLEMAN_GET_UP_ATTACK_INDEX, DEMON_HUNTER_GET_UP_ATTACK_INDEX))
        return
    pose.selectName("attack")

function attackAnimationRate(FighterState fighter) returns real
    if attackPhase(fighter) == ATTACK_NONE
        return 1.
    let seconds = fighter.attackDuration * FRAME_SECONDS
    if fighter.character == 2
        if fighter.attackStyle == 2
            return DEMON_HUNTER_UP_SMASH_SECONDS / seconds
        if fighter.attackStyle == 3
            return DEMON_HUNTER_DOWN_SMASH_SECONDS / seconds
        if fighter.attackStyle == 4
            return DEMON_HUNTER_FORWARD_SMASH_SECONDS / seconds
        if fighter.attackStyle == DEMONHUNTER_DASH_ATTACK_STYLE
            return DEMON_HUNTER_DASH_ATTACK_SECONDS / seconds
    if fighter.attackStyle == AERIAL_NEUTRAL_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_AERIAL_NEUTRAL_SECONDS, RIFLEMAN_AERIAL_NEUTRAL_SECONDS, DEMON_HUNTER_AERIAL_NEUTRAL_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_FORWARD_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_AERIAL_FORWARD_SECONDS, RIFLEMAN_AERIAL_FORWARD_SECONDS, DEMON_HUNTER_AERIAL_FORWARD_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_BACK_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_AERIAL_BACK_SECONDS, RIFLEMAN_AERIAL_BACK_SECONDS, DEMON_HUNTER_AERIAL_BACK_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_UP_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_AERIAL_UP_SECONDS, RIFLEMAN_AERIAL_UP_SECONDS, DEMON_HUNTER_AERIAL_UP_SECONDS) / seconds
    if fighter.attackStyle == AERIAL_DOWN_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_AERIAL_DOWN_SECONDS, RIFLEMAN_AERIAL_DOWN_SECONDS, DEMON_HUNTER_AERIAL_DOWN_SECONDS) / seconds
    if fighter.attackStyle == 0
        return characterAnimationSeconds(fighter.character, ARCHER_JAB_SECONDS, RIFLEMAN_JAB_SECONDS, DEMON_HUNTER_ATTACK_JAB_SECONDS) / seconds
    if fighter.attackStyle == 5
        return characterAnimationSeconds(fighter.character, ARCHER_GRAB_SECONDS, RIFLEMAN_GRAB_SECONDS, DEMON_HUNTER_GRAB_SECONDS) / seconds
    if fighter.attackStyle == 6
        return characterAnimationSeconds(fighter.character, ARCHER_FORWARD_TILT_SECONDS, RIFLEMAN_FORWARD_TILT_SECONDS, DEMON_HUNTER_FORWARD_TILT_SECONDS) / seconds
    if fighter.attackStyle == 7
        return characterAnimationSeconds(fighter.character, ARCHER_UP_TILT_SECONDS, RIFLEMAN_UP_TILT_SECONDS, DEMON_HUNTER_UP_TILT_SECONDS) / seconds
    if fighter.attackStyle == 8
        return characterAnimationSeconds(fighter.character, ARCHER_DOWN_TILT_SECONDS, RIFLEMAN_DOWN_TILT_SECONDS, DEMON_HUNTER_DOWN_TILT_SECONDS) / seconds
    if fighter.attackStyle == 9
        return characterAnimationSeconds(fighter.character, ARCHER_FORWARD_TILT_UP_SECONDS, RIFLEMAN_FORWARD_TILT_UP_SECONDS, DEMON_HUNTER_FORWARD_TILT_UP_SECONDS) / seconds
    if fighter.attackStyle == 10
        return characterAnimationSeconds(fighter.character, ARCHER_FORWARD_TILT_DOWN_SECONDS, RIFLEMAN_FORWARD_TILT_DOWN_SECONDS, DEMON_HUNTER_FORWARD_TILT_DOWN_SECONDS) / seconds
    if fighter.attackStyle == DOWN_ATTACK_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_GET_UP_ATTACK_SECONDS, RIFLEMAN_GET_UP_ATTACK_SECONDS, DEMON_HUNTER_GET_UP_ATTACK_SECONDS) / seconds
    if fighter.attackStyle == LEDGE_ATTACK_STYLE
        return characterAnimationSeconds(fighter.character, ARCHER_GET_UP_ATTACK_SECONDS, RIFLEMAN_GET_UP_ATTACK_SECONDS, DEMON_HUNTER_GET_UP_ATTACK_SECONDS) / (LEDGE_ATTACK_FRAMES * FRAME_SECONDS)
    return 1.

function downAnimationIndex(FighterState fighter) returns int
    if fighter.character == 2
        if fighter.downState == DOWN_TECH
            return DEMON_HUNTER_TECH_NEUTRAL_INDEX
        if fighter.downState == DOWN_TECH_ROLL
            return fighter.downDirection == fighter.facing ? DEMON_HUNTER_TECH_FORWARD_INDEX : DEMON_HUNTER_TECH_BACK_INDEX
        if fighter.downState == DOWN_ROLL
            return fighter.downDirection == fighter.facing ? DEMON_HUNTER_GET_UP_ROLL_FORWARD_INDEX : DEMON_HUNTER_GET_UP_ROLL_BACK_INDEX
    if fighter.downState == DOWN_DAMAGE
        return characterAnimationIndex(fighter.character, ARCHER_DOWN_DAMAGE_INDEX, RIFLEMAN_DOWN_DAMAGE_INDEX, DEMON_HUNTER_DOWN_DAMAGE_INDEX)
    if fighter.downState == DOWN_BOUND or fighter.downState == DOWN_WAIT
        return characterAnimationIndex(fighter.character, ARCHER_KNOCKDOWN_INDEX, RIFLEMAN_KNOCKDOWN_INDEX, DEMON_HUNTER_KNOCKDOWN_INDEX)
    if fighter.downState == DOWN_STAND or fighter.downState == DOWN_TECH
        return characterAnimationIndex(fighter.character, ARCHER_GET_UP_INDEX, RIFLEMAN_GET_UP_INDEX, DEMON_HUNTER_GET_UP_INDEX)
    return fighter.downDirection == fighter.facing ? characterAnimationIndex(fighter.character, ARCHER_ROLL_FORWARD_INDEX, RIFLEMAN_ROLL_FORWARD_INDEX, DEMON_HUNTER_ROLL_FORWARD_INDEX) : characterAnimationIndex(fighter.character, ARCHER_ROLL_BACKWARD_INDEX, RIFLEMAN_ROLL_BACKWARD_INDEX, DEMON_HUNTER_ROLL_BACKWARD_INDEX)

function downAnimationRate(FighterState fighter) returns real
    if fighter.character == 2
        if fighter.downState == DOWN_TECH
            return DEMON_HUNTER_TECH_NEUTRAL_SECONDS / (TECH_IN_PLACE_FRAMES * FRAME_SECONDS)
        if fighter.downState == DOWN_TECH_ROLL
            return (fighter.downDirection == fighter.facing ? DEMON_HUNTER_TECH_FORWARD_SECONDS : DEMON_HUNTER_TECH_BACK_SECONDS) / (TECH_ROLL_FRAMES * FRAME_SECONDS)
        if fighter.downState == DOWN_ROLL
            return (fighter.downDirection == fighter.facing ? DEMON_HUNTER_GET_UP_ROLL_FORWARD_SECONDS : DEMON_HUNTER_GET_UP_ROLL_BACK_SECONDS) / (DOWN_ROLL_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_DAMAGE
        return characterAnimationSeconds(fighter.character, ARCHER_DOWN_DAMAGE_SECONDS, RIFLEMAN_DOWN_DAMAGE_SECONDS, DEMON_HUNTER_DOWN_DAMAGE_SECONDS) / (DOWN_DAMAGE_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_WAIT
        return 0.
    if fighter.downState == DOWN_BOUND
        return characterAnimationSeconds(fighter.character, ARCHER_KNOCKDOWN_SECONDS, RIFLEMAN_KNOCKDOWN_SECONDS, DEMON_HUNTER_KNOCKDOWN_SECONDS) / (DOWN_BOUND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_STAND
        return characterAnimationSeconds(fighter.character, ARCHER_GET_UP_SECONDS, RIFLEMAN_GET_UP_SECONDS, DEMON_HUNTER_GET_UP_SECONDS) / (DOWN_STAND_FRAMES * FRAME_SECONDS)
    if fighter.downState == DOWN_TECH
        return characterAnimationSeconds(fighter.character, ARCHER_GET_UP_SECONDS, RIFLEMAN_GET_UP_SECONDS, DEMON_HUNTER_GET_UP_SECONDS) / (TECH_IN_PLACE_FRAMES * FRAME_SECONDS)
    let seconds = fighter.downDirection == fighter.facing ? characterAnimationSeconds(fighter.character, ARCHER_ROLL_FORWARD_SECONDS, RIFLEMAN_ROLL_FORWARD_SECONDS, DEMON_HUNTER_ROLL_FORWARD_SECONDS) : characterAnimationSeconds(fighter.character, ARCHER_ROLL_BACKWARD_SECONDS, RIFLEMAN_ROLL_BACKWARD_SECONDS, DEMON_HUNTER_ROLL_BACKWARD_SECONDS)
    return seconds / ((fighter.downState == DOWN_TECH_ROLL ? TECH_ROLL_FRAMES : DOWN_ROLL_FRAMES) * FRAME_SECONDS)

function groundDodgeAnimation(FighterState fighter) returns int
    if fighter.groundDodgeDirection == 0
        return characterAnimationIndex(fighter.character, ARCHER_SPOT_DODGE_INDEX, RIFLEMAN_SPOT_DODGE_INDEX, DEMON_HUNTER_SPOT_DODGE_INDEX)
    return isForwardGroundRoll(fighter) ? characterAnimationIndex(fighter.character, ARCHER_ROLL_FORWARD_INDEX, RIFLEMAN_ROLL_FORWARD_INDEX, DEMON_HUNTER_ROLL_FORWARD_INDEX) : characterAnimationIndex(fighter.character, ARCHER_ROLL_BACKWARD_INDEX, RIFLEMAN_ROLL_BACKWARD_INDEX, DEMON_HUNTER_ROLL_BACKWARD_INDEX)

function groundDodgeAnimationSeconds(FighterState fighter) returns real
    if fighter.groundDodgeDirection == 0
        return characterAnimationSeconds(fighter.character, ARCHER_SPOT_DODGE_SECONDS, RIFLEMAN_SPOT_DODGE_SECONDS, DEMON_HUNTER_SPOT_DODGE_SECONDS)
    return isForwardGroundRoll(fighter) ? characterAnimationSeconds(fighter.character, ARCHER_ROLL_FORWARD_SECONDS, RIFLEMAN_ROLL_FORWARD_SECONDS, DEMON_HUNTER_ROLL_FORWARD_SECONDS) : characterAnimationSeconds(fighter.character, ARCHER_ROLL_BACKWARD_SECONDS, RIFLEMAN_ROLL_BACKWARD_SECONDS, DEMON_HUNTER_ROLL_BACKWARD_SECONDS)

function specialAnimationIndex(FighterState f) returns int
    if f.specialAction == SPECIAL_DEMONHUNTER_MANA_BURN
        return f.grounded ? DEMON_HUNTER_SPECIAL_NEUTRAL_INDEX : DEMON_HUNTER_SPECIAL_NEUTRAL_AIR_INDEX
    if f.specialAction == SPECIAL_DEMONHUNTER_PARRY_STEP
        return f.grounded ? DEMON_HUNTER_SPECIAL_SIDE_INDEX : DEMON_HUNTER_SPECIAL_SIDE_AIR_INDEX
    if f.specialAction == SPECIAL_DEMONHUNTER_WING_ASCENT
        return f.grounded ? DEMON_HUNTER_SPECIAL_UP_INDEX : DEMON_HUNTER_SPECIAL_UP_AIR_INDEX
    if f.specialAction == SPECIAL_DEMONHUNTER_IMMOLATE
        return f.grounded ? DEMON_HUNTER_SPECIAL_DOWN_INDEX : DEMON_HUNTER_SPECIAL_DOWN_AIR_INDEX
    if f.specialAction == SPECIAL_ARCHER_ARROW
        return ARCHER_SPECIAL_NEUTRAL_INDEX
    if f.specialAction == SPECIAL_ARCHER_MULTISHOT
        return ARCHER_SPECIAL_SIDE_INDEX
    if f.specialAction == SPECIAL_ARCHER_DISENGAGE
        return ARCHER_SPECIAL_DOWN_INDEX
    if f.specialAction == SPECIAL_ARCHER_RECOVERY
        return ARCHER_SPECIAL_UP_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_BEAR
        return RIFLEMAN_SPECIAL_SIDE_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_TRAP
        return RIFLEMAN_SPECIAL_DOWN_INDEX
    if f.specialAction == SPECIAL_RIFLEMAN_RECOVERY
        return RIFLEMAN_SPECIAL_UP_INDEX
    if f.specialDuration == attackDurationFramesForGrounding(1, false)
        return RIFLEMAN_SPECIAL_NEUTRAL_AIR_INDEX
    return RIFLEMAN_SPECIAL_NEUTRAL_INDEX

function specialAnimationSeconds(FighterState f) returns real
    if f.specialAction == SPECIAL_DEMONHUNTER_MANA_BURN
        return f.grounded ? DEMON_HUNTER_SPECIAL_NEUTRAL_SECONDS : DEMON_HUNTER_SPECIAL_NEUTRAL_AIR_SECONDS
    if f.specialAction == SPECIAL_DEMONHUNTER_PARRY_STEP
        return f.grounded ? DEMON_HUNTER_SPECIAL_SIDE_SECONDS : DEMON_HUNTER_SPECIAL_SIDE_AIR_SECONDS
    if f.specialAction == SPECIAL_DEMONHUNTER_WING_ASCENT
        return f.grounded ? DEMON_HUNTER_SPECIAL_UP_SECONDS : DEMON_HUNTER_SPECIAL_UP_AIR_SECONDS
    if f.specialAction == SPECIAL_DEMONHUNTER_IMMOLATE
        return f.grounded ? DEMON_HUNTER_SPECIAL_DOWN_SECONDS : DEMON_HUNTER_SPECIAL_DOWN_AIR_SECONDS
    if f.specialAction == SPECIAL_ARCHER_ARROW
        return ARCHER_SPECIAL_NEUTRAL_SECONDS
    if f.specialAction == SPECIAL_ARCHER_MULTISHOT
        return ARCHER_SPECIAL_SIDE_SECONDS
    if f.specialAction == SPECIAL_ARCHER_DISENGAGE
        return ARCHER_SPECIAL_DOWN_SECONDS
    if f.specialAction == SPECIAL_ARCHER_RECOVERY
        return ARCHER_SPECIAL_UP_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_BEAR
        return RIFLEMAN_SPECIAL_SIDE_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_TRAP
        return RIFLEMAN_SPECIAL_DOWN_SECONDS
    if f.specialAction == SPECIAL_RIFLEMAN_RECOVERY
        return RIFLEMAN_SPECIAL_UP_SECONDS
    if f.specialDuration == attackDurationFramesForGrounding(1, false)
        return RIFLEMAN_SPECIAL_NEUTRAL_AIR_SECONDS
    return RIFLEMAN_SPECIAL_NEUTRAL_SECONDS

function damageAnimationIndex(FighterState f, int pose) returns int
    if pose == DAMAGE_POSE_GROUND
        return characterAnimationIndex(f.character, ARCHER_DAMAGE_GROUND_INDEX, RIFLEMAN_DAMAGE_GROUND_INDEX, DEMON_HUNTER_DAMAGE_GROUND_INDEX)
    if pose == DAMAGE_POSE_TUMBLE
        return characterAnimationIndex(f.character, ARCHER_DAMAGE_TUMBLE_INDEX, RIFLEMAN_DAMAGE_TUMBLE_INDEX, DEMON_HUNTER_DAMAGE_TUMBLE_INDEX)
    if pose == DAMAGE_POSE_SHIELD
        return characterAnimationIndex(f.character, ARCHER_DAMAGE_SHIELD_INDEX, RIFLEMAN_DAMAGE_SHIELD_INDEX, DEMON_HUNTER_DAMAGE_SHIELD_INDEX)
    return characterAnimationIndex(f.character, ARCHER_DAMAGE_AIR_INDEX, RIFLEMAN_DAMAGE_AIR_INDEX, DEMON_HUNTER_DAMAGE_AIR_INDEX)

function damageAnimationSeconds(FighterState f, int pose) returns real
    if pose == DAMAGE_POSE_GROUND
        return characterAnimationSeconds(f.character, ARCHER_DAMAGE_GROUND_SECONDS, RIFLEMAN_DAMAGE_GROUND_SECONDS, DEMON_HUNTER_DAMAGE_GROUND_SECONDS)
    if pose == DAMAGE_POSE_TUMBLE
        return characterAnimationSeconds(f.character, ARCHER_DAMAGE_TUMBLE_SECONDS, RIFLEMAN_DAMAGE_TUMBLE_SECONDS, DEMON_HUNTER_DAMAGE_TUMBLE_SECONDS)
    if pose == DAMAGE_POSE_SHIELD
        return characterAnimationSeconds(f.character, ARCHER_DAMAGE_SHIELD_SECONDS, RIFLEMAN_DAMAGE_SHIELD_SECONDS, DEMON_HUNTER_DAMAGE_SHIELD_SECONDS)
    return characterAnimationSeconds(f.character, ARCHER_DAMAGE_AIR_SECONDS, RIFLEMAN_DAMAGE_AIR_SECONDS, DEMON_HUNTER_DAMAGE_AIR_SECONDS)

function grabAnimationIndex(int character, int action, boolean victim) returns int
    if action == GRAB_PUMMEL
        if victim
            return characterAnimationIndex(character, ARCHER_VICTIM_PUMMEL_INDEX, RIFLEMAN_VICTIM_PUMMEL_INDEX, DEMON_HUNTER_VICTIM_PUMMEL_INDEX)
        return characterAnimationIndex(character, ARCHER_PUMMEL_INDEX, RIFLEMAN_PUMMEL_INDEX, DEMON_HUNTER_PUMMEL_INDEX)
    if action == THROW_FORWARD
        if victim
            return characterAnimationIndex(character, ARCHER_VICTIM_THROW_FORWARD_INDEX, RIFLEMAN_VICTIM_THROW_FORWARD_INDEX, DEMON_HUNTER_VICTIM_THROW_FORWARD_INDEX)
        return characterAnimationIndex(character, ARCHER_THROW_FORWARD_INDEX, RIFLEMAN_THROW_FORWARD_INDEX, DEMON_HUNTER_THROW_FORWARD_INDEX)
    if action == THROW_BACK
        if victim
            return characterAnimationIndex(character, ARCHER_VICTIM_THROW_BACK_INDEX, RIFLEMAN_VICTIM_THROW_BACK_INDEX, DEMON_HUNTER_VICTIM_THROW_BACK_INDEX)
        return characterAnimationIndex(character, ARCHER_THROW_BACK_INDEX, RIFLEMAN_THROW_BACK_INDEX, DEMON_HUNTER_THROW_BACK_INDEX)
    if action == THROW_UP
        if victim
            return characterAnimationIndex(character, ARCHER_VICTIM_THROW_UP_INDEX, RIFLEMAN_VICTIM_THROW_UP_INDEX, DEMON_HUNTER_VICTIM_THROW_UP_INDEX)
        return characterAnimationIndex(character, ARCHER_THROW_UP_INDEX, RIFLEMAN_THROW_UP_INDEX, DEMON_HUNTER_THROW_UP_INDEX)
    if action == THROW_DOWN
        if victim
            return characterAnimationIndex(character, ARCHER_VICTIM_THROW_DOWN_INDEX, RIFLEMAN_VICTIM_THROW_DOWN_INDEX, DEMON_HUNTER_VICTIM_THROW_DOWN_INDEX)
        return characterAnimationIndex(character, ARCHER_THROW_DOWN_INDEX, RIFLEMAN_THROW_DOWN_INDEX, DEMON_HUNTER_THROW_DOWN_INDEX)
    if character == 2
        return victim ? DEMON_HUNTER_GRABBED_INDEX : DEMON_HUNTER_GRAB_HOLD_INDEX
    return character == 0 ? (victim ? ARCHER_GRABBED_INDEX : ARCHER_GRAB_HOLD_INDEX) : (victim ? RIFLEMAN_GRABBED_INDEX : RIFLEMAN_GRAB_HOLD_INDEX)

function grabAnimationSeconds(int character, int action) returns real
    if action == GRAB_PUMMEL
        return characterAnimationSeconds(character, ARCHER_PUMMEL_SECONDS, RIFLEMAN_PUMMEL_SECONDS, DEMON_HUNTER_PUMMEL_SECONDS)
    if action == THROW_FORWARD
        return characterAnimationSeconds(character, ARCHER_THROW_FORWARD_SECONDS, RIFLEMAN_THROW_FORWARD_SECONDS, DEMON_HUNTER_THROW_FORWARD_SECONDS)
    if action == THROW_BACK
        return characterAnimationSeconds(character, ARCHER_THROW_BACK_SECONDS, RIFLEMAN_THROW_BACK_SECONDS, DEMON_HUNTER_THROW_BACK_SECONDS)
    if action == THROW_UP
        return characterAnimationSeconds(character, ARCHER_THROW_UP_SECONDS, RIFLEMAN_THROW_UP_SECONDS, DEMON_HUNTER_THROW_UP_SECONDS)
    if action == THROW_DOWN
        return characterAnimationSeconds(character, ARCHER_THROW_DOWN_SECONDS, RIFLEMAN_THROW_DOWN_SECONDS, DEMON_HUNTER_THROW_DOWN_SECONDS)
    return 0.

function illidanMotionIndex(int motion) returns int
    if motion == ILLIDAN_WALK
        return DEMON_HUNTER_WALK_FORWARD_INDEX
    if motion == ILLIDAN_RUN
        return DEMON_HUNTER_RUN_FORWARD_INDEX
    if motion == ILLIDAN_DASH
        return DEMON_HUNTER_DASH_START_INDEX
    if motion == ILLIDAN_TURN
        return DEMON_HUNTER_TURNAROUND_INDEX
    if motion == ILLIDAN_STOP
        return DEMON_HUNTER_STOP_INDEX
    if motion == ILLIDAN_CROUCH
        return DEMON_HUNTER_CROUCH_INDEX
    if motion == ILLIDAN_FAST_FALL
        return DEMON_HUNTER_FAST_FALL_INDEX
    if motion == ILLIDAN_FALL
        return DEMON_HUNTER_FALL_INDEX
    return DEMON_HUNTER_COMBAT_IDLE_INDEX

function illidanSmashIndex(int style, boolean charge) returns int
    if style == 2
        return charge ? DEMON_HUNTER_UP_SMASH_CHARGE_INDEX : DEMON_HUNTER_UP_SMASH_RELEASE_INDEX
    if style == 3
        return charge ? DEMON_HUNTER_DOWN_SMASH_CHARGE_INDEX : DEMON_HUNTER_DOWN_SMASH_RELEASE_INDEX
    return charge ? DEMON_HUNTER_FORWARD_SMASH_CHARGE_INDEX : DEMON_HUNTER_FORWARD_SMASH_RELEASE_INDEX

function illidanMotionRate(FighterState f, IllidanMotion history) returns real
    let motion = history.motion
    if motion == ILLIDAN_DASH
        return DEMON_HUNTER_DASH_START_SECONDS / (INITIAL_DASH_FRAMES * FRAME_SECONDS)
    if motion == ILLIDAN_TURN
        return DEMON_HUNTER_TURNAROUND_SECONDS / (8 * FRAME_SECONDS)
    if motion == ILLIDAN_STOP
        return DEMON_HUNTER_STOP_SECONDS / (8 * FRAME_SECONDS)
    if motion == ILLIDAN_CROUCH
        return DEMON_HUNTER_CROUCH_SECONDS / (24 * FRAME_SECONDS)
    if motion == ILLIDAN_FALL or motion == ILLIDAN_FAST_FALL
        return 0.
    if motion == ILLIDAN_WALK
        return max(0.2, f.vx.abs() / f.physics.walkSpeed)
    if motion == ILLIDAN_RUN
        return max(0.2, f.vx.abs() / f.physics.runSpeed)
    return 1.

