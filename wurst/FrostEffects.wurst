package FrostEffects
import Wurst
import Simulation
import ParticipantInputs
import FrostAssetInfo

// Fixed common-init handles; presentation follows numerical state and can be
// reapplied after a restore without spawning another trap or ice shell.
public class FrostEffects
    private effect array[INPUT_PARTICIPANT_CAPACITY] traps
    private effect array[INPUT_PARTICIPANT_CAPACITY] iceShells
    private real worldX
    private real worldY
    private real worldZ

    construct(real x, real y, real z)
        worldX = x
        worldY = y
        worldZ = z
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            traps[slot] = AddSpecialEffect(FROST_TRAP_MODEL, x, y)
            iceShells[slot] = AddSpecialEffect(FROST_ICE_MODEL, x, y)
        clear()

    private function hide(effect model)
        BlzSetSpecialEffectAlpha(model, 0)
        BlzSetSpecialEffectScale(model, 0.)

    function clear()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            hideSlot(slot)

    function hideSlot(int slot)
        hide(traps[slot])
        hide(iceShells[slot])

    private function apply(FighterState fighter, effect trap, effect ice)
        if fighter.freezeTrapLife > 0 and not fighter.out
            BlzSetSpecialEffectPosition(trap, worldX + fighter.freezeTrapX, worldY, worldZ + fighter.freezeTrapZ)
            BlzSetSpecialEffectScale(trap, 1.)
            BlzSetSpecialEffectAlpha(trap, fighter.freezeTrapArming > 0 ? 100 : 255)
        else
            hide(trap)
        if fighter.frozenFrames > 0 and not fighter.out
            BlzSetSpecialEffectPosition(ice, worldX + fighter.x, worldY, worldZ + fighter.z)
            BlzSetSpecialEffectScale(ice, 1.)
            BlzSetSpecialEffectAlpha(ice, 255)
        else
            hide(ice)

    function present(FighterState fighter, int slot)
        apply(fighter, traps[slot], iceShells[slot])
