package RecoveryTests
import Simulation
import ReplayState
import MatchRules
import CommandBuffer
import MatchStep

// Test-only grounded-motion profile; no character or move data enters the roster.
function floorRecoveryReferencePhysics() returns fighterPhysics
	var physics = archerPhysics()
	physics.traction = 0.07999999821186066 * 6
	return physics

function recordedFloorRecoveryPosition(boolean tech, int sample) returns real
	if tech
		if sample == 1
			return -42.34517288208008
		if sample == 2
			return -42.67805099487305
		if sample == 3
			return -42.930931091308594
		if sample == 4
			return -43.10380935668945
		if sample == 5
			return -43.196685791015625
		return -43.209564208984375
	if sample == 1
		return -38.086673736572266
	if sample == 2
		return -38.44503402709961
	return -38.72339630126953

function recordedFloorRecoveryKnockback(boolean tech, int sample) returns real
	if tech
		if sample == 1
			return -0.41287824511528015
		if sample == 2
			return -0.3328782618045807
		if sample == 3
			return -0.2528782784938812
		if sample == 4
			return -0.17287829518318176
		if sample == 5
			return -0.0928783044219017
		if sample == 6
			return -0.012878312729299068
		return 0
	if sample == 1
		return -0.4383614957332611
	if sample == 2
		return -0.35836151242256165
	return -0.2783615291118622

function recordedFloorRecoveryFirstDifference(int character, boolean tech, real velocityOffset) returns int
	let fighter = new FighterState(character, (tech ? -41.93229293823242 : -37.648311614990234) * 6, 1)
	fighter.physics = floorRecoveryReferencePhysics()
	fighter.downState = tech ? DOWN_TECH : DOWN_BOUND
	fighter.downFrame = 1
	fighter.knockbackX = (tech ? -0.492878258228302 : -0.5183614492416382) * 6 + velocityOffset
	fighter.damage = tech ? 25 : 42.5
	let input = new InputSnapshot()
	input.shield = true
	input.direction = tech ? 0 : -1
	var firstDifference = 0
	for sample = 1 to (tech ? 7 : 3)
		advance(fighter, 0, input, 0)
		if firstDifference == 0 and ((fighter.x - recordedFloorRecoveryPosition(tech, sample) * 6).abs() > 0.0001
			or (fighter.knockbackX - recordedFloorRecoveryKnockback(tech, sample) * 6).abs() > 0.00001
			or not fighter.grounded or fighter.vx != 0 or fighter.knockbackZ != 0 or fighter.hitlag != 0
			or fighter.downState != (tech ? DOWN_TECH : DOWN_BOUND) or fighter.downFrame != sample + 1
			or fighter.damage != (tech ? 25 : 42.5) or fighter.shield or canAttack(fighter))
			firstDifference = (tech ? 203 : 955) + sample
	destroy input
	destroy fighter
	return firstDifference

@Test function recordedFloorRecoverySkidsMatchTechAndMissedTechOnBothOriginalHosts()
	for character = 0 to 1
		recordedFloorRecoveryFirstDifference(character, true, 0).assertEquals(0)
		recordedFloorRecoveryFirstDifference(character, false, 0).assertEquals(0)

@Test function recordedFloorRecoveryDetectsWrongKnockbackOnItsFirstFrame()
	recordedFloorRecoveryFirstDifference(0, true, 0.06).assertEquals(204)
	recordedFloorRecoveryFirstDifference(0, false, 0.06).assertEquals(956)

@Test function floorRecoveryEntryPreservesResidualHorizontalKnockback()
	for character = 0 to 1
		for recovery = 0 to 2
			let fighter = new FighterState(character, 0, 1)
			let input = new InputSnapshot()
			fighter.physics = floorRecoveryReferencePhysics()
			fighter.grounded = false
			fighter.surface = -1
			fighter.z = 1
			fighter.vz = -2
			fighter.knockbackX = -0.5 * 6
			fighter.hitstun = 20
			fighter.downState = DOWN_TUMBLE
			input.techPressed = recovery > 0
			input.direction = recovery == 2 ? -1 : 0
			advance(fighter, 0, input, 0)
			fighter.grounded.assertTrue()
			fighter.downState.assertEquals(recovery == 0 ? DOWN_BOUND : (recovery == 1 ? DOWN_TECH : DOWN_TECH_ROLL))
			fighter.knockbackX.assertEquals((-0.5 + 0.051) * 6, 0.00001)
			destroy input
			destroy fighter

function weakRecoveryHit(int direction, FighterState attacker, FighterState target)
	attacker.facing = direction
	target.facing = -direction
	target.x = direction * 50.
	target.surface = 0
	target.grounded = true
	target.downState = DOWN_WAIT
	target.downFrame = 20
	target.downWaitRemaining = 100
	target.downFaceUp = false
	beginAttackPair(attacker, target, 6, -1, false, false)
	attacker.attackFrame = attackStartupFrames(6) + 1
	resolveAttackPair(attacker, target)

@Test function downboundAndGetupActionsUseTheirOwnFrameCounts()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	fighter.surface = 0
	fighter.grounded = true
	fighter.downState = DOWN_BOUND
	fighter.downFrame = 1
	for tick = 1 to DOWN_BOUND_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_BOUND)
	fighter.downFrame.assertEquals(DOWN_BOUND_FRAMES)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_WAIT)
	fighter.downWaitRemaining.assertEquals(DOWN_WAIT_FRAMES)
	fighter.z.assertEquals(0.)

	fighter.downState = DOWN_WAIT
	fighter.downWaitRemaining = 1
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_STAND)
	fighter.downFrame.assertEquals(1)
	for tick = 1 to DOWN_STAND_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_STAND)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_NONE)

	fighter.downState = DOWN_ROLL
	fighter.downDirection = 1
	fighter.downFrame = 1
	fighter.grounded = true
	for tick = 1 to DOWN_ROLL_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_ROLL)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_NONE)
	destroy input
	destroy fighter

@Test function lowDamageDuringEitherGroundedDownPoseStartsDownDamageInBothFacings()
	for direction = -1 to 1
		if direction != 0
			let attacker = new FighterState(0, 0, direction)
			let target = new FighterState(1, direction * 50., -direction)
			weakRecoveryHit(direction, attacker, target)
			target.damage.assertEquals(5.)
			target.downState.assertEquals(DOWN_DAMAGE)
			target.downFrame.assertEquals(1)
			target.grounded.assertTrue()
			target.downFaceUp.assertFalse()
			target.hitlag.assertEquals(4)
			destroy target
			destroy attacker

@Test function hitlagFreezesDownDamageThenHitstunReturnsToTimedDownWait()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 50, -1)
	let input = new InputSnapshot()
	target.damage = 80
	weakRecoveryHit(1, attacker, target)
	target.downState.assertEquals(DOWN_DAMAGE)
	let damageFrame = target.downFrame
	for tick = 1 to 3
		advance(target, 0, input, -240)
		target.downFrame.assertEquals(damageFrame)
		target.grounded.assertTrue()
	while target.downState == DOWN_DAMAGE
		advance(target, 0, input, -240)
	target.downState.assertEquals(DOWN_WAIT)
	target.downWaitRemaining.assertEquals(target.hitstun)
	target.downWaitRemaining.assertGreaterThan(0)
	let remaining = target.downWaitRemaining
	for tick = 1 to remaining
		advance(target, 0, input, -240)
	target.downState.assertEquals(DOWN_STAND)
	destroy input
	destroy target
	destroy attacker

@Test function sevenDamageInterruptsDownRecoveryAndDoesNotJabReset()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 50, -1)
	target.downState = DOWN_WAIT
	target.downWaitRemaining = 100
	beginAttackPair(attacker, target, 6, -1, false, false)
	attacker.attackFrame = attackStartupFrames(6)
	resolveAttackPair(attacker, target)
	target.damage.assertEquals(7.)
	(target.downState != DOWN_DAMAGE).assertTrue()
	target.grounded.assertFalse()
	destroy target
	destroy attacker

@Test function downDamageCompletionChecksGetupInputWithoutWaitingAnotherTick()
	for host = 0 to 1
		let attacker = new FighterState(0, 0, 1)
		let target = new FighterState(host, 50, -1)
		let input = new InputSnapshot()
		target.damage = 80
		weakRecoveryHit(1, attacker, target)
		while target.hitlag > 1
			advance(target, 0, input, -240)
		for tick = 1 to DOWN_DAMAGE_FRAMES - 1
			advance(target, 0, input, -240)
			target.downState.assertEquals(DOWN_DAMAGE)
		input.getupAttackPressed = true
		advance(target, 0, input, -240)
		target.downState.assertEquals(DOWN_ATTACK)
		destroy input
		destroy target
		destroy attacker

@Test function downDamageEndsInStandWhenItsHitstunExpiresDuringTheAnimation()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	fighter.surface = 0
	fighter.grounded = true
	fighter.downState = DOWN_DAMAGE
	fighter.downFrame = 1
	fighter.hitstun = 1
	for tick = 1 to DOWN_DAMAGE_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_DAMAGE)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_STAND)
	fighter.downFrame.assertEquals(1)
	destroy input
	destroy fighter

@Test function proneWaitExpiryStartsStandBeforeGetupInput()
	for remaining = 1 to 2
		let fighter = new FighterState(0, 0, 1)
		let input = new InputSnapshot()
		fighter.surface = 0
		fighter.grounded = true
		fighter.downState = DOWN_WAIT
		fighter.downWaitRemaining = remaining
		input.getupAttackPressed = true
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(remaining == 1 ? DOWN_STAND : DOWN_ATTACK)
		destroy input
		destroy fighter

@Test function replaySnapshotRetainsFaceAndDownDamageRecoveryTimers()
	let first = new FighterState(0, -90, 1)
	let second = new FighterState(1, 90, -1)
	let match = new MatchState()
	let firstCommands = new AttackBuffer(0)
	let secondCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let snapshot = new ReplaySnapshot()
	first.downState = DOWN_DAMAGE
	first.downFrame = 8
	first.downWaitRemaining = 13
	first.downFaceUp = false
	snapshot.capture(first, second, match, firstCommands, secondCommands, runtime)
	first.downState = DOWN_NONE
	first.downFrame = 0
	first.downWaitRemaining = 0
	first.downFaceUp = true
	snapshot.restore(first, second, match, firstCommands, secondCommands, runtime)
	first.downState.assertEquals(DOWN_DAMAGE)
	first.downFrame.assertEquals(8)
	first.downWaitRemaining.assertEquals(13)
	first.downFaceUp.assertFalse()
	let expected = new ReplaySnapshot()
	expected.capture(first, second, match, firstCommands, secondCommands, runtime)
	snapshot.firstDifference(expected).assertEquals("")

@Test function recoveryProtectionMatchesExtractedEventTimes()
	let fighter = new FighterState(0, 0, 1)
	fighter.downState = DOWN_STAND
	fighter.downFrame = DOWN_RECOVERY_INTANGIBLE_FRAMES
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()

	fighter.downState = DOWN_ROLL
	fighter.downDirection = -1
	fighter.downFaceUp = true
	fighter.downFrame = DOWN_ROLL_INTANGIBLE_FRAMES_BACK_UP
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downFaceUp = false
	fighter.downFrame = DOWN_ROLL_INTANGIBLE_FRAMES_BACK_DOWN
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downDirection = fighter.facing
	fighter.downFrame = DOWN_RECOVERY_INTANGIBLE_FRAMES
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()

	fighter.downState = DOWN_ATTACK
	fighter.downFaceUp = true
	fighter.downFrame = DOWN_ATTACK_INTANGIBLE_FRAMES_UP
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downFaceUp = false
	fighter.downFrame = DOWN_ATTACK_INTANGIBLE_FRAMES_DOWN
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	destroy fighter

@Test function groundedRiflemanBlasterHitKeepsGroundingAndImpactHitlag()
	let owner = new FighterState(1, 0, 1)
	let target = new FighterState(0, 20, -1)
	owner.projectileLife[0] = 10
	owner.projectileKind[0] = PROJECTILE_BLASTER
	owner.projectileDirection[0] = 1
	owner.projectileX[0] = 0
	owner.projectileZ[0] = 45
	owner.projectileVelocityX[0] = 30
	updateProjectilePair(owner, target)
	target.damage.assertEquals(3.)
	target.hitlag.assertEquals(4)
	target.grounded.assertTrue()
	destroy target
	destroy owner

@Test function floorRecoverySkidLeavesPlatformWithoutKeepingTheGroundedPose()
	for host = 0 to 1
		for stage = 0 to 1
			for side = 0 to 1
				for recovery = 0 to 2
					let direction = side == 0 ? -1 : 1
					let deck = stage == 0 ? 0 : 1
					let edge = direction < 0 ? surfaceLeft(stage, deck) : surfaceRight(stage, deck)
					let fighter = new FighterState(host, edge - direction * 30, direction)
					let input = new InputSnapshot()
					fighter.physics = floorRecoveryReferencePhysics()
					fighter.grounded = false
					fighter.surface = -1
					fighter.z = surfaceZ(stage, deck) + 1
					fighter.vz = -2
					fighter.knockbackX = direction * 18.
					fighter.downState = DOWN_TUMBLE
					fighter.hitstun = 20
					input.techPressed = recovery > 0
					input.direction = recovery == 2 ? direction : 0
					advance(fighter, stage, input, 0)
					fighter.downState.assertEquals(recovery == 0 ? DOWN_BOUND : (recovery == 1 ? DOWN_TECH : DOWN_TECH_ROLL))
					fighter.surface.assertEquals(deck)
					fighter.grounded.assertTrue()
					input.techPressed = false
					let contactX = fighter.x
					let contactZ = fighter.z
					advance(fighter, stage, input, 0)
					if recovery == 2
						fighter.x.assertEquals(edge)
						fighter.grounded.assertTrue()
						fighter.downState.assertEquals(DOWN_TECH_ROLL)
						fighter.surface.assertEquals(deck)
					else
						((fighter.x - edge) * direction > 0).assertTrue()
						fighter.grounded.assertFalse()
						fighter.downState.assertEquals(DOWN_NONE)
						fighter.surface.assertEquals(-1)
						fighter.jumps.assertEquals(1)
						(fighter.knockbackX * direction > 0).assertTrue()
					fighter.positionDeltaX.assertEquals(fighter.x - contactX)
					fighter.z.assertEquals(contactZ)
					advance(fighter, stage, input, 0)
					if recovery == 2
						fighter.z.assertEquals(contactZ)
					else
						(fighter.z < contactZ).assertTrue()
					destroy input
					destroy fighter
