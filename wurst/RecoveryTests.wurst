package RecoveryTests
import Simulation
import ReplayState
import MatchRules
import CommandBuffer
import MatchStep

function weakRecoveryHit(int direction, FighterState attacker, FighterState target)
	attacker.facing = direction
	target.facing = -direction
	target.x = direction * 50.
	target.surface = 0
	target.grounded = true
	target.downState = DOWN_WAIT
	target.downFrame = 20
	target.downWaitRemaining = 100
	target.downFaceUp = false
	beginAttackPair(attacker, target, 6, -1, false, false)
	attacker.attackFrame = attackStartupFrames(6) + 1
	resolveAttackPair(attacker, target)

@Test function downboundAndGetupActionsUseTheirOwnFrameCounts()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	fighter.surface = 0
	fighter.grounded = true
	fighter.downState = DOWN_BOUND
	fighter.downFrame = 1
	for tick = 1 to DOWN_BOUND_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_BOUND)
	fighter.downFrame.assertEquals(DOWN_BOUND_FRAMES)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_WAIT)
	fighter.downWaitRemaining.assertEquals(DOWN_WAIT_FRAMES)
	fighter.z.assertEquals(0.)

	fighter.downState = DOWN_WAIT
	fighter.downWaitRemaining = 1
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_STAND)
	fighter.downFrame.assertEquals(1)
	for tick = 1 to DOWN_STAND_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_STAND)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_NONE)

	fighter.downState = DOWN_ROLL
	fighter.downDirection = 1
	fighter.downFrame = 1
	fighter.grounded = true
	for tick = 1 to DOWN_ROLL_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_ROLL)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_NONE)
	destroy input
	destroy fighter

@Test function lowDamageDuringEitherGroundedDownPoseStartsDownDamageInBothFacings()
	for direction = -1 to 1
		if direction != 0
			let attacker = new FighterState(0, 0, direction)
			let target = new FighterState(1, direction * 50., -direction)
			weakRecoveryHit(direction, attacker, target)
			target.damage.assertEquals(5.)
			target.downState.assertEquals(DOWN_DAMAGE)
			target.downFrame.assertEquals(1)
			target.grounded.assertTrue()
			target.downFaceUp.assertFalse()
			target.hitlag.assertEquals(4)
			destroy target
			destroy attacker

@Test function hitlagFreezesDownDamageThenHitstunReturnsToTimedDownWait()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 50, -1)
	let input = new InputSnapshot()
	target.damage = 80
	weakRecoveryHit(1, attacker, target)
	target.downState.assertEquals(DOWN_DAMAGE)
	let damageFrame = target.downFrame
	for tick = 1 to 4
		advance(target, 0, input, -240)
		target.downFrame.assertEquals(damageFrame)
		target.grounded.assertTrue()
	while target.downState == DOWN_DAMAGE
		advance(target, 0, input, -240)
	target.downState.assertEquals(DOWN_WAIT)
	target.downWaitRemaining.assertEquals(target.hitstun)
	target.downWaitRemaining.assertGreaterThan(0)
	let remaining = target.downWaitRemaining
	for tick = 1 to remaining
		advance(target, 0, input, -240)
	target.downState.assertEquals(DOWN_STAND)
	destroy input
	destroy target
	destroy attacker

@Test function sevenDamageInterruptsDownRecoveryAndDoesNotJabReset()
	let attacker = new FighterState(0, 0, 1)
	let target = new FighterState(1, 50, -1)
	target.downState = DOWN_WAIT
	target.downWaitRemaining = 100
	beginAttackPair(attacker, target, 6, -1, false, false)
	attacker.attackFrame = attackStartupFrames(6)
	resolveAttackPair(attacker, target)
	target.damage.assertEquals(7.)
	(target.downState != DOWN_DAMAGE).assertTrue()
	target.grounded.assertFalse()
	destroy target
	destroy attacker

@Test function downDamageEndsInStandWhenItsHitstunExpiresDuringTheAnimation()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	fighter.surface = 0
	fighter.grounded = true
	fighter.downState = DOWN_DAMAGE
	fighter.downFrame = 1
	fighter.hitstun = 1
	for tick = 1 to DOWN_DAMAGE_FRAMES - 1
		advance(fighter, 0, input, -240)
		fighter.downState.assertEquals(DOWN_DAMAGE)
	advance(fighter, 0, input, -240)
	fighter.downState.assertEquals(DOWN_STAND)
	fighter.downFrame.assertEquals(1)
	destroy input
	destroy fighter

@Test function replaySnapshotRetainsFaceAndDownDamageRecoveryTimers()
	let first = new FighterState(0, -90, 1)
	let second = new FighterState(1, 90, -1)
	let match = new MatchState()
	let firstCommands = new AttackBuffer(0)
	let secondCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let snapshot = new ReplaySnapshot()
	first.downState = DOWN_DAMAGE
	first.downFrame = 8
	first.downWaitRemaining = 13
	first.downFaceUp = false
	snapshot.capture(first, second, match, firstCommands, secondCommands, runtime)
	first.downState = DOWN_NONE
	first.downFrame = 0
	first.downWaitRemaining = 0
	first.downFaceUp = true
	snapshot.restore(first, second, match, firstCommands, secondCommands, runtime)
	first.downState.assertEquals(DOWN_DAMAGE)
	first.downFrame.assertEquals(8)
	first.downWaitRemaining.assertEquals(13)
	first.downFaceUp.assertFalse()
	let expected = new ReplaySnapshot()
	expected.capture(first, second, match, firstCommands, secondCommands, runtime)
	snapshot.firstDifference(expected).assertEquals("")

@Test function recoveryProtectionMatchesExtractedEventTimes()
	let fighter = new FighterState(0, 0, 1)
	fighter.downState = DOWN_STAND
	fighter.downFrame = DOWN_RECOVERY_INTANGIBLE_FRAMES
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()

	fighter.downState = DOWN_ROLL
	fighter.downDirection = -1
	fighter.downFaceUp = true
	fighter.downFrame = DOWN_ROLL_INTANGIBLE_FRAMES_BACK_UP
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downFaceUp = false
	fighter.downFrame = DOWN_ROLL_INTANGIBLE_FRAMES_BACK_DOWN
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downDirection = fighter.facing
	fighter.downFrame = DOWN_RECOVERY_INTANGIBLE_FRAMES
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()

	fighter.downState = DOWN_ATTACK
	fighter.downFaceUp = true
	fighter.downFrame = DOWN_ATTACK_INTANGIBLE_FRAMES_UP
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	fighter.downFaceUp = false
	fighter.downFrame = DOWN_ATTACK_INTANGIBLE_FRAMES_DOWN
	isIntangible(fighter).assertTrue()
	fighter.downFrame++
	isIntangible(fighter).assertFalse()
	destroy fighter

@Test function groundedRiflemanBlasterHitKeepsGroundingAndImpactHitlag()
	let owner = new FighterState(1, 0, 1)
	let target = new FighterState(0, 20, -1)
	owner.projectileLife[0] = 10
	owner.projectileKind[0] = PROJECTILE_BLASTER
	owner.projectileDirection[0] = 1
	owner.projectileX[0] = 0
	owner.projectileZ[0] = 45
	owner.projectileVelocityX[0] = 30
	updateProjectilePair(owner, target)
	target.damage.assertEquals(3.)
	target.hitlag.assertEquals(4)
	target.grounded.assertTrue()
	destroy target
	destroy owner
