	if expected.grabMashZ != actual.grabMashZ
		return "grabMashZ"
	if expected.grabbedFrames != actual.grabbedFrames
		return "grabbedFrames"
	let expectedOwner = attackerSlot(expected.grabOwner, expectedFirst, expectedSecond)
	let actualOwner = attackerSlot(actual.grabOwner, actualFirst, actualSecond)
	if expectedOwner == -2 or actualOwner == -2 or expectedOwner != actualOwner
		return "grabOwner"
	let expectedTarget = attackerSlot(expected.grabTarget, expectedFirst, expectedSecond)
	let actualTarget = attackerSlot(actual.grabTarget, actualFirst, actualSecond)
	if expectedTarget == -2 or actualTarget == -2 or expectedTarget != actualTarget
		return "grabTarget"
	if expected.ledgeState != actual.ledgeState
