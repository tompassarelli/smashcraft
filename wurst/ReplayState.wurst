	if expected.ledgeIntangible != actual.ledgeIntangible
		return "ledgeIntangible"
	if expected.ledgeRegrab != actual.ledgeRegrab
		return "ledgeRegrab"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileLife[i] != actual.projectileLife[i]
			return "projectileLife[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileX[i] != actual.projectileX[i]
			return "projectileX[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileZ[i] != actual.projectileZ[i]
			return "projectileZ[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileDirection[i] != actual.projectileDirection[i]
			return "projectileDirection[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileKind[i] != actual.projectileKind[i]
			return "projectileKind[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileVelocityX[i] != actual.projectileVelocityX[i]
			return "projectileVelocityX[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileVelocityZ[i] != actual.projectileVelocityZ[i]
			return "projectileVelocityZ[" + I2S(i) + "]"
	for i = 0 to PROJECTILE_CAPACITY - 1
		if expected.projectileSerial[i] != actual.projectileSerial[i]
			return "projectileSerial[" + I2S(i) + "]"
	if expected.specialAction != actual.specialAction
		return "specialAction"
	if expected.specialFrame != actual.specialFrame
		return "specialFrame"
	if expected.specialDuration != actual.specialDuration
		return "specialDuration"
	if expected.specialLockFrames != actual.specialLockFrames
		return "specialLockFrames"
	if expected.specialFall != actual.specialFall
		return "specialFall"
	for i = 0 to SPECIAL_ACTION_CAPACITY - 1
		if expected.specialCooldowns[i] != actual.specialCooldowns[i]
			return "specialCooldowns[" + I2S(i) + "]"
	if expected.specialDirection != actual.specialDirection
		return "specialDirection"
	if expected.specialHit != actual.specialHit
		return "specialHit"
	if expected.bearLife != actual.bearLife
		return "bearLife"
	if expected.bearX != actual.bearX
		return "bearX"
	if expected.bearZ != actual.bearZ
		return "bearZ"
	if expected.bearVelocityX != actual.bearVelocityX
		return "bearVelocityX"
	if expected.bearVelocityZ != actual.bearVelocityZ
		return "bearVelocityZ"
	if expected.bearSwipeCooldown != actual.bearSwipeCooldown
		return "bearSwipeCooldown"
	if expected.bearHitSerial != actual.bearHitSerial
		return "bearHitSerial"
	if expected.bearSurface != actual.bearSurface
		return "bearSurface"
	if expected.hippogryphLife != actual.hippogryphLife
		return "hippogryphLife"
	if expected.hippogryphX != actual.hippogryphX
		return "hippogryphX"
	if expected.hippogryphZ != actual.hippogryphZ
		return "hippogryphZ"
	if expected.hippogryphVelocityX != actual.hippogryphVelocityX
		return "hippogryphVelocityX"
	if expected.hippogryphVelocityZ != actual.hippogryphVelocityZ
		return "hippogryphVelocityZ"
	if expected.hippogryphKind != actual.hippogryphKind
		return "hippogryphKind"
	return ""

public class ReplaySnapshot
	FighterState first = new FighterState(0, 0, 1)
	FighterState second = new FighterState(1, 0, -1)
	MatchState match = new MatchState()
	AttackBuffer firstCommands = new AttackBuffer(0)
	AttackBuffer secondCommands = new AttackBuffer(0)
	ReplayRuntimeState runtime = new ReplayRuntimeState()

	function capture(FighterState liveFirst, FighterState liveSecond,
			MatchState liveMatch, AttackBuffer liveFirstCommands, AttackBuffer liveSecondCommands,
			ReplayRuntimeState liveRuntime)
		copyFighter(liveFirst, first, liveFirst, liveSecond, first, second)
		copyFighter(liveSecond, second, liveFirst, liveSecond, first, second)
		liveMatch.copyTo(match)
		liveFirstCommands.copyTo(firstCommands)
		liveSecondCommands.copyTo(secondCommands)
		liveRuntime.copyTo(runtime)

	function restore(FighterState liveFirst, FighterState liveSecond,
			MatchState liveMatch, AttackBuffer liveFirstCommands, AttackBuffer liveSecondCommands,
			ReplayRuntimeState liveRuntime)
		copyFighter(first, liveFirst, first, second, liveFirst, liveSecond)
		copyFighter(second, liveSecond, first, second, liveFirst, liveSecond)
		match.copyTo(liveMatch)
		firstCommands.copyTo(liveFirstCommands)
		secondCommands.copyTo(liveSecondCommands)
		runtime.copyTo(liveRuntime)

	// Exact numerical equality, without decimal formatting or quantization. This
	// is a field oracle within one runtime, not a cross-runtime bitwise hash.
	function firstDifference(ReplaySnapshot actual) returns string
		let firstField = fighterDifference(first, actual.first, first, second, actual.first, actual.second)
		if firstField != ""
			return "first." + firstField
		let secondField = fighterDifference(second, actual.second, first, second, actual.first, actual.second)
		if secondField != ""
			return "second." + secondField
		if match.phase != actual.match.phase
			return "match.phase"
		if match.characterChoice != actual.match.characterChoice
			return "match.characterChoice"
		if match.secondCharacterChoice != actual.match.secondCharacterChoice
			return "match.secondCharacterChoice"
		if match.stageChoice != actual.match.stageChoice
			return "match.stageChoice"
		if match.winner != actual.match.winner
			return "match.winner"
		if match.humanCount != actual.match.humanCount
			return "match.humanCount"
		if match.practice != actual.match.practice
			return "match.practice"
		if match.stockCount != actual.match.stockCount
			return "match.stockCount"
		if match.timeLimitMinutes != actual.match.timeLimitMinutes
			return "match.timeLimitMinutes"
		if match.remainingFrames != actual.match.remainingFrames
			return "match.remainingFrames"
		if match.timedOut != actual.match.timedOut
			return "match.timedOut"
		if match.firstCharacterReady != actual.match.firstCharacterReady
			return "match.firstCharacterReady"
		if match.secondCharacterReady != actual.match.secondCharacterReady
			return "match.secondCharacterReady"
		if match.firstRematchReady != actual.match.firstRematchReady
			return "match.firstRematchReady"
		if match.secondRematchReady != actual.match.secondRematchReady
			return "match.secondRematchReady"
		if firstCommands.windowFrames != actual.firstCommands.windowFrames
			return "firstCommands.windowFrames"
		if firstCommands.style != actual.firstCommands.style
			return "firstCommands.style"
		if firstCommands.facing != actual.firstCommands.facing
			return "firstCommands.facing"
		if firstCommands.targetFrame != actual.firstCommands.targetFrame
			return "firstCommands.targetFrame"
		if firstCommands.consumedFacing != actual.firstCommands.consumedFacing
			return "firstCommands.consumedFacing"
		if firstCommands.mayCharge != actual.firstCommands.mayCharge
			return "firstCommands.mayCharge"
		if firstCommands.consumedMayCharge != actual.firstCommands.consumedMayCharge
			return "firstCommands.consumedMayCharge"
		if secondCommands.windowFrames != actual.secondCommands.windowFrames
			return "secondCommands.windowFrames"
		if secondCommands.style != actual.secondCommands.style
			return "secondCommands.style"
		if secondCommands.facing != actual.secondCommands.facing
			return "secondCommands.facing"
		if secondCommands.targetFrame != actual.secondCommands.targetFrame
			return "secondCommands.targetFrame"
		if secondCommands.consumedFacing != actual.secondCommands.consumedFacing
			return "secondCommands.consumedFacing"
		if secondCommands.mayCharge != actual.secondCommands.mayCharge
			return "secondCommands.mayCharge"
		if secondCommands.consumedMayCharge != actual.secondCommands.consumedMayCharge
			return "secondCommands.consumedMayCharge"
		if runtime.simulationFrame != actual.runtime.simulationFrame
			return "runtime.simulationFrame"
		if runtime.botAttackDelay != actual.runtime.botAttackDelay
			return "runtime.botAttackDelay"
		return ""
