	if expected.surfaceRecoveryState != actual.surfaceRecoveryState
		return "surfaceRecoveryState"
	if expected.surfaceRecoveryFrame != actual.surfaceRecoveryFrame
		return "surfaceRecoveryFrame"
	if expected.surfaceRecoveryVelocityApplied != actual.surfaceRecoveryVelocityApplied
		return "surfaceRecoveryVelocityApplied"
	if expected.surfaceWallJumpQueued != actual.surfaceWallJumpQueued
		return "surfaceWallJumpQueued"
	if expected.surfaceReflectCooldown != actual.surfaceReflectCooldown
		return "surfaceReflectCooldown"
	if expected.lastReflectedSurface != actual.lastReflectedSurface
		return "lastReflectedSurface"
	if expected.surfaceContactSerial != actual.surfaceContactSerial
		return "surfaceContactSerial"
	if expected.surfaceContactKind != actual.surfaceContactKind
		return "surfaceContactKind"
	if expected.surfaceContactApproachSpeed != actual.surfaceContactApproachSpeed
		return "surfaceContactApproachSpeed"
	if expected.surfaceContactX != actual.surfaceContactX
		return "surfaceContactX"
	if expected.surfaceContactZ != actual.surfaceContactZ
		return "surfaceContactZ"
	if expected.surfaceContactNormalX != actual.surfaceContactNormalX
		return "surfaceContactNormalX"
	if expected.surfaceContactNormalZ != actual.surfaceContactNormalZ
		return "surfaceContactNormalZ"
	if expected.airDodgeTime != actual.airDodgeTime
		return "airDodgeTime"
	if expected.landingLag != actual.landingLag
		return "landingLag"
	if expected.lCancelWindow != actual.lCancelWindow
		return "lCancelWindow"
	if expected.lCancelSerial != actual.lCancelSerial
		return "lCancelSerial"
	if expected.airDodging != actual.airDodging
		return "airDodging"
	if expected.airDodgeFrame != actual.airDodgeFrame
		return "airDodgeFrame"
	if expected.groundDodgeFrame != actual.groundDodgeFrame
		return "groundDodgeFrame"
	if expected.groundDodgeDirection != actual.groundDodgeDirection
		return "groundDodgeDirection"
	if expected.groundDodgeEntryFacing != actual.groundDodgeEntryFacing
		return "groundDodgeEntryFacing"
	if expected.downState != actual.downState
		return "downState"
	if expected.downFrame != actual.downFrame
		return "downFrame"
	if expected.downDirection != actual.downDirection
		return "downDirection"
	if expected.downWaitRemaining != actual.downWaitRemaining
		return "downWaitRemaining"
	if expected.downFaceUp != actual.downFaceUp
		return "downFaceUp"
	if expected.techWindow != actual.techWindow
		return "techWindow"
	if expected.techPressAge != actual.techPressAge
		return "techPressAge"
	if expected.techPreviousPressAge != actual.techPreviousPressAge
		return "techPreviousPressAge"
	if expected.techAccumulatedPress != actual.techAccumulatedPress
		return "techAccumulatedPress"
	if expected.grabbedFrames != actual.grabbedFrames
		return "grabbedFrames"
	if expected.grabAction != actual.grabAction
		return "grabAction"
	if expected.grabFrame != actual.grabFrame
		return "grabFrame"
	if expected.grabSerial != actual.grabSerial
		return "grabSerial"
	if expected.grabMashX != actual.grabMashX
		return "grabMashX"
	if expected.grabMashZ != actual.grabMashZ
		return "grabMashZ"
	if expectedWorld.slotOf(expected.grabOwner) != actualWorld.slotOf(actual.grabOwner) or expectedWorld.slotOf(expected.grabOwner) == -2 or actualWorld.slotOf(actual.grabOwner) == -2
		return "grabOwner"
	if expectedWorld.slotOf(expected.grabTarget) != actualWorld.slotOf(actual.grabTarget) or expectedWorld.slotOf(expected.grabTarget) == -2 or actualWorld.slotOf(actual.grabTarget) == -2
		return "grabTarget"
	if expected.ledgeState != actual.ledgeState
		return "ledgeState"
	if expected.ledgeSide != actual.ledgeSide
		return "ledgeSide"
	if expected.ledgeFrame != actual.ledgeFrame
		return "ledgeFrame"
	if expected.ledgeSerial != actual.ledgeSerial
		return "ledgeSerial"
	if expected.ledgeIntangible != actual.ledgeIntangible
		return "ledgeIntangible"
	if expected.ledgeRegrab != actual.ledgeRegrab
		return "ledgeRegrab"
	return ""

public class ReplaySnapshot
	private CanonicalWriter writer = new CanonicalWriter()
	FighterRoster world = new FighterRoster(3)
	FrameInputs controls = new FrameInputs()
	MatchState match = new MatchState()
	ReplayRuntimeState runtime = new ReplayRuntimeState()

	construct()
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			world.fighters[slot] = new FighterState(slot mod 3, 0, slot mod 2 == 0 ? 1 : -1)

	ondestroy
		destroy writer

	function capture(FighterRoster liveWorld, MatchState liveMatch, FrameInputs liveControls, ReplayRuntimeState liveRuntime)
		world.mask = liveWorld.mask
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if world.active(slot)
				copyFighter(liveWorld.fighters[slot], world.fighters[slot], liveWorld, world)
				liveControls.commands[slot].copyTo(controls.commands[slot])
		liveMatch.copyTo(match)
		liveRuntime.copyTo(runtime, liveWorld, world)

	function restore(FighterRoster liveWorld, MatchState liveMatch, FrameInputs liveControls, ReplayRuntimeState liveRuntime)
		liveWorld.mask = world.mask
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if world.active(slot)
				copyFighter(world.fighters[slot], liveWorld.fighters[slot], world, liveWorld)
				controls.commands[slot].copyTo(liveControls.commands[slot])
		match.copyTo(liveMatch)
		runtime.copyTo(liveRuntime, world, liveWorld)

	private function writeCanonicalState()
		writer.append("SmashcraftReplay2")
		canonicalInt(writer, "participantMask", world.mask)
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if world.active(slot)
				canonicalFighter(writer, "fighter[" + I2S(slot) + "]", world.fighters[slot], world)
				canonicalInt(writer, "commands[" + I2S(slot) + "].windowFrames", controls.commands[slot].windowFrames)
				canonicalInt(writer, "commands[" + I2S(slot) + "].style", controls.commands[slot].style)
				canonicalInt(writer, "commands[" + I2S(slot) + "].facing", controls.commands[slot].facing)
				canonicalInt(writer, "commands[" + I2S(slot) + "].targetFrame", controls.commands[slot].targetFrame)
				canonicalInt(writer, "commands[" + I2S(slot) + "].consumedFacing", controls.commands[slot].consumedFacing)
				canonicalBoolean(writer, "commands[" + I2S(slot) + "].mayCharge", controls.commands[slot].mayCharge)
				canonicalBoolean(writer, "commands[" + I2S(slot) + "].consumedMayCharge", controls.commands[slot].consumedMayCharge)
		canonicalInt(writer, "match.phase", match.phase)
		canonicalInt(writer, "match.stageChoice", match.stageChoice)
		canonicalInt(writer, "match.winner", match.winner)
		canonicalInt(writer, "match.humanCount", match.humanCount)
		canonicalInt(writer, "match.humanMask", match.humanMask)
		canonicalInt(writer, "match.humanFighterMask", match.humanFighterMask)
		canonicalInt(writer, "match.computerMask", match.computerMask)
		canonicalInt(writer, "match.departedMask", match.departedMask)
		canonicalBoolean(writer, "match.interrupted", match.interrupted)
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			let prefix = "match.slot" + I2S(slot)
			canonicalInt(writer, prefix + ".character", match.characterChoices[slot])
			canonicalBoolean(writer, prefix + ".ready", match.characterReadiness[slot])
			canonicalBoolean(writer, prefix + ".rematch", match.rematchReadiness[slot])
		canonicalInt(writer, "match.stockCount", match.stockCount)
		canonicalInt(writer, "match.timeLimitMinutes", match.timeLimitMinutes)
		canonicalInt(writer, "match.remainingFrames", match.remainingFrames)
		canonicalBoolean(writer, "match.timedOut", match.timedOut)
		canonicalBoolean(writer, "match.practice", match.practice)
		canonicalInt(writer, "runtime.simulationFrame", runtime.simulationFrame)
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			canonicalRealField(writer, "runtime.botAttackDelays[" + I2S(slot) + "]", runtime.botAttackDelays[slot])

	function canonicalState() returns string
		writer.reset(false)
		writeCanonicalState()
		return writer.text

	function checksum() returns string
		writer.reset(true)
		writeCanonicalState()
		return writer.checksum()

	function firstPoseDifference(ReplaySnapshot actual) returns string
		if world.mask != actual.world.mask
			return "participantMask"
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if world.active(slot)
				let field = runtime.poses[slot].firstDifference(actual.runtime.poses[slot], world, actual.world)
				if field != ""
					return "pose[" + I2S(slot) + "]." + field
		let impactField = runtime.impacts.firstDifference(actual.runtime.impacts)
		if impactField != ""
			return "impacts." + impactField
		let specialField = runtime.specials.firstDifference(actual.runtime.specials)
		if specialField != ""
			return "specials." + specialField
		let summonField = runtime.summons.firstDifference(actual.runtime.summons)
		return summonField == "" ? "" : "summons." + summonField

	function firstDifference(ReplaySnapshot actual) returns string
		if world.mask != actual.world.mask
			return "participantMask"
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if world.active(slot)
				let field = fighterDifference(world.fighters[slot], actual.world.fighters[slot], world, actual.world)
				if field != ""
					return "fighter[" + I2S(slot) + "]." + field
				if controls.commands[slot].windowFrames != actual.controls.commands[slot].windowFrames
					return "commands[" + I2S(slot) + "].windowFrames"
				if controls.commands[slot].style != actual.controls.commands[slot].style
					return "commands[" + I2S(slot) + "].style"
				if controls.commands[slot].facing != actual.controls.commands[slot].facing
					return "commands[" + I2S(slot) + "].facing"
				if controls.commands[slot].targetFrame != actual.controls.commands[slot].targetFrame
					return "commands[" + I2S(slot) + "].targetFrame"
				if controls.commands[slot].consumedFacing != actual.controls.commands[slot].consumedFacing
					return "commands[" + I2S(slot) + "].consumedFacing"
				if controls.commands[slot].mayCharge != actual.controls.commands[slot].mayCharge
					return "commands[" + I2S(slot) + "].mayCharge"
				if controls.commands[slot].consumedMayCharge != actual.controls.commands[slot].consumedMayCharge
					return "commands[" + I2S(slot) + "].consumedMayCharge"
		if match.phase != actual.match.phase
			return "match.phase"
		if match.stageChoice != actual.match.stageChoice
			return "match.stageChoice"
		if match.winner != actual.match.winner
			return "match.winner"
		if match.departedMask != actual.match.departedMask
			return "match.departedMask"
		if match.interrupted != actual.match.interrupted
			return "match.interrupted"
		if match.humanFighterMask != actual.match.humanFighterMask
			return "match.humanFighterMask"
		if match.computerMask != actual.match.computerMask
			return "match.computerMask"
		if match.humanMask != actual.match.humanMask
			return "match.humanMask"
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			let prefix = "match.slot" + I2S(slot)
			if match.characterChoices[slot] != actual.match.characterChoices[slot]
				return prefix + ".character"
			if match.characterReadiness[slot] != actual.match.characterReadiness[slot]
				return prefix + ".ready"
			if match.rematchReadiness[slot] != actual.match.rematchReadiness[slot]
				return prefix + ".rematch"
		if match.humanCount != actual.match.humanCount
			return "match.humanCount"
		if match.practice != actual.match.practice
			return "match.practice"
		if match.stockCount != actual.match.stockCount
			return "match.stockCount"
		if match.timeLimitMinutes != actual.match.timeLimitMinutes
			return "match.timeLimitMinutes"
		if match.remainingFrames != actual.match.remainingFrames
			return "match.remainingFrames"
		if match.timedOut != actual.match.timedOut
			return "match.timedOut"
		if runtime.simulationFrame != actual.runtime.simulationFrame
			return "runtime.simulationFrame"
		for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
			if runtime.botAttackDelays[slot] != actual.runtime.botAttackDelays[slot]
				return "runtime.botAttackDelays[" + I2S(slot) + "]"
		return ""

// Exact finite binary representation: sign, exponent, and all 52 double fraction bits.
// Fixed ordering, names, and separators make the serialized form canonical.
public function canonicalReal(real value) returns string
	if value != value
		return "nan"
	let negative = value < 0
	if not negative and not value > 0
		return "0"
	var magnitude = negative ? -value : value
	if magnitude * 2 == magnitude
		return negative ? "-inf" : "+inf"
	var exponent = 0
	while magnitude >= 2
		magnitude = magnitude / 2
		exponent++
	while magnitude < 1
		magnitude = magnitude * 2
		exponent--
	var fraction = magnitude - 1
	var high = 0
	for i = 0 to 25
		fraction = fraction * 2
		high = high * 2
		if fraction >= 1
			high++
			fraction = fraction - 1
	var low = 0
	for i = 0 to 25
		fraction = fraction * 2
		low = low * 2
		if fraction >= 1
			low++
			fraction = fraction - 1
	return (negative ? "-" : "+") + I2S(exponent) + ":" + I2S(high) + ":" + I2S(low)

// One writer per snapshot; both modes consume the same ordered fragments.
class CanonicalWriter
	string text = ""
	private boolean hashing = false
	private boolean valid = true
	private int first = 0
	private int second = 0

	function reset(boolean hashMode)
		hashing = hashMode
		text = ""
		valid = true
		first = 0
		second = 0

	function append(string fragment)
		if not hashing
			text += fragment
			return
		if not valid
			return
		for i = 0 to fragment.length() - 1
			let character = fragment.charAt(i)
			let decoded = character.toChar()
			let byte = decoded.toInt()
			if byte < 32 or byte > 126 or decoded.toString() != character
				valid = false
				return
			first = (first * 257 + byte + 1) mod REPLAY_CHECKSUM_MODULUS
			second = (second * 263 + byte + 1) mod REPLAY_CHECKSUM_MODULUS

	function checksum() returns string
		return valid ? I2S(first) + ":" + I2S(second) : "invalid-ascii"

function canonicalInt(CanonicalWriter writer, string name, int value)
	writer.append("|" + name + "=" + I2S(value))

function canonicalBoolean(CanonicalWriter writer, string name, boolean value)
	writer.append("|" + name + "=" + (value ? "1" : "0"))

function canonicalRealField(CanonicalWriter writer, string name, real value)
	writer.append("|" + name + "=" + canonicalReal(value))

function canonicalReference(CanonicalWriter writer, string name, FighterState value, FighterRoster world)
	canonicalInt(writer, name, world.slotOf(value))

// Two bounded polynomial lanes digest the canonical ASCII bytes. The largest
// intermediate is below 264 million, so both Lua and Warcraft signed ints agree.
public function canonicalChecksum(string text) returns string
	var first = 0
	var second = 0
	for i = 0 to text.length() - 1
		let character = text.charAt(i)
		let decoded = character.toChar()
		let byte = decoded.toInt()
		// The lookup can alias unsupported bytes; require an exact printable round trip.
		if byte < 32 or byte > 126 or decoded.toString() != character
			return "invalid-ascii"
		first = (first * 257 + byte + 1) mod REPLAY_CHECKSUM_MODULUS
		second = (second * 263 + byte + 1) mod REPLAY_CHECKSUM_MODULUS
	return I2S(first) + ":" + I2S(second)

function canonicalFighter(CanonicalWriter writer, string prefix, FighterState fighter, FighterRoster world)
	canonicalInt(writer, prefix + ".ceilingTechImpulseFrame", fighter.ceilingTechImpulseFrame)
	canonicalInt(writer, prefix + ".ceilingTechAnimationEndFrame", fighter.ceilingTechAnimationEndFrame)
	canonicalInt(writer, prefix + ".wallTechAnimationEndFrame", fighter.wallTechAnimationEndFrame)
	canonicalInt(writer, prefix + ".wallJumpTechAnimationEndFrame", fighter.wallJumpTechAnimationEndFrame)
	canonicalInt(writer, prefix + ".dashGrabWindow", fighter.dashGrabWindow)
	canonicalInt(writer, prefix + ".groundAction", fighter.groundAction)
	canonicalInt(writer, prefix + ".groundActionFrame", fighter.groundActionFrame)
	canonicalInt(writer, prefix + ".groundRunBrakeFramesRemaining", fighter.groundRunBrakeFramesRemaining)
	canonicalInt(writer, prefix + ".groundTurnRunEntryFacing", fighter.groundTurnRunEntryFacing)
	canonicalInt(writer, prefix + ".groundRules.dashRunEnableFrame", fighter.groundRules.dashRunEnableFrame)
	canonicalInt(writer, prefix + ".groundRules.turnRunFacingCommandFrame", fighter.groundRules.turnRunFacingCommandFrame)
	canonicalInt(writer, prefix + ".groundRules.turnRunAnimationEndFrame", fighter.groundRules.turnRunAnimationEndFrame)
	canonicalInt(writer, prefix + ".groundRules.runBrakeTurnCommandEndFrame", fighter.groundRules.runBrakeTurnCommandEndFrame)
	canonicalInt(writer, prefix + ".groundRules.runBrakeAnimationEndFrame", fighter.groundRules.runBrakeAnimationEndFrame)
	canonicalInt(writer, prefix + ".groundRules.runBrakeMaximumFrames", fighter.groundRules.runBrakeMaximumFrames)
	canonicalInt(writer, prefix + ".dashGrabTiming.startupFrames", fighter.dashGrabTiming.startupFrames)
	canonicalInt(writer, prefix + ".dashGrabTiming.activeFrames", fighter.dashGrabTiming.activeFrames)
	canonicalInt(writer, prefix + ".dashGrabTiming.totalFrames", fighter.dashGrabTiming.totalFrames)
	canonicalBoolean(writer, prefix + ".dashGrabAttack", fighter.dashGrabAttack)
	canonicalBoolean(writer, prefix + ".groundTurnRunFacingCommandLatched", fighter.groundTurnRunFacingCommandLatched)
	canonicalBoolean(writer, prefix + ".groundTurnRunPausePending", fighter.groundTurnRunPausePending)
	canonicalInt(writer, prefix + "." + "character", fighter.character)
	canonicalRealField(writer, prefix + ".physics.weight", fighter.physics.weight)
	canonicalRealField(writer, prefix + ".physics.gravity", fighter.physics.gravity)
	canonicalRealField(writer, prefix + ".physics.terminalSpeed", fighter.physics.terminalSpeed)
	canonicalRealField(writer, prefix + ".physics.fastFallSpeed", fighter.physics.fastFallSpeed)
	canonicalRealField(writer, prefix + ".physics.airAcceleration", fighter.physics.airAcceleration)
	canonicalRealField(writer, prefix + ".physics.airSpeed", fighter.physics.airSpeed)
	canonicalRealField(writer, prefix + ".physics.airFriction", fighter.physics.airFriction)
	canonicalRealField(writer, prefix + ".physics.airCap", fighter.physics.airCap)
	canonicalRealField(writer, prefix + ".physics.traction", fighter.physics.traction)
	canonicalRealField(writer, prefix + ".physics.dashSpeed", fighter.physics.dashSpeed)
	canonicalRealField(writer, prefix + ".physics.runSpeed", fighter.physics.runSpeed)
	canonicalRealField(writer, prefix + ".physics.walkSpeed", fighter.physics.walkSpeed)
	canonicalInt(writer, prefix + ".physics.jumpSquatFrames", fighter.physics.jumpSquatFrames)
	canonicalRealField(writer, prefix + ".physics.fullJumpSpeed", fighter.physics.fullJumpSpeed)
	canonicalRealField(writer, prefix + ".physics.shortJumpSpeed", fighter.physics.shortJumpSpeed)
	canonicalRealField(writer, prefix + ".physics.aerialJumpSpeed", fighter.physics.aerialJumpSpeed)
	canonicalRealField(writer, prefix + ".physics.jumpMomentum", fighter.physics.jumpMomentum)
	canonicalRealField(writer, prefix + ".physics.jumpHorizontalSpeed", fighter.physics.jumpHorizontalSpeed)
	canonicalRealField(writer, prefix + ".physics.jumpHorizontalCap", fighter.physics.jumpHorizontalCap)
	canonicalRealField(writer, prefix + ".physics.aerialJumpHorizontalSpeed", fighter.physics.aerialJumpHorizontalSpeed)
	canonicalRealField(writer, prefix + ".physics.shieldBreakSpeed", fighter.physics.shieldBreakSpeed)
	canonicalInt(writer, prefix + "." + "facing", fighter.facing)
	canonicalInt(writer, prefix + "." + "lastAerialTapDirection", fighter.lastAerialTapDirection)
	canonicalInt(writer, prefix + "." + "dashFrame", fighter.dashFrame)
	canonicalInt(writer, prefix + "." + "dashDirection", fighter.dashDirection)
	canonicalRealField(writer, prefix + "." + "x", fighter.x)
	canonicalRealField(writer, prefix + "." + "z", fighter.z)
	canonicalRealField(writer, prefix + "." + "vx", fighter.vx)
	canonicalRealField(writer, prefix + "." + "vz", fighter.vz)
	canonicalRealField(writer, prefix + "." + "knockbackX", fighter.knockbackX)
	canonicalRealField(writer, prefix + "." + "knockbackZ", fighter.knockbackZ)
	canonicalRealField(writer, prefix + "." + "damage", fighter.damage)
	canonicalInt(writer, prefix + "." + "stocks", fighter.stocks)
	canonicalInt(writer, prefix + "." + "hitstun", fighter.hitstun)
	canonicalInt(writer, prefix + "." + "hitlag", fighter.hitlag)
	canonicalBoolean(writer, prefix + "." + "diPending", fighter.diPending)
	canonicalRealField(writer, prefix + "." + "diLaunchSpeed", fighter.diLaunchSpeed)
	canonicalInt(writer, prefix + "." + "diSerial", fighter.diSerial)
	canonicalRealField(writer, prefix + "." + "diAngleDegrees", fighter.diAngleDegrees)
	canonicalBoolean(writer, prefix + "." + "sdiWasGrounded", fighter.sdiWasGrounded)
	canonicalBoolean(writer, prefix + "." + "sdiLaunchesUpward", fighter.sdiLaunchesUpward)
	canonicalInt(writer, prefix + "." + "sdiSerial", fighter.sdiSerial)
	canonicalInt(writer, prefix + "." + "asdiSerial", fighter.asdiSerial)
	canonicalInt(writer, prefix + "." + "cooldown", fighter.cooldown)
	canonicalInt(writer, prefix + "." + "attackStyle", fighter.attackStyle)
	canonicalInt(writer, prefix + "." + "attackFrame", fighter.attackFrame)
	canonicalInt(writer, prefix + "." + "attackDuration", fighter.attackDuration)
	canonicalInt(writer, prefix + "." + "attackSerial", fighter.attackSerial)
	canonicalBoolean(writer, prefix + "." + "attackHit", fighter.attackHit)
	for i = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		canonicalReference(writer, prefix + "." + "hitAttackers[" + I2S(i) + "]", fighter.hitAttackers[i], world)
	for i = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "hitSerials[" + I2S(i) + "]", fighter.hitSerials[i])
	for i = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "hitWindows[" + I2S(i) + "]", fighter.hitWindows[i])
	for i = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		canonicalReference(writer, prefix + "." + "specialHitTargets[" + I2S(i) + "]", fighter.specialHitTargets[i], world)
	canonicalReference(writer, prefix + "." + "lastHitAttacker", fighter.lastHitAttacker, world)
	canonicalInt(writer, prefix + "." + "lastHitAttackSerial", fighter.lastHitAttackSerial)
	canonicalInt(writer, prefix + "." + "lastHitWindow", fighter.lastHitWindow)
	canonicalBoolean(writer, prefix + "." + "smashCharging", fighter.smashCharging)
	canonicalInt(writer, prefix + "." + "smashChargeFrames", fighter.smashChargeFrames)
	canonicalBoolean(writer, prefix + "." + "smashChargeAllowed", fighter.smashChargeAllowed)
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "projectileLife[" + I2S(i) + "]", fighter.projectileLife[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalRealField(writer, prefix + "." + "projectileX[" + I2S(i) + "]", fighter.projectileX[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalRealField(writer, prefix + "." + "projectileZ[" + I2S(i) + "]", fighter.projectileZ[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "projectileDirection[" + I2S(i) + "]", fighter.projectileDirection[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "projectileKind[" + I2S(i) + "]", fighter.projectileKind[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalRealField(writer, prefix + "." + "projectileVelocityX[" + I2S(i) + "]", fighter.projectileVelocityX[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalRealField(writer, prefix + "." + "projectileVelocityZ[" + I2S(i) + "]", fighter.projectileVelocityZ[i])
	for i = 0 to PROJECTILE_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "projectileSerial[" + I2S(i) + "]", fighter.projectileSerial[i])
	canonicalInt(writer, prefix + "." + "parrySerial", fighter.parrySerial)
	canonicalInt(writer, prefix + "." + "specialAction", fighter.specialAction)
	canonicalInt(writer, prefix + "." + "specialFrame", fighter.specialFrame)
	canonicalInt(writer, prefix + "." + "specialDuration", fighter.specialDuration)
	canonicalInt(writer, prefix + "." + "specialLockFrames", fighter.specialLockFrames)
	canonicalBoolean(writer, prefix + "." + "specialFall", fighter.specialFall)
	for i = 0 to SPECIAL_ACTION_CAPACITY - 1
		canonicalInt(writer, prefix + "." + "specialCooldowns[" + I2S(i) + "]", fighter.specialCooldowns[i])
	canonicalInt(writer, prefix + "." + "specialDirection", fighter.specialDirection)
	canonicalBoolean(writer, prefix + "." + "specialHit", fighter.specialHit)
	canonicalInt(writer, prefix + "." + "bearLife", fighter.bearLife)
	canonicalRealField(writer, prefix + "." + "bearX", fighter.bearX)
	canonicalRealField(writer, prefix + "." + "bearZ", fighter.bearZ)
