package ReplayState
import Simulation
import MatchRules
import CommandBuffer

// Reusable detached storage. Construct once before the match; capture/restore only
// overwrite numerical fields and never create Warcraft handles or replay objects.
function copyFighter(FighterState source, FighterState destination,
		FighterState sourceFirst, FighterState sourceSecond,
		FighterState destinationFirst, FighterState destinationSecond)
	destination.character = source.character
	destination.physics = source.physics
	destination.surfacePhysics = source.surfacePhysics
	destination.ceilingTechImpulseFrame = source.ceilingTechImpulseFrame
	destination.ceilingTechAnimationEndFrame = source.ceilingTechAnimationEndFrame
	destination.wallTechAnimationEndFrame = source.wallTechAnimationEndFrame
	destination.wallJumpTechAnimationEndFrame = source.wallJumpTechAnimationEndFrame
	destination.facing = source.facing
	destination.lastAerialTapDirection = source.lastAerialTapDirection
	destination.dashFrame = source.dashFrame
	destination.dashDirection = source.dashDirection
	destination.groundRules = groundMovementRules(
		source.groundRules.dashRunEnableFrame,
		source.groundRules.turnRunFacingCommandFrame,
		source.groundRules.turnRunAnimationEndFrame,
		source.groundRules.runBrakeTurnCommandEndFrame,
		source.groundRules.runBrakeAnimationEndFrame,
		source.groundRules.runBrakeMaximumFrames)
	destination.dashGrabTiming = dashGrabRules(source.dashGrabTiming.startupFrames, source.dashGrabTiming.activeFrames, source.dashGrabTiming.totalFrames)
	destination.dashGrabWindow = source.dashGrabWindow
	destination.dashGrabAttack = source.dashGrabAttack
	destination.groundAction = source.groundAction
	destination.groundActionFrame = source.groundActionFrame
	destination.groundRunBrakeFramesRemaining = source.groundRunBrakeFramesRemaining
	destination.groundTurnRunEntryFacing = source.groundTurnRunEntryFacing
	destination.groundTurnRunFacingCommandLatched = source.groundTurnRunFacingCommandLatched
	destination.groundTurnRunPausePending = source.groundTurnRunPausePending
	destination.x = source.x
	destination.z = source.z
	destination.positionDeltaX = source.positionDeltaX
	destination.positionDeltaZ = source.positionDeltaZ
	destination.vx = source.vx
	destination.vz = source.vz
	destination.knockbackX = source.knockbackX
	destination.knockbackZ = source.knockbackZ
	destination.groundKnockbackX = source.groundKnockbackX
	destination.knockbackAgeFrames = source.knockbackAgeFrames
	destination.damageLevel = source.damageLevel
	destination.shieldPushbackX = source.shieldPushbackX
	destination.shieldRecoilX = source.shieldRecoilX
	destination.shieldRecoilZ = source.shieldRecoilZ
	destination.shieldDrainResumePending = source.shieldDrainResumePending
	destination.damage = source.damage
	destination.hitVisualSerial = source.hitVisualSerial
	destination.hitVisualElectric = source.hitVisualElectric
	destination.shieldVisualSerial = source.shieldVisualSerial
	destination.stocks = source.stocks
	destination.hitstun = source.hitstun
	destination.hitlag = source.hitlag
	destination.diPending = source.diPending
	destination.diLaunchSpeed = source.diLaunchSpeed
	destination.diSerial = source.diSerial
	destination.diAngleDegrees = source.diAngleDegrees
	destination.sdiWasGrounded = source.sdiWasGrounded
	destination.sdiLaunchesUpward = source.sdiLaunchesUpward
	destination.sdiSerial = source.sdiSerial
	destination.asdiSerial = source.asdiSerial
	destination.cooldown = source.cooldown
	destination.attackStyle = source.attackStyle
	destination.attackFrame = source.attackFrame
	destination.attackDuration = source.attackDuration
	destination.attackSerial = source.attackSerial
	destination.attackHit = source.attackHit
	destination.smashCharging = source.smashCharging
	destination.smashChargeFrames = source.smashChargeFrames
	destination.smashChargeAllowed = source.smashChargeAllowed
	destination.freezeTrapLife = source.freezeTrapLife
	destination.freezeTrapArming = source.freezeTrapArming
	destination.freezeTrapX = source.freezeTrapX
	destination.freezeTrapZ = source.freezeTrapZ
	destination.freezeTrapSurface = source.freezeTrapSurface
	destination.freezeTrapSerial = source.freezeTrapSerial
	destination.frozenFrames = source.frozenFrames
	destination.freezeTrapCooldown = source.freezeTrapCooldown
	destination.out = source.out
	destination.respawn = source.respawn
	destination.shield = source.shield
	destination.shieldEnergy = source.shieldEnergy
	destination.shieldStun = source.shieldStun
	destination.shieldHeldFrames = source.shieldHeldFrames
	destination.shieldReleaseLag = source.shieldReleaseLag
	destination.shieldBreakState = source.shieldBreakState
	destination.shieldBreakFrame = source.shieldBreakFrame
	destination.shieldBreakSerial = source.shieldBreakSerial
	destination.shieldBreakDownFrames = source.shieldBreakDownFrames
	destination.shieldBreakStandFrames = source.shieldBreakStandFrames
	destination.shieldBreakRemaining = source.shieldBreakRemaining
	destination.grounded = source.grounded
	destination.crouching = source.crouching
	destination.fastFalling = source.fastFalling
	destination.fastFallDownHeld = source.fastFallDownHeld
	destination.fastFallInputAge = source.fastFallInputAge
	destination.jumpInputAge = source.jumpInputAge
	destination.jumps = source.jumps
	destination.jumpSerial = source.jumpSerial
	destination.jumpIsDouble = source.jumpIsDouble
	destination.jumpSquat = source.jumpSquat
	destination.jumpDodgeQueued = source.jumpDodgeQueued
	destination.jumpDodgeX = source.jumpDodgeX
	destination.jumpDodgeZ = source.jumpDodgeZ
	destination.jumpHeld = source.jumpHeld
	destination.dropTime = source.dropTime
	destination.invincible = source.invincible
	destination.surface = source.surface
	destination.surfaceRecoveryState = source.surfaceRecoveryState
	destination.surfaceRecoveryFrame = source.surfaceRecoveryFrame
	destination.surfaceRecoveryVelocityApplied = source.surfaceRecoveryVelocityApplied
	destination.surfaceWallJumpQueued = source.surfaceWallJumpQueued
	destination.surfaceReflectCooldown = source.surfaceReflectCooldown
	destination.lastReflectedSurface = source.lastReflectedSurface
	destination.surfaceContactSerial = source.surfaceContactSerial
	destination.surfaceContactKind = source.surfaceContactKind
	destination.surfaceContactApproachSpeed = source.surfaceContactApproachSpeed
	destination.surfaceContactX = source.surfaceContactX
	destination.surfaceContactZ = source.surfaceContactZ
	destination.surfaceContactNormalX = source.surfaceContactNormalX
	destination.surfaceContactNormalZ = source.surfaceContactNormalZ
	destination.airDodgeTime = source.airDodgeTime
	destination.landingLag = source.landingLag
	destination.lCancelWindow = source.lCancelWindow
	destination.lCancelSerial = source.lCancelSerial
	destination.airDodging = source.airDodging
	destination.airDodgeFrame = source.airDodgeFrame
	destination.groundDodgeFrame = source.groundDodgeFrame
	destination.groundDodgeDirection = source.groundDodgeDirection
	destination.groundDodgeEntryFacing = source.groundDodgeEntryFacing
	destination.downState = source.downState
	destination.downFrame = source.downFrame
	destination.downDirection = source.downDirection
	destination.downWaitRemaining = source.downWaitRemaining
	destination.downFaceUp = source.downFaceUp
	destination.techWindow = source.techWindow
	destination.techLockout = source.techLockout
	destination.techHitlagLatched = source.techHitlagLatched
	destination.grabbedFrames = source.grabbedFrames
	destination.grabAction = source.grabAction
	destination.grabFrame = source.grabFrame
	destination.grabSerial = source.grabSerial
	destination.grabMashX = source.grabMashX
	destination.grabMashZ = source.grabMashZ
	destination.grabOwner = source.grabOwner == sourceFirst ? destinationFirst : (source.grabOwner == sourceSecond ? destinationSecond : null)
	destination.grabTarget = source.grabTarget == sourceFirst ? destinationFirst : (source.grabTarget == sourceSecond ? destinationSecond : null)
	destination.ledgeState = source.ledgeState
	destination.ledgeSide = source.ledgeSide
	destination.ledgeFrame = source.ledgeFrame
	destination.ledgeSerial = source.ledgeSerial
	destination.ledgeIntangible = source.ledgeIntangible
	destination.ledgeRegrab = source.ledgeRegrab
	if source.lastHitAttacker == sourceFirst
		destination.lastHitAttacker = destinationFirst
	else if source.lastHitAttacker == sourceSecond
		destination.lastHitAttacker = destinationSecond
	else
		destination.lastHitAttacker = null
	destination.lastHitAttackSerial = source.lastHitAttackSerial
	destination.lastHitWindow = source.lastHitWindow
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileLife[i] = source.projectileLife[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileX[i] = source.projectileX[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileZ[i] = source.projectileZ[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileDirection[i] = source.projectileDirection[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileKind[i] = source.projectileKind[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileVelocityX[i] = source.projectileVelocityX[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileVelocityZ[i] = source.projectileVelocityZ[i]
	for i = 0 to PROJECTILE_CAPACITY - 1
		destination.projectileSerial[i] = source.projectileSerial[i]
	destination.specialAction = source.specialAction
	destination.specialFrame = source.specialFrame
	destination.specialDuration = source.specialDuration
	destination.specialLockFrames = source.specialLockFrames
	destination.specialFall = source.specialFall
	for i = 0 to SPECIAL_ACTION_CAPACITY - 1
		destination.specialCooldowns[i] = source.specialCooldowns[i]
	destination.specialDirection = source.specialDirection
	destination.specialHit = source.specialHit
	destination.bearLife = source.bearLife
	destination.bearX = source.bearX
	destination.bearZ = source.bearZ
	destination.bearVelocityX = source.bearVelocityX
	destination.bearVelocityZ = source.bearVelocityZ
	destination.bearSwipeCooldown = source.bearSwipeCooldown
	destination.bearHitSerial = source.bearHitSerial
	destination.bearSurface = source.bearSurface
	destination.hippogryphLife = source.hippogryphLife
	destination.hippogryphX = source.hippogryphX
	destination.hippogryphZ = source.hippogryphZ
	destination.hippogryphVelocityX = source.hippogryphVelocityX
	destination.hippogryphVelocityZ = source.hippogryphVelocityZ
	destination.hippogryphKind = source.hippogryphKind

// Slot identity survives detached snapshots; foreign references are invalid state.
function attackerSlot(FighterState attacker, FighterState first, FighterState second) returns int
	if attacker == null
		return -1
	if attacker == first
		return 0
	if attacker == second
		return 1
	return -2

function fighterDifference(FighterState expected, FighterState actual,
		FighterState expectedFirst, FighterState expectedSecond,
		FighterState actualFirst, FighterState actualSecond) returns string
	if expected.character != actual.character
		return "character"
	if expected.physics != actual.physics
		return "physics"
	if expected.surfacePhysics != actual.surfacePhysics
		return "surfacePhysics"
	if expected.ceilingTechImpulseFrame != actual.ceilingTechImpulseFrame
		return "ceilingTechImpulseFrame"
	if expected.ceilingTechAnimationEndFrame != actual.ceilingTechAnimationEndFrame
		return "ceilingTechAnimationEndFrame"
	if expected.wallTechAnimationEndFrame != actual.wallTechAnimationEndFrame
		return "wallTechAnimationEndFrame"
	if expected.wallJumpTechAnimationEndFrame != actual.wallJumpTechAnimationEndFrame
		return "wallJumpTechAnimationEndFrame"
	if expected.facing != actual.facing
		return "facing"
	if expected.lastAerialTapDirection != actual.lastAerialTapDirection
		return "lastAerialTapDirection"
	if expected.dashFrame != actual.dashFrame
		return "dashFrame"
	if expected.dashDirection != actual.dashDirection
		return "dashDirection"
	if expected.groundRules != actual.groundRules
		return "groundRules"
	if expected.dashGrabTiming.startupFrames != actual.dashGrabTiming.startupFrames or
		expected.dashGrabTiming.activeFrames != actual.dashGrabTiming.activeFrames or
		expected.dashGrabTiming.totalFrames != actual.dashGrabTiming.totalFrames
		return "dashGrabTiming"
	if expected.dashGrabWindow != actual.dashGrabWindow
		return "dashGrabWindow"
	if expected.dashGrabAttack != actual.dashGrabAttack
		return "dashGrabAttack"
	if expected.groundAction != actual.groundAction
		return "groundAction"
	if expected.groundActionFrame != actual.groundActionFrame
		return "groundActionFrame"
	if expected.groundRunBrakeFramesRemaining != actual.groundRunBrakeFramesRemaining
		return "groundRunBrakeFramesRemaining"
	if expected.groundTurnRunEntryFacing != actual.groundTurnRunEntryFacing
		return "groundTurnRunEntryFacing"
	if expected.groundTurnRunFacingCommandLatched != actual.groundTurnRunFacingCommandLatched
		return "groundTurnRunFacingCommandLatched"
	if expected.groundTurnRunPausePending != actual.groundTurnRunPausePending
		return "groundTurnRunPausePending"
	if expected.x != actual.x
		return "x"
	if expected.z != actual.z
		return "z"
	if expected.positionDeltaX != actual.positionDeltaX
		return "positionDeltaX"
	if expected.positionDeltaZ != actual.positionDeltaZ
		return "positionDeltaZ"
	if expected.vx != actual.vx
		return "vx"
	if expected.vz != actual.vz
		return "vz"
	if expected.knockbackX != actual.knockbackX
		return "knockbackX"
	if expected.knockbackZ != actual.knockbackZ
		return "knockbackZ"
	if expected.groundKnockbackX != actual.groundKnockbackX
		return "groundKnockbackX"
	if expected.knockbackAgeFrames != actual.knockbackAgeFrames
		return "knockbackAgeFrames"
	if expected.damageLevel != actual.damageLevel
		return "damageLevel"
	if expected.shieldPushbackX != actual.shieldPushbackX
		return "shieldPushbackX"
	if expected.shieldRecoilX != actual.shieldRecoilX
		return "shieldRecoilX"
	if expected.shieldRecoilZ != actual.shieldRecoilZ
		return "shieldRecoilZ"
	if expected.shieldDrainResumePending != actual.shieldDrainResumePending
		return "shieldDrainResumePending"
	if expected.damage != actual.damage
		return "damage"
	if expected.hitVisualSerial != actual.hitVisualSerial
		return "hitVisualSerial"
	if expected.hitVisualElectric != actual.hitVisualElectric
		return "hitVisualElectric"
	if expected.shieldVisualSerial != actual.shieldVisualSerial
		return "shieldVisualSerial"
	if expected.stocks != actual.stocks
		return "stocks"
	if expected.hitstun != actual.hitstun
		return "hitstun"
	if expected.hitlag != actual.hitlag
		return "hitlag"
	if expected.diPending != actual.diPending
		return "diPending"
	if expected.diLaunchSpeed != actual.diLaunchSpeed
		return "diLaunchSpeed"
	if expected.diSerial != actual.diSerial
		return "diSerial"
	if expected.diAngleDegrees != actual.diAngleDegrees
		return "diAngleDegrees"
	if expected.sdiWasGrounded != actual.sdiWasGrounded
		return "sdiWasGrounded"
	if expected.sdiLaunchesUpward != actual.sdiLaunchesUpward
		return "sdiLaunchesUpward"
	if expected.sdiSerial != actual.sdiSerial
		return "sdiSerial"
	if expected.asdiSerial != actual.asdiSerial
		return "asdiSerial"
	if expected.cooldown != actual.cooldown
		return "cooldown"
	if expected.attackStyle != actual.attackStyle
		return "attackStyle"
	if expected.attackFrame != actual.attackFrame
		return "attackFrame"
	if expected.attackDuration != actual.attackDuration
		return "attackDuration"
	if expected.attackSerial != actual.attackSerial
		return "attackSerial"
	if expected.attackHit != actual.attackHit
		return "attackHit"
	let expectedSlot = attackerSlot(expected.lastHitAttacker, expectedFirst, expectedSecond)
	let actualSlot = attackerSlot(actual.lastHitAttacker, actualFirst, actualSecond)
	if expectedSlot == -2 or actualSlot == -2 or expectedSlot != actualSlot
		return "lastHitAttacker"
	if expected.lastHitAttackSerial != actual.lastHitAttackSerial
		return "lastHitAttackSerial"
	if expected.lastHitWindow != actual.lastHitWindow
		return "lastHitWindow"
	if expected.smashCharging != actual.smashCharging
		return "smashCharging"
	if expected.smashChargeFrames != actual.smashChargeFrames
		return "smashChargeFrames"
	if expected.smashChargeAllowed != actual.smashChargeAllowed
		return "smashChargeAllowed"
	if expected.freezeTrapLife != actual.freezeTrapLife
		return "freezeTrapLife"
	if expected.freezeTrapArming != actual.freezeTrapArming
		return "freezeTrapArming"
	if expected.freezeTrapX != actual.freezeTrapX
		return "freezeTrapX"
	if expected.freezeTrapZ != actual.freezeTrapZ
		return "freezeTrapZ"
	if expected.freezeTrapSurface != actual.freezeTrapSurface
		return "freezeTrapSurface"
	if expected.freezeTrapSerial != actual.freezeTrapSerial
		return "freezeTrapSerial"
	if expected.frozenFrames != actual.frozenFrames
		return "frozenFrames"
	if expected.freezeTrapCooldown != actual.freezeTrapCooldown
		return "freezeTrapCooldown"
	if expected.out != actual.out
		return "out"
	if expected.respawn != actual.respawn
		return "respawn"
	if expected.shield != actual.shield
		return "shield"
	if expected.shieldEnergy != actual.shieldEnergy
		return "shieldEnergy"
	if expected.shieldStun != actual.shieldStun
		return "shieldStun"
	if expected.shieldHeldFrames != actual.shieldHeldFrames
		return "shieldHeldFrames"
	if expected.shieldReleaseLag != actual.shieldReleaseLag
		return "shieldReleaseLag"
	if expected.shieldBreakState != actual.shieldBreakState
		return "shieldBreakState"
	if expected.shieldBreakFrame != actual.shieldBreakFrame
		return "shieldBreakFrame"
	if expected.shieldBreakSerial != actual.shieldBreakSerial
		return "shieldBreakSerial"
	if expected.shieldBreakDownFrames != actual.shieldBreakDownFrames
		return "shieldBreakDownFrames"
	if expected.shieldBreakStandFrames != actual.shieldBreakStandFrames
		return "shieldBreakStandFrames"
	if expected.shieldBreakRemaining != actual.shieldBreakRemaining
		return "shieldBreakRemaining"
	if expected.crouching != actual.crouching
		return "crouching"
	if expected.fastFallDownHeld != actual.fastFallDownHeld
		return "fastFallDownHeld"
	if expected.fastFallInputAge != actual.fastFallInputAge
		return "fastFallInputAge"
	if expected.jumpInputAge != actual.jumpInputAge
		return "jumpInputAge"
	if expected.fastFalling != actual.fastFalling
		return "fastFalling"
	if expected.grounded != actual.grounded
		return "grounded"
	if expected.jumps != actual.jumps
		return "jumps"
	if expected.jumpSerial != actual.jumpSerial
		return "jumpSerial"
	if expected.jumpIsDouble != actual.jumpIsDouble
		return "jumpIsDouble"
	if expected.jumpSquat != actual.jumpSquat
		return "jumpSquat"
	if expected.jumpDodgeQueued != actual.jumpDodgeQueued
		return "jumpDodgeQueued"
	if expected.jumpDodgeX != actual.jumpDodgeX
		return "jumpDodgeX"
	if expected.jumpDodgeZ != actual.jumpDodgeZ
		return "jumpDodgeZ"
	if expected.jumpHeld != actual.jumpHeld
		return "jumpHeld"
	if expected.dropTime != actual.dropTime
		return "dropTime"
	if expected.invincible != actual.invincible
		return "invincible"
	if expected.surface != actual.surface
		return "surface"
	if expected.surfaceRecoveryState != actual.surfaceRecoveryState
		return "surfaceRecoveryState"
	if expected.surfaceRecoveryFrame != actual.surfaceRecoveryFrame
		return "surfaceRecoveryFrame"
	if expected.surfaceRecoveryVelocityApplied != actual.surfaceRecoveryVelocityApplied
		return "surfaceRecoveryVelocityApplied"
	if expected.surfaceWallJumpQueued != actual.surfaceWallJumpQueued
		return "surfaceWallJumpQueued"
	if expected.surfaceReflectCooldown != actual.surfaceReflectCooldown
		return "surfaceReflectCooldown"
	if expected.lastReflectedSurface != actual.lastReflectedSurface
		return "lastReflectedSurface"
	if expected.surfaceContactSerial != actual.surfaceContactSerial
		return "surfaceContactSerial"
	if expected.surfaceContactKind != actual.surfaceContactKind
		return "surfaceContactKind"
	if expected.surfaceContactApproachSpeed != actual.surfaceContactApproachSpeed
		return "surfaceContactApproachSpeed"
	if expected.surfaceContactX != actual.surfaceContactX
		return "surfaceContactX"
	if expected.surfaceContactZ != actual.surfaceContactZ
		return "surfaceContactZ"
	if expected.surfaceContactNormalX != actual.surfaceContactNormalX
		return "surfaceContactNormalX"
	if expected.surfaceContactNormalZ != actual.surfaceContactNormalZ
		return "surfaceContactNormalZ"
	if expected.airDodgeTime != actual.airDodgeTime
		return "airDodgeTime"
	if expected.landingLag != actual.landingLag
		return "landingLag"
	if expected.lCancelWindow != actual.lCancelWindow
		return "lCancelWindow"
	if expected.lCancelSerial != actual.lCancelSerial
		return "lCancelSerial"
	if expected.airDodging != actual.airDodging
		return "airDodging"
	if expected.airDodgeFrame != actual.airDodgeFrame
		return "airDodgeFrame"
	if expected.groundDodgeFrame != actual.groundDodgeFrame
		return "groundDodgeFrame"
	if expected.groundDodgeEntryFacing != actual.groundDodgeEntryFacing
		return "groundDodgeEntryFacing"
	if expected.groundDodgeDirection != actual.groundDodgeDirection
		return "groundDodgeDirection"
	if expected.downState != actual.downState
		return "downState"
	if expected.downFrame != actual.downFrame
		return "downFrame"
	if expected.downDirection != actual.downDirection
		return "downDirection"
	if expected.downWaitRemaining != actual.downWaitRemaining
		return "downWaitRemaining"
	if expected.downFaceUp != actual.downFaceUp
		return "downFaceUp"
	if expected.techWindow != actual.techWindow
