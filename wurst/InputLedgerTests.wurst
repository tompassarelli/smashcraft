package InputLedgerTests
import NetworkInput
import InputProtocol
import InputLedger

@Test function ledgerAdvancesOnlyAcrossCompleteRowsAfterGapRecovery()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(0, 1, 0, 3).assertTrue()
    packet.assign(0, 2, 2, row, row).assertTrue()
    ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(0)
    packet.assign(0, 1, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(0)
    ledger.markConsumed(0, 1).assertFalse()
    ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(3)
    ledger.consumedThrough().assertEquals(0)
    ledger.markConsumed(0, 2).assertFalse()
    ledger.markConsumed(0, 1).assertTrue()
    ledger.markConsumed(0, 1).assertFalse()
    ledger.markConsumed(0, 2).assertTrue()

@Test function ledgerAcceptedCopiesAndDuplicatesAreImmutable()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    let output = new NetworkInput()
    ledger.beginEpoch(1, 1, 0, 3).assertTrue()
    row.assign(32, 32, 16, 1, -1, 23, 45).assertTrue()
    packet.assign(1, 1, 1, row, row).assertTrue()
    ledger.receive(0, packet.encode()).assertEquals(INPUT_ACCEPTED)
    ledger.receive(0, packet.encode()).assertEquals(INPUT_ACCEPTED)
    row.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    ledger.copyAccepted(1, 0, 1, output).assertTrue()
    output.heldMask().assertEquals(32)
    output.assign(1, 0, 0, 0, 0, 0, 0).assertTrue()
    ledger.copyAccepted(1, 0, 1, output).assertTrue()
    output.pressedMask().assertEquals(32)
    packet.assign(1, 1, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_CONFLICT)
    ledger.copyAccepted(1, 0, 1, output).assertTrue()
    output.releasedMask().assertEquals(16)
    ledger.predictFrom(1, 0, 1, output).assertTrue()
    output.heldMask().assertEquals(32)
    output.pressedMask().assertEquals(0)
    output.releasedMask().assertEquals(0)
    output.triggerRight().assertEquals(45)
    ledger.knownThrough().assertEquals(0)
    ledger.predictFrom(1, 1, 1, output).assertFalse()
    ledger.copyAccepted(1, 0, 1, output).assertTrue()
    output.pressedMask().assertEquals(32)

@Test function ledgerRejectsWholeBatchWhenSecondRowConflicts()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let neutral = new NetworkInput()
    let attack = new NetworkInput()
    attack.assign(32, 32, 0, 0, 0, 0, 0).assertTrue()
    ledger.beginEpoch(1, 1, 0, 3).assertTrue()
    packet.assign(1, 2, 1, attack, attack).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    packet.assign(1, 1, 2, neutral, neutral).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_CONFLICT)
    ledger.contains(1, 0, 1).assertFalse()
    packet.assign(1, 1, 2, neutral, attack).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.contains(1, 0, 1).assertTrue()
    ledger.knownThrough().assertEquals(0)

@Test function ledgerBoundsFutureByConsumptionAndRejectsAtomicBoundaryBatch()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(1, 1, 0, 3).assertTrue()
    packet.assign(1, 64, 2, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_TOO_FAR_AHEAD)
    ledger.contains(1, 0, 64).assertFalse()
    packet.assign(1, 64, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(0)
    for frame = 1 to 64
        packet.assign(1, frame, 1, row, row).assertTrue()
        ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
        ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(64)
    packet.assign(1, 65, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_TOO_FAR_AHEAD)
    ledger.markConsumed(1, 1).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)

@Test function ledgerSeedsNeutralDelayAndRejectsStaleEpochsAndObservers()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    let output = new NetworkInput()
    ledger.beginEpoch(-1, 1, 3, 3).assertFalse()
    ledger.beginEpoch(1, 0, 3, 3).assertFalse()
    ledger.beginEpoch(1, 1, 65, 3).assertFalse()
    ledger.beginEpoch(1, 1, -1, 3).assertFalse()
    packet.assign(1, 1, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_WRONG_EPOCH)
    ledger.beginEpoch(1, 1, 3, 3).assertTrue()
    ledger.knownThrough().assertEquals(3)
    ledger.consumedThrough().assertEquals(0)
    for frame = 1 to 3
        for sender = 0 to 1
            ledger.copyAccepted(1, sender, frame, output).assertTrue()
            output.sameAs(row).assertTrue()
    ledger.contains(1, 0, 0).assertFalse()
    ledger.receive(-1, packet.encode()).assertEquals(INPUT_WRONG_SENDER)
    ledger.receive(2, packet.encode()).assertEquals(INPUT_WRONG_SENDER)
    ledger.contains(1, 2, 1).assertFalse()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    row.assign(32, 32, 0, 0, 0, 0, 0).assertTrue()
    packet.assign(1, 1, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_CONFLICT)
    ledger.beginEpoch(1, 1, 0, 3).assertFalse()
    ledger.beginEpoch(0, 1, 0, 3).assertFalse()
    ledger.knownThrough().assertEquals(3)
    ledger.beginEpoch(2, 1, 0, 3).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_WRONG_EPOCH)
    ledger.contains(1, 0, 1).assertFalse()
    ledger.contains(2, 0, 1).assertFalse()
    ledger.markConsumed(1, 1).assertFalse()
    ledger.discardThrough(1, 0).assertFalse()
    ledger.knownThrough().assertEquals(0)

@Test function ledgerRetainsUntilExplicitDiscardAndSafelyReusesRing()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(1, 1, 0, 3).assertTrue()
    for frame = 1 to 256
        packet.assign(1, frame, 1, row, row).assertTrue()
        ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
        ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
        ledger.markConsumed(1, frame).assertTrue()
    ledger.firstRetained().assertEquals(1)
    ledger.contains(1, 0, 1).assertTrue()
    packet.assign(1, 257, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_STORAGE_FULL)
    ledger.discardThrough(1, 257).assertFalse()
    ledger.contains(1, 0, 1).assertTrue()
    ledger.discardThrough(1, 1).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(257)
    ledger.markConsumed(1, 257).assertTrue()
    ledger.contains(1, 0, 1).assertFalse()
    ledger.contains(1, 0, 257).assertTrue()
    packet.assign(1, 1, 2, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_OUT_OF_HISTORY)
    ledger.discardThrough(1, 257).assertTrue()
    ledger.firstRetained().assertEquals(258)
    ledger.contains(1, 0, 257).assertFalse()
    ledger.discardThrough(1, 256).assertFalse()

@Test function ledgerMalformedSecondRecordCannotCommitFirst()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(1, 1, 0, 3).assertTrue()
    packet.assign(1, 1, 2, row, row).assertTrue()
    let wire = packet.encode()
    ledger.receive(0, wire.substring(0, wire.length() - 1) + "1800").assertEquals(INPUT_MALFORMED)
    ledger.contains(1, 0, 1).assertFalse()
    ledger.contains(1, 0, 2).assertFalse()
    ledger.receive(0, wire).assertEquals(INPUT_ACCEPTED)
    ledger.receive(1, wire).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(2)

@Test function ledgerEpochAndFrameLimitsNeverWrapSignedCounters()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(0, INPUT_LAST_FRAME, 2, 3).assertFalse()
    ledger.beginEpoch(0, 2147483647, 0, 3).assertFalse()
    ledger.beginEpoch(2147483647, INPUT_LAST_FRAME - 1, 0, 3).assertTrue()
    packet.assign(2147483647, INPUT_LAST_FRAME - 1, 2, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(1, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(INPUT_LAST_FRAME)
    ledger.markConsumed(2147483647, INPUT_LAST_FRAME - 1).assertTrue()
    ledger.markConsumed(2147483647, INPUT_LAST_FRAME).assertTrue()
    ledger.markConsumed(2147483647, 2147483647).assertFalse()
    ledger.discardThrough(2147483647, INPUT_LAST_FRAME).assertTrue()
    ledger.firstRetained().assertEquals(2147483647)
    ledger.beginEpoch(-2147483647, 1, 0, 3).assertFalse()
    ledger.beginEpoch(2147483647, 1, 0, 3).assertFalse()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_OUT_OF_HISTORY)

@Test function fourParticipantLedgerWaitsForSlotThreeAndKeepsAtomicTimeBatches()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    let other = new NetworkInput()
    ledger.beginEpoch(10, 1, 0, 15).assertTrue()
    row.assign(23, 17, 12, 127, -81, 42, 255).assertTrue()
    row.assignThrowContributions(-3, 7).assertTrue()
    other.assign(31, 9, 4, -7, 43, 111, 0).assertTrue()
    packet.assign(10, 1, 2, row, other).assertTrue()
    for sender = 0 to 2
        ledger.receive(sender, packet.encode()).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(0)
    ledger.contains(10, 3, 1).assertFalse()
    ledger.markConsumed(10, 1).assertFalse()
    packet.assign(10, 2, 1, other, other).assertTrue()
    ledger.acceptPacket(3, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(0)
    packet.assign(10, 1, 2, row, row).assertTrue()
    ledger.acceptPacket(3, packet).assertEquals(INPUT_CONFLICT)
    ledger.contains(10, 3, 1).assertFalse()
    packet.assign(10, 1, 2, row, other).assertTrue()
    ledger.acceptPacket(3, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(3, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(2)
    ledger.copyAccepted(10, 3, 1, other).assertTrue()
    other.sameAs(row).assertTrue()

@Test function sparseMembershipIsEpochBoundAndRejectsInactiveSenders()
    let ledger = new InputLedger()
    let packet = new InputPacket()
    let row = new NetworkInput()
    ledger.beginEpoch(1, 1, 2, 0).assertFalse()
    ledger.beginEpoch(1, 1, 2, 16).assertFalse()
    ledger.beginEpoch(1, 1, 2, 13).assertTrue()
    ledger.participantMask().assertEquals(13)
    ledger.knownThrough().assertEquals(2)
    ledger.contains(1, 1, 1).assertFalse()
    ledger.contains(1, 3, 1).assertTrue()
    packet.assign(1, 3, 1, row, row).assertTrue()
    ledger.acceptPacket(1, packet).assertEquals(INPUT_WRONG_SENDER)
    ledger.acceptPacket(4, packet).assertEquals(INPUT_WRONG_SENDER)
    ledger.acceptPacket(3, packet).assertEquals(INPUT_ACCEPTED)
    ledger.acceptPacket(0, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(2)
    ledger.acceptPacket(2, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(3)
    ledger.beginEpoch(2, 1, 0, -1).assertFalse()
    ledger.participantMask().assertEquals(13)
    ledger.beginEpoch(2, 1, 0, 8).assertTrue()
    ledger.contains(2, 3, 1).assertFalse()
    packet.assign(2, 1, 1, row, row).assertTrue()
    ledger.acceptPacket(0, packet).assertEquals(INPUT_WRONG_SENDER)
    ledger.acceptPacket(3, packet).assertEquals(INPUT_ACCEPTED)
    ledger.knownThrough().assertEquals(1)
