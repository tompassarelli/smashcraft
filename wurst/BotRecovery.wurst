package BotRecovery
import Simulation

// Produce ordinary frame inputs; recovery never moves the fighter directly.
public function chooseRecoveryInput(FighterState fighter, int stage, InputSnapshot input) returns boolean
    input.specialPressed = false
    input.specialX = 0
    input.specialZ = 0
    input.verticalDirection = 0
    input.ledgeVerticalPressed = 0
    if fighter.out
        return false
    if fighter.ledgeState != LEDGE_NONE
        input.direction = -fighter.ledgeSide
        input.ledgeVerticalPressed = fighter.ledgeState == LEDGE_HANG ? 1 : 0
        return true
    let left = surfaceLeft(stage, 0)
    let right = surfaceRight(stage, 0)
    let floor = surfaceZ(stage, 0)
    if fighter.grounded or (fighter.x >= left and fighter.x <= right and fighter.z >= floor)
        return false
    let landingX = fighter.x < 0 ? left + 60 : right - 60
    input.direction = fighter.x < landingX ? 1 : -1
    if fighter.hitstun > 0 or fighter.hitlag > 0 or fighter.specialAction != SPECIAL_NONE
        return true
    if totalVelocityZ(fighter) <= 0 and fighter.z < floor + 100
        if fighter.jumps > 0 and fighter.cooldown == 0
            input.jumpPressed = true
            input.jumpHeld = true
        else if fighter.z < floor + 50
            input.specialPressed = true
            input.specialX = input.direction
            input.specialZ = 1
            input.verticalDirection = 1
    return true
