package DevConsoleTests
import DevConsole
import ReplayHistory

@Test function devCommandsSetNextMatchWindowAndDelay()
	let settings = new DevSettings(24, 0, 2)
	settings.apply("-dev rb 64").assertEquals("dev: next match rb=64 delay=0 batch=2")
	settings.apply("-dev delay 2").assertEquals("dev: next match rb=64 delay=2 batch=2")
	settings.apply("-dev batch 1").assertEquals("dev: next match rb=64 delay=2 batch=1")
	settings.apply("-dev show").assertEquals("dev: next match rb=64 delay=2 batch=1")
	settings.rollback.assertEquals(64)
	settings.delay.assertEquals(2)
	settings.batch.assertEquals(1)

@Test function devCommandsRejectValuesTheScheduleCannotStart()
	let settings = new DevSettings(24, 0, 2)
	settings.apply("-dev rb 0").assertEquals("dev: rb must be 1-" + I2S(REPLAY_MAX_CORRECTION_FRAMES))
	settings.apply("-dev rb " + I2S(REPLAY_MAX_CORRECTION_FRAMES + 1)).assertEquals("dev: rb must be 1-" + I2S(REPLAY_MAX_CORRECTION_FRAMES))
	settings.apply("-dev rb 64x").assertEquals("dev: rb must be 1-" + I2S(REPLAY_MAX_CORRECTION_FRAMES))
	settings.apply("-dev delay 4").assertEquals("dev: delay must be 0, 1, 2, 3 or 5")
	settings.apply("-dev batch 3").assertEquals("dev: batch must be 1 or 2")
	settings.apply("-dev nothing").assertEquals("")
	settings.apply("hello -dev rb 64").assertEquals("")
	settings.rollback.assertEquals(24)
	settings.delay.assertEquals(0)
	settings.batch.assertEquals(2)
