package FighterAssets
import UnitObjEditing
import public FighterAssetInfo
import public DemonHunterAssetInfo

public constant int ARCHER_FIGHTER_ID = 'mfar'
public constant int RIFLEMAN_FIGHTER_ID = 'mfrf'
public constant int DEMON_HUNTER_FIGHTER_ID = 'mfdh'

@compiletime function defineFighterAssets()
    let archer = new UnitDefinition(ARCHER_FIGHTER_ID, 'earc')
    archer.setName("Archer")
    archer.setModelFile(ARCHER_MODEL_FILE)
    archer.setModelFileExtraVersions(0)
    archer.setScalingValue(1.)
    archer.setAnimationBlendTimeseconds(0.)
    archer.setSelectionScale(0.)
    let rifleman = new UnitDefinition(RIFLEMAN_FIGHTER_ID, 'hrif')
    rifleman.setName("Rifleman")
    rifleman.setModelFile(RIFLEMAN_MODEL_FILE)
    rifleman.setModelFileExtraVersions(0)
    rifleman.setScalingValue(1.)
    rifleman.setAnimationBlendTimeseconds(0.)
    rifleman.setSelectionScale(0.)
    let demonHunter = new UnitDefinition(DEMON_HUNTER_FIGHTER_ID, 'earc')
    demonHunter.setName("Illidan")
    demonHunter.setModelFile(DEMON_HUNTER_MODEL_FILE)
    demonHunter.setModelFileExtraVersions(0)
    demonHunter.setScalingValue(1.)
    demonHunter.setAnimationBlendTimeseconds(0.)
    demonHunter.setSelectionScale(0.)
