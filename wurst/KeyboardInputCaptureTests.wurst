package KeyboardInputCaptureTests
import KeyboardInputCapture
import NetworkInput
import KeyBindings
import FixedInputSchedule

@Test function keyboardCaptureRetainsTapAndDeduplicatesHeldSamples()
    let sampler = new KeyboardInputCapture()
    let row = new NetworkInput()
    let schedule = new FixedInputSchedule()
    schedule.beginEpoch(1, 3).assertTrue()
    sampler.sample(inputActionBit(JUMP)).assertTrue()
    sampler.sample(inputActionBit(JUMP)).assertTrue()
    sampler.sample(0).assertTrue()
    sampler.read(row)
    row.heldMask().assertEquals(0)
    row.pressedMask().assertEquals(inputActionBit(JUMP))
    row.releasedMask().assertEquals(inputActionBit(JUMP))
    sampler.capture(schedule, 1).assertEquals(FIXED_CAPTURED)
    schedule.copyPending(1, 4, row).assertTrue()
    row.actionPressed(JUMP).assertTrue()
    row.actionReleased(JUMP).assertTrue()
    sampler.read(row)
    row.pressedMask().assertEquals(0)
    row.releasedMask().assertEquals(0)

@Test function keyboardCaptureWaitKeepsNextTapWithoutRewritingAssignedInput()
    let sampler = new KeyboardInputCapture()
    let schedule = new FixedInputSchedule()
    let first = new NetworkInput()
    let second = new NetworkInput()
    schedule.beginEpoch(1, 3).assertTrue()
    sampler.capture(schedule, 1).assertEquals(FIXED_CAPTURED)
    sampler.sample(inputActionBit(ATTACK)).assertTrue()
    sampler.sample(0).assertTrue()
    for service = 1 to 20
        sampler.capture(schedule, 1).assertEquals(FIXED_ALREADY_CAPTURED)
    schedule.copyPending(1, 4, first).assertTrue()
    first.pressedMask().assertEquals(0)
    schedule.knownThrough().assertEquals(3)
    schedule.readNext(1, first, second).assertTrue()
    schedule.complete(1, 1).assertTrue()
    sampler.capture(schedule, 1).assertEquals(FIXED_CAPTURED)
    schedule.copyPending(1, 5, first).assertTrue()
    first.actionPressed(ATTACK).assertTrue()
    first.actionReleased(ATTACK).assertTrue()
    first.heldMask().assertEquals(0)

@Test function keyboardCaptureNormalizesMovementAndKeepsCStickSeparate()
    let sampler = new KeyboardInputCapture()
    let row = new NetworkInput()
    sampler.sample(inputActionBit(MOVE_LEFT) + inputActionBit(MOVE_RIGHT) + inputActionBit(MOVE_DOWN) + inputActionBit(MOVE_UP)).assertTrue()
    sampler.read(row)
    row.axisX().assertEquals(0)
    row.axisZ().assertEquals(0)
    sampler.sample(inputActionBit(SMASH_DOWN) + inputActionBit(LEFT_TRIGGER)).assertTrue()
    sampler.read(row)
    row.axisX().assertEquals(0)
    row.axisZ().assertEquals(0)
    row.actionPressed(SMASH_DOWN).assertTrue()
    row.triggerLeft().assertEquals(255)
    row.triggerRight().assertEquals(0)
    sampler.sample(inputActionBit(MOVE_RIGHT) + inputActionBit(MOVE_DOWN)).assertTrue()
    sampler.read(row)
    row.axisX().assertEquals(127)
    row.axisZ().assertEquals(-127)

@Test function keyboardCaptureRejectsInvalidSampleAndFailedCommitKeepsEdges()
    let sampler = new KeyboardInputCapture()
    let schedule = new FixedInputSchedule()
    let before = new NetworkInput()
    let after = new NetworkInput()
    sampler.sample(inputActionBit(SPECIAL)).assertTrue()
    sampler.read(before)
    sampler.sample(-1).assertFalse()
    sampler.sample(32768).assertFalse()
    sampler.capture(schedule, 1).assertEquals(FIXED_WRONG_EPOCH)
    sampler.read(after)
    before.sameAs(after).assertTrue()

@Test function keyboardCaptureFocusNeutralReleasesAndPauseClearDiscardsActions()
    let sampler = new KeyboardInputCapture()
    let schedule = new FixedInputSchedule()
    let row = new NetworkInput()
    schedule.beginEpoch(1, 3).assertTrue()
    sampler.sample(inputActionBit(ATTACK)).assertTrue()
    sampler.capture(schedule, 1).assertEquals(FIXED_CAPTURED)
    sampler.sample(inputActionBit(ATTACK)).assertTrue()
    sampler.read(row)
    row.pressedMask().assertEquals(0)
    sampler.sample(0).assertTrue()
    sampler.read(row)
    row.actionReleased(ATTACK).assertTrue()
    row.actionHeld(ATTACK).assertFalse()
    sampler.sample(inputActionBit(JUMP)).assertTrue()
    sampler.clear()
    sampler.read(row)
    row.heldMask().assertEquals(0)
    row.pressedMask().assertEquals(0)
    row.releasedMask().assertEquals(0)
