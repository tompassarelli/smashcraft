package ShieldPose
import Wurst
import Simulation

public tuple shieldPose(boolean visible, real x, real z, real scale)

public function projectedShield(FighterState fighter, boolean playing) returns shieldPose
    if not playing or fighter == null or fighter.out or not fighter.shield
        return shieldPose(false, 0., 0., 0.)
    return shieldPose(true, fighter.x, fighter.z + 50., 0.7 + 0.5 * fighter.shieldEnergy / SHIELD_MAX)
