package ConfirmedModelSounds
import Wurst
import Simulation
import ParticipantInputs
import FighterPose
import FighterOriginalClipInfo
import ModelSoundInfo

public tuple modelSoundEvent(int epoch, int frame, int slot, int selectionSerial, int ordinal, int loopIndex, int soundIndex)

// The sink belongs to confirmed presentation, never a replay snapshot or executor.
public abstract class ModelSoundSink
    abstract function emit(modelSoundEvent occurrence, real x, real z)

public function modelSoundCrossed(real fromSeconds, real throughSeconds, real cueSeconds, real duration, boolean looping, int loopIndex) returns boolean
    if loopIndex < 0 or cueSeconds < 0. or cueSeconds > duration or throughSeconds < fromSeconds
        return false
    if loopIndex > 0 and (not looping or duration <= 0.)
        return false
    let eventSeconds = cueSeconds + loopIndex * duration
    return eventSeconds > fromSeconds and eventSeconds <= throughSeconds

public function emitModelSoundInterval(ModelSoundSink sink, int epoch, int frame, int slot, int character, int selectionSerial, int clipIndex, real fromSeconds, real throughSeconds, real x, real z)
    let clip = originalClip(character, clipIndex)
    if not clip.valid or throughSeconds < fromSeconds
        return
    let duration = clip.endSeconds - clip.startSeconds
    var firstLoop = 0
    var lastLoop = 0
    if clip.looping and duration > 0.
        firstLoop = R2I(max(0., fromSeconds) / duration)
        lastLoop = R2I(max(0., throughSeconds) / duration)
    // Each authored key is distinct, including simultaneous keys and clip-end /
    // next-loop-start keys. There is no capacity that can discard catch-up cues.
    for loopIndex = firstLoop to lastLoop
        for ordinal = 0 to fighterSoundCueCount(character) - 1
            let cue = fighterSoundCue(character, ordinal)
            if cue.valid and cue.sequenceIndex == clipIndex and modelSoundCrossed(fromSeconds, throughSeconds, cue.seconds, duration, clip.looping, loopIndex)
                sink.emit(modelSoundEvent(epoch, frame, slot, selectionSerial, ordinal, loopIndex, cue.soundIndex), x, z)

public class ConfirmedModelSounds
    private int epoch = -1
    private int array[INPUT_PARTICIPANT_CAPACITY] lastFrame
    private int array[INPUT_PARTICIPANT_CAPACITY] character
    private int array[INPUT_PARTICIPANT_CAPACITY] selection
    private int array[INPUT_PARTICIPANT_CAPACITY] clipIndex
    private real array[INPUT_PARTICIPANT_CAPACITY] seconds
    private real array[INPUT_PARTICIPANT_CAPACITY] rate
    private boolean array[INPUT_PARTICIPANT_CAPACITY] audibleSelection
    private boolean array[INPUT_PARTICIPANT_CAPACITY] wasOut

    function beginEpoch(int newEpoch) returns boolean
        if newEpoch <= epoch
            return false
        epoch = newEpoch
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            lastFrame[slot] = -1
            audibleSelection[slot] = false
        return true

    // Frame zero seeds the initial selection. Subsequent calls must visit every
    // completed confirmed frame; rejected duplicate/stale/gapped calls do not
    // consume anything. Speculative execution has no reference to this cursor.
    function confirm(int requestedEpoch, int frame, int slot, FighterState fighter, FighterPose pose, ModelSoundSink sink) returns boolean
        if requestedEpoch != epoch or epoch < 0 or slot < 0 or slot >= INPUT_PARTICIPANT_CAPACITY
            return false
        if frame != lastFrame[slot] + 1 or fighter == null or pose == null
            return false
        let selected = pose.clipIndex >= 0 ? pose.clipIndex : originalClipNamed(fighter.character, pose.clipName)
        let changed = lastFrame[slot] < 0 or character[slot] != fighter.character or selection[slot] != pose.selectionSerial or clipIndex[slot] != selected
        if lastFrame[slot] >= 0 and audibleSelection[slot]
            // advance integrates the previous rate before selecting a new clip.
            let through = changed ? seconds[slot] + rate[slot] * FRAME_SECONDS : pose.clipTime
            emitModelSoundInterval(sink, epoch, frame, slot, character[slot], selection[slot], clipIndex[slot], seconds[slot], through, fighter.x, fighter.z)
        if changed
            emitModelSoundInterval(sink, epoch, frame, slot, fighter.character, pose.selectionSerial, selected, -1., pose.clipTime, fighter.x, fighter.z)
        lastFrame[slot] = frame
        character[slot] = fighter.character
        selection[slot] = pose.selectionSerial
        clipIndex[slot] = selected
        seconds[slot] = pose.clipTime
        rate[slot] = pose.rate
        // A newly selected out/death clip retains its authored sound clock.
        // Hiding an unchanged pre-KO selection stops only that stale selection.
        if changed or not fighter.out
            audibleSelection[slot] = true
        else if not wasOut[slot]
            audibleSelection[slot] = false
        wasOut[slot] = fighter.out
        return true
