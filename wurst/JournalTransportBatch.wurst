package JournalTransportBatch
import InputProtocol

// Batch transport records only: both canonical packets retain every original row.
public class JournalTransportBatch
    private string first = ""
    private string second = ""
    private int age = 0
    private int epoch = -1
    private int frame = 0
    private int rows = 0
    private InputPacket packet = new InputPacket()

    function clear()
        first = ""
        second = ""
        age = 0
        epoch = -1
        frame = 0
        rows = 0

    function append(string wire) returns boolean
        if second != "" or not packet.decode(wire) or packet.encode() != wire
            return false
        if first == ""
            first = wire
            epoch = packet.epochNumber()
            frame = packet.firstFrameNumber()
            rows = packet.recordCount()
            age = 0
        else
            if packet.epochNumber() != epoch or packet.firstFrameNumber() != frame + rows
                return false
            second = wire
            rows += packet.recordCount()
        return true

    function nextCallback()
        if first != ""
            age++

    function ready(boolean flush) returns boolean
        return first != "" and (flush or second != "" or age >= 2)

    function encode() returns string
        return second == "" ? first : "B4" + first + "|" + second

    function decode(string wire) returns boolean
        clear()
        if wire.length() < 2 or wire.substring(0, 2) != "B4"
            return append(wire)
        let split = wire.indexOf("|")
        if split < 2 or not append(wire.substring(2, split)) or not append(wire.substring(split + 1))
            clear()
            return false
        return true

    function packetWire(int index) returns string
        return index == 0 ? first : (index == 1 ? second : "")

    function packetCount() returns int
        return first == "" ? 0 : (second == "" ? 1 : 2)

    function epochNumber() returns int
        return epoch

    function firstFrameNumber() returns int
        return frame

    function recordCount() returns int
        return rows
