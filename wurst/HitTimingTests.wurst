package HitTimingTests
import Simulation

// Slippi techTester.slp ff815345e641836a331191320c0f6eae21542a5f,
// frames 3432–3445: NTSC recording, disc revision unknown. Only release
// timing is compared here; grounded knockback displacement has its own fixture.
@Test function recordedGroundedDamageResumesOnHitlagExpiry()
    let fighter = new FighterState(0, -11.548782348632812 * 6., 1)
    let input = new InputSnapshot()
    fighter.surface = 0
    fighter.hitlag = 4
    fighter.hitstun = 10
    fighter.knockbackX = 0.7562744617462158 * 6.
    input.down = true
    input.verticalDirection = -1
    let contactX = fighter.x
    for frame = 3433 to 3445
        advance(fighter, 0, input, 0)
        fighter.hitlag.assertEquals(max(0, 3436 - frame))
        fighter.hitstun.assertEquals(frame < 3436 ? 10 : 3445 - frame)
        if frame < 3436
            fighter.x.assertEquals(contactX)
        else if frame == 3436
            (fighter.x > contactX).assertTrue()
        canAttack(fighter).assertEquals(frame == 3445)
    destroy input
    destroy fighter

@Test function hitlagReleaseAllowsJumpWhenHitstunExpiresOnThatFrame()
    let fighter = new FighterState(0, 0, 1)
    let input = new InputSnapshot()
    fighter.surface = 0
    fighter.hitlag = 2
    fighter.hitstun = 1
    input.jumpPressed = true
    input.jumpHeld = true
    advance(fighter, 0, input, 0)
    fighter.hitlag.assertEquals(1)
    fighter.hitstun.assertEquals(1)
    fighter.jumpSquat.assertEquals(0)
    advance(fighter, 0, input, 0)
    fighter.hitlag.assertEquals(0)
    fighter.hitstun.assertEquals(0)
    fighter.jumpSquat.assertGreaterThan(0)
    destroy input
    destroy fighter

@Test function hitstunExpiryAllowsJumpOnTheSameTickAsAttack()
    let fighter = new FighterState(0, 0, 1)
    let input = new InputSnapshot()
    fighter.surface = 0
    fighter.hitstun = 2
    input.jumpPressed = true
    input.jumpHeld = true
    advance(fighter, 0, input, 0)
    fighter.jumpSquat.assertEquals(0)
    canAttack(fighter).assertFalse()
    advance(fighter, 0, input, 0)
    fighter.hitstun.assertEquals(0)
    fighter.jumpSquat.assertGreaterThan(0)
    destroy input
    destroy fighter

@Test function hitlagAndShieldstunRespectMeleeIntegerBoundaries()
    ordinaryHitlagFrames(0).assertEquals(0)
    ordinaryHitlagFrames(2.999).assertEquals(3)
    ordinaryHitlagFrames(3).assertEquals(4)
    ordinaryHitlagFrames(15).assertEquals(8)
    ordinaryHitlagFrames(100).assertEquals(20)
    digitalShieldstunFrames(12).assertEquals(7)
    digitalShieldstunFrames(7).assertEquals(5)
    ordinaryHitstunFrames(100).assertEquals(40)

@Test function positiveFractionalDamageKeepsOneUnitOfContactPower()
    integerHitPower(0).assertEquals(0)
    integerHitPower(0.25).assertEquals(1)
    integerHitPower(0.999).assertEquals(1)
    integerHitPower(1).assertEquals(1)
    integerHitPower(1.999).assertEquals(1)
    integerHitPower(2).assertEquals(2)
    ordinaryHitKnockback(12.75, 0.25, 80, 100, 20, 1).assertEquals(40.8583333333, 0.00001)
    digitalShieldstunFrames(0.25).assertEquals(2)
    ordinaryHitlagFrames(0.25).assertEquals(3)

@Test function shieldContactFreezesBothBodiesBeforeShieldstunCountsDown()
    let attacker = new FighterState(0, 0, 1)
    let target = new FighterState(1, 100, -1)
    let input = new InputSnapshot()
    target.shield = true
    input.shield = true
    beginAttackPair(attacker, target, 0, -1, false, false)
    attacker.attackFrame = attackStartupFrames(0)
    resolveAttackPair(attacker, target)
    attacker.hitlag.assertEquals(7)
    target.hitlag.assertEquals(7)
    target.shieldStun.assertEquals(7)
    for tick = 1 to 6
        advance(target, 0, input, 240)
        target.shieldStun.assertEquals(7)
    advance(target, 0, input, 240)
    target.shieldStun.assertEquals(6)
    destroy input
    destroy attacker
    destroy target

@Test function detachedProjectileImpactDoesNotFreezeItsShooter()
    for shielded = 0 to 1
        for kind = PROJECTILE_ARROW to PROJECTILE_RECOIL
            let shooter = new FighterState(0, 0, 1)
            let target = new FighterState(1, 100, -1)
            target.shield = shielded == 1
            shooter.projectileLife[0] = 2
            shooter.projectileKind[0] = kind
            shooter.projectileX[0] = 90
            shooter.projectileZ[0] = 45
            shooter.projectileVelocityX[0] = 20
            shooter.projectileDirection[0] = 1
            updateProjectilePair(shooter, target)
            shooter.hitlag.assertEquals(0)
            if kind == PROJECTILE_RECOIL
                target.hitlag.assertGreaterThan(0)
            else
                target.hitlag.assertEquals(0)
                target.hitstun.assertEquals(0)
                target.shieldStun.assertEquals(0)
            destroy shooter
            destroy target
