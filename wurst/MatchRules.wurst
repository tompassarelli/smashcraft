package MatchRules
import FighterPose
import ImpactState
import SpecialEffectState
import SummonState
import ImpactEvents
import Simulation
import ParticipantInputs

public constant int CHARACTER_MENU = 0
public constant int STAGE_MENU = 1
public constant int MATCH = 2
public constant int RESULT = 3
public constant int MATCH_TICKS_PER_SECOND = 60

// Frame-owned pacing and presentation history; only pacing feeds simulation.
public class ReplayRuntimeState
    int simulationFrame = 0
    real array[INPUT_PARTICIPANT_CAPACITY] botAttackDelays
    ImpactState impacts = new ImpactState()
    SpecialEffectState specials = new SpecialEffectState()
    SummonState summons = new SummonState()
    // Scratch is overwritten before every step and has no cross-frame state.
    ImpactEvents array[INPUT_PARTICIPANT_CAPACITY] frameImpacts
    FighterPose array[INPUT_PARTICIPANT_CAPACITY] poses

    construct()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            poses[slot] = new FighterPose()
            frameImpacts[slot] = new ImpactEvents()

    ondestroy
        destroy impacts
        destroy specials
        destroy summons
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            destroy poses[slot]
            destroy frameImpacts[slot]

    function resetPoses()
        impacts.clear()
        specials.clear()
        summons.clear()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            destroy poses[slot]
            poses[slot] = new FighterPose()

    function copyTo(ReplayRuntimeState destination, FighterRoster source, FighterRoster target)
        destination.simulationFrame = simulationFrame
        impacts.copyTo(destination.impacts)
        specials.copyTo(destination.specials)
        summons.copyTo(destination.summons)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            destination.botAttackDelays[slot] = botAttackDelays[slot]
            if source.active(slot)
                poses[slot].copyTo(destination.poses[slot], source, target)

public class MatchState
    int phase = CHARACTER_MENU
    int array[INPUT_PARTICIPANT_CAPACITY] characterChoices
    boolean array[INPUT_PARTICIPANT_CAPACITY] characterReadiness
    boolean array[INPUT_PARTICIPANT_CAPACITY] rematchReadiness
    int departedMask = 0
    boolean interrupted = false
    // Connected players own menu access and network senders, regardless of fighter mode.
    int humanMask = 1
    int humanFighterMask = 1
    int humanCount = 1
    int computerMask = 0
    int stageChoice = 0
    int winner = -1
    int stockCount = 3
    int timeLimitMinutes = 7
    int remainingFrames = 7 * 60 * MATCH_TICKS_PER_SECOND
    boolean timedOut = false
    boolean practice = false

    construct()
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            characterChoices[slot] = slot mod 3
            characterReadiness[slot] = false
            rematchReadiness[slot] = false

    function humanActive(int slot) returns boolean
        return participantIsActive(humanMask, slot)

    function humanPresent(int slot) returns boolean
        return humanActive(slot) and not participantIsActive(departedMask, slot)

    function firstHumanSlot() returns int
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if humanActive(slot)
                return slot
        return -1

    function humanFighterActive(int slot) returns boolean
        return participantIsActive(humanFighterMask, slot)

    function computerActive(int slot) returns boolean
        return participantIsActive(computerMask, slot)

    function canChooseComputer(int actorSlot, int computerSlot) returns boolean
        return humanPresent(actorSlot) and (actorSlot == firstHumanSlot() or actorSlot == computerSlot) and computerActive(computerSlot)

    function cpuSlot() returns int
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if computerActive(slot)
                return slot
        return -1

    function fighterMask() returns int
        return practice and phase == MATCH ? humanFighterMask : humanFighterMask + computerMask

    function fighterActive(int slot) returns boolean
        return participantIsActive(fighterMask(), slot)

    function setParticipants(int humans, int computers)
        if not validParticipantMask(humans) or computers < 0 or computers >= 16 or phase == MATCH
            return
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(humans, slot) and participantIsActive(computers, slot)
                return
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if humanActive(slot) != participantIsActive(humans, slot) or computerActive(slot) != participantIsActive(computers, slot)
                characterReadiness[slot] = false
            if participantIsActive(computers, slot)
                characterReadiness[slot] = true
            rematchReadiness[slot] = false
        humanFighterMask = humans
        computerMask = computers
        updateConnectedHumans(humans)

    function updateConnectedHumans(int humans)
        if not validParticipantMask(humans) or phase == MATCH
            return
        humanMask = humans
        departedMask = 0
        interrupted = false
        humanCount = 0
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if humanActive(slot)
                humanCount++

    function canCycleSlotMode(int actorSlot, int fighterSlot) returns boolean
        return phase == CHARACTER_MENU and humanPresent(actorSlot) and fighterSlot >= 0 and fighterSlot < INPUT_PARTICIPANT_CAPACITY and (actorSlot == fighterSlot or actorSlot == firstHumanSlot())

    function cycleSlotMode(int actorSlot, int fighterSlot) returns boolean
        if not canCycleSlotMode(actorSlot, fighterSlot)
            return false
        var bit = 1
        for slot = 1 to fighterSlot
            bit *= 2
        if humanFighterActive(fighterSlot)
            humanFighterMask -= bit
            computerMask += bit
            characterReadiness[fighterSlot] = true
        else if computerActive(fighterSlot)
            computerMask -= bit
            characterReadiness[fighterSlot] = false
        else
            humanFighterMask += bit
            characterReadiness[fighterSlot] = false
        return true

    function hasUnassignedHuman() returns boolean
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if humanFighterActive(slot) and not humanPresent(slot)
                return true
        return false

    function setHumanMask(int mask)
        setParticipants(mask, 0)

    function setHumanCount(int count)
        if count < 1 or count > INPUT_PARTICIPANT_CAPACITY
            return
        var mask = 0
        var bit = 1
        for slot = 0 to count - 1
            mask += bit
            bit *= 2
        setHumanMask(mask)

    function copyTo(MatchState destination)
        destination.phase = phase
        destination.humanMask = humanMask
        destination.humanFighterMask = humanFighterMask
        destination.computerMask = computerMask
        destination.departedMask = departedMask
        destination.interrupted = interrupted
        destination.humanCount = humanCount
        destination.stageChoice = stageChoice
        destination.winner = winner
        destination.stockCount = stockCount
        destination.timeLimitMinutes = timeLimitMinutes
        destination.remainingFrames = remainingFrames
        destination.timedOut = timedOut
        destination.practice = practice
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            destination.characterChoices[slot] = characterChoices[slot]
            destination.characterReadiness[slot] = characterReadiness[slot]
            destination.rematchReadiness[slot] = rematchReadiness[slot]

    function characterFor(int slot) returns int
        return slot >= 0 and slot < INPUT_PARTICIPANT_CAPACITY ? characterChoices[slot] : -1

    function characterReady(int slot) returns boolean
        return fighterActive(slot) and characterReadiness[slot] and (computerActive(slot) or humanPresent(slot))

    function selectCharacter(int slot, int choice)
        if phase != CHARACTER_MENU or not humanPresent(slot) or not humanFighterActive(slot) or choice < 0 or choice > 2
            return
        characterChoices[slot] = choice
        characterReadiness[slot] = true

    function selectCpuCharacter(int actorSlot, int cpu, int choice)
        if phase != CHARACTER_MENU or not canChooseComputer(actorSlot, cpu) or choice < 0 or choice > 2
            return
        characterChoices[cpu] = choice
        characterReadiness[cpu] = true

    function practiceSelected() returns boolean
        if humanCount != 1 or humanFighterMask != humanMask
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if computerActive(slot) and characterReadiness[slot]
                return false
        return true

    function allCharactersReady() returns boolean
        if fighterMask() == 0 or hasUnassignedHuman()
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if fighterActive(slot) and not characterReadiness[slot] and not (practiceSelected() and computerActive(slot))
                return false
        return true

    function unreadyCharacter(int slot)
        if phase == CHARACTER_MENU and humanActive(slot)
            characterReadiness[slot] = false

    function recallCharacter(int actorSlot, int chipSlot)
        if phase != CHARACTER_MENU or not humanActive(actorSlot)
            return
        if (chipSlot == actorSlot and humanFighterActive(chipSlot)) or canChooseComputer(actorSlot, chipSlot)
            characterReadiness[chipSlot] = false

    function selectStage(int slot, int choice)
        if phase == STAGE_MENU and humanActive(slot) and choice >= 0 and choice <= 1
            stageChoice = choice

    function requestStageSelect(int slot) returns boolean
        if phase != CHARACTER_MENU or not humanActive(slot) or not allCharactersReady()
            return false
        phase = STAGE_MENU
        return true

    function returnToCharacters(int slot)
        if phase == STAGE_MENU and humanActive(slot)
            phase = CHARACTER_MENU

    function setStocks(int slot, int count)
        if phase == STAGE_MENU and humanActive(slot) and count >= 1 and count <= 9
            stockCount = count

    function setTimeLimit(int slot, int minutes)
        if phase == STAGE_MENU and humanActive(slot) and minutes >= 0 and minutes <= 10
            timeLimitMinutes = minutes

    function remainingSeconds() returns int
        return (remainingFrames + MATCH_TICKS_PER_SECOND - 1) div MATCH_TICKS_PER_SECOND

    function requestStart(int slot) returns boolean
        if phase != STAGE_MENU or not humanActive(slot) or not allCharactersReady()
            return false
        winner = -1
        interrupted = false
        departedMask = 0
        timedOut = false
        practice = practiceSelected()
        remainingFrames = practice ? 0 : timeLimitMinutes * 60 * MATCH_TICKS_PER_SECOND
        phase = MATCH
        return true

    function leavePractice(int slot) returns boolean
        if phase != MATCH or not practice or slot != firstHumanSlot()
            return false
        phase = CHARACTER_MENU
        practice = false
        return true

    function confirmRematch(int slot) returns boolean
        if phase != RESULT or not humanPresent(slot)
            return false
        rematchReadiness[slot] = true
        for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if humanPresent(participant) and not rematchReadiness[participant]
                return false
        for participant = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            rematchReadiness[participant] = false
        phase = CHARACTER_MENU
        return true

    function participantLeft(int slot, FighterRoster world)
        if not humanPresent(slot)
            return
        var bit = 1
        for index = 1 to slot
            bit *= 2
        departedMask += bit
        rematchReadiness[slot] = false
        if phase != MATCH
            return
        interrupted = true
        timedOut = false
        winner = -1
        var contenders = 0
        for fighterSlot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(fighterSlot) and not participantIsActive(departedMask, fighterSlot) and world.fighters[fighterSlot].stocks > 0
                contenders++
                winner = fighterSlot
        if contenders != 1
            winner = -1
        phase = RESULT

    function resolveStocks(FighterRoster world)
        if phase != MATCH or practice
            return
        resolveRemaining(world)

    private function resolveRemaining(FighterRoster world)
        var remaining = 0
        var survivor = -1
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot) and world.fighters[slot].stocks > 0
                remaining++
                survivor = slot
        if remaining > 1
            return
        winner = survivor
        phase = RESULT

    function advanceClock(FighterRoster world)
        if phase != MATCH or practice or timeLimitMinutes == 0
            return
        remainingFrames--
        if remainingFrames > 0
            return
        remainingFrames = 0
        timedOut = true
        var best = -1
        var tied = false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                let fighter = world.fighters[slot]
                if best < 0
                    best = slot
                else
                    let leader = world.fighters[best]
                    if fighter.stocks > leader.stocks or (fighter.stocks == leader.stocks and fighter.damage < leader.damage)
                        best = slot
                        tied = false
                    else if fighter.stocks == leader.stocks and fighter.damage == leader.damage
                        tied = true
        winner = tied ? -1 : best
        phase = RESULT

    function forfeit(int losingSlot, FighterRoster world)
        if world.active(losingSlot)
            world.fighters[losingSlot].stocks = 0
            world.fighters[losingSlot].out = true
            resolveRemaining(world)
            for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
                rematchReadiness[slot] = false
