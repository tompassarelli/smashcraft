package MatchRules

public constant int CHARACTER_MENU = 0
public constant int STAGE_MENU = 1
public constant int MATCH = 2
public constant int RESULT = 3
public constant int MATCH_TICKS_PER_SECOND = 60

// Mutable pacing/CPU state that affects future frame production is simulation state.
public class ReplayRuntimeState
    int simulationFrame = 0
    real botAttackDelay = 0

    function copyTo(ReplayRuntimeState destination)
        destination.simulationFrame = simulationFrame
        destination.botAttackDelay = botAttackDelay

public class MatchState
    int phase = CHARACTER_MENU
    int characterChoice = 0
    int secondCharacterChoice = 1
    int stageChoice = 0
    int winner = -1
    int humanCount = 1
    int stockCount = 3
    int timeLimitMinutes = 7
    int remainingFrames = 7 * 60 * MATCH_TICKS_PER_SECOND
    boolean timedOut = false
    boolean firstCharacterReady = false
    boolean secondCharacterReady = false
    boolean firstRematchReady = false
    boolean secondRematchReady = false

    function copyTo(MatchState destination)
        destination.phase = phase
        destination.characterChoice = characterChoice
        destination.secondCharacterChoice = secondCharacterChoice
        destination.stageChoice = stageChoice
        destination.winner = winner
        destination.humanCount = humanCount
        destination.stockCount = stockCount
        destination.timeLimitMinutes = timeLimitMinutes
        destination.remainingFrames = remainingFrames
        destination.timedOut = timedOut
        destination.firstCharacterReady = firstCharacterReady
        destination.secondCharacterReady = secondCharacterReady
        destination.firstRematchReady = firstRematchReady
        destination.secondRematchReady = secondRematchReady

    function setHumanCount(int count)
        humanCount = count == 2 ? 2 : 1
        if humanCount == 1
            secondCharacterReady = false
            secondRematchReady = false

    function characterFor(int slot) returns int
        return slot == 1 ? secondCharacterChoice : characterChoice

    function characterReady(int slot) returns boolean
        return slot == 1 ? secondCharacterReady : firstCharacterReady

    function selectCharacter(int slot, int choice)
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount or choice < 0 or choice > 1
            return
        if slot == 1
            secondCharacterChoice = choice
            secondCharacterReady = true
        else
            characterChoice = choice
            firstCharacterReady = true

    // In a solo match, P1 may choose the CPU's fighter independently. A
    // second human owns slot 1 whenever two humans are present.
    function selectCpuCharacter(int actorSlot, int choice)
        if phase != CHARACTER_MENU or humanCount != 1 or actorSlot != 0 or choice < 0 or choice > 1
            return
        secondCharacterChoice = choice

    function allCharactersReady() returns boolean
        return firstCharacterReady and (humanCount == 1 or secondCharacterReady)

    function unreadyCharacter(int slot)
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount
            return
        if slot == 1
            secondCharacterReady = false
        else
            firstCharacterReady = false

    function selectStage(int slot, int choice)
        if phase == STAGE_MENU and slot >= 0 and slot < humanCount and choice >= 0 and choice <= 1
            stageChoice = choice

    function requestStageSelect(int slot) returns boolean
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount or not allCharactersReady()
            return false
        phase = STAGE_MENU
        return true

    function returnToCharacters(int slot)
        if phase == STAGE_MENU and slot >= 0 and slot < humanCount
            phase = CHARACTER_MENU

    function setStocks(int slot, int count)
        if phase == STAGE_MENU and slot >= 0 and slot < humanCount and count >= 1 and count <= 9
            stockCount = count

    function setTimeLimit(int slot, int minutes)
        if phase == STAGE_MENU and slot >= 0 and slot < humanCount and minutes >= 0 and minutes <= 10
            timeLimitMinutes = minutes

    function remainingSeconds() returns int
        return (remainingFrames + MATCH_TICKS_PER_SECOND - 1) div MATCH_TICKS_PER_SECOND

    function requestStart(int slot) returns boolean
        if phase != STAGE_MENU or slot < 0 or slot >= humanCount or not allCharactersReady()
            return false
        winner = -1
        timedOut = false
        remainingFrames = timeLimitMinutes * 60 * MATCH_TICKS_PER_SECOND
        phase = MATCH
        return true

    function confirmRematch(int slot) returns boolean
        if phase != RESULT or slot < 0 or slot >= humanCount
            return false
        if slot == 1
            secondRematchReady = true
        else
            firstRematchReady = true
        if firstRematchReady and (humanCount == 1 or secondRematchReady)
            firstRematchReady = false
            secondRematchReady = false
            firstCharacterReady = false
            secondCharacterReady = false
            phase = CHARACTER_MENU
            return true
        return false

    function resolveStocks(int firstStocks, int secondStocks)
        if phase != MATCH or (firstStocks > 0 and secondStocks > 0)
            return
        winner = firstStocks <= 0 ? (secondStocks <= 0 ? -1 : 1) : 0
        phase = RESULT

    function advanceClock(int firstStocks, real firstDamage, int secondStocks, real secondDamage)
        if phase != MATCH or timeLimitMinutes == 0
            return
        remainingFrames--
        if remainingFrames > 0
            return
        remainingFrames = 0
        timedOut = true
        if firstStocks != secondStocks
            winner = firstStocks > secondStocks ? 0 : 1
        else if firstDamage != secondDamage
            winner = firstDamage < secondDamage ? 0 : 1
        else
            winner = -1
        phase = RESULT

    function forfeit(int losingSlot)
        if losingSlot == 0 or losingSlot == 1
            winner = 1 - losingSlot
            phase = RESULT
            firstRematchReady = false
            secondRematchReady = false
