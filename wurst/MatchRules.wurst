package MatchRules

public constant int CHARACTER_MENU = 0
public constant int MATCH = 2
public constant int RESULT = 3

public class MatchState
    int phase = CHARACTER_MENU
    int characterChoice = 0
    int secondCharacterChoice = 1
    int stageChoice = 0
    int winner = -1
    int humanCount = 1
    boolean firstCharacterReady = false
    boolean secondCharacterReady = false
    boolean firstRematchReady = false
    boolean secondRematchReady = false

    function setHumanCount(int count)
        humanCount = count == 2 ? 2 : 1
        if humanCount == 1
            secondCharacterReady = false
            secondRematchReady = false

    function characterFor(int slot) returns int
        return slot == 1 ? secondCharacterChoice : characterChoice

    function characterReady(int slot) returns boolean
        return slot == 1 ? secondCharacterReady : firstCharacterReady

    function selectCharacter(int slot, int choice)
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount or choice < 0 or choice > 1
            return
        if slot == 1
            secondCharacterChoice = choice
            secondCharacterReady = true
        else
            characterChoice = choice
            firstCharacterReady = true

    function allCharactersReady() returns boolean
        return firstCharacterReady and (humanCount == 1 or secondCharacterReady)

    function unreadyCharacter(int slot)
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount
            return
        if slot == 1
            secondCharacterReady = false
        else
            firstCharacterReady = false

    function selectStage(int slot, int choice)
        if phase == CHARACTER_MENU and slot == 0 and choice >= 0 and choice <= 1
            stageChoice = choice

    function requestStart(int slot) returns boolean
        if phase != CHARACTER_MENU or slot < 0 or slot >= humanCount or not allCharactersReady()
            return false
        winner = -1
        phase = MATCH
        return true

    function confirmRematch(int slot) returns boolean
        if phase != RESULT or slot < 0 or slot >= humanCount
            return false
        if slot == 1
            secondRematchReady = true
        else
            firstRematchReady = true
        if firstRematchReady and (humanCount == 1 or secondRematchReady)
            firstRematchReady = false
            secondRematchReady = false
            firstCharacterReady = false
            secondCharacterReady = false
            phase = CHARACTER_MENU
            return true
        return false

    function resolveStocks(int firstStocks, int secondStocks)
        if phase != MATCH or (firstStocks > 0 and secondStocks > 0)
            return
        winner = firstStocks <= 0 ? (secondStocks <= 0 ? -1 : 1) : 0
        phase = RESULT

    function forfeit(int losingSlot)
        if losingSlot == 0 or losingSlot == 1
            winner = 1 - losingSlot
            phase = RESULT
            firstRematchReady = false
            secondRematchReady = false
