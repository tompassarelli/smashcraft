package InputProtocolTests
import NetworkInput
import InputProtocol
import KeyBindings

function replaceField(string wire, int offset, int width, string replacement) returns string
    return wire.substring(0, offset) + replacement + wire.substring(offset + width, wire.length())

function rejectPacket(InputPacket packet, string wire)
    packet.decode(wire).assertFalse()
    packet.recordCount().assertEquals(0)
    packet.encode().assertEquals("")

function checkRoundtrip(InputPacket packet, InputPacket decoded, NetworkInput source, NetworkInput scratch)
    packet.assign(7, 1, 1, source, source).assertTrue()
    decoded.decode(packet.encode()).assertTrue()
    decoded.copyRecord(0, scratch).assertTrue()
    scratch.sameAs(source).assertTrue()
    decoded.encode().assertEquals(packet.encode())

@Test function inputPacketHasExactVersionedNeutralHeldAndTwoRecordEncoding()
    let first = new NetworkInput()
    let second = new NetworkInput()
    let scratch = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    checkRoundtrip(packet, decoded, first, scratch)
    packet.encode().assertEquals("I310000070000010")
    packet.encode().length().assertEquals(16)
    first.assign(32, 0, 0, 0, 0, 0, 0).assertTrue()
    checkRoundtrip(packet, decoded, first, scratch)
    packet.encode().assertEquals("I31000007000001100W")
    packet.encode().length().assertEquals(19)
    decoded.epochNumber().assertEquals(7)
    decoded.firstFrameNumber().assertEquals(1)
    decoded.recordCount().assertEquals(1)
    decoded.copyRecord(-1, scratch).assertFalse()
    decoded.copyRecord(1, scratch).assertFalse()
    packet.assign(7, 1, 2, first, second).assertTrue()
    packet.encode().assertEquals("I32000007000001100W0")
    decoded.decode(packet.encode()).assertTrue()
    decoded.copyRecord(1, scratch).assertTrue()
    scratch.sameAs(second).assertTrue()
    first.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    decoded.copyRecord(0, scratch).assertTrue()
    scratch.heldMask().assertEquals(32)
    packet.copyRecord(0, scratch).assertTrue()
    scratch.heldMask().assertEquals(32)

@Test function inputPacketCarriesEveryFieldIncludingCombinedTapReleaseAndThrowTotals()
    let input = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    let row = new NetworkInput()
    input.assign(32767, 32767, 32767, -127, 127, 255, 255).assertTrue()
    input.assignPressData(-1, -1, 1, 0, true, 1, -1, 1).assertTrue()
    input.assignThrowContributions(-127, 127).assertTrue()
    checkRoundtrip(packet, decoded, input, row)
    packet.encode().length().assertEquals(36)
    packet.assign(2147483647, INPUT_LAST_FRAME - 1, 2, input, input).assertTrue()
    packet.encode().length().assertEquals(57)
    decoded.decode(packet.encode()).assertTrue()
    decoded.copyRecord(1, row).assertTrue()
    row.sameAs(input).assertTrue()
    row.predictTo(input)
    input.actionPressed(SPECIAL).assertFalse()
    input.actionReleased(MOVE_DOWN).assertFalse()
    input.specialX().assertEquals(0)
    input.specialZ().assertEquals(0)
    input.dodgeX().assertEquals(0)
    input.dodgeZ().assertEquals(0)
    input.sdiPulse().assertFalse()
    input.sdiX().assertEquals(0)
    input.sdiZ().assertEquals(0)
    input.ledgeVerticalPressed().assertEquals(0)
    input.throwX().assertEquals(0)
    input.throwZ().assertEquals(0)
    // assign would derive +1 here, but explicitly zero accumulated throw is
    // valid after opposing taps and must survive an omitted throw group.
    input.assign(0, inputActionBit(MOVE_RIGHT), inputActionBit(MOVE_RIGHT), 0, 0, 0, 0).assertTrue()
    input.assignThrowContributions(0, 0).assertTrue()
    checkRoundtrip(packet, decoded, input, row)
    row.throwX().assertEquals(0)

@Test function inputPacketRoundtripsAnalogRangesAndDirectionCombinations()
    let input = new NetworkInput()
    let row = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    for value = -127 to 127
        input.assign(32767, 32767, 32767, value, -value, value + 127, 254 - (value + 127)).assertTrue()
        input.assignThrowContributions(-value, value).assertTrue()
        checkRoundtrip(packet, decoded, input, row)
    for x = -1 to 1
        for z = -1 to 1
            input.assign(0, 32767, 32767, 0, 0, 0, 255).assertTrue()
            input.assignPressData(x, z, z, x, x != 0 or z != 0, x, z, z).assertTrue()
            checkRoundtrip(packet, decoded, input, row)

@Test function inputPacketRejectsMalformedHeadersTruncationTrailingAndUnknownAlphabet()
    let input = new NetworkInput()
    let packet = new InputPacket()
    input.assign(32767, 32767, 32767, -127, 127, 255, 255).assertTrue()
    input.assignPressData(-1, 1, 1, -1, true, -1, 1, -1).assertTrue()
    input.assignThrowContributions(127, -127).assertTrue()
    packet.assign(0, 1, 2, input, input).assertTrue()
    let wire = packet.encode()
    for length = 0 to wire.length() - 1
        rejectPacket(packet, wire.substring(0, length))
    rejectPacket(packet, wire + "0")
    for offset = 0 to wire.length() - 1
        rejectPacket(packet, replaceField(wire, offset, 1, "!"))
    rejectPacket(packet, replaceField(wire, 0, 2, "I2"))
    rejectPacket(packet, replaceField(wire, 2, 1, "0"))
    rejectPacket(packet, replaceField(wire, 2, 1, "3"))
    rejectPacket(packet, replaceField(wire, 3, 6, "200000"))
    rejectPacket(packet, replaceField(wire, 3, 6, "______"))
    rejectPacket(packet, replaceField(wire, 9, 6, "000000"))
    rejectPacket(packet, replaceField(wire, 9, 6, "1_____"))
    packet.copyRecord(0, input).assertFalse()
    packet.decode(wire).assertTrue()

@Test function inputPacketRejectsOutOfRangeAndNoncanonicalGroups()
    let packet = new InputPacket()
    let header = "I31000000000001"
    // Zero groups must be omitted, never emitted in a longer spelling.
    rejectPacket(packet, header + "1000")
    rejectPacket(packet, header + "2000000")
    rejectPacket(packet, header + "4000")
    rejectPacket(packet, header + "8000")
    rejectPacket(packet, header + "G00")
    rejectPacket(packet, header + "W000")
    rejectPacket(packet, header + "1800")
    rejectPacket(packet, header + "2800000")
    rejectPacket(packet, header + "2000800")
    rejectPacket(packet, header + "4___")
    rejectPacket(packet, header + "8G00")
    rejectPacket(packet, header + "G__")
    rejectPacket(packet, header + "W___")
    // Metadata cannot supply special/dodge/ledge directions without their
    // corresponding pressed bits, even if a key is no longer held.
    rejectPacket(packet, header + "G01")
    rejectPacket(packet, header + "G09")
    rejectPacket(packet, header + "GBP")
    packet.decode(header + "GG00").assertFalse()

@Test function inputPacketReusedDecoderAndReorderedPacketsAreIndependent()
    let input = new NetworkInput()
    let neutral = new NetworkInput()
    let row = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    input.assign(32767, 32767, 32767, -127, 127, 255, 255).assertTrue()
    input.assignPressData(1, -1, -1, 1, true, 1, 1, -1).assertTrue()
    input.assignThrowContributions(127, -127).assertTrue()
    packet.assign(7, 20, 1, input, input).assertTrue()
    let later = packet.encode()
    packet.assign(7, 10, 2, neutral, input).assertTrue()
    let earlier = packet.encode()
    decoded.decode(later).assertTrue()
    decoded.decode(earlier).assertTrue()
    decoded.copyRecord(0, row).assertTrue()
    row.sameAs(neutral).assertTrue()
    decoded.copyRecord(1, row).assertTrue()
    row.sameAs(input).assertTrue()
    rejectPacket(decoded, earlier.substring(0, earlier.length() - 1))
    decoded.copyRecord(0, row).assertFalse()
    decoded.decode(later).assertTrue()
    decoded.copyRecord(0, row).assertTrue()
    row.sameAs(input).assertTrue()

@Test function inputPacketChecksBatchEndBeforeFrameArithmetic()
    let input = new NetworkInput()
    let packet = new InputPacket()
    packet.assign(-1, 1, 1, input, input).assertFalse()
    packet.assign(0, 0, 1, input, input).assertFalse()
    packet.assign(0, 1, 0, input, input).assertFalse()
    packet.assign(0, 1, 3, input, input).assertFalse()
    packet.assign(0, INPUT_LAST_FRAME, 2, input, input).assertFalse()
    packet.assign(2147483647, INPUT_LAST_FRAME - 1, 2, input, input).assertTrue()
    let wire = packet.encode()
    packet.decode(wire).assertTrue()
    packet.epochNumber().assertEquals(2147483647)
    packet.firstFrameNumber().assertEquals(INPUT_LAST_FRAME - 1)
    rejectPacket(packet, replaceField(wire, 9, 6, "1____-"))
    packet.assign(2147483647, INPUT_LAST_FRAME, 1, input, input).assertTrue()
    packet.decode(packet.encode()).assertTrue()
