package InputProtocolTests
import NetworkInput
import InputProtocol
import KeyBindings

function replaceField(string wire, int offset, int width, string replacement) returns string
    return wire.substring(0, offset) + replacement + wire.substring(offset + width, wire.length())

@Test function inputPacketHasExactVersionedOneAndTwoRecordEncoding()
    let first = new NetworkInput()
    let second = new NetworkInput()
    let scratch = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    first.assign(32, 32, 16, -127, 127, 0, 255).assertTrue()
    second.assign(32767, 0, 32767, 0, -1, 128, 1).assertTrue()
    packet.assign(7, 1, 1, first, second).assertTrue()
    let pressDirections = "11110111" + "127127"
    let firstWire = "00032" + "00032" + "00016" + "000" + "254" + "000" + "255" + pressDirections
    packet.encode().assertEquals("I20100000000070000000001" + firstWire)
    packet.encode().length().assertEquals(65)
    decoded.decode(packet.encode()).assertTrue()
    decoded.epochNumber().assertEquals(7)
    decoded.firstFrameNumber().assertEquals(1)
    decoded.recordCount().assertEquals(1)
    decoded.copyRecord(0, scratch).assertTrue()
    scratch.sameAs(first).assertTrue()
    decoded.copyRecord(-1, scratch).assertFalse()
    decoded.copyRecord(1, scratch).assertFalse()
    packet.assign(7, 1, 2, first, second).assertTrue()
    let secondWire = "32767" + "00000" + "32767" + "127" + "126" + "128" + "001" + pressDirections
    packet.encode().assertEquals("I20200000000070000000001" + firstWire + secondWire)
    packet.encode().length().assertEquals(106)
    decoded.decode(packet.encode()).assertTrue()
    decoded.copyRecord(1, scratch).assertTrue()
    scratch.sameAs(second).assertTrue()
    first.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    decoded.copyRecord(0, scratch).assertTrue()
    scratch.heldMask().assertEquals(32)
    packet.copyRecord(0, scratch).assertTrue()
    scratch.heldMask().assertEquals(32)

@Test function inputPacketRejectsMalformedHeaderAndSignedOverflow()
    let input = new NetworkInput()
    let packet = new InputPacket()
    packet.assign(0, 1, 1, input, input).assertTrue()
    let wire = packet.encode()
    packet.decode("").assertFalse()
    packet.decode(wire + "0").assertFalse()
    packet.decode(wire.substring(0, 50)).assertFalse()
    packet.decode(replaceField(wire, 0, 2, "I1")).assertFalse()
    packet.decode(replaceField(wire, 2, 1, "1")).assertFalse()
    packet.decode(replaceField(wire, 3, 1, "0")).assertFalse()
    packet.decode(replaceField(wire, 3, 1, "2")).assertFalse()
    packet.decode(replaceField(wire, 4, 10, "2147483648")).assertFalse()
    packet.decode(replaceField(wire, 4, 10, "9999999999")).assertFalse()
    packet.decode(replaceField(wire, 4, 10, "-000000001")).assertFalse()
    packet.decode(replaceField(wire, 14, 10, "0000000000")).assertFalse()
    packet.decode(replaceField(wire, 14, 10, "2147483647")).assertFalse()
    packet.decode(replaceField(wire, 14, 10, "000000000a")).assertFalse()
    packet.recordCount().assertEquals(0)
    packet.encode().assertEquals("")
    packet.copyRecord(0, input).assertFalse()

@Test function inputPacketRejectsUnknownActionBitsAndOutOfRangeAnalogFields()
    let input = new NetworkInput()
    let packet = new InputPacket()
    packet.assign(1, 1, 2, input, input).assertTrue()
    let wire = packet.encode()
    for offset = 0 to 2
        packet.decode(replaceField(wire, 24 + offset * 5, 5, "32768")).assertFalse()
    packet.decode(replaceField(wire, 39, 3, "255")).assertFalse()
    packet.decode(replaceField(wire, 42, 3, "255")).assertFalse()
    packet.decode(replaceField(wire, 45, 3, "256")).assertFalse()
    packet.decode(replaceField(wire, 48, 3, "256")).assertFalse()
    packet.decode(replaceField(wire, 75, 3, "a00")).assertFalse()
    packet.decode(replaceField(wire, 24, 5, "000 0")).assertFalse()
    packet.decode(replaceField(wire, 39, 3, "+00")).assertFalse()
    packet.decode(wire).assertTrue()

@Test function inputPacketCarriesPressTimeDirectionsAndClearsThemForPrediction()
    let input = new NetworkInput()
    let packet = new InputPacket()
    let decoded = new InputPacket()
    let row = new NetworkInput()
    input.assign(inputActionBit(SPECIAL) + inputActionBit(LEFT_TRIGGER) + inputActionBit(MOVE_UP),
        inputActionBit(SPECIAL) + inputActionBit(LEFT_TRIGGER) + inputActionBit(MOVE_UP),
        inputActionBit(MOVE_DOWN), -127, 127, 255, 0).assertTrue()
    input.assignPressData(-1, -1, 1, 0, true, 1, -1, 1).assertTrue()
    input.assignThrowContributions(-127, 127).assertTrue()
    packet.assign(3, 9, 1, input, input).assertTrue()
    let wire = packet.encode()
    wire.length().assertEquals(65)
    decoded.decode(wire).assertTrue()
    decoded.copyRecord(0, row).assertTrue()
    row.sameAs(input).assertTrue()
    row.specialX().assertEquals(-1)
    row.specialZ().assertEquals(-1)
    row.dodgeX().assertEquals(1)
    row.dodgeZ().assertEquals(0)
    row.sdiPulse().assertTrue()
    row.sdiX().assertEquals(1)
    row.sdiZ().assertEquals(-1)
    row.ledgeVerticalPressed().assertEquals(1)
    row.throwX().assertEquals(-127)
    row.throwZ().assertEquals(127)
    row.predictTo(input)
    input.actionPressed(SPECIAL).assertFalse()
    input.actionReleased(MOVE_DOWN).assertFalse()
    input.specialX().assertEquals(0)
    input.specialZ().assertEquals(0)
    input.dodgeX().assertEquals(0)
    input.dodgeZ().assertEquals(0)
    input.sdiPulse().assertFalse()
    input.sdiX().assertEquals(0)
    input.sdiZ().assertEquals(0)
    input.ledgeVerticalPressed().assertEquals(0)
    input.throwX().assertEquals(0)
    input.throwZ().assertEquals(0)

@Test function inputPacketRejectsNoncanonicalPressDirections()
    let input = new NetworkInput()
    let packet = new InputPacket()
    input.assign(0, 0, 0, 0, 0, 0, 0).assertTrue()
    input.assignPressData(1, 0, 0, 0, false, 0, 0, 0).assertFalse()
    input.assignPressData(0, 0, 1, 0, false, 0, 0, 0).assertFalse()
    input.assignPressData(0, 0, 0, 0, true, 0, 0, 0).assertFalse()
    input.assignPressData(0, 0, 0, 0, false, 1, 0, 0).assertFalse()
    input.assignThrowContributions(-128, 0).assertFalse()
    input.assignThrowContributions(0, 128).assertFalse()
    input.assign(inputActionBit(SPECIAL), inputActionBit(SPECIAL), 0, 0, 0, 0, 0).assertTrue()
    input.assignPressData(0, 0, 0, 0, false, 0, 0, 0).assertTrue()
    packet.assign(0, 1, 1, input, input).assertTrue()
    let wire = packet.encode()
    packet.decode(replaceField(wire, 51, 1, "9")).assertFalse()
    packet.decode(replaceField(wire, 55, 1, "2")).assertFalse()
    packet.decode(replaceField(wire, 56, 1, "a")).assertFalse()
    packet.decode(replaceField(wire, 59, 3, "255")).assertFalse()
    packet.decode(replaceField(wire, 62, 3, "a00")).assertFalse()

@Test function inputPacketChecksBatchEndBeforeFrameArithmetic()
    let input = new NetworkInput()
    let packet = new InputPacket()
    packet.assign(-1, 1, 1, input, input).assertFalse()
    packet.assign(0, 0, 1, input, input).assertFalse()
    packet.assign(0, 1, 0, input, input).assertFalse()
    packet.assign(0, 1, 3, input, input).assertFalse()
    packet.assign(0, INPUT_LAST_FRAME, 2, input, input).assertFalse()
    packet.assign(2147483647, INPUT_LAST_FRAME - 1, 2, input, input).assertTrue()
    let wire = packet.encode()
    packet.decode(wire).assertTrue()
    packet.epochNumber().assertEquals(2147483647)
    packet.firstFrameNumber().assertEquals(INPUT_LAST_FRAME - 1)
    packet.decode(replaceField(wire, 14, 10, "2147483646")).assertFalse()
    packet.assign(2147483647, INPUT_LAST_FRAME, 1, input, input).assertTrue()
    packet.decode(packet.encode()).assertTrue()
