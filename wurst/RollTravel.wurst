package RollTravel

// Factual frame observations from libmelee ef679270ff95f0d42339dcdf1608282a35023349,
// melee/framedata.csv, SHA256 8e0d811290b511902076c0011db1a0116356a7ddaa68dfa369ea4f5dcdc93777.
// Numerical data only; no LGPL library helper implementation is incorporated.
// Frames are one-based. Samples are signed travel along the chosen roll direction,
// in Melee units; facing_changed is orientation metadata, not a travel sign flip.
// Profiles: ordinary forward/back, face-up getup forward/back,
// face-down getup forward/back, tech forward/back. Small captured reversals remain.
public function forwardRollTurnFrame(int character) returns int
	// Only Fox/Archer and Falco/Rifleman adopt the observed orientation event.
	return character == 0 or character == 1 ? 20 : 0

public function rollTravelSample(int character, int profile, int frame) returns real
	if character < 0 or character > 1 or profile < 0 or profile > 7 or frame < 1
		return 0
	// The owner retains forty tech ticks; the dataset ends at thirty-nine.
	if profile >= 6 and frame == 40
		return 0
	return rollSample(character * 8 + profile, frame) * 6

