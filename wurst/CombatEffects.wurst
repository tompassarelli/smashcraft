package CombatEffects
import Wurst
import ImpactEvents
import ImpactAssetInfo
import Simulation

constant int EFFECTS_PER_KIND = 8
constant int EFFECT_KIND_COUNT = 10
constant int EFFECT_COUNT = EFFECTS_PER_KIND * EFFECT_KIND_COUNT

// All handles are created together in common initialization. Effects never
// provide input to combat, and playback creates/destroys no native handles.
public class CombatEffects
    private effect array[EFFECT_COUNT] models
    private int array[EFFECT_COUNT] ages
    private int array[EFFECT_KIND_COUNT] nextSlot
    private real array[EFFECT_COUNT] originX
    private real array[EFFECT_COUNT] originZ
    private int array[EFFECT_COUNT] drift
    private real array[EFFECT_COUNT] driftZ
    private real array[EFFECT_COUNT] pitch
    private real array[EFFECT_COUNT] strength
    private real worldX
    private real worldY
    private real worldZ
    private ImpactPresentationCursor cursor = new ImpactPresentationCursor()

    construct(real x, real y, real z)
        worldX = x
        worldY = y - 8
        worldZ = z
        for i = 0 to EFFECT_COUNT - 1
            let kind = i div EFFECTS_PER_KIND
            var path = IMPACT_ROLL_MODEL
            if kind == 0
                path = IMPACT_HIT_MODEL
            else if kind == 1
                path = IMPACT_TECH_MODEL
            else if kind == 2
                path = IMPACT_MISS_MODEL
            else if kind == 3
                path = IMPACT_DUST_MODEL
            else if kind == 5
                path = IMPACT_ELECTRIC_MODEL
            else if kind == 6
                path = IMPACT_SHIELD_MODEL
            else if kind == 7
                path = IMPACT_JUMP_MODEL
            else if kind == 8
                path = IMPACT_KO_MODEL
            else if kind == 9
                path = IMPACT_RESPAWN_MODEL
            let model = AddSpecialEffect(path, x, y)
            BlzSetSpecialEffectAlpha(model, 0)
            BlzSetSpecialEffectScale(model, 0.)
            models[i] = model
            ages[i] = -1
        for kind = 0 to EFFECT_KIND_COUNT - 1
            nextSlot[kind] = 0

    function clear()
        cursor.reset()
        for i = 0 to EFFECT_COUNT - 1
            ages[i] = -1
            BlzSetSpecialEffectAlpha(models[i], 0)
            BlzSetSpecialEffectScale(models[i], 0.)

    private function spawn(int kind, real x, real z, int direction, real size) returns int
        let slot = kind * EFFECTS_PER_KIND + nextSlot[kind]
        nextSlot[kind] = (nextSlot[kind] + 1) mod EFFECTS_PER_KIND
        ages[slot] = 0
        originX[slot] = x
        originZ[slot] = z
        drift[slot] = direction
        driftZ[slot] = 0
        pitch[slot] = 0
        strength[slot] = size
        return slot

    private function surfaceFlash(int kind, ImpactEvents events)
        let slot = spawn(kind, events.contactX, events.contactZ, R2I(events.normalX), 0.8)
        pitch[slot] = events.normalX == 0 ? 0. : 1.570796327
        driftZ[slot] = events.normalZ

    private function emit(int frame, ImpactEvents events)
        if events.hit
            spawn(events.electric ? 5 : 0, events.x, events.z + 50, 0, 1.)
        if events.shieldHit
            spawn(6, events.x, events.z + 50, 0, 1.)
        if events.shieldBreak
            spawn(6, events.x, events.z + 50, 0, 2.)
        if events.landing == IMPACT_TECH
            spawn(1, events.x, events.z + 3, 0, 1.)
        else if events.landing == IMPACT_MISSED_TECH
            spawn(2, events.x, events.z + 2, 0, 1.)
            spawn(3, events.x - 15, events.z + 3, -1, 1.)
            spawn(3, events.x + 15, events.z + 3, 1, 1.)
        if events.surface == SURFACE_TECH_WALL or events.surface == SURFACE_TECH_CEILING
            surfaceFlash(1, events)
        else if events.surfaceMissedTech
            surfaceFlash(2, events)
            surfaceFlash(3, events)
        if events.ordinaryLanding
            spawn(3, events.x - 12, events.z + 2, -1, 0.7)
            spawn(3, events.x + 12, events.z + 2, 1, 0.7)
        if events.jump == 1
            spawn(3, events.jumpOriginX - 12, events.jumpOriginZ + 2, -1, 0.7)
            spawn(3, events.jumpOriginX + 12, events.jumpOriginZ + 2, 1, 0.7)
        else if events.jump == 2 or events.jump == 3
            spawn(7, events.jumpOriginX, events.jumpOriginZ - 5, 0, 1.)
        if events.airDodge
            spawn(4, events.x, events.z + 50, 0, 0.6)
        if events.movementDust or events.dodgeTrail or (events.runningDust and frame mod 8 == 0)
            spawn(3, events.x - events.direction * 12, events.z + 2, -events.direction, 0.45)
        if events.launchTrail
            spawn(3, events.x, events.z + 45, 0, 0.6)
        if events.koDirectionX != 0 or events.koDirectionZ != 0
            let slot = spawn(8, events.x, events.z + 35, events.koDirectionX, 2.)
            driftZ[slot] = events.koDirectionZ * 2.
        if events.respawn
            spawn(9, events.x, events.z + 50, 0, 1.3)
        if events.dodge == 1
            spawn(3, events.x - 8, events.z + 2, -1, 0.65)
            spawn(3, events.x + 8, events.z + 2, 1, 0.65)
        else if events.dodge == 2
            spawn(4, events.x, events.z + 12, 0, 1.)
            spawn(3, events.x - events.direction * 15, events.z + 2, -events.direction, 0.55)

    function present(int frame, ImpactEvents first, ImpactEvents second)
        if cursor.consume(frame)
            emit(frame, first)
            emit(frame, second)

    function setPaused(boolean paused)
        for i = 0 to EFFECT_COUNT - 1
            BlzSetSpecialEffectTimeScale(models[i], paused ? 0. : 1.)

    function tick()
        for i = 0 to EFFECT_COUNT - 1
            if ages[i] >= 0
                let kind = i div EFFECTS_PER_KIND
                let lifetime = kind == 0 or kind == 5 or kind == 6 ? 9 : (kind == 1 ? 15 : (kind == 3 ? 32 : (kind == 8 ? 24 : 12)))
                let age = ages[i]
                if age >= lifetime
                    ages[i] = -1
                    BlzSetSpecialEffectAlpha(models[i], 0)
                    BlzSetSpecialEffectScale(models[i], 0.)
                else
                    let progress = age * 1. / lifetime
                    let scale = kind == 3 ? 0.75 + progress * 1.1 : (kind == 2 ? 0.7 + progress * 0.5 : 1. + progress * 0.25)
                    let fade = 1. - progress
                    BlzSetSpecialEffectAlpha(models[i], R2I((kind == 3 ? 220 * strength[i] : 255) * fade * fade))
                    BlzSetSpecialEffectScale(models[i], scale * strength[i])
                    BlzSetSpecialEffectPitch(models[i], pitch[i])
                    BlzSetSpecialEffectPosition(models[i], worldX + originX[i] + drift[i] * age * 1.3, worldY, worldZ + originZ[i] + driftZ[i] * age * 1.3 + (kind == 3 ? progress * 9 : 0))
                    ages[i]++
