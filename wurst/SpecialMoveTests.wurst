@Test function riflemanNeutralSpecialKeepsGroundAndAirStartupAndRecovery()
	let game = specialMatch()
	let groundedRifleman = new FighterState(1, -100, 1)
	let airborneRifleman = new FighterState(1, 100, -1)
	let firstTarget = new FighterState(0, 500, -1)
	let secondTarget = new FighterState(0, -500, 1)
	let groundedInput = new InputSnapshot()
	let airborneInput = new InputSnapshot()
	let firstTargetInput = new InputSnapshot()
	let secondTargetInput = new InputSnapshot()
	let groundedCommands = new AttackBuffer(0)
	let airborneCommands = new AttackBuffer(0)
	let firstTargetCommands = new AttackBuffer(0)
	let secondTargetCommands = new AttackBuffer(0)
	airborneRifleman.grounded = false
	airborneRifleman.z = 200
	groundedInput.specialPressed = true
	airborneInput.specialPressed = true
	stepMatch(game, groundedRifleman, firstTarget, groundedInput, firstTargetInput,
		groundedCommands, firstTargetCommands, 1)
	stepMatch(game, airborneRifleman, secondTarget, airborneInput, secondTargetInput,
		airborneCommands, secondTargetCommands, 1)
	groundedRifleman.specialDuration.assertEquals(attackDurationFramesForGrounding(1, true))
	airborneRifleman.specialDuration.assertEquals(attackDurationFramesForGrounding(1, false))
	projectileCount(groundedRifleman).assertEquals(0)
	projectileCount(airborneRifleman).assertEquals(0)
	groundedInput.specialPressed = false
	airborneInput.specialPressed = false
	stepMatch(game, groundedRifleman, firstTarget, groundedInput, firstTargetInput,
		groundedCommands, firstTargetCommands, 2)
	stepMatch(game, airborneRifleman, secondTarget, airborneInput, secondTargetInput,
		airborneCommands, secondTargetCommands, 2)
	projectileCount(groundedRifleman).assertEquals(1)
	projectileCount(airborneRifleman).assertEquals(1)
	destroy groundedCommands
	destroy airborneCommands
	destroy firstTargetCommands
	destroy secondTargetCommands
	destroy groundedInput
	destroy airborneInput
	destroy firstTargetInput
	destroy secondTargetInput
	destroy groundedRifleman
	destroy airborneRifleman
	destroy firstTarget
	destroy secondTarget
	destroy game

@Test function activeBearDoesNotBlockRiflemanNeutralSpecialOrShareItsCooldown()
	let game = specialMatch()
	let rifleman = new FighterState(1, -100, 1)
	let archer = new FighterState(0, 800, -1)
	let riflemanInput = new InputSnapshot()
	let archerInput = new InputSnapshot()
	let riflemanCommands = new AttackBuffer(0)
	let archerCommands = new AttackBuffer(0)
	archer.invincible = 100
	riflemanInput.specialPressed = true
	riflemanInput.direction = 1
	riflemanInput.specialX = riflemanInput.direction
	stepMatch(game, rifleman, archer, riflemanInput, archerInput,
		riflemanCommands, archerCommands, 1)
	riflemanInput.specialPressed = false
	for frame = 2 to 22
		stepMatch(game, rifleman, archer, riflemanInput, archerInput,
			riflemanCommands, archerCommands, frame)
	rifleman.specialAction.assertEquals(SPECIAL_NONE)
	rifleman.bearLife.assertGreaterThan(0)
	rifleman.specialCooldowns[SPECIAL_RIFLEMAN_BEAR].assertGreaterThan(0)
	riflemanInput.specialPressed = true
	riflemanInput.direction = 0
	riflemanInput.specialX = riflemanInput.direction
	stepMatch(game, rifleman, archer, riflemanInput, archerInput,
		riflemanCommands, archerCommands, 23)
	rifleman.specialAction.assertEquals(SPECIAL_RIFLEMAN_BLASTER)
	rifleman.bearLife.assertGreaterThan(0)
	projectileCount(rifleman).assertEquals(0)
	riflemanInput.specialPressed = false
	stepMatch(game, rifleman, archer, riflemanInput, archerInput,
		riflemanCommands, archerCommands, 24)
	projectileCount(rifleman).assertEquals(1)
	rifleman.specialCooldowns[SPECIAL_RIFLEMAN_BEAR].assertGreaterThan(0)
	destroy riflemanCommands
	destroy archerCommands
	destroy riflemanInput
	destroy archerInput
	destroy rifleman
	destroy archer
	destroy game

@Test function riflemanBearKeepsJogSpeedAndGravityAndSwipesOnItsPath()
	let game = specialMatch()
	let rifleman = new FighterState(1, -100, 1)
	let archer = new FighterState(0, -200, 1)
	let riflemanInput = new InputSnapshot()
	let archerInput = new InputSnapshot()
	let riflemanCommands = new AttackBuffer(0)
	let archerCommands = new AttackBuffer(0)
	rifleman.grounded = false
	rifleman.z = 250
	archer.grounded = false
	archer.z = 230
	riflemanInput.specialPressed = true
	riflemanInput.direction = -1
	riflemanInput.specialX = riflemanInput.direction
	stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, 1)
	rifleman.bearLife.assertGreaterThan(0)
	rifleman.bearVelocityX.assertEquals(-14.)
	let initialBearZ = rifleman.bearZ
	riflemanInput.specialPressed = false
	for frame = 2 to 7
		stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, frame)
	(rifleman.bearZ < initialBearZ).assertTrue()
	archer.damage.assertGreaterThan(0)
	destroy riflemanCommands
	destroy archerCommands
	destroy riflemanInput
	destroy archerInput
	destroy rifleman
	destroy archer
	destroy game

@Test function riflemanUpSpecialFiresThenLaunchesWithProtectionUntilNearApex()
	let game = specialMatch()
	let rifleman = new FighterState(1, 0, 1)
	let archer = new FighterState(0, 500, -1)
	let riflemanInput = new InputSnapshot()
	let archerInput = new InputSnapshot()
	let riflemanCommands = new AttackBuffer(0)
	let archerCommands = new AttackBuffer(0)
	riflemanInput.specialPressed = true
	riflemanInput.verticalDirection = 1
	riflemanInput.specialZ = riflemanInput.verticalDirection
	stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, 1)
	rifleman.grounded.assertTrue()
	for frame = 2 to RIFLEMAN_RECOVERY_STARTUP_FRAMES + 1
		riflemanInput.specialPressed = false
		stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, frame)
	rifleman.grounded.assertFalse()
	rifleman.vz.assertGreaterThan(0)
	rifleman.vx.assertEquals(0.)
	rifleman.invincible.assertGreaterThan(0)
	(projectileCount(rifleman) > 0).assertTrue()
	for frame = RIFLEMAN_RECOVERY_STARTUP_FRAMES + 2 to RIFLEMAN_RECOVERY_PROTECTION_END
		stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, frame)
	rifleman.invincible.assertGreaterThan(0)
	for frame = RIFLEMAN_RECOVERY_PROTECTION_END + 1 to RIFLEMAN_RECOVERY_PROTECTION_END + 3
		stepMatch(game, rifleman, archer, riflemanInput, archerInput, riflemanCommands, archerCommands, frame)
	rifleman.invincible.assertEquals(0)
	destroy riflemanCommands
	destroy archerCommands
	destroy riflemanInput
	destroy archerInput
	destroy rifleman
	destroy archer
	destroy game

@Test function aerialUpSpecialsConsumeJumpAndEndInHelplessFallUntilLandingOrLedge()
	for character = 0 to 1
		let game = specialMatch()
		let fighter = new FighterState(character, 0, 1)
		let target = new FighterState(1 - character, 500, -1)
		let input = new InputSnapshot()
		let targetInput = new InputSnapshot()
		let commands = new AttackBuffer(0)
		let targetCommands = new AttackBuffer(0)
		fighter.grounded = false
		fighter.z = 500
		fighter.jumps = 1
		input.specialPressed = true
		input.verticalDirection = 1
		input.specialZ = input.verticalDirection
		startFighterSpecial(fighter, 0, input).assertTrue()
		fighter.jumps.assertEquals(0)
		input.specialPressed = false
		input.verticalDirection = 0
		input.specialZ = input.verticalDirection
		for frame = 1 to 38
			fighter.cooldown = max(0, fighter.cooldown - 1)
			fighter.specialLockFrames = max(0, fighter.specialLockFrames - 1)
			advanceSpecialPair(fighter, target, 0)
		fighter.specialAction.assertEquals(SPECIAL_NONE)
		fighter.specialFall.assertTrue()
		fighter.jumps.assertEquals(0)
		canAttack(fighter).assertFalse()
		input.jumpPressed = true
		input.airDodgePressed = true
		input.dodgeX = 1
		input.direction = 1
		input.specialX = input.direction
		advance(fighter, 0, input, 0)
		fighter.specialFall.assertTrue()
		fighter.jumpSquat.assertEquals(0)
		fighter.airDodging.assertFalse()
		fighter.jumps.assertEquals(0)
		fighter.attackStyle.assertEquals(-1)
		beginAttackPair(fighter, target, AERIAL_NEUTRAL_STYLE, -1, false, false)
		fighter.attackStyle.assertEquals(-1)
		input.specialPressed = true
		input.verticalDirection = 0
		input.specialZ = input.verticalDirection
		startFighterSpecial(fighter, 0, input).assertFalse()
		input.specialPressed = false
		input.jumpPressed = false
		input.airDodgePressed = false
		input.dodgeX = 0
		input.direction = 0
		input.specialX = input.direction
		fighter.hitstun = 2
		cancelSpecialState(fighter)
		fighter.specialFall.assertFalse()
		input.jumpPressed = true
		for tick = 1 to 3
			advance(fighter, 0, input, 0)
		fighter.specialFall.assertFalse()
		fighter.jumps.assertEquals(0)
		canAttack(fighter).assertTrue()

		let landing = new FighterState(character, 0, 1)
		let landingInput = new InputSnapshot()
		landing.grounded = false
		landing.z = 1
		landing.vz = -2
		landing.jumps = 0
		landing.specialFall = true
		for tick = 1 to 5
			advance(landing, 0, landingInput, 0)
		landing.grounded.assertTrue()
		landing.specialFall.assertFalse()
		landing.jumps.assertEquals(2)

		let ledge = new FighterState(character, 620, -1)
		let ledgeInput = new InputSnapshot()
		let otherInput = new InputSnapshot()
		let other = new FighterState(1 - character, 0, 1)
		ledge.grounded = false
		ledge.z = -30
		ledge.vz = -2
		ledge.specialFall = true
		ledge.jumps = 0
		resolveLedgePair(ledge, other, 0, ledgeInput, otherInput)
		ledge.ledgeState.assertEquals(LEDGE_HANG)
		ledge.specialFall.assertFalse()

		landing.specialFall = true
		reset(landing, 0)
		landing.specialFall.assertFalse()
		destroy other
		destroy otherInput
		destroy ledgeInput
		destroy ledge
		destroy landingInput
		destroy landing
		destroy commands
		destroy targetCommands
		destroy input
		destroy targetInput
		destroy fighter
		destroy target
		destroy game

@Test function specialFallStateSurvivesReplaySnapshotRoundTrip()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	let game = new MatchState()
	let firstCommands = new AttackBuffer(0)
	let secondCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let before = new ReplaySnapshot()
	let after = new ReplaySnapshot()
	let replayFirst = new FighterState(0, 0, 1)
	let replaySecond = new FighterState(1, 0, -1)
	first.specialFall = true
	before.capture(first, second, game, firstCommands, secondCommands, runtime)
	first.specialFall = false
	before.restore(replayFirst, replaySecond, game, firstCommands, secondCommands, runtime)
	replayFirst.specialFall.assertTrue()
	after.capture(replayFirst, replaySecond, game, firstCommands, secondCommands, runtime)
	before.firstDifference(after).assertEquals("")
	destroy replayFirst
	destroy replaySecond
	destroy before
	destroy after
	destroy runtime
	destroy firstCommands
	destroy secondCommands
	destroy first
	destroy second
	destroy game

@Test function bearRunsWithoutSwipingUntilATargetEntersItsPath()
	let owner = new FighterState(1, -100, 1)
	let target = new FighterState(0, 500, -1)
	owner.bearLife = 80
	owner.bearX = -100
	owner.bearZ = 0
	owner.bearVelocityX = 14
	owner.bearSurface = 0
	for frame = 1 to 10
		advanceSpecialPair(owner, target, 0)
	owner.bearHitSerial.assertEquals(0)
	owner.bearSwipeCooldown.assertEquals(0)
	target.damage.assertEquals(0.)
	target.x = owner.bearX + 40
	advanceSpecialPair(owner, target, 0)
	owner.bearHitSerial.assertEquals(1)
	target.damage.assertGreaterThan(0.)
	advanceSpecialPair(owner, target, 0)
	owner.bearHitSerial.assertEquals(1)
	destroy target
	destroy owner

@Test function projectileAndSummonStateSurviveReplayCopyAndComparison()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	let game = specialMatch()
	let firstCommands = new AttackBuffer(0)
	let secondCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let snapshot = new ReplaySnapshot()
	first.specialAction = SPECIAL_ARCHER_DISENGAGE
	first.specialFrame = 11
	first.specialDuration = ARCHER_DISENGAGE_FRAMES
	first.specialCooldowns[SPECIAL_ARCHER_DISENGAGE] = 42
	first.hippogryphKind = 1
	first.hippogryphLife = 5
	first.hippogryphX = 78.5
	first.hippogryphVelocityX = 32
	first.bearLife = 9
	first.bearX = -67
	first.bearVelocityZ = -2.5
	first.bearSurface = 2
	first.projectileLife[4] = 12
	first.projectileKind[4] = PROJECTILE_FAN_ARROW
	first.projectileVelocityX[4] = 31
	first.projectileVelocityZ[4] = -10
	snapshot.capture(first, second, game, firstCommands, secondCommands, runtime)
	first.specialAction = SPECIAL_NONE
	first.bearLife = 0
	first.hippogryphLife = 0
	first.projectileLife[4] = 0
	snapshot.restore(first, second, game, firstCommands, secondCommands, runtime)
	first.specialAction.assertEquals(SPECIAL_ARCHER_DISENGAGE)
	first.specialFrame.assertEquals(11)
	first.specialDuration.assertEquals(ARCHER_DISENGAGE_FRAMES)
	first.specialCooldowns[SPECIAL_ARCHER_DISENGAGE].assertEquals(42)
	first.hippogryphLife.assertEquals(5)
	first.hippogryphX.assertEquals(78.5)
	first.bearLife.assertEquals(9)
	first.bearVelocityZ.assertEquals(-2.5)
	first.bearSurface.assertEquals(2)
	first.projectileLife[4].assertEquals(12)
	first.projectileKind[4].assertEquals(PROJECTILE_FAN_ARROW)
	first.projectileVelocityX[4].assertEquals(31.)
	first.projectileVelocityZ[4].assertEquals(-10.)
	let actual = new ReplaySnapshot()
	actual.capture(first, second, game, firstCommands, secondCommands, runtime)
	snapshot.firstDifference(actual).assertEquals("")
	first.hippogryphVelocityX = 0.25
	actual.capture(first, second, game, firstCommands, secondCommands, runtime)
	snapshot.firstDifference(actual).assertEquals("first.hippogryphVelocityX")
	destroy actual
	destroy snapshot
	destroy runtime
	destroy firstCommands
	destroy secondCommands
	destroy first
	destroy second
	destroy game

@Test function summonedEntitiesSurviveActionInterruptionButNotStockReset()
	let owner = new FighterState(1, -100, 1)
	owner.specialAction = SPECIAL_RIFLEMAN_BEAR
	owner.bearLife = 30
	owner.bearSwipeCooldown = 8
	owner.hippogryphKind = 1
	owner.hippogryphLife = 12
	owner.specialHit = true
	cancelSpecialState(owner)
	owner.specialAction.assertEquals(SPECIAL_NONE)
	owner.bearLife.assertEquals(30)
	owner.bearSwipeCooldown.assertEquals(8)
	owner.hippogryphLife.assertEquals(12)
	owner.specialHit.assertTrue()
	owner.hippogryphKind = 2
	cancelSpecialState(owner)
	owner.hippogryphLife.assertEquals(0)
	reset(owner, -240)
	owner.bearLife.assertEquals(0)
	owner.specialHit.assertFalse()
	destroy owner

@Test function arrowTravelDirectionDoesNotFollowTheShootersLaterFacing()
	let owner = new FighterState(0, -100, -1)
	let target = new FighterState(1, 20, -1)
	owner.projectileLife[0] = 10
	owner.projectileKind[0] = PROJECTILE_ARROW
	owner.projectileDirection[0] = 1
	owner.projectileX[0] = 0
	owner.projectileZ[0] = 45
	owner.projectileVelocityX[0] = 30
	updateProjectilePair(owner, target)
	target.damage.assertGreaterThan(0.)
	owner.projectileX[0].assertEquals(30.)
	target.knockbackX.assertEquals(0.)
	destroy target
	destroy owner

@Test function bothArcherArrowKindsPreserveReactionMovementAndActionState()
	for kind = PROJECTILE_ARROW to PROJECTILE_FAN_ARROW
		let owner = new FighterState(0, -100, 1)
		let target = new FighterState(1, 20, -1)
		owner.projectileLife[0] = 10
		owner.projectileKind[0] = kind
		owner.projectileDirection[0] = 1
		owner.projectileX[0] = 0
		owner.projectileZ[0] = 45
		owner.projectileVelocityX[0] = 30
		target.grounded = false
		target.vx = 3
		target.vz = -4
		target.knockbackX = 5
		target.knockbackZ = 6
		target.hitstun = 8
		target.hitlag = 2
		target.downState = DOWN_TUMBLE
		target.downFrame = 3
		target.frozenFrames = 20
		updateProjectilePair(owner, target)
		target.damage.assertEquals(kind == PROJECTILE_ARROW ? 7. : 4.)
		target.grounded.assertFalse()
		target.vx.assertEquals(3.)
		target.vz.assertEquals(-4.)
		target.knockbackX.assertEquals(5.)
		target.knockbackZ.assertEquals(6.)
		target.hitstun.assertEquals(8)
		target.hitlag.assertEquals(2)
		target.downState.assertEquals(DOWN_TUMBLE)
		target.downFrame.assertEquals(3)
		target.frozenFrames.assertEquals(0)
		owner.projectileLife[0].assertEquals(0)
		destroy owner
		destroy target

@Test function arrowsDamageShieldWithoutAddingShieldstunOrHitlag()
	for kind = PROJECTILE_ARROW to PROJECTILE_FAN_ARROW
		let owner = new FighterState(0, -100, 1)
		let target = new FighterState(1, 20, -1)
		owner.projectileLife[0] = 10
		owner.projectileKind[0] = kind
		owner.projectileDirection[0] = 1
		owner.projectileX[0] = 0
		owner.projectileZ[0] = 45
		owner.projectileVelocityX[0] = 30
		target.shield = true
		updateProjectilePair(owner, target)
		target.shield.assertTrue()
		target.shieldEnergy.assertLessThan(SHIELD_MAX)
		target.damage.assertEquals(0.)
		target.shieldStun.assertEquals(0)
		target.hitlag.assertEquals(0)
		destroy owner
		destroy target
