package SpecialMoveTests
import Simulation
import MatchRules
import CommandBuffer
import MatchStep
import ReplayState
import DamagePose

function specialMatch() returns MatchState
	let game = new MatchState()
	game.phase = MATCH
	return game

@Test function riflemanNeutralShotFreezesThenFlinchesItsVictimOnly()
	let game = specialMatch()
	let rifleman = new FighterState(1, 0, 1)
	let target = new FighterState(0, 140, -1)
	let input = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let commands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	input.specialPressed = true
	targetCommands.enqueue(4, -1, 1, false)
	var frame = 1
	while target.damage == 0 and frame <= 8
		stepMatch(game, rifleman, target, input, targetInput, commands, targetCommands, frame)
		input.specialPressed = false
		frame++
	target.damage.assertEquals(3.)
	target.attackStyle.assertEquals(-1)
	target.hitlag.assertEquals(4)
	target.hitstun.assertEquals(11)
	damagePose(target).assertEquals(DAMAGE_POSE_GROUND)
	rifleman.hitlag.assertEquals(0)
	targetInput.jumpPressed = true
	targetInput.jumpHeld = true
	for tick = 1 to 3
		advance(target, 0, targetInput, 0)
		target.hitstun.assertEquals(11)
		target.jumpSquat.assertEquals(0)
	for tick = 1 to 10
		advance(target, 0, targetInput, 0)
		target.jumpSquat.assertEquals(0)
	advance(target, 0, targetInput, 0)
	target.hitstun.assertEquals(0)
	target.jumpSquat.assertGreaterThan(0)
	destroy commands
	destroy targetCommands
	destroy input
	destroy targetInput
	destroy rifleman
	destroy target
	destroy game

@Test function movingArcherArrowDealsDamageWithoutInterruptingTargetAttack()
	let game = specialMatch()
	let archer = new FighterState(0, 0, 1)
	let target = new FighterState(1, 140, -1)
	let input = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let commands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	archer.vx = characterSpeed(0)
	input.specialPressed = true
	startFighterSpecial(archer, 0, input).assertTrue()
	input.specialPressed = false
	input.direction = 1
	input.specialX = input.direction
	targetCommands.enqueue(4, -1, 1, false)
	for frame = 1 to 4
		stepMatch(game, archer, target, input, targetInput, commands, targetCommands, frame)
	target.damage.assertEquals(7.)
	target.hitstun.assertEquals(0)
	target.hitlag.assertEquals(0)
	target.attackStyle.assertEquals(4)
	target.attackFrame.assertEquals(3)
	target.knockbackX.assertEquals(0.)
	target.knockbackZ.assertEquals(0.)
	projectileCount(archer).assertEquals(0)
	destroy commands
	destroy targetCommands
	destroy input
	destroy targetInput
	destroy archer
	destroy target
	destroy game

@Test function archerNeutralArrowIsImmediateAndDoesNotBlockJump()
	let game = specialMatch()
	let archer = new FighterState(0, -100, 1)
	let rifleman = new FighterState(1, 500, -1)
	let archerInput = new InputSnapshot()
	let riflemanInput = new InputSnapshot()
	let archerCommands = new AttackBuffer(0)
	let riflemanCommands = new AttackBuffer(0)
	archerInput.specialPressed = true
	stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, 1)
	projectileCount(archer).assertEquals(0)
	archer.cooldown.assertEquals(0)
	archerInput.specialPressed = false
	archerInput.jumpPressed = true
	archerInput.jumpHeld = true
	stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, 2)
	archer.jumpSquat.assertGreaterThan(0)
	projectileCount(archer).assertEquals(1)
	projectileKindAt(archer, 0).assertEquals(PROJECTILE_ARROW)
	projectileVelocityXAt(archer, 0).assertEquals(BLASTER_PROJECTILE_SPEED)
	destroy archerCommands
	destroy riflemanCommands
	destroy archerInput
	destroy riflemanInput
	destroy archer
	destroy rifleman
	destroy game

@Test function turnaroundNeutralShotsUseReleasedAirTapWithoutChangingMomentumOrAerialFacing()
	for character = 0 to 1
		for facingIndex = 0 to 1
			let facing = facingIndex == 0 ? -1 : 1
			let game = specialMatch()
			let shooter = new FighterState(character, 0, facing)
			let target = new FighterState(1 - character, 800, -facing)
			let input = new InputSnapshot()
			let targetInput = new InputSnapshot()
			let commands = new AttackBuffer(0)
			let targetCommands = new AttackBuffer(0)
			shooter.grounded = false
			shooter.z = 400
			shooter.vx = facing * 15.
			input.direction = -facing
			input.specialX = input.direction
			stepMatch(game, shooter, target, input, targetInput, commands, targetCommands, 1)
			shooter.facing.assertEquals(facing)
			shooter.lastAerialTapDirection.assertEquals(-facing)
			input.direction = 0
			input.specialX = input.direction
			stepMatch(game, shooter, target, input, targetInput, commands, targetCommands, 2)
			shooter.facing.assertEquals(facing)
			(shooter.vx * facing > 0).assertTrue()
			input.specialPressed = true
			stepMatch(game, shooter, target, input, targetInput, commands, targetCommands, 3)
			shooter.facing.assertEquals(-facing)
			(shooter.vx * facing > 0).assertTrue()
			shooter.specialAction.assertEquals(character == 0 ? SPECIAL_ARCHER_ARROW : SPECIAL_RIFLEMAN_BLASTER)
			input.specialPressed = false
			stepMatch(game, shooter, target, input, targetInput, commands, targetCommands, 4)
			projectileCount(shooter).assertEquals(1)
			projectileDirectionAt(shooter, 0).assertEquals(-facing)
			destroy commands
			destroy targetCommands
			destroy input
			destroy targetInput
			destroy shooter
			destroy target
			destroy game

@Test function heldAirTapDirectionStillSelectsSideSpecial()
	for character = 0 to 1
		let game = specialMatch()
		let fighter = new FighterState(character, 0, 1)
		let target = new FighterState(1 - character, 800, -1)
		let input = new InputSnapshot()
		let targetInput = new InputSnapshot()
		let commands = new AttackBuffer(0)
		let targetCommands = new AttackBuffer(0)
		fighter.grounded = false
		fighter.z = 300
		input.specialPressed = true
		input.direction = -1
		input.specialX = input.direction
		stepMatch(game, fighter, target, input, targetInput, commands, targetCommands, 1)
		fighter.specialAction.assertEquals(character == 0 ? SPECIAL_ARCHER_MULTISHOT : SPECIAL_RIFLEMAN_BEAR)
		destroy commands
		destroy targetCommands
		destroy input
		destroy targetInput
		destroy fighter
		destroy target
		destroy game

@Test function oppositeAirTapStillFacesBackAirAndClearsOnLandingAndReset()
	let fighter = new FighterState(1, 0, 1)
	let target = new FighterState(0, 200, -1)
	let input = new InputSnapshot()
	let targetInput = new InputSnapshot()
	let game = specialMatch()
	let commands = new AttackBuffer(0)
	let targetCommands = new AttackBuffer(0)
	fighter.grounded = false
	fighter.z = 300
	fighter.vx = 8
	input.direction = -1
	input.specialX = input.direction
	stepMatch(game, fighter, target, input, targetInput, commands, targetCommands, 1)
	fighter.facing.assertEquals(1)
	fighter.lastAerialTapDirection.assertEquals(-1)
	beginAttackPair(fighter, target, AERIAL_BACK_STYLE, -1, false, false)
	fighter.attackStyle.assertEquals(AERIAL_BACK_STYLE)
	fighter.facing.assertEquals(1)
	fighter.attackStyle = -1
	fighter.attackFrame = 0
	fighter.attackDuration = 0
	fighter.attackHit = false
	fighter.cooldown = 0
	input.direction = 0
	input.specialX = input.direction
	fighter.z = 1
	fighter.vz = -2
	advance(fighter, 0, input, 0)
	fighter.lastAerialTapDirection.assertEquals(0)
	fighter.grounded.assertTrue()
	fighter.lastAerialTapDirection = -1
	reset(fighter, 0)
	fighter.lastAerialTapDirection.assertEquals(0)
	destroy commands
	destroy targetCommands
	destroy input
	destroy targetInput
	destroy fighter
	destroy target
	destroy game

@Test function aerialTapDirectionSurvivesReplaySnapshotRoundTrip()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	let game = new MatchState()
	let firstCommands = new AttackBuffer(0)
	let secondCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let before = new ReplaySnapshot()
	let after = new ReplaySnapshot()
	let replayFirst = new FighterState(0, 0, 1)
	let replaySecond = new FighterState(1, 0, -1)
	first.lastAerialTapDirection = -1
	before.capture(first, second, game, firstCommands, secondCommands, runtime)
	first.lastAerialTapDirection = 1
	before.restore(replayFirst, replaySecond, game, firstCommands, secondCommands, runtime)
	replayFirst.lastAerialTapDirection.assertEquals(-1)
	after.capture(replayFirst, replaySecond, game, firstCommands, secondCommands, runtime)
	before.firstDifference(after).assertEquals("")
	destroy replayFirst
	destroy replaySecond
	destroy before
	destroy after
	destroy runtime
	destroy firstCommands
	destroy secondCommands
	destroy first
	destroy second
	destroy game

@Test function archerSideSpecialWaitsThenFiresThreeAngledArrows()
	let game = specialMatch()
	let archer = new FighterState(0, -100, 1)
	let rifleman = new FighterState(1, 500, -1)
	let archerInput = new InputSnapshot()
	let riflemanInput = new InputSnapshot()
	let archerCommands = new AttackBuffer(0)
	let riflemanCommands = new AttackBuffer(0)
	archerInput.specialPressed = true
	archerInput.direction = 1
	archerInput.specialX = archerInput.direction
	stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, 1)
	archer.specialAction.assertEquals(SPECIAL_ARCHER_MULTISHOT)
	projectileCount(archer).assertEquals(0)
	archerInput.specialPressed = false
	for frame = 2 to ARCHER_MULTISHOT_WINDUP_FRAMES
		stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, frame)
	projectileCount(archer).assertEquals(3)
	projectileVelocityZAt(archer, 0).assertEquals(10.)
	projectileVelocityZAt(archer, 1).assertEquals(0.)
	projectileVelocityZAt(archer, 2).assertEquals(-10.)
	destroy archerCommands
	destroy riflemanCommands
	destroy archerInput
	destroy riflemanInput
	destroy archer
	destroy rifleman
	destroy game

@Test function archerDownSpecialRetreatsAndHippogryphRushCanHit()
	let game = specialMatch()
	let archer = new FighterState(0, 0, 1)
	let rifleman = new FighterState(1, 210, -1)
	let archerInput = new InputSnapshot()
	let riflemanInput = new InputSnapshot()
	let archerCommands = new AttackBuffer(0)
	let riflemanCommands = new AttackBuffer(0)
	archerInput.specialPressed = true
	archerInput.verticalDirection = -1
	archerInput.specialZ = archerInput.verticalDirection
	stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, 1)
	archer.specialAction.assertEquals(SPECIAL_ARCHER_DISENGAGE)
	archer.vx.assertLessThan(0)
	archer.vz.assertGreaterThan(0)
	archer.hippogryphKind.assertEquals(1)
	archerInput.specialPressed = false
	for frame = 2 to 12
		stepMatch(game, archer, rifleman, archerInput, riflemanInput, archerCommands, riflemanCommands, frame)
	rifleman.damage.assertGreaterThan(0)
	destroy archerCommands
	destroy riflemanCommands
	destroy archerInput
	destroy riflemanInput
	destroy archer
	destroy rifleman
	destroy game

