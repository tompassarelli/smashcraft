package AnalogShieldTests
import Simulation
import InputAdapter
import NetworkInput
import KeyBindings
import CommandBuffer
import MatchStep
import ReplayState
import MatchRules

@Test function pressureThresholdAndDigitalClickRemainIndependent()
	let row = new NetworkInput()
	let fighter = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	let copy = new InputSnapshot()
	let commands = new AttackBuffer(0)
	for pressure = 0 to 77
		row.assign(0, 0, 0, 0, 0, pressure, 0).assertTrue()
		adaptInput(row, fighter, pressure, input, commands)
		input.shield.assertEquals(pressure == 77)
	row.assign(0, 0, 0, 0, 0, 77, 128).assertTrue()
	adaptInput(row, fighter, 78, input, commands)
	input.shieldStrength.assertEquals(0.28851544857025146)
	input.copyTo(copy)
	copy.shieldStrength.assertEquals(input.shieldStrength)
	row.assign(inputActionBit(LEFT_TRIGGER), 0, 0, 0, 0, 0, 128).assertTrue()
	adaptInput(row, fighter, 79, input, commands)
	input.shieldStrength.assertEquals(1.)
	destroy commands
	destroy copy
	destroy input
	destroy fighter
	destroy row

@Test function lightShieldEntersDrainsChangesPressureAndKeepsMinimumHold()
	let f = new FighterState(0, 0, 1)
	let input = new InputSnapshot()
	input.shield = true
	input.shieldStrength = analogShieldStrength(128)
	advance(f, 0, input, 0)
	f.shield.assertTrue()
	f.shieldEnergy.assertEquals(60.)
	f.shieldStrength.assertEquals(input.shieldStrength)
	advance(f, 0, input, 0)
	f.shieldEnergy.assertEquals(59.90925598144531)
	input.shieldStrength = analogShieldStrength(77)
	advance(f, 0, input, 0)
	f.shieldStrength.assertEquals(input.shieldStrength)
	input.shield = false
	let heldStrength = f.shieldStrength
	while f.shieldHeldFrames < SHIELD_MIN_HOLD_FRAMES
		advance(f, 0, input, 0)
		f.shield.assertTrue()
		f.shieldStrength.assertEquals(heldStrength)
	advance(f, 0, input, 0)
	f.shield.assertFalse()
	f.shieldReleaseLag.assertEquals(SHIELD_RELEASE_LAG_FRAMES)
	reset(f, 0)
	f.shieldStrength.assertEquals(1.)
	destroy input
	destroy f

@Test function lightShieldContactUsesStrengthAndFreezesItThroughStun()
	let owner = new FighterState(0, -100, 1)
	let target = new FighterState(1, 0, -1)
	let input = new InputSnapshot()
	target.shield = true
	target.shieldStrength = analogShieldStrength(128)
	beginDamageContacts()
	queueDamageContact(owner, target, hitEffect(10, 100, 20, 1, 1, false), 1, CONTACT_LAUNCH, true, null)
	finishDamageContacts(owner, target)
	target.damage.assertEquals(0.)
	target.shieldEnergy.assertEquals(51.577030181884766)
	target.shieldStun.assertEquals(13)
	target.shieldPushbackX.assertEquals(1.612437129020691 * WORLD_UNITS_PER_MELEE_UNIT)
	let strength = target.shieldStrength
	let health = target.shieldEnergy
	input.shield = true
	input.shieldStrength = 1
	while target.hitlag > 1 or target.shieldStun > 0
		advance(target, 0, input, 0)
		target.shieldStrength.assertEquals(strength)
		target.shieldEnergy.assertEquals(health)
	destroy input
	destroy target
	destroy owner

@Test function rollbackRestoresShieldStrengthAndInputRowsDistinguishIt()
	let first = new FighterState(0, 0, 1)
	let second = new FighterState(1, 100, -1)
	let game = new MatchState()
	let commands = new AttackBuffer(0)
	let otherCommands = new AttackBuffer(0)
	let runtime = new ReplayRuntimeState()
	let snapshot = new ReplaySnapshot()
	let actual = new ReplaySnapshot()
	first.shieldStrength = analogShieldStrength(128)
	snapshot.capture(first, second, game, commands, otherCommands, runtime)
	first.shieldStrength = 1
	actual.capture(first, second, game, commands, otherCommands, runtime)
	snapshot.firstDifference(actual).assertEquals("first.shieldStrength")
	snapshot.restore(first, second, game, commands, otherCommands, runtime)
	first.shieldStrength.assertEquals(0.28851544857025146)
	let input = new InputSnapshot()
	let otherInput = new InputSnapshot()
	let before = new MatchFrameInput()
	let after = new MatchFrameInput()
	input.shield = true
	input.shieldStrength = first.shieldStrength
	before.capture(1, input, otherInput, commands, otherCommands, runtime).assertTrue()
	input.shieldStrength = 1
	after.capture(1, input, otherInput, commands, otherCommands, runtime).assertTrue()
	before.sameAs(after).assertFalse()
	destroy after
	destroy before
	destroy otherInput
	destroy input
	destroy actual
	destroy snapshot
	destroy runtime
	destroy otherCommands
	destroy commands
	destroy game
	destroy second
	destroy first
