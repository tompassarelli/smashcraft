package CombatInput
import Simulation

public constant int NO_GROUND_DODGE = 2

public function attackStyleForGrounding(int style, boolean grounded, int facing, int direction) returns int
    if grounded or style < 0 or style == 1
        return style
    if style == 5
        return -1
    if style == 0
        return AERIAL_NEUTRAL_STYLE
    if style == 2 or style == 7 or style == 9
        return AERIAL_UP_STYLE
    if style == 3 or style == 8 or style == 10
        return AERIAL_DOWN_STYLE
    if style == 4 or style == 6
        return direction != 0 and direction != facing ? AERIAL_BACK_STYLE : AERIAL_FORWARD_STYLE
    return -1

public function groundDodgeIntent(boolean shielding, boolean leftPressed, boolean rightPressed, boolean downPressed) returns int
    if not shielding
        return NO_GROUND_DODGE
    if downPressed
        return 0
    if leftPressed == rightPressed
        return NO_GROUND_DODGE
    return leftPressed ? -1 : 1

public function normalAttackStyle(int horizontal, int vertical, boolean walking, boolean shieldGrab) returns int
    if shieldGrab
        return 5
    if walking and horizontal != 0
        if vertical > 0
            return 9
        if vertical < 0
            return 10
        return 6
    if vertical > 0
        return walking ? 7 : 2
    if vertical < 0
        return walking ? 8 : 3
    if horizontal != 0
        return walking ? 6 : 4
    return 0
