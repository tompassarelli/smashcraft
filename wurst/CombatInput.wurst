package CombatInput

public constant int NO_GROUND_DODGE = 2

public function groundDodgeIntent(boolean shielding, boolean leftPressed, boolean rightPressed, boolean downPressed) returns int
    if not shielding
        return NO_GROUND_DODGE
    if downPressed
        return 0
    if leftPressed == rightPressed
        return NO_GROUND_DODGE
    return leftPressed ? -1 : 1

public function normalAttackStyle(int horizontal, int vertical, boolean walking) returns int
    if walking and horizontal != 0
        if vertical > 0
            return 9
        if vertical < 0
            return 10
        return 6
    if vertical > 0
        return walking ? 7 : 2
    if vertical < 0
        return walking ? 8 : 3
    if horizontal != 0
        return walking ? 6 : 4
    return 0
