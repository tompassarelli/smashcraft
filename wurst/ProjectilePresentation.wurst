package ProjectilePresentation
import Wurst
import Abilities
import Simulation
import ProjectilePose

// Construct/destroy only in the synchronized match lifecycle. Local projection
// never allocates handles. Native emitted particles are not replay state.
public class ProjectilePresentation
    private effect array[PROJECTILE_CAPACITY] models
    private boolean array[PROJECTILE_CAPACITY] visible
    private real originX
    private real originY
    private real originZ
    private real scale

    construct(int character, real x, real y, real z)
        originX = x
        originY = y
        originZ = z
        scale = character == 1 ? 0.65 : 1.
        let path = character == 2 ? Abilities.manaFlareMissile : (character == 0 ? Abilities.arrowMissile1 : Abilities.gyroCopterMissile)
        for index = 0 to PROJECTILE_CAPACITY - 1
            models[index] = AddSpecialEffect(path, x, y)
            BlzSetSpecialEffectPosition(models[index], x, y, z)
        clear()

    private function hide(effect model)
        BlzSetSpecialEffectAlpha(model, 0)
        BlzSetSpecialEffectScale(model, 0.)
        BlzSetSpecialEffectTimeScale(model, 0.)

    function clear()
        for index = 0 to PROJECTILE_CAPACITY - 1
            visible[index] = false
            hide(models[index])

    function present(FighterState fighter, boolean playing, boolean paused)
        for index = 0 to PROJECTILE_CAPACITY - 1
            let pose = projectedProjectile(fighter, index, playing)
            let model = models[index]
            visible[index] = pose.visible
            if pose.visible
                BlzSetSpecialEffectYaw(model, pose.yaw)
                BlzSetSpecialEffectPitch(model, pose.pitch)
                BlzSetSpecialEffectPosition(model, originX + pose.x, originY, originZ + pose.z)
                BlzSetSpecialEffectScale(model, scale)
                BlzSetSpecialEffectAlpha(model, 255)
                BlzSetSpecialEffectTimeScale(model, paused ? 0. : 1.)
            else
                hide(model)

    function setPaused(boolean paused)
        for index = 0 to PROJECTILE_CAPACITY - 1
            BlzSetSpecialEffectTimeScale(models[index], paused or not visible[index] ? 0. : 1.)

    ondestroy
        clear()
        for index = 0 to PROJECTILE_CAPACITY - 1
            DestroyEffect(models[index])
            models[index] = null
