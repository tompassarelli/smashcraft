package FighterPoolPresentation
import Wurst
import Simulation
import FighterPose
import FighterOriginalClipInfo

// Allocation and destruction belong to synchronized character/match lifecycle.
// present changes only already-created visual handles, never simulation state.
public class FighterPoolPresentation
    private effect array[ORIGINAL_CLIP_CAPACITY] clips
    private int character
    private int count = 0
    private int visible = -1
    private effect light = null
    private boolean lightVisible = false
    private real originX
    private real originY
    private real originZ
    int missingSelections = 0

    construct(int character, int participant, real x, real y, real z)
        this.character = character
        originX = x
        originY = y
        originZ = z
        count = originalClipCount(character)
        let lightPath = originalLightPath(character)
        if lightPath != ""
            light = AddSpecialEffect(lightPath, x, y)
            BlzSetSpecialEffectPosition(light, x, y, z)
            BlzSetSpecialEffectScale(light, characterModelScale(character))
            BlzSetSpecialEffectAnimationBlendTime(light, 0.)
            BlzSetSpecialEffectTimeScale(light, 0.)
            BlzSetSpecialEffectAnimation(light, ORIGINAL_LIGHT_INACTIVE_ANIMATION)
            BlzSetSpecialEffectTime(light, ORIGINAL_LIGHT_GATE_SECONDS)
        for index = 0 to count - 1
            let clip = originalClip(character, index)
            let model = AddSpecialEffect(clip.modelPath, x, y)
            clips[index] = model
            BlzSetSpecialEffectPosition(model, x, y, z)
            BlzSetSpecialEffectScale(model, characterModelScale(character))
            BlzSetSpecialEffectColorByPlayer(model, Player(participant))
            BlzSetSpecialEffectAnimationBlendTime(model, 0.)
            BlzSetSpecialEffectAnimation(model, "Stand")
            BlzSetSpecialEffectTimeScale(model, 0.)
            BlzSetSpecialEffectAlpha(model, 0)

    function admitted() returns boolean
        return count > 0

    function hide()
        if visible >= 0
            BlzSetSpecialEffectAlpha(clips[visible], 0)
            visible = -1
        if light != null and lightVisible
            BlzSetSpecialEffectAnimation(light, ORIGINAL_LIGHT_INACTIVE_ANIMATION)
            BlzSetSpecialEffectTime(light, ORIGINAL_LIGHT_GATE_SECONDS)
            lightVisible = false

    function present(FighterState fighter, FighterPose pose)
        if count == 0
            return
        let index = pose.clipIndex >= 0 ? pose.clipIndex : originalClipNamed(character, pose.clipName)
        if fighter.out or index < 0 or index >= count
            if not fighter.out
                missingSelections++
            hide()
            return
        if visible != index
            if visible >= 0
                BlzSetSpecialEffectAlpha(clips[visible], 0)
            visible = index
        let clip = originalClip(character, index)
        let duration = clip.endSeconds - clip.startSeconds
        var seconds = max(0., pose.clipTime)
        if duration > 0.
            if clip.looping
                seconds -= I2R(R2I(seconds / duration)) * duration
            else
                seconds = min(seconds, duration)
        else
            seconds = 0.
        let model = clips[index]
        BlzSetSpecialEffectPosition(model, originX + fighter.x, originY, originZ + fighter.z)
        BlzSetSpecialEffectYaw(model, fighterPoseFacing(fighter) > 0 ? 0. : 3.141592654)
        BlzSetSpecialEffectScale(model, characterModelScale(character))
        BlzSetSpecialEffectTime(model, seconds)
        if light != null
            BlzSetSpecialEffectPosition(light, originX + fighter.x, originY, originZ + fighter.z)
            BlzSetSpecialEffectYaw(light, fighterPoseFacing(fighter) > 0 ? 0. : 3.141592654)
            BlzSetSpecialEffectScale(light, characterModelScale(character))
            if not lightVisible
                BlzSetSpecialEffectAnimation(light, ORIGINAL_LIGHT_ACTIVE_ANIMATION)
                BlzSetSpecialEffectTime(light, ORIGINAL_LIGHT_GATE_SECONDS)
                lightVisible = true
        if fighter.frozenFrames > 0
            BlzSetSpecialEffectColor(model, 155, 210, 255)
            BlzSetSpecialEffectAlpha(model, 255)
        else
            BlzSetSpecialEffectColor(model, fighter.shield ? 100 : 255, fighter.shield ? 160 : 255, 255)
            BlzSetSpecialEffectAlpha(model, isIntangible(fighter) ? 140 : 255)

    ondestroy
        // DestroyEffect may defer teardown; suppress illumination first.
        if light != null
            BlzSetSpecialEffectAnimation(light, ORIGINAL_LIGHT_INACTIVE_ANIMATION)
            BlzSetSpecialEffectTime(light, ORIGINAL_LIGHT_GATE_SECONDS)
            DestroyEffect(light)
            light = null
        for index = 0 to count - 1
            BlzSetSpecialEffectAlpha(clips[index], 0)
            BlzSetSpecialEffectScale(clips[index], 0.)
            DestroyEffect(clips[index])
            clips[index] = null
