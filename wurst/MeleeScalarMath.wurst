package MeleeScalarMath
import Binary32

// Numerical coefficients: wc3-melee:docs/smash-melee-reference/retail-trig-coefficients.json.
// Every rounding boundary is part of the approximation, including range reduction.
constant PI = 3.1415927410125732
constant HALF_PI = 1.5707963705062866

tuple atanSegment(real offsetHigh, real offsetLow, real numeratorHigh, real numeratorLow, real angleHigh, real angleLow)

function segmentFor(real magnitude) returns atanSegment
    if magnitude < 0.534511148929596
        return atanSegment(2.414212942123413, 0.0000005620000251838064, 6.828420162200928, 0.0000071350000325764995, 0.3926900029182434, 0.000009081698408408556)
    if magnitude < 0.8206787705421448
        return atanSegment(1.4966057538986206, 0., 3.239828109741211, 0.0000008200000252145401, 0.5890486240386963, 0.000000023000000126671694)
    if magnitude < 1.218503475189209
        return atanSegment(1., 0., 2., 0., 0.7853981256484985, 0.0000000630000016599297)
    if magnitude < 1.870868444442749
        return atanSegment(0.6681786179542542, 0., 1.4464620351791382, 0.0000006299999881775875, 0.9817469716072083, 0.0000007040000014058023)
    return atanSegment(0.4142135679721832, 0., 1.1715729236602783, 0., 1.1780970096588135, 0.0000002499999993688107)

function atanPolynomial(real residual) returns real
    let square = (residual * residual).roundToFloat32()
    let cube = (square * residual).roundToFloat32()
    var coefficient = 0.04714243486523628
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.08459755778312683)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, 0.11041180044412613)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.14281649887561798)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, 0.1999988704919815)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.3333333134651184)
    return fusedMultiplyAddFloat32(coefficient, cube, residual)

function positiveAtan(real magnitude) returns real
    if magnitude <= 0.4142135679721832
        return atanPolynomial(magnitude)
    if magnitude >= 2.4142136573791504
        return (HALF_PI - atanPolynomial((1. / magnitude).roundToFloat32())).roundToFloat32()
    let segment = segmentFor(magnitude)
    let denominator = (segment.offsetHigh + (magnitude + segment.offsetLow).roundToFloat32()).roundToFloat32()
    let inverse = (1. / denominator).roundToFloat32()
    let high = fusedMultiplyAddFloat32(-inverse, segment.numeratorHigh, segment.offsetHigh)
    let low = fusedMultiplyAddFloat32(-inverse, segment.numeratorLow, segment.offsetLow)
    let residual = (high + low).roundToFloat32()
    return ((atanPolynomial(residual) + segment.angleLow).roundToFloat32() + segment.angleHigh).roundToFloat32()

function hasNegativeSign(real value) returns boolean
    // IEEE reciprocal distinguishes the zeros that choose atan2's quadrant.
    return value < 0. or (value == 0. and 1. / value < 0.)

/** Finite binary32 vector angle; zero vectors use the vertical zero's sign. */
public function meleeAtan2(real y, real x) returns real
    let horizontal = x.roundToFloat32()
    let vertical = y.roundToFloat32()
    if horizontal == 0.
        if hasNegativeSign(vertical)
            return -HALF_PI
        return HALF_PI
    let ratio = (vertical / horizontal).roundToFloat32()
    var angle = positiveAtan(ratio.abs())
    if hasNegativeSign(ratio)
        angle = -angle
    if horizontal < 0.
        if hasNegativeSign(vertical)
            return (angle - PI).roundToFloat32()
        return (angle + PI).roundToFloat32()
    return angle

function quadrantIndex(real angle) returns int
    let scaled = (angle * 0.6366197466850281).roundToFloat32()
    if angle < 0.
        return (scaled - 0.5).roundToFloat32().toInt()
    return (scaled + 0.5).roundToFloat32().toInt()

function normalizedResidual(real angle, int quadrant) returns real
    var residual = (angle - 2. * quadrant).roundToFloat32()
    residual = fusedMultiplyAddFloat32(0.25, angle, residual)
    residual = fusedMultiplyAddFloat32(0.0232393741607666, angle, residual)
    residual = fusedMultiplyAddFloat32(0.00000017055572243407369, angle, residual)
    return fusedMultiplyAddFloat32(0.000000000018673649432310313, angle, residual)

function quadrantSine(int quadrant) returns real
    if quadrant == 1
        return 1.
    if quadrant == -1
        return -1.
    return 0.

function quadrantCosine(int quadrant) returns real
    if quadrant == 0
        return 1.
    if quadrant == 2 or quadrant == -2
        return -1.
    return 0.

function evenPolynomial(real square) returns real
    var coefficient = 0.00000352876168108196
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.0003259365039411932)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, 0.015854323282837868)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.3084251284599304)
    return fusedMultiplyAddFloat32(coefficient, square, 1.)

function oddPolynomial(real square) returns real
    var coefficient = 0.00000030897470537638583
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.0000365723499271553)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, 0.002490393118932843)
    coefficient = fusedMultiplyAddFloat32(coefficient, square, -0.08074551075696945)
    return fusedMultiplyAddFloat32(coefficient, square, 0.7853981852531433)

/** Binary32 sine for finite angles in [-float32(pi), float32(pi)]. */
public function meleeSin(real angle) returns real
    let input = angle.roundToFloat32()
    let quadrant = quadrantIndex(input)
    let residual = normalizedResidual(input, quadrant)
    let sine = quadrantSine(quadrant)
    let cosine = quadrantCosine(quadrant)
    if residual.abs() < 0.0003452669770922512
        return fusedMultiplyAddFloat32((cosine * residual).roundToFloat32(), 0.7853981852531433, sine)
    let square = (residual * residual).roundToFloat32()
    if sine != 0.
        return sine * evenPolynomial(square)
    return (cosine * residual * oddPolynomial(square)).roundToFloat32()

/** Binary32 cosine for finite angles in [-float32(pi), float32(pi)]. */
public function meleeCos(real angle) returns real
    let input = angle.roundToFloat32()
    let quadrant = quadrantIndex(input)
    let residual = normalizedResidual(input, quadrant)
    let sine = quadrantSine(quadrant)
    let cosine = quadrantCosine(quadrant)
    if residual.abs() < 0.0003452669770922512
        return fusedMultiplyAddFloat32(-residual, sine, cosine)
    let square = (residual * residual).roundToFloat32()
    if cosine != 0.
        return cosine * evenPolynomial(square)
    return (-sine * residual * oddPolynomial(square)).roundToFloat32()
