package BindingSettings
import Wurst
import KeyBindings
import SaveLoadData

public constant SETTINGS_FILE = "MeleePrototypeBindings"

public class BindingSettings
    private player owner
    public KeyBindings bindings = new KeyBindings(false)
    public boolean ready = false
    public boolean capturing = false
    public int revision = 0
    public int captureAction = -1
    public int captureSlot = -1
    public string message = "Loading controls..."

    construct(player owner)
        this.owner = owner

    function initialize()
        bindings.preset(false)
        owner.loadData(SETTINGS_FILE) (status, data) ->
            if status == SUCCESS and data != null
                if not bindings.restore(data.getUnsafeString())
                    bindings.preset(false)
                    message = "Saved controls were invalid; using QWERTY defaults."
                else
                    message = "Saved controls loaded."
            else
                bindings.preset(false)
                message = "QWERTY controls ready."
            if data != null
                destroy data
            revision++
            ready = true

    function applyPreset(boolean custom)
        if not ready
            return
        bindings.preset(custom)
        revision++
        capturing = false
        message = custom ? "Custom controls selected." : "QWERTY controls selected."

    function beginCapture(int action, int slot)
        if not ready or action < 0 or action >= ACTION_COUNT or slot < 0 or slot > 1
            return
        captureAction = action
        captureSlot = slot
        capturing = true
        message = "Press a key for " + KeyBindings.actionName(action) + "."

    function capture(int key) returns boolean
        if not capturing
            return false
        if bindings.rebind(captureAction, captureSlot, key)
            capturing = false
            revision++
            message = "Binding updated."
            return true
        message = "That key is reserved or already assigned. Press another key."
        return true

    function save()
        if not ready
            return
        capturing = false
        owner.saveData(SETTINGS_FILE, bindings.encode())
        message = "Controls saved for next time."

    function cancelCapture()
        capturing = false
        captureAction = -1
        captureSlot = -1
