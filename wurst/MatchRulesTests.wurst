package MatchRulesTests
import MatchRules

@Test function selectionMatchResultAndRematch()
    let game = new MatchState()
    game.requestStageSelect(0).assertFalse()
    game.requestStart(0).assertFalse()
    game.selectCharacter(0, 1)
    game.selectStage(0, 1)
    game.stageChoice.assertEquals(0)
    game.requestStart(0).assertFalse()
    game.requestStageSelect(0).assertTrue()
    game.phase.assertEquals(STAGE_MENU)
    game.selectCharacter(0, 0)
    game.characterChoice.assertEquals(1)
    game.selectStage(0, 1)
    game.stageChoice.assertEquals(1)
    game.requestStart(0).assertTrue()
    game.phase.assertEquals(MATCH)
    game.remainingSeconds().assertEquals(420)
    game.selectStage(0, 0)
    game.stageChoice.assertEquals(1)
    game.resolveStocks(2, 1)
    game.phase.assertEquals(MATCH)
    game.resolveStocks(2, 0)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(0)
    game.confirmRematch(0).assertTrue()
    game.phase.assertEquals(CHARACTER_MENU)
    game.characterReady(0).assertFalse()
    game.requestStageSelect(0).assertFalse()
    destroy game

@Test function bothPlayersMustSelectBeforeEitherCanOpenStages()
    let game = new MatchState()
    game.setHumanCount(2)
    game.selectCharacter(0, 1)
    game.requestStageSelect(0).assertFalse()
    game.requestStageSelect(1).assertFalse()
    game.selectCharacter(1, 0)
    game.requestStageSelect(1).assertTrue()
    game.selectStage(1, 1)
    game.stageChoice.assertEquals(1)
    game.selectStage(0, 0)
    game.stageChoice.assertEquals(0)
    game.requestStart(1).assertTrue()
    game.phase.assertEquals(MATCH)
    destroy game

@Test function humanAndCpuCanIndependentlyChooseMirrorMatchups()
    let game = new MatchState()
    game.characterFor(1).assertEquals(1)
    game.selectCharacter(0, 1)
    game.characterFor(0).assertEquals(1)
    game.characterFor(1).assertEquals(1)
    game.requestStageSelect(0).assertTrue()
    game.returnToCharacters(0)
    game.unreadyCharacter(0)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, 0)
    game.characterFor(0).assertEquals(0)
    game.characterFor(1).assertEquals(0)
    game.allCharactersReady().assertTrue()
    destroy game

@Test function onlySoloHostCanChooseCpuAndNeverOverridesHumanTwo()
    let game = new MatchState()
    game.selectCpuCharacter(1, 0)
    game.selectCpuCharacter(0, 2)
    game.characterFor(1).assertEquals(1)
    game.setHumanCount(2)
    game.selectCpuCharacter(0, 0)
    game.characterFor(1).assertEquals(1)
    game.selectCharacter(1, 0)
    game.characterFor(0).assertEquals(0)
    game.characterFor(1).assertEquals(0)
    destroy game

@Test function backFromStagesPreservesChoicesAndAllowsUnready()
    let game = new MatchState()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.selectCharacter(1, 1)
    game.requestStageSelect(0)
    game.setStocks(1, 5)
    game.selectStage(1, 1)
    game.returnToCharacters(1)
    game.phase.assertEquals(CHARACTER_MENU)
    game.stockCount.assertEquals(5)
    game.stageChoice.assertEquals(1)
    game.unreadyCharacter(1)
    game.requestStageSelect(0).assertFalse()
    game.selectCharacter(1, 0)
    game.requestStageSelect(1).assertTrue()
    destroy game

@Test function absentAndInvalidParticipantsCannotChooseOrStart()
    let game = new MatchState()
    game.selectCharacter(1, 0)
    game.characterReady(1).assertFalse()
    game.selectCharacter(0, 2)
    game.characterReady(0).assertFalse()
    game.selectCharacter(0, 0)
    game.requestStageSelect(-1).assertFalse()
    game.requestStageSelect(1).assertFalse()
    game.requestStageSelect(0).assertTrue()
    game.selectStage(1, 1)
    game.selectStage(-1, 1)
    game.selectStage(0, 2)
    game.stageChoice.assertEquals(0)
    game.returnToCharacters(1)
    game.phase.assertEquals(STAGE_MENU)
    game.setStocks(1, 8)
    game.setTimeLimit(-1, 1)
    game.stockCount.assertEquals(3)
    game.timeLimitMinutes.assertEquals(7)
    game.requestStart(1).assertFalse()
    game.requestStart(-1).assertFalse()
    game.requestStart(0).assertTrue()
    destroy game

@Test function settingsStayBoundedAndOnlyChangeInStageSelect()
    let game = new MatchState()
    game.setStocks(0, 9)
    game.setTimeLimit(0, 10)
    game.stockCount.assertEquals(3)
    game.timeLimitMinutes.assertEquals(7)
    game.selectCharacter(0, 0)
    game.requestStageSelect(0)
    game.setStocks(0, 1)
    game.setStocks(0, 0)
    game.stockCount.assertEquals(1)
    game.setStocks(0, 9)
    game.setStocks(0, 10)
    game.stockCount.assertEquals(9)
    game.setTimeLimit(0, 0)
    game.setTimeLimit(0, -1)
    game.timeLimitMinutes.assertEquals(0)
    game.setTimeLimit(0, 10)
    game.setTimeLimit(0, 11)
    game.timeLimitMinutes.assertEquals(10)
    game.requestStart(0)
    game.remainingFrames.assertEquals(36000)
    game.setStocks(0, 1)
    game.setTimeLimit(0, 1)
    game.stockCount.assertEquals(9)
    game.timeLimitMinutes.assertEquals(10)
    destroy game

@Test function secondPlayerLeavingLetsSelectedHostOpenStages()
    let game = new MatchState()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.requestStageSelect(0).assertFalse()
    game.setHumanCount(1)
    game.requestStageSelect(0).assertTrue()
    game.requestStart(0).assertTrue()
    destroy game

@Test function bothPlayersReadyAgainForRematch()
    let game = new MatchState()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.selectCharacter(1, 1)
    game.requestStageSelect(0)
    game.requestStart(0)
    game.resolveStocks(0, 2)
    game.confirmRematch(0).assertFalse()
    game.phase.assertEquals(RESULT)
    game.confirmRematch(1).assertTrue()
    game.characterReady(0).assertFalse()
    game.characterReady(1).assertFalse()
    game.selectCharacter(0, 0)
    game.requestStageSelect(0).assertFalse()
    game.selectCharacter(1, 1)
    game.requestStageSelect(0).assertTrue()
    game.requestStart(0).assertTrue()
    destroy game

@Test function menuAndUnlimitedMatchesDoNotRunClock()
    let game = new MatchState()
    game.advanceClock(0, 0., 0, 0.)
    game.remainingFrames.assertEquals(25200)
    game.phase.assertEquals(CHARACTER_MENU)
    game.selectCharacter(0, 0)
    game.requestStageSelect(0)
    game.advanceClock(0, 0., 0, 0.)
    game.remainingFrames.assertEquals(25200)
    game.phase.assertEquals(STAGE_MENU)
    game.setTimeLimit(0, 0)
    game.requestStart(0)
    for tick = 1 to 120
        game.advanceClock(1, 90., 1, 20.)
    game.phase.assertEquals(MATCH)
    game.remainingFrames.assertEquals(0)
    game.timedOut.assertFalse()
    destroy game

@Test function timeoutComparesStocksThenDamageAndExactTieDraws()
    for outcome = 0 to 4
        let game = new MatchState()
        game.selectCharacter(0, 0)
        game.requestStageSelect(0)
        game.setTimeLimit(0, 1)
        game.requestStart(0)
        for tick = 1 to 3599
            game.advanceClock(3, 100., 2, 0.)
        game.phase.assertEquals(MATCH)
        game.remainingSeconds().assertEquals(1)
        if outcome == 0
            game.advanceClock(3, 100., 2, 0.)
            game.winner.assertEquals(0)
        else if outcome == 1
            game.advanceClock(1, 0., 2, 100.)
            game.winner.assertEquals(1)
        else if outcome == 2
            game.advanceClock(2, 10.1, 2, 10.2)
            game.winner.assertEquals(0)
        else if outcome == 3
            game.advanceClock(2, 10.2, 2, 10.1)
            game.winner.assertEquals(1)
        else
            game.advanceClock(2, 10., 2, 10.)
            game.winner.assertEquals(-1)
        game.phase.assertEquals(RESULT)
        game.timedOut.assertTrue()
        game.remainingSeconds().assertEquals(0)
        let result = game.winner
        game.advanceClock(0, 0., 1, 0.)
        game.winner.assertEquals(result)
        game.remainingFrames.assertEquals(0)
        destroy game

@Test function simultaneousFinalStocksAreADraw()
    let game = new MatchState()
    game.resolveStocks(0, 0)
    game.phase.assertEquals(CHARACTER_MENU)
    game.selectCharacter(0, 0)
    game.requestStageSelect(0)
    game.requestStart(0)
    game.resolveStocks(0, 0)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(-1)
    game.resolveStocks(1, 0)
    game.winner.assertEquals(-1)
    destroy game

@Test function playerForfeitEndsSelectionAndDeclaresOtherPlayerWinner()
    let game = new MatchState()
    game.setHumanCount(2)
    game.forfeit(0)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(1)
    destroy game
