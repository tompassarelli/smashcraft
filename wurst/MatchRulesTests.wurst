package MatchRulesTests
import WorldTestSupport
import MatchRules
import Simulation

@Test function selectionMatchResultAndRematch()
    let game = testSoloMatch()
    game.requestStageSelect(0).assertFalse()
    game.requestStart(0).assertFalse()
    game.selectCharacter(0, 1)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.selectStage(0, 1)
    game.stageChoice.assertEquals(0)
    game.requestStart(0).assertFalse()
    game.requestStageSelect(0).assertTrue()
    game.phase.assertEquals(STAGE_MENU)
    game.selectCharacter(0, 0)
    game.characterFor(0).assertEquals(1)
    game.selectStage(0, 1)
    game.stageChoice.assertEquals(1)
    game.requestStart(0).assertTrue()
    game.phase.assertEquals(MATCH)
    game.remainingSeconds().assertEquals(420)
    game.selectStage(0, 0)
    game.stageChoice.assertEquals(1)
    game.resolveStocks(testStanding(2, 0., 1, 0.))
    game.phase.assertEquals(MATCH)
    game.resolveStocks(testStanding(2, 0., 0, 0.))
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(0)
    game.confirmRematch(0).assertTrue()
    game.phase.assertEquals(CHARACTER_MENU)
    game.characterReady(0).assertTrue()
    game.characterReady(1).assertTrue()
    game.characterFor(0).assertEquals(1)
    game.characterFor(1).assertEquals(0)
    game.requestStageSelect(0).assertTrue()
    game.selectStage(0, 0)
    game.requestStart(0).assertTrue()
    game.phase.assertEquals(MATCH)
    destroy game

@Test function bothPlayersMustSelectBeforeEitherCanOpenStages()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.selectCharacter(0, 1)
    game.requestStageSelect(0).assertFalse()
    game.requestStageSelect(1).assertFalse()
    game.selectCharacter(1, 0)
    game.requestStageSelect(1).assertTrue()
    game.selectStage(1, 1)
    game.stageChoice.assertEquals(1)
    game.selectStage(0, 0)
    game.stageChoice.assertEquals(0)
    game.requestStart(1).assertTrue()
    game.phase.assertEquals(MATCH)
    destroy game

@Test function humanAndCpuCanIndependentlyChooseMirrorMatchups()
    let game = testSoloMatch()
    game.characterFor(1).assertEquals(1)
    game.selectCharacter(0, 1)
    game.characterFor(0).assertEquals(1)
    game.characterFor(1).assertEquals(1)
    game.practiceSelected().assertTrue()
    game.selectCpuCharacter(0, game.cpuSlot(), 1)
    game.requestStageSelect(0).assertTrue()
    game.returnToCharacters(0)
    game.unreadyCharacter(0)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.characterFor(0).assertEquals(0)
    game.characterFor(1).assertEquals(0)
    game.allCharactersReady().assertTrue()
    destroy game

@Test function onlySoloHostCanChooseCpuAndNeverOverridesHumanTwo()
    let game = testSoloMatch()
    game.selectCpuCharacter(1, game.cpuSlot(), 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 3)
    game.characterFor(1).assertEquals(1)
    game.setHumanCount(2)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.characterFor(1).assertEquals(1)
    game.selectCharacter(1, 0)
    game.characterFor(0).assertEquals(0)
    game.characterFor(1).assertEquals(0)
    destroy game

@Test function soloPracticeNeedsOnlyPlayerChipAndCpuPlacementChoosesFight()
    let game = testSoloMatch()
    game.allCharactersReady().assertFalse()
    game.requestStageSelect(0).assertFalse()
    game.requestStart(0).assertFalse()
    game.selectCharacter(0, 1)
    game.characterReady(1).assertFalse()
    game.allCharactersReady().assertTrue()
    game.requestStageSelect(0).assertTrue()
    game.returnToCharacters(0)
    game.selectCpuCharacter(0, game.cpuSlot(), 1)
    game.allCharactersReady().assertTrue()
    game.requestStageSelect(0).assertTrue()
    game.returnToCharacters(0)
    game.recallCharacter(0, 1)
    game.characterReady(1).assertFalse()
    game.requestStageSelect(0).assertTrue()
    destroy game

@Test function soloCpuPlacementIsClearedWhenSecondHumanJoins()
    let game = testSoloMatch()
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.allCharactersReady().assertTrue()
    game.setHumanCount(2)
    game.characterReady(1).assertFalse()
    game.requestStageSelect(0).assertFalse()
    destroy game

@Test function backFromStagesPreservesChoicesAndAllowsUnready()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.selectCharacter(1, 1)
    game.requestStageSelect(0)
    game.setStocks(1, 5)
    game.selectStage(1, 1)
    game.returnToCharacters(1)
    game.phase.assertEquals(CHARACTER_MENU)
    game.stockCount.assertEquals(5)
    game.stageChoice.assertEquals(1)
    game.unreadyCharacter(1)
    game.requestStageSelect(0).assertFalse()
    game.selectCharacter(1, 0)
    game.requestStageSelect(1).assertTrue()
    destroy game

@Test function absentAndInvalidParticipantsCannotChooseOrStart()
    let game = testSoloMatch()
    game.selectCharacter(1, 0)
    game.characterReady(1).assertFalse()
    game.selectCharacter(0, 3)
    game.characterReady(0).assertFalse()
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 1)
    game.requestStageSelect(-1).assertFalse()
    game.requestStageSelect(1).assertFalse()
    game.requestStageSelect(0).assertTrue()
    game.selectStage(1, 1)
    game.selectStage(-1, 1)
    game.selectStage(0, 2)
    game.stageChoice.assertEquals(0)
    game.returnToCharacters(1)
    game.phase.assertEquals(STAGE_MENU)
    game.setStocks(1, 8)
    game.setTimeLimit(-1, 1)
    game.stockCount.assertEquals(3)
    game.timeLimitMinutes.assertEquals(7)
    game.requestStart(1).assertFalse()
    game.requestStart(-1).assertFalse()
    game.requestStart(0).assertTrue()
    destroy game

@Test function settingsStayBoundedAndOnlyChangeInStageSelect()
    let game = testSoloMatch()
    game.setStocks(0, 9)
    game.setTimeLimit(0, 10)
    game.stockCount.assertEquals(3)
    game.timeLimitMinutes.assertEquals(7)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 1)
    game.requestStageSelect(0)
    game.setStocks(0, 1)
    game.setStocks(0, 0)
    game.stockCount.assertEquals(1)
    game.setStocks(0, 9)
    game.setStocks(0, 10)
    game.stockCount.assertEquals(9)
    game.setTimeLimit(0, 0)
    game.setTimeLimit(0, -1)
    game.timeLimitMinutes.assertEquals(0)
    game.setTimeLimit(0, 10)
    game.setTimeLimit(0, 11)
    game.timeLimitMinutes.assertEquals(10)
    game.requestStart(0)
    game.remainingFrames.assertEquals(36000)
    game.setStocks(0, 1)
    game.setTimeLimit(0, 1)
    game.stockCount.assertEquals(9)
    game.timeLimitMinutes.assertEquals(10)
    destroy game

@Test function secondPlayerLeavingLetsSelectedHostOpenStages()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.requestStageSelect(0).assertFalse()
    game.setHumanCount(1)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.requestStageSelect(0).assertTrue()
    game.requestStart(0).assertTrue()
    destroy game

@Test function bothPlayersConfirmRematchAndKeepPlacedFighters()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.selectCharacter(1, 1)
    game.requestStageSelect(0)
    game.requestStart(0)
    game.resolveStocks(testStanding(0, 0., 2, 0.))
    game.confirmRematch(0).assertFalse()
    game.phase.assertEquals(RESULT)
    game.confirmRematch(1).assertTrue()
    game.characterReady(0).assertTrue()
    game.characterReady(1).assertTrue()
    game.characterFor(0).assertEquals(0)
    game.characterFor(1).assertEquals(1)
    game.requestStageSelect(0).assertTrue()
    game.selectStage(1, 1)
    game.requestStart(0).assertTrue()
    game.stageChoice.assertEquals(1)
    game.phase.assertEquals(MATCH)
    destroy game

@Test function menuAndUnlimitedMatchesDoNotRunClock()
    let game = testSoloMatch()
    game.advanceClock(testStanding(0, 0., 0, 0.))
    game.remainingFrames.assertEquals(25200)
    game.phase.assertEquals(CHARACTER_MENU)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.requestStageSelect(0)
    game.advanceClock(testStanding(0, 0., 0, 0.))
    game.remainingFrames.assertEquals(25200)
    game.phase.assertEquals(STAGE_MENU)
    game.setTimeLimit(0, 0)
    game.requestStart(0)
    for tick = 1 to 120
        game.advanceClock(testStanding(1, 90., 1, 20.))
    game.phase.assertEquals(MATCH)
    game.remainingFrames.assertEquals(0)
    game.timedOut.assertFalse()
    destroy game

@Test function timeoutComparesStocksThenDamageAndExactTieDraws()
    for outcome = 0 to 4
        let game = testSoloMatch()
        game.selectCharacter(0, 0)
        game.selectCpuCharacter(0, game.cpuSlot(), 0)
        game.requestStageSelect(0)
        game.setTimeLimit(0, 1)
        game.requestStart(0)
        for tick = 1 to 3599
            game.advanceClock(testStanding(3, 100., 2, 0.))
        game.phase.assertEquals(MATCH)
        game.remainingSeconds().assertEquals(1)
        if outcome == 0
            game.advanceClock(testStanding(3, 100., 2, 0.))
            game.winner.assertEquals(0)
        else if outcome == 1
            game.advanceClock(testStanding(1, 0., 2, 100.))
            game.winner.assertEquals(1)
        else if outcome == 2
            game.advanceClock(testStanding(2, 10.1, 2, 10.2))
            game.winner.assertEquals(0)
        else if outcome == 3
            game.advanceClock(testStanding(2, 10.2, 2, 10.1))
            game.winner.assertEquals(1)
        else
            game.advanceClock(testStanding(2, 10., 2, 10.))
            game.winner.assertEquals(-1)
        game.phase.assertEquals(RESULT)
        game.timedOut.assertTrue()
        game.remainingSeconds().assertEquals(0)
        let result = game.winner
        game.advanceClock(testStanding(0, 0., 1, 0.))
        game.winner.assertEquals(result)
        game.remainingFrames.assertEquals(0)
        destroy game

@Test function simultaneousFinalStocksAreADraw()
    let game = testSoloMatch()
    game.resolveStocks(testStanding(0, 0., 0, 0.))
    game.phase.assertEquals(CHARACTER_MENU)
    game.selectCharacter(0, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 0)
    game.requestStageSelect(0)
    game.requestStart(0)
    game.resolveStocks(testStanding(0, 0., 0, 0.))
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(-1)
    game.resolveStocks(testStanding(1, 0., 0, 0.))
    game.winner.assertEquals(-1)
    destroy game

@Test function playerForfeitEndsSelectionAndDeclaresOtherPlayerWinner()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.forfeit(0, testStanding(1, 0., 1, 0.))
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(1)
    destroy game

@Test function illidanMirrorMatchRetainsSelectionsAfterNewMatch()
    let game = testSoloMatch()
    game.selectCharacter(0, 2)
    game.selectCpuCharacter(0, game.cpuSlot(), 2)
    game.characterFor(0).assertEquals(2)
    game.characterFor(1).assertEquals(2)
    game.requestStageSelect(0).assertTrue()
    game.requestStart(0).assertTrue()
    game.resolveStocks(testStanding(1, 0., 0, 0.))
    game.confirmRematch(0).assertTrue()
    game.characterFor(0).assertEquals(2)
    game.characterFor(1).assertEquals(2)
    game.requestStageSelect(0).assertTrue()
    game.requestStart(0).assertTrue()
    destroy game

@Test function secondHumanCanSelectIllidan()
    let game = testSoloMatch()
    game.setHumanCount(2)
    game.selectCharacter(0, 0)
    game.selectCharacter(1, 2)
    game.characterFor(1).assertEquals(2)
    game.requestStageSelect(1).assertTrue()
    game.requestStart(1).assertTrue()
    destroy game

@Test function everyHumanMustChooseAndConfirmForThreeAndFourPlayerMatches()
    for count = 3 to 4
        let game = testSoloMatch()
        game.setHumanCount(count)
        game.humanCount.assertEquals(count)
        for slot = 0 to count - 2
            game.selectCharacter(slot, slot mod 3)
        game.requestStageSelect(count - 1).assertFalse()
        game.selectCharacter(count - 1, 2)
        game.requestStageSelect(count - 1).assertTrue()
        game.setStocks(count - 1, 5)
        game.setTimeLimit(count - 1, 2)
        game.requestStart(count - 1).assertTrue()
        game.remainingFrames.assertEquals(7200)
        game.phase = RESULT
        for slot = 0 to count - 2
            game.confirmRematch(slot).assertFalse()
        game.confirmRematch(count - 1).assertTrue()
        for slot = 0 to count - 1
            game.rematchReadiness[slot].assertFalse()
            game.characterReady(slot).assertTrue()
        game.requestStageSelect(0).assertTrue()
        game.requestStart(0).assertTrue()
        game.remainingFrames.assertEquals(7200)
        destroy game

@Test function sparseSlotsOwnTheirChoicesAndMembershipIsFixedDuringMatch()
    let game = testSoloMatch()
    game.setHumanMask(10)
    game.humanCount.assertEquals(2)
    game.firstHumanSlot().assertEquals(1)
    game.fighterMask().assertEquals(10)
    game.cpuSlot().assertEquals(-1)
    game.selectCharacter(0, 2)
    game.characterReady(0).assertFalse()
    game.selectCharacter(1, 2)
    game.selectCharacter(3, 1)
    game.selectCpuCharacter(1, game.cpuSlot(), 0)
    game.characterFor(3).assertEquals(1)
    game.requestStageSelect(0).assertFalse()
    game.requestStageSelect(3).assertTrue()
    game.setStocks(0, 9)
    game.stockCount.assertEquals(3)
    game.requestStart(3).assertTrue()
    game.setHumanMask(2)
    game.humanMask.assertEquals(10)
    game.phase = RESULT
    game.confirmRematch(0).assertFalse()
    game.confirmRematch(1).assertFalse()
    game.confirmRematch(3).assertTrue()
    game.humanMask.assertEquals(10)
    destroy game

@Test function sparseSoloHumanOwnsOneSeparateCpuAndSnapshotsKeepAllMenuSlots()
    let game = testSoloMatch()
    game.setParticipants(8, 1)
    game.humanCount.assertEquals(1)
    game.cpuSlot().assertEquals(0)
    game.fighterMask().assertEquals(9)
    game.selectCharacter(3, 2)
    game.recallCharacter(3, 0)
    game.selectCpuCharacter(0, game.cpuSlot(), 1)
    game.characterReady(0).assertFalse()
    game.selectCpuCharacter(3, game.cpuSlot(), 1)
    game.allCharactersReady().assertTrue()
    game.recallCharacter(3, 0)
    game.characterReady(0).assertFalse()
    game.selectCpuCharacter(3, game.cpuSlot(), 2)
    let copy = testSoloMatch()
    game.copyTo(copy)
    copy.humanMask.assertEquals(8)
    copy.characterFor(3).assertEquals(2)
    copy.characterFor(0).assertEquals(2)
    copy.allCharactersReady().assertTrue()
    game.setHumanMask(15)
    game.characterReady(0).assertFalse()
    game.characterReady(3).assertTrue()
    game.allCharactersReady().assertFalse()
    destroy copy
    destroy game

@Test function departureEndsEpochWithoutCpuTakeoverOrWaitingForMissingVotes()
    let game = testSoloMatch()
    game.setHumanMask(11)
    game.phase = MATCH
    let world = new FighterRoster(11)
    world.fighters[0] = new FighterState(0, -240, 1)
    world.fighters[1] = new FighterState(1, 240, -1)
    world.fighters[3] = new FighterState(2, 480, -1)
    game.participantLeft(1, world)
    game.phase.assertEquals(RESULT)
    game.interrupted.assertTrue()
    game.winner.assertEquals(-1)
    game.humanMask.assertEquals(11)
    world.mask.assertEquals(11)
    game.cpuSlot().assertEquals(-1)
    game.humanPresent(1).assertFalse()
    game.confirmRematch(1).assertFalse()
    game.confirmRematch(0).assertFalse()
    game.confirmRematch(3).assertTrue()
    game.setHumanMask(9)
    game.departedMask.assertEquals(0)
    game.interrupted.assertFalse()
    game.humanMask.assertEquals(9)
    destroy world.fighters[0]
    destroy world.fighters[1]
    destroy world.fighters[3]
    destroy world
    destroy game

@Test function lastEligibleFighterWinsByForfeit()
    let game = testSoloMatch()
    game.setHumanMask(10)
    game.phase = MATCH
    let world = new FighterRoster(10)
    world.fighters[1] = new FighterState(0, -240, 1)
    world.fighters[3] = new FighterState(1, 240, -1)
    game.participantLeft(1, world)
    game.phase.assertEquals(RESULT)
    game.winner.assertEquals(3)
    game.interrupted.assertTrue()
    game.confirmRematch(3).assertTrue()
    destroy world.fighters[1]
    destroy world.fighters[3]
    destroy world
    destroy game

@Test function lobbyParticipantsPreserveEveryHumanComputerAndEmptySlot()
    let game = testSoloMatch()
    game.setParticipants(1, 6)
    game.humanMask.assertEquals(1)
    game.computerMask.assertEquals(6)
    game.fighterMask().assertEquals(7)
    game.characterReady(1).assertTrue()
    game.characterReady(2).assertTrue()
    game.characterReady(3).assertFalse()
    game.setParticipants(8, 7)
    game.firstHumanSlot().assertEquals(3)
    game.fighterMask().assertEquals(15)
    for slot = 0 to 2
        game.canChooseComputer(3, slot).assertTrue()
        game.selectCpuCharacter(3, slot, 2)
        game.characterFor(slot).assertEquals(2)
    game.selectCharacter(3, 1)
    game.allCharactersReady().assertTrue()
    game.setParticipants(9, 4)
    game.humanCount.assertEquals(2)
    game.fighterMask().assertEquals(13)
    game.fighterActive(1).assertFalse()
    game.canChooseComputer(0, 2).assertTrue()
    game.canChooseComputer(3, 2).assertFalse()
    game.selectCpuCharacter(3, 2, 0)
    game.characterFor(2).assertEquals(2)
    game.selectCharacter(0, 1)
    game.selectCharacter(3, 2)
    game.requestStageSelect(3).assertTrue()
    game.requestStart(0).assertTrue()
    game.setParticipants(1, 14)
    game.humanMask.assertEquals(9)
    game.computerMask.assertEquals(4)
    let copy = testSoloMatch()
    game.copyTo(copy)
    copy.computerMask.assertEquals(4)
    copy.fighterMask().assertEquals(13)
    copy.phase = CHARACTER_MENU
    copy.setParticipants(15, 0)
    copy.fighterMask().assertEquals(15)
    copy.cpuSlot().assertEquals(-1)
    copy.setParticipants(8, 0)
    copy.fighterMask().assertEquals(8)
    copy.cpuSlot().assertEquals(-1)
    destroy copy
    destroy game

@Test function slotModeCyclesPreserveConnectedOwnersAndTheirOriginalIndices()
    let game = new MatchState()
    game.setParticipants(9, 2)
    game.selectCharacter(0, 2)
    game.selectCharacter(3, 1)
    game.cycleSlotMode(3, 3).assertTrue()
    game.humanMask.assertEquals(9)
    game.humanCount.assertEquals(2)
    game.humanFighterMask.assertEquals(1)
    game.computerMask.assertEquals(10)
    game.characterReady(3).assertTrue()
    game.canChooseComputer(3, 3).assertTrue()
    game.cycleSlotMode(3, 0).assertFalse()
    game.cycleSlotMode(2, 2).assertFalse()
    game.cycleSlotMode(3, 3).assertTrue()
    game.fighterActive(3).assertFalse()
    game.humanPresent(3).assertTrue()
    game.cycleSlotMode(3, 3).assertTrue()
    game.humanFighterActive(3).assertTrue()
    game.characterReady(3).assertFalse()
    game.selectCharacter(3, 2)
    game.characterFor(3).assertEquals(2)
    game.cycleSlotMode(0, 0).assertTrue()
    game.cycleSlotMode(0, 0).assertTrue()
    game.fighterActive(0).assertFalse()
    game.firstHumanSlot().assertEquals(0)
    game.requestStageSelect(0).assertTrue()
    game.cycleSlotMode(0, 3).assertFalse()
    game.requestStart(0).assertTrue()
    game.cycleSlotMode(3, 3).assertFalse()
    let copy = new MatchState()
    game.copyTo(copy)
    copy.humanMask.assertEquals(9)
    copy.humanFighterMask.assertEquals(8)
    copy.computerMask.assertEquals(2)
    copy.phase = RESULT
    copy.confirmRematch(0).assertFalse()
    copy.confirmRematch(3).assertTrue()
    copy.updateConnectedHumans(9)
    copy.fighterActive(0).assertFalse()
    copy.humanFighterMask.assertEquals(8)
    copy.cycleSlotMode(0, 0).assertTrue()
    copy.humanFighterMask.assertEquals(9)
    destroy copy
    destroy game

@Test function slotModeUnconnectedHumansAndEmptyMatchesCannotStart()
    let game = new MatchState()
    game.setParticipants(8, 0)
    game.selectCharacter(3, 2)
    game.cycleSlotMode(3, 0).assertTrue()
    game.humanFighterActive(0).assertTrue()
    game.humanMask.assertEquals(8)
    game.hasUnassignedHuman().assertTrue()
    game.selectCharacter(0, 1)
    game.characterReady(0).assertFalse()
    game.requestStageSelect(3).assertFalse()
    game.cycleSlotMode(3, 0).assertTrue()
    game.computerActive(0).assertTrue()
    game.hasUnassignedHuman().assertFalse()
    game.allCharactersReady().assertTrue()
    game.cycleSlotMode(3, 3).assertTrue()
    game.selectCharacter(3, 0)
    game.characterFor(3).assertEquals(2)
    game.humanFighterMask.assertEquals(0)
    game.allCharactersReady().assertTrue()
    game.cycleSlotMode(3, 3).assertTrue()
    game.cycleSlotMode(3, 0).assertTrue()
    game.fighterMask().assertEquals(0)
    game.humanPresent(3).assertTrue()
    game.allCharactersReady().assertFalse()
    game.requestStageSelect(3).assertFalse()
    destroy game
