package MatchStep
import Simulation
import MatchRules
import CommandBuffer
import CombatInput
import NetworkInput
import InputAdapter
import ParticipantInputs
import ImpactEvents
import ImpactState
import SpecialEffectState
import BotRecovery

boolean array wasGrabbed
boolean array beforeOut
int array beforeJump
int array beforeAttack
real array beforeDamage
real array beforeShield
InputSnapshot computerNeutral = new InputSnapshot()

public function initializeMatchFighters(MatchState game, FighterRoster world)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot)
            world.fighters[slot].stocks = game.practice and not game.humanFighterActive(slot) ? 0 : game.stockCount
            world.fighters[slot].out = game.practice and not game.humanFighterActive(slot)

public function matchSpawnX(int slot) returns real
    if slot == 0
        return -240
    if slot == 1
        return 240
    return slot == 2 ? -80 : 80

// Runs from the state being simulated, so a corrected human row also corrects
// every computer decision that depends on that human's position.
public function produceComputerInput(MatchState game, FighterRoster world, ReplayRuntimeState runtime,
        int slot, int frame, InputSnapshot input, AttackBuffer commands)
    let fighter = world.fighters[slot]
    computerNeutral.copyTo(input)
    commands.clear()
    if fighter.out
        return
    var targetSlot = -1
    var distance = 0.
    for candidate = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(candidate) and candidate != slot and not world.fighters[candidate].out and world.fighters[candidate].stocks > 0
            let gap = (world.fighters[candidate].x - fighter.x).abs()
            if targetSlot < 0 or gap < distance
                targetSlot = candidate
                distance = gap
    let recovering = chooseRecoveryInput(fighter, game.stageChoice, input)
    runtime.botAttackDelays[slot] -= 1.0 / MATCH_TICKS_PER_SECOND
    if targetSlot < 0
        return
    let target = world.fighters[targetSlot]
    if not recovering
        let chaseX = min(surfaceRight(game.stageChoice, 0) - 40, max(surfaceLeft(game.stageChoice, 0) + 40, target.x))
        if (chaseX - fighter.x).abs() > 95
            input.direction = chaseX > fighter.x ? 1 : -1
        if fighter.grounded and target.z > fighter.z + 130
            input.jumpPressed = true
            input.jumpHeld = true
        if distance < 135 and runtime.botAttackDelays[slot] <= 0
            commands.enqueue(0, target.x >= fighter.x ? 1 : -1, frame, false)
            runtime.botAttackDelays[slot] = 0.35

public function stepMatch(MatchState game, FighterRoster world, FrameInputs controls, int frame)
    if game.phase != MATCH
        return
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot)
            let f = world.fighters[slot]
            beforeOut[slot] = f.out
            wasGrabbed[slot] = inGrabContext(f)
            if wasGrabbed[slot]
                controls.commands[slot].clear()
            controls.inputs[slot].attackRequested = controls.commands[slot].hasPending(frame) and f.frozenFrames == 0
    resolveLedges(world, game.stageChoice, controls)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot)
            advance(world.fighters[slot], game.stageChoice, controls.inputs[slot], matchSpawnX(slot))
    captureGrabPauses(world)
    resolveGrabs(world)
    beginDamageContacts()
    advanceGrabs(world, controls)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot) and not wasGrabbed[slot]
            startFighterSpecial(world.fighters[slot], game.stageChoice, controls.inputs[slot])
    advanceFreezeTraps(world)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot)
            let f = world.fighters[slot]
            let commands = controls.commands[slot]
            if f.frozenFrames > 0
                commands.clear()
            let command = commands.consume(frame, canStartAttackStyle(f, commands.style))
            let style = attackStyleForGrounding(command, f.grounded, f.facing, commands.consumedFacing)
            if f.grounded and style >= 0 and commands.consumedFacing != 0
                f.facing = commands.consumedFacing
            beginFighterAttack(world, slot, style, commands.consumedMayCharge and controls.inputs[slot].attackHeld)
    resolveAttacks(world)
    advanceSpecials(world, game.stageChoice)
    updateProjectiles(world)
    finishDamageContacts(world)
    resolveGrabs(world)
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot) and inGrabContext(world.fighters[slot])
            controls.commands[slot].clear()
    for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
        if world.active(slot) and game.practice and world.fighters[slot].out and not beforeOut[slot]
            world.fighters[slot].stocks = game.stockCount
            world.fighters[slot].respawn = 60
    game.resolveStocks(world)
    game.advanceClock(world)

function sameInputSnapshot(InputSnapshot first, InputSnapshot second) returns boolean
    if first.direction != second.direction
        return false
    if first.verticalDirection != second.verticalDirection
        return false
    if first.sdiPulse != second.sdiPulse
        return false
    if first.sdiX != second.sdiX
        return false
    if first.sdiZ != second.sdiZ
        return false
    if first.cStickX != second.cStickX
        return false
    if first.cStickZ != second.cStickZ
        return false
    if first.attackRequested != second.attackRequested
        return false
    if first.specialX != second.specialX or first.specialZ != second.specialZ
        return false
    if first.specialPressed != second.specialPressed
        return false
    if first.down != second.down
        return false
    if first.shield != second.shield
        return false
    if first.jumpPressed != second.jumpPressed
        return false
    if first.airDodgePressed != second.airDodgePressed
        return false
    if first.techPressed != second.techPressed
        return false
    if first.mashPressed != second.mashPressed
        return false
    if first.attackPressed != second.attackPressed
        return false
    if first.grabMashPressed != second.grabMashPressed
        return false
    if first.grabThrowX != second.grabThrowX
        return false
    if first.grabThrowZ != second.grabThrowZ
        return false
    if first.lCancelPressed != second.lCancelPressed
        return false
    if first.groundDodgePressed != second.groundDodgePressed
        return false
    if first.groundDodgeDirection != second.groundDodgeDirection
        return false
    if first.getupAttackPressed != second.getupAttackPressed
        return false
    if first.ledgeVerticalPressed != second.ledgeVerticalPressed
        return false
    if first.getupStandPressed != second.getupStandPressed
        return false
    if first.getupDirectionPressed != second.getupDirectionPressed
        return false
    if first.getupDirection != second.getupDirection
        return false
    if first.dodgeX != second.dodgeX
        return false
    if first.dodgeZ != second.dodgeZ
        return false
    if first.jumpHeld != second.jumpHeld
        return false
    if first.walking != second.walking
        return false
    if first.attackHeld != second.attackHeld
        return false
    return true

function sameAttackBuffer(AttackBuffer first, AttackBuffer second) returns boolean
    if first.windowFrames != second.windowFrames
        return false
    if first.style != second.style
        return false
    if first.facing != second.facing
        return false
    if first.targetFrame != second.targetFrame
        return false
    if first.consumedFacing != second.consumedFacing
        return false
    if first.mayCharge != second.mayCharge
        return false
    if first.consumedMayCharge != second.consumedMayCharge
        return false
    return true

// Detached immutable source rows; execution always rebuilds adaptation after rollback.
public class MatchFrameInput
    private int frame = -1
    private int mask = 0
    private int networkMask = 0
    private FrameInputs values = new FrameInputs()
    private FrameInputs scratch = new FrameInputs()
    private ParticipantInputs network = new ParticipantInputs()
    private boolean hasNetworkInputs = false
    private real array[INPUT_PARTICIPANT_CAPACITY] botDelaysAfterInput

    function reset()
        frame = -1
        mask = 0
        hasNetworkInputs = false

    function participantMask() returns int
        return mask

    function capture(int assignedFrame, int participantMask, FrameInputs source, ReplayRuntimeState runtime) returns boolean
        if assignedFrame < 0 or frame == assignedFrame or not validParticipantMask(participantMask)
            return false
        frame = assignedFrame
        mask = participantMask
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(mask, slot)
                source.inputs[slot].copyTo(values.inputs[slot])
                source.commands[slot].copyTo(values.commands[slot])
        hasNetworkInputs = false
        networkMask = 0
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            botDelaysAfterInput[slot] = runtime.botAttackDelays[slot]
        return true

    function captureNetworkInputs(int assignedFrame, ParticipantInputs source, FighterRoster world, int senderMask) returns boolean
        if assignedFrame < 0 or frame == assignedFrame or not validParticipantMask(world.mask) or not validParticipantMask(senderMask)
            return false
        frame = assignedFrame
        mask = world.mask
        networkMask = senderMask
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(networkMask, slot)
                source.row(slot).copyTo(network.row(slot))
        hasNetworkInputs = true
        refreshNetworkAdaptation(world, assignedFrame)
        return true

    function hasNetworkRows() returns boolean
        return hasNetworkInputs

    function copyNetworkRow(int playerSlot, NetworkInput destination) returns boolean
        if not hasNetworkInputs or not participantIsActive(networkMask, playerSlot)
            return false
        network.row(playerSlot).copyTo(destination)
        return true

    function networkRowsMatch(ParticipantInputs source) returns boolean
        if not hasNetworkInputs
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(networkMask, slot) and not network.row(slot).sameAs(source.row(slot))
                return false
        return true

    function replaceNetworkRows(ParticipantInputs source) returns boolean
        if not hasNetworkInputs
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(networkMask, slot)
                source.row(slot).copyTo(network.row(slot))
        return true

    function refreshNetworkAdaptation(FighterRoster world, int expectedFrame) returns boolean
        if not hasNetworkInputs or frame != expectedFrame or mask != world.mask
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot) and participantIsActive(networkMask, slot)
                adaptInput(network.row(slot), world.fighters[slot], expectedFrame, values.inputs[slot], values.commands[slot])
        return true

    function copyTo(MatchFrameInput destination)
        destination.frame = frame
        destination.mask = mask
        destination.networkMask = networkMask
        destination.hasNetworkInputs = hasNetworkInputs
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if participantIsActive(mask, slot)
                values.inputs[slot].copyTo(destination.values.inputs[slot])
                values.commands[slot].copyTo(destination.values.commands[slot])
            if participantIsActive(networkMask, slot)
                network.row(slot).copyTo(destination.network.row(slot))
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            destination.botDelaysAfterInput[slot] = botDelaysAfterInput[slot]

    function copyExecutedInput(int slot, InputSnapshot destination) returns boolean
        if not participantIsActive(mask, slot)
            return false
        scratch.inputs[slot].copyTo(destination)
        return true

    function sameAs(MatchFrameInput other) returns boolean
        if frame != other.frame or mask != other.mask or networkMask != other.networkMask or hasNetworkInputs != other.hasNetworkInputs
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if hasNetworkInputs
                if participantIsActive(networkMask, slot) and not network.row(slot).sameAs(other.network.row(slot))
                    return false
            else if participantIsActive(mask, slot)
                if botDelaysAfterInput[slot] != other.botDelaysAfterInput[slot]
                    return false
                if not sameInputSnapshot(values.inputs[slot], other.values.inputs[slot]) or not sameAttackBuffer(values.commands[slot], other.values.commands[slot])
                    return false
        return true

    function frameNumber() returns int
        return frame

    function execute(MatchState game, FighterRoster world, FrameInputs controls, ReplayRuntimeState runtime, int expectedFrame) returns boolean
        if frame != expectedFrame or expectedFrame != runtime.simulationFrame + 1 or mask != world.mask
            return false
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                if hasNetworkInputs
                    if game.computerActive(slot)
                        produceComputerInput(game, world, runtime, slot, frame, values.inputs[slot], values.commands[slot])
                    else
                        adaptInput(network.row(slot), world.fighters[slot], frame, values.inputs[slot], values.commands[slot])
                else
                    runtime.botAttackDelays[slot] = botDelaysAfterInput[slot]
                values.inputs[slot].copyTo(scratch.inputs[slot])
                scratch.commands[slot] = controls.commands[slot]
                let request = values.commands[slot]
                if request.style >= 0
                    controls.commands[slot].enqueue(request.style, request.facing, request.targetFrame, request.mayCharge)
                let f = world.fighters[slot]
                runtime.frameImpacts[slot].before(f)
                beforeOut[slot] = f.out
                beforeJump[slot] = f.jumpSerial
                beforeAttack[slot] = f.attackSerial
                beforeDamage[slot] = f.damage
                beforeShield[slot] = f.shieldEnergy

        runtime.impacts.advance()
        stepMatch(game, world, scratch, frame)
        for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
            if world.active(slot)
                let f = world.fighters[slot]
                runtime.frameImpacts[slot].after(f)
                if game.phase == MATCH
                    runtime.impacts.emit(runtime.frameImpacts[slot], frame)
                    runtime.specials.advance(f, slot)
                    runtime.summons.advance(f, slot)
                let hit = not beforeOut[slot] and not f.out and (f.damage > beforeDamage[slot] or (f.shieldStun > 0 and f.shieldEnergy < beforeShield[slot]))
                runtime.poses[slot].advance(f, scratch.inputs[slot], beforeOut[slot], f.jumpSerial != beforeJump[slot], f.attackSerial != beforeAttack[slot], hit)
            else
                runtime.summons.advance(null, slot)
        if game.phase != MATCH
            runtime.impacts.clear()
            runtime.specials.clear()
            runtime.summons.clear()
        runtime.simulationFrame = frame
        return true
