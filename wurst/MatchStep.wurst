package MatchStep
import Simulation
import MatchRules
import CommandBuffer
import CombatInput

public function initializeMatchFighters(MatchState game, FighterState first, FighterState second)
    first.stocks = game.stockCount
    second.stocks = game.practice ? 0 : game.stockCount
    second.out = game.practice

public function stepMatch(MatchState game, FighterState first, FighterState second, InputSnapshot firstInput, InputSnapshot secondInput, AttackBuffer firstCommands, AttackBuffer secondCommands, int frame)
    if game.phase != MATCH
        return
    let firstWasOut = first.out
    if game.practice
        secondCommands.clear()
    let firstGrab = inGrabContext(first)
    let secondGrab = inGrabContext(second)
    if firstGrab
        firstCommands.clear()
    if secondGrab
        secondCommands.clear()
    firstInput.attackRequested = firstCommands.hasPending(frame) and first.frozenFrames == 0
    secondInput.attackRequested = secondCommands.hasPending(frame) and second.frozenFrames == 0
    let firstHadDashGrabWindow = first.dashGrabWindow > 0 and first.frozenFrames == 0 and first.hitlag <= 1
    let secondHadDashGrabWindow = second.dashGrabWindow > 0 and second.frozenFrames == 0 and second.hitlag <= 1
    resolveLedgePair(first, second, game.stageChoice, firstInput, secondInput)
    advance(first, game.stageChoice, firstInput, -240)
    advance(second, game.stageChoice, secondInput, 240)
    let grabPaused = first.hitlag > 0 or second.hitlag > 0
    resolveGrabPair(first, second)
    beginDamageContacts()
    advanceGrabPair(first, second, firstInput, secondInput, grabPaused)
    if not firstGrab
        startFighterSpecial(first, game.stageChoice, firstInput)
    if not secondGrab
        startFighterSpecial(second, game.stageChoice, secondInput)
    advanceFreezeTrapPair(first, second)
    if first.frozenFrames > 0
        firstCommands.clear()
    if second.frozenFrames > 0
        secondCommands.clear()
    let firstCommand = firstCommands.consume(frame, canStartAttackStyle(first, firstCommands.style))
    let secondCommand = secondCommands.consume(frame, canStartAttackStyle(second, secondCommands.style))
    let firstDashGrabInput = first.grounded and first.dashFrame > 0 and first.dashGrabTiming.startupFrames > 0 and
        (firstCommand == 0 or firstCommand == 5)
    let secondDashGrabInput = second.grounded and second.dashFrame > 0 and second.dashGrabTiming.startupFrames > 0 and
        (secondCommand == 0 or secondCommand == 5)
    let firstCatchDash = first.dashGrabWindow > 0 and firstCommand == 5 and first.dashGrabTiming.startupFrames > 0
    let secondCatchDash = second.dashGrabWindow > 0 and secondCommand == 5 and second.dashGrabTiming.startupFrames > 0
    let firstStyle = firstDashGrabInput or firstCatchDash ? 11 : attackStyleForGrounding(firstCommand, first.grounded, first.facing, firstCommands.consumedFacing)
    let secondStyle = secondDashGrabInput or secondCatchDash ? 11 : attackStyleForGrounding(secondCommand, second.grounded, second.facing, secondCommands.consumedFacing)
    if firstCatchDash
        first.dashGrabWindow = 0
    if secondCatchDash
        second.dashGrabWindow = 0
    if first.grounded and firstStyle >= 0 and firstCommands.consumedFacing != 0
        first.facing = firstCommands.consumedFacing
    if second.grounded and secondStyle >= 0 and secondCommands.consumedFacing != 0
        second.facing = secondCommands.consumedFacing
    beginAttackPair(first, second, firstStyle, secondStyle, firstCommands.consumedMayCharge and firstInput.attackHeld, secondCommands.consumedMayCharge and secondInput.attackHeld)
    if firstHadDashGrabWindow and first.dashGrabWindow > 0 and not first.dashGrabAttack
        first.dashGrabWindow = max(0, first.dashGrabWindow - 1)
    if secondHadDashGrabWindow and second.dashGrabWindow > 0 and not second.dashGrabAttack
        second.dashGrabWindow = max(0, second.dashGrabWindow - 1)
    resolveAttackPair(first, second)
    advanceSpecialPair(first, second, game.stageChoice)
    updateProjectilePair(first, second)
    finishDamageContacts(first, second)
    resolveGrabPair(first, second)
    if inGrabContext(first)
        firstCommands.clear()
    if inGrabContext(second)
        secondCommands.clear()
    if game.practice and first.out and not firstWasOut
        first.stocks = game.stockCount
        first.respawn = 60
    game.resolveStocks(first.stocks, second.stocks)
    game.advanceClock(first.stocks, first.damage, second.stocks, second.damage)

function sameInputSnapshot(InputSnapshot first, InputSnapshot second) returns boolean
    if first.direction != second.direction
        return false
    if first.verticalDirection != second.verticalDirection
        return false
    if first.sdiPulse != second.sdiPulse
        return false
    if first.sdiX != second.sdiX
        return false
    if first.sdiZ != second.sdiZ
        return false
    if first.cStickX != second.cStickX
        return false
    if first.cStickZ != second.cStickZ
        return false
    if first.attackRequested != second.attackRequested
        return false
    if first.specialX != second.specialX or first.specialZ != second.specialZ
        return false
    if first.specialPressed != second.specialPressed
        return false
    if first.down != second.down
        return false
    if first.shield != second.shield
        return false
    if first.jumpPressed != second.jumpPressed
        return false
    if first.airDodgePressed != second.airDodgePressed
        return false
    if first.techPressed != second.techPressed
        return false
    if first.mashPressed != second.mashPressed
        return false
    if first.attackPressed != second.attackPressed
        return false
    if first.grabMashPressed != second.grabMashPressed
        return false
    if first.grabThrowX != second.grabThrowX
        return false
    if first.grabThrowZ != second.grabThrowZ
        return false
    if first.lCancelPressed != second.lCancelPressed
        return false
    if first.groundDodgePressed != second.groundDodgePressed
        return false
    if first.groundDodgeDirection != second.groundDodgeDirection
        return false
    if first.getupAttackPressed != second.getupAttackPressed
        return false
    if first.ledgeVerticalPressed != second.ledgeVerticalPressed
        return false
    if first.getupStandPressed != second.getupStandPressed
        return false
    if first.getupDirectionPressed != second.getupDirectionPressed
        return false
    if first.getupDirection != second.getupDirection
        return false
    if first.dodgeX != second.dodgeX
        return false
    if first.dodgeZ != second.dodgeZ
        return false
    if first.jumpHeld != second.jumpHeld
        return false
    if first.walking != second.walking
        return false
    if first.attackHeld != second.attackHeld
        return false
    return true

function sameAttackBuffer(AttackBuffer first, AttackBuffer second) returns boolean
    if first.windowFrames != second.windowFrames
        return false
    if first.style != second.style
        return false
    if first.facing != second.facing
        return false
    if first.targetFrame != second.targetFrame
        return false
    if first.consumedFacing != second.consumedFacing
        return false
    if first.mayCharge != second.mayCharge
        return false
    if first.consumedMayCharge != second.consumedMayCharge
        return false
    return true

// One complete, immutable input row for a fighting frame. Producer-side attack
// requests are recorded separately from the persistent simulation buffers.
public class MatchFrameInput
    private int frame = -1
    private InputSnapshot first = new InputSnapshot()
    private InputSnapshot second = new InputSnapshot()
    private InputSnapshot firstScratch = new InputSnapshot()
    private InputSnapshot secondScratch = new InputSnapshot()
    private AttackBuffer firstRequests = new AttackBuffer(0)
    private AttackBuffer secondRequests = new AttackBuffer(0)
    private real botDelayAfterInput = 0

    function reset()
        frame = -1

    function capture(int assignedFrame, InputSnapshot firstInput, InputSnapshot secondInput,
            AttackBuffer firstAttackRequests, AttackBuffer secondAttackRequests,
            ReplayRuntimeState runtime) returns boolean
        if assignedFrame < 0 or frame == assignedFrame
            return false
        frame = assignedFrame
        firstInput.copyTo(first)
        secondInput.copyTo(second)
        firstAttackRequests.copyTo(firstRequests)
        secondAttackRequests.copyTo(secondRequests)
        botDelayAfterInput = runtime.botAttackDelay
        return true

    // The history owns its destination; producer and execution scratch stay detached.
    function copyTo(MatchFrameInput destination)
        destination.frame = frame
        first.copyTo(destination.first)
        second.copyTo(destination.second)
        firstRequests.copyTo(destination.firstRequests)
        secondRequests.copyTo(destination.secondRequests)
        destination.botDelayAfterInput = botDelayAfterInput

    // Scratch is intentionally excluded: stepMatch may consume or rewrite it.
    function sameAs(MatchFrameInput other) returns boolean
        return frame == other.frame and botDelayAfterInput == other.botDelayAfterInput and sameInputSnapshot(first, other.first) and sameInputSnapshot(second, other.second) and sameAttackBuffer(firstRequests, other.firstRequests) and sameAttackBuffer(secondRequests, other.secondRequests)

    function frameNumber() returns int
        return frame

    function execute(MatchState game, FighterState firstFighter, FighterState secondFighter,
            AttackBuffer firstCommands, AttackBuffer secondCommands,
            ReplayRuntimeState runtime, int expectedFrame) returns boolean
        if frame != expectedFrame or expectedFrame != runtime.simulationFrame + 1
            return false
        first.copyTo(firstScratch)
        second.copyTo(secondScratch)
        if firstRequests.style >= 0
            firstCommands.enqueue(firstRequests.style, firstRequests.facing, firstRequests.targetFrame, firstRequests.mayCharge)
        if secondRequests.style >= 0
            secondCommands.enqueue(secondRequests.style, secondRequests.facing, secondRequests.targetFrame, secondRequests.mayCharge)
        runtime.botAttackDelay = botDelayAfterInput
        stepMatch(game, firstFighter, secondFighter, firstScratch, secondScratch,
            firstCommands, secondCommands, frame)
        runtime.simulationFrame = frame
        return true
