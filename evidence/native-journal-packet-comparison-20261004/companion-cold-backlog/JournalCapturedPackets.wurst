package JournalCapturedPackets
import Wurstunit
import InputProtocol
import NetworkInput
@Test function decodeColdStoppedHelperPackets()
    let packet = new InputPacket()
    let row = new NetworkInput()
    packet.decode("I32000001000001300W00W000200000W").assertTrue()
    packet.epochNumber().assertEquals(1)
    packet.firstFrameNumber().assertEquals(1)
    packet.recordCount().assertEquals(2)
    packet.copyRecord(0, row).assertTrue()
    row.heldMask().assertEquals(32)
    row.pressedMask().assertEquals(32)
    row.releasedMask().assertEquals(0)
    row.axisX().assertEquals(0)
    row.axisZ().assertEquals(0)
    packet.copyRecord(1, row).assertTrue()
    row.heldMask().assertEquals(0)
    row.pressedMask().assertEquals(0)
    row.releasedMask().assertEquals(32)
    row.axisX().assertEquals(0)
    row.axisZ().assertEquals(0)
