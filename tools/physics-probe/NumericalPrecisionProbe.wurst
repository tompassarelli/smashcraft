package NumericalPrecisionProbe
import Simulation

init
    let fighter = new FighterState(0, 0, 1)
    let input = new InputSnapshot()
    fighter.physics.traction = 0.07999999821186066 * 6
    fighter.knockbackX = 0.7562744617462158 * 6
    fighter.hitstun = 10
    fighter.shieldEnergy = 20
    advance(fighter, 0, input, 0)
    if fighter.knockbackX == 0.6762744784355164 * 6
        BJDebugMsg("GROUNDED_BINARY32_EXACT_PASS")
    else
        BJDebugMsg("GROUNDED_BINARY32_EXACT_FAIL")
    if fighter.shieldEnergy == 20.06999969482422
        BJDebugMsg("SHIELD_REGEN_BINARY32_EXACT_PASS")
    else
        BJDebugMsg("SHIELD_REGEN_BINARY32_EXACT_FAIL")
    if digitalShieldDamage(9.) == 6.299999713897705
        BJDebugMsg("SHIELD_DAMAGE_BINARY32_EXACT_PASS")
    else
        BJDebugMsg("SHIELD_DAMAGE_BINARY32_EXACT_FAIL")
    if digitalShieldstunDuration(9.) == 6.050000190734863 and digitalShieldstunDuration(3.) == 3.3500001430511475
        BJDebugMsg("SHIELD_STUN_BINARY32_EXACT_PASS")
    else
        BJDebugMsg("SHIELD_STUN_BINARY32_EXACT_FAIL")
    let attacker = new FighterState(1, 100, -1)
    let world = new FighterRoster(3)
    world.fighters[0] = fighter
    world.fighters[1] = attacker
    fighter.shield = true
    fighter.shieldEnergy = 8
    beginDamageContacts()
    queueDamageContact(attacker, fighter, hitEffect(9, 0, 0, 0, 0, false), 1, CONTACT_DAMAGE_ONLY, false, null)
    queueDamageContact(attacker, fighter, hitEffect(1, 0, 0, 0, 0, false), 1, CONTACT_DAMAGE_ONLY, false, null)
    finishDamageContacts(world)
    if fighter.shieldEnergy == 1.
        BJDebugMsg("SHIELD_CONTACT_SUM_BINARY32_EXACT_PASS")
    else
        BJDebugMsg("SHIELD_CONTACT_SUM_BINARY32_EXACT_FAIL")
        BJDebugMsg("SHIELD_CONTACT_SUM_ACTUAL=" + R2SW(fighter.shieldEnergy, 0, 12) + " EXPECTED=1.0")
    destroy world
    destroy attacker
    destroy input
    destroy fighter
