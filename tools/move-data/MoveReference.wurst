package MoveReference

public tuple exportedMove(string row, int style, int charge, int startup)
exportedMove array moves
int moveCount = 0
string array referenceCharacters
int referenceCharacterCount = 0
boolean array matched

public function actionFamily(int style) returns string
    if style == 0
        return "jab1"
    if style == 2
        return "usmash"
    if style == 3
        return "dsmash"
    if style == 4
        return "fsmash"
    if style == 6 or style == 9 or style == 10
        return "ftilt"
    if style == 7
        return "utilt"
    if style == 8
        return "dtilt"
    if style == 12
        return "nair"
    if style == 13
        return "fair"
    if style == 14
        return "bair"
    if style == 15
        return "uair"
    if style == 16
        return "dair"
    return ""

public function joinScope(int style, int charge) returns string
    if charge > 0
        return "family-only-charge-unknown"
    if style == 9 or style == 10
        return "family-only-angle-unknown"
    return "same-action-family"

public function firstActiveDelta(int startup, int referenceStart) returns int
    return startup + 1 - referenceStart

public function acceptMove(string row, int style, int charge, int startup)
    moves[moveCount] = exportedMove(row, style, charge, startup)
    moveCount++

// Reference -1 is an ingestion sentinel for null, never a measured frame.
public function acceptReference(string row, string character, string category, string action, int start, int origin)
    if category != "attacks"
        return
    var referenceIndex = 0
    while referenceIndex < referenceCharacterCount and referenceCharacters[referenceIndex] != character
        referenceIndex++
    if referenceIndex == referenceCharacterCount
        referenceCharacters[referenceIndex] = character
        referenceCharacterCount++
    for i = 0 to moveCount - 1
        let move = moves[i]
        if actionFamily(move.style) != "" and actionFamily(move.style) == action
            matched[referenceIndex * moveCount + i] = true
            let matchKind = joinScope(move.style, move.charge)
            var delta = "null"
            if start >= 0 and origin == 1 and matchKind == "same-action-family"
                delta = I2S(firstActiveDelta(move.startup, start))
            BJDebugMsg("{\"kind\":\"reference-join\",\"scope\":\"" + matchKind + "\",\"declared\":{\"production\":" + move.row + ",\"reference\":" + row + "},\"derived\":{\"productionFirstActiveOneBased\":" + I2S(move.startup + 1) + ",\"reportedFirstActiveDelta\":" + delta + "},\"unknown\":{\"fighterEquivalence\":null,\"referenceRecovery\":null,\"referenceDiscreteActiveWindows\":null,\"referenceShieldSafety\":null,\"chargeComparability\":null,\"balanceParity\":null}}")

public function finishReferenceJoins()
    for referenceIndex = 0 to referenceCharacterCount - 1
        for i = 0 to moveCount - 1
            if not matched[referenceIndex * moveCount + i]
                BJDebugMsg("{\"kind\":\"reference-gap\",\"declared\":{\"production\":" + moves[i].row + ",\"referenceCharacter\":\"" + referenceCharacters[referenceIndex] + "\"},\"derived\":{\"requestedActionFamily\":\"" + actionFamily(moves[i].style) + "\"},\"unknown\":{\"referenceRecord\":null}}")

public tuple contactFact(string row, int character, string category, real spacing, real percent, boolean shield, boolean connected, int attackerReady, int defenderReady, real shieldDamage, real percentDamage)
contactFact array contacts
int contactCount = 0

public function sameContactContext(contactFact a, contactFact b) returns boolean
    return a.category == b.category and a.spacing == b.spacing and a.percent == b.percent and a.shield == b.shield

// This partial order deliberately has no preference over separation or launch.
public function readinessDamageDominates(contactFact a, contactFact b) returns boolean
    let aDamage = a.shield ? a.shieldDamage : a.percentDamage
    let bDamage = b.shield ? b.shieldDamage : b.percentDamage
    return aDamage >= bDamage and a.attackerReady <= b.attackerReady and a.defenderReady >= b.defenderReady and (aDamage > bDamage or a.attackerReady < b.attackerReady or a.defenderReady > b.defenderReady)

public function tradeoffVerdict(contactFact a, contactFact b) returns string
    if not a.connected or not b.connected
        return "contact-unavailable"
    if a.attackerReady < 0 or b.attackerReady < 0 or a.defenderReady < 0 or b.defenderReady < 0
        return "readiness-unobserved"
    if readinessDamageDominates(a, b)
        return "a-dominates-projection"
    if readinessDamageDominates(b, a)
        return "b-dominates-projection"
    let aDamage = a.shield ? a.shieldDamage : a.percentDamage
    let bDamage = b.shield ? b.shieldDamage : b.percentDamage
    if aDamage == bDamage and a.attackerReady == b.attackerReady and a.defenderReady == b.defenderReady
        return "equal-projection"
    return "tradeoff"

public function acceptContact(contactFact value)
    for i = 0 to contactCount - 1
        let previous = contacts[i]
        if previous.character != value.character and sameContactContext(previous, value)
            BJDebugMsg("{\"kind\":\"tradeoff\",\"declared\":{\"a\":" + previous.row + ",\"b\":" + value.row + "},\"derived\":{\"verdict\":\"" + tradeoffVerdict(previous, value) + "\"},\"unknown\":{\"overallDominance\":null,\"tuningRecommendation\":null}}")
    contacts[contactCount] = value
    contactCount++
