package MoveComparisonTests
import MoveComparisons

@Test function sameCategoryRuleRejectsOnlyDeliberateRecoveryMutation()
    let normal = compareContact(0, 1, 60, 0, true, false)
    let smash = compareContact(0, 0, 60, 0, true, false)
    let mutant = compareContact(0, 0, 60, 0, true, true)
    normal.connected.assertTrue()
    smash.connected.assertTrue()
    categoryTradeoffViolation(smash, normal).assertFalse()
    categoryTradeoffViolation(mutant, normal).assertTrue()
    (smash.shieldDamage > normal.shieldDamage).assertTrue()
    mutant.shieldDamage.assertEquals(smash.shieldDamage)
    destroy mutant
    destroy smash
    destroy normal

@Test function followupRequiresBothTheApproachAndTheRemainingTime()
    let baseline = compareContact(0, 2, 60, 60, false, false)
    baseline.attackerReady.assertEquals(12)
    baseline.defenderReady.assertEquals(22)
    let standing = compareFollowup(0, 2, 60, 60, false, 0, 0, false, baseline)
    let approach = compareFollowup(0, 2, 60, 60, false, 0, 2, true, baseline)
    let late = compareFollowup(0, 2, 60, 60, false, 0, 6, true, baseline)
    standing.timingAllows.assertTrue()
    standing.reachesBeforeAction.assertFalse()
    approach.reachesBeforeAction.assertTrue()
    approach.firstContact.assertEquals(19)
    late.timingAllows.assertFalse()
    late.reachesBeforeAction.assertFalse()
    destroy late
    destroy approach
    destroy standing
    destroy baseline
