package MoveComparisonExport
import MoveComparisons
import MoveData

function number(real value) returns string
    return R2SW(value, 0, 12)

function booleanJson(boolean value) returns string
    return value ? "true" : "false"

function key(int character, int category, real spacing, real percent, boolean shielding) returns string
    return "\"character\":" + I2S(character) + ",\"defenderCharacter\":1,\"category\":\"" + comparisonCategory(category) + "\",\"move\":\"" + normalMoveName(comparisonStyle(category)) + "\",\"style\":" + I2S(comparisonStyle(category)) + ",\"spacing\":" + number(spacing) + ",\"percent\":" + number(percent) + ",\"shielding\":" + booleanJson(shielding)

function emitContext(int character, int category, real spacing, real percent, boolean shielding)
    let result = compareContact(character, category, spacing, percent, shielding, false)
    let identity = key(character, category, spacing, percent, shielding)
    BJDebugMsg("{\"kind\":\"contact\"," + identity + ",\"connected\":" + booleanJson(result.connected) + ",\"contactFrame\":" + I2S(result.contactFrame) + ",\"attackerReady\":" + I2S(result.attackerReady) + ",\"defenderReady\":" + I2S(result.defenderReady) + ",\"attackerLanding\":" + I2S(result.attackerLanding) + ",\"shieldstun\":" + I2S(result.shieldstun) + ",\"hitstun\":" + I2S(result.hitstun) + ",\"attackerHitlag\":" + I2S(result.attackerHitlag) + ",\"defenderHitlag\":" + I2S(result.defenderHitlag) + ",\"percentDamage\":" + number(result.percentDamage) + ",\"shieldDamage\":" + number(result.shieldDamage) + ",\"defenderWeight\":" + number(result.defenderWeight) + ",\"separationAtAttackerReady\":" + number(result.separationAtAttackerReady) + ",\"verticalAtAttackerReady\":" + number(result.verticalAtAttackerReady) + ",\"separationAtDefenderReady\":" + number(result.separationAtDefenderReady) + ",\"verticalAtDefenderReady\":" + number(result.verticalAtDefenderReady) + "}")
    if result.connected
        for candidate = 0 to 1
            let style = candidate == 0 ? 0 : 6
            for delay = 0 to 12
                for approach = 0 to 1
                    let follow = compareFollowup(character, category, spacing, percent, shielding, style, delay, approach == 1, result)
                    BJDebugMsg("{\"kind\":\"option\"," + identity + ",\"role\":\"" + (shielding ? "punish" : "followup") + "\",\"candidateStyle\":" + I2S(style) + ",\"delay\":" + I2S(delay) + ",\"approach\":" + booleanJson(approach == 1) + ",\"scheduledStart\":" + I2S(follow.scheduledStart) + ",\"actualStart\":" + I2S(follow.actualStart) + ",\"actualStyle\":" + I2S(follow.actualStyle) + ",\"firstActive\":" + I2S(follow.firstActive) + ",\"firstContact\":" + I2S(follow.firstContact) + ",\"opponentReady\":" + I2S(follow.opponentReady) + ",\"separationAtStart\":" + number(follow.separationAtStart) + ",\"verticalAtStart\":" + number(follow.verticalAtStart) + ",\"separationAtFirstActive\":" + number(follow.separationAtFirstActive) + ",\"verticalAtFirstActive\":" + number(follow.verticalAtFirstActive) + ",\"timingAllows\":" + booleanJson(follow.timingAllows) + ",\"reachesBeforeAction\":" + booleanJson(follow.reachesBeforeAction) + ",\"verdict\":\"" + followupVerdict(follow, shielding, approach == 1) + "\"}")
                    destroy follow
    destroy result

function emitRule(int character, real spacing)
    let normal = compareContact(character, 1, spacing, 0, true, false)
    let smash = compareContact(character, 0, spacing, 0, true, false)
    let mutant = compareContact(character, 0, spacing, 0, true, true)
    BJDebugMsg("{\"kind\":\"category-rule\",\"character\":" + I2S(character) + ",\"defenderCharacter\":1,\"spacing\":" + number(spacing) + ",\"percent\":0,\"shielding\":true,\"rule\":\"greater shield damage requires later attacker recovery or earlier defender response\",\"productionViolation\":" + booleanJson(categoryTradeoffViolation(smash, normal)) + ",\"mutantViolation\":" + booleanJson(categoryTradeoffViolation(mutant, normal)) + ",\"normalAttackerReady\":" + I2S(normal.attackerReady) + ",\"smashAttackerReady\":" + I2S(smash.attackerReady) + ",\"mutantAttackerReady\":" + I2S(mutant.attackerReady) + ",\"normalDefenderReady\":" + I2S(normal.defenderReady) + ",\"smashDefenderReady\":" + I2S(smash.defenderReady) + ",\"normalShieldDamage\":" + number(normal.shieldDamage) + ",\"smashShieldDamage\":" + number(smash.shieldDamage) + ",\"mutation\":\"after contact, only fixture attacker cooldown and remaining attack duration become one tick\"}")
    destroy mutant
    destroy smash
    destroy normal

init
    BJDebugMsg("{\"kind\":\"context\",\"schema\":1,\"roster\":[\"Archer\",\"Rifleman\",\"Demon Hunter\"],\"defender\":\"Rifleman with production weight\",\"horizon\":96,\"timeOrigin\":\"contact checkpoint, zero-based ticks; -1 means unobserved or unavailable\",\"grounding\":\"smash/normal grounded; late neutral aerial at attack frame 20, z20, vz-2\",\"facing\":[1,-1],\"stage\":0,\"charge\":0,\"shield\":\"full digital shield held before checkpoint, released afterwards; no powershield\",\"lCancel\":\"one press on first aerial tick with hitlag <=1\",\"DI\":\"neutral, no SDI or ASDI displacement\",\"actionable\":\"canAttack for a normal action; not a universal earliest escape oracle\",\"optionPolicy\":\"jab or forward tilt attempted at normal-ready + delay 0..12; optional approach only during delay; target otherwise neutral\",\"limits\":[\"contact-state experiment, not complete approach safety\",\"strictly earlier contact required; same-tick response is not certified\",\"bounded true links exclude DI/SDI/escape-policy variation\",\"no read or human reaction likelihood inferred\",\"no reference-character equivalence\",\"no native or balance acceptance\"]}")
    for character = 0 to 2
        for spacingIndex = 0 to 1
            let spacing = spacingIndex == 0 ? 60. : 140.
            emitRule(character, spacing)
            for category = 0 to 2
                emitContext(character, category, spacing, 0, true)
                emitContext(character, category, spacing, 0, false)
                emitContext(character, category, spacing, 60, false)
