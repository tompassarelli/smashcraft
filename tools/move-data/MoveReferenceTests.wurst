package MoveReferenceTests
import MoveReference

@Test function referenceJoinPreservesClockAndVariantBoundaries()
    firstActiveDelta(4, 2).assertEquals(3)
    actionFamily(9).assertEquals("ftilt")
    actionFamily(1).assertEquals("")
    joinScope(9, 0).assertEquals("family-only-angle-unknown")
    joinScope(4, 60).assertEquals("family-only-charge-unknown")

@Test function dominanceNeedsEveryDimensionAndObservedReadiness()
    let baseline = contactFact("", 0, "normal", 60, 0, true, true, 28, 27, 7, 0)
    let costlyDamage = contactFact("", 1, "normal", 60, 0, true, true, 38, 34, 12.6, 0)
    let freeDamage = contactFact("", 1, "normal", 60, 0, true, true, 28, 27, 12.6, 0)
    let missing = contactFact("", 1, "normal", 60, 0, true, true, 12, -1, 14, 0)
    let whiff = contactFact("", 1, "normal", 60, 0, true, false, 12, 27, 0, 0)
    tradeoffVerdict(baseline, costlyDamage).assertEquals("tradeoff")
    tradeoffVerdict(baseline, freeDamage).assertEquals("b-dominates-projection")
    tradeoffVerdict(freeDamage, baseline).assertEquals("a-dominates-projection")
    tradeoffVerdict(baseline, baseline).assertEquals("equal-projection")
    tradeoffVerdict(baseline, missing).assertEquals("readiness-unobserved")
    tradeoffVerdict(baseline, whiff).assertEquals("contact-unavailable")
