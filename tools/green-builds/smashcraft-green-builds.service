[Unit]
Description=Install the newest green Smashcraft main under Maps/00-Smashcraft
Documentation=https://github.com/tompassarelli/smashcraft/blob/main/docs/commands/play.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
Environment=PATH=%h/.bun/bin:%h/.nix-profile/bin:/etc/profiles/per-user/%u/bin:/run/current-system/sw/bin:/usr/local/bin:/usr/bin:/bin
Environment=RUNNER=%h/code/smashcraft/worktrees/green-builds-runner
ExecStartPre=/usr/bin/env git -C %h/code/smashcraft/main fetch -q origin main
ExecStartPre=/bin/sh -c 'test -d "$RUNNER" || git -C %h/code/smashcraft/main worktree add -q --detach "$RUNNER" origin/main'
ExecStartPre=/bin/sh -c 'git -C "$RUNNER" checkout -q --detach origin/main && cd "$RUNNER/ts" && bun install --frozen-lockfile'
WorkingDirectory=%h/code/smashcraft
ExecStart=/bin/sh -c 'cd "$RUNNER/ts" && exec bun wisp play --install-green'
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=45min
