package FighterPlaybackProbe
import Wurst
import FighterAssets
import UnitObjEditing
import FighterContactPoseInfo

@compiletime function defineContactPose()
    let contact = new UnitDefinition('mpc1', 'earc')
    contact.setModelFile(CONTACT_MODEL)
    contact.setModelFileExtraVersions(0)
    contact.setScalingValue(1.)
    contact.setAnimationBlendTimeseconds(0.)

unit array[3] models
framehandle status
int service = 0
real centerX
real centerY

function tick()
    let frame = service mod 180
    if frame == 0
        for i = 0 to 2
            SetUnitAnimationByIndex(models[i], i == 0 ? ARCHER_UP_TILT_INDEX : 0)
            SetUnitTimeScale(models[i], i == 0 ? 2.5 : 0.)
    status.setText("FIGHTER CONTACT POSE PROBE | service " + I2S(service) + " | cycle " + I2S(frame) + "\nLeft: unchanged model. Middle/right: authored contact held, opposite facings. Models enlarged 2x.\nLeft plays the full clip at the gameplay rate (2.5x). Cycle restarts after 180 callbacks. No combat runs.")
    service++

function setup()
    DestroyTimer(GetExpiredTimer())
    centerX = GetRectCenterX(bj_mapInitialPlayableArea)
    centerY = GetRectCenterY(bj_mapInitialPlayableArea)
    FogEnable(false)
    FogMaskEnable(false)
    BlzHideOriginFrames(true)
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1200, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1120, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(centerX, centerY)
    for i = 0 to 2
        models[i] = CreateUnit(Player(0), i == 0 ? ARCHER_FIGHTER_ID : 'mpc1', centerX + (i - 1) * 240, centerY, 0.)
        SetUnitScale(models[i], 2., 2., 2.)
        if i == 2
            SetUnitFacing(models[i], 180.)
        SetUnitInvulnerable(models[i], true)
        SetUnitPathing(models[i], false)
        UnitAddAbility(models[i], 'Amrf')
        UnitRemoveAbility(models[i], 'Amrf')
        UnitAddAbility(models[i], 'Aloc')
        PauseUnit(models[i], true)
        SetUnitBlendTime(models[i], 0.)
        SetUnitFlyHeight(models[i], 1000., 0.)
    status = createTextFrame("SCFighterPlayback", GAME_UI, 955)
    status.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.02, 0.58)
    status.setSize(0.76, 0.12)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
