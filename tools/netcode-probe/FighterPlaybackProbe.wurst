package FighterPlaybackProbe
import Wurst
import FighterAssets

unit array[3] models
framehandle status
int service = 0
real centerX
real centerY

function tick()
    let frame = service mod 180
    if frame == 0
        for i = 0 to 2
            SetUnitAnimationByIndex(models[i], ARCHER_UP_TILT_INDEX)
            SetUnitTimeScale(models[i], i == 0 ? 1. : ARCHER_UP_TILT_SECONDS / (29. / 60.))
    // Source contact is frame 6 at 24 FPS: .25 seconds into the clip.
    if frame == 15
        SetUnitTimeScale(models[0], 0.)
    if frame == 6
        SetUnitTimeScale(models[1], 0.)
    status.setText("FIGHTER PLAYBACK PROBE | service " + I2S(service) + " | cycle " + I2S(frame) + "\nArcher Up Tilt index " + I2S(ARCHER_UP_TILT_INDEX) + "\nLeft: 1x, freeze at .25s. Middle: gameplay rate, freeze after 6 callbacks. Right: gameplay rate, full clip.\nEach cycle restarts after 180 callbacks. No combat simulation runs.")
    service++

function setup()
    DestroyTimer(GetExpiredTimer())
    centerX = GetRectCenterX(bj_mapInitialPlayableArea)
    centerY = GetRectCenterY(bj_mapInitialPlayableArea)
    FogEnable(false)
    FogMaskEnable(false)
    BlzHideOriginFrames(true)
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1200, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1120, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(centerX, centerY)
    for i = 0 to 2
        models[i] = CreateUnit(Player(0), ARCHER_FIGHTER_ID, centerX + (i - 1) * 240, centerY, 0.)
        SetUnitInvulnerable(models[i], true)
        SetUnitPathing(models[i], false)
        UnitAddAbility(models[i], 'Amrf')
        UnitRemoveAbility(models[i], 'Amrf')
        UnitAddAbility(models[i], 'Aloc')
        PauseUnit(models[i], true)
        SetUnitBlendTime(models[i], 0.)
        SetUnitFlyHeight(models[i], 1000., 0.)
    status = createTextFrame("SCFighterPlayback", GAME_UI, 955)
    status.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.02, 0.58)
    status.setSize(0.76, 0.12)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
