package VocabularyCorpusTests
import VocabularyProbeCorpus
import InputProtocol
import NetworkInput
import JournalInputSource

@Test function exportAndValidateVocabularyCorpus()
    let encoder = new VocabularyProbeEncoder()
    let decoder = new InputPacket()
    let row = new NetworkInput()
    let expected = new NetworkInput()
    let journal = new JournalInputSource()
    for sender = 0 to 1
        for arm = 0 to 5
            journal.beginEpoch("vocabulary-corpus", VOCABULARY_PROBE_EPOCH, sender, 0).assertTrue()
            for seq = 0 to VOCABULARY_PROBE_SAMPLES - 1
                let wire = encoder.encode(sender, arm, seq)
                journal.decode(wire, 600).assertEquals(JOURNAL_READY)
                decoder.decode(wire).assertTrue()
                decoder.encode().assertEquals(wire)
                decoder.firstFrameNumber().assertEquals(vocabularyProbeFrame(arm, seq))
                decoder.recordCount().assertEquals(vocabularyProbeRows(arm))
                for record = 0 to decoder.recordCount() - 1
                    decoder.copyRecord(record, row).assertTrue()
                    vocabularyProbeRow(sender, decoder.firstFrameNumber() + record, expected).assertTrue()
                    row.sameAs(expected).assertTrue()
                journal.submitted().assertTrue()
                if arm mod 3 != 0
                    println("VOCABULARY_CORPUS " + I2S(sender) + " " + I2S(arm) + " " + I2S(seq) + " " + wire)
    println("VOCABULARY_ALPHABET " + INPUT_ALPHABET)
    println("VOCABULARY_MAX_BYTES " + I2S(INPUT_HEADER_MAX_BYTES + 2 * INPUT_MAX_RECORD_BYTES))
