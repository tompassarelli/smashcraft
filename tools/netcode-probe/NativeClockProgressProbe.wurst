package NativeClockProgressProbe

import Wurst
import ProbeInfo

constant int CALLBACKS_PER_MARKER = 6
constant int TOTAL_CALLBACKS = 300
constant int TOTAL_MARKERS = 50

timer nativeClock
timer serviceTimer
int callbackIndex = 0
real previousMarkerMs = 0.

function localSlot() returns int
    return GetPlayerId(GetLocalPlayer())

function nativeMs() returns real
    return TimerGetElapsed(nativeClock) * 1000.

function padSequence(int sequence) returns string
    var digits = I2S(sequence)
    while digits.length() < 6
        digits = "0" + digits
    return digits

function writeMarker(int sequence, real nowMs, real deltaMs)
    PreloadGenClear()
    PreloadGenStart()
    Preload("WC3_NATIVE_CLOCK_MARKER v=1 build=" + CLOCK_BUILD
        + " slot=" + I2S(localSlot())
        + " sequence=" + I2S(sequence)
        + " callback=" + I2S(callbackIndex)
        + " native_ms=" + R2S(nowMs)
        + " previous_marker_delta_ms=" + R2S(deltaMs)
        + " clock=TimerGetElapsed(nativeClock)")
    let phase = sequence == TOTAL_MARKERS ? "complete" : "progress"
    Preload("phase=" + phase)
    PreloadGenEnd("smashcraft-native-clock-progress-" + CLOCK_BUILD
        + "-p" + I2S(localSlot()) + "-" + padSequence(sequence) + ".txt")

function tick()
    callbackIndex++
    if callbackIndex mod CALLBACKS_PER_MARKER != 0
        return
    let sequence = callbackIndex div CALLBACKS_PER_MARKER
    let currentMs = nativeMs()
    writeMarker(sequence, currentMs, currentMs - previousMarkerMs)
    previousMarkerMs = currentMs
    if callbackIndex >= TOTAL_CALLBACKS
        PauseTimer(GetExpiredTimer())

function setup()
    DestroyTimer(GetExpiredTimer())
    nativeClock = CreateTimer()
    TimerStart(nativeClock, 3600., false, null)
    previousMarkerMs = nativeMs()

    serviceTimer = CreateTimer()
    TimerStart(serviceTimer, 1. / 60., true, function tick)

    PreloadGenClear()
    PreloadGenStart()
    Preload("WC3_NATIVE_CLOCK_READY v=1 build=" + CLOCK_BUILD
        + " slot=" + I2S(localSlot())
        + " callback=0 native_ms=" + R2S(previousMarkerMs)
        + " clock=TimerGetElapsed(nativeClock)")
    Preload("service=60Hz marker_every=6_callbacks total_callbacks=300 total_markers=50 delta_baseline=ready_time observer_local_only=no_cross_client_subtraction")
    PreloadGenEnd("smashcraft-native-clock-progress-" + CLOCK_BUILD
        + "-p" + I2S(localSlot()) + "-ready.txt")

init
    TimerStart(CreateTimer(), 0., false, function setup)
