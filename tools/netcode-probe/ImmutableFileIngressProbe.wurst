package ImmutableFileIngressProbe

import Wurst
import FileIO
import ProbeInfo

constant int MAX_ROWS = 64
string array[MAX_ROWS] rows
int rowCount = 0
int retryAttempts = 0
int sequenceIndex = 0
int callbackCount = 0
int syncReceived = 0
int uniqueMatches = 0
boolean retryDelivered = false
timer gameClock

function retryFilename() returns string
    return "smashcraft-ingress-" + INGRESS_BUILD_ID + "-retry.pld"

function sequenceFilename(int index) returns string
    return "smashcraft-ingress-" + INGRESS_BUILD_ID + "-00000" + I2S(index + 2) + ".pld"

function expectedValue(int index) returns string
    if index == 0
        return "V1|000002|000000|000002|0;"
    if index == 1
        return "V1|000003|000000|000003|1;"
    return "V1|000004|000000|000004|0;"

function clockMs() returns string
    return R2S(TimerGetElapsed(gameClock) * 1000.)

function readLocal(string filename) returns string
    let file = new File(filename)
    let contents = file.readAsString(GetLocalPlayer())
    destroy file
    return contents

function record(string kind, int attempt, string filename, string value, string expected)
    if rowCount < MAX_ROWS
        rows[rowCount] = kind + " slot=" + I2S(GetPlayerId(GetLocalPlayer()))
            + " attempt=" + I2S(attempt) + " game_ms=" + clockMs()
            + " file=" + filename + " data=" + value + " expected=" + expected
        rowCount++

function sendRead(string kind, int sequence, string value)
    let wire = "IF1|" + kind + "|" + I2S(sequence) + "|" + value
    let ok = GetLocalPlayer().sendSyncData("IF1", wire)
    record("SYNC_TX", sequence, kind, wire, ok ? "queued" : "rejected")

function receiveRead()
    syncReceived++
    record("SYNC_RX sender=" + I2S(GetPlayerId(GetTriggerPlayer())), syncReceived,
        "IF1", BlzGetTriggerSyncData(), "exact sender-tagged file data")

function export(string phase)
    PreloadGenClear()
    PreloadGenStart()
    Preload("IMMUTABLE_FILE_INGRESS v=1 build=" + INGRESS_BUILD_ID
        + " version=0.0.14 slot=" + I2S(GetPlayerId(GetLocalPlayer()))
        + " phase=" + phase + " callbacks=" + I2S(callbackCount)
        + " retry_attempts=" + I2S(retryAttempts)
        + " unique_files_read=" + I2S(sequenceIndex)
        + " unique_matches=" + I2S(uniqueMatches)
        + " retry_delivered=" + (retryDelivered ? "1" : "0")
        + " sync_received=" + I2S(syncReceived))
    Preload("FileIO pinned stdlib bb1e0458db5a372ba2a6928112452785e435d01a")
    for i = 0 to rowCount - 1
        Preload(rows[i])
    PreloadGenEnd("smashcraft-immutable-ingress-" + INGRESS_BUILD_ID
        + "-p" + I2S(GetPlayerId(GetLocalPlayer())) + ".txt")

function poll()
    callbackCount++

    // Deliberately retry the exact filename whose first read occurred before
    // host publication. This directly tests negative-result filename caching.
    retryAttempts++
    let retryPath = retryFilename()
    let retryValue = readLocal(retryPath)
    let retryExpected = "V1|000001|000000|000001|1;"
    record("RETRY", retryAttempts, retryPath, retryValue, retryExpected)
    if retryValue == retryExpected and not retryDelivered
        retryDelivered = true
        sendRead("RETRY", 1, retryValue)

    // These three immutable files must already exist before their first read.
    // Each distinct filename is consumed once, in order, without focus changes.
    if sequenceIndex < 3
        let filename = sequenceFilename(sequenceIndex)
        let value = readLocal(filename)
        let expected = expectedValue(sequenceIndex)
        record("UNIQUE", sequenceIndex + 1, filename, value, expected)
        if value == expected
            uniqueMatches++
            sendRead("UNIQUE", sequenceIndex + 2, value)
        sequenceIndex++

    export("poll")
    if callbackCount >= 40
        export("complete")
        PauseTimer(GetExpiredTimer())

function setup()
    gameClock = CreateTimer()
    TimerStart(gameClock, 3600., false, null)

    let retryPath = retryFilename()
    let initialValue = readLocal(retryPath)
    record("INITIAL_MISSING_READ", 1, retryPath, initialValue, "")
    export("ready_create_retry_file_now")

    let receiver = CreateTrigger()
    BlzTriggerRegisterPlayerSyncEvent(receiver, Player(0), "IF1", false)
    BlzTriggerRegisterPlayerSyncEvent(receiver, Player(1), "IF1", false)
    TriggerAddAction(receiver, function receiveRead)

    let pollTimer = CreateTimer()
    TimerStart(pollTimer, 0.25, true, function poll)

init
    TimerStart(CreateTimer(), 0., false, function setup)
