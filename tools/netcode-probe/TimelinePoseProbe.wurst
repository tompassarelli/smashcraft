package TimelinePoseProbe
import Wurst
import PoseFixtureInfo

effect reference
effect candidate
framehandle status
int service = 0
int previousPhase = -1

function tick()
    service++
    if service == 30
        BlzSetSpecialEffectTime(reference, 2.3)
    let phase = min(8, service div 180)
    if phase != previousPhase
        previousPhase = phase
        if phase == 1 or phase == 5 or phase == 8
            BlzSetSpecialEffectTime(candidate, 2.3)
        else if phase == 2
            BlzSetSpecialEffectTime(candidate, 4.3)
        else if phase == 3
            BlzSetSpecialEffectTime(candidate, 2.5)
        else if phase == 4
            BlzSetSpecialEffectTime(candidate, 4.5)
        else if phase == 7
            BlzSetSpecialEffectTime(candidate, 2.8)
            BlzSetSpecialEffectTime(candidate, 4.9)
            BlzSetSpecialEffectTime(candidate, 2.3)
    if phase == 6
        BlzSetSpecialEffectTime(candidate, 2.3)
    status.setText("SINGLE TIMELINE | S " + I2S(service) + " | phase " + I2S(phase) + "\nBoth models: one nonlooping Stand interval 0..5000ms; playback frozen. No clip switching.\nLeft: held at 2.3s (z=60). Right expected: 1 z60, 2 x60, 3 z100, 4 x100, 5 z60.\n6: seek z60 every tick; 7: three seeks in one callback ending at z60; 8: z60. Ctrl+R reloads.")

function restart()
    if GetTriggerPlayer() == Player(0)
        RestartGame(false)

function setup()
    DestroyTimer(GetExpiredTimer())
    let x = GetRectCenterX(bj_mapInitialPlayableArea)
    let y = GetRectCenterY(bj_mapInitialPlayableArea)
    FogEnable(false)
    FogMaskEnable(false)
    BlzHideOriginFrames(true)
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1200, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1120, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(x, y)
    reference = AddSpecialEffect(POSE_FIXTURE_MODEL, x - 220, y)
    candidate = AddSpecialEffect(POSE_FIXTURE_MODEL, x + 100, y)
    BlzSetSpecialEffectZ(reference, 1000.)
    BlzSetSpecialEffectZ(candidate, 1000.)
    BlzSetSpecialEffectAnimationBlendTime(reference, 0.)
    BlzSetSpecialEffectAnimationBlendTime(candidate, 0.)
    BlzSetSpecialEffectAnimation(reference, "Stand")
    BlzSetSpecialEffectAnimation(candidate, "Stand")
    BlzSetSpecialEffectTimeScale(reference, 0.)
    BlzSetSpecialEffectTimeScale(candidate, 0.)
    status = createTextFrame("SCTimelinePose", GAME_UI, 952)
    status.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.02, 0.58)
    status.setSize(0.76, 0.12)
    let keys = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(keys, Player(0), OSKEY_R, 2, true)
    TriggerAddAction(keys, function restart)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
