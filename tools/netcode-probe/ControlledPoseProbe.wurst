package ControlledPoseProbe
import Wurst

effect reference
effect candidate
framehandle status
int service = 0
int previousPhase = -1

function tick()
    service++
    if service == 18
        BlzSetSpecialEffectTimeScale(reference, 0.)
    let phase = min(9, service div 180)
    if phase != previousPhase
        previousPhase = phase
        if phase == 1 or phase == 7 or phase == 9
            BlzSetSpecialEffectTime(candidate, 0.3)
        else if phase == 2 or phase == 6
            if phase == 6
                BlzSetSpecialEffectAnimation(candidate, "Attack")
            BlzSetSpecialEffectTime(candidate, 2.3)
        else if phase == 3
            BlzSetSpecialEffectTime(candidate, 0.)
        else if phase == 4
            BlzSetSpecialEffectAnimation(candidate, "Walk")
            BlzSetSpecialEffectTime(candidate, 0.3)
        else if phase == 5
            BlzSetSpecialEffectTime(candidate, 4.3)
        else if phase == 8
            BlzSetSpecialEffectTime(candidate, 0.5)
    status.setText("CONTROLLED POSE | S " + I2S(service) + " | phase " + I2S(phase) + "\nLeft: natural Attack frozen near .3s. Right: seek candidate. White marks z=0,60,100,200.\nAttack interval 2000..3000ms, marker z=0..200. Walk 4000..5000ms, marker x=0..200.\nPhases: 1 .3; 2 2.3; 3 zero; 4 Walk+.3; 5 4.3; 6 Attack+2.3; 7 .3; 8 .5; 9 .3. Ctrl+R reloads.")

function restart()
    if GetTriggerPlayer() == Player(0)
        RestartGame(false)

function setup()
    DestroyTimer(GetExpiredTimer())
    let x = GetRectCenterX(bj_mapInitialPlayableArea)
    let y = GetRectCenterY(bj_mapInitialPlayableArea)
    FogEnable(false)
    FogMaskEnable(false)
    BlzHideOriginFrames(true)
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1200, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1120, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(x, y)
    reference = AddSpecialEffect("war3mapImported\\PoseFixture.mdx", x - 220, y)
    candidate = AddSpecialEffect("war3mapImported\\PoseFixture.mdx", x + 100, y)
    BlzSetSpecialEffectZ(reference, 1000.)
    BlzSetSpecialEffectZ(candidate, 1000.)
    BlzSetSpecialEffectAnimationBlendTime(reference, 0.)
    BlzSetSpecialEffectAnimationBlendTime(candidate, 0.)
    BlzSetSpecialEffectAnimation(reference, "Attack")
    BlzSetSpecialEffectAnimation(candidate, "Attack")
    BlzSetSpecialEffectTimeScale(reference, 1.)
    BlzSetSpecialEffectTimeScale(candidate, 0.)
    status = createTextFrame("SCControlledPose", GAME_UI, 951)
    status.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.02, 0.58)
    status.setSize(0.76, 0.12)
    let keys = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(keys, Player(0), OSKEY_R, 2, true)
    TriggerAddAction(keys, function restart)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
