package LiveImmutableIngressProbe

import Wurst
import FileIO
import FrameTaggedRecord
import ProbeInfo

constant int POLL_HZ = 60
constant int EXPECTED_RECORDS = 10
constant int DRAIN_LIMIT = 16
constant int ROW_CAP = 32
constant string SYNC_PREFIX = "LI1"

EventLedger localLedger
EventLedger receivedZero
EventLedger receivedOne
TaggedEvent parsed
string array[16] localRows
string array[32] syncRows
int localCount = 0
int syncCount = 0
int cursor = 1
int callbacks = 0
int readAttempts = 0
int missingReads = 0
int invalidRecords = 0
int sendFailures = 0
int receiveErrors = 0
boolean completeWritten = false
timer nativeClock

function slot() returns int
    return GetPlayerId(GetLocalPlayer())

function filename(int sequence) returns string
    var digits = I2S(sequence)
    while digits.length() < 6
        digits = "0" + digits
    return "smashcraft-live-ingress-" + LIVE_INGRESS_BUILD + "-" + digits + ".pld"

function nativeMs() returns string
    return R2S(TimerGetElapsed(nativeClock) * 1000.)

function readLocal(string path) returns string
    let file = new File(path)
    let contents = file.readAsString(GetLocalPlayer())
    destroy file
    return contents

function export(string phase)
    PreloadGenClear()
    PreloadGenStart()
    Preload("LIVE_INGRESS_" + phase + " v=1 build=" + LIVE_INGRESS_BUILD
        + " version=0.0.15 slot=" + I2S(slot())
        + " callbacks=" + I2S(callbacks)
        + " local_unique=" + I2S(localLedger.size())
        + " sync_p0_unique=" + I2S(receivedZero.size())
        + " sync_p1_unique=" + I2S(receivedOne.size())
        + " read_attempts=" + I2S(readAttempts)
        + " missing_reads=" + I2S(missingReads)
        + " invalid_records=" + I2S(invalidRecords)
        + " send_failures=" + I2S(sendFailures)
        + " receive_errors=" + I2S(receiveErrors)
        + " errors=" + I2S(invalidRecords + sendFailures + receiveErrors))
    Preload("native clock is Warcraft TimerGetElapsed; read_begin/read_end bracket FileIO only; elapsed_us and frame are publisher-provided host-monotonic tags, not cross-clock delays")
    Preload("LOCAL callback sequence read_begin_native_ms read_end_native_ms id elapsed_us frame action exact_wire")
    for i = 0 to localCount - 1
        Preload(localRows[i])
    Preload("SYNC callback receive_native_ms sender id elapsed_us frame action exact_wire")
    for i = 0 to syncCount - 1
        Preload(syncRows[i])
    PreloadGenEnd("smashcraft-live-ingress-" + LIVE_INGRESS_BUILD
        + "-p" + I2S(slot()) + "-" + phase + ".txt")

function checkComplete()
    if completeWritten or callbacks < 300
        return
    if invalidRecords != 0 or sendFailures != 0 or receiveErrors != 0
        return
    if localLedger.size() != EXPECTED_RECORDS
        return
    if receivedZero.size() != EXPECTED_RECORDS or receivedOne.size() != EXPECTED_RECORDS
        return
    completeWritten = true
    export("complete")

function poll()
    callbacks++
    var drained = 0
    while drained < DRAIN_LIMIT and cursor <= EXPECTED_RECORDS
        readAttempts++
        let readBegin = nativeMs()
        let path = filename(cursor)
        let wire = readLocal(path)
        let readEnd = nativeMs()
        if wire == ""
            missingReads++
            break

        if not parsed.decode(wire) or parsed.id() != cursor
            invalidRecords++
            break

        let sent = GetLocalPlayer().sendSyncData(SYNC_PREFIX, parsed.exactWire())
        if not sent
            sendFailures++
            break

        let outcome = localLedger.observe(parsed.exactWire())
        if outcome != RECORD_ADDED
            invalidRecords++
            break

        localRows[localCount] = "L callback=" + I2S(callbacks)
            + " sequence=" + I2S(cursor)
            + " read_begin_native_ms=" + readBegin
            + " read_end_native_ms=" + readEnd
            + " id=" + I2S(parsed.id())
            + " elapsed_us=" + I2S(parsed.elapsedMicroseconds())
            + " frame=" + I2S(parsed.frame())
            + " action=" + I2S(parsed.state())
            + " wire=" + parsed.exactWire()
        localCount++
        cursor++
        drained++
    checkComplete()

function receiveSync()
    let sender = GetPlayerId(GetTriggerPlayer())
    let wire = BlzGetTriggerSyncData()
    var outcome = RECORD_INVALID
    if parsed.decode(wire)
        if sender == 0
            outcome = receivedZero.observe(parsed.exactWire())
        else if sender == 1
            outcome = receivedOne.observe(parsed.exactWire())
    if outcome != RECORD_ADDED
        receiveErrors++
    if syncCount < ROW_CAP
        var detail = ""
        if parsed.decode(wire)
            detail = " id=" + I2S(parsed.id())
                + " elapsed_us=" + I2S(parsed.elapsedMicroseconds())
                + " frame=" + I2S(parsed.frame())
                + " action=" + I2S(parsed.state())
        syncRows[syncCount] = "R callback=" + I2S(callbacks)
            + " receive_native_ms=" + nativeMs()
            + " sender=" + I2S(sender)
            + " result=" + I2S(outcome)
            + detail + " wire=" + wire
        syncCount++
    checkComplete()

function setup()
    DestroyTimer(GetExpiredTimer())
    localLedger = new EventLedger()
    receivedZero = new EventLedger()
    receivedOne = new EventLedger()
    parsed = new TaggedEvent()
    nativeClock = CreateTimer()
    TimerStart(nativeClock, 3600., false, null)

    let receiver = CreateTrigger()
    BlzTriggerRegisterPlayerSyncEvent(receiver, Player(0), SYNC_PREFIX, false)
    BlzTriggerRegisterPlayerSyncEvent(receiver, Player(1), SYNC_PREFIX, false)
    TriggerAddAction(receiver, function receiveSync)

    let pollTimer = CreateTimer()
    TimerStart(pollTimer, 1. / POLL_HZ, true, function poll)

    PreloadGenClear()
    PreloadGenStart()
    Preload("LIVE_INGRESS_READY v=1 build=" + LIVE_INGRESS_BUILD
        + " version=0.0.15 slot=" + I2S(slot())
        + " poll_hz=60 record_bytes=26 first_sequence=1 last_sequence=10")
    Preload("files=smashcraft-live-ingress-<BUILD>-000001.pld through -000010.pld; absent read does not advance the sequence cursor; publisher frame/time are preserved")
    PreloadGenEnd("smashcraft-live-ingress-" + LIVE_INGRESS_BUILD
        + "-p" + I2S(slot()) + "-ready.txt")

init
    TimerStart(CreateTimer(), 0., false, function setup)
