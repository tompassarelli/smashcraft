package FrameTaggedRecordTests
import FrameTaggedRecord

@Test function frameTaggedRecordPreservesFieldsAndRejectsIncompleteSuffix()
    let parsedRecord = new TaggedEvent()
    parsedRecord.decode("V1|000123|016666|000001|0;").assertTrue()
    parsedRecord.id().assertEquals(123)
    parsedRecord.elapsedMicroseconds().assertEquals(16666)
    parsedRecord.frame().assertEquals(1)
    parsedRecord.state().assertEquals(0)
    parsedRecord.exactWire().assertEquals("V1|000123|016666|000001|0;")
    parsedRecord.decode("V1|000124|016667|000002|1").assertFalse()

@Test function frameTaggedRecordRejectsWrongVersionSeparatorsAndAction()
    let parsedRecord = new TaggedEvent()
    parsedRecord.decode("V0|000123|016666|000001|1;").assertFalse()
    parsedRecord.decode("V1|00012x|016666|000001|1;").assertFalse()
    parsedRecord.decode("V1|000123/016666|000001|1;").assertFalse()
    parsedRecord.decode("V1|000123|016666|000001|2;").assertFalse()

@Test function ledgerSendsUniqueIdsOnceAndDetectsDuplicateConflictAndOverflow()
    let ledger = new EventLedger()
    let first = "V1|000123|016666|000001|1;"
    ledger.observe(first).assertEquals(RECORD_ADDED)
    ledger.observe(first).assertEquals(RECORD_DUPLICATE)
    ledger.observe("V1|000123|016667|000002|1;").assertEquals(RECORD_CONFLICT)
    ledger.observe("malformed").assertEquals(RECORD_INVALID)
    ledger.size().assertEquals(1)
    ledger.duplicateCount().assertEquals(1)
    ledger.conflictCount().assertEquals(1)
    for i = 1 to LEDGER_CAPACITY
        let id = I2S(i)
        let padded = "000000".substring(0, 6 - id.length()) + id
        if i < LEDGER_CAPACITY
            ledger.observe("V1|" + padded + "|016666|000001|0;").assertEquals(RECORD_ADDED)
    ledger.observe("V1|999999|016666|000001|0;").assertEquals(RECORD_OVERFLOW)
    ledger.overflowCount().assertEquals(1)
