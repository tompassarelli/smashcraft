package PoseProbe
import Wurst

effect array[4] models
framehandle status
int service = 0
int previousPhase = -1
real centerX
real centerY

function camera()
    SetCameraField(CAMERA_FIELD_ROTATION, 90, 0)
    SetCameraField(CAMERA_FIELD_ANGLE_OF_ATTACK, 350, 0)
    SetCameraField(CAMERA_FIELD_TARGET_DISTANCE, 1450, 0)
    SetCameraField(CAMERA_FIELD_ZOFFSET, 1100, 0)
    SetCameraField(CAMERA_FIELD_FIELD_OF_VIEW, 70, 0)
    SetCameraField(CAMERA_FIELD_FARZ, 8000, 0)
    SetCameraPosition(centerX, centerY)

function tick()
    service++
    camera()
    // Reference plays naturally for eighteen callbacks before freezing.
    if service == 18
        BlzSetSpecialEffectTimeScale(models[0], 0.)
    let phase = min(6, service div 180)
    if phase != previousPhase
        previousPhase = phase
        if phase == 1
            BlzSetSpecialEffectTime(models[1], 0.3)
            BlzSetSpecialEffectTime(models[2], 300.)
        else if phase == 2
            BlzSetSpecialEffectTime(models[1], 0.)
            BlzSetSpecialEffectTime(models[2], 0.)
        else if phase == 3
            BlzSetSpecialEffectTime(models[1], 0.5)
            BlzSetSpecialEffectTime(models[2], 500.)
        else if phase == 4
            BlzSetSpecialEffectTime(models[1], 0.3)
            BlzSetSpecialEffectTime(models[2], 300.)
        else if phase == 5
            BlzSetSpecialEffectAnimation(models[1], "Walk")
            BlzSetSpecialEffectAnimation(models[2], "Walk")
            BlzSetSpecialEffectTime(models[1], 0.3)
            BlzSetSpecialEffectTime(models[2], 300.)
        else if phase == 6
            BlzSetSpecialEffectAnimation(models[1], "Attack")
            BlzSetSpecialEffectAnimation(models[2], "Attack")
            BlzSetSpecialEffectTime(models[1], 0.3)
            BlzSetSpecialEffectTime(models[2], 0.3)
    if service == 1081
        BlzSetSpecialEffectTime(models[2], 0.3)
    status.setText("POSE PROBE | S " + I2S(service) + " | phase " + I2S(phase) + "\nLeft: natural attack frozen at callback 18. Middle: SetTime seconds / milliseconds (phase 6: immediate / next callback).\nPhases: 0 initial, 1 seek .3/300, 2 seek zero, 3 seek .5/500, 4 rewind .3/300, 5 walk+seek, 6 attack+seek. Right: live walk.\nN restarts the sequence. Ctrl+R reloads map. No native units or runtime handle allocation.")
    if BlzIsKeyPressed(OSKEY_N)
        service = 0
        previousPhase = -1
        for i = 0 to 2
            BlzSetSpecialEffectAnimation(models[i], "Attack")
            BlzSetSpecialEffectTimeScale(models[i], i == 0 ? 1. : 0.)

function restart()
    if GetTriggerPlayer() == Player(0)
        RestartGame(false)

function setup()
    DestroyTimer(GetExpiredTimer())
    centerX = GetRectCenterX(bj_mapInitialPlayableArea)
    centerY = GetRectCenterY(bj_mapInitialPlayableArea)
    FogEnable(false)
    FogMaskEnable(false)
    BlzHideOriginFrames(true)
    // Allocate identically; only model pose/transform updates are local candidates.
    for i = 0 to 3
        models[i] = AddSpecialEffect("units\\human\\Rifleman\\Rifleman.mdl", centerX + (i * 300 - 450), centerY)
    status = createTextFrame("SCPoseProbe", GAME_UI, 950)
    status.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.02, 0.58)
    status.setSize(0.76, 0.12)
    for i = 0 to 3
        BlzSetSpecialEffectPosition(models[i], centerX + (i * 300 - 450), centerY, 1000.)
        BlzSetSpecialEffectScale(models[i], 2.)
        BlzSetSpecialEffectYaw(models[i], GetPlayerId(GetLocalPlayer()) == 0 ? 0. : 3.141592654)
        BlzSetSpecialEffectAnimationBlendTime(models[i], 0.)
        BlzSetSpecialEffectAnimation(models[i], i == 3 ? "Walk" : "Attack")
        BlzSetSpecialEffectTimeScale(models[i], i == 1 or i == 2 ? 0. : 1.)
    let keys = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(keys, Player(0), OSKEY_R, 2, true)
    TriggerAddAction(keys, function restart)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
