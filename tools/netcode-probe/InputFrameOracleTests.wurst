package InputFrameOracleTests
import InputFrameOracle

@Test function nanosecondBoundariesUseCaptureTimeAndHalfOpenIntervals()
    captureFrameFromElapsed(0, 0, 0).assertEquals(1)
    captureFrameFromElapsed(0, 16666666, 0).assertEquals(1)
    captureFrameFromElapsed(0, 16666667, 0).assertEquals(2)
    captureFrameFromElapsed(0, 33333333, 0).assertEquals(2)
    captureFrameFromElapsed(0, 33333334, 0).assertEquals(3)
    captureFrameFromElapsed(0, 49999999, 0).assertEquals(3)
    captureFrameFromElapsed(0, 50000000, 0).assertEquals(4)
    captureFrameFromElapsed(0, 999999999, 0).assertEquals(60)
    captureFrameFromElapsed(1, 0, 0).assertEquals(61)

@Test function intentionalDelayShiftsEveryBoundaryEqually()
    captureFrameFromElapsed(0, 16666666, 3).assertEquals(4)
    captureFrameFromElapsed(0, 16666667, 3).assertEquals(5)
    captureFrameFromElapsed(10, 999999999, 3).assertEquals(663)

@Test function invalidOrOverflowingTimesFailWithoutWrapping()
    captureFrameFromElapsed(-1, 0, 0).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(0, -1, 0).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(0, 1000000000, 0).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(0, 0, -1).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(35791394, 0, 0).assertEquals(2147483641)
    captureFrameFromElapsed(35791394, 83333333, 0).assertEquals(LAST_CAPTURE_FRAME - 1)
    captureFrameFromElapsed(35791394, 83333334, 0).assertEquals(LAST_CAPTURE_FRAME)
    captureFrameFromElapsed(35791394, 100000000, 0).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(35791395, 0, 0).assertEquals(INVALID_CAPTURE_FRAME)
    captureFrameFromElapsed(0, 0, LAST_CAPTURE_FRAME).assertEquals(INVALID_CAPTURE_FRAME)
