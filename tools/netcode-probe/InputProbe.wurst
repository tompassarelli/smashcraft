package InputProbe
import Wurst
import ProbeInfo

constant string PREFIX = "SC_P0"
constant int HISTORY = 256
constant int TRACE_CAPACITY = 2048
constant string PADDING = "...................................................................................................................................................................................."
int service = 0
int completed = 0
int array[2] frontier
int array[2] packets
int array[2] rows
int array[2] lastArrival
int array[2] maximumAge
int array[2] duplicates
int array[2] reordered
int array[2] conflicts
int array[2] invalid
int array[2] rawEvents
int array[2] effectiveEvents
int array[512] acceptedFrame
int array[512] acceptedMask
boolean array[6] eventHeld
boolean array[2] competitor
framehandle header
framehandle pollingLine
framehandle eventsLine
framehandle receiptsLine
framehandle detailsLine

// Client-local diagnostics only. None of these values advances the common gate.
int localMask = 0
int priorMask = 0
int localEdges = 0
int sent = 0
int sendFailures = 0
int previousSample = 0
int traceCount = 0
int traceDropped = 0
string array[2048] trace
boolean dumpHeld = false

function record(string message)
    if traceCount < TRACE_CAPACITY
        trace[traceCount] = I2S(service) + " " + message
        traceCount++
    else
        traceDropped++

function field(int value, int width) returns string
    var result = I2S(value)
    while StringLength(result) < width
        result = "0" + result
    return result

function decimal(string text, int width, int maximum) returns int
    if StringLength(text) != width
        return -1
    let value = S2I(text)
    if value < 0 or value > maximum or field(value, width) != text
        return -1
    return value

function receive()
    let slot = GetPlayerId(GetTriggerPlayer())
    if slot < 0 or slot > 1 or not competitor[slot]
        return
    let data = BlzGetTriggerSyncData()
    let first = decimal(SubString(data, 1, 9), 8, 99999999)
    let count = decimal(SubString(data, 9, 10), 1, 2)
    if StringLength(data) != 180 or SubString(data, 0, 1) != "1" or first < 1 or count != PROBE_BATCH or first + count - 1 > service or first > frontier[slot] + HISTORY - count
        invalid[slot]++
        return
    // Validate the complete packet before changing the replicated ledger.
    for i = 0 to count - 1
        if decimal(SubString(data, 10 + i * 3, 13 + i * 3), 3, 127) < 0
            invalid[slot]++
            return
    if SubString(data, 10 + count * 3, 180) != SubString(PADDING, 0, 170 - count * 3)
        invalid[slot]++
        return
    packets[slot]++
    if first < lastArrival[slot]
        reordered[slot]++
    lastArrival[slot] = first
    maximumAge[slot] = max(maximumAge[slot], service - first)
    for i = 0 to count - 1
        let frame = first + i
        let mask = decimal(SubString(data, 10 + i * 3, 13 + i * 3), 3, 127)
        let index = slot * HISTORY + frame mod HISTORY
        if acceptedFrame[index] == frame
            duplicates[slot]++
            if acceptedMask[index] != mask
                conflicts[slot]++
        else if frame <= frontier[slot]
            invalid[slot]++
        else
            acceptedFrame[index] = frame
            acceptedMask[index] = mask
            rows[slot]++
    while acceptedFrame[slot * HISTORY + (frontier[slot] + 1) mod HISTORY] == frontier[slot] + 1
        frontier[slot]++
    record("receive p=" + I2S(slot) + " first=" + I2S(first) + " count=" + I2S(count) + " age-service-ticks=" + I2S(service - first))

function keyEvent()
    let slot = GetPlayerId(GetTriggerPlayer())
    let key = BlzGetTriggerPlayerKey()
    let keyIndex = key == OSKEY_N ? 0 : (key == OSKEY_I ? 1 : 2)
    let index = slot * 3 + keyIndex
    let down = BlzGetTriggerPlayerIsKeyDown()
    rawEvents[slot]++
    if eventHeld[index] != down
        effectiveEvents[slot]++
        eventHeld[index] = down
    record("key-event p=" + I2S(slot) + " key=" + I2S(GetHandleId(key)) + " down=" + (down ? "1" : "0") + " meta=" + I2S(BlzGetTriggerPlayerMetaKey()))

function dump()
    PreloadGenClear()
    PreloadGenStart()
    Preload("SMASHCRAFT P0 batch=" + I2S(PROBE_BATCH) + " service=" + I2S(service) + " completed=" + I2S(completed) + " local-player=" + I2S(GetPlayerId(GetLocalPlayer())))
    Preload("Counters are game callbacks, not measured physical latency. sent=" + I2S(sent) + " failures=" + I2S(sendFailures))
    for i = 0 to traceCount - 1
        Preload(trace[i])
    Preload("dropped=" + I2S(traceDropped))
    PreloadGenEnd("smashcraft-native-input-probe.txt")

function sample() returns int
    return (BlzIsKeyPressed(OSKEY_N) ? 1 : 0) + (BlzIsKeyPressed(OSKEY_I) ? 2 : 0) + (BlzIsKeyPressed(OSKEY_A) ? 4 : 0) + (BlzIsMetaKeyPressed(1) ? 8 : 0) + (BlzIsMetaKeyPressed(2) ? 16 : 0) + (BlzIsMetaKeyPressed(4) ? 32 : 0) + (BlzIsMetaKeyPressed(8) ? 64 : 0)

function tick()
    service++
    if service == 1
        PreloadGenClear()
        PreloadGenStart()
        Preload("SMASHCRAFT INPUT PROBE batch=" + I2S(PROBE_BATCH))
        Preload("game-speed-handle=" + I2S(GetHandleId(GetGameSpeed())))
        PreloadGenEnd("smashcraft-input-probe-ready.txt")
    // Only synchronized receipt frontiers can advance this empty R=0 counter.
    var known = service
    var players = 0
    for slot = 0 to 1
        if competitor[slot]
            known = min(known, frontier[slot])
            players++
    if players > 0 and completed < known
        completed++
    localMask = sample()
    if localMask != priorMask
        localEdges++
        record("poll mask=" + I2S(localMask) + " active=" + (BlzIsLocalClientActive() ? "1" : "0"))
        priorMask = localMask
    let localSlot = GetPlayerId(GetLocalPlayer())
    if localSlot >= 0 and localSlot <= 1 and competitor[localSlot] and service <= 99999999
        if service mod PROBE_BATCH == 0
            let first = service - PROBE_BATCH + 1
            var payload = "1" + field(first, 8) + I2S(PROBE_BATCH)
            if PROBE_BATCH == 2
                payload += field(previousSample, 3)
            payload += field(localMask, 3)
            payload += SubString(PADDING, 0, 180 - StringLength(payload))
            sent++
            if not BlzSendSyncData(PREFIX, payload)
                sendFailures++
                record("send-failed first=" + I2S(first))
    previousSample = localMask
    header.setText("INPUT PROBE | batch " + I2S(PROBE_BATCH) + " | S " + I2S(service) + " | empty R=0 frame " + I2S(completed) + " | speed " + I2S(GetHandleId(GetGameSpeed())))
    pollingLine.setText("LOCAL POLL: " + (localMask mod 2 == 1 ? "|cff40ff40N DOWN|r" : "N UP") + " | mask " + I2S(localMask) + " | changes " + I2S(localEdges) + " | active " + (BlzIsLocalClientActive() ? "yes" : "no"))
    eventsLine.setText("SYNC KEY: P1 " + (eventHeld[0] ? "|cff40ff40N DOWN|r" : "N UP") + " P2 " + (eventHeld[3] ? "|cff40ff40N DOWN|r" : "N UP") + " | raw " + I2S(rawEvents[0]) + "/" + I2S(rawEvents[1]) + " edges " + I2S(effectiveEvents[0]) + "/" + I2S(effectiveEvents[1]))
    receiptsLine.setText("SYNC PACKETS: " + I2S(packets[0]) + "/" + I2S(packets[1]) + " | contiguous " + I2S(frontier[0]) + "/" + I2S(frontier[1]) + " | max age (service ticks) " + I2S(maximumAge[0]) + "/" + I2S(maximumAge[1]))
    detailsLine.setText("N / I / A + modifiers. F8 saves this client's bounded trace.\n180 ASCII bytes/packet. Sends " + I2S(sent) + " failed " + I2S(sendFailures) + " | local outstanding rows " + I2S(localSlot >= 0 and localSlot <= 1 ? max(0, service - frontier[localSlot]) : 0) + "\nInvalid " + I2S(invalid[0]) + "/" + I2S(invalid[1]) + " conflicts " + I2S(conflicts[0]) + "/" + I2S(conflicts[1]) + " reorders " + I2S(reordered[0]) + "/" + I2S(reordered[1]) + " dropped trace " + I2S(traceDropped))
    let dumping = BlzIsKeyPressed(OSKEY_F8)
    if dumping and not dumpHeld
        dump()
    dumpHeld = dumping

function label(string name, int context, real y, real height) returns framehandle
    let result = createTextFrame(name, GAME_UI, context)
    result.setAbsPoint(FRAMEPOINT_TOPLEFT, 0.05, y)
    result.setSize(0.7, height)
    return result

function restart()
    if GetTriggerPlayer() == Player(0)
        RestartGame(false)

function setup()
    DestroyTimer(GetExpiredTimer())
    header = label("SCProbeHeader", 901, 0.55, 0.04)
    pollingLine = label("SCProbePolling", 902, 0.49, 0.04)
    eventsLine = label("SCProbeEvents", 903, 0.43, 0.04)
    receiptsLine = label("SCProbeReceipts", 904, 0.37, 0.04)
    detailsLine = label("SCProbeDetails", 905, 0.30, 0.15)
    let sync = CreateTrigger()
    let keys = CreateTrigger()
    let restartKeys = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(restartKeys, Player(0), OSKEY_R, 2, true)
    TriggerAddAction(restartKeys, function restart)
    for slot = 0 to 1
        competitor[slot] = GetPlayerController(Player(slot)) == MAP_CONTROL_USER and GetPlayerSlotState(Player(slot)) == PLAYER_SLOT_STATE_PLAYING
        if competitor[slot]
            BlzTriggerRegisterPlayerSyncEvent(sync, Player(slot), PREFIX, false)
            for meta = 0 to 15
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_N, meta, true)
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_N, meta, false)
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_I, meta, true)
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_I, meta, false)
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_A, meta, true)
                BlzTriggerRegisterPlayerKeyEvent(keys, Player(slot), OSKEY_A, meta, false)
    TriggerAddAction(sync, function receive)
    TriggerAddAction(keys, function keyEvent)
    TimerStart(CreateTimer(), 1. / 60., true, function tick)

init
    TimerStart(CreateTimer(), 0., false, function setup)
