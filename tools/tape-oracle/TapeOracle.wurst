package TapeOracle
import ReplayHistory
import ReplayState
import MatchStep
import MatchRules
import Simulation
import CommandBuffer
import ParticipantInputs

// Host boundary served by smashcraft:tools/tape-oracle/run.lua: tape tokens in, records out.
@extern native TapeOracleNextLine() returns boolean
@extern native TapeOracleLineNumber() returns int
@extern native TapeOracleWord() returns string
@extern native TapeOracleInt() returns int
@extern native TapeOracleReal() returns real
@extern native TapeOracleEmit(string record)
@extern native TapeOracleFail(string message)

MatchState game
FighterRoster world
FrameInputs controls
ReplayRuntimeState runtime
ReplayHistory history
ReplaySnapshot observed
MatchFrameInput row
FrameInputs produced
InputSnapshot neutral
int epoch = 0

function flag() returns boolean
	return TapeOracleInt() != 0

function setInput(InputSnapshot input, string name)
	if name == "direction"
		input.direction = TapeOracleInt()
	else if name == "verticalDirection"
		input.verticalDirection = TapeOracleInt()
	else if name == "diStickValid"
		input.diStickValid = flag()
	else if name == "diStickX"
		input.diStickX = TapeOracleReal()
	else if name == "diStickZ"
		input.diStickZ = TapeOracleReal()
	else if name == "sdiPulse"
		input.sdiPulse = flag()
	else if name == "sdiX"
		input.sdiX = TapeOracleInt()
	else if name == "sdiZ"
		input.sdiZ = TapeOracleInt()
	else if name == "cStickX"
		input.cStickX = TapeOracleInt()
	else if name == "cStickZ"
		input.cStickZ = TapeOracleInt()
	else if name == "attackRequested"
		input.attackRequested = flag()
	else if name == "specialPressed"
		input.specialPressed = flag()
	else if name == "specialX"
		input.specialX = TapeOracleInt()
	else if name == "specialZ"
		input.specialZ = TapeOracleInt()
	else if name == "down"
		input.down = flag()
	else if name == "shield"
		input.shield = flag()
	else if name == "shieldPressed"
		input.shieldPressed = flag()
	else if name == "shieldTriggerActive"
		input.shieldTriggerActive = flag()
	else if name == "shieldStrength"
		input.shieldStrength = TapeOracleReal()
	else if name == "jumpPressed"
		input.jumpPressed = flag()
	else if name == "airDodgePressed"
		input.airDodgePressed = flag()
	else if name == "techPressed"
		input.techPressed = flag()
	else if name == "mashPressed"
		input.mashPressed = flag()
	else if name == "attackPressed"
		input.attackPressed = flag()
	else if name == "grabMashPressed"
		input.grabMashPressed = flag()
	else if name == "grabThrowX"
		input.grabThrowX = TapeOracleInt()
	else if name == "grabThrowZ"
		input.grabThrowZ = TapeOracleInt()
	else if name == "lCancelPressed"
		input.lCancelPressed = flag()
	else if name == "groundDodgePressed"
		input.groundDodgePressed = flag()
	else if name == "groundDodgeDirection"
		input.groundDodgeDirection = TapeOracleInt()
	else if name == "getupAttackPressed"
		input.getupAttackPressed = flag()
	else if name == "ledgeVerticalPressed"
		input.ledgeVerticalPressed = TapeOracleInt()
	else if name == "getupStandPressed"
		input.getupStandPressed = flag()
	else if name == "getupDirectionPressed"
		input.getupDirectionPressed = flag()
	else if name == "getupDirection"
		input.getupDirection = TapeOracleInt()
	else if name == "dodgeX"
		input.dodgeX = TapeOracleInt()
	else if name == "dodgeZ"
		input.dodgeZ = TapeOracleInt()
	else if name == "jumpHeld"
		input.jumpHeld = flag()
	else if name == "walking"
		input.walking = flag()
	else if name == "attackHeld"
		input.attackHeld = flag()
	else
		TapeOracleFail("unknown input field " + name)

function readInput()
	let slot = TapeOracleInt()
	if slot < 0 or slot >= INPUT_PARTICIPANT_CAPACITY
		TapeOracleFail("input slot out of range")
		return
	var name = TapeOracleWord()
	while name != ""
		if name == "attack"
			let style = TapeOracleInt()
			let facing = TapeOracleInt()
			let target = TapeOracleInt()
			produced.commands[slot].enqueue(style, facing, target, flag())
		else
			setInput(produced.inputs[slot], name)
		name = TapeOracleWord()

// Mirrors the pure part of Melee's makePreview and startMatch: fresh fighters, runtime and epoch.
function startMatch()
	epoch++
	world.mask = game.fighterMask()
	for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		if world.active(slot)
			let x = matchSpawnX(slot)
			world.fighters[slot] = new FighterState(game.characterFor(slot), x, x < 0 ? 1 : -1)
		neutral.copyTo(controls.inputs[slot])
		controls.commands[slot].clear()
		runtime.botAttackDelays[slot] = 0
	runtime.simulationFrame = 0
	runtime.resetPoses()
	initializeMatchFighters(game, world)
	if not history.beginEpoch(epoch, 1)
		TapeOracleFail("history refused epoch " + I2S(epoch))

function flagText(boolean value) returns string
	return value ? "1" : "0"

// Fighter presentation, which the replay checksum leaves out, in the canonical field form.
function poseText() returns string
	var text = ""
	for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		if world.active(slot)
			let pose = runtime.poses[slot]
			let prefix = "|pose[" + I2S(slot) + "]."
			text += prefix + "animation=" + pose.animation + prefix + "jumpAnimationRemaining=" + I2S(pose.jumpAnimationRemaining)
			text += prefix + "doubleJumpAnimation=" + flagText(pose.doubleJumpAnimation) + prefix + "landingAnimationRate=" + canonicalReal(pose.landingAnimationRate)
			text += prefix + "clipIndex=" + I2S(pose.clipIndex) + prefix + "clipName=" + pose.clipName + prefix + "clipTime=" + canonicalReal(pose.clipTime)
			text += prefix + "rate=" + canonicalReal(pose.rate) + prefix + "selectionSerial=" + I2S(pose.selectionSerial)
			text += prefix + "motion=" + I2S(pose.motion.motion) + prefix + "transitionRemaining=" + I2S(pose.motion.transitionRemaining)
			text += prefix + "respawnRemaining=" + I2S(pose.motion.respawnRemaining) + prefix + "escapeRemaining=" + I2S(pose.motion.escapeRemaining)
			text += prefix + "ledgeCatchRemaining=" + I2S(pose.motion.ledgeCatchRemaining) + prefix + "ledgeJump=" + flagText(pose.motion.ledgeJump)
	return text

// The canonical state text rather than its checksum: equal texts give equal checksums,
// a difference names its field, and hashing in compiled Wurst would dominate the run.
function emit(string operation, string result)
	observed.capture(world, game, controls, runtime)
	TapeOracleEmit(I2S(TapeOracleLineNumber()) + " " + operation + " " + result + " " + observed.canonicalState() + poseText())

function runFrame()
	let number = TapeOracleInt()
	if not row.capture(number, world.mask, produced, runtime)
		TapeOracleFail("capture refused frame " + I2S(number))
	if not history.save(epoch, row, world, game, controls, runtime)
		TapeOracleFail("history refused frame " + I2S(number))
	if not row.execute(game, world, controls, runtime, number)
		TapeOracleFail("execution refused frame " + I2S(number))
	emit("frame", I2S(number))
	for slot = 0 to INPUT_PARTICIPANT_CAPACITY - 1
		neutral.copyTo(produced.inputs[slot])
		produced.commands[slot].clear()

function runRollback()
	let first = TapeOracleInt()
	let last = TapeOracleInt()
	if last != runtime.simulationFrame or not history.replay(epoch, first, last, world, game, controls, runtime)
		TapeOracleFail("history refused replay " + I2S(first) + ".." + I2S(last))
	emit("rollback", I2S(first) + ".." + I2S(last))

function perform(string operation)
	if operation == "input"
		readInput()
	else if operation == "frame"
		runFrame()
	else if operation == "rollback"
		runRollback()
	else if operation == "participants"
		let humans = TapeOracleInt()
		game.setParticipants(humans, TapeOracleInt())
		emit(operation, "-")
	else if operation == "character"
		let slot = TapeOracleInt()
		game.selectCharacter(slot, TapeOracleInt())
		emit(operation, "-")
	else if operation == "stage-select"
		emit(operation, flagText(game.requestStageSelect(TapeOracleInt())))
	else if operation == "stage"
		let slot = TapeOracleInt()
		game.selectStage(slot, TapeOracleInt())
		emit(operation, "-")
	else if operation == "stocks"
		let slot = TapeOracleInt()
		game.setStocks(slot, TapeOracleInt())
		emit(operation, "-")
	else if operation == "time"
		let slot = TapeOracleInt()
		game.setTimeLimit(slot, TapeOracleInt())
		emit(operation, "-")
	else if operation == "start"
		let started = game.requestStart(TapeOracleInt())
		if started
			startMatch()
		emit(operation, flagText(started))
	else if operation == "rematch"
		let confirmed = game.confirmRematch(TapeOracleInt())
		if confirmed
			game.updateConnectedHumans(game.humanMask)
		emit(operation, flagText(confirmed))
	else
		TapeOracleFail("unknown operation " + operation)

init
	game = new MatchState()
	world = new FighterRoster(0)
	controls = new FrameInputs()
	runtime = new ReplayRuntimeState()
	history = new ReplayHistory()
	observed = new ReplaySnapshot()
	row = new MatchFrameInput()
	produced = new FrameInputs()
	neutral = new InputSnapshot()
	while TapeOracleNextLine()
		perform(TapeOracleWord())
