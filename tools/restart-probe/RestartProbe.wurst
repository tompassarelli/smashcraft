package RestartProbe
import Wurst
import ProbeInfo

int ticks = 0
int inputs = 0
boolean restarting = false

function receipt()
    inputs++
    PreloadGenClear()
    PreloadGenStart()
    Preload("RESTART PROBE " + PROBE_VARIANT + " ticks=" + I2S(ticks) + " inputs=" + I2S(inputs))
    PreloadGenEnd("wc3-restart-probe.txt")
    DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 10, "Input received at " + I2S(ticks) + " seconds")

function restart()
    if not restarting
        restarting = true
        RestartGame(false)

function tick()
    ticks++
    if ticks % 5 == 0
        DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 5, "Restart probe: " + I2S(ticks) + " seconds")

init
    let restartTrigger = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(restartTrigger, Player(0), OSKEY_R, 2, true)
    TriggerAddAction(restartTrigger, function restart)
    let inputTrigger = CreateTrigger()
    BlzTriggerRegisterPlayerKeyEvent(inputTrigger, Player(0), OSKEY_T, 2, true)
    TriggerAddAction(inputTrigger, function receipt)
    TimerStart(CreateTimer(), 1, true, function tick)
    DisplayTimedTextToPlayer(GetLocalPlayer(), 0, 0, 60, "Restart probe " + PROBE_VARIANT + " | Ctrl+R: scripted restart | Ctrl+T: input receipt")
