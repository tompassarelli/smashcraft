package KeysProbe
import Wurst

int edges = 0

function edge()
    edges++

init
    let downTrigger = CreateTrigger()
    let upTrigger = CreateTrigger()
    for keyCode = 1 to 255
        let key = ConvertOsKeyType(keyCode)
        BlzTriggerRegisterPlayerKeyEvent(downTrigger, Player(0), key, 0, true)
        BlzTriggerRegisterPlayerKeyEvent(upTrigger, Player(0), key, 0, false)
    TriggerAddAction(downTrigger, function edge)
    TriggerAddAction(upTrigger, function edge)
